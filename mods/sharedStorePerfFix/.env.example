# sharedStorePerfFix mod - configuration template
#
# Copy this file to `.env` in this same folder and change the values you want.
# Order of precedence, highest first: the real environment (Docker compose, a
# start script), then this file, then settings.json, then the built-in default.
# Format: KEY=value, one per line, whole-line `#` comments only.
# An invalid value: the mod logs the problem and installs nothing.
# A change takes effect the next time EVE.js starts.

# Whole mod on/off (1/0, true/false, on/off). Default: 1.
# Off = vanilla EveJS: the mod reads and writes nothing.
# EVEJS_SSPF_ENABLED=1

# Any non-empty value skips installing the hook at all (emergency switch).
# EVEJS_SSPF_NO_INSTALL=

# Row count written into the planner statistic, 1000..10000000. Default: 100000.
# EVEJS_SSPF_PIN_ROWS=100000

# Lock wait of every writing game database connection in ms, 0..120000.
# 0 keeps the server default (5000). Default: 0.
# EVEJS_SSPF_BUSY_TIMEOUT_MS=0

# Skip sovereignty mirror saves that change nothing (1/0). Default: 1.
# 0 = every mirror save rewrites the structures table as in vanilla EveJS.
# EVEJS_SSPF_MIRROR_SKIP=1
