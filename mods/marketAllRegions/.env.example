# A real environment variable wins over this file. In Docker set these under
# `environment:` in compose.yaml (no rebuild); a .env next to the mod is baked
# into the image and needs `docker compose build init`.
# A value outside its range makes the mod install nothing (vanilla market).

# 1 = the market order list (type details) shows orders from every region.
# 0 = vanilla: session region only. Default: 1.
EVEJS_MARKET_ALL_REGIONS=1

# Foreign rows kept per side (sells / buys), best prices first, 0..5000.
# Rows of your own region are always all shown and never count here.
# 0 = own region only. Lower it (e.g. 100) if opening a type stutters the
# server: vanilla computes the jump count of every shown row. Default: 150 (~0.6 s BFS per 500 rows on first open).
EVEJS_MARKET_ALL_REGIONS_MAX_FOREIGN_ROWS=150

# How long the foreign part of a type is reused, in ms, 0..600000.
# 0 = no cache (every read asks the market daemon for every region).
# Your own region is always read fresh. Default: 60000.
EVEJS_MARKET_ALL_REGIONS_CACHE_TTL_MS=60000

# Types kept in that cache, 1..100000; the oldest is dropped. Default: 200.
EVEJS_MARKET_ALL_REGIONS_CACHE_MAX_TYPES=200

# Parallel daemon requests per all-regions read, 1..64. Default: 8.
EVEJS_MARKET_ALL_REGIONS_CONCURRENCY=8

# 1 = include wormhole (J-space) regions. Default: 0.
EVEJS_MARKET_ALL_REGIONS_INCLUDE_WORMHOLE=0

# At most one "region failed" log line per this window, in ms, 0..3600000,
# with a count of the suppressed ones. 0 = log every failure. Default: 60000.
EVEJS_MARKET_ALL_REGIONS_ERROR_LOG_INTERVAL_MS=60000

# 1 = one log line per all-regions fetch (type, regions, errors, rows, ms).
# Default: 0.
EVEJS_MARKET_ALL_REGIONS_VERBOSE=0
