# hotPathPerf — override example (environment variables win over settings.json)
# HOTPATH_NO_INSTALL=1                  kill switch: the loader installs nothing
# HOTPATH_ENABLED=1
# HOTPATH_SLOW_CALL_MS=250
# HOTPATH_STATS_MINUTES=10
# HOTPATH_MEASURE_BOUNDARY=1
# HOTPATH_MEASURE_CACHE_MGR=1
# HOTPATH_MEASURE_LIFECYCLE_LISTS=1
# HOTPATH_MEASURE_COLLECT_EMPTY=1
# HOTPATH_MEASURE_PREPARE_SITES=1
# HOTPATH_MEASURE_ENSURE_SCENE=1
# HOTPATH_MEASURE_MULTI_LOCATIONS=1
# Active location index (see README), off by default:
# HOTPATH_DUNGEON_INDEX=0
# HOTPATH_DUNGEON_INDEX_PARITY=0          1 = compare with the vendor (measurement runs only)
# HOTPATH_DUNGEON_INDEX_MAX_ENTRIES=100000
# Scene retention (see README), off by default:
# HOTPATH_SCENE_RETENTION=0
# HOTPATH_SCENE_RETENTION_PIN_DOCKED=1
# HOTPATH_SCENE_RETENTION_DOCKED_MAX_MINUTES=120   0 = no limit
# HOTPATH_SCENE_RETENTION_PIN_RECENT=0
# HOTPATH_SCENE_RETENTION_RECENT_MINUTES=10
# HOTPATH_SCENE_RETENTION_MAX_PER_CHARACTER=4
# HOTPATH_SCENE_RETENTION_MAX_TOTAL=16
# HOTPATH_SCENE_RETENTION_RSS_CEILING_MB=0         0 = RSS guard off
# Location pre-warm (see README), on by default:
# HOTPATH_PREWARM_LOCATIONS=1
# Abyssal career read (see README), off by default:
# HOTPATH_CAREER_ABYSSAL_READ=0
# HOTPATH_CAREER_ABYSSAL_READ_PARITY=0     1 = compare with the vendor (measurement runs only)
# HOTPATH_CAREER_ABYSSAL_READ_RECLASSIFY=64   0 = no reclassification
# HOTPATH_CAREER_ABYSSAL_READ_MAX_KEYS=200000
# HOTPATH_CAREER_ABYSSAL_READ_BUSY_MS=5000
# Career combat ledger read (see README), off by default:
# HOTPATH_CAREER_COMBAT_ITEMS_READ=0
# HOTPATH_CAREER_COMBAT_ITEMS_READ_PARITY=0    1 = compare with the vendor (measurement runs only)
# HOTPATH_CAREER_COMBAT_ITEMS_READ_BUSY_MS=5000
# Read-only templates (see README), off by default:
# HOTPATH_TEMPLATE_READONLY=0
# HOTPATH_TEMPLATE_READONLY_PARITY=0       1 = compare with the vendor clone (measurement runs only)
# HOTPATH_TEMPLATE_READONLY_ROTATE=0       1 = view also in location rotation (needs HOTPATH_TEMPLATE_READONLY=1)
# Dungeon reads without a clone (see README), off by default:
# HOTPATH_TEMPLATE_READONLY_CALLERS=0      1 = view also for guide and scanner texts (needs HOTPATH_TEMPLATE_READONLY=1)
# HOTPATH_DUNGEON_INSTANCE_REF=0           1 = instance ref instead of a clone in the location behavior tick
# HOTPATH_DUNGEON_INSTANCE_REF_PARITY=0    1 = compare with the vendor clone (measurement runs only)
# Dungeon rock depletion coalescing (see README), off by default:
# HOTPATH_ROCK_REMAINDER_COALESCE=0
# HOTPATH_ROCK_REMAINDER_COALESCE_MS=10000          0 = no buffering
# HOTPATH_ROCK_REMAINDER_COALESCE_MAX_INSTANCES=256
# System structures without cloning the whole universe (see README), off by default:
# HOTPATH_STRUCTURES_SYSTEM_FILTER=0
# HOTPATH_STRUCTURES_SYSTEM_FILTER_PARITY=0    1 = compare with the vendor (measurement runs only)
# HOTPATH_STRUCTURES_REFRESH_COALESCE=0        1 = refresh skipped when a full tickStructures ran < FRESH_MS ago
# HOTPATH_STRUCTURES_REFRESH_FRESH_MS=5000     0 = always refresh; > 10000 clamped to 10000
# Mining drone persist coalescing (see README), off by default:
# HOTPATH_DRONE_PERSIST_COALESCE=0
# HOTPATH_DRONE_PERSIST_COALESCE_MS=5000          0 = no deferral
# HOTPATH_DRONE_PERSIST_COALESCE_MAX_ITEMS=256
# Structure tick throttle (see README), off by default:
# HOTPATH_TICK_STRUCTURES_THROTTLE=0
# HOTPATH_TICK_STRUCTURES_MIN_INTERVAL_MS=5000   0 = no throttle; > 10000 clamped to 10000
# Owner blueprint list (see README), off by default:
# HOTPATH_BLUEPRINT_OWNER_READ=0
# HOTPATH_BLUEPRINT_OWNER_READ_PARITY=0         1 = compare with the vendor (measurement runs only)
# NPC wreck list (see README), off by default:
# HOTPATH_NATIVE_WRECK_LIST=0
# HOTPATH_NATIVE_WRECK_LIST_PARITY=0            1 = compare with the vendor (measurement runs only)
# Config snapshot memo at handshake (see README), off by default:
# HOTPATH_CONFIG_SNAPSHOT_MEMO=0
# HOTPATH_CONFIG_SNAPSHOT_MEMO_REVALIDATE_MS=1000   window without a stat of the config files; 0 = stat on every read; > 60000 clamped
# HOTPATH_CONFIG_SNAPSHOT_MEMO_PARITY=0             1 = compare with the vendor read (brings back the disk cost, diagnostics only)
# Scheduler client queue limit (see README), default 4096:
# HOTPATH_SCHEDULER_MAX_PENDING=4096              0 = vendor (256); only raises; > 65536 clamped
# HOTPATH_SCHEDULER_REQUEST_TIMEOUT_MS=120000     0 = vendor (10000); only raises; > 600000 clamped
# Scheduler overdue job gate during startup (see README), on by default:
# HOTPATH_SCHEDULER_DUE_GATE=1                    0 = vendor behavior (kill switch)
# HOTPATH_SCHEDULER_DUE_GATE_TYPES=ess.settlement,sovereignty.campaign-tick   ≤ 16 types, no *; empty = gate off
# HOTPATH_SCHEDULER_DUE_GATE_RELEASE_DELAY_MS=30000   0..600000; the pump starts this long after startup ends
# HOTPATH_SCHEDULER_DUE_GATE_MAX_HOLD_MS=300000       10000..1800000; opens without a startup signal
# HOTPATH_SCHEDULER_DUE_GATE_PUMP_INTERVAL_MS=100     10..5000
# HOTPATH_SCHEDULER_DUE_GATE_BATCH=8                  1..256 jobs per pump step
# HOTPATH_SCHEDULER_DUE_GATE_MAX_IN_FLIGHT=2          1..64 gate jobs in flight
# HOTPATH_SCHEDULER_DUE_GATE_MIN_LEASE_LEFT_MS=10000  0..29000; a shorter lease waits for a new one
# HOTPATH_SCHEDULER_DUE_GATE_STALE_DROP_MS=120000     1000..600000; an older expired lease drops out of the gate
# HOTPATH_SCHEDULER_DUE_GATE_MAX_HELD=100000          1000..1000000; the excess goes to the vendor at once
# HOTPATH_SCHEDULER_DUE_GATE_UNSEEN_RELEASE_MS=10000  1000..600000; an in-flight entry without a vendor call frees its slot
# Main thread loop watchdog at startup (see README), on by default:
# HOTPATH_STALL_WATCH=1                           0 = no watchdog thread and no timer (kill switch)
# HOTPATH_STALL_WATCH_THRESHOLD_MS=5000           500..600000; loop gap from which a `stallWatch: stall` line is logged
# HOTPATH_STALL_WATCH_SAMPLE_EVERY_MS=20000       1000..600000; interval of stack samples within one stall
# HOTPATH_STALL_WATCH_MAX_SAMPLES=40              0..1000; 0 = only gaps and breadcrumbs, no debugger
# HOTPATH_STALL_WATCH_FRAMES=12                   1..50 stack frames per sample line
# HOTPATH_STALL_WATCH_WINDOW_MS=1800000           60000..86400000; the watchdog runs this long after startup
# HOTPATH_STALL_WATCH_HEARTBEAT_MS=250            50..5000
# HOTPATH_SCHEDULER_OWNERS_SLOW_CALL_MS=10000     0..600000; scheduler client round trip that logs a `slow call` line; 0 = no line
# Mask of owned sov hub echoes in the startup reconcile (see README), on by default:
# HOTPATH_SOV_CAPTURE_OWNED_ECHO_SKIP=1           0 = vendor behavior (kill switch)
# Cyno jammer broadcast only for systems with a session (see README), on by default:
# HOTPATH_CYNO_BROADCAST_SESSION_FILTER=1         0 = vendor behavior (kill switch)
# Incursion tale list memo (see README), off by default:
# HOTPATH_INCURSION_TALES_MEMO=0
# HOTPATH_INCURSION_TALES_MEMO_PARITY_CHECK=0     1 = compare with the vendor (measurement runs only)
# Bounty read without clones (see README), off by default:
# HOTPATH_BOUNTY_POOL_READ=0
# HOTPATH_BOUNTY_POOL_READ_PARITY=0               1 = compare with the vendor (measurement runs only)
# Corporation memo in career sync (see README), off by default:
# HOTPATH_CAREER_STANDING_CORP_MEMO=0
# HOTPATH_CAREER_STANDING_CORP_MEMO_PARITY=0      1 = compare with the vendor (measurement runs only)
# Deferred retire of reprocessing receipts (see README), off by default:
# HOTPATH_REPROCESSING_RECEIPT_RETIRE_DEFER=0
# HOTPATH_REPROCESSING_RECEIPT_RETIRE_DELAY_MS=30000          1000..600000; key collection window
# HOTPATH_REPROCESSING_RECEIPT_RETIRE_MAX_PENDING_KEYS=20000  100..200000; when reached = flush at once
