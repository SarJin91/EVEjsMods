# Ship Wing - configuration (copy to .env beside this file, or set in the environment).
# Layers, the higher wins per key: defaults < settings.json < .env < environment.
# A value the mod cannot read keeps its default and prints a "config: warning" line.

# Master switch. 0 = the loader installs no hook at all (needs a server restart). Default: 0.
EVEJS_SHIPWING_ENABLED=0

# Most wing copies one pilot can have out at once (1..10). Default: 2.
EVEJS_SHIPWING_MAX_WING_PER_PILOT=2

# A copy further than this from its host (surface to surface, meters) is recalled (1000..250000).
# Also the hard limit for combat targets (manual Attack and ASSIST). Default: 20000.
EVEJS_SHIPWING_CONTROL_RANGE_METERS=20000

# How long a copy may stay out of control range before the recall, ms (0..600000). Default: 10000.
EVEJS_SHIPWING_OUT_OF_RANGE_GRACE_MS=10000

# Launch distance from the host, surface to surface, meters (0..50000). Default: 500.
EVEJS_SHIPWING_LAUNCH_OFFSET_METERS=500

# Follow distance of a copy behind its host, meters (0..100000). Default: 1500.
EVEJS_SHIPWING_FOLLOW_RANGE_METERS=1500

# A follow order is sent again at most this often, ms (100..60000). Default: 1000.
EVEJS_SHIPWING_FOLLOW_RETUNE_MS=1000

# A returning copy closer than this to its host (meters) goes back to the bay (0..100000). Default: 2500.
EVEJS_SHIPWING_RECALL_RANGE_METERS=2500

# A returning copy goes back to the bay after this time at the latest, ms (1000..3600000). Default: 60000.
EVEJS_SHIPWING_RECALL_TIMEOUT_MS=60000

# Wing tick period, ms (50..10000): reaction time to dock, jump, warp and logoff. Default: 500.
EVEJS_SHIPWING_TICK_INTERVAL_MS=500

# A wing tick longer than this (ms, 1..1000) counts as tick.overBudget (the tick is never cut). Default: 2.
EVEJS_SHIPWING_TICK_BUDGET_MS=2

# Minimum time between two launches of one pilot, ms (0..60000); one chat command may launch several. Default: 2000.
EVEJS_SHIPWING_COMMAND_COOLDOWN_MS=2000

# Most item IDs one guarded ship/inventory call is scanned for (1..100000). While any wing record exists
# (also a LOST one), a call with more IDs than this is refused for every player (fail-closed). Default: 4096.
EVEJS_SHIPWING_GUARD_MAX_SCANNED_IDS=4096

# A guard error (a mod bug) is logged at once, the next ones at most once per this period, ms (1000..3600000).
# Default: 60000.
EVEJS_SHIPWING_GUARD_ERROR_LOG_INTERVAL_MS=60000

# The "telemetry" counters line is printed at most this often, and only when it changed, ms (10000..86400000);
# also once at shutdown. Default: 600000 (10 min).
EVEJS_SHIPWING_TELEMETRY_INTERVAL_MS=600000

# Chat command in Local: ! followed by 1-31 letters, digits, _ or -. Default: !wing.
EVEJS_SHIPWING_CHAT_TRIGGER=!wing

# Client window (test): the shipWingSvc service (GetState, Command, Report), the OnShipWingState and
# OnShipWingOpen notifications, "!wing ui", and the client code sent in memory at login (a hook on handshake.js;
# shipWing must be preloaded before moonOreAnomalies and droneClassBalance). Needs EVEJS_SHIPWING_ENABLED=1 (else a
# config warning) and a restart. Default: 0 (off).
EVEJS_SHIPWING_CLIENT_WINDOW_ENABLED=0

# Most one OnShipWingState per pilot per this period, ms (100..60000); changes in between are sent together.
# Default: 1000.
EVEJS_SHIPWING_CLIENT_WINDOW_STATE_MIN_INTERVAL_MS=1000

# Most calls to shipWingSvc (GetState, Command and Report together) per pilot per second (1..50); more are refused
# (RATE_LIMIT). Default: 5.
EVEJS_SHIPWING_CLIENT_WINDOW_MAX_COMMANDS_PER_SECOND=5

# Most ships in one window command (1..100, after duplicates are removed); more = the command is refused
# (TOO_MANY_SHIPS). Default: 20.
EVEJS_SHIPWING_CLIENT_WINDOW_MAX_SHIPS_PER_COMMAND=20

# Most one SHIPWING_UI:PROBE log line per pilot per this period, ms (1000..3600000). Default: 60000.
EVEJS_SHIPWING_CLIENT_WINDOW_REPORT_MIN_INTERVAL_MS=60000

# `!wing ui` opens the window (OnShipWingOpen) at most once per pilot per this period, ms (0..60000; 0 = no limit).
# A faster line answers "the window could not be opened, try again". Default: 1000.
EVEJS_SHIPWING_CLIENT_WINDOW_OPEN_MIN_INTERVAL_MS=1000

# The window refreshes its state (one GetState) every this many ms while it is open, ms (0..60000; 0 = no refresh;
# 1..999 is raised to 1000 with a config warning). Default: 5000.
EVEJS_SHIPWING_CLIENT_WINDOW_POLL_MS=5000

# The window reads the HP of the copies in space from the client every this many ms (250..10000; no RPC).
# Default: 1000.
EVEJS_SHIPWING_CLIENT_WINDOW_HP_REFRESH_MS=1000

# A refusal of one copy stays in its window row this many ms (1000..60000). Default: 8000.
EVEJS_SHIPWING_CLIENT_WINDOW_ROW_REASON_MS=8000

# The window opens on its own at the first launch of a copy (1) or only with "!wing ui" (0). Default: 1.
EVEJS_SHIPWING_CLIENT_WINDOW_AUTO_OPEN=1

# Most rows in one window state (10..100). Rows of copies in space always stay; the rest is cut. Default: 30.
EVEJS_SHIPWING_CLIENT_WINDOW_MAX_ROWS=30

# HP colours in the window: each S, A, H number below HP_WARN_PCT is orange, below HP_CRITICAL_PCT red
# (1..99, critical below warn, else both defaults and a warning). Defaults: 90 and 50.
EVEJS_SHIPWING_HP_WARN_PCT=90
EVEJS_SHIPWING_HP_CRITICAL_PCT=50

# Button text colours in the window: Go green, Back blue, Follow white, Mine yellow, Fire red, Dr violet
# F orange (off = dimmer). 0 = plain labels (use it if the client shows the <color=...> markup as text). Default: 1.
EVEJS_SHIPWING_CLIENT_WINDOW_BUTTON_COLORS=1

# Most one SHIPWING_UI:EVENT log line (client window events and errors) per pilot per this period, ms (0..60000;
# 0 = only the limit EVEJS_SHIPWING_CLIENT_WINDOW_MAX_COMMANDS_PER_SECOND). Default: 1000.
EVEJS_SHIPWING_CLIENT_WINDOW_EVENT_MIN_INTERVAL_MS=1000

# The window opens on its own at each new login of a pilot who typed "!wing ui auto on" (1) or never (0); the choice
# is kept in wingUiPrefs.json under EVEJS_DATA_ROOT. Default: 1.
EVEJS_SHIPWING_CLIENT_WINDOW_OPEN_AT_LOGIN_ENABLED=1

# That login window is sent this many ms after the first window state of the new session (0..30000). Raise it when
# the window does not appear because the client was still loading. Default: 3000.
EVEJS_SHIPWING_CLIENT_WINDOW_LOGIN_OPEN_DELAY_MS=3000

# Most pilots kept in wingUiPrefs.json (1..100000); a new pilot above it gets "list full". Default: 4096.
EVEJS_SHIPWING_UI_PREFS_MAX_PILOTS=4096

# Known server/src/network/tcp/handshake.js versions: 1..8 comma-separated sha256 hashes (64 hex characters, file
# with LF line ends). An unknown file = no client code (SHIPWING_UI:UNAVAILABLE:UNKNOWN_HANDSHAKE hash=<hash>); add a
# hash only after a review of the new file. Default: the EveJS 261115.2 file.
EVEJS_SHIPWING_CLIENT_WINDOW_HANDSHAKE_HASHES=7aaa72247049b38d3f656f3b2c602877a8bcf0d9ff0af68f1795ff1327565ba7

# Loss of a copy. The wreck of a destroyed copy is durable: its loot stays after a server restart. 0 = transient
# wreck (diagnostics only). Default: 1.
EVEJS_SHIPWING_DURABLE_WRECK=1

# When a copy ends with the copy still in space (return, dock, jump, logoff ...), its structure, armor, shield and
# capacitor go back to the real ship. Default: 1.
EVEJS_SHIPWING_CONDITION_WRITE_BACK=1

# A loss that could not be settled (e.g. the ship is in use) is tried again after this x the attempt number, ms
# (500..600000). Default: 5000.
EVEJS_SHIPWING_LOSS_SETTLE_RETRY_MS=5000

# After this many failed attempts (1..1000) the ship stays locked until the next server start ("LOSS NOT SETTLED" in
# the log). Default: 20.
EVEJS_SHIPWING_LOSS_SETTLE_MAX_ATTEMPTS=20

# A settled loss record is kept this long, ms (5000..3600000), then removed; more than the 2 s gameStore flush.
# Default: 30000.
EVEJS_SHIPWING_LOSS_RECORD_RETENTION_MS=30000

# No insurance payout for a destroyed copy (still an open question). 0 is not tested in the game. Default: 1.
EVEJS_SHIPWING_LOSS_SKIP_INSURANCE=1

# A copy that vanished from a loaded scene without a fight (e.g. a GM command) is a loss without a wreck (still an
# open question, fail-closed). 0 = the real ship is given back (end reason TWIN_GONE). Default: 1.
EVEJS_SHIPWING_LOSS_ON_MISSING_TWIN=1

# mining (flags off; the mine engine is, the drone command mirror)
# 1 = the `hold` and `mine` orders (!wing hold, !wing mine) are on; `mine` also needs the mining hook. Default: 0.
EVEJS_SHIPWING_MINING_ENABLED=0
# 1 = the pilot's drone and fighter commands are mirrored to the wing: Engage / a fighter ability with an entity
# target -> attack, Recall fighters -> hold for the copies in ATTACK (attack needs COMBAT_ENABLED); drone
# Mine repeatedly on a rock -> mine (needs MINING_ENABLED), for every ACTIVE copy. Default: 0.
EVEJS_SHIPWING_COMMAND_MIRROR_ENABLED=0
# 1 = drone Return to drone bay -> return and Return and orbit -> hold for every ACTIVE copy, but only when the
# command names every drone of the pilot in space (a command for some drones never moves the copies). 0 = the copies
# come back only by!wing return or the window. Needs COMMAND_MIRROR_ENABLED. Default: 0.
EVEJS_SHIPWING_COMMAND_MIRROR_RETURN_ENABLED=0
# 1 = the pilot's F (drone Engage, a fighter ability with a target, fighter recall) may go to the copies whose F
# toggle in the wing window is on (F:on); 0 = never, and the window shows no F toggles. Needs
# COMMAND_MIRROR_ENABLED. Default: 1.
EVEJS_SHIPWING_COMMAND_MIRROR_ENGAGE_ENABLED=1
# The F toggle of a newly launched copy: 1 = F:on (every copy attacks with your drones, the old behaviour), 0 = F:off
# (copies ignore your F until you click F:on in the window). Needs COMMAND_MIRROR_ENGAGE_ENABLED. Default: 0.
EVEJS_SHIPWING_COMMAND_MIRROR_ENGAGE_COPY_DEFAULT=0
# Rock search range around the host, m (1000..100000); keep it <= CONTROL_RANGE_METERS. Default: 15000.
EVEJS_SHIPWING_MINING_SEARCH_RANGE_METERS=15000
# Range from the host of a rock the pilot names (mine/F, his locked rock), m (1000..250000); keep it between
# MINING_SEARCH_RANGE_METERS and CONTROL_RANGE_METERS + 15000. Default: 30000.
EVEJS_SHIPWING_MINING_ORDER_RANGE_METERS=30000
# Distance kept inside the mining module range, m (0..10000). Default: 500.
EVEJS_SHIPWING_MINING_RANGE_BUFFER_METERS=500
# Penalty per twin already on a rock when a rock is chosen, m (0..50000). Default: 2000.
EVEJS_SHIPWING_MINING_CLAIM_PENALTY_METERS=2000
# Rock scans per mod tick (1..50). Default: 2.
EVEJS_SHIPWING_MINING_MAX_SEEKS_PER_TICK=2
# Twin hold fill that sends it to unload, % (10..100). Default: 95.
EVEJS_SHIPWING_MINING_UNLOAD_AT_PERCENT=95
# Distance to the host to hand over ore, m (500..20000). Default: 2500.
EVEJS_SHIPWING_MINING_TRANSFER_RANGE_METERS=2500
# Wait before the next rock search when there is none, ms (1000..600000). Default: 10000.
EVEJS_SHIPWING_MINING_SEEK_RETRY_MS=10000
# Wait before the next unload try when the host is full, ms (1000..600000). Default: 30000.
EVEJS_SHIPWING_MINING_FULL_RETRY_MS=30000
# Twin ore goes to the owner's mining ledger. Default: 1.
EVEJS_SHIPWING_MINING_LEDGER_ENABLED=1
# Ore the pilot's ship has no room for goes into the pilot's jetcan beside the twin; the twin mines on.
# 0 = the twin waits at the host (FULL) as before. Default: 1.
EVEJS_SHIPWING_MINING_OVERFLOW_CAN_ENABLED=1
# Overflow jetcans per pilot at a time (1..20); then the twins wait (FULL). Default: 3.
EVEJS_SHIPWING_MINING_OVERFLOW_MAX_CANS_PER_OWNER=3
# Lifetime of an overflow jetcan, ms of scene time (600000..86400000); the server removes it then. Default: 7200000.
EVEJS_SHIPWING_MINING_OVERFLOW_CAN_LIFETIME_MS=7200000
# A jetcan with less time left than this gets no more ore, ms (0..3600000). Default: 600000.
EVEJS_SHIPWING_MINING_OVERFLOW_CAN_MIN_REMAINING_MS=600000
# At the end of a twin (warp, jump, logoff, dock, out of range...) its ore goes into a jetcan instead of being lost;
# at a return / board the rest after the unload. Default: 1.
EVEJS_SHIPWING_MINING_OVERFLOW_ON_END=1
# The ore of a twin goes into the hold of its real ship in your Ship Maintenance Bay (then the hauler of
# `!wing store`); the rest goes to your ship / a jetcan as before. A ship with ore cannot go back into the bay until
# you empty it. Default: 0.
EVEJS_SHIPWING_MINING_REAL_CARGO_ENABLED=0
# Time between two moves of one twin's ore to its real ship, ms (0..600000; 0 = every step with ore). Default: 10000.
EVEJS_SHIPWING_MINING_REAL_CARGO_INTERVAL_MS=10000
# Moves to the real ships per mod tick, all twins (1..50). Default: 4.
EVEJS_SHIPWING_MINING_REAL_CARGO_MAX_DEPOSITS_PER_TICK=4
# 1 = the cargo hold of the real ship takes the ore after its ore hold. Default: 1.
EVEJS_SHIPWING_MINING_REAL_CARGO_USE_CARGO_HOLD=1
# 1 = `!wing store <name>` names a ship in the bay that takes the ore when the twin's own ship is full. Default: 1.
EVEJS_SHIPWING_MINING_REAL_CARGO_STORE_ENABLED=1
# The holds of your ship and of the ships in its Ship Maintenance Bay: `!wing cargo [name]`, `!wing move <from> to
# <to|host> [type]` and the Cargo panel of the wing window. Default: 0.
EVEJS_SHIPWING_CARGO_PANEL_ENABLED=0
# One move order per pilot per this time, ms (0..60000). Default: 1000.
EVEJS_SHIPWING_CARGO_MOVE_MIN_INTERVAL_MS=1000
# Stacks moved by one order at most (1..100). Default: 20.
EVEJS_SHIPWING_CARGO_MOVE_MAX_ITEMS=20
# Item rows of one cargo list at most (5..500); more are counted as "+N more". Default: 60.
EVEJS_SHIPWING_CARGO_LIST_MAX_ROWS=60

# combat (flag off; = combat access, = the `attack` order and ASSIST)
# 1 = the twins' turret combat (and the `hold` order). Targets: native NPC ships only. Default: 0.
EVEJS_SHIPWING_COMBAT_ENABLED=0
# twins assist the pilot right after launch. Default: 1.
EVEJS_SHIPWING_COMBAT_ASSIST_ON_LAUNCH=1
# twins shoot NPCs that lock them or the pilot. Default: 1.
EVEJS_SHIPWING_COMBAT_DEFEND_WHEN_ATTACKED=1
# 1 = drifters are allowed targets. CONCORD never is. Default: 0.
EVEJS_SHIPWING_COMBAT_ALLOW_DRIFTER_TARGETS=0
# 1 = NPC site structures (e.g. a Habitation Module of a mission/anomaly) are allowed as the main target
# (Attack / Fire / assist). Never for auto-target, smartbombs, Vorton arcs or bombs. Default: 1.
EVEJS_SHIPWING_COMBAT_ALLOW_NPC_STRUCTURE_TARGETS=1
# Target at most this far from the pilot's ship (surface distance), m (1000..250000). Default: 15000.
# Limits auto-target range (clamped to min(autoRange, engageRange)). Manual Attack uses controlRangeMeters.
EVEJS_SHIPWING_COMBAT_ENGAGE_RANGE_METERS=15000
# largest orbit around a target, m (500..100000); ORBIT must stay <= CONTROL_RANGE_METERS.
# Default: 5000.
EVEJS_SHIPWING_COMBAT_ORBIT_MAX_METERS=5000
# Wait before a weapon tries again after a refused volley with no cycle time, ms (100..60000). Default: 2000.
EVEJS_SHIPWING_COMBAT_REACQUIRE_MS=2000
# volleys of all twins per mod tick (1..500); the rest wait for the next tick. Default: 16.
EVEJS_SHIPWING_COMBAT_MAX_VOLLEYS_PER_TICK=16
# Weapon effects of twins in the client. 0 = no effects (damage stays the same). Default: 1.
EVEJS_SHIPWING_COMBAT_FX_ENABLED=1
# used ammo is taken from the real ship at the end without a loss. Default: 1.
EVEJS_SHIPWING_COMBAT_AMMO_WRITE_BACK=1
# a twin that flies to its target gets the order again after this time when it does not come closer
# ms (500..60000). Default: 2000.
EVEJS_SHIPWING_COMBAT_APPROACH_RETUNE_MS=2000
# a target not in weapon range after this time is given up, ms (1000..600000). Default: 30000.
EVEJS_SHIPWING_COMBAT_APPROACH_TIMEOUT_MS=30000
# Auto target: 1 = an Attack from the window or `!wing attack` while the pilot has no target makes the copy pick an
# NPC itself (the NPC that locks the pilot, then one that locks the copies, then the nearest to the pilot). Follow,
# Hold, Mine and Return turn it off. Needs COMBAT_ENABLED=1. Default: 1.
EVEJS_SHIPWING_COMBAT_AUTO_TARGET_ENABLED=1
# Auto target: NPCs at most this far from the pilot, m (1000..250000); COMBAT_ENGAGE_RANGE_METERS limits it too.
# Default: 30000.
EVEJS_SHIPWING_COMBAT_AUTO_TARGET_RANGE_METERS=30000
# Auto target: scene scans per mod tick (copies of one pilot share a scan), 1..50. Default: 4.
EVEJS_SHIPWING_COMBAT_AUTO_SCANS_PER_TICK=4
# Auto target: entities read per scan at most, 100..20000. Default: 2000.
EVEJS_SHIPWING_COMBAT_AUTO_SCAN_MAX_ENTITIES=2000
# 1 = twins with launchers fire missiles, FOF and festival charges (the server flies the missile; the kill and
# its rewards go to the main character). Needs COMBAT_ENABLED=1. Defenders are not used. Default: 0.
EVEJS_SHIPWING_COMBAT_MISSILES_ENABLED=0
# 1 = twins with Entropic Disintegrators (Leshak, Vedmak, Damavik,...) fire them; the damage bonus grows with
# each shot at the same target ("spool"), as for the player. Needs COMBAT_ENABLED=1. Default: 0.
EVEJS_SHIPWING_COMBAT_PRECURSOR_ENABLED=0
# the spool stays when the pause since the last shot is not longer than (1 + this value) cycles; a longer
# pause or another target sets the spool to 0 (0..10). Default: 1.
EVEJS_SHIPWING_COMBAT_PRECURSOR_SPOOL_KEEP_CYCLES=1
# 1 = twins with Vorton Projectors (EDENCOM ships) fire them. Needs COMBAT_ENABLED=1. Default: 0.
EVEJS_SHIPWING_COMBAT_VORTON_ENABLED=0
# 1 = the Vorton shot also arcs to other NPC ships near the target. Arcs hit only NPCs the twin may shoot
# never a player, a host, another twin, a drone, a structure or CONCORD. 0 = the main target only. Default: 1.
EVEJS_SHIPWING_COMBAT_VORTON_ARCS_ENABLED=1
# 1 = twins with smartbombs or point defense use them. The wave hurts only NPC ships the twin may shoot
# never a player, a host, another twin, a drone, a structure or CONCORD. No crimewatch for the owner. Needs
# COMBAT_ENABLED=1. Default: 0.
EVEJS_SHIPWING_COMBAT_AREA_ENABLED=0
# 1 = the smartbombs of twins work also in highsec (still only on NPCs). Point defense stays off in highsec
# (server rule). Default: 0.
EVEJS_SHIPWING_COMBAT_AREA_ALLOW_HIGHSEC=0
# 1 = no wave while another player, his ship, twin, drone, fighter or structure, or CONCORD is in range.
# The owner's host, other twins, drones and fighters never hold the wave. Default: 0.
EVEJS_SHIPWING_COMBAT_AREA_HOLD_WHEN_BYSTANDER=0
# 1 = twins with a breacher pod launcher fire breacher pods (damage over time on the NPC). Bounty and killmail
# go to the main character. Needs COMBAT_ENABLED=1. Default: 0.
EVEJS_SHIPWING_COMBAT_BREACHER_ENABLED=0
# 1 = twins with a bomb launcher (stealth bombers) launch bombs. The blast hurts only NPC ships the twin may
# shoot - never a player, a host or another twin. No weapon timer for the owner. Not in highsec or lowsec (server
# rule). Needs COMBAT_ENABLED=1. Default: 0.
EVEJS_SHIPWING_COMBAT_BOMBS_ENABLED=0
# a bomb starts only when the angle between the twin's flight direction and the target is not more than this
# value, degrees (1..90). Default: 10.
EVEJS_SHIPWING_COMBAT_BOMB_MAX_ANGLE_DEG=10
# The ammo write-back leaves one server record ("receipt", key wing-ammo:...) per ammo stack. 1 = the
# mod removes the receipts it does not need any more: at start, and then every interval below. Needs
# COMBAT_ENABLED=1. 0 = the receipts stay (the server records grow). Default: 1.
EVEJS_SHIPWING_COMBAT_AMMO_RECEIPT_PRUNE_ENABLED=1
# Maximum receipts removed in one pass (1..100000). The rest goes in the next pass. Default: 500.
EVEJS_SHIPWING_COMBAT_AMMO_RECEIPT_PRUNE_MAX_PER_PASS=500
# Time between two passes while the server runs, ms (0..86400000). 0 = only at start. Default: 3600000.
EVEJS_SHIPWING_COMBAT_AMMO_RECEIPT_PRUNE_INTERVAL_MS=3600000
# A pass while the server runs removes only receipts older than this, ms (0..604800000). The pass at start
# removes all receipts that are not needed. Default: 3600000.
EVEJS_SHIPWING_COMBAT_AMMO_RECEIPT_PRUNE_MIN_AGE_MS=3600000

# active modules (flag off; variant A: no capacitor in a fight)
# 1 = at launch the mod checks the capacitor of the fit; hardeners and Damage Control are always on (in the twin's
# resists) and the local repairer runs below a damage level. Default: 0.
EVEJS_SHIPWING_ACTIVE_MODULES_ENABLED=0
# Unstable capacitor: shed = turn off the least needed modules until stable (local repair before hardeners; weapons
# never), disable = no active module, refuse = the twin is not launched (CAP_UNSTABLE). Default: shed.
EVEJS_SHIPWING_ACTIVE_CAP_UNSTABLE_POLICY=shed
# Stable = use per second <= peak recharge x this percent (10..200). Default: 100.
EVEJS_SHIPWING_ACTIVE_CAP_STABLE_FACTOR_PCT=100
# 1 = the weapons count in the capacitor check (lasers, hybrids). Default: 0 (: salvos of a twin use no
# capacitor, so a weapon cost does not turn off hardeners or repairers).
EVEJS_SHIPWING_ACTIVE_CAP_INCLUDE_WEAPONS=0
# Percent (0..100) of the Nosferatu transfer (powerTransferAmount / cycle time) the capacitor check counts as income,
# so a Nos + remote repair fit keeps its repairer. Counted with or without ewarEnabled (the Nos itself runs only with
# EWAR on). Default: 0 (no income, as before). Recommended for a logi twin: 100.
EVEJS_SHIPWING_ACTIVE_CAP_NOS_CREDIT_PCT=0
# 1 = shed turns off remote repair and cap transfer after the hardeners (a logi twin keeps its repairer and loses
# resists). Default: 0 (remote repair before the hardeners). Recommended for a logi twin: 1.
EVEJS_SHIPWING_ACTIVE_CAP_SHED_REMOTE_LAST=0
# The local repairer starts below this percent of its layer (1..99). Default: 70.
EVEJS_SHIPWING_ACTIVE_LOCAL_REP_START_PCT=70
# ... and stops at this percent (2..100; must be above the start, else both keys use 70 and 95 with a warning).
# Default: 95.
EVEJS_SHIPWING_ACTIVE_LOCAL_REP_STOP_PCT=95
# Repair cycles of all twins per mod tick (1..1000); the rest waits for the next tick. Default: 32.
EVEJS_SHIPWING_ACTIVE_MAX_CYCLES_PER_TICK=32
# Repair effects of twins in the client. 0 = no effects (the repair stays the same). Default: 1.
EVEJS_SHIPWING_ACTIVE_FX_ENABLED=1
# Wait before a repairer tries again after a failed cycle, ms (100..600000). Default: 5000.
EVEJS_SHIPWING_ACTIVE_RETRY_MS=5000

# remote repair (flag off; needs EVEJS_SHIPWING_ACTIVE_MODULES_ENABLED=1, else a warning and off)
# 1 = a twin with remote repairers (armor, shield, hull) repairs only the ship of its pilot and the pilot's other
# twins. Never other players, their twins, the fleet, NPCs or structures. The capacitor check counts the remote
# repairers only when this is 1 at launch (a change needs a new launch). Default: 0.
EVEJS_SHIPWING_LOGI_ENABLED=0
# A ship is repaired when the layer of the module (armor, shield, hull) is below this percent (1..100). The lowest
# goes first; same percent = the pilot's ship first. Default: 90.
EVEJS_SHIPWING_LOGI_REPAIR_THRESHOLD_PCT=90
# Time between two target checks of a remote repairer, and between two move orders to a far target, ms
# (100..60000). Also the wait after a refused cycle. Default: 1000.
EVEJS_SHIPWING_LOGI_RETARGET_MS=1000
# A twin flies to a far target at this distance at most (500..100000; also not more than the module's optimal).
# Default: 5000.
EVEJS_SHIPWING_LOGI_APPROACH_METERS=5000
# A twin that does not get nearer to its repair target in this time stops flying to it, ms (500..60000).
# Must be above LOGI_RETARGET_MS; else both keys go back to the defaults 1000 and 3000 (a warning). Default: 3000.
EVEJS_SHIPWING_LOGI_MOVE_LEASE_MS=3000
# 1 = a twin with a capacitor transmitter gives capacitor to the pilot's ship (never to twins). Default: 0.
EVEJS_SHIPWING_LOGI_CAP_TRANSFER_ENABLED=0

# AB/MWD (flag off; needs EVEJS_SHIPWING_ACTIVE_MODULES_ENABLED=1, else a warning and off)
# 1 = a twin with an afterburner or a microwarpdrive turns it on while it flies to a far target, and off near the
# target or when it stops. No capacitor use. The capacitor check counts the module only when this is 1 at launch;
# an unstable fit turns AB/MWD off first. Default: 0.
EVEJS_SHIPWING_ACTIVE_PROP_ENABLED=0
# AB/MWD on only when the target is farther than this, in meters (0..250000). Default: 5000.
EVEJS_SHIPWING_ACTIVE_PROP_MIN_DISTANCE_METERS=5000

# --- EWAR (flag off; needs ACTIVE_MODULES_ENABLED=1 and COMBAT_ENABLED=1) ---
# 1 = a twin with an energy nosferatu, energy neutralizer, stasis webifier, warp scrambler or warp disruptor runs it
# on its combat target (NPC ships only). The server applies the effect; the mod takes it off again on a target
# change, lock loss, end of the fight, recall, warp and twin loss. No crimewatch, no capacitor use in a fight.
# Without ACTIVE_MODULES_ENABLED=1 or COMBAT_ENABLED=1 a warning and no EWAR. Default: 0.
EVEJS_SHIPWING_EWAR_ENABLED=0
# Wait before a module tries again after a refused lock, a target out of range or a server refusal, ms
# (100..60000). Default: 2000.
EVEJS_SHIPWING_EWAR_RETRY_MS=2000
# EWAR cycles per mod tick for all twins together (1..1000); the rest waits a tick. Default: 32.
EVEJS_SHIPWING_EWAR_MAX_CYCLES_PER_TICK=32
# Time between two sweeps of effects left by twins that are gone from a system, ms (1000..600000). Default: 10000.
EVEJS_SHIPWING_EWAR_ORPHAN_SWEEP_MS=10000

# --- safe logoff (flags off; both 0 = the game's safe logoff stays as it is) ---
# 1 = an accepted twin order (launch, return, hold, mine, attack; chat, window or mirror) stops a running safe
# logoff, as a drone order does. Default: 0.
EVEJS_SHIPWING_SAFE_LOGOFF_ABORT_ON_ORDER=0
# 1 = safe logoff does not start while a twin is in space (also on its way back); the client shows the
# "drones connected" text. Default: 0.
EVEJS_SHIPWING_SAFE_LOGOFF_BLOCK_WHILE_DEPLOYED=0

# --- command burst (flag off) ---
# 1 = the twins of a pilot get the command bursts of his own ship (one burst affinity group per pilot on his ship and
# his twins), and the burst bonuses reach the local repair and remote repair modules of the twins (the second one
# needs EVEJS_SHIPWING_ACTIVE_MODULES_ENABLED=1 and EVEJS_SHIPWING_LOGI_ENABLED=1). Mining twins read the bonus by
# themselves. While /rr runs on the pilot's ship, the twins get no bursts. Default: 0.
EVEJS_SHIPWING_BURST_ENABLED=0
# 1 = the bursts also change the twin's own ship values (shield/armor/hull HP, resists, signature radius, agility,
# lock range and scan resolution); when the bursts end, the twin gets back the values it had at launch. 0 = only the
# bursts of point one. Works only with EVEJS_SHIPWING_BURST_ENABLED=1. Default: 1.
EVEJS_SHIPWING_BURST_SHIP_STATS_ENABLED=1
# Most twin ship value updates for all twins in one tick; the others wait for the next tick. 1..1000. Default: 8.
EVEJS_SHIPWING_BURST_MAX_REBUILDS_PER_TICK=8

# --- copy drones (flag off) ---
# 1 = twins launch the real combat drones of their ship's drone bay (the ship in the SMB) at the twin's attack target
# and take them back to that bay when the twin ends. Needs EVEJS_SHIPWING_COMBAT_ENABLED=1 (the target). Default: 0.
EVEJS_SHIPWING_DRONES_ENABLED=0
# Drone mode of a new twin: auto (drones go out with a target) or off (drones stay in the bay). Default: auto.
EVEJS_SHIPWING_DRONE_DEFAULT_MODE=auto
# Most drones of one twin in space, 1..25; also the pilot's maxActiveDrones and the hull bandwidth. Default: 5.
EVEJS_SHIPWING_DRONE_MAX_PER_COPY=5
# Most drones of all twins of one pilot, 0..100; 0 = no cap. The pilot's own drones do not count. Default: 0.
EVEJS_SHIPWING_DRONE_MAX_PER_PILOT=0
# Drones without a target for this long (ms) go back to the drone bay, 0..3600000; 0 = never. Default: 60000.
EVEJS_SHIPWING_DRONE_IDLE_RECALL_MS=60000
# Most drone launches for all twins in one tick, 1..50. Default: 5.
EVEJS_SHIPWING_DRONE_LAUNCHES_PER_TICK=5
# Most drone combat cycles for all twins in one tick, 1..500; the others wait. Default: 16.
EVEJS_SHIPWING_DRONE_MAX_CYCLES_PER_TICK=16
# 1 = the shot effect of a twin's drone is shown to observers. Default: 1.
EVEJS_SHIPWING_DRONE_FX_ENABLED=1
# 1 = repair drones of the bay repair the pilot's ship and his own twins (below the logi threshold
# EVEJS_SHIPWING_LOGI_REPAIR_THRESHOLD_PCT); the twin's remote repair target first. Needs DRONES_ENABLED. Default: 0.
EVEJS_SHIPWING_DRONE_REPAIR_ENABLED=0
# 1 = mining drones of the bay (Mining Drone, Ice Harvesting Drone) mine the rock of a twin in MINE; the ore goes
# into the twin's hold and is unloaded with the rest. Needs DRONES_ENABLED and MINING_ENABLED. Default: 0.
EVEJS_SHIPWING_DRONE_MINING_ENABLED=0
# 1 = at the start the twins' drones left in space by the last run (restart, scene gone, a refused recall) go back
# to the drone bay of their ship (journal wingDrones.json in the data dir). 0 = the journal is still kept, the start
# returns nothing. Default: 1.
EVEJS_SHIPWING_DRONE_RECLAIM_ON_BOOT=1
# --- NPC aggro on twins (flag off) ---
# 1 = NPCs treat twins like player ships: NPCs that attack players lock and shoot twins in range, and an NPC shot by
# a twin fires back. The pilot gets no crimewatch flags. Twins die more often: a lost twin is a lost real ship.
# Without EVEJS_SHIPWING_COMBAT_ENABLED=1 the twins do not fire back. Read at server start (restart to change).
# Default: 0.
EVEJS_SHIPWING_NPC_AGGRO_ENABLED=0
# --- Formations (flag on; every pilot flies `none` = follow until he picks a formation) ---
# 1 = a pilot may pick a formation (wedge, line, column, sphere): his twins keep slots around the host, relative to
# its flight direction. The choice is kept in wingFormations.json in the data dir. 0 = always follow. Default: 1.
EVEJS_SHIPWING_FORMATION_ENABLED=1
# Surface gap between neighbour slots in meters (plus 2x the largest ship radius), 100..20000. Default: 1000.
EVEJS_SHIPWING_FORMATION_SPACING_METERS=1000
# Farthest slot from the host in meters, 1000..250000; larger formations are scaled down. Keep it below
# CONTROL_RANGE_METERS. Default: 12000.
EVEJS_SHIPWING_FORMATION_MAX_DISTANCE_METERS=12000
# Most frequent new GotoPoint of one twin (ms), 250..60000. Default: 1000.
EVEJS_SHIPWING_FORMATION_RETUNE_MS=1000
# A slot point that moved less than this (meters) sends no new GotoPoint, 10..10000. Default: 150.
EVEJS_SHIPWING_FORMATION_REPOINT_METERS=150
# The slot point is moved ahead by the host velocity times this (ms), 0..10000. Default: 1000.
EVEJS_SHIPWING_FORMATION_LEAD_MS=1000
# Angle of the wedge arms from the flight axis (degrees), 10..80. Default: 45.
EVEJS_SHIPWING_FORMATION_WEDGE_ANGLE_DEG=45
# Most pilots in wingFormations.json, 100..1000000; above it a choice lives in memory only. Default: 10000.
EVEJS_SHIPWING_FORMATION_MAX_PILOTS=10000
# A mining twin in a formation mines from its slot while the slot is within the mining range minus this (meters) of
# the rock; farther = it flies to the rock. 0..10000. Default: 500.
EVEJS_SHIPWING_FORMATION_MINE_MARGIN_METERS=500
# A twin at its rock goes back to the slot only when the slot is this much (meters) nearer than the margin above,
# so it does not jerk at the edge. 0..20000. Default: 1000.
EVEJS_SHIPWING_FORMATION_MINE_HYSTERESIS_METERS=1000
# Twins ended by a warp or a jump of the host go out again from the SMB once the host landed / is in the new system
# and not cloaked (pilot with a formation other than none). 0 = they end as before. Default: 1.
EVEJS_SHIPWING_FORMATION_RELAUNCH_ENABLED=1
# The relaunch is dropped after this (ms) without the conditions, 10000..600000. Default: 120000.
EVEJS_SHIPWING_FORMATION_RELAUNCH_TIMEOUT_MS=120000
# Most relaunches per tick for all pilots, 1..20. Default: 4.
EVEJS_SHIPWING_FORMATION_RELAUNCH_PER_TICK=4

# salvage on ships (flag off): `!wing salvage [name]` / the Salv button
# Copies with a Salvager salvage wrecks around your ship; the salvage goes to your ship's cargo. Default: 0.
EVEJS_SHIPWING_SALVAGE_ENABLED=0
# Wreck search range around the host, m (1000..100000); keep it <= CONTROL_RANGE_METERS. Default: 15000.
EVEJS_SHIPWING_SALVAGE_SEARCH_RANGE_METERS=15000
# The host may be this much farther (m) from the wreck than the search range before the copy gives it up
# (500..20000). Default: 2500.
EVEJS_SHIPWING_SALVAGE_LEASH_MARGIN_METERS=2500
# Wait before the next wreck search when there is none, ms (1000..600000). Default: 10000.
EVEJS_SHIPWING_SALVAGE_SEEK_RETRY_MS=10000
# Wait before the next try when your cargo is full, ms (1000..600000). Default: 30000.
EVEJS_SHIPWING_SALVAGE_FULL_RETRY_MS=30000
# Free cargo below this (m3, 0..1000) stops the Salvagers (FULL). Default: 1.
EVEJS_SHIPWING_SALVAGE_MIN_FREE_CARGO_M3=1
# Wreck picks per mod tick (1..50). Default: 2.
EVEJS_SHIPWING_SALVAGE_MAX_SEEKS_PER_TICK=2
# 1 = salvage drones of the bay (Salvage Drone I) salvage the copy's wreck; the salvage goes to your ship's cargo.
# A copy without a Salvager takes the salvage order with them. Needs DRONES_ENABLED and SALVAGE_ENABLED. Default: 0.
EVEJS_SHIPWING_DRONE_SALVAGE_ENABLED=0
# Distance (m) a copy without a Salvager keeps from its wreck while its drones salvage it (500..50000). Default: 5000.
EVEJS_SHIPWING_SALVAGE_DRONE_WORK_RANGE_METERS=5000

# 1 = Board Ship on your own wing copy ends the copy and puts you in the real ship, launched from the maintenance
# bay at the copy's spot. Needs a restart. Default: 0 (compose: 1).
EVEJS_SHIPWING_BOARD_ENABLED=0
# Most distance (m) between your ship and the copy for a board (0..6550, the server's boarding range). Default: 6550.
EVEJS_SHIPWING_BOARD_RANGE_METERS=6550
# Wait (ms) between two boards of one pilot (0..60000). Default: 3000.
EVEJS_SHIPWING_BOARD_COOLDOWN_MS=3000
# 1 = after you leave the ship that launched the copies (Eject to the capsule, or Board another ship / a copy) in the
# same place, the copies stay and hold near the empty ship, and you can board them from the capsule. Needs
# BOARD_ENABLED. Default: 0 (compose: 1).
EVEJS_SHIPWING_BOARD_ORPHAN_ENABLED=0
# How long (ms) the copies wait near the empty ship (10000..600000). Default: 120000.
EVEJS_SHIPWING_BOARD_ORPHAN_GRACE_MS=120000
# Most distance (m) between your capsule/ship and the empty ship for a board (0..5000, the server's launch range
# of the maintenance bay). Default: 5000.
EVEJS_SHIPWING_BOARD_HOST_RANGE_METERS=5000
# 1 = after a board the copy (and its drones) also vanish from your screen when the server lost track of what your
# client sees (no "ghost" of the copy left). 0 = off, if the client reacts badly. Needs BOARD_ENABLED. Default: 1.
EVEJS_SHIPWING_BOARD_RESEND_REMOVAL=1
# 1 = after a board, Board back on the ship that launched the copy puts the ship you left into its maintenance bay
# (within 2500 m; farther it stays in space for the normal Scoop). Needs BOARD_ENABLED. Default: 1.
EVEJS_SHIPWING_BOARD_BACK_STOW_ENABLED=1
# How long (ms) after a board the Board back still stows the ship you left (0..86400000, 0 = no limit).
# Default: 1800000 (30 minutes).
EVEJS_SHIPWING_BOARD_BACK_STOW_MAX_AGE_MS=1800000
# 1 = Board back first moves the ore / other cargo the maintenance bay refuses from the ship you left into this ship
# (ore hold, then fleet hangar; nothing moves if it does not all fit). Needs BOARD_ENABLED and BOARD_BACK_STOW_ENABLED.
# Default: 0.
EVEJS_SHIPWING_BOARD_BACK_CARGO_UNLOAD_ENABLED=0
# Most cargo stacks one Board back moves (1..500); more stacks = nothing moves, empty the ship by hand. Default: 50.
EVEJS_SHIPWING_BOARD_BACK_CARGO_MAX_STACKS=50
# 1 = "Scoop to Ship Maintenance Bay" on your live copy sends it back to the bay (as Return). Needs BOARD_ENABLED and
# a restart. Default: 1.
EVEJS_SHIPWING_SCOOP_RETURN_ENABLED=1

# Extra [debug] lines in the server log. Changes nothing in the game. Default: 0.
EVEJS_SHIPWING_DEBUG=0
