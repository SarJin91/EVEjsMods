# planetaryDrill mod - configuration template
#
# Copy this file to `.env` in this same folder and change the values you want.
# Order of precedence, highest first: the real environment (Docker compose, a
# start script), then this file, then the built-in default.
# Format: KEY=value, one per line, whole-line `#` comments only.
# An invalid value: the mod logs the problem and installs nothing.
# A change takes effect the next time EVE.js starts.

# Whole mod on/off (1/0, true/false, on/off). Default: 0 (off).
# DANGER: turning it off after drills have run deletes their stock at
# the next sovereignty bootstrap (the Skyhook loses its reagent definition).
# EVEJS_PDRILL_ENABLED=1

# P0 units per hour of a drill at a planet with a single resource; with several
# resources the drill gets quality(selected) / sum(qualities) of it. Default 20000.
# EVEJS_PDRILL_BASE_UNITS_PER_HOUR=20000

# Harvest cycle length in seconds, 60..86400. Default 3600.
# EVEJS_PDRILL_CYCLE_SECONDS=3600

# Bay capacity in cycles (secured capacity = amount per cycle x this). Default 168.
# EVEJS_PDRILL_STORAGE_CYCLES=168

# Drills per solar system / per corporation, lowest Skyhook item ID first.
# 0 = no limit. EveJS allows one Skyhook per planet anyway. Defaults 3 / 10.
# EVEJS_PDRILL_MAX_PER_SYSTEM=3
# EVEJS_PDRILL_MAX_PER_CORPORATION=10

# The Planetary Drill item (mods/customTypes) that launches as an Orbital
# Skyhook 81080. 0 = conversion off (the item takes the generic orbital path),
# otherwise 340000..349999. Default 340100. The launch ledger lives in
# <EVEJS_DATA_ROOT>/mods/planetaryDrill/launch-ledger.json.
# EVEJS_PDRILL_LAUNCH_TYPE_ID=340100

# Only Skyhooks launched from the drill item mine (1/0). Default: 0 (every
# Skyhook outside sov null-sec mines).
# DANGER: with 1, every Skyhook anchored before (or launched from a plain
# 81080) stops mining - amount 0, its stock stays and can be extracted.
# EVEJS_PDRILL_DRILL_ITEMS_ONLY=0
