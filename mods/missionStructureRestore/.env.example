# missionStructureRestore mod - configuration template
#
# Copy this file to `.env` in this same folder and change the values you want.
# Order of precedence, highest first: the real environment (Docker compose, a
# start script), then this file, then the built-in defaults.
# Format: KEY=value, one per line, whole-line `#` comments only.
# An invalid value: the mod logs the problem and installs nothing.
# A change takes effect the next time EVE.js starts.

# Whole mod on/off (1/0, true/false, on/off). Default: 1.
# Off = vanilla EveJS: after a server restart a mission whose objective is a
# structure of an already spawned wave (e.g. the Habitation Module in
# "Avenge A Fallen Comrade") has no such structure and cannot be completed.
# EVEJS_MISSION_STRUCTURE_RESTORE=1

# One log line per restored structure (instance, template, wave, entry key,
# new entity ID, room). Default: 1. Errors are always logged.
# EVEJS_MISSION_STRUCTURE_RESTORE_LOG=1

# Kill switch for the preload itself (any non-empty value): the loader file is
# required but installs nothing, not even the text probe.
# EVEJS_MISSION_STRUCTURE_RESTORE_NO_INSTALL=1
