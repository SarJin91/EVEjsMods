# dailyGoalsPersist mod - configuration template
#
# Copy this file to `.env` in this same folder and change the values you want.
# Order of precedence, highest first: the real environment (Docker compose, a
# start script), then this file, then the built-in defaults.
# Format: KEY=value, one per line, whole-line `#` comments only.
# A value outside its range: the mod logs the problem and installs nothing.
# A change takes effect the next time EVE.js starts.

# Whole mod on/off (1/0, true/false, on/off). Default: 1.
# Off = vanilla EveJS: daily goal state is not written to disk after the
# first write and is lost on restart.
# EVEJS_DAILY_GOALS_PERSIST=1

# Log line for a daily-goal Redeem answered with 404 (character, goal UUID,
# daily and monthly error codes). Default: 1.
# EVEJS_DAILY_GOALS_PERSIST_REDEEM_LOG=1

# Same character + UUID + codes is logged at most once per this many ms;
# repeats are counted and shown as "(+N suppressed)". 0..3600000, default 60000.
# EVEJS_DAILY_GOALS_PERSIST_LOG_INTERVAL_MS=60000

# At most this many 404 lines in total per interval. 1..1000, default 20.
# EVEJS_DAILY_GOALS_PERSIST_LOG_MAX_PER_INTERVAL=20

# How many distinct keys the rate limiter remembers (oldest dropped).
# 1..100000, default 256.
# EVEJS_DAILY_GOALS_PERSIST_LOG_MAX_KEYS=256
