# customTypes mod - configuration template
#
# Copy this file to `.env` in this same folder and change the values you want.
# Order of precedence, highest first: the real environment (Docker compose, a
# start script), then this file, then the built-in default.
# Format: KEY=value, one per line, whole-line `#` comments only.
# An invalid value: the mod logs the problem and installs nothing.
# A change takes effect the next time EVE.js starts.

# Whole mod on/off (1/0, true/false, on/off). Default: 0.
# On = the types and blueprints of data/*.json exist on the server. The client
# needs the same packs applied (client/README.md), otherwise it does not know
# the types and the Industry window cannot install their jobs.
# EVEJS_CUSTOMTYPES_ENABLED=0

# DANGER (1/0). Default: 0. Needs ENABLED=1.
# On = after the world boots, every item of a typeID declared in data/*.json is
# deleted (hangars, containers, everywhere). Use it once before removing the
# mod: finish or cancel industry jobs of these blueprints first.
# EVEJS_CUSTOMTYPES_CLEANUP=0
# CLEANUP refuses while an outstanding contract holds a custom item: set
# EVEJS_CUSTOMTYPES_SHOP_DELIST=1 and restart first (README "Remove").

# ConnectJob diagnostic trace (1/0). Default: 1. Log only: when the Industry
# window opens a pack blueprint, one CONNECTJOB_TRACE line (blueprint, owner,
# facility, definition materials, the materials sent to the client) per
# character/blueprint/activity per window. A bad value turns off the trace only.
# EVEJS_CUSTOMTYPES_CONNECTJOB_TRACE=1
# Window in minutes, 1-1440. Default: 10.
# EVEJS_CUSTOMTYPES_CONNECTJOB_TRACE_MINUTES=10

# --- Blueprint shop (README "Blueprint shop") ---
# A bad shop value turns off the shop only; types and blueprints keep working.
# Public item exchange contracts of an NPC corporation, 1 blueprint each.
# On/off (needs EVEJS_CUSTOMTYPES_ENABLED=1). Default: 0 (compose.yaml sets 1).
# EVEJS_CUSTOMTYPES_SHOP_ENABLED=0
# 1 = delete every shop contract (items back to the issuer's hangar), create none.
# EVEJS_CUSTOMTYPES_SHOP_DELIST=0
# 1 = the shop scan filters the live contract rows (no clone of every contract);
# a failed read = the vendor list. Default: 0.
# EVEJS_CUSTOMTYPES_SHOP_LIVE_CONTRACT_READ=0
# Hub stations, 1-20 IDs (Jita 4-4, Amarr 8, Dodixie 9-19, Rens 6-8, Hek 8-12).
# EVEJS_CUSTOMTYPES_SHOP_STATIONS=60003760,60008494,60011866,60004588,60005686
# Issuer corporation (needs a CEO in its record). Default: Outer Ring Excavations.
# EVEJS_CUSTOMTYPES_SHOP_ISSUER_CORPORATION_ID=1000129
# Wallet division that receives the ISK, 1000-1006 (8192 sales per division).
# EVEJS_CUSTOMTYPES_SHOP_ISSUER_ACCOUNT_KEY=1000
# Contracts per (hub, blueprint type), 1-10.
# EVEJS_CUSTOMTYPES_SHOP_CONTRACTS_PER_TYPE=3
# original (BPO) or copy (BPC with COPY_RUNS runs, 1-1000, clipped to the
# blueprint's max runs).
# EVEJS_CUSTOMTYPES_SHOP_BLUEPRINT_KIND=original
# EVEJS_CUSTOMTYPES_SHOP_COPY_RUNS=10
# Contract duration in days (1-90); renewed when fewer than RENEW_HOURS (1-168,
# below CONTRACT_DAYS*24) are left.
# EVEJS_CUSTOMTYPES_SHOP_CONTRACT_DAYS=30
# EVEJS_CUSTOMTYPES_SHOP_RENEW_HOURS=24
# Prices in ISK (1-1000000000000): PI tier by the Industry skill level, drill
# pack, other packs, and typeID=isk overrides (comma separated).
# EVEJS_CUSTOMTYPES_SHOP_PRICE_P1=2000000
# EVEJS_CUSTOMTYPES_SHOP_PRICE_P2=8000000
# EVEJS_CUSTOMTYPES_SHOP_PRICE_P3=25000000
# EVEJS_CUSTOMTYPES_SHOP_PRICE_P4=60000000
# EVEJS_CUSTOMTYPES_SHOP_PRICE_DRILL=150000000
# EVEJS_CUSTOMTYPES_SHOP_PRICE_DEFAULT=10000000
# EVEJS_CUSTOMTYPES_SHOP_PRICE_OVERRIDES=
# Officer blueprints (pack officer-blueprints): own price, hubs (1-20 IDs, only
# those also in SHOP_STATIONS are used) and contracts per type (0-10, 0 = not
# listed). They are not multiplied by the 5 hubs and CONTRACTS_PER_TYPE.
# EVEJS_CUSTOMTYPES_SHOP_PRICE_OFFICER=1000000000
# EVEJS_CUSTOMTYPES_SHOP_OFFICER_STATIONS=60003760
# EVEJS_CUSTOMTYPES_SHOP_OFFICER_CONTRACTS_PER_TYPE=1
# Pass interval (10-3600 s), first pass after bootWorld (0-3600 s), vendor
# actions per pass (1-500), backoff ceiling after failing passes (1-240 min).
# EVEJS_CUSTOMTYPES_SHOP_PASS_SECONDS=30
# EVEJS_CUSTOMTYPES_SHOP_FIRST_PASS_SECONDS=30
# EVEJS_CUSTOMTYPES_SHOP_MAX_ACTIONS_PER_PASS=40
# EVEJS_CUSTOMTYPES_SHOP_BACKOFF_MAX_MINUTES=30
