# Living New Eden mod - configuration template
#
# Copy this file to `.env`, in this same folder, and uncomment the values you
# want. A package never contains a `.env`, and the Docker image never gets one
# (.dockerignore); in Docker set the same names in `environment:` of the
# `server` service (compose.override.yaml).
#
# Order of precedence, highest first: the real environment (Docker compose, a
# start script), then this file, then the launcher's settings.json, then the
# built-in defaults. When a value here overrides a launcher setting, the
# console says so at startup.
#
# Format: KEY=value, one per line. Whole-line `#` comments only. Switches take
# 1, 0, true or false. A value the mod cannot read is ignored with a warning and
# the next layer down applies. An EVEJS_LNE_* name the mod does not know is
# reported as a warning (a typo never passes silently).
#
# A change here takes effect the next time EveJS starts.

# enabled - Main switch. 0 = the mod loads, starts no services and writes one line
# "disabled by config" in the log (the launcher's own switch removes the preload instead).
# Default: 1.
# EVEJS_LNE_ENABLED=

# debug - Prints extra [debug] lines in the console window. Changes nothing in the game.
# Default: 0.
# EVEJS_LNE_DEBUG=

# modules.graph.enabled - Builds the map of systems, gates and regions the mod plans on. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_GRAPH_ENABLED=

# modules.world.enabled - Keeps faction territory, influence and occupation in the mod's own database. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_WORLD_ENABLED=

# modules.fleets.enabled - Moves NPC faction fleets on the map as records, without spawning ships. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_FLEETS_ENABLED=

# modules.scheduler.enabled - Runs the mod's due work in small budgeted passes about once a second, outside the server tick. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_SCHEDULER_ENABLED=

# modules.strategy.enabled - Lets factions choose targets, fronts and fleet orders. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_STRATEGY_ENABLED=

# modules.battle.enabled - Settles fights between virtual fleets away from players. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_BATTLE_ENABLED=

# modules.events.enabled - Turns the mod's world state into in-game events near players. Creates objects in the game world the player can see. Off by default.
# Default: 0.
# EVEJS_LNE_EVENTS_ENABLED=

# modules.sites.enabled - Spawns combat sites in space from faction activity. Creates objects in the game world the player can see. Off by default.
# Default: 0.
# EVEJS_LNE_SITES_ENABLED=

# modules.materialization.enabled - Turns virtual fleets near a player into real NPC ships in space. Creates objects in the game world the player can see. Off by default.
# Default: 0.
# EVEJS_LNE_MATERIALIZATION_ENABLED=

# modules.persistence.enabled - Stores the mod's state in its own database under the data folder. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_PERSISTENCE_ENABLED=

# modules.telemetry.enabled - Measures the mod's work per tick and writes its metrics. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_TELEMETRY_ENABLED=

# modules.presence.enabled - Tracks which systems have logged-in players, read only. Off puts this module to sleep.
# Default: 1.
# EVEJS_LNE_PRESENCE_ENABLED=

# modules.virtualCorps.enabled - Creates real EveJS alliances, corporations and characters per qualifying faction. Off puts this module to sleep.
# Default: 0.
# EVEJS_LNE_VIRTUALCORPS_ENABLED=

# modules.sovProjection.enabled - Projects mod controller changes onto EveJS native sovereignty (Sov Hubs, claims). Creates objects in the game world the player can see. Off by default.
# Default: 0.
# EVEJS_LNE_SOVPROJECTION_ENABLED=

# modules.structures.enabled - Projects faction Upwell stations onto real EveJS structures. Creates objects in the game world the player can see. Off by default.
# Default: 0.
# EVEJS_LNE_STRUCTURES_ENABLED=

# limits.maxVirtualFleets - Most NPC faction fleets the mod keeps on the map at once. Range 1..5000 (outside: clamped).
# Default: 1000 (scaling bench guard).
# EVEJS_LNE_MAX_VIRTUAL_FLEETS=

# limits.maxDueEventsPerPass - Most due events the scheduler handles in one pass. Range 1..1024 (outside: clamped).
# Default: 64.
# EVEJS_LNE_MAX_DUE_EVENTS_PER_PASS=

# limits.maxSchedulerWorkMs - Most milliseconds of server time the mod's scheduler uses in one pass. Range 0.5..50 (outside: clamped).
# Default: 8.
# EVEJS_LNE_MAX_SCHEDULER_WORK_MS=

# limits.maxBattleResolutionsPerPass - Most fights between virtual fleets settled in one pass. Range 1..256 (outside: clamped).
# Default: 2.
# EVEJS_LNE_MAX_BATTLE_RESOLUTIONS_PER_PASS=

# limits.maxLiveMaterializationsPerSystem - Most real NPC ships the mod puts in space in one solar system. Range 0..256 (outside: clamped).
# Default: 48.
# EVEJS_LNE_MAX_LIVE_MATERIALIZATIONS_PER_SYSTEM=

# limits.maxLiveMaterializationsGlobal - Most real NPC ships the mod puts in space across the whole universe. Range 0..1000 (outside: clamped).
# Default: 120.
# EVEJS_LNE_MAX_LIVE_MATERIALIZATIONS_GLOBAL=

# limits.maxNewSitesPerSystemPerWindow - Most new combat sites the mod spawns in one solar system per time window. Range 0..32 (outside: clamped).
# Default: 2.
# EVEJS_LNE_MAX_NEW_SITES_PER_SYSTEM_PER_WINDOW=

# limits.maxActiveFrontsPerFaction - Most war fronts one NPC faction fights on at the same time. Range 1..16 (outside: clamped).
# Default: 6.
# EVEJS_LNE_MAX_ACTIVE_FRONTS_PER_FACTION=

# limits.maxCatchUpEventsPerPass - Most missed events the mod replays per pass after the server was off. Range 1..1024 (outside: clamped).
# Default: 32.
# EVEJS_LNE_MAX_CATCH_UP_EVENTS_PER_PASS=

# limits.maxSovWritesPerWindow - Most sovereignty table flushes allowed per time window. Range 1..100 (outside: clamped).
# Default: 8.
# EVEJS_LNE_MAX_SOV_WRITES_PER_WINDOW=

# limits.sovWriteWindowMs - Time window in milliseconds for the sovereignty write budget. Range 1000..3600000 (outside: clamped).
# Default: 300000.
# EVEJS_LNE_SOV_WRITE_WINDOW_MS=

# persistence.exclusiveLock - Debugging only: 0 opens world.sqlite in NORMAL locking mode so an outside
# tool can read it while the server runs. No protection against a second writer then. Not in the launcher.
# Default: 1.
# EVEJS_LNE_PERSISTENCE_EXCLUSIVE_LOCK=

# persistence.busyTimeoutMs - How long a database write waits for a brief lock held by another connection. A second server process on the same file is refused at once. Range 0..10000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_PERSISTENCE_BUSY_TIMEOUT_MS=

# persistence.journalMaxPayloadBytes - Internal safety cap: largest journal entry payload (UTF-8 bytes of its JSON).
# Not in the launcher. Range 256..262144 (outside: clamped).
# Default: 16384.
# EVEJS_LNE_PERSISTENCE_JOURNAL_MAX_PAYLOAD_BYTES=

# persistence.maxRowsPerTransaction - Most rows the mod changes in its database in one transaction. Range 1..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_PERSISTENCE_MAX_ROWS_PER_TRANSACTION=

# persistence.maxWriteMsPerPass - Most milliseconds the mod spends writing its database in one scheduler pass. Range 0.5..50 (outside: clamped).
# Default: 5.
# EVEJS_LNE_PERSISTENCE_MAX_WRITE_MS_PER_PASS=

# persistence.dbFile - Test profile only: file name of the mod's database under the data folder (a-z, 0-9, -,
# then .sqlite). Any name other than world.sqlite prints a warning; the world database is not touched.
# Not in the launcher. Default: world.sqlite.
# EVEJS_LNE_PERSISTENCE_DB_FILE=

# persistence.managedCheckpoint - Internal: the mod runs small WAL checkpoints of its database itself, right after a
# game tick, instead of SQLite inside a write. 0 = SQLite's own auto-checkpoint (emergency fallback).
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_PERSISTENCE_MANAGED_CHECKPOINT=

# persistence.walSafetyPages - Internal: SQLite's own auto-checkpoint as a fuse while the mod manages checkpoints (pages).
# Not in the launcher. Range 1000..100000 (outside: clamped).
# Default: 10000.
# EVEJS_LNE_PERSISTENCE_WAL_SAFETY_PAGES=

# persistence.checkpointTargetFrames - Internal: estimated WAL frames at which a normal checkpoint runs.
# Not in the launcher. Range 100..5000 (outside: clamped).
# Default: 600.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_TARGET_FRAMES=

# persistence.checkpointForceFrames - Internal: estimated WAL frames at which a checkpoint runs whatever the load.
# Not in the launcher. Range 500..50000 (outside: clamped).
# Default: 4000.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_FORCE_FRAMES=

# persistence.checkpointMaxIntervalMs - Internal: longest time between checkpoints while the mod writes (loss window on a
# power cut of the host or the Docker VM; a crash or container restart loses nothing). OVERLOADED/SHED defer it,
# then checkpointForceFrames bounds the WAL.
# Not in the launcher. Range 1000..600000 (outside: clamped).
# Default: 120000.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_MAX_INTERVAL_MS=

# persistence.checkpointSlowMs - Internal: a checkpoint that took at least this long (ms) starts a backoff: no
# target / interval checkpoint for checkpointSlowBackoffMs (the force checkpoint still runs). 0 = off.
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_SLOW_MS=

# persistence.checkpointSlowBackoffMs - Internal: length of that backoff (ms). Longer than
# checkpointMaxIntervalMs = warning (wider loss window on a power cut).
# Not in the launcher. Range 0..600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_SLOW_BACKOFF_MS=

# persistence.warmupEnabled - Internal: after opening, read the database file once in the background (off the main
# thread) so the first writes after a cold VM start do not wait for the disk. 0 = off.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_PERSISTENCE_WARMUP_ENABLED=

# persistence.warmupChunkBytes - Internal: bytes per warm-up read (one read at a time).
# Not in the launcher. Range 65536..16777216 (outside: clamped).
# Default: 1048576.
# EVEJS_LNE_PERSISTENCE_WARMUP_CHUNK_BYTES=

# persistence.warmupPauseMs - Internal: pause between warm-up reads (less disk contention with the game server).
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 5.
# EVEJS_LNE_PERSISTENCE_WARMUP_PAUSE_MS=

# persistence.warmupMaxBytes - Internal: most bytes the warm-up reads; a larger file is read only up to this.
# Not in the launcher. Range 1048576..4294967296 (outside: clamped).
# Default: 536870912.
# EVEJS_LNE_PERSISTENCE_WARMUP_MAX_BYTES=

# persistence.vendorTagsLegacyRead - Internal: also accept LNE ownership fields stored inside vendor records
# (saves written before the shared schema). 0 = only the LNE tag tables count.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_PERSISTENCE_VENDOR_TAGS_LEGACY_READ=

# persistence.vendorTagsPruneMax - Internal: stale vendor tags removed per full list call.
# Not in the launcher. Range 1..5000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_PERSISTENCE_VENDOR_TAGS_PRUNE_MAX=

# persistence.vendorTagsPruneGraceMs - Internal: minimum tag age before a tag without a vendor record is removed.
# Not in the launcher. Range 1000..86400000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_PERSISTENCE_VENDOR_TAGS_PRUNE_GRACE_MS=

# lne-retention a: retention of old DONE rows of the allowed key classes in world_scheduled_events
# (lib/retention/classes.js; any other key stays forever; QUEUED/RETRY/CLAIMED/QUARANTINED never go). All keys
# internal: not in the launcher, values outside the range are clamped.
# retention.enabled - Master switch. Off = no handler, no RETENTION_PASS event.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_RETENTION_ENABLED=

# retention.dryRun - Count the candidates only (persistence.retention.candidates), delete nothing.
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_RETENTION_DRY_RUN=

# retention.intervalMs - Period of the RETENTION_PASS chain (ms).
# Not in the launcher. Range 10000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_RETENTION_INTERVAL_MS=

# retention.minAgeMs - A DONE row goes only when it finished at least this long ago (ms).
# Not in the launcher. Range 86400000..31536000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_RETENTION_MIN_AGE_MS=

# retention.maxScanRowsPerPass - Rows read per pass (no payload); at most persistence.maxRowsPerTransaction.
# Not in the launcher. Range 1..10000 (outside: clamped). Default: 400.
# EVEJS_LNE_RETENTION_MAX_SCAN_ROWS_PER_PASS=

# retention.maxDeleteRowsPerPass - Rows deleted per pass; at most persistence.maxRowsPerTransaction - 2.
# Not in the launcher. Range 1..10000 (outside: clamped). Default: 200.
# EVEJS_LNE_RETENTION_MAX_DELETE_ROWS_PER_PASS=

# retention.disabledClasses - Comma list of class ids switched off (e.g. strategy-review,events-pulse).
# Not in the launcher. Default: empty.
# EVEJS_LNE_RETENTION_DISABLED_CLASSES=

# online copy of world.sqlite through the store connection (SQLite backup
# API, in steps outside the tick) to world-YYYYMMDD-HHMMSSZ.sqlite, with rotation, a free space check and governor
# deferral. All keys internal: not in the launcher, values outside the range are clamped.
# backup.enabled - Master switch. Off = no timer, no file. compose.yaml passes 0 unless the root .env sets it.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_BACKUP_ENABLED=

# backup.intervalMs - Time between two copies (ms), counted from the newest file name.
# Not in the launcher. Range 3600000..604800000 (outside: clamped). Default: 21600000.
# EVEJS_LNE_BACKUP_INTERVAL_MS=

# backup.startDelayMs - No copy earlier than this after a start (ms).
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_BACKUP_START_DELAY_MS=

# backup.pollMs - How often the service checks whether a copy is due (ms).
# Not in the launcher. Range 5000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_BACKUP_POLL_MS=

# backup.retryMs - Wait after a failed or aborted copy (ms).
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_BACKUP_RETRY_MS=

# backup.pagesPerStep - Database pages copied per step between two event loop turns.
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 64.
# EVEJS_LNE_BACKUP_PAGES_PER_STEP=

# backup.maxRunMs - A copy that takes longer aborts (TIMEOUT, alarm).
# Not in the launcher. Range 60000..7200000 (outside: clamped). Default: 900000.
# EVEJS_LNE_BACKUP_MAX_RUN_MS=

# backup.keep - Newest world-*.sqlite copies kept; older ones are deleted (no other file is ever deleted).
# Not in the launcher. Range 1..30 (outside: clamped). Default: 3.
# EVEJS_LNE_BACKUP_KEEP=

# backup.freeSpaceFactor - Free space needed before a copy = (db + wal) x factor + minFreeMb.
# Not in the launcher. Range 1..10 (outside: clamped). Default: 1.5.
# EVEJS_LNE_BACKUP_FREE_SPACE_FACTOR=

# backup.minFreeMb - Fixed free space margin (MB).
# Not in the launcher. Range 0..1048576 (outside: clamped). Default: 512.
# EVEJS_LNE_BACKUP_MIN_FREE_MB=

# backup.dir - Absolute directory of the copies, outside the mod directory. Empty = <dataDir>/backups.
# Not in the launcher. Default: empty.
# EVEJS_LNE_BACKUP_DIR=

# backup.pruneToolCopiesDays - 0 = never delete the tool copies *.pre-compact-* / *.pre-reset-* (only counted).
# > 0 deletes the older ones; the newest copy of each kind always stays.
# Not in the launcher. Range 0..365 (outside: clamped). Default: 0.
# EVEJS_LNE_BACKUP_PRUNE_TOOL_COPIES_DAYS=

# backup.paced - Own step loop with a gap between steps, an adaptive step size and a pause (instead of an
# abort) while the governor is SHED / OVERLOADED. Off = the better-sqlite3 loop as before.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_BACKUP_PACED=

# backup.stepGapMs - Paced: pause between two steps (ms).
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 20.
# EVEJS_LNE_BACKUP_STEP_GAP_MS=

# backup.stepTargetMs - Paced: target time of one step (ms); slower halves the step, under half doubles it.
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 25.
# EVEJS_LNE_BACKUP_STEP_TARGET_MS=

# backup.minPagesPerStep - Paced: smallest step (pages).
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 8.
# EVEJS_LNE_BACKUP_MIN_PAGES_PER_STEP=

# backup.maxPagesPerStep - Paced: largest step (pages); backup.pagesPerStep is the first step.
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 256.
# EVEJS_LNE_BACKUP_MAX_PAGES_PER_STEP=

# backup.governorPauseMs - Paced: one pause while the governor is SHED / OVERLOADED (ms).
# Not in the launcher. Range 100..60000 (outside: clamped). Default: 5000.
# EVEJS_LNE_BACKUP_GOVERNOR_PAUSE_MS=

# backup.maxPauseMs - Paced: total pause before the copy is deferred (GOVERNOR); 0 = defer at once.
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_BACKUP_MAX_PAUSE_MS=

# operational alerts (BOOT, ALARM, SHED, PROBE_DRIFT, SERVICES_REFUSED
# SERVICE_FAILED) in batches to one webhook. All keys internal: not in the launcher, values outside the range are
# clamped. Set the flag and the URL in the ROOT .env (next to compose.yaml), never in the repository.
# alerts.enabled - Master switch. Off = no timer, no request. On with an empty URL -> ALERTS_NO_WEBHOOK.
# compose.yaml passes 0 unless the root .env sets it. Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_ALERTS_ENABLED=

# alerts.webhookUrl - Webhook address (https; user:password refused). Secret: masked in the observer and warnings.
# Not in the launcher. Default: empty.
# EVEJS_LNE_ALERTS_WEBHOOK_URL=

# alerts.format - Body shape: json | discord | slack.
# Not in the launcher. Default: json.
# EVEJS_LNE_ALERTS_FORMAT=

# alerts.allowPlainHttp - Allow an http:// URL (a local test receiver only).
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_ALERTS_ALLOW_PLAIN_HTTP=

# alerts.serverLabel - Label in the message text, 1-40 characters of A-Z a-z 0-9 space _ . -
# Not in the launcher. Default: lne.
# EVEJS_LNE_ALERTS_SERVER_LABEL=

# alerts.alarmIds - Comma list of telemetry alarm ids (lib/telemetry/snapshot.js ALARMS) sent as ALARM events.
# Not in the launcher. Default: journal.conflict,persistence.tx.TX_NESTED,persistence.tx.TX_FAILED,persistence.backup.failed.
# EVEJS_LNE_ALERTS_ALARM_IDS=

# alerts.notifyBoot - One BOOT event per start.
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_ALERTS_NOTIFY_BOOT=

# alerts.pollMs - How often the service reads telemetry and the service status (ms).
# Not in the launcher. Range 1000..600000 (outside: clamped). Default: 15000.
# EVEJS_LNE_ALERTS_POLL_MS=

# alerts.minSendIntervalMs - Least time between two messages (ms).
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_ALERTS_MIN_SEND_INTERVAL_MS=

# alerts.repeatMs - Cooldown per event key (ms); a repeat inside it is suppressed.
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_ALERTS_REPEAT_MS=

# alerts.maxQueue - Queued events; over it the oldest are dropped.
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 50.
# EVEJS_LNE_ALERTS_MAX_QUEUE=

# alerts.maxEventsPerMessage - Events in one message.
# Not in the launcher. Range 1..100 (outside: clamped). Default: 20.
# EVEJS_LNE_ALERTS_MAX_EVENTS_PER_MESSAGE=

# alerts.maxAttempts - Attempts of one message, then its events are dropped.
# Not in the launcher. Range 1..10 (outside: clamped). Default: 3.
# EVEJS_LNE_ALERTS_MAX_ATTEMPTS=

# alerts.timeoutMs - HTTP time limit of one message (ms).
# Not in the launcher. Range 500..60000 (outside: clamped). Default: 5000.
# EVEJS_LNE_ALERTS_TIMEOUT_MS=

# alerts.maxBodyBytes - Body size limit (bytes); events that do not fit wait for the next message.
# Not in the launcher. Range 512..65536 (outside: clamped). Default: 8192.
# EVEJS_LNE_ALERTS_MAX_BODY_BYTES=

# alerts.logFailures - One log line per send failure reason.
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_ALERTS_LOG_FAILURES=

# restart loop guard. maxUncleanBoots starts in a row without a clean stop inside
# windowMs latch the refusal crash_loop_guard: the world services do not start, only observer and alerts (alert
# RESTART_GUARD_TRIPPED). Reset by hand only: delete <dataDir>/runtime/boots.json and restart the server.
# All keys internal: not in the launcher, values outside the range are clamped.
# restartGuard.enabled - Master switch. Off = no file is read or written.
# compose.yaml passes 0 unless the root .env sets it. Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_RESTART_GUARD_ENABLED=

# restartGuard.maxUncleanBoots - Length of the series (this start included) that latches the guard.
# Not in the launcher. Range 2..20 (outside: clamped). Default: 3.
# EVEJS_LNE_RESTART_GUARD_MAX_UNCLEAN_BOOTS=

# restartGuard.windowMs - Window of the series (ms); older unclean starts do not count.
# Not in the launcher. Range 60000..604800000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_RESTART_GUARD_WINDOW_MS=

# restartGuard.maxEntries - Starts kept in boots.json (the oldest go).
# Not in the launcher. Range 5..200 (outside: clamped). Default: 20.
# EVEJS_LNE_RESTART_GUARD_MAX_ENTRIES=

# Start-up check of the image inputs. Once per start the mod reads
# docker/build-inputs.json (written into the build context by tools/deploy/deploy.js) and stats every listed file in
# the image. A missing file = ERROR line + status degraded. No hashing, no write. Procedure: tools/deploy/README.md.
# All keys internal: not in the launcher, values outside the range are clamped.
# buildInputs.enabled - Master switch. Off = one line "buildInputs: disabled_by_config".
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_BUILD_INPUTS_ENABLED=

# buildInputs.requireManifest - No manifest in the image = ERROR line + status degraded (otherwise only information).
# compose.yaml passes 1 unless the root .env sets it. Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_BUILD_INPUTS_REQUIRE_MANIFEST=

# buildInputs.maxFiles - A manifest with more files is refused (MANIFEST_TOO_LARGE): bound of the statSync calls.
# Not in the launcher. Range 100..200000 (outside: clamped). Default: 20000.
# EVEJS_LNE_BUILD_INPUTS_MAX_FILES=

# buildInputs.listLimit - Missing paths named in the ERROR line.
# Not in the launcher. Range 1..100 (outside: clamped). Default: 10.
# EVEJS_LNE_BUILD_INPUTS_LIST_LIMIT=

# persistence.checkpointPollMs - Internal: how often the checkpointer decides.
# Not in the launcher. Range 100..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_POLL_MS=

# persistence.checkpointAlignToTick - Internal: run the checkpoint right after a game tick.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_ALIGN_TO_TICK=

# persistence.checkpointAlignWaitMs - Internal: no tick this long -> the checkpoint runs from the timer.
# Not in the launcher. Range 0..5000 (outside: clamped).
# Default: 250.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_ALIGN_WAIT_MS=

# persistence.checkpointFramesPerRowInitial - Internal: starting estimate of WAL frames per written row.
# Not in the launcher. Range 0.5..50 (outside: clamped).
# Default: 3.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_FRAMES_PER_ROW_INITIAL=

# persistence.checkpointFramesEwma - Internal: smoothing of the frames-per-row estimate.
# Not in the launcher. Range 0.01..1 (outside: clamped).
# Default: 0.2.
# EVEJS_LNE_PERSISTENCE_CHECKPOINT_FRAMES_EWMA=

# persistence.walPerTx.enabled - Internal: WAL frames per transaction name in the telemetry (
# journal_size_limit 0 + one stat of the -wal file after each commit). Warnings W45 (managedCheckpoint off), W46
# (telemetry off).
# Not in the launcher.
# Default: 0.
# EVEJS_LNE_PERSISTENCE_WAL_PER_TX_ENABLED=

# persistence.walPerTx.maxKeys - Internal: module keys with their own WAL counters; the rest goes to other.
# Not in the launcher. Range 8..512 (outside: clamped).
# Default: 128.
# EVEJS_LNE_PERSISTENCE_WAL_PER_TX_MAX_KEYS=

# persistence.walPerTx.detailModule - Internal: module with WAL frames per full transaction name.
# Not in the launcher. Empty (settings.json) or a module name. Default: freeCorps.
# EVEJS_LNE_PERSISTENCE_WAL_PER_TX_DETAIL_MODULE=

# persistence.walPerTx.maxDetailNames - Internal: limit of the detail names.
# Not in the launcher. Range 0..128 (outside: clamped).
# Default: 32.
# EVEJS_LNE_PERSISTENCE_WAL_PER_TX_MAX_DETAIL_NAMES=

# graph.buildWarnMs - Internal: a universe graph build (read + build) this long or longer adds SLOW to the "graph built" log line.
# Not in the launcher. Range 10..60000 (outside: clamped).
# Default: 250.
# EVEJS_LNE_GRAPH_BUILD_WARN_MS=

# graph.routeCacheSize - Internal: how many routes the universe graph keeps in its LRU cache; 0 turns the cache off.
# Not in the launcher. Range 0..100000 (outside: clamped).
# Default: 2048.
# EVEJS_LNE_GRAPH_ROUTE_CACHE_SIZE=

# graph.routeMaxJumps - Internal: longest route (jumps) findRoute returns, and its default maxJumps; longer gives TOO_FAR.
# Not in the launcher. Range 1..150 (outside: clamped).
# Default: 40.
# EVEJS_LNE_GRAPH_ROUTE_MAX_JUMPS=

# Routes avoid the fortress Zarzakh (30100000) inside a route
# when the detour is short. Start or destination in Zarzakh: no aversion. Internal: not in the launcher.
# compose.yaml passes all 17 EVEJS_LNE_FORTRESS_* keys (flags:-0
# values:- = empty = the mod default). Row bounds of the Docker flags: tools/measure/rowBoundProbe.js.

# fortress.routeAversionEnabled - Feature flag: second search without the fortress for routes through it; the detour
# wins when it costs <= fortress.routeDetourMaxJumps more. Range: true/false. Default: false.
# EVEJS_LNE_FORTRESS_ROUTE_AVERSION_ENABLED=

# fortress.routeDetourMaxJumps - Largest extra cost (jumps; weighted cost with secClassCost) of the accepted detour.
# Range 0..64 (outside: clamped). Default: 6.
# EVEJS_LNE_FORTRESS_ROUTE_DETOUR_MAX_JUMPS=

# The checkpoint of Zarzakh. A hostile fleet crossing the
# fortress may be stopped there and fight one VIRTUAL battle against a fixed defense (no Deathless fleets, no
# treasury). Needs modules.strategy. Numbers are hypotheses for the calibration. Internal: not in the launcher.

# fortress.checkpointEnabled - Feature flag: departure listener + FORTRESS_CHECKPOINT. Off with open rows of an earlier
# run = drain (every row ends STALE OFF). Range: true/false. Default: false.
# EVEJS_LNE_FORTRESS_CHECKPOINT_ENABLED=

# fortress.interceptChancePermille - Chance (per mille) that one crossing is stopped. Range 0..1000 (clamped).
# Default: 700.
# EVEJS_LNE_FORTRESS_INTERCEPT_CHANCE_PERMILLE=

# fortress.batteryCount - Batteries of the fixed defense. Range 1..64 (clamped). Default: 12.
# EVEJS_LNE_FORTRESS_BATTERY_COUNT=

# fortress.batteryHp - HP (= EHP) of one battery. Range 1..1000000000 (clamped). Default: 250000.
# EVEJS_LNE_FORTRESS_BATTERY_HP=

# fortress.batteryDps - DPS of one battery. Range 0..1000000 (clamped). Default: 400.
# EVEJS_LNE_FORTRESS_BATTERY_DPS=

# fortress.batterySignature - Signature radius of one battery. Range 1..1000000000 (clamped). Default: 2000.
# EVEJS_LNE_FORTRESS_BATTERY_SIGNATURE=

# fortress.batteryDesignSig - Design signature (weapon resolution) of one battery. Range 1..1000000000 (clamped).
# Default: 400.
# EVEJS_LNE_FORTRESS_BATTERY_DESIGN_SIG=

# fortress.batteryTypeId - Type of the batteries in the battle record (never sent to EveJS). Default: 16690.
# EVEJS_LNE_FORTRESS_BATTERY_TYPE_ID=

# fortress.attackerRetreatLossPermille - The stopped fleet retreats after this share (per mille) of its EHP is lost.
# Range 50..1000 (clamped). Default: 300.
# EVEJS_LNE_FORTRESS_ATTACKER_RETREAT_LOSS_PERMILLE=

# fortress.exemptFactionIds - Factions never stopped (the owner always is exempt). Empty, none or a comma list of
# faction IDs. Default: empty.
# EVEJS_LNE_FORTRESS_EXEMPT_FACTION_IDS=

# fortress.exemptRoles - Fleet roles never stopped. Empty, none or a comma list of fleet roles. Default: empty.
# EVEJS_LNE_FORTRESS_EXEMPT_ROLES=

# The checkpoint budget per transaction and the HALT
# memory. Numbers are hypotheses for the calibration. Internal: not in the launcher.

# fortress.maxCheckpointsPerTransaction - FORTRESS_CHECKPOINT rows of one transaction; over it the crossing passes
# (fortress.budgetPass). Counted once in every row bound. Range 1..8 (clamped). Default: 1.
# EVEJS_LNE_FORTRESS_MAX_CHECKPOINTS_PER_TRANSACTION=

# fortress.haltMemoryEnabled - Feature flag: a HALT writes (fortress, faction) memory and the travel plans of that
# faction avoid the fortress until it ends. Needs fortress.checkpointEnabled. Range: true/false. Default: false.
# EVEJS_LNE_FORTRESS_HALT_MEMORY_ENABLED=

# fortress.haltMemoryMs - How long the faction avoids the fortress after a HALT (ms). Range 60000..2592000000
# (clamped). Default: 86400000.
# EVEJS_LNE_FORTRESS_HALT_MEMORY_MS=

# fortress.haltMemoryDetourMaxJumps - Largest extra jumps of the detour with an active memory; longer = the plan
# refuses TOO_FAR (detail FORTRESS_AVOID). Range 0..64 (clamped). Default: 30.
# EVEJS_LNE_FORTRESS_HALT_MEMORY_DETOUR_MAX_JUMPS=

# Transit checkpoint, mode observe (the
# departure listener counts hostile nullsec crossings and the expected contact chance; writes nothing). Needs
# modules.strategy and modules.world. Numbers are hypotheses. Internal: not in the launcher.

# transit.enabled - Feature flag: the transit service. Range: true/false. Default: false.
# EVEJS_LNE_TRANSIT_ENABLED=

# transit.mode - observe (only counters) or on (: + one TRANSIT_CHECKPOINT per leg; a HALT stops the fleet with
# a contact or a picket battle). Default: observe.
# EVEJS_LNE_TRANSIT_MODE=

# transit.secClasses - Security classes of the risk index. Comma list of highsec|lowsec|nullsec|wormhole|other.
# Default: nullsec.
# EVEJS_LNE_TRANSIT_SEC_CLASSES=

# transit.basePermille - Base contact chance in one hostile system. Range 0..1000 (clamped). Default: 150.
# EVEJS_LNE_TRANSIT_BASE_PERMILLE=

# transit.controlPermille - Extra chance at influence 100 of the controller. Range 0..1000 (clamped). Default: 150.
# EVEJS_LNE_TRANSIT_CONTROL_PERMILLE=

# transit.garrisonPermillePer1000 - Extra chance per 1000 garrison strength. Range 0..1000 (clamped). Default: 20.
# EVEJS_LNE_TRANSIT_GARRISON_PERMILLE_PER1000=

# transit.garrisonCapPermille - Largest garrison part. Range 0..1000 (clamped). Default: 100.
# EVEJS_LNE_TRANSIT_GARRISON_CAP_PERMILLE=

# transit.sentryPermilleEach - Extra chance per live gate sentry of the controller. Range 0..1000 (clamped).
# Default: 25.
# EVEJS_LNE_TRANSIT_SENTRY_PERMILLE_EACH=

# transit.sentryCapPermille - Largest sentry part. Range 0..1000 (clamped). Default: 100.
# EVEJS_LNE_TRANSIT_SENTRY_CAP_PERMILLE=

# transit.maxChancePermille - Largest contact chance in one system. Range 0..1000 (clamped). Default: 500.
# EVEJS_LNE_TRANSIT_MAX_CHANCE_PERMILLE=

# transit.smallGangMaxShips - A fleet of at most this many ships is a small gang. Range 1..64 (clamped). Default: 5.
# EVEJS_LNE_TRANSIT_SMALL_GANG_MAX_SHIPS=

# transit.smallGangPermille - Class factor of a small gang. Range 0..1000 (clamped). Default: 500.
# EVEJS_LNE_TRANSIT_SMALL_GANG_PERMILLE=

# transit.largeFleetMinShips - A fleet of at least this many ships is a large fleet. Range 2..2000 (clamped).
# Default: 30.
# EVEJS_LNE_TRANSIT_LARGE_FLEET_MIN_SHIPS=

# transit.largeFleetPermille - Class factor of a large fleet. Range 0..1000 (clamped). Default: 300.
# EVEJS_LNE_TRANSIT_LARGE_FLEET_PERMILLE=

# transit.evasiveRolePermille - Class factor of hunter and capsuleer fleets. Range 0..1000 (clamped). Default: 250.
# EVEJS_LNE_TRANSIT_EVASIVE_ROLE_PERMILLE=

# transit.exemptFactionIds - Factions never counted. Empty, none or a comma list of faction IDs. Default: empty.
# EVEJS_LNE_TRANSIT_EXEMPT_FACTION_IDS=

# transit.exemptRoles - Fleet roles never counted. Empty, none or a comma list of fleet roles. Default: empty.
# EVEJS_LNE_TRANSIT_EXEMPT_ROLES=

# transit.exemptOperationTypes - Operation types never counted. none or a comma list of operation types.
# Default: return.
# EVEJS_LNE_TRANSIT_EXEMPT_OPERATION_TYPES=

# transit.listenerMaxSystems - Systems of one leg the listener looks at. Range 1..128 (clamped). Default: 32.
# EVEJS_LNE_TRANSIT_LISTENER_MAX_SYSTEMS=

# transit.indexPageSize - Systems per risk index page. Range 16..1000 (clamped). Default: 256.
# EVEJS_LNE_TRANSIT_INDEX_PAGE_SIZE=

# transit.indexPageIntervalMs - Wall time between two index pages (ms). Range 200..60000 (clamped). Default: 2000.
# EVEJS_LNE_TRANSIT_INDEX_PAGE_INTERVAL_MS=

# transit.indexRefreshMs - Wall time from one finished index build to the next (ms). Range 60000..86400000
# (clamped). Default: 600000.
# EVEJS_LNE_TRANSIT_INDEX_REFRESH_MS=

# transit.maxChecksPerLeg - Mode on: checkpoint rows of one leg (a chain). Range 1..32 (clamped). Default: 10.
# EVEJS_LNE_TRANSIT_MAX_CHECKS_PER_LEG=

# transit.maxCheckpointsPerTransaction - Mode on: checkpoint rows of one transaction; over it the leg passes.
# Range 1..8 (clamped). Default: 2.
# EVEJS_LNE_TRANSIT_MAX_CHECKPOINTS_PER_TRANSACTION=

# transit.maxEventsPerPass - Mode on: checkpoints of one scheduler pass. Range 1..1024 (clamped). Default: 32.
# EVEJS_LNE_TRANSIT_MAX_EVENTS_PER_PASS=

# transit.haltsPerControllerHour - Mode on: HALTs of one controller per virtual hour; 0 = never a HALT.
# Range 0..1000 (clamped). Default: 6.
# EVEJS_LNE_TRANSIT_HALTS_PER_CONTROLLER_HOUR=

# transit.contactRoles - Roles of a controller fleet in the system that make a HALT a contact. Empty, none or a comma
# list of fleet roles; empty = always a picket battle. Default: garrison.
# EVEJS_LNE_TRANSIT_CONTACT_ROLES=

# transit.contactScanFleets - Fleets of the system read for a defender. Range 1..500 (clamped). Default: 16.
# EVEJS_LNE_TRANSIT_CONTACT_SCAN_FLEETS=

# transit.defenderBonusPermille - Extra chance with a defender fleet in the system. Range 0..1000 (clamped).
# Default: 150.
# EVEJS_LNE_TRANSIT_DEFENDER_BONUS_PERMILLE=

# transit.picketPermillePerBattery - Picket batteries = ceil(system chance / this). Range 1..1000 (clamped).
# Default: 50.
# EVEJS_LNE_TRANSIT_PICKET_PERMILLE_PER_BATTERY=

# transit.picketMaxBatteries - Largest picket. Range 1..32 (clamped). Default: 8.
# EVEJS_LNE_TRANSIT_PICKET_MAX_BATTERIES=

# transit.picketBatteryHp - HP (= EHP) of one picket battery. Range 1..1000000000 (clamped). Default: 20000.
# EVEJS_LNE_TRANSIT_PICKET_BATTERY_HP=

# transit.picketBatteryDps - DPS of one picket battery. Range 0..1000000 (clamped). Default: 60.
# EVEJS_LNE_TRANSIT_PICKET_BATTERY_DPS=

# transit.picketBatterySignature - Signature radius of one picket battery. Range 1..1000000000 (clamped).
# Default: 400.
# EVEJS_LNE_TRANSIT_PICKET_BATTERY_SIGNATURE=

# transit.picketBatteryDesignSig - Design signature of one picket battery. Range 1..1000000000 (clamped).
# Default: 125.
# EVEJS_LNE_TRANSIT_PICKET_BATTERY_DESIGN_SIG=

# transit.picketBatteryTypeId - Type of the picket batteries in the battle record. Default: 16690.
# EVEJS_LNE_TRANSIT_PICKET_BATTERY_TYPE_ID=

# transit.picketAttackerRetreatLossPermille - The stopped fleet retreats after this share of its EHP is lost.
# Range 50..1000 (clamped). Default: 150.
# EVEJS_LNE_TRANSIT_PICKET_ATTACKER_RETREAT_LOSS_PERMILLE=

# transit.advisorEnabled - soft travel route advisor - a detour around hostile systems with a high
# crossing chance; a detour too long keeps the route (never refuses a plan). transit.mode=on only. Default: false.
# EVEJS_LNE_TRANSIT_ADVISOR_ENABLED=

# transit.advisorAvoidPermille - the advisor avoids systems with a crossing chance (with the fleet class) at
# least this (per mille). Range 0..1000 (clamped). Default: 250.
# EVEJS_LNE_TRANSIT_ADVISOR_AVOID_PERMILLE=

# transit.advisorDetourMaxJumps - extra jumps a detour may take, else the base route stays. Range 0..64
# (clamped). Default: 2.
# EVEJS_LNE_TRANSIT_ADVISOR_DETOUR_MAX_JUMPS=

# transit.aiGateEnabled - Strategic AI skips a target behind a very risky route (attack, patrol, gank)
# and sends a larger attack fleet behind a risky one. transit.mode=on only. Default: false.
# EVEJS_LNE_TRANSIT_AI_GATE_ENABLED=

# transit.aiSkipRouteRiskPermille - a route contact chance above this (per mille) skips the target. Range
# 0..1000 (clamped). Default: 700.
# EVEJS_LNE_TRANSIT_AI_SKIP_ROUTE_RISK_PERMILLE=

# transit.aiRaiseStepPermille - an attack needs strength x (1000 + floor(risk x this / 1000)) / 1000. Range
# 0..5000 (clamped). Default: 500.
# EVEJS_LNE_TRANSIT_AI_RAISE_STEP_PERMILLE=

# transit.aiOperationTemplateShips - (calibration): the attack route risk of the operations planner uses the
# ship count of the mobilizeRole template (small gang / large fleet class); off = the regular fleet class. Default: false.
# EVEJS_LNE_TRANSIT_AI_OPERATION_TEMPLATE_SHIPS=

# wormholes.enabled - read-only poll of the EveJS wormhole pairs into the graph overlay. Routes use it
# only on request (constraints.wormholes); off = no poll, empty overlay. Needs modules.graph.enabled.
# Default true since, flipped without the in-game gate session (2026-10-31).
# Launcher field "Wormhole routes" (Modules). Range: true/false. Default: true.
# EVEJS_LNE_WORMHOLES_ENABLED=

# wormholes.syncIntervalMs - Internal: time between two reads of the wormhole state.
# Not in the launcher. Range 5000..600000 (outside: clamped).
# Default: 30000.
# EVEJS_LNE_WORMHOLES_SYNC_INTERVAL_MS=

# wormholes.minRemainingMs - Internal: a wormhole edge is routable only while it lives at least this long.
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 14400000.
# EVEJS_LNE_WORMHOLES_MIN_REMAINING_MS=

# wormholes.maxPairs - Internal: more wormhole pairs in the EveJS state -> the read is refused (never partial).
# Not in the launcher. Range 100..200000 (outside: clamped).
# Default: 20000.
# EVEJS_LNE_WORMHOLES_MAX_PAIRS=

# wormholes.expiryMarginMs - Internal: a plan through a wormhole is refused when the pair expires less than this
# after the crossing.
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 600000.
# EVEJS_LNE_WORMHOLES_EXPIRY_MARGIN_MS=

# wormholes.maxClosuresPerSync - Internal: closed wormhole pairs handled in one sync; the rest waits for the next.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_WORMHOLES_MAX_CLOSURES_PER_SYNC=

# wormholes.syncHoldMaxMs - Internal: after a start, arrivals through wormholes wait at most this long for the first
# wormhole sync.
# Not in the launcher. Range 0..3600000 (outside: clamped).
# Default: 120000.
# EVEJS_LNE_WORMHOLES_SYNC_HOLD_MAX_MS=

# wormholes.syncHoldRecheckMs - Internal: a held arrival through wormholes is deferred this long by the scheduler
# (the attempt is returned), then checked again.
# Not in the launcher. Range 1000..60000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_WORMHOLES_SYNC_HOLD_RECHECK_MS=

# wormholes.transitRetentionMs - Internal: wormhole transit rows are deleted this long after the crossing.
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 86400000.
# EVEJS_LNE_WORMHOLES_TRANSIT_RETENTION_MS=

# wormholes.maxPurgePerSync - Internal: wormhole transit rows deleted in one sync.
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_WORMHOLES_MAX_PURGE_PER_SYNC=

# world.maxFactionsPerSystem - Internal: most factions with an influence row in one system.
# Not in the launcher. Range 1..32 (outside: clamped).
# Default: 8.
# EVEJS_LNE_WORLD_MAX_FACTIONS_PER_SYSTEM=

# world.maxBatchReadIds - Internal: most system ids in one batch read of the world state (getSystems).
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_WORLD_MAX_BATCH_READ_IDS=

# world.maxListLimit - Internal: page size cap of listSystems / listInfluenceByFaction.
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_WORLD_MAX_LIST_LIMIT=

# world.readCacheEnabled - Internal: in-memory cache of the world state reads by system id (getSystem/getSystems).
# Not in the launcher. Every write invalidates its system; 0 = read every row from the database.
# Default: true.
# EVEJS_LNE_WORLD_READ_CACHE_ENABLED=

# world.readCacheMaxSystems - Internal: cache size bound; past 2x this many entries the cache is cleared.
# Not in the launcher. Range 0..100000 (outside: clamped); 0 = cache off.
# Default: 10000.
# EVEJS_LNE_WORLD_READ_CACHE_MAX_SYSTEMS=

# world.seedEnabled - Internal: run the one-time control seed (controller + influence of the systems in scope).
# Not in the launcher. 0 = no seed; the world repository still runs.
# Default: true.
# EVEJS_LNE_WORLD_SEED_ENABLED=

# world.seedScope - Internal: space classes the control seed covers, a comma list of
# highsec|lowsec|nullsec|wormhole|other (e.g. nullsec,lowsec). A new scope seeds only the new systems.
# Not in the launcher. Default: nullsec.
# EVEJS_LNE_WORLD_SEED_SCOPE=

# world.seedSliceSystems - Internal: most systems the control seed writes in one transaction (slice).
# Not in the launcher. Range 1..125 (outside: clamped).
# Default: 50.
# EVEJS_LNE_WORLD_SEED_SLICE_SYSTEMS=

# world.seedSliceMs - Internal: time budget (ms) of one seed slice; the slice stops early when it is used up.
# Not in the launcher. Range 0.5..50 (outside: clamped).
# Default: 4.
# EVEJS_LNE_WORLD_SEED_SLICE_MS=

# world.seedDeferMs - Internal: wait (ms) before the next seed slice when the load governor holds maintenance work.
# Not in the launcher. Range 100..60000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_WORLD_SEED_DEFER_MS=

# world.seedControllerInfluence - Internal: starting influence (0..100) of a system's controller.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 60.
# EVEJS_LNE_WORLD_SEED_CONTROLLER_INFLUENCE=

# world.seedSdeFactionInfluence - Internal: starting influence of the SDE faction of a system when it is not
# the controller; 0 = no row. Not in the launcher. Range 0..100 (outside: clamped).
# Default: 20.
# EVEJS_LNE_WORLD_SEED_SDE_FACTION_INFLUENCE=

# world.projectionEnabled - wrap resolvePirateFactionKeyForSystem so NPC spawns match the mod-controlled faction.
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_WORLD_PROJECTION_ENABLED=

# world.siteProjectionEnabled - wrap buildRuntimeSystemPolicyContext so universe sites match the mod-controlled pirate faction; default false until verified in the game.
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_WORLD_SITE_PROJECTION_ENABLED=

# world.controllerMemoMaxSystems - Internal: bound of the controller memo of the site projection (one entry per system,
# dropped on every world write of that system). Past this many entries the memo is cleared. Not in the launcher.
# Range 0..100000 (outside: clamped); 0 = memo off (one read transaction per call).
# Default: 10000.
# EVEJS_LNE_WORLD_CONTROLLER_MEMO_MAX_SYSTEMS=

# world.empireBeltsEnabled - (pkt 8): belt rats in empire-controlled nullsec become that empire's FW navy profiles of EveJS (same hull class); nullsec only.
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_WORLD_EMPIRE_BELTS_ENABLED=

# world.empireNavyFactions - comma-separated factionIDs of empires whose navy spawns on belts (Amarr, Caldari, Gallente, Minmatar).
# Not in the launcher. Format: comma-separated positive integers (e.g. 500001,500002,500003,500004).
# Default: 500001,500002,500003,500004.
# EVEJS_LNE_WORLD_EMPIRE_NAVY_FACTIONS=

# world.beltNavy.rewardsEnabled - belt navy takes the replaced pirate's bounty and loot table and the empire's factionID; off = FW profiles as they are.
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_WORLD_BELT_NAVY_REWARDS_ENABLED=

# world.beltNavy.bountyMultiplier - belt navy bounty = replaced pirate's bounty x this multiplier, rounded.
# Not in the launcher. Range 0.1..5 (outside: clamped). Default: 1.1.
# EVEJS_LNE_WORLD_BELT_NAVY_BOUNTY_MULTIPLIER=

# world.beltNavy.liberationKills - belt navy kills lower the controller's influence through liberation; off = they do not.
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_WORLD_BELT_NAVY_LIBERATION_KILLS=

# world.beltNavy.shareEnabled - each belt spawn is rolled navy or pirates and vendor special spawns stay pirate; off = every normal spawn is navy and special spawns are skipped.
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_WORLD_BELT_NAVY_SHARE_ENABLED=

# world.beltNavy.shareMin - navy share of a system with weight 0 or influence 0.
# Not in the launcher. Range 0..1 (outside: clamped). Default: 0.25.
# EVEJS_LNE_WORLD_BELT_NAVY_SHARE_MIN=

# world.beltNavy.shareMax - navy share of a STABLE system with influence 100.
# Not in the launcher. Range 0..1 (outside: clamped). Default: 0.75.
# EVEJS_LNE_WORLD_BELT_NAVY_SHARE_MAX=

# world.beltNavy.consolidatingWeight - weight of a CONSOLIDATING system in the navy share formula.
# Not in the launcher. Range 0..1 (outside: clamped). Default: 0.5.
# EVEJS_LNE_WORLD_BELT_NAVY_CONSOLIDATING_WEIGHT=

# world.beltNavy.rollBucketMs - time bucket in the roll key, a repeated spawn ID inside it rolls the same.
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_WORLD_BELT_NAVY_ROLL_BUCKET_MS=

# world.beltNavy.standingAggroEnabled - the navy is born passive and attacks by standing; off = the vendor's aggression, the navy attacks every player.
# Not in the launcher. Default: true.
# EVEJS_LNE_WORLD_BELT_NAVY_STANDING_AGGRO_ENABLED=

# world.beltNavy.hostileBelowStanding - the navy attacks first a pilot with a raw standing strictly below this.
# Not in the launcher. Range -10..10 (outside: clamped). Default: 0.
# EVEJS_LNE_WORLD_BELT_NAVY_HOSTILE_BELOW_STANDING=

# world.beltNavy.aggroRangeMeters - players within this range of the group count for its targets and its TTL.
# Not in the launcher. Range 10000..1000000 (outside: clamped). Default: 150000.
# EVEJS_LNE_WORLD_BELT_NAVY_AGGRO_RANGE_METERS=

# world.beltNavy.pollMs - pause between the passes of the group timer.
# Not in the launcher. Range 1000..60000 (outside: clamped). Default: 5000.
# EVEJS_LNE_WORLD_BELT_NAVY_POLL_MS=

# world.beltNavy.maxGroups - navy groups in the registry; a full registry spawns the vendor's pirates.
# Not in the launcher. Range 1..1024 (outside: clamped). Default: 64.
# EVEJS_LNE_WORLD_BELT_NAVY_MAX_GROUPS=

# world.beltNavy.maxGroupsPerPass - work budget of one timer pass, groups taken in rotation.
# Not in the launcher. Range 1..256 (outside: clamped). Default: 16.
# EVEJS_LNE_WORLD_BELT_NAVY_MAX_GROUPS_PER_PASS=

# world.beltNavy.groupTtlMs - a group this old with nobody in range is removed, so it never blocks a belt.
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_WORLD_BELT_NAVY_GROUP_TTL_MS=

# world.beltNavy.patrolFactionsEnabled - belt rats in nullsec held by a non-pirate faction without own rats (SoE) become its patrol; needs world.empireBeltsEnabled + materialization.factionProfilesEnabled.
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_WORLD_BELT_NAVY_PATROL_FACTIONS_ENABLED=

# world.beltNavy.patrolFactions - comma-separated factionIDs of the LNE faction profile catalog whose patrol replaces the belt rats in full; IDs outside the catalog and empires are ignored.
# Not in the launcher. Format: comma-separated positive integers (e.g. 500001,500002,500003,500004).
# Default: 500016.
# EVEJS_LNE_WORLD_BELT_NAVY_PATROL_FACTIONS=

# world.siteNavy.enabled - combat anomalies in empire-controlled nullsec get the empire's navy for the whole instance, by the belt share; needs world.empireBeltsEnabled; off = vendor pirates.
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_WORLD_SITE_NAVY_ENABLED=

# world.siteNavy.maxTrackedSites - anomaly decisions kept in memory; a full memory drops the oldest, the next wave reads it back from the vendor.
# Not in the launcher. Range 64..16384 (outside: clamped). Default: 1024.
# EVEJS_LNE_WORLD_SITE_NAVY_MAX_TRACKED_SITES=

# world.sovProjection.invaderFactionIds - comma-separated factionIDs of invader factions that never get native sov (Sleepers, Drifters, etc.).
# Not in the launcher. Format: comma-separated positive integers.
# Default: 500021,500026,500029.
# EVEJS_LNE_WORLD_SOVPROJECTION_INVADER_FACTIONS=

# world.sovProjection.reinforceOnLoss - when controller lost but our Hub still stands, call reinforceSystemHub (EveJS auto-reinforce on entosis may suffice).
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_WORLD_SOVPROJECTION_REINFORCE_ON_LOSS=

# world.sovProjection.syncBatchSize - keyset pagination batch size for syncAll (systems per slice).
# Not in the launcher. Range 50..2000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_WORLD_SOVPROJECTION_SYNC_BATCH_SIZE=

# world.sovProjection.syncSliceMs - syncAll yields a macrotask once a slice reaches this (ms), checked after every system.
# Not in the launcher. Range 0.5..50 (outside: clamped).
# Default: 4.
# EVEJS_LNE_WORLD_SOVPROJECTION_SYNC_SLICE_MS=

# world.sovProjection.projectionMinSpacingMs - minimum gap between two EveJS sov writes (ms); 0 with costFactor 0 = no pacing.
# Not in the launcher. Range 0..600000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_WORLD_SOVPROJECTION_PROJECTION_MIN_SPACING_MS=

# world.sovProjection.projectionCostFactor - gap after a sov write = its duration x this factor (480 ms -> 9.6 s).
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 20.
# EVEJS_LNE_WORLD_SOVPROJECTION_PROJECTION_COST_FACTOR=

# world.sovProjection.deferMaxSystems - most systems in the projection defer queue (claimable ~3552).
# Not in the launcher. Range 16..16384 (outside: clamped).
# Default: 4096.
# EVEJS_LNE_WORLD_SOVPROJECTION_DEFER_MAX_SYSTEMS=

# world.sovProjection.deferFailureRetryMs - retry delay after a transient vendor/commit failure (ms).
# Not in the launcher. Range 1000..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_WORLD_SOVPROJECTION_DEFER_FAILURE_RETRY_MS=

# world.sovProjection.deferMaxAttempts - failed attempts before a deferred system is given up (until the next syncAll).
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 5.
# EVEJS_LNE_WORLD_SOVPROJECTION_DEFER_MAX_ATTEMPTS=

# world.sovProjection.deferDrainMaxPerPass - deferred systems looked at per timer fire.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 16.
# EVEJS_LNE_WORLD_SOVPROJECTION_DEFER_DRAIN_MAX_PER_PASS=

# world.sovProjection.verifyAfterDrain - run verifyAll (read-only mod <-> EveJS comparison) when the defer queue drains.
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_WORLD_SOVPROJECTION_VERIFY_AFTER_DRAIN=

# world.sovProjection.verifyMinIntervalMs - shortest gap between two verifyAll runs (ms).
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 600000.
# EVEJS_LNE_WORLD_SOVPROJECTION_VERIFY_MIN_INTERVAL_MS=

# world.sovProjection.verifyMaxSamples - most mismatched system IDs kept in the verify sample (panel sov-projection).
# Not in the launcher. Range 0..200 (outside: clamped).
# Default: 20.
# EVEJS_LNE_WORLD_SOVPROJECTION_VERIFY_MAX_SAMPLES=

# world.sovProjection.syncSeedWaitMs - longest wait of the start syncAll for a terminal world seed state (ms); 0 = no wait.
# Not in the launcher. Range 0..3600000 (outside: clamped).
# Default: 600000.
# EVEJS_LNE_WORLD_SOVPROJECTION_SYNC_SEED_WAIT_MS=

# world.sovProjection.syncSeedPollMs - poll interval of the world seed state before the start syncAll (ms).
# Not in the launcher. Range 100..60000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_WORLD_SOVPROJECTION_SYNC_SEED_POLL_MS=

# world.sovProjection.campaignSpreadEnabled - spread the EveJS window ticks of the LNE sov hubs (prime hour 0 -> all at the same ms = server freezes).
# Not in the launcher. Range: true/false. Default: true. Independent of modules.sovProjection.
# EVEJS_LNE_WORLD_SOVPROJECTION_CAMPAIGN_SPREAD_ENABLED=

# world.sitePolicyHubFastPathEnabled - inside the site policy context a hub with no upgrades skips the global hub fuel settle (415^2 per player entry).
# Not in the launcher. Range: true/false. Default: true. Independent of world.siteProjectionEnabled.
# EVEJS_LNE_SITE_POLICY_HUB_FAST_PATH=

# world.sovProjection.campaignSpreadMs - the window tick of an LNE hub moves by fnv1a32(hubID) % this (ms); 0 = no spread.
# Not in the launcher. Range 0..21600000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_WORLD_SOVPROJECTION_CAMPAIGN_SPREAD_MS=

# world.sovProjection.campaignSpreadRetryMax - max window jobs the start reconciliation could not spread (NOT_LNE/CLAIM_UNAVAILABLE), re-scheduled after virtualCorps is ready; 0 = no retry.
# Not in the launcher. Range 0..20000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_WORLD_SOVPROJECTION_CAMPAIGN_SPREAD_RETRY_MAX=

# world.sovProjection.campaignSpreadRetryBatch - remembered window jobs re-decided per retry slice.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 25.
# EVEJS_LNE_WORLD_SOVPROJECTION_CAMPAIGN_SPREAD_RETRY_BATCH=

# world.sovProjection.campaignSpreadRetryDelayMs - pause between retry slices (ms).
# Not in the launcher. Range 10..60000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_WORLD_SOVPROJECTION_CAMPAIGN_SPREAD_RETRY_DELAY_MS=

# world.sovProjection.campaignSpreadProvisionalEnabled - before virtualCorps is ready the start window jobs move by fnv1a32(hubID) % campaignSpreadMs at once; the retry keeps LNE hubs and restores the vendor time of player hubs.
# Not in the launcher. Range: true/false. Default: false. Needs campaignSpreadRetryMax > 0.
# EVEJS_LNE_WORLD_SOVPROJECTION_CAMPAIGN_SPREAD_PROVISIONAL_ENABLED=

# EveJS essRepository.read() clones the whole ESS table
# (dynamicResourceRuntime) on every call. Not in the launcher. Independent of modules.*. Measurement: stats first
# (baseline), then fast with parity for a short run, then fast without parity.

# world.essRepository.fastReadEnabled - ESS read/mutate as a lazy per-entity snapshot + commit with
# knownChangedPaths (no full clones). Range: true/false. Default: false.
# EVEJS_LNE_WORLD_ESS_REPOSITORY_FAST_READ_ENABLED=

# world.essRepository.statsEnabled - counting wrappers of ESS read/write/mutate and the ess.settlement jobs
# vendor semantics unchanged (the "before" measurement). Range: true/false. Default: false.
# EVEJS_LNE_WORLD_ESS_REPOSITORY_STATS_ENABLED=

# world.essRepository.statsLogMinutes - window of the `essRepository stats` log line (minutes); 0 = no line.
# Range 0..1440 (outside: clamped). Default: 15.
# EVEJS_LNE_WORLD_ESS_REPOSITORY_STATS_LOG_MINUTES=

# world.essRepository.parityEvery - every N-th fast commit compares the SQLite rows with the cache; a
# difference = disabled:parity + a full flush. Expensive, verification run only. Range 0..100000. Default: 0 (off).
# EVEJS_LNE_WORLD_ESS_REPOSITORY_PARITY_EVERY=

# EveJS dynamicBountyRuntime.recoverLosses clones the whole killmail
# index on every call. Not in the launcher. Independent of modules.*. Enabled only at the gate
# (compose:-0).

# world.dbsKillmailCache.enabled - one deep-frozen killmail copy per index version inside DBS
# maintain/recoverLosses. Range: true/false. Default: false.
# EVEJS_LNE_WORLD_DBS_KILLMAIL_CACHE_ENABLED=

# world.dbsKillmailCache.maxRecords - a longer killmail copy is not cached (bypass).
# Range 1000..2000000 (outside: clamped). Default: 200000.
# EVEJS_LNE_WORLD_DBS_KILLMAIL_CACHE_MAX_RECORDS=

# EveJS ess.settlement jobs collapsed to one
# synchronize per system, reconcile at the start without one schedule per bank. Not in the launcher. Independent of
# modules.*. Compose :-1 (kill switch 0).

# world.essCollapse.enabled - the collapse of the ESS jobs. Range: true/false. Default: false.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_ENABLED=

# world.essCollapse.pumpIntervalMs - pause between pump steps (ms). Range 20..5000 (clamped). Default: 250.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_PUMP_INTERVAL_MS=

# world.essCollapse.maxSystemsPerTick - synchronize calls per step. Range 1..64 (clamped). Default: 4.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_MAX_SYSTEMS_PER_TICK=

# world.essCollapse.tickBudgetMs - time of one step (ms). Range 1..1000 (clamped). Default: 25.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_TICK_BUDGET_MS=

# world.essCollapse.startDelayMs - the pump starts this long after the boot (ms).
# Range 0..600000 (clamped). Default: 30000.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_START_DELAY_MS=

# world.essCollapse.maxHoldMs - fuse without the boot signal (ms). Range 60000..3600000 (clamped).
# Default: 600000.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_MAX_HOLD_MS=

# world.essCollapse.retryDelayMs - durable retry of a failed synchronize (ms). Range 1000..3600000 (clamped).
# Default: 60000.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_RETRY_DELAY_MS=

# world.essCollapse.maxRetries - retries of one system before gave up. Range 0..100 (clamped). Default: 5.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_MAX_RETRIES=

# world.essCollapse.maxPending - RAM bound of the system set. Range 100..200000 (clamped). Default: 20000.
# EVEJS_LNE_WORLD_ESS_COLLAPSE_MAX_PENDING=

# world.sovReconcile.enabled - master switch for the reconcile pump.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_WORLD_SOVRECONCILE_ENABLED=

# world.sovReconcile.passMs - timer interval between reconcile passes (ms).
# Not in the launcher. Range 1000..86400000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_WORLD_SOVRECONCILE_PASS_MS=

# world.sovReconcile.fullPassMs - full cursor cycle interval (ms); 0 = no full pass acceleration; warning if < passMs.
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_WORLD_SOVRECONCILE_FULL_PASS_MS=

# world.sovReconcile.maxRowsPerPass - keyset pagination limit per pass (systems).
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_WORLD_SOVRECONCILE_MAX_ROWS_PER_PASS=

# world.sovReconcile.maxFactsPerPass - budget of fact transactions per pass (DEFENDED excluded).
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_WORLD_SOVRECONCILE_MAX_FACTS_PER_PASS=

# world.sovReconcile.maxOutcomesPerSystem - max campaign outcomes read per system (truncated counter, no acceleration).
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_WORLD_SOVRECONCILE_MAX_OUTCOMES_PER_SYSTEM=

# world.sovReconcile.maxDeferMs - deferral window for non-hold states before DROP_ONLY (ms).
# Not in the launcher. Range 1000..604800000 (outside: clamped).
# Default: 86400000.
# EVEJS_LNE_WORLD_SOVRECONCILE_MAX_DEFER_MS=

# world.sovReconcile.hubLossInfluencePoints - influence points dropped on hub loss (0 = drop only, no abandon).
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_WORLD_SOVRECONCILE_HUB_LOSS_INFLUENCE_POINTS=

# world.sovReconcile.logOnceMs - deduplication window for logOnce (ms).
# Not in the launcher. Range 1000..86400000 (outside: clamped).
# Default: 300000.
# EVEJS_LNE_WORLD_SOVRECONCILE_LOG_ONCE_MS=

# world.sovReconcile.logOnceMaxKeys - audit: size of the logOnce (system, reason) cache before it is cleared.
# Not in the launcher. Range 1..100000 (outside: clamped). Default: 2000.
# EVEJS_LNE_WORLD_SOVRECONCILE_LOG_ONCE_MAX_KEYS=

# world.sovReconcile.governorWorkClass - audit: governor work class of a pass (governor.admits).
# Not in the launcher. One of SETTLEMENT, LIVE, OPERATIONAL, STRATEGIC, MAINTENANCE. Default: OPERATIONAL.
# EVEJS_LNE_WORLD_SOVRECONCILE_GOVERNOR_WORK_CLASS=

# world.sovReconcile.maxProjectNudgesPerPass - max reconciliation nudges per pass (0 = no catch-up nudges).
# Not in the launcher. Range 0..100 (outside: clamped). Default: 4.
# EVEJS_LNE_WORLD_SOVRECONCILE_MAX_PROJECT_NUDGES_PER_PASS=

# world.sovReconcile.maxRowRetries - max retries per system row before giving up (cursor advances, rowsGivenUp).
# Not in the launcher. Range 1..1000 (0 is clamped to 1). Default: 5.
# EVEJS_LNE_WORLD_SOVRECONCILE_MAX_ROW_RETRIES=

# salvage.enabled - virtual salvagers of the battle winner (also off with modules.world / wrecks).
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SALVAGE_ENABLED=

# salvage.maxActiveJobs - global cap on active salvage jobs.
# Not in the launcher. Range 1..1000. Default: 48.
# EVEJS_LNE_SALVAGE_MAX_ACTIVE_JOBS=

# salvage.maxNewJobsPerPulse - wreck fields taken per salvage pulse (3 rows each + 2 per pulse).
# Not in the launcher. Range 1..100. Default: 6.
# EVEJS_LNE_SALVAGE_MAX_NEW_JOBS_PER_PULSE=

# salvage.pulseIntervalMs - interval of the salvage pulse in ms.
# Not in the launcher. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_SALVAGE_PULSE_INTERVAL_MS=

# salvage.baseTravelMs - base travel time for salvage outbound/return in ms.
# Not in the launcher. Range 1000..600000. Default: 120000.
# EVEJS_LNE_SALVAGE_BASE_TRAVEL_MS=

# salvage.perJumpTravelMs - per-jump travel time for salvage in ms.
# Not in the launcher. Range 1000..300000. Default: 60000.
# EVEJS_LNE_SALVAGE_PER_JUMP_TRAVEL_MS=

# salvage.baseRecoveryMs - base recovery time at the wreck field in ms.
# Not in the launcher. Range 1000..600000. Default: 45000.
# EVEJS_LNE_SALVAGE_BASE_RECOVERY_MS=

# salvage.perWreckRecoveryMs - additional recovery time per lost ship of the field in ms.
# Not in the launcher. Range 1000..300000. Default: 30000.
# EVEJS_LNE_SALVAGE_PER_WRECK_RECOVERY_MS=

# salvage.maxRecoveryMs - cap of the recovery time in ms.
# Not in the launcher. Range 1000..86400000. Default: 1800000 (30 min).
# EVEJS_LNE_SALVAGE_MAX_RECOVERY_MS=

# salvage.maxJumps - jumps from the field to the home station of the winner; farther -> no job.
# Not in the launcher. Range 0..40. Default: 10.
# EVEJS_LNE_SALVAGE_MAX_JUMPS=

# salvage.reconcileMaxJobs - open jobs checked by the reconcile after each start.
# Not in the launcher. Range 1..5000. Default: 200.
# EVEJS_LNE_SALVAGE_RECONCILE_MAX_JOBS=

# salvage.reconcileMaxAttempts - reconcile events per job phase over all starts.
# Not in the launcher. Range 1..20. Default: 3.
# EVEJS_LNE_SALVAGE_RECONCILE_MAX_ATTEMPTS=

# salvage.claimPermille - Share (permille) of the remaining base pool of a wreck field an NPC
# salvager takes; the rest stays for the player (salvage anomaly). 1000 = all (before), 0 = nothing.
# Not in the launcher. Range 0..1000. Default: 500.
# EVEJS_LNE_SALVAGE_CLAIM_PERMILLE=

# liberation.enabled - observe NPC kills of a controlling faction (seam recordNpcFactionStandingLoss) and free
# the system when its influence stays below the threshold. Needs occupation.enabled. Not in the launcher.
# Range: true/false. Default: true.
# EVEJS_LNE_LIBERATION_ENABLED=

# liberation.killInfluencePoints - influence lost by the controller per counted NPC kill.
# Not in the launcher. Range 0.01..25 (outside: clamped). Default: 2.5.
# EVEJS_LNE_LIBERATION_KILL_INFLUENCE_POINTS=

# liberation.minControllerScore - below this influence (with liberation.holdMs) the system becomes free.
# Not in the launcher. Range 0..100 (outside: clamped). Default: 25.
# EVEJS_LNE_LIBERATION_MIN_CONTROLLER_SCORE=

# liberation.holdMs - the controller must stay below the threshold for this long (hysteresis).
# Not in the launcher. Range 0..2592000000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_LIBERATION_HOLD_MS=

# liberation.maxKillsPerPlayerSystemHour - anti-farm limit of counted kills per player+system+hour.
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 30.
# EVEJS_LNE_LIBERATION_MAX_KILLS_PER_PLAYER_SYSTEM_HOUR=

# liberation.virtualKillPacingEnabled - a kill of a virtual capsuleer (ratting trip)
# lowers the controller influence by killInfluencePoints x virtualKillInfluencePermille / 1000. Player and navy kills
# stay full. Not in the launcher. Default: 0 (off).
# EVEJS_LNE_LIBERATION_VIRTUAL_KILL_PACING_ENABLED=

# liberation.virtualKillInfluencePermille - permille of the kill points for a virtual kill.
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 300.
# EVEJS_LNE_LIBERATION_VIRTUAL_KILL_INFLUENCE_PERMILLE=

# liberation.nonControllerKillsEnabled - a player kill of a non-controller faction with an influence row
# drops that row (no check, no contribution). Not in the launcher. Default: true.
# EVEJS_LNE_LIBERATION_NON_CONTROLLER_KILLS_ENABLED=

# liberation.nonControllerKillInfluencePoints - influence lost by a non-controller faction per counted kill.
# Not in the launcher. Range 0.01..25 (outside: clamped). Default: 2.5.
# EVEJS_LNE_LIBERATION_NON_CONTROLLER_KILL_INFLUENCE_POINTS=

# liberation.nonControllerVirtualKillPermille - permille of those points for a virtual capsuleer kill (0 = not
# counted). Not in the launcher. Range 0..1000 (outside: clamped). Default: 0.
# EVEJS_LNE_LIBERATION_NON_CONTROLLER_VIRTUAL_KILL_PERMILLE=

# liberation.maxChecksPerPass - most LIBERATION_CHECK events handled per scheduler pass.
# Not in the launcher. Range 1..256 (outside: clamped). Default: 8.
# EVEJS_LNE_LIBERATION_MAX_CHECKS_PER_PASS=

# liberation.rateMapSweep - size of the in-memory rate map that triggers a sweep of the stale hour buckets.
# Not in the launcher. Range 64..1048576 (outside: clamped). Default: 4096.
# EVEJS_LNE_LIBERATION_RATE_MAP_SWEEP=

# liberation.rewardsEnabled - record the kills of players against the controller
# and plan the payout (PENDING rows) when the system is freed. The wallet payout is. Not in the launcher.
# Range: true/false. Default: true.
# EVEJS_LNE_LIBERATION_REWARDS_ENABLED=

# liberation.rewardIskPerSystem - ISK pool of one liberated system, split by kills.
# Not in the launcher. Range 0..10000000000 (outside: clamped). Default: 20000000.
# EVEJS_LNE_LIBERATION_REWARD_ISK_PER_SYSTEM=

# liberation.rewardLpPerSystem - LP pool of one liberated system, split by kills.
# Not in the launcher. Range 0..1000000 (outside: clamped). Default: 4000.
# EVEJS_LNE_LIBERATION_REWARD_LP_PER_SYSTEM=

# liberation.rewardMinKills - Fewest counted kills of a character to share the pools.
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 3.
# EVEJS_LNE_LIBERATION_REWARD_MIN_KILLS=

# liberation.rewardMaxRecipients - Most characters paid for one liberation (by kills).
# Not in the launcher. Range 1..64 (outside: clamped). Default: 16.
# EVEJS_LNE_LIBERATION_REWARD_MAX_RECIPIENTS=

# liberation.rewardMaxContributorsPerSystem - Most contribution rows of one system inside
# the window (more = not recorded). Warning when below rewardMaxRecipients.
# Not in the launcher. Range 1..256 (outside: clamped). Default: 32.
# EVEJS_LNE_LIBERATION_REWARD_MAX_CONTRIBUTORS_PER_SYSTEM=

# liberation.rewardContributionWindowMs - A kill older than this does not count.
# Not in the launcher. Range 3600000..2592000000 (outside: clamped). Default: 86400000.
# EVEJS_LNE_LIBERATION_REWARD_CONTRIBUTION_WINDOW_MS=

# liberation.rewardSystemCooldownMs - no new payout plan for the same system for this long
# after the last one (0 = off). Not in the launcher. Range 0..2592000000 (outside: clamped). Default: 21600000.
# EVEJS_LNE_LIBERATION_REWARD_SYSTEM_COOLDOWN_MS=

# liberation.payoutEnabled - pay the planned rows into the EveJS wallets (ISK, LP)
# through new EveJS seams. Off = the rows wait PENDING. compose.yaml sets 0 until a try in the game.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_LIBERATION_PAYOUT_ENABLED=

# liberation.payoutPollMs - period of the payout pump pass (also the prune).
# Not in the launcher. Range 1000..600000 (outside: clamped). Default: 30000.
# EVEJS_LNE_LIBERATION_PAYOUT_POLL_MS=

# liberation.payoutMaxPerPass - most payout rows handled in one pump pass.
# Not in the launcher. Range 1..64 (outside: clamped). Default: 8.
# EVEJS_LNE_LIBERATION_PAYOUT_MAX_PER_PASS=

# liberation.payoutMaxAttempts - transient failures of a row before its pending legs
# become FAILED. Not in the launcher. Range 1..100 (outside: clamped). Default: 10.
# EVEJS_LNE_LIBERATION_PAYOUT_MAX_ATTEMPTS=

# liberation.payoutRetryBaseMs - first retry delay of a row (doubled per attempt).
# Not in the launcher. Range 1000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_LIBERATION_PAYOUT_RETRY_BASE_MS=

# liberation.payoutRetryMaxMs - longest retry delay of a row. Warning when below
# payoutRetryBaseMs. Not in the launcher. Range 1000..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_LIBERATION_PAYOUT_RETRY_MAX_MS=

# liberation.payoutRetentionMs - a PAID / FAILED row is kept this long after its
# last change. Not in the launcher. Range 86400000..31536000000 (outside: clamped). Default: 2592000000.
# EVEJS_LNE_LIBERATION_PAYOUT_RETENTION_MS=

# liberation.rewardPrunePerPass - most payout rows and most contribution rows
# (outside the window) deleted in one pass. Not in the launcher. Range 1..1000 (outside: clamped). Default: 64.
# EVEJS_LNE_LIBERATION_REWARD_PRUNE_PER_PASS=

# standings.enabled - small standing plus with the empire fighting the pirates for every pirate NPC kill in a
# pirate-held or contested system (writes the character standings of EveJS through applyStandingChanges with an
# idempotency key). Launcher field "Standings for fighting pirates" (General). Range: true/false. Default: true.
# EVEJS_LNE_STANDINGS_ENABLED=

# standings.rawChangePerGrant - raw change of one grant; delta = (10 - standing) x raw.
# Not in the launcher. Range 0.00001..0.002 (outside: clamped). Default: 0.0002.
# EVEJS_LNE_STANDINGS_RAW_CHANGE_PER_GRANT=

# standings.debounceWindowMs - 0 = off (every pirate kill is a grant); > 0 = at most one grant per
# character + beneficiary + system + window. Not in the launcher. Range 0..86400000 (outside: clamped). Default: 0.
# EVEJS_LNE_STANDINGS_DEBOUNCE_WINDOW_MS=

# standings.maxGrantsPerCharacterDay - 0 = no cap; > 0 = grants per character and UTC day. Must not exceed
# persistence.maxRowsPerTransaction. Not in the launcher. Range 0..200 (outside: clamped). Default: 0.
# EVEJS_LNE_STANDINGS_MAX_GRANTS_PER_CHARACTER_DAY=

# standings.maxGrantsPerPass - most STANDING_GRANT events handled per scheduler pass.
# Not in the launcher. Range 1..256 (outside: clamped). Default: 8.
# EVEJS_LNE_STANDINGS_MAX_GRANTS_PER_PASS=

# standings.grantMaxAgeMs - a grant decided longer ago is EXPIRED without writing the standing.
# Not in the launcher. Range 60000..604800000 (outside: clamped). Default: 86400000.
# EVEJS_LNE_STANDINGS_GRANT_MAX_AGE_MS=

# standings.pruneEnabled - retention of the grant trail (vendor receipts lne:std: in the
# character record, journal rows, DONE events). Off = nothing is deleted (the 24 h STALE_KILL guard stays on).
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_STANDINGS_PRUNE_ENABLED=

# standings.retentionMs - grant rows live until the end of the UTC day of their key + this.
# Not in the launcher. Range 86400000..2592000000 (outside: clamped). Default: 86400000.
# EVEJS_LNE_STANDINGS_RETENTION_MS=

# standings.receiptGraceMs - a vendor receipt lives at least this long after its grant is applied.
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_STANDINGS_RECEIPT_GRACE_MS=

# standings.pruneIntervalMs - period of the STANDINGS_PRUNE run.
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 300000.
# EVEJS_LNE_STANDINGS_PRUNE_INTERVAL_MS=

# standings.navyPenaltyEnabled - attacking or killing the belt navy costs standing; off = no cost of the mod, the small vendor loss of a kill stays.
# Not in the launcher. Default: true.
# EVEJS_LNE_STANDINGS_NAVY_PENALTY_ENABLED=

# standings.navyAttackRaw - raw cost of attacking the navy, once per attack window; -0.02 at standing 0.
# Not in the launcher. Range 0.00001..0.1 (outside: clamped). Default: 0.002.
# EVEJS_LNE_STANDINGS_NAVY_ATTACK_RAW=

# standings.navyKillRaw - raw cost of killing a navy ship; -0.05 at standing 0.
# Not in the launcher. Range 0.00001..0.1 (outside: clamped). Default: 0.005.
# EVEJS_LNE_STANDINGS_NAVY_KILL_RAW=

# standings.navyAttackWindowMs - one attack charge per character + faction + system in a window of this length.
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_STANDINGS_NAVY_ATTACK_WINDOW_MS=

# standings.pirateSideEnabled - a kill of an empire / CONCORD NPC in a pirate-held
# pirate-claimed or SDE pirate system gives a plus with that pirate. Not in the launcher. Default: false.
# EVEJS_LNE_STANDINGS_PIRATE_SIDE_ENABLED=

# standings.pirateSideRawChangePerGrant - raw change of one pirate-side grant.
# Not in the launcher. Range 0.00001..0.002 (outside: clamped). Default: 0.0002.
# EVEJS_LNE_STANDINGS_PIRATE_SIDE_RAW_CHANGE_PER_GRANT=

# standings.convoyPenaltyEnabled - the claim of a convoy exposure and the kill of
# a convoy ship cost standing with the owner faction. Not in the launcher. Default: false.
# EVEJS_LNE_STANDINGS_CONVOY_PENALTY_ENABLED=

# standings.convoyAttackRaw - raw cost of attacking a convoy, once per
# standings.navyAttackWindowMs. Not in the launcher. Range 0.00001..0.1 (outside: clamped). Default: 0.0015.
# EVEJS_LNE_STANDINGS_CONVOY_ATTACK_RAW=

# standings.convoyKillRaw - raw cost of killing one convoy ship.
# Not in the launcher. Range 0.00001..0.1 (outside: clamped). Default: 0.004.
# EVEJS_LNE_STANDINGS_CONVOY_KILL_RAW=

# standings.pirateKillChargeRaw - raw cost of killing one pirate NPC with its faction, 0 =
# off (to enable: 0.002). Not in the launcher. Range 0..0.1 (outside: clamped). Default: 0.
# EVEJS_LNE_STANDINGS_PIRATE_KILL_CHARGE_RAW=

# standings.pruneMaxCharactersPerPass - characters visited (= character record writes) per run.
# Not in the launcher. Range 1..256 (outside: clamped). Default: 8.
# EVEJS_LNE_STANDINGS_PRUNE_MAX_CHARACTERS_PER_PASS=

# standings.pruneMaxGrantsPerPass - grant rows deleted per run; 2N + 4 must not exceed
# persistence.maxRowsPerTransaction (else the prune does not start). Not in the launcher. Range 1..4998. Default: 200.
# EVEJS_LNE_STANDINGS_PRUNE_MAX_GRANTS_PER_PASS=

# standings.pruneMaxLookupsPerPass - journal rows scanned + receipt keys read per run.
# Not in the launcher. Range 100..100000 (outside: clamped). Default: 4000.
# EVEJS_LNE_STANDINGS_PRUNE_MAX_LOOKUPS_PER_PASS=

# scheduler.maxAttempts - Internal: attempts of a scheduled event (counted at claim) before QUARANTINED.
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 5.
# EVEJS_LNE_SCHEDULER_MAX_ATTEMPTS=

# scheduler.retryBaseMs - Internal: first retry delay (ms); doubles per attempt up to scheduler.retryMaxMs.
# Not in the launcher. Range 100..3600000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_SCHEDULER_RETRY_BASE_MS=

# scheduler.retryMaxMs - Internal: longest retry delay (ms).
# Not in the launcher. Range 1000..86400000 (outside: clamped).
# Default: 600000.
# EVEJS_LNE_SCHEDULER_RETRY_MAX_MS=

# scheduler.conflictLogLimit - Internal: the first N IDEMPOTENCY_CONFLICTs of a process (same key, other payload)
# get one "scheduler: idempotency conflict" log line (key, event types, aggregate, the event whose completion was
# running; never the payload), then only the scheduler.conflicts counter. 0 = no line.
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 20.
# EVEJS_LNE_SCHEDULER_CONFLICT_LOG_LIMIT=

# scheduler.maxOpenEvents - Internal: most open scheduled events; above it priorities 3-5 get QUEUE_FULL
# (settlements and live work are always accepted). Not in the launcher. Range 100..1000000 (outside: clamped).
# Default: 50000.
# EVEJS_LNE_SCHEDULER_MAX_OPEN_EVENTS=

# scheduler.chainedHeadroom - Internal: hard safety ceiling above maxOpenEvents for follow-up events written by
# the effect of an already accepted event (arrival -> refit / operation check). 0 = none. Not in the launcher.
# Range 0..100000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_SCHEDULER_CHAINED_HEADROOM=

# scheduler.maxPayloadBytes - Internal: largest payload (bytes of JSON) of one scheduled event.
# Not in the launcher. Range 256..65536 (outside: clamped).
# Default: 4096.
# EVEJS_LNE_SCHEDULER_MAX_PAYLOAD_BYTES=

# scheduler.intervalMs - Internal: pause (ms) between the end of one scheduler pass and the start of the next.
# Not in the launcher. Range 100..60000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_SCHEDULER_INTERVAL_MS=

# scheduler.sliceMs - Internal: work (ms) of a pass before it yields to the server for a moment.
# Not in the launcher. Range 0.5..50 (outside: clamped).
# Default: 4.
# EVEJS_LNE_SCHEDULER_SLICE_MS=

# scheduler.claimBatchSize - Internal: events claimed at once inside a pass (a batch is always finished).
# Not in the launcher. Range 1..1024 (outside: clamped).
# Default: 8.
# EVEJS_LNE_SCHEDULER_CLAIM_BATCH_SIZE=

# scheduler.catchUpLagMs - Internal: an event this late (ms) makes the pass a catch-up pass
# (at most limits.maxCatchUpEventsPerPass events). Not in the launcher. Range 1000..86400000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_SCHEDULER_CATCH_UP_LAG_MS=

# scheduler.backlogCountCap - Internal: ceiling of the backlog gauges per pass; 0 = no backlog gauges.
# Not in the launcher. Range 0..100000 (outside: clamped).
# Default: 4096.
# EVEJS_LNE_SCHEDULER_BACKLOG_COUNT_CAP=

# scheduler.adaptiveClaimBatch - Internal: size each claim batch to the budget left in the pass. 0 = fixed
# scheduler.claimBatchSize (emergency fallback).
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_SCHEDULER_ADAPTIVE_CLAIM_BATCH=

# scheduler.costEwmaInitialMs - Internal: starting estimate of the cost of one event (ms).
# Not in the launcher. Range 0.05..20 (outside: clamped).
# Default: 0.6.
# EVEJS_LNE_SCHEDULER_COST_EWMA_INITIAL_MS=

# scheduler.costEwmaAlpha - Internal: smoothing of the per-event cost estimate.
# Not in the launcher. Range 0.01..1 (outside: clamped).
# Default: 0.2.
# EVEJS_LNE_SCHEDULER_COST_EWMA_ALPHA=

# scheduler.heavyPacing - Internal: limit heavy events (OPERATIONAL/STRATEGIC/MAINTENANCE types whose average cost
# is >= scheduler.heavyEventMs) to scheduler.heavyPerWindow per scheduler.heavyWindowMs and 1 per pass, only with
# real tick samples of the governor. 0 = no pacing.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_SCHEDULER_HEAVY_PACING=

# scheduler.heavyEventMs - Internal: average cost of one event (ms) from which its type is heavy.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 30.
# EVEJS_LNE_SCHEDULER_HEAVY_EVENT_MS=

# scheduler.heavyPerWindow - Internal: most heavy events per scheduler.heavyWindowMs (keep it below the samples
# above p95 of governor.sampleCount, 5 of 100).
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 3.
# EVEJS_LNE_SCHEDULER_HEAVY_PER_WINDOW=

# scheduler.heavyWindowMs - Internal: sliding window of the heavy event limit (ms).
# Not in the launcher. Range 1000..600000 (outside: clamped).
# Default: 10000.
# EVEJS_LNE_SCHEDULER_HEAVY_WINDOW_MS=

# scheduler.heavySampleCapFactor - Internal: a per-type cost sample is capped at this factor x
# scheduler.heavyEventMs before it enters the average (one GC or cold-write spike cannot make a light type heavy).
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 4.
# EVEJS_LNE_SCHEDULER_HEAVY_SAMPLE_CAP_FACTOR=

# scheduler.heavyMinSamples - Internal: samples a type needs before it can be heavy; with fewer it runs once per pass
# without a token (unmeasured). The average starts from the smallest of these samples.
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_SCHEDULER_HEAVY_MIN_SAMPLES=

# scheduler.reescalationWindowMs - Internal: a governor escalation this soon after a catch-up start counts in
# scheduler.catchUpReescalations (measure only, ms).
# Not in the launcher. Range 1000..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_SCHEDULER_REESCALATION_WINDOW_MS=

# scheduler.latenessDetail - Internal: lateness histograms per work class (scheduler.lateness.<class>), counters
# scheduler.stoppedBy.time|items|write, gauge scheduler.oldestDueAgeMs and status latenessByType (measure only).
# 0 = no new metric names. Not in the launcher.
# Default: 1.
# EVEJS_LNE_SCHEDULER_LATENESS_DETAIL=

# scheduler.latenessSlowMs - Internal: a dispatch this late (ms) counts as "over" in status latenessByType.
# Not in the launcher. Range 1000..600000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_SCHEDULER_LATENESS_SLOW_MS=

# scheduler.latenessTopTypes - Internal: event types listed in status latenessByType (by max lateness), the rest
# as more. Not in the launcher. Range 1..100 (outside: clamped).
# Default: 12.
# EVEJS_LNE_SCHEDULER_LATENESS_TOP_TYPES=

# fleets.maxCompositionEntries - Internal: most composition entries (hull group / type) of one virtual fleet.
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 32.
# EVEJS_LNE_FLEETS_MAX_COMPOSITION_ENTRIES=

# fleets.maxShipsPerFleet - Internal: most ships in one virtual fleet.
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_FLEETS_MAX_SHIPS_PER_FLEET=

# fleets.maxFleetsPerOperation - Internal: most fleets assigned to one operation.
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_FLEETS_MAX_FLEETS_PER_OPERATION=

# fleets.maxJsonBytes - Internal: largest route / cargo / operation result (bytes of JSON).
# Not in the launcher. Range 256..65536 (outside: clamped).
# Default: 4096.
# EVEJS_LNE_FLEETS_MAX_JSON_BYTES=

# fleets.maxListLimit - Internal: most fleets or operations in one list page or batch read.
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_FLEETS_MAX_LIST_LIMIT=

# fleets.travelTimeFactor - Internal: multiplies the jump time of virtual fleet travel (1 = as in EVE).
# Not the test acceleration. Not in the launcher. Range 0.1..10 (outside: clamped).
# Default: 1.
# EVEJS_LNE_FLEETS_TRAVEL_TIME_FACTOR=

# fleets.refitMs - Internal: repair time (ms) of a fleet after a retreat.
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_FLEETS_REFIT_MS=

# fleets.operationMaxOverdueRounds - Internal: rechecks (with backoff) of an operation whose member is past its
# arrival time; after them the check is quarantined. Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 12.
# EVEJS_LNE_FLEETS_OPERATION_MAX_OVERDUE_ROUNDS=

# fleets.refitPolicy - Internal: where a fleet repairs after a retreat: station = only at an ONLINE station of
# its own faction (a stranded fleet looks for one), anywhere = repair in place (use it for the M3 bench).
# A bad value is ignored with a warning.
# Not in the launcher.
# Default: station.
# EVEJS_LNE_FLEETS_REFIT_POLICY=

# battle.maxFleetsPerSide - Internal: most fleets on one side of a battle.
# Not in the launcher. Range 1..32 (outside: clamped).
# Default: 8.
# EVEJS_LNE_BATTLE_MAX_FLEETS_PER_SIDE=

# battle.maxResolutionMs - Internal: ceiling of the resolution time budget (ms) of one battle.
# Not in the launcher. Range 1..5000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_BATTLE_MAX_RESOLUTION_MS=

# battle.maxInputBytes - Internal: largest stored battle input (bytes of JSON).
# Not in the launcher. Range 4096..262144 (outside: clamped).
# Default: 65536.
# EVEJS_LNE_BATTLE_MAX_INPUT_BYTES=

# battle.maxResultBytes - Internal: largest stored battle result (bytes of JSON).
# Below 2 x 2 x maxFleetsPerSide x fleets.maxCompositionEntries x 96 -> warning (a large result may be refused).
# Not in the launcher. Range 4096..262144 (outside: clamped).
# Default: 131072.
# EVEJS_LNE_BATTLE_MAX_RESULT_BYTES=

# battle.maxListLimit - Internal: most battles in one list page.
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_BATTLE_MAX_LIST_LIMIT=

# battle.retreatSearchMaxJumps - Internal: radius (jumps) of the search for a friendly system (controlled by
# the fleet's faction) where a fleet retreats after a battle; then its home system, then a repair in place.
# Not in the launcher. Range 1..40 (outside: clamped).
# Default: 5.
# EVEJS_LNE_BATTLE_RETREAT_SEARCH_MAX_JUMPS=

# battle.retreatSearchMaxSystems - Internal: most systems read by that search per faction and settlement.
# Not in the launcher. Range 1..5000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_BATTLE_RETREAT_SEARCH_MAX_SYSTEMS=

# battle.retreatMaxCandidates - Internal: friendly systems tried before the home system.
# Not in the launcher. Range 1..10 (outside: clamped).
# Default: 3.
# EVEJS_LNE_BATTLE_RETREAT_MAX_CANDIDATES=

# battle.settleRowsReserve - Internal: rows of one transaction kept for the consequences of a settlement
# (wrecks, influence), a refused attempt + quarantine and DONE. Settlement rows = persistence.maxRowsPerTransaction
# minus this; a battle needing more is refused at creation (warning when the largest battle does not fit,
# error when nothing is left).
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 56.
# EVEJS_LNE_BATTLE_SETTLE_ROWS_RESERVE=

# battle.engageDelayMs - Internal: virtual time (ms) from a contact of two hostile fleets to the resolution of their battle.
# Not in the launcher. Range 0..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_BATTLE_ENGAGE_DELAY_MS=

# battle.recontactCooldownMs - Internal: no new battle of the same faction pair in the system for this long (ms) after a DRAW or a
# failed battle; then a recheck.
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_BATTLE_RECONTACT_COOLDOWN_MS=

# battle.contactScanMaxFleets - Internal: contactable fleets read per contact check (warning when below 2 x maxFleetsPerSide).
# Not in the launcher. Range 2..500 (outside: clamped).
# Default: 64.
# EVEJS_LNE_BATTLE_CONTACT_SCAN_MAX_FLEETS=

# battle.holdRecheckMs - Internal: recheck period (ms) of a battle held while players watch its system (AWAITING_LIVE).
# Not in the launcher. Range 5000..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_BATTLE_HOLD_RECHECK_MS=

# battle.holdWhenPresenceUnknown - Internal: 1 = hold battles while the player presence data is stale or failed; 0 = resolve them
# virtually.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_BATTLE_HOLD_WHEN_PRESENCE_UNKNOWN=

# battle.holdRadius - Internal: hold radius (jumps) of a battle near a player while modules.materialization is on
# (off: radius 0). Clamped by presence.maxRadius.
# Not in the launcher. Range 0..5 (outside: clamped).
# Default: 1.
# EVEJS_LNE_BATTLE_HOLD_RADIUS=

# battle.neighborHoldMaxMs - Internal: longest hold (ms from the battle start) of a battle 1+ jumps from a player
# (0 = neighbours never hold).
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 600000.
# EVEJS_LNE_BATTLE_NEIGHBOR_HOLD_MAX_MS=

# battle.reconcileDelayMs - Internal: delay (ms) of the one reconcile of open battles after each start.
# Not in the launcher. Range 0..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_BATTLE_RECONCILE_DELAY_MS=

# battle.reconcileMaxBattles - Internal: battles / engaged fleets per page of the reconcile.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_BATTLE_RECONCILE_MAX_BATTLES=

# battle.logSettledPerMin - Internal: most 'battle: settled' log lines per minute (demo battles always logged).
# Not in the launcher. Range 0..600 (outside: clamped).
# Default: 10.
# EVEJS_LNE_BATTLE_LOG_SETTLED_PER_MIN=

# battle.liveLossImport.enabled - enable the live loss import hook from killmailTracker
# (markDestroyed of LIVE members). Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_BATTLE_LIVE_LOSS_IMPORT_ENABLED=

# battle.liveEndMonitor.enabled - enable the LIVE battle end monitor (timeout / no survivors
# -> exitLiveInTx END). Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_BATTLE_LIVE_END_MONITOR_ENABLED=

# battle.liveEndMonitor.timeoutMs - max time a LIVE_EVEJS battle can run without ending
# (safety timeout). Not in the launcher. Range 60000..3600000 (outside: clamped).
# Default: 300000.
# EVEJS_LNE_BATTLE_LIVE_END_MONITOR_TIMEOUT_MS=

# structure live combat (structure siege near a player, LIVE_EVEJS)
# battle.structureLiveCombat.enabled - a contact at a mod station in HULL_ASSAULT / ANCHOR_ASSAULT marks the
# battle with its structure; a LIVE one exits STRUCTURE_DESTROYED when the structure dies (the siege counts the fall).
# Works only with modules.materialization and siege.nativeDestructionEnabled. Not in the launcher.
# Range: true/false. Default: false.
# EVEJS_LNE_BATTLE_STRUCTURE_LIVE_COMBAT_ENABLED=

# the influence garrison in the battle input.
# battle.influenceGarrison - legacy = side B gets its influence garrison (the power of its standing fleets) plus its
# station points (behaviour before). off = the garrison is station points only (the standing fleets fight as
# ships); the attack planner in strategy.garrisonEstimate=resolver then also counts station points only.
# Default off, always a pair with strategy.garrisonEstimate=resolver (as compose since).
# Rollback only as a pair: BATTLE_INFLUENCE_GARRISON=legacy and STRATEGY_GARRISON_ESTIMATE=legacy.
# Not in the launcher. One of legacy, off. Default: off.
# EVEJS_LNE_BATTLE_INFLUENCE_GARRISON=

# Contact check of a released fleet.
# battle.releaseContact.enabled - a fleet released from MATERIALIZED (end of a hunt, a garrison patrol or an exposure)
# queues one BATTLE_CONTACT_CHECK contact:<sys>:rel:<id> in its system. Not in the launcher.
# Range: true/false. Default: true.
# EVEJS_LNE_BATTLE_RELEASE_CONTACT_ENABLED=

# Capsuleer fleets on a trip take part in a contact.
# battle.capsuleerTripsFightable.enabled - a fleet of role capsuleer with an operation (rat, salvage, return) is not
# evasive, so a hostile fleet in its system starts a battle (side B = 500018); at its base it stays evasive.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_BATTLE_CAPSULEER_TRIPS_FIGHTABLE_ENABLED=

# Contacts per grid.
# battle.gridContacts.enabled - fleet-fleet contact only in a common grid of the system (needs grid.enabled and
# grid.movesEnabled), garrison pool and station points of the battle grid only, contact check after
# FLEET_GRID_ARRIVAL. Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_BATTLE_GRID_CONTACTS_ENABLED=

# Assembly and decline. Internal (not in the
# launcher), out of range = clamped; consumers in.
# battle.assembly.enabled - a STAGED invasion/raid fleet waits for its operation fleets in flight. Default: false.
# EVEJS_LNE_BATTLE_ASSEMBLY_ENABLED=
# battle.assemblyGraceMs - most wait of the assembly contact (ms). Range 0..7200000. Default: 1800000 (30 min).
# EVEJS_LNE_BATTLE_ASSEMBLY_GRACE_MS=
# A superseded assembly check is rechecked; after the last round it makes the contact itself.
# battle.assemblyRecheckMs - delay of the next round (ms). Range 1000..3600000. Default: 60000.
# EVEJS_LNE_BATTLE_ASSEMBLY_RECHECK_MS=
# battle.assemblyMaxRounds - rechecks before the check makes the contact. Range 0..20. Default: 3.
# EVEJS_LNE_BATTLE_ASSEMBLY_MAX_ROUNDS=
# battle.decline.enabled - STAGED raid fleets far weaker than the defender retreat before the battle. Default: false.
# EVEJS_LNE_BATTLE_DECLINE_ENABLED=
# battle.declineRatioPermille - decline when power A x 1000 < (power B + garrison B) x this. Range 1..1000.
# Default: 500.
# EVEJS_LNE_BATTLE_DECLINE_RATIO_PERMILLE=

# A battle with a station garrison near a player goes LIVE with garrison proxy
# ships (fleet_id garrison, side and faction of the garrison). Internal, not in the launcher.
# battle.garrisonLive.enabled - on = garrison battles materialize (needs modules.materialization); off =
# GARRISON_UNSUPPORTED, resolved virtually. Range: true/false. Default: false.
# EVEJS_LNE_BATTLE_GARRISON_LIVE_ENABLED=

# battle.garrisonLive.maxShips - most garrison proxy ships of one LIVE battle (0 = the garrison is left out of
# LIVE). Range 0..64 (outside: clamped). Default: 6.
# EVEJS_LNE_BATTLE_GARRISON_LIVE_MAX_SHIPS=

# battle.garrisonLive.pointsPerShip - garrison strength points per proxy ship
# k = min(maxShips, ceil(strength / pointsPerShip)). Range 1..100000 (outside: clamped). Default: 25.
# EVEJS_LNE_BATTLE_GARRISON_LIVE_POINTS_PER_SHIP=

# battle.garrisonLive.hullGroup - hull group of the proxy ships, one of frigate|tackle|ewar|destroyer|cruiser|
# logistics|battlecruiser|battleship|capital. Default: cruiser.
# EVEJS_LNE_BATTLE_GARRISON_LIVE_HULL_GROUP=

# wrecks.enabled - Internal: wreck fields after virtual battles. 0 = no new fields, the expiry events park, no
# layer; the existing fields stay untouched.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_WRECKS_ENABLED=

# wrecks.fieldTtlMs - Internal: lifetime of a wreck field (7 days); frozen into each field when it is created.
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 604800000.
# EVEJS_LNE_WRECKS_FIELD_TTL_MS=

# wrecks.decayFloor - Internal: share of the wreck pool left at expiry (linear decay from 1).
# Not in the launcher. Range 0..1 (outside: clamped).
# Default: 0.25.
# EVEJS_LNE_WRECKS_DECAY_FLOOR=

# wrecks.maxFieldsPerSystem - Internal: active wreck fields per system; a new field evicts the oldest.
# Not in the launcher. Range 1..50 (outside: clamped).
# Default: 3.
# EVEJS_LNE_WRECKS_MAX_FIELDS_PER_SYSTEM=

# wrecks.maxFieldsGlobal - Internal: active wreck fields in the world; a new field evicts the oldest.
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_WRECKS_MAX_FIELDS_GLOBAL=

# wrecks.minShipsLost - Internal: ships lost in a battle below which it leaves no wreck field.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 1.
# EVEJS_LNE_WRECKS_MIN_SHIPS_LOST=

# wrecks.maxCompositionEntries - Internal: entries of the wreck composition; above it one entry per faction and hull
# group.
# Not in the launcher. Range 1..512 (outside: clamped).
# Default: 64.
# EVEJS_LNE_WRECKS_MAX_COMPOSITION_ENTRIES=

# wrecks.salvageYieldFactor - Internal: multiplier of the salvage units per destroyed hull.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 1.
# EVEJS_LNE_WRECKS_SALVAGE_YIELD_FACTOR=

# wrecks.lootYieldFactor - Internal: multiplier of the loot units per destroyed hull.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 1.
# EVEJS_LNE_WRECKS_LOOT_YIELD_FACTOR=

# permille of lost stock units added to loot of a structure wreck field.
# wrecks.stockLootPermille - Internal: share of station stock units added to structure wreck loot.
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_WRECKS_STOCK_LOOT_PERMILLE=

# strategy.campaigns - Internal: active campaigns of the faction registry (lib/strategy/data/campaigns.js), a comma
# list of at most 8 ids, or "none" for no campaign (an empty value means unset). A bad value is ignored with a
# warning. Not in the launcher.
# Default: k3-stain.
# EVEJS_LNE_STRATEGY_CAMPAIGNS=

# strategy.activeFactions - Internal: factions that play: "registry" = every registry entry with
# activity active, a comma list of faction ids = a subset of them (switch per faction), "none" = no faction. An
# unknown or passive id, or more than strategy.maxActiveFactions, refuses the strategy service; a bad format is
# ignored with a warning. Not in the launcher.
# Default: registry.
# EVEJS_LNE_STRATEGY_ACTIVE_FACTIONS=

# strategy.maxActiveFactions - Internal: cap of the factions that play.
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 16.
# EVEJS_LNE_STRATEGY_MAX_ACTIVE_FACTIONS=

# strategy.factionSeedEnabled - Internal: seed the world_factions rows from the registry (an existing row wins).
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STRATEGY_FACTION_SEED_ENABLED=

# strategy.budgetFactor - Internal: multiplier of the start budgets of the registry, only when a row is created.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 1.
# EVEJS_LNE_STRATEGY_BUDGET_FACTOR=

# strategy.maxRegistryFactions - Internal: factions of the registry and rows of listFactions.
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 64.
# EVEJS_LNE_STRATEGY_MAX_REGISTRY_FACTIONS=

# strategy.maxCampaignSystems - Internal: systems of one campaign theatre.
# Not in the launcher. Range 1..200 (outside: clamped).
# Default: 40.
# EVEJS_LNE_STRATEGY_MAX_CAMPAIGN_SYSTEMS=

# strategy.maxResourceUnits - Internal: cap of the faction resource and reserve units.
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 1000000000.
# EVEJS_LNE_STRATEGY_MAX_RESOURCE_UNITS=

# strategy.aiEnabled - Internal: switch of the faction strategy review; off = factions do nothing.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STRATEGY_AI_ENABLED=

# strategy.reviewIntervalMs - Internal: period of one faction strategy review in ms (virtual time).
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 900000.
# EVEJS_LNE_STRATEGY_REVIEW_INTERVAL_MS=

# strategy.maxReviewsPerPass - Internal: faction reviews handled in one scheduler pass.
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 2.
# EVEJS_LNE_STRATEGY_MAX_REVIEWS_PER_PASS=

# strategy.decideThrewLogIntervalMs - Internal: at most one "strategy: <faction> decide threw" log line
# per faction per this many ms (full and reactive review each). Not in the launcher.
# Range 1000..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_STRATEGY_DECIDE_THREW_LOG_INTERVAL_MS=

# strategy.reactiveEnabled - Internal: reactive review between full reviews (defense, relief of own systems).
# Not in the launcher.
# Default: true (faster-strategy-reviews-enable). 0 = off.
# EVEJS_LNE_STRATEGY_REACTIVE_ENABLED=

# strategy.reactiveIntervalMs - Internal: period of one reactive review in ms (virtual time).
# Not in the launcher. Range 30000..900000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_STRATEGY_REACTIVE_INTERVAL_MS=

# strategy.maxReactiveReviewsPerPass - Internal: legacy per-faction reactive rows drained (SUPERSEDED) in one
# scheduler pass (the reactive sweep runs once per pass).
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_STRATEGY_REACTIVE_MAX_REVIEWS_PER_PASS=

# strategy.reactiveMaxLaunchesPerHour - Internal: defense / relief launches of the reactive review per faction per hour.
# Not in the launcher. Range 0..64 (outside: clamped). 0 = read without action.
# Default: 4.
# EVEJS_LNE_STRATEGY_REACTIVE_MAX_LAUNCHES_PER_HOUR=

# strategy.reactiveDoneRetentionMs - Internal: age of finished reactive review rows deleted by later rounds.
# Not in the launcher. Range 600000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_STRATEGY_REACTIVE_DONE_RETENTION_MS=

# strategy.reactivePruneBatch - Internal: finished reactive review rows deleted per round (0 = no retention).
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_STRATEGY_REACTIVE_PRUNE_BATCH=

# strategy.maxReachJumps - Internal: ceiling of the operational reach of a faction in jumps.
# Not in the launcher. Range 1..40 (outside: clamped).
# Default: 10.
# EVEJS_LNE_STRATEGY_MAX_REACH_JUMPS=

# strategy.supplyChainJumps - Internal: jumps of the chain of own systems that extends the supply anchors.
# Not in the launcher. Range 0..40 (outside: clamped).
# Default: 10.
# EVEJS_LNE_STRATEGY_SUPPLY_CHAIN_JUMPS=

# strategy.captureRangeFromStationJumps - Internal: invasion targets lie at most this many jumps from an own online station.
# Not in the launcher. Range 1..40 (outside: clamped).
# Default: 15.
# EVEJS_LNE_STRATEGY_CAPTURE_RANGE_FROM_STATION_JUMPS=

# strategy.maxAssemblyJumps - Internal: how far from the target a fleet may be to join an operation.
# Not in the launcher. Range 1..40 (outside: clamped).
# Default: 15.
# EVEJS_LNE_STRATEGY_MAX_ASSEMBLY_JUMPS=

# strategy.mobilizeFallbackJumps - Internal: radius from the target of a far mobilization station holding the whole template when none lies in maxAssemblyJumps; <= maxAssemblyJumps (also 0) = off.
# Not in the launcher. Range 0..40 (outside: clamped).
# Default: 30.
# EVEJS_LNE_STRATEGY_MOBILIZE_FALLBACK_JUMPS=

# strategy.mobilizeFallbackMaxSystems - Internal: systems visited by the search of a far mobilization.
# Not in the launcher. Range 10..20000 (outside: clamped).
# Default: 9000.
# EVEJS_LNE_STRATEGY_MOBILIZE_FALLBACK_MAX_SYSTEMS=

# strategy.maxBfsSystems - Internal: systems visited by one search of a review.
# Not in the launcher. Range 10..20000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_STRATEGY_MAX_BFS_SYSTEMS=

# strategy.bfsMemoMaxEntries - Internal: BFS results kept in memory per graph for the faction reviews.
# Not in the launcher. Cleared when full; 0 = every search computed again. Range 0..10000 (outside: clamped).
# Default: 512.
# EVEJS_LNE_STRATEGY_BFS_MEMO_MAX_ENTRIES=

# strategy.bfsMemoMaxSystems - Internal: systems held by all BFS results of that memory (sum of the result sizes,
# about 40 B each; 250000 = about 10 MB). Not in the launcher. Cleared when the next result would pass it; a single
# result above it is not kept. Range 1000..10000000 (outside: clamped).
# Default: 250000.
# EVEJS_LNE_STRATEGY_BFS_MEMO_MAX_SYSTEMS=

# strategy.maxTargetCandidates - Internal: target candidates scored per review.
# Not in the launcher. Range 1..200 (outside: clamped).
# Default: 40.
# EVEJS_LNE_STRATEGY_MAX_TARGET_CANDIDATES=

# strategy.targetPickTopK - Internal: weighted pick among this many best targets.
# Not in the launcher. Range 1..10 (outside: clamped).
# Default: 3.
# EVEJS_LNE_STRATEGY_TARGET_PICK_TOP_K=

# strategy.maxOperationsPerReview - Internal: new operations per review.
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 2.
# EVEJS_LNE_STRATEGY_MAX_OPERATIONS_PER_REVIEW=

# strategy.maxFleetsPerOperation - Internal: fleets of one new operation.
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 6.
# EVEJS_LNE_STRATEGY_MAX_FLEETS_PER_OPERATION=

# strategy.maxFleetsPerFaction - Internal: live fleets of one faction (mobilization ceiling).
# Not in the launcher. Range 0..200 (outside: clamped).
# Default: 32.
# EVEJS_LNE_STRATEGY_MAX_FLEETS_PER_FACTION=

# strategy.reconUnblockEnabled - Experimental: scouts outside maxFleetsPerFaction with their own limit;
# a failed scout mobilization skips the target instead of ending the review.
# Live: 1 (with EVEJS_LNE_UPKEEP_SHIP_CAP_SCOUT_SHIPS=4 the scouts mobilize under the ship cap).
# Not in the launcher. Values: 1/0.
# Default: 0.
# EVEJS_LNE_STRATEGY_RECON_UNBLOCK_ENABLED=

# strategy.maxScoutsPerFaction - Internal: live scout fleets per faction with reconUnblockEnabled.
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 4.
# EVEJS_LNE_STRATEGY_MAX_SCOUTS_PER_FACTION=

# strategy.raidFrontLimitEnabled - Experimental: at most maxRaidFronts raid fronts; raid-only targets
# are no candidates when full.
# Not in the launcher. Values: 1/0.
# Default: 0.
# EVEJS_LNE_STRATEGY_RAID_FRONT_LIMIT_ENABLED=

# strategy.maxRaidFronts - Internal: open raid fronts per faction with raidFrontLimitEnabled.
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_STRATEGY_MAX_RAID_FRONTS=

# strategy.hostilePremiumCaptureOnly - Hostile target premium (+350) only when the target is capturable
# in this review AND not blocked (captureAllowed && captureBlock === null; territory limit, adjacency, war chest).
# TARGET_SCORING_VERSION 10. Not in the launcher. Values: 1/0.
# Default: 1.
# EVEJS_LNE_STRATEGY_HOSTILE_PREMIUM_CAPTURE_ONLY=

# strategy.maxMobilizationsPerReview - Internal: fleets mobilized per review.
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 3.
# EVEJS_LNE_STRATEGY_MAX_MOBILIZATIONS_PER_REVIEW=

# strategy.mobilizeResourcePerShip - Internal: resource units per mobilized ship.
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_STRATEGY_MOBILIZE_RESOURCE_PER_SHIP=

# strategy.mobilizeReservePerShip - Internal: reserve units per mobilized ship.
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 1.
# EVEJS_LNE_STRATEGY_MOBILIZE_RESERVE_PER_SHIP=

# strategy.attackStrengthRatio - Internal: strength advantage an attack needs.
# Not in the launcher. Range 0.1..10 (outside: clamped).
# Default: 1.2.
# EVEJS_LNE_STRATEGY_ATTACK_STRENGTH_RATIO=

# strategy.invaderCounter.enabled - Internal: idle fleets of the kinds below attack an ACTIVE invader beachhead near own space (no front, no capture).
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_INVADER_COUNTER_ENABLED=

# strategy.invaderCounter.maxPerReview - Internal: counter-offensive LAUNCHes per review (operation slots left by the offensive).
# Range 0..4 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_INVADER_COUNTER_MAX_PER_REVIEW=

# strategy.invaderCounter.rangeJumps - Internal: a beachhead is a target within these jumps of an own system (<= graph.routeMaxJumps).
# Range 1..15 (outside: clamped). Default: 6.
# EVEJS_LNE_STRATEGY_INVADER_COUNTER_RANGE_JUMPS=

# strategy.invaderCounter.maxBeachheadsRead - Internal: beachheads read per review of one faction.
# Range 1..32 (outside: clamped). Default: 8.
# EVEJS_LNE_STRATEGY_INVADER_COUNTER_MAX_BEACHHEADS_READ=

# strategy.invaderCounter.holderReadLimit - Internal: defender fleets read per beachhead (more = no target).
# Range 1..64 (outside: clamped). Default: 16.
# EVEJS_LNE_STRATEGY_INVADER_COUNTER_HOLDER_READ_LIMIT=

# strategy.invaderCounter.kinds - Internal: faction kinds that run the counter-offensive (comma list of pirate, empire, police, neutral, invader, hive).
# Default: empire.
# EVEJS_LNE_STRATEGY_INVADER_COUNTER_KINDS=

# strategy.garrisonEstimate - Internal: how the attack planner counts the garrison of a target.
# legacy = the power sum of the garrison fleets (behaviour before). resolver = the garrison points as the battle
# resolver fights them: round((garrison + hostile stations x npc station points) x sqrt(battle.resolverGarrisonDps
# PerPoint x battle.resolverGarrisonEhpPerPoint)); the AI attacks a garrisoned system only with a much larger force.
# Default resolver, always a pair with battle.influenceGarrison=off (as compose since).
# Rollback only as a pair: STRATEGY_GARRISON_ESTIMATE=legacy and BATTLE_INFLUENCE_GARRISON=legacy.
# Not in the launcher. One of legacy, resolver. Default: resolver.
# EVEJS_LNE_STRATEGY_GARRISON_ESTIMATE=

# strategy.battleshipDoctrines - Internal: battleships in the doctrines of the
# empires and the territorial pirates (overlay battleshipTemplates of the doctrine data, invasion only since
# Garrisons stay as before).
# off = templates as before; stock = production builds the battleships into the station stock, the fleets stay as
# before; on = invasion fleets also carry the battleships. Go off -> stock (>= 24 h) -> on.
# Rollback = off and restart (battleships already built stay in stocks and fleets). A bad value is ignored with
# a warning.
# Not in the launcher. One of off, stock, on. Default: off.
# EVEJS_LNE_STRATEGY_BATTLESHIP_DOCTRINES=

# strategy.escalationEnabled - Internal: an attack
# target gets a level 0..3 (fleets of the base template it needs, a lost home / hostile stations / a player system,
# lost raids) and the mobilization takes a heavier template step: patrol -> invasion (battlecruisers) -> invasion
# with battleships (stockTemplates, needs strategy.battleshipDoctrines=stock). No hulls / ISK / resources -> one step
# lower (note ESCALATION_FALLBACK). Counters strategy.review.escalatedMobilized / escalationFallback.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_ESCALATION_ENABLED=

# strategy.escalationFleetsL1 - Internal: fleets of the base template needed for pressure 1.
# Not in the launcher. Range 1..16 (outside: clamped). Default: 2.
# EVEJS_LNE_STRATEGY_ESCALATION_FLEETS_L1=

# strategy.escalationFleetsL2 - Internal: fleets of the base template needed for pressure 2.
# Not in the launcher. Range 1..16 (outside: clamped). Default: 4.
# EVEJS_LNE_STRATEGY_ESCALATION_FLEETS_L2=

# strategy.escalationFleetsL3 - Internal: fleets of the base template needed for pressure 3.
# Not in the launcher. Range 1..16 (outside: clamped). Default: 6.
# EVEJS_LNE_STRATEGY_ESCALATION_FLEETS_L3=

# strategy.escalationValueBonus - Internal: levels added for a lost home, hostile stations or a player system.
# Not in the launcher. Range 0..3 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_ESCALATION_VALUE_BONUS=

# strategy.escalationLossStep - Internal: one level per this many lost raids on the target (0 = no term).
# Not in the launcher. Range 0..16 (outside: clamped). Default: 2.
# EVEJS_LNE_STRATEGY_ESCALATION_LOSS_STEP=

# strategy.escalationMaxLevel - Internal: the ceiling of the escalation level.
# Not in the launcher. Range 0..3 (outside: clamped). Default: 3.
# EVEJS_LNE_STRATEGY_ESCALATION_MAX_LEVEL=

# strategy.escalationCapitalMinLevel - Internal: with
# strategy.escalationEnabled and strategy.capitalAttachEnabled a mobilization attaches a carrier / dreadnought / FAX
# only for a target of at least this escalation level (lower: note CAPITAL_LEVEL_GATED, counter
# strategy.review.capitalLevelGated). Not in the launcher. Range 1..3 (outside: clamped). Default: 2.
# EVEJS_LNE_STRATEGY_ESCALATION_CAPITAL_MIN_LEVEL=

# strategy.escalationSuperMinLevel - Internal: the same for a supercarrier / titan (below
# escalationCapitalMinLevel: warning). Not in the launcher. Range 1..3 (outside: clamped). Default: 3.
# EVEJS_LNE_STRATEGY_ESCALATION_SUPER_MIN_LEVEL=

# strategy.capitalPostLevelEnabled - Internal: with
# strategy.escalationEnabled the garrison and the hunter mobilizations get the escalation level of their post /
# hunting ground (hostile strength seen, HQ, lost raids) for the capital gate. Off = level 0 (no capital at the gate).
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_CAPITAL_POST_LEVEL_ENABLED=

# strategy.capitalHomeLevelBonus - Internal: levels added to the post level of the faction HQ.
# Not in the launcher. Range 0..3 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_CAPITAL_HOME_LEVEL_BONUS=

# strategy.garrisonEscalationEnabled - Experimental: with
# strategy.escalationEnabled a garrison reinforcement of a post at escalation level >= 1 (hot post, HQ) takes the
# heavier template steps (ESCALATION_STEPS.garrison: up to the invasion battleship template); no hulls for a step ->
# the step below, at the end the base template. The fleet role stays garrison, the weak-post threshold is unchanged.
# Not in the launcher. Range: true/false. Default: false (recommended: true).
# EVEJS_LNE_STRATEGY_GARRISON_ESCALATION_ENABLED=

# strategy.intelTtlMs - Internal: how long an observation counts as fresh, ms.
# Not in the launcher. Range 600000..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_STRATEGY_INTEL_TTL_MS=

# strategy.battleIntelTtlMs - Internal: how long an observation from a battle counts as fresh, ms (0 = intelTtlMs).
# Not in the launcher. Range 0..604800000 (outside: clamped).
# Default: 86400000.
# EVEJS_LNE_STRATEGY_BATTLE_INTEL_TTL_MS=

# strategy.maxIntelRowsPerFaction - Internal: intel rows per faction.
# Not in the launcher. Range 16..10000 (outside: clamped).
# Default: 512.
# EVEJS_LNE_STRATEGY_MAX_INTEL_ROWS_PER_FACTION=

# strategy.reconLossEnabled - Internal: memory of scout fleet losses per target system and a recon cooldown after
# reconLossThreshold losses.
# Not in the launcher.
# Default: true. 0 = off (no write, no read, the planner works as before).
# EVEJS_LNE_STRATEGY_RECON_LOSS_ENABLED=

# strategy.reconLossThreshold - Internal: scout fleet losses in the window that start a recon cooldown.
# Not in the launcher. Range 1..20 (outside: clamped).
# Default: 2.
# EVEJS_LNE_STRATEGY_RECON_LOSS_THRESHOLD=

# strategy.reconLossCooldownMs - Internal: base recon cooldown (ms), times min(losses - threshold + 1, max multiplier).
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000 (72 h).
# EVEJS_LNE_STRATEGY_RECON_LOSS_COOLDOWN_MS=

# strategy.reconLossWindowMs - Internal: time (ms) after the end of the recon cooldown (or the last loss, when later)
# in which a new scout loss continues the series.
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 604800000 (7 d).
# EVEJS_LNE_STRATEGY_RECON_LOSS_WINDOW_MS=

# strategy.reconLossMaxMultiplier - Internal: cap of the recon cooldown multiplier.
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 4.
# EVEJS_LNE_STRATEGY_RECON_LOSS_MAX_MULTIPLIER=

# strategy.maxReconLossRowsPerFaction - Internal: rows of world_faction_recon_losses per faction (RECON_LOSS_LIMIT).
# Not in the launcher. Range 16..2048 (outside: clamped).
# Default: 128.
# EVEJS_LNE_STRATEGY_MAX_RECON_LOSS_ROWS_PER_FACTION=

# Memory of lost raids and the ISK cost gate.
# All internal (not in the launcher), out of range = clamped; consumers in.
# strategy.attackLossMemoryEnabled - lost raid battles per faction and target start an attack cooldown. Default: false.
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_MEMORY_ENABLED=
# strategy.attackLossThreshold - losses in the window that start the cooldown. Range 1..100. Default: 3.
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_THRESHOLD=
# strategy.attackLossCooldownMs - base cooldown (ms). Range 3600000..604800000. Default: 21600000 (6 h).
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_COOLDOWN_MS=
# strategy.attackLossWindowMs - series window after the cooldown (ms). Range 3600000..2592000000. Default: 86400000.
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_WINDOW_MS=
# strategy.attackLossMaxMultiplier - cap of the cooldown multiplier and strength steps. Range 1..100. Default: 4.
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_MAX_MULTIPLIER=
# strategy.attackLossStepPermille - extra required strength per loss. Range 0..10000. Default: 250.
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_STEP_PERMILLE=
# strategy.maxAttackLossRowsPerFaction - rows of world_faction_attack_losses per faction. Range 1..1024. Default: 128.
# EVEJS_LNE_STRATEGY_MAX_ATTACK_LOSS_ROWS_PER_FACTION=
# strategy.attackLossSettleRows - settlement rows of the loss write (only with the memory on). Range 3..64. Default: 4.
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_SETTLE_ROWS=
# strategy.attackLossIskGateEnabled - an attack starts only when the expected ISK loss fits the war room
# (needs the memory and treasury.pressureEnabled). Default: false.
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_ISK_GATE_ENABLED=
# strategy.attackLossSharePermille - base share of attacker hulls lost. Range 1..1000. Default: 330.
# EVEJS_LNE_STRATEGY_ATTACK_LOSS_SHARE_PERMILLE=
# strategy.maxAttackLossRoomPermille - most of the war room one attack may risk. Range 1..1000. Default: 500.
# EVEJS_LNE_STRATEGY_MAX_ATTACK_LOSS_ROOM_PERMILLE=

# War weariness and truces of faction
# pairs (world_war_pairs). All internal (not in the launcher), out of range = clamped; the effect on the reviews in.
# strategy.truceEnabled - the settlement consequence warPair keeps the war / truce state of a pair. Default: false.
# With it on, battle.settleRowsReserve needs 2 more rows (58 at the defaults, else a start warning).
# EVEJS_LNE_STRATEGY_TRUCE_ENABLED=
# strategy.truceWindowMs - a longer gap between two battles of the pair starts a new series (ms).
# Range 3600000..2592000000. Default: 259200000 (72 h).
# EVEJS_LNE_STRATEGY_TRUCE_WINDOW_MS=
# strategy.truceMinLosses - ships the weary side lost in the series. Range 1..1000000. Default: 60.
# EVEJS_LNE_STRATEGY_TRUCE_MIN_LOSSES=
# strategy.truceLossRatioPermille - losses of the weary side >= this x the other side. Range 1000..100000. Default: 2000.
# EVEJS_LNE_STRATEGY_TRUCE_LOSS_RATIO_PERMILLE=
# strategy.truceMaxWinPermille - most battles of the series the weary side may have won. Range 0..1000. Default: 250.
# EVEJS_LNE_STRATEGY_TRUCE_MAX_WIN_PERMILLE=
# strategy.truceMs - length of a truce (ms). Range 3600000..2592000000. Default: 172800000 (48 h).
# EVEJS_LNE_STRATEGY_TRUCE_MS=
# strategy.truceCooldownMs - time after a truce without a new one (ms). Range 0..2592000000. Default: 259200000 (72 h).
# EVEJS_LNE_STRATEGY_TRUCE_COOLDOWN_MS=
# strategy.truceKinds - faction kinds whose pairs may make a truce. Default: empire,pirate,neutral.
# EVEJS_LNE_STRATEGY_TRUCE_KINDS=
# strategy.maxWarPairRows - rows of world_war_pairs (a new pair over it is refused). Range 16..65536. Default: 1024.
# EVEJS_LNE_STRATEGY_MAX_WAR_PAIR_ROWS=

# strategy.playerActivityEnabled - Internal: player kills on NPC ships of a faction per system lower the target score
# of that system and mark an own post hot for the garrison.
# Not in the launcher.
# Default: false. 1 = on (the kill seam wrap, the write per kill and the review read).
# EVEJS_LNE_STRATEGY_PLAYER_ACTIVITY_ENABLED=

# strategy.playerActivityWindowMs - Internal: window (ms) of a player kill series; an older series starts again.
# Not in the launcher. Range 600000..604800000 (outside: clamped).
# Default: 21600000 (6 h).
# EVEJS_LNE_STRATEGY_PLAYER_ACTIVITY_WINDOW_MS=

# strategy.playerActivityMaxKills - Internal: cap of the kills of one faction and system.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_STRATEGY_PLAYER_ACTIVITY_MAX_KILLS=

# strategy.maxPlayerActivityRowsPerFaction - Internal: rows of world_faction_player_activity per faction; a new row
# at the limit deletes the oldest one.
# Not in the launcher. Range 16..2048 (outside: clamped).
# Default: 64.
# EVEJS_LNE_STRATEGY_MAX_PLAYER_ACTIVITY_ROWS_PER_FACTION=

# strategy.playerActivityHotMinKills - Internal: kills in the window that make an own post hot (garrison first, no
# release of its garrison).
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 3.
# EVEJS_LNE_STRATEGY_PLAYER_ACTIVITY_HOT_MIN_KILLS=

# strategy.maxObservationsPerReview - Internal: observations written per review.
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 12.
# EVEJS_LNE_STRATEGY_MAX_OBSERVATIONS_PER_REVIEW=

# strategy.reconWindowMs - Internal: window of a recon operation, ms.
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_STRATEGY_RECON_WINDOW_MS=

# strategy.attackWindowMs - Internal: window of an attack operation, ms.
# Not in the launcher. Range 60000..604800000 (outside: clamped).
# Default: 7200000.
# EVEJS_LNE_STRATEGY_ATTACK_WINDOW_MS=

# strategy.operationGraceMs - Internal: grace after the window before an orphaned operation is closed, ms.
# Not in the launcher. Range 0..604800000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_STRATEGY_OPERATION_GRACE_MS=

# strategy.maxHousekeepingPerReview - Internal: orphaned operations closed per review.
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 4.
# EVEJS_LNE_STRATEGY_MAX_HOUSEKEEPING_PER_REVIEW=

# strategy.maxRefitRequestsPerReview - Internal: stranded fleets sent to look for a station per review.
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 2.
# EVEJS_LNE_STRATEGY_MAX_REFIT_REQUESTS_PER_REVIEW=

# strategy.maxFleetsReadPerReview - Internal: fleets of a faction read per review.
# Not in the launcher. Range 8..500 (outside: clamped).
# Default: 256.
# EVEJS_LNE_STRATEGY_MAX_FLEETS_READ_PER_REVIEW=

# strategy.maxOpenOperationsRead - Internal: open operations of a faction read per review.
# Not in the launcher. Range 4..256 (outside: clamped).
# Default: 96.
# EVEJS_LNE_STRATEGY_MAX_OPEN_OPERATIONS_READ=

# strategy.maxTerritoryMarksPerReview - Internal: TERRITORY_MARK intents (detached / back in range) per review.
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_STRATEGY_MAX_TERRITORY_MARKS_PER_REVIEW=

# strategy.maxTerritoryRead - Internal: page of captured systems of a faction in the review snapshot (1 -> truncated, no marks).
# Not in the launcher. Range 8..4096 (outside: clamped).
# Default: 256.
# EVEJS_LNE_STRATEGY_MAX_TERRITORY_READ=

# strategy.expansionEnabled - Internal: capture targets beyond the theatre for doctrines with expandsBeyondTheatre.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STRATEGY_EXPANSION_ENABLED=

# strategy.maxExpansionSystems - Internal: expansion candidates after sorting by (jumps, systemId).
# Not in the launcher. Range 0..500 (outside: clamped).
# Default: 96.
# EVEJS_LNE_STRATEGY_MAX_EXPANSION_SYSTEMS=

# strategy.maxExpansionScanSystems - Internal: expansion systems read per review to fill maxExpansionSystems
# with targets of a hostile or no controller (own systems no longer take the slots).
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 384.
# EVEJS_LNE_STRATEGY_MAX_EXPANSION_SCAN_SYSTEMS=

# strategy.targetPassiveControllers - Internal: true = systems of a controller without an active faction
# (Rogue Drones, Jove) are targets beyond a theatre; false = no capture and no raid of them.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_TARGET_PASSIVE_CONTROLLERS=

# strategy.borderEnabled - Internal: border belt of doctrines with ownSpace (targets + capture range); off = only the default targets.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STRATEGY_BORDER_ENABLED=

# strategy.empireMaxReachJumps - Internal: pkt 9: depth of the empire belt from the border of its own space.
# Not in the launcher. Range 1..40 (outside: clamped).
# Default: 15.
# EVEJS_LNE_STRATEGY_EMPIRE_MAX_REACH_JUMPS=

# strategy.reclaimMinInfluence - Internal: own influence from which a hostile STABLE system is contested.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 20.
# EVEJS_LNE_STRATEGY_RECLAIM_MIN_INFLUENCE=

# strategy.ownInfluenceEffective - Internal: snapshot ownInfluence = effective influence (STABLE drift); false = the stored value (rollback).
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STRATEGY_OWN_INFLUENCE_EFFECTIVE=

# strategy.maxBorderSystems - Internal: belt target candidates after sorting by (jumps, systemId).
# Not in the launcher. Range 0..500 (outside: clamped).
# Default: 96.
# EVEJS_LNE_STRATEGY_MAX_BORDER_SYSTEMS=

# strategy.maxBorderScanSystems - Internal: belt systems read per review to fill maxBorderSystems
# with targets of a hostile or no controller (own, allied and friendly controllers are skipped before the limit).
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 512.
# EVEJS_LNE_STRATEGY_MAX_BORDER_SCAN_SYSTEMS=

# strategy.expansionRaidsEnabled - Internal: raid targets beyond the theatre for doctrines with
# raidsBeyondTheatre; off = as before.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STRATEGY_EXPANSION_RAIDS_ENABLED=

# strategy.maxRaidScanSystems - Internal: systems scanned for raid targets (world rows read per review)
# 256 -> 1024, the range is the raid reach (doctrine reachJumps) of the own ONLINE stations.
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 1024.
# EVEJS_LNE_STRATEGY_MAX_RAID_SCAN_SYSTEMS=

# strategy.maxRaidTargets - Internal: raid targets in the snapshot after sorting by (jumps, systemId).
# Not in the launcher. Range 0..128 (outside: clamped).
# Default: 16.
# EVEJS_LNE_STRATEGY_MAX_RAID_TARGETS=

# strategy.raidTargetPreference - Internal: raid targets ranked hostile live station, ACTIVE
# controller, (jumps, systemId) before the cut to maxRaidTargets; false = (jumps, systemId).
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STRATEGY_RAID_TARGET_PREFERENCE=

# strategy.policeBeltJumps - Internal: depth of the police belt from highsec.
# Not in the launcher. Range 1..10 (outside: clamped).
# Default: 4.
# EVEJS_LNE_STRATEGY_POLICE_BELT_JUMPS=

# return-to-base cycle config
# strategy.returnAfterIdleMs - Internal: idle threshold before a fleet with returnToBase starts a return operation.
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_STRATEGY_RETURN_AFTER_IDLE_MS=

# strategy.returnWindowMs - Internal: dueAt window for the return operation.
# Not in the launcher. Range 60000..604800000 (outside: clamped).
# Default: 7200000.
# EVEJS_LNE_STRATEGY_RETURN_WINDOW_MS=

# strategy.maxReturnsPerReview - Internal: max return operations per review (0 = disabled).
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 5.
# EVEJS_LNE_STRATEGY_MAX_RETURNS_PER_REVIEW=

# strategy.strandedReturnEnabled - Experimental: an idle invasion / patrol fleet without a target in
# maxAssemblyJumps flies to the nearest own station (LAUNCH return COMBAT_STRANDED) and is disbanded there
# (DISBAND STRANDED, hulls back to the stock).
# Not in the launcher. Values: 1/0.
# Default: 0.
# EVEJS_LNE_STRATEGY_STRANDED_RETURN_ENABLED=

# strategy.strandedIdleMs - Internal: idle time of a stranded combat fleet outside an own station before its return.
# Not in the launcher. Range 3600000..604800000 (outside: clamped).
# Default: 43200000.
# EVEJS_LNE_STRATEGY_STRANDED_IDLE_MS=

# strategy.strandedDisbandIdleMs - Internal: idle time of a stranded combat fleet in an own station system before DISBAND.
# Not in the launcher. Range 900000..604800000 (outside: clamped).
# Default: 7200000.
# EVEJS_LNE_STRATEGY_STRANDED_DISBAND_IDLE_MS=

# strategy.maxStrandedPerReview - Internal: stranded LAUNCH return + DISBAND per review (0 = none).
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_STRATEGY_MAX_STRANDED_PER_REVIEW=

# strategy.strandedReturnMaxJumps - Internal: BFS depth of the nearest own station of a stranded combat fleet.
# Not in the launcher. Range 1..60 (outside: clamped).
# Default: 30.
# EVEJS_LNE_STRATEGY_STRANDED_RETURN_MAX_JUMPS=

# strategy.strandedMaxBfsSystems - Internal: systems of the target zone BFS (reached = note STRANDED_BFS_LIMIT).
# Not in the launcher. Range 100..20000 (outside: clamped).
# Default: 4000.
# EVEJS_LNE_STRATEGY_STRANDED_MAX_BFS_SYSTEMS=

# strategy.strandedMaxSearchesPerReview - Internal: nearest station BFS of stranded combat fleets per review.
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_STRATEGY_STRANDED_MAX_SEARCHES_PER_REVIEW=

# strategy.maxUpgradesPerReview - Internal: FLEET_UPGRADE of mining fleets at their station per review (0 = no upgrades).
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 1.
# EVEJS_LNE_STRATEGY_MAX_UPGRADES_PER_REVIEW=

# strategy.territoryTrimEnabled - Internal: one-time trim of the seeded territory far from the own stations (off = no trim).
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STRATEGY_TERRITORY_TRIM_ENABLED=

# strategy.startTerritoryJumps - Internal: radius of the seeded territory kept around the live own stations.
# Not in the launcher. Range 0..40 (outside: clamped).
# Default: 2.
# EVEJS_LNE_STRATEGY_START_TERRITORY_JUMPS=

# strategy.maxTrimsPerReview - Internal: systems of one trim batch (0 = no trim).
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 32.
# EVEJS_LNE_STRATEGY_MAX_TRIMS_PER_REVIEW=

# strategy.trimReadPerReview - Internal: page of controlled systems read per review for the trim (cursor in memory).
# Not in the launcher. Range 16..4096 (outside: clamped).
# Default: 256.
# EVEJS_LNE_STRATEGY_TRIM_READ_PER_REVIEW=

# strategy.maxTrimBatchesPerPass - Internal: maxPerPass of the STRATEGY_TERRITORY_TRIM handler.
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_STRATEGY_MAX_TRIM_BATCHES_PER_PASS=

# stations.enabled - Internal: switch of the faction stations; off = fleets repair in place (legacy).
# Not in the launcher.
# Default: true.
# EVEJS_LNE_STATIONS_ENABLED=

# stations.startStationsPerFaction - Internal: start stations per faction taken from the registry (a destroyed one never
# comes back).
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 5.
# EVEJS_LNE_STATIONS_START_STATIONS_PER_FACTION=

# stations.maxPerSystem - Internal: live stations per system, every faction together.
# Not in the launcher. Range 1..32 (outside: clamped).
# Default: 8.
# EVEJS_LNE_STATIONS_MAX_PER_SYSTEM=

# stations.maxPerSystemPerFaction - Internal: live stations of one faction per system.
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 3.
# EVEJS_LNE_STATIONS_MAX_PER_SYSTEM_PER_FACTION=

# stations.maxPerFaction - Internal: live stations of one faction.
# Not in the launcher. Range 1..1024 (outside: clamped).
# Default: 64.
# EVEJS_LNE_STATIONS_MAX_PER_FACTION=

# stations.maxStations - Internal: live stations in the world.
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_STATIONS_MAX_STATIONS=

# stations.maxStockItemsPerStation - Internal: stock rows (item types) per station.
# Not in the launcher. Range 1..4096 (outside: clamped).
# Default: 256.
# EVEJS_LNE_STATIONS_MAX_STOCK_ITEMS_PER_STATION=

# stations.maxStockQuantity - Internal: cap of one stock row.
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 1000000000000.
# EVEJS_LNE_STATIONS_MAX_STOCK_QUANTITY=

# stations.maxDeltasPerChange - Internal: item deltas of one stock change.
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 32.
# EVEJS_LNE_STATIONS_MAX_DELTAS_PER_CHANGE=

# stations.repairSearchMaxJumps - Internal: jumps of the repair station search.
# Not in the launcher. Range 0..40 (outside: clamped).
# Default: 20.
# EVEJS_LNE_STATIONS_REPAIR_SEARCH_MAX_JUMPS=

# stations.repairSearchMaxSystems - Internal: systems visited by one repair station search.
# Not in the launcher. Range 10..20000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_STATIONS_REPAIR_SEARCH_MAX_SYSTEMS=

# stations.repairMaxCandidates - Internal: repair station candidates per search.
# Not in the launcher. Range 1..10 (outside: clamped).
# Default: 3.
# EVEJS_LNE_STATIONS_REPAIR_MAX_CANDIDATES=

# stations.refitSeekRecheckMs - Internal: a stranded fleet looks for a repair station every this many ms.
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_STATIONS_REFIT_SEEK_RECHECK_MS=

# stations.refitSeekMaxRounds - Internal: rounds of that search; then the fleet stays idle and needs repair.
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 24.
# EVEJS_LNE_STATIONS_REFIT_SEEK_MAX_ROUNDS=

# occupation.enabled - Internal: switch of the occupation machine (no consequence, no handler, no signals when off).
# Not in the launcher.
# Default: true.
# EVEJS_LNE_OCCUPATION_ENABLED=

# occupation.evalIntervalMs - Internal: interval of the evaluation of a system in the machine (virtual time).
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 900000.
# EVEJS_LNE_OCCUPATION_EVAL_INTERVAL_MS=

# occupation.idleEvalIntervalMs - Internal: interval when nothing can progress (OCCUPIED detached or without a garrison).
# Not in the launcher. Range 60000..604800000 (outside: clamped).
# Default: 7200000.
# EVEJS_LNE_OCCUPATION_IDLE_EVAL_INTERVAL_MS=

# occupation.maxEvalsPerPass - Internal: maxPerPass of the handler.
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 8.
# EVEJS_LNE_OCCUPATION_MAX_EVALS_PER_PASS=

# occupation.maxActiveSystems - Internal: systems not STABLE (a signal above -> OCCUPATION_CAPACITY; bootstrap rows).
# Not in the launcher. Range 1..4096 (outside: clamped).
# Default: 160.
# EVEJS_LNE_OCCUPATION_MAX_ACTIVE_SYSTEMS=

# occupation.maxFleetsReadPerEval - Internal: standing fleets read in the system per evaluation (1 -> truncated: no transition).
# Not in the launcher. Range 2..500 (outside: clamped).
# Default: 64.
# EVEJS_LNE_OCCUPATION_MAX_FLEETS_READ_PER_EVAL=

# occupation.reconTimeoutMs - Internal: RECON without escalation -> STABLE.
# Not in the launcher. Range 60000..604800000 (outside: clamped).
# Default: 7200000.
# EVEJS_LNE_OCCUPATION_RECON_TIMEOUT_MS=

# occupation.contestTimeoutMs - Internal: CONTESTED without a fleet of the pretender -> STABLE (repelled).
# Not in the launcher. Range 60000..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_OCCUPATION_CONTEST_TIMEOUT_MS=

# occupation.invasionHoldMs - Internal: least time in INVASION before the controller changes.
# Not in the launcher. Range 0..2592000000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_OCCUPATION_INVASION_HOLD_MS=

# occupation.occupiedSettleMs - Internal: least time in OCCUPIED before consolidation.
# Not in the launcher. Range 0..2592000000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_OCCUPATION_OCCUPIED_SETTLE_MS=

# occupation.consolidateMs - Internal: least time in CONSOLIDATING before STABLE.
# Not in the launcher. Range 0..2592000000 (outside: clamped).
# Default: 14400000.
# EVEJS_LNE_OCCUPATION_CONSOLIDATE_MS=

# occupation.invasionMinScore - Internal: influence of P for INVASION.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 30.
# EVEJS_LNE_OCCUPATION_INVASION_MIN_SCORE=

# occupation.occupyMinScore - Internal: influence of P for OCCUPIED.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 60.
# EVEJS_LNE_OCCUPATION_OCCUPY_MIN_SCORE=

# occupation.occupyMaxDefenderScore - Internal: most influence of C at OCCUPIED (seed 60 - 5/h x 6 h = 30).
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 30.
# EVEJS_LNE_OCCUPATION_OCCUPY_MAX_DEFENDER_SCORE=

# occupation.stableMinScore - Internal: influence of C for STABLE.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 80.
# EVEJS_LNE_OCCUPATION_STABLE_MIN_SCORE=

# occupation.stableMaxResidualScore - Internal: most influence of a faction hostile to C at STABLE.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 20.
# EVEJS_LNE_OCCUPATION_STABLE_MAX_RESIDUAL_SCORE=

# occupation.battleWinPoints - Internal: influence for a won battle.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 20.
# EVEJS_LNE_OCCUPATION_BATTLE_WIN_POINTS=

# occupation.battleLossPoints - Internal: influence lost in a battle.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 15.
# EVEJS_LNE_OCCUPATION_BATTLE_LOSS_POINTS=

# occupation.holdPointsPerHour - Internal: influence per hour of the holder.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 30.
# EVEJS_LNE_OCCUPATION_HOLD_POINTS_PER_HOUR=

# occupation.stationPointsPerHour - Internal: bonus per hour per live station of the faction in the system.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 5.
# EVEJS_LNE_OCCUPATION_STATION_POINTS_PER_HOUR=

# occupation.stationBonusCap - Internal: most stations counted for the bonus.
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 3.
# EVEJS_LNE_OCCUPATION_STATION_BONUS_CAP=

# occupation.decayPointsPerHour - Internal: loss per hour of factions hostile to the holder without a station.
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 15.
# EVEJS_LNE_OCCUPATION_DECAY_POINTS_PER_HOUR=

# occupation.requireNoDefenderStations - Internal: a live station of the controller blocks OCCUPIED (until a siege takes it).
# Not in the launcher.
# Default: true.
# EVEJS_LNE_OCCUPATION_REQUIRE_NO_DEFENDER_STATIONS=

# occupation.adjacencyGateEnabled - Internal: the occupation machine applies strategy.captureRequiresAdjacency (holder, battle, RECON escalation, CONTESTED, INVASION); off = as before. Effective gate = this key AND strategy.captureRequiresAdjacency.
# Not in the launcher. compose.yaml sets 1 (mod default).
# Default: true.
# EVEJS_LNE_OCCUPATION_ADJACENCY_GATE_ENABLED=

# occupation.canOccupyGateEnabled - Internal: a faction with doctrine canOccupy false (CONCORD) is never the pretender of the occupation machine (holder, battle winner, RECON escalation, signal; a legacy claim unwinds); off = as before.
# Not in the launcher. compose.yaml sets 1 (mod default).
# Default: true.
# EVEJS_LNE_OCCUPATION_CAN_OCCUPY_GATE_ENABLED=

# occupation.garrisonFleetsTarget - Internal: IDLE fleets of the new controller renamed to the role garrison.
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_OCCUPATION_GARRISON_FLEETS_TARGET=

# occupation.garrisonFromRoles - Internal: only IDLE fleets of these roles become a garrison.
# Not in the launcher. Comma list of fleet roles (lib/fleets/schema FLEET_ROLES) or none (= only existing garrison
# fleets). An unknown role: warning, default kept.
# Default: invasion,patrol,scout,reserve.
# EVEJS_LNE_OCCUPATION_GARRISON_FROM_ROLES=

# occupation.detachedUpkeepStep - Internal: growth of the upkeep multiplier of a detached captured system per period.
# Not in the launcher. Range 0..10 (outside: clamped).
# Default: 0.5.
# EVEJS_LNE_OCCUPATION_DETACHED_UPKEEP_STEP=

# occupation.detachedUpkeepPeriodMs - Internal: period of that growth.
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 86400000.
# EVEJS_LNE_OCCUPATION_DETACHED_UPKEEP_PERIOD_MS=

# occupation.detachedUpkeepMaxFactor - Internal: ceiling of the multiplier (consumer).
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 4.
# EVEJS_LNE_OCCUPATION_DETACHED_UPKEEP_MAX_FACTOR=

# occupation.stableBaselineScore - Internal: baseline of the controller in STABLE (= world.seedControllerInfluence)
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 60.
# EVEJS_LNE_OCCUPATION_STABLE_BASELINE_SCORE=

# occupation.stableRecoverPointsPerHour - Internal: recovery of the controller towards the baseline per hour
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 1.
# EVEJS_LNE_OCCUPATION_STABLE_RECOVER_POINTS_PER_HOUR=

# occupation.stableForeignDecayPointsPerHour - Internal: decay of the other factions' influence in STABLE per hour
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 1.
# EVEJS_LNE_OCCUPATION_STABLE_FOREIGN_DECAY_POINTS_PER_HOUR=

# occupation.stableForeignFloorScore - Internal: floor of that decay
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 0.
# EVEJS_LNE_OCCUPATION_STABLE_FOREIGN_FLOOR_SCORE=

# occupation.bastionBattleInfluenceFrozen - a battle in an NPC sov bastion moves no influence
# (BASTION_FROZEN). Not in the launcher. Default: true.
# EVEJS_LNE_OCCUPATION_BASTION_BATTLE_INFLUENCE_FROZEN=

# occupation.claimFrontGraceMs - Internal: a claim counts as an AI front while its next evaluation is at most this overdue
# Not in the launcher. Range 0..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_OCCUPATION_CLAIM_FRONT_GRACE_MS=

# occupation.playerRepelEnabled - Internal: a won player hunt over a fleet of the pretender drops its influence and moves INVASION -> CONTESTED
# Not in the launcher. compose.yaml sets 0 until it is tried in the game.
# Default: false.
# EVEJS_LNE_OCCUPATION_PLAYER_REPEL_ENABLED=

# occupation.repelPoints - Internal: influence of the pretender lost in a repel (0 = only the evaluation)
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 15.
# EVEJS_LNE_OCCUPATION_REPEL_POINTS=

# occupation.repelStates - Internal: claim states seen by a repel (none or a comma list of RECON, CONTESTED, INVASION)
# Not in the launcher.
# Default: CONTESTED,INVASION.
# EVEJS_LNE_OCCUPATION_REPEL_STATES=

# INVASION -> OCCUPIED needs an ONLINE
# sovereignty structure of the pretender (virtual, anchored from the treasury). All keys internal: not in the launcher,
# values outside the range are clamped.
# sovStructures.enabled - Feature flag (off = captures as before, the sov-structure rows are frozen). true/false.
# Default: true (since; false before). compose.yaml does not pin it. Start log after the first reconcile
# ADOPT (within reconcileMs): "sovStructures: running adopted=<n>".
# EVEJS_LNE_SOV_STRUCTURES_ENABLED=

# sovStructures.earlyTimersEnabled - The siege of the controller's structure (ATTACK) and the anchoring (ANCHOR)
# start at the first held INVASION evaluation, in parallel with occupation.invasionHoldMs; the destruction of the
# controller's structure and the capture still need every capture condition. true/false. Default: true.
# 0 = the timers start only after the hold, as before. compose.yaml passes it (default 1).
# EVEJS_LNE_SOV_STRUCTURES_EARLY_TIMERS_ENABLED=

# sovStructures.anchorMs - Anchoring time of a structure. Range 60000..604800000. Default: 3600000 (1 h
# 7200000 before).
# EVEJS_LNE_SOV_STRUCTURES_ANCHOR_MS=

# sovStructures.costIsk - ISK of one structure from the treasury (warSpend, no refund; 0 = free). Range 0..1e13.
# Default: 1000000000.
# EVEJS_LNE_SOV_STRUCTURES_COST_ISK=

# sovStructures.exemptKinds - Faction kinds that capture without a structure (comma list of pirate, empire, police,
# neutral, invader, hive). Default: invader,hive.
# EVEJS_LNE_SOV_STRUCTURES_EXEMPT_KINDS=

# sovStructures.maxAnchoringPerFaction - ANCHORING structures of one faction. Range 1..100. Default: 6 (
# 3 before).
# EVEJS_LNE_SOV_STRUCTURES_MAX_ANCHORING_PER_FACTION=

# sovStructures.maxAttemptsPerClaim - Structures of one claim (system, faction, INVASION phase). Range 1..20. Default: 3.
# EVEJS_LNE_SOV_STRUCTURES_MAX_ATTEMPTS_PER_CLAIM=

# sovStructures.maxLive - Live structures of the world. Range 1..100000. Default: 4000.
# EVEJS_LNE_SOV_STRUCTURES_MAX_LIVE=

# sovStructures.bootstrapPageRows - ANCHORING rows per page of the start bootstrap. Range 1..5000. Default: 200.
# EVEJS_LNE_SOV_STRUCTURES_BOOTSTRAP_PAGE_ROWS=

# sovStructures.siegeHoldMs - time the pretender holds the field to destroy the structure of the
# controller. Range 60000..604800000. Default: 3600000 (1 h).
# EVEJS_LNE_SOV_STRUCTURES_SIEGE_HOLD_MS=

# sovStructures.siegePausedWhenObserved - a virtual siege waits while a player is in the system.
# true/false. Default: true.
# EVEJS_LNE_SOV_STRUCTURES_SIEGE_PAUSED_WHEN_OBSERVED=

# sovStructures.reconcileMs - bucket of the reconcile chain SOV_STRUCTURE_RECONCILE. Range
# 10000..86400000. Default: 300000.
# EVEJS_LNE_SOV_STRUCTURES_RECONCILE_MS=

# sovStructures.reconcileMaxRows - rows of one reconcile event. Runtime min(value
# persistence.maxRowsPerTransaction - 2). Range 1..5000. Default: 200.
# EVEJS_LNE_SOV_STRUCTURES_RECONCILE_MAX_ROWS=

# sovStructures.healMaxPerEvent - abandons of one HEAL reconcile event. Runtime min(value
# (persistence.maxRowsPerTransaction - 2) / (5 + world.maxFactionsPerSystem)). Range 1..200. Default: 20.
# EVEJS_LNE_SOV_STRUCTURES_HEAL_MAX_PER_EVENT=

# sovStructures.retentionMs - age of a DESTROYED / ENDED row before it is pruned. Range 3600000..7776000000.
# Default: 604800000 (7 days).
# EVEJS_LNE_SOV_STRUCTURES_RETENTION_MS=

# sovStructures.panelMaxRows - rows of the observer panel sov-structures. Range 1..1000. Default: 200.
# EVEJS_LNE_SOV_STRUCTURES_PANEL_MAX_ROWS=

# sovStructures.typeId - EveJS type of the physical structure (TCU). Range 1..2147483647. Default: 32226.
# EVEJS_LNE_SOV_STRUCTURES_TYPE_ID=

# sovStructures.physical.mode - on = a TCU per live structure in a system observed by a player; cleanup = remove
# every TCU of the mod; off = no physical pump. Default: on.
# EVEJS_LNE_SOV_STRUCTURES_PHYSICAL_MODE=

# sovStructures.physical.passMs - interval between physical passes. Range 1000..600000. Default: 5000.
# EVEJS_LNE_SOV_STRUCTURES_PHYSICAL_PASS_MS=

# sovStructures.physical.maxWritesPerPass - EveJS structure writes (and live kills) per pass. Range 1..100.
# Default: 4.
# EVEJS_LNE_SOV_STRUCTURES_PHYSICAL_MAX_WRITES_PER_PASS=

# sovStructures.physical.maxPhysical - TCU of the mod in EveJS at a time. Range 1..1000. Default: 64.
# EVEJS_LNE_SOV_STRUCTURES_PHYSICAL_MAX_PHYSICAL=

# sovStructures.physical.lingerMs - a TCU stays this long after the last player left the system. Range
# 0..86400000. Default: 1800000 (30 min).
# EVEJS_LNE_SOV_STRUCTURES_PHYSICAL_LINGER_MS=

# sovStructures.physical.reinforceHoldMaxMs - a TCU outside SHIELD_VULNERABLE / ANCHOR_VULNERABLE
# (vendor reinforce cycle, up to ~25 h) outlives lingerMs at most this long. Range 0..604800000. Default: 93600000 (26 h).
# EVEJS_LNE_SOV_STRUCTURES_PHYSICAL_REINFORCE_HOLD_MAX_MS=

# sovStructures.physical.offsetM - x offset in meters from the default hub position. Range 0..1000000.
# Default: 30000.
# EVEJS_LNE_SOV_STRUCTURES_PHYSICAL_OFFSET_M=

# Player sovereignty
# Internal keys (not in the launcher). compose.yaml passes none of them yet.

# playerSov.enabled - the mirror world_player_sov of the player sovereignty of EveJS (claims of player
# alliances and the neutral Sovereignty Hubs they launched). Off = no mirror, the table frozen, no player claim for the
# AI; the projection guard (no GAIN over a neutral player hub) works anyway. Default: false (on at).
# EVEJS_LNE_PLAYER_SOV_ENABLED=

# playerSov.reconcileMs - interval between mirror passes; the vendor is read only after a change of the sov table
# on the first pass and every 10 passes. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_PLAYER_SOV_RECONCILE_MS=

# playerSov.maxRowsPerPass - mirror rows written per pass; one transaction = min(this
# persistence.maxRowsPerTransaction - 2). Range 1..5000. Default: 200.
# EVEJS_LNE_PLAYER_SOV_MAX_ROWS_PER_PASS=

# playerSov.scanBudgetMs - a vendor sov scan longer than this = counter world.playerSov.scanOverBudget + one log
# line. Range 1..5000. Default: 50.
# EVEJS_LNE_PLAYER_SOV_SCAN_BUDGET_MS=

# playerSov.retentionMs - LOST rows older than this are pruned. Range 3600000..7776000000. Default: 604800000 (7 d).
# EVEJS_LNE_PLAYER_SOV_RETENTION_MS=

# playerSov.panelMaxRows - rows of the observer panel player-sov. Range 1..1000. Default: 200.
# EVEJS_LNE_PLAYER_SOV_PANEL_MAX_ROWS=

# playerSov.autoCaptureMs - U5: a neutral player hub CAPTURING this long is claimed by the mod for the
# alliance that launched it (fallback when Entosis does not work in EveJS). 0 = off (vanilla Entosis). Range
# 0..604800000. Default: 0.
# EVEJS_LNE_PLAYER_SOV_AUTO_CAPTURE_MS=

# playerSov.deployGate.enabled - the hub launch gate (refuses a launch in a system with a live sov
# structure of a faction, registers CAPTURING at once). Works only with playerSov.enabled. Default: true.
# EVEJS_LNE_PLAYER_SOV_DEPLOY_GATE_ENABLED=

# playerSov.siegeHoldMs - owner-online time a hostile faction holds the field to reinforce a
# player hub. Range 60000..604800000. Default: 3600000 (1 h).
# EVEJS_LNE_PLAYER_SOV_SIEGE_HOLD_MS=

# playerSov.reinforceMs - U2: the reinforcement timer of a player hub before the retake, in
# owner-online time. Range 60000..604800000. Default: 86400000 (24 h).
# EVEJS_LNE_PLAYER_SOV_REINFORCE_MS=

# playerSov.targetOwnerSeenMs - a player system is a strategy target only if an owner-corp member was
# online within this window; 0 = no check. Range 0..2592000000. Default: 172800000 (48 h).
# EVEJS_LNE_PLAYER_SOV_TARGET_OWNER_SEEN_MS=

# playerSov.siegeSampleMs - sample interval of the owner-online siege clock (credit per sample at most
# 2 x this). Range 60000..3600000. Default: 600000 (10 min).
# EVEJS_LNE_PLAYER_SOV_SIEGE_SAMPLE_MS=

# playerSov.ownerMembersMax - members of the owner corporation read to decide "the owner is online".
# Range 1..5000. Default: 500.
# EVEJS_LNE_PLAYER_SOV_OWNER_MEMBERS_MAX=

# playerSov.pauseWhenObserved - the virtual siege of a player hub stands while a player is in the system.
# Default: true.
# EVEJS_LNE_PLAYER_SOV_PAUSE_WHEN_OBSERVED=

# playerSov.maxRetakesPerPass - vendor writes (auto-capture U5, retake) per pass. Range 1..20. Default: 2.
# EVEJS_LNE_PLAYER_SOV_MAX_RETAKES_PER_PASS=

# playerSov.retakeRetryMs - delay before a refused retake write is tried again. Range 10000..3600000.
# Default: 300000.
# EVEJS_LNE_PLAYER_SOV_RETAKE_RETRY_MS=

# playerSov.maxSiegesPerFaction - sieges of player hubs one faction runs at a time (0 = the factions never target
# player systems). Range 0..20. Default: 2.
# EVEJS_LNE_PLAYER_SOV_MAX_SIEGES_PER_FACTION=

# playerSov.targetPremium - score premium of a hostile player system as a capture target. Range 0..1000.
# Default: 20.
# EVEJS_LNE_PLAYER_SOV_TARGET_PREMIUM=

# playerValue.* - (K2): the player structures of a system
# (Upwell, Metenox, Ansiblex, Triglavian bridge, Skyhook, player sentries) add a capped premium to its target score
# and order the structure assaults. Off = the review bit for bit as before. Internal, not in the launcher.
# playerValue.enabled - the value index (off = no vendor read). Default: false.
# EVEJS_LNE_PLAYER_VALUE_ENABLED=0
# playerValue.indexTtlMs - the in-memory index is rebuilt at most this often. Range 10000..3600000. Default: 300000.
# EVEJS_LNE_PLAYER_VALUE_INDEX_TTL_MS=
# playerValue.maxIndexStructures - player structures read into the index. Range 1..20000. Default: 2000.
# EVEJS_LNE_PLAYER_VALUE_MAX_INDEX_STRUCTURES=
# playerValue.maxIndexSkyhooks - player Skyhooks read into the index (0 = none). Range 0..20000. Default: 1000.
# EVEJS_LNE_PLAYER_VALUE_MAX_INDEX_SKYHOOKS=
# playerValue.maxCountPerKind - items of one kind counted per system. Range 1..20. Default: 3.
# EVEJS_LNE_PLAYER_VALUE_MAX_COUNT_PER_KIND=
# playerValue.valueCap - ceiling of the value of a system (W157 over 240). Range 0..1000. Default: 120.
# EVEJS_LNE_PLAYER_VALUE_VALUE_CAP=
# playerValue.unclaimedPermille - share of the value for a system without a player sov claim. Range 0..1000.
# Default: 0.
# EVEJS_LNE_PLAYER_VALUE_UNCLAIMED_PERMILLE=
# playerValue.weight.<kind> - weight of one item of the kind. Range 0..200. Defaults: citadelM 10, citadelL 20,
# citadelXL 40, engineeringM 10, engineeringL 20, engineeringXL 30, refineryM 10, refineryL 20, metenox 20,
# ansiblex 10, trigBridge 30, flexOther 0, skyhook 15, sentry 0, listeningPost 5, heavySentry 5.
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_CITADEL_M=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_CITADEL_L=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_CITADEL_XL=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_ENGINEERING_M=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_ENGINEERING_L=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_ENGINEERING_XL=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_REFINERY_M=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_REFINERY_L=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_METENOX=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_ANSIBLEX=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_TRIG_BRIDGE=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_FLEX_OTHER=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_SKYHOOK=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_SENTRY=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_LISTENING_POST=
# EVEJS_LNE_PLAYER_VALUE_WEIGHT_HEAVY_SENTRY=

# harvestRaid.* - (K3): a faction fleet with a
# harvest_raid operation takes part of the Moon Material Bay of a player Metenox (warning, online time of the owner,
# one settlement with vendor receipts). Internal, not in the launcher. (W158): the module starts only with
# the warning mail (EVEJS_LNE_NOTICES_ENABLED=1, notices.kindHarvestRaid true, modules.world on).
# harvestRaid.enabled - raids on player harvesters (off = no listener, no vendor read, no row). Default: false.
# EVEJS_LNE_HARVEST_RAID_ENABLED=0
# harvestRaid.metenoxEnabled - Metenox targets (off = no new raid on a Metenox). Default: true.
# EVEJS_LNE_HARVEST_RAID_METENOX_ENABLED=
# harvestRaid.warningMs - online time of the owner between the warning and the raid. Range 300000..86400000.
# Default: 1800000.
# EVEJS_LNE_HARVEST_RAID_WARNING_MS=
# harvestRaid.raidMs - online time of the owner the fleet holds the field before the loss. Range 300000..86400000.
# Default: 1800000.
# EVEJS_LNE_HARVEST_RAID_RAID_MS=
# harvestRaid.sampleMs - step of the online clock. Range 60000..3600000. Default: 300000.
# EVEJS_LNE_HARVEST_RAID_SAMPLE_MS=
# harvestRaid.wallDeadlineMs - wall time after the start, then EXPIRED without a loss. Range 3600000..604800000.
# Default: 21600000.
# EVEJS_LNE_HARVEST_RAID_WALL_DEADLINE_MS=
# harvestRaid.settleWallMs - an uncertain vendor take is retried this long, then the line counts 0.
# Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_HARVEST_RAID_SETTLE_WALL_MS=
# harvestRaid.lossPermille - share of each moon material stack taken (W159 over 300). Range 0..500. Default: 150.
# EVEJS_LNE_HARVEST_RAID_LOSS_PERMILLE=
# harvestRaid.maxLossVolumeM3 - ceiling of the volume taken by one raid. Range 1..500000. Default: 2000.
# EVEJS_LNE_HARVEST_RAID_MAX_LOSS_VOLUME_M3=
# harvestRaid.minLootVolumeM3 - no raid below this planned loss. Range 0..500000. Default: 50.
# EVEJS_LNE_HARVEST_RAID_MIN_LOOT_VOLUME_M3=
# harvestRaid.maxPlanLines - stacks in the plan of one raid. Range 1..128. Default: 32.
# EVEJS_LNE_HARVEST_RAID_MAX_PLAN_LINES=
# harvestRaid.targetCooldownMs - no new raid on a structure after the end of the last one. Range 0..2592000000.
# Default: 259200000.
# EVEJS_LNE_HARVEST_RAID_TARGET_COOLDOWN_MS=
# harvestRaid.ownerCooldownMs - no new raid on a corporation after the start of its last one. Range 0..2592000000.
# Default: 86400000.
# EVEJS_LNE_HARVEST_RAID_OWNER_COOLDOWN_MS=
# harvestRaid.maxOpen - open raids in the world (0 = none). Range 0..50. Default: 2.
# EVEJS_LNE_HARVEST_RAID_MAX_OPEN=
# harvestRaid.maxOpenPerFaction - open raids of one faction. Range 0..10. Default: 1.
# EVEJS_LNE_HARVEST_RAID_MAX_OPEN_PER_FACTION=
# harvestRaid.secClasses - security classes of the raided systems. Default: lowsec,nullsec.
# EVEJS_LNE_HARVEST_RAID_SEC_CLASSES=
# harvestRaid.retentionMs - ended raid rows kept this long (>= both cooldowns). Range 3600000..7776000000.
# Default: 604800000.
# EVEJS_LNE_HARVEST_RAID_RETENTION_MS=
# harvestRaid.pruneBatch - ended rows deleted by one start. Range 0..256. Default: 16.
# EVEJS_LNE_HARVEST_RAID_PRUNE_BATCH=
# harvestRaid.maxBayLines - stacks of the Moon Material Bay read at once. Range 1..4096. Default: 256.
# EVEJS_LNE_HARVEST_RAID_MAX_BAY_LINES=
# harvestRaid.maxFleetsReadPerCheck - fleets of the system read by a check / step. Range 1..1024. Default: 64.
# EVEJS_LNE_HARVEST_RAID_MAX_FLEETS_READ_PER_CHECK=
# harvestRaid.maxPerPass - maxPerPass of the HRAID_* handlers. Range 1..1000. Default: 8.
# EVEJS_LNE_HARVEST_RAID_MAX_PER_PASS=
# harvestRaid.factionKinds - faction kinds that send raids (comma list). Default: pirate.
# EVEJS_LNE_HARVEST_RAID_FACTION_KINDS=
# harvestRaid.maxDispatchPerReview - raid LAUNCHes of one faction review. Range 0..5. Default: 1.
# EVEJS_LNE_HARVEST_RAID_MAX_DISPATCH_PER_REVIEW=
# harvestRaid.dispatchMaxJumps - jumps from a controlled system to a raid target. Range 1..30. Default: 6.
# EVEJS_LNE_HARVEST_RAID_DISPATCH_MAX_JUMPS=
# harvestRaid.maxTargetsReadPerReview - Moon Material Bay reads of one review. Range 1..64. Default: 8.
# EVEJS_LNE_HARVEST_RAID_MAX_TARGETS_READ_PER_REVIEW=
# harvestRaid.skyhookEnabled - a player Orbital Skyhook as a raid target (part of the unsecured
# stock, only in the theft window of the vendor; off = zero reads/writes of Skyhooks). Default: false.
# EVEJS_LNE_HARVEST_RAID_SKYHOOK_ENABLED=0
# harvestRaid.skyhookLossPermille - share of the unsecured stock taken (W159 over 300). Range 0..500. Default: 150.
# EVEJS_LNE_HARVEST_RAID_SKYHOOK_LOSS_PERMILLE=
# harvestRaid.skyhookLaunchLeadMs - a Skyhook is a target this long before its theft window opens.
# Range 0..86400000. Default: 3600000.
# EVEJS_LNE_HARVEST_RAID_SKYHOOK_LAUNCH_LEAD_MS=
# harvestRaid.skyhookMinLootUnits - no Skyhook raid below this many planned units. Range 0..1000000. Default: 50.
# EVEJS_LNE_HARVEST_RAID_SKYHOOK_MIN_LOOT_UNITS=
# harvestRaid.maxSkyhooksIndexed - Skyhooks of the raid index (W161: raidMs must stay below the 1 h window).
# Range 1..20000. Default: 1000.
# EVEJS_LNE_HARVEST_RAID_MAX_SKYHOOKS_INDEXED=

# notices.kindPlayerSovSiege / kindPlayerSovReinforced / kindPlayerSovLost - EVE mail lines to the owner
# corporation at the siege, the reinforcement and the loss of its hub (needs notices.enabled). Default: true.
# EVEJS_LNE_NOTICES_KIND_PLAYER_SOV_SIEGE=
# EVEJS_LNE_NOTICES_KIND_PLAYER_SOV_REINFORCED=
# EVEJS_LNE_NOTICES_KIND_PLAYER_SOV_LOST=

# upkeep.enabled - Internal: the UPKEEP intent of the strategy review (with modules.strategy); off = no intent, the budget changes only by mobilizations
# Not in the launcher.
# Default: true.
# EVEJS_LNE_UPKEEP_ENABLED=

# upkeep.periodMs - Internal: period of one settlement
# Not in the launcher. Range 600000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_UPKEEP_PERIOD_MS=

# upkeep.maxCatchUpPeriods - Internal: periods charged after a downtime (the rest forgiven)
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 48.
# EVEJS_LNE_UPKEEP_MAX_CATCH_UP_PERIODS=

# upkeep.incomePerSystem - Internal: income of a controlled system that is not detached, per period
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 3.
# EVEJS_LNE_UPKEEP_INCOME_PER_SYSTEM=

# upkeep.incomePerStation - Internal: income of an ONLINE station per period
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_UPKEEP_INCOME_PER_STATION=

# upkeep.reservePerStation - Internal: growth of reserve_units per station per period
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 2.
# EVEJS_LNE_UPKEEP_RESERVE_PER_STATION=

# upkeep.maxReserveUnits - Internal: ceiling of the reserve growth
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_UPKEEP_MAX_RESERVE_UNITS=

# upkeep.costPerSystem - Internal: cost of a system per period (x the detachment factor)
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 1.
# EVEJS_LNE_UPKEEP_COST_PER_SYSTEM=

# upkeep.capturedCostPerSystem - Internal: extra cost of a system captured by an occupation (brake)
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 2.
# EVEJS_LNE_UPKEEP_CAPTURED_COST_PER_SYSTEM=

# upkeep.costPerShipPermille - Internal: cost of a ship of a live fleet per period (permille of a unit)
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_UPKEEP_COST_PER_SHIP_PERMILLE=

# upkeep.homeSpaceIncomeEnabled - Internal: income of the own SDE high/lowsec of a doctrine with ownSpace (empires); off = no term
# Not in the launcher.
# Default: false.
# EVEJS_LNE_UPKEEP_HOME_SPACE_INCOME_ENABLED=

# upkeep.homeSpaceIncomePermille - Internal: income of one own home space system per period (permille of a unit)
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 250.
# EVEJS_LNE_UPKEEP_HOME_SPACE_INCOME_PERMILLE=

# upkeep.shipCapEnabled - Internal: mobilization budget cut to the ships the income keeps; off = no cap
# Not in the launcher.
# Default: false.
# EVEJS_LNE_UPKEEP_SHIP_CAP_ENABLED=

# upkeep.shipCapMarginPermille - Internal: share of the income kept free of ships by the ship cap
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_UPKEEP_SHIP_CAP_MARGIN_PERMILLE=

# upkeep.shipCapKinds - Internal: faction kinds (registry FACTION_KINDS) the ship cap applies to.
# Not in the launcher. A comma list of distinct faction kinds pirate, empire, police, neutral, invader, hive.
# Default: empire,pirate,neutral.
# EVEJS_LNE_UPKEEP_SHIP_CAP_KINDS=

# upkeep.shipCapScoutShips - Internal: ships of the scout pool the ship cap leaves the review (role scout); 0 = no pool
# Works only with EVEJS_LNE_STRATEGY_RECON_UNBLOCK_ENABLED=1 (live: 4 = maxScoutsPerFaction).
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 0.
# EVEJS_LNE_UPKEEP_SHIP_CAP_SCOUT_SHIPS=

# upkeep.offensiveReservePeriods - Internal: resources after the charge needed for a new front (x the cost of a period); 0 = no brake
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 24.
# EVEJS_LNE_UPKEEP_OFFENSIVE_RESERVE_PERIODS=

# upkeep.abandonAfterUnpaidPeriods - Internal: unpaid periods before a captured system is abandoned
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 24.
# EVEJS_LNE_UPKEEP_ABANDON_AFTER_UNPAID_PERIODS=

# upkeep.maxAbandonsPerReview - Internal: abandons of one review
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_UPKEEP_MAX_ABANDONS_PER_REVIEW=

# upkeep.tradeIncomeSharePermille - Internal: share of the income to the ISK budget of the trade
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_UPKEEP_TRADE_INCOME_SHARE_PERMILLE=

# upkeep.hoardCapPeriods - Internal: hoard ceiling of hoardCapped doctrines = periods of gross income; 0 = off
# Not in the launcher. Range 0..100000 (outside: clamped).
# Default: 168.
# EVEJS_LNE_UPKEEP_HOARD_CAP_PERIODS=

# upkeep.deficitReliefEnabled - Internal: deficit relief (abandon with a gain, upgrades without growth in debt, DISBAND UPKEEP); off = the review of before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_UPKEEP_DEFICIT_RELIEF_ENABLED=

# upkeep.deficitReliefAfterUnpaidPeriods - Internal: unpaid periods before the review disbands the ships the income cannot keep
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 3.
# EVEJS_LNE_UPKEEP_DEFICIT_RELIEF_AFTER_UNPAID_PERIODS=

# upkeep.deficitReliefMarginPermille - Internal: share of the income kept free of ships by the deficit relief
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 20.
# EVEJS_LNE_UPKEEP_DEFICIT_RELIEF_MARGIN_PERMILLE=

# upkeep.maxDisbandsPerReview - Internal: DISBAND UPKEEP intents of one review
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_UPKEEP_MAX_DISBANDS_PER_REVIEW=

# upkeep.iskTopUpEnabled - Internal: ISK top-up of the resource units while the upkeep brake holds on the reserve; off = no purchase. Needs treasury.enabled.
# Not in the launcher.
# Default: false.
# EVEJS_LNE_UPKEEP_ISK_TOP_UP_ENABLED=

# upkeep.iskPerUnit - Internal: ISK price of one resource unit (gross ISK income / gross unit income of an empire, audit 2026-11-17)
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 4000000.
# EVEJS_LNE_UPKEEP_ISK_PER_UNIT=

# upkeep.iskTopUpMaxUnitsPerPeriod - Internal: units bought by one review with an UPKEEP period; 0 = nothing
# Not in the launcher. Range 0..100000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_UPKEEP_ISK_TOP_UP_MAX_UNITS_PER_PERIOD=

# upkeep.iskTopUpKinds - Internal: faction kinds (registry FACTION_KINDS) that buy units with ISK.
# Not in the launcher. A comma list of distinct faction kinds pirate, empire, police, neutral, invader, hive.
# Default: empire.
# EVEJS_LNE_UPKEEP_ISK_TOP_UP_KINDS=

# upkeep.iskTopUpFloorPermille - Internal: balance floor of a purchase (permille of the initial ISK; never below the AUSTERITY enter threshold)
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 800.
# EVEJS_LNE_UPKEEP_ISK_TOP_UP_FLOOR_PERMILLE=

# upkeep.iskTopUpHeadroomPeriods - Internal: periods of cost bought above the offensive reserve
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 2.
# EVEJS_LNE_UPKEEP_ISK_TOP_UP_HEADROOM_PERIODS=

# upkeep.iskTopUpRoomSharePermille - Internal: share of the war room a purchase may take (treasury.pressureEnabled)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_UPKEEP_ISK_TOP_UP_ROOM_SHARE_PERMILLE=

# mining.enabled - Internal: switch of the mining service (with modules.strategy); off = open trips frozen.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_MINING_ENABLED=

# mining.maxFleetsPerFaction - Internal: live mining fleets per faction (outside strategy.maxFleetsPerFaction).
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 10.
# EVEJS_LNE_MINING_MAX_FLEETS_PER_FACTION=

# mining.maxFleetsPerSystem - Internal: open trips per belt system.
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_MINING_MAX_FLEETS_PER_SYSTEM=

# mining.targetFleetsPerSystemPermille - Internal: wanted miners per candidate system (permille).
# Not in the launcher. Range 0..4000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_MINING_TARGET_FLEETS_PER_SYSTEM_PERMILLE=

# mining.fleetsPerStationPermille - Internal: wanted mining fleets per own ONLINE station (permille, 0 = no miner mobilization).
# Not in the launcher. Range 0..8000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_MINING_FLEETS_PER_STATION_PERMILLE=

# mining.minersPerFleetBase - Internal: miners of a mining fleet without a booster.
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 3.
# EVEJS_LNE_MINING_MINERS_PER_FLEET_BASE=

# mining.maxMobilizationsPerReview - Internal: miner mobilizations of one review (brake).
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 2.
# EVEJS_LNE_MINING_MAX_MOBILIZATIONS_PER_REVIEW=

# mining.maxDispatchesPerReview - Internal: MINE_DISPATCH intents of one review.
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 3.
# EVEJS_LNE_MINING_MAX_DISPATCHES_PER_REVIEW=

# mining.maxTripJumps - Internal: reach station/miner -> belt (jumps).
# Not in the launcher. Range 0..20 (outside: clamped).
# Default: 5.
# EVEJS_LNE_MINING_MAX_TRIP_JUMPS=

# mining.maxCandidateSystems - Internal: candidate belt systems of one review.
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 32.
# EVEJS_LNE_MINING_MAX_CANDIDATE_SYSTEMS=

# mining.distancePenaltyPermille - Internal: score penalty per jump.
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 250.
# EVEJS_LNE_MINING_DISTANCE_PENALTY_PERMILLE=

# mining.avoidHostileIntel - Internal: skip belts with fresh intel of hostile fleets.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_MINING_AVOID_HOSTILE_INTEL=

# mining.candidateIntelEnabled - Internal: the review reads intel of the candidate belt systems; hostile
# fleets / stations there skip the belt. Not in the launcher. Compose: 0.
# Default: false.
# EVEJS_LNE_MINING_CANDIDATE_INTEL_ENABLED=

# mining.candidateIntelMaxSystems - Internal: candidate systems added to the extra intel read of one review.
# Not in the launcher. Range 0..256 (outside: clamped).
# Default: 32.
# EVEJS_LNE_MINING_CANDIDATE_INTEL_MAX_SYSTEMS=

# mining.beltCooldownEnabled - Internal: skip belts with beltCooldownThreshold bad trip ends (DIVERTED
# FLEET_DESTROYED / NOT_IN_BELT) in the window. Not in the launcher. Compose: 0.
# Default: false.
# EVEJS_LNE_MINING_BELT_COOLDOWN_ENABLED=

# mining.beltCooldownMs - Internal: rolling window of the belt cooldown (cut to mining.tripRetentionMs).
# Not in the launcher. Range 600000..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_MINING_BELT_COOLDOWN_MS=

# mining.beltCooldownThreshold - Internal: bad trip ends of a belt in the window that start the cooldown.
# Not in the launcher. Range 1..32 (outside: clamped).
# Default: 2.
# EVEJS_LNE_MINING_BELT_COOLDOWN_THRESHOLD=

# mining.beltCooldownMaxSystems - Internal: belts in the cooldown read by one review.
# Not in the launcher. Range 1..512 (outside: clamped).
# Default: 64.
# EVEJS_LNE_MINING_BELT_COOLDOWN_MAX_SYSTEMS=

# mining.shiftMs - Internal: length of a mining shift.
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 7200000.
# EVEJS_LNE_MINING_SHIFT_MS=

# mining.rateMiningFrigateM3PerMin - Internal: Venture, middle of 5-8 m3/s (also old industrial miners).
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 390.
# EVEJS_LNE_MINING_RATE_MINING_FRIGATE_M3_PER_MIN=

# mining.rateMiningBargeM3PerMin - Internal: barge = Covetor.
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 1410.
# EVEJS_LNE_MINING_RATE_MINING_BARGE_M3_PER_MIN=

# mining.rateExhumerM3PerMin - Internal: exhumer = Hulk.
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 1950.
# EVEJS_LNE_MINING_RATE_EXHUMER_M3_PER_MIN=

# mining.rateRorqualM3PerMin - Internal: lower bound 360 m3/s.
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 21600.
# EVEJS_LNE_MINING_RATE_RORQUAL_M3_PER_MIN=

# mining.ratePorpoiseM3PerMin - Internal: boost only.
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_MINING_RATE_PORPOISE_M3_PER_MIN=

# mining.rateOrcaM3PerMin - Internal: boost only.
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_MINING_RATE_ORCA_M3_PER_MIN=

# mining.boostPorpoisePermille - Internal: boost of a Porpoise on its boosted miners.
# Not in the launcher. Range 1000..10000 (outside: clamped).
# Default: 2600.
# EVEJS_LNE_MINING_BOOST_PORPOISE_PERMILLE=

# mining.boostOrcaPermille - Internal: boost of an Orca on its boosted miners.
# Not in the launcher. Range 1000..10000 (outside: clamped).
# Default: 2600.
# EVEJS_LNE_MINING_BOOST_ORCA_PERMILLE=

# mining.boostRorqualPermille - Internal: boost of a Rorqual on its boosted miners (not on its own rate).
# Not in the launcher. Range 1000..10000 (outside: clamped).
# Default: 2600.
# EVEJS_LNE_MINING_BOOST_RORQUAL_PERMILLE=

# mining.boostedMinersPorpoise - Internal: best miners boosted by a Porpoise.
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 5.
# EVEJS_LNE_MINING_BOOSTED_MINERS_PORPOISE=

# mining.boostedMinersOrca - Internal: best miners boosted by an Orca.
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 10.
# EVEJS_LNE_MINING_BOOSTED_MINERS_ORCA=

# mining.boostedMinersRorqual - Internal: best miners boosted by a Rorqual.
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 15.
# EVEJS_LNE_MINING_BOOSTED_MINERS_RORQUAL=

# mining.refineYieldPermille - Internal: coarse refining, X-Eve getNpcRefineryEfficiency 72 %.
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 720.
# EVEJS_LNE_MINING_REFINE_YIELD_PERMILLE=

# mining.bandFactorHighsecPermille - Internal: richness factor of highsec.
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_MINING_BAND_FACTOR_HIGHSEC_PERMILLE=

# mining.bandFactorLowsecPermille - Internal: richness factor of lowsec.
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 750.
# EVEJS_LNE_MINING_BAND_FACTOR_LOWSEC_PERMILLE=

# mining.bandFactorNullsecPermille - Internal: richness factor of nullsec.
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_MINING_BAND_FACTOR_NULLSEC_PERMILLE=

# mining.mineralFactorTritaniumPermille - Internal: factor on the Tritanium ore band.
# Not in the launcher. Range 100..100000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_MINING_MINERAL_FACTOR_TRITANIUM_PERMILLE=

# mining.mineralFactorPyeritePermille - Internal: factor on the Pyerite ore band.
# Not in the launcher. Range 100..100000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_MINING_MINERAL_FACTOR_PYERITE_PERMILLE=

# mining.mineralFactorMexallonPermille - Internal: factor on the Mexallon ore band.
# Not in the launcher. Range 100..100000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_MINING_MINERAL_FACTOR_MEXALLON_PERMILLE=

# mining.mineralFactorIsogenPermille - Internal: factor on the Isogen ore band.
# Not in the launcher. Range 100..100000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_MINING_MINERAL_FACTOR_ISOGEN_PERMILLE=

# mining.mineralFactorNocxiumPermille - Internal: factor on the Nocxium ore band.
# Not in the launcher. Range 100..100000 (outside: clamped).
# Default: 3000.
# EVEJS_LNE_MINING_MINERAL_FACTOR_NOCXIUM_PERMILLE=

# mining.mineralFactorZydrinePermille - Internal: factor on the Zydrine ore band.
# Not in the launcher. Range 100..100000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_MINING_MINERAL_FACTOR_ZYDRINE_PERMILLE=

# mining.mineralFactorMegacytePermille - Internal: factor on the Megacyte ore band.
# Not in the launcher. Range 100..100000 (outside: clamped).
# Default: 10000.
# EVEJS_LNE_MINING_MINERAL_FACTOR_MEGACYTE_PERMILLE=

# mining.beltCap - Internal: belts counted per system at most.
# Not in the launcher. Range 1..200 (outside: clamped).
# Default: 20.
# EVEJS_LNE_MINING_BELT_CAP=

# mining.anomalySitesPerSystem - Internal: ore anomalies assumed per system (no site data).
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 2.
# EVEJS_LNE_MINING_ANOMALY_SITES_PER_SYSTEM=

# mining.siteSaturation - Internal: mining sites of a full richness.
# Not in the launcher. Range 1..200 (outside: clamped).
# Default: 6.
# EVEJS_LNE_MINING_SITE_SATURATION=

# mining.defaultBeltsPerSystem - Internal: belts when the adapter read fails (DRIFT).
# Not in the launcher. Range 0..200 (outside: clamped).
# Default: 4.
# EVEJS_LNE_MINING_DEFAULT_BELTS_PER_SYSTEM=

# mining.watchGraceMs - Internal: deadline after an expected arrival (a lost nudge).
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 900000.
# EVEJS_LNE_MINING_WATCH_GRACE_MS=

# mining.watchRecheckMs - Internal: next deadline of a wait.
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_MINING_WATCH_RECHECK_MS=

# mining.maxWatchRounds - Internal: waits of a trip before TIMEOUT.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 12.
# EVEJS_LNE_MINING_MAX_WATCH_ROUNDS=

# mining.returnSeekRecheckMs - Internal: next search of a station when none was found.
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_MINING_RETURN_SEEK_RECHECK_MS=

# mining.tripRetentionMs - Internal: ended trips kept (panel 24 h, totals survive the prune).
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 604800000.
# EVEJS_LNE_MINING_TRIP_RETENTION_MS=

# mining.pruneBatch - Internal: ended trips pruned per dispatch.
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_MINING_PRUNE_BATCH=

# mining.reconcileMaxTrips - Internal: open trips checked by the reconcile after a start.
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_MINING_RECONCILE_MAX_TRIPS=

# mining.reconcileMaxAttempts - Internal: suffixed reconcile keys tried per trip before it is counted as exhausted.
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_MINING_RECONCILE_MAX_ATTEMPTS=

# mining.maxReleasesPerReview - Internal: MINE_RELEASE of orphaned miners per strategy review.
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_MINING_MAX_RELEASES_PER_REVIEW=

# mining.maxStepsPerPass - Internal: maxPerPass of the MINING_TRIP_STEP handler.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_MINING_MAX_STEPS_PER_PASS=

# mining.ownSpaceScanSystems - Internal: own SDE systems without a world row scanned per review from the own stations (0 = no own-space projection).
# Not in the launcher. Range 0..4096 (outside: clamped).
# Default: 256.
# EVEJS_LNE_MINING_OWN_SPACE_SCAN_SYSTEMS=

# mining.ownStationSystemsEnabled - Internal: soe-mining-base: a system with an own ONLINE station is mineable under a foreign (or null) controller without a foreign occupier; off = the controller only (12.1a).
# Not in the launcher.
# Default: false.
# EVEJS_LNE_MINING_OWN_STATION_SYSTEMS_ENABLED=

# mining.ownStationMinInfluence - Internal: with ownStationSystemsEnabled an own ONLINE station under a FOREIGN controller counts only with the own stored influence there >= this value (an empty controller: as); 0 = unchanged.
# Not in the launcher. Range 0..100000 (outside: clamped).
# Default: 1.
# EVEJS_LNE_MINING_OWN_STATION_MIN_INFLUENCE=

# mining.stockCoverEnabled - Internal: a mineral stock covering mining.stockCoverRebuilds rebuilds of the doctrine hull buffer mobilizes no miner and keeps at most mining.coveredMaxOpenTrips open trips (note MINING_STOCK_COVERED); off = as before.
# Not in the launcher.
# Default: false.
# EVEJS_LNE_MINING_STOCK_COVER_ENABLED=

# mining.stockCoverRebuilds - Internal: full rebuilds of the hull buffer (hullTargets) the stock must pay for to count as covered.
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 30.
# EVEJS_LNE_MINING_STOCK_COVER_REBUILDS=

# mining.coveredMaxOpenTrips - Internal: open mining trips of a faction while its mineral stock is covered.
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 1.
# EVEJS_LNE_MINING_COVERED_MAX_OPEN_TRIPS=

# production.enabled - Internal: switch of the production service (with modules.strategy); off = ACTIVE jobs frozen, mobilization in the legacy way.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_PRODUCTION_ENABLED=

# production.linesPerNpcStation - Internal: production lines of an npc station.
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 4.
# EVEJS_LNE_PRODUCTION_LINES_PER_NPC_STATION=

# production.linesPerUpwellStation - Internal: production lines of an upwell station (an Astrahus is a weak factory).
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_PRODUCTION_LINES_PER_UPWELL_STATION=

# production.maxActiveJobsPerFaction - Internal: ACTIVE jobs of one faction.
# Not in the launcher. Range 0..256 (outside: clamped).
# Default: 24.
# EVEJS_LNE_PRODUCTION_MAX_ACTIVE_JOBS_PER_FACTION=

# production.industryEnabled - Internal: industry hulls (barges, exhumers, boosters) built by the AI (false = combat hulls only).
# Not in the launcher.
# Default: true.
# EVEJS_LNE_PRODUCTION_INDUSTRY_ENABLED=

# production.maxIndustryJobsPerReview - Internal: industry PRODUCE intents of one strategy review.
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_PRODUCTION_MAX_INDUSTRY_JOBS_PER_REVIEW=

# production.maxActiveIndustryJobsPerFaction - Internal: ACTIVE industry jobs of one faction (they never take every line of the combat production).
# Not in the launcher. Range 0..256 (outside: clamped).
# Default: 2.
# EVEJS_LNE_PRODUCTION_MAX_ACTIVE_INDUSTRY_JOBS_PER_FACTION=

# production.minerPriorityEnabled - Internal: industry PRODUCE before the combat one while the paid mining hulls are below the floor (false = before). compose.yaml passes 1 unless the root.env sets it.
# Not in the launcher.
# Default: false.
# EVEJS_LNE_PRODUCTION_MINER_PRIORITY_ENABLED=

# production.minerFloorPermille - Internal: floor of the paid mining hulls per miner slot (max(mining fleets, wanted) x mining.minersPerFleetBase).
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_PRODUCTION_MINER_FLOOR_PERMILLE=

# production.minerReserveRuns - Internal: runs of the best industry hull whose minerals one station keeps from the combat production and convoys.
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_PRODUCTION_MINER_RESERVE_RUNS=

# production.maxJobsPerReview - Internal: PRODUCE intents of one strategy review.
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_PRODUCTION_MAX_JOBS_PER_REVIEW=

# production.maxRunsPerJob - Internal: hulls of one job (sequential runs).
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 2.
# EVEJS_LNE_PRODUCTION_MAX_RUNS_PER_JOB=

# production.timeFactorPermille - Internal: factor of the blueprint time (X-Eve timeScale idea).
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_PRODUCTION_TIME_FACTOR_PERMILLE=

# production.minRunMs - Internal: floor of one run.
# Not in the launcher. Range 1000..86400000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_PRODUCTION_MIN_RUN_MS=

# production.maxRunMs - Internal: ceiling of one run (capitals: 2 000 000 s blueprint).
# Not in the launcher. Range 60000..2592000000 (outside: clamped).
# Default: 28800000.
# EVEJS_LNE_PRODUCTION_MAX_RUN_MS=

# production.scaledTimeEnabled - Internal: runMs = min(titanRunMs, max(minRunMs, floor(timeSec x titanRunMs / scaledTimeReferenceSec))); timeFactorPermille and maxRunMs do not act in this mode (false = the state before).
# Not in the launcher.
# Default: false.
# EVEJS_LNE_PRODUCTION_SCALED_TIME_ENABLED=

# production.titanRunMs - Internal: run of the reference blueprint (titan, 8 h) and the ceiling of the scaled time.
# Not in the launcher. Range 60000..604800000 (outside: clamped).
# Default: 28800000.
# EVEJS_LNE_PRODUCTION_TITAN_RUN_MS=

# production.scaledTimeReferenceSec - Internal: blueprint seconds that take titanRunMs (titan, SDE 3396210).
# Not in the launcher. Range 1..100000000 (outside: clamped).
# Default: 9000000.
# EVEJS_LNE_PRODUCTION_SCALED_TIME_REFERENCE_SEC=

# production.capitalLadderEnabled - Internal: demand for capital classes outside the doctrine buffer (rungs carrier/dread/FAX -> super -> titan, mineral reserve in one station, PRODUCE of one class per review; false = the state before).
# Not in the launcher.
# Default: false.
# EVEJS_LNE_PRODUCTION_CAPITAL_LADDER_ENABLED=

# production.ladderOverRoomEnabled - Internal: a ladder rung whose fee of one run exceeds the full day war room (dayBudget x treasury.productionRoomSharePermille) is paid from the balance (LADDER_OVER_ROOM), a balance below it releases the mineral reserve in that review (LADDER_FEE_UNREACHABLE); false = the state before. Only with capitalLadderEnabled and treasury.pressureEnabled. compose.yaml sets 1.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_PRODUCTION_LADDER_OVER_ROOM_ENABLED=

# production.ladderUnlockPermille - Internal: hull buffer permille of the mobilization stations that opens the first rung of the ladder.
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 800.
# EVEJS_LNE_PRODUCTION_LADDER_UNLOCK_PERMILLE=

# production.ladderBufferPoolCapEnabled - Internal: a hull group at the pool ceiling (production.poolCapEnabled, all own stations) counts as full in the ladder buffer of the mobilization stations; false = the state before. compose.yaml sets 1.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_PRODUCTION_LADDER_BUFFER_POOL_CAP_ENABLED=

# production.ladderQuotaCarrier - Internal: carriers per faction (fleets + station stock + ACTIVE jobs) the ladder builds.
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_PRODUCTION_LADDER_QUOTA_CARRIER=

# production.ladderQuotaDreadnought - Internal: dreadnoughts per faction the ladder builds.
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_PRODUCTION_LADDER_QUOTA_DREADNOUGHT=

# production.ladderQuotaForceAuxiliary - Internal: force auxiliaries per faction the ladder builds.
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 1.
# EVEJS_LNE_PRODUCTION_LADDER_QUOTA_FORCE_AUXILIARY=

# production.ladderQuotaSupercarrier - Internal: supercarriers per faction the ladder builds.
# Not in the launcher. Range 0..4 (outside: clamped).
# Default: 1.
# EVEJS_LNE_PRODUCTION_LADDER_QUOTA_SUPERCARRIER=

# production.ladderQuotaTitan - Internal: titans per faction the ladder builds.
# Not in the launcher. Range 0..4 (outside: clamped).
# Default: 1.
# EVEJS_LNE_PRODUCTION_LADDER_QUOTA_TITAN=

# production.ladderFactionKinds - Internal: faction kinds (registry FACTION_KINDS) the capital ladder runs for.
# Not in the launcher. A comma list of distinct faction kinds pirate, empire, police, neutral, invader, hive.
# Default: empire,pirate.
# EVEJS_LNE_PRODUCTION_LADDER_FACTION_KINDS=

# production.supercarrierRecipePermille - Internal: minerals of the supercarrier recipe, ceil(m x permille / 1000) (1000 = the SDE recipe).
# Not in the launcher. Range 50..1000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_PRODUCTION_SUPERCARRIER_RECIPE_PERMILLE=

# production.titanRecipePermille - Internal: minerals of the titan recipe, ceil(m x permille / 1000) (1000 = the SDE recipe).
# Not in the launcher. Range 50..1000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_PRODUCTION_TITAN_RECIPE_PERMILLE=

# production.capitalHighsecAllowed - Internal: false = the ladder never saves for / builds a capital in a highsec station.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_PRODUCTION_CAPITAL_HIGHSEC_ALLOWED=

# production.targetStockFleets - Internal: hull buffer = this many fleets of every doctrine role.
# Not in the launcher. Range 0..20 (outside: clamped).
# Default: 2.
# EVEJS_LNE_PRODUCTION_TARGET_STOCK_FLEETS=

# production.mobilizationStations - Internal: stations of a faction filled with whole doctrine templates (deficit per station, buffer in each).
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_PRODUCTION_MOBILIZATION_STATIONS=

# production.poolCapEnabled - Internal: global hull pool ceiling over all own stations; off = deficit of the mobilization stations only. compose.yaml passes 0 unless the root.env sets it.
# Not in the launcher.
# Default: false.
# EVEJS_LNE_PRODUCTION_POOL_CAP_ENABLED=

# production.poolCapStations - Internal: pool ceiling = desired per station x this (>= mobilizationStations, else a config warning).
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 3.
# EVEJS_LNE_PRODUCTION_POOL_CAP_STATIONS=

# production.poolCapReleaseEnabled - Internal (): a capped group is released when no own station within strategy.mobilizeFallbackJumps of the focus holds the hulls of one template (stock + ACTIVE runs); its jobs only in reach. Needs production.poolCapEnabled. compose.yaml passes 0 unless the root.env sets it.
# Not in the launcher.
# Default: false.
# EVEJS_LNE_PRODUCTION_POOL_CAP_RELEASE_ENABLED=

# production.hunterHulls - Internal: the hunter template counts in the hull buffer (doctrine fieldsHunters, hunt on); false = the state before.
# Not in the launcher.
# Default: true.
# EVEJS_LNE_PRODUCTION_HUNTER_HULLS=

# production.mobilizeHulls - Internal: required = a mobilization takes its hulls from the station stock; off = a mobilization does not need hulls in stock.
# Not in the launcher. Values: required | off.
# Default: required.
# EVEJS_LNE_PRODUCTION_MOBILIZE_HULLS=

# production.miningNeedsHulls - Internal: a miner mobilization takes hulls too (false = the bootstrap of the economy).
# Not in the launcher.
# Default: false.
# EVEJS_LNE_PRODUCTION_MINING_NEEDS_HULLS=

# production.waitRecheckMs - Internal: next deadline of a waiting job (reinforced station, full stock).
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_PRODUCTION_WAIT_RECHECK_MS=

# production.maxWaitRounds - Internal: waits of a job before TIMEOUT.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 72.
# EVEJS_LNE_PRODUCTION_MAX_WAIT_ROUNDS=

# production.jobRetentionMs - Internal: ended jobs kept (panel 24 h, totals survive the prune).
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 604800000.
# EVEJS_LNE_PRODUCTION_JOB_RETENTION_MS=

# production.pruneBatch - Internal: ended jobs pruned per job start.
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_PRODUCTION_PRUNE_BATCH=

# production.reconcileMaxJobs - Internal: ACTIVE jobs checked by the reconcile after a start.
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_PRODUCTION_RECONCILE_MAX_JOBS=

# production.reconcileMaxAttempts - Internal: suffixed reconcile keys tried per job.
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_PRODUCTION_RECONCILE_MAX_ATTEMPTS=

# production.maxCompletionsPerPass - Internal: maxPerPass of the PRODUCTION_JOB_COMPLETE handler.
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_PRODUCTION_MAX_COMPLETIONS_PER_PASS=

# production.freeHullGroups - Internal: hull groups a faction does not build and a mobilization gets for free (none = no free groups).
# Not in the launcher. Values: none or a comma list of distinct hull groups of lib/fleets/schema HULL_GROUPS.
# Default: mining_frigate,industrial.
# EVEJS_LNE_PRODUCTION_FREE_HULL_GROUPS=

# production.componentWeightPermille - Internal: weight of the component factor of an industry recipe (0 = minerals only).
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_PRODUCTION_COMPONENT_WEIGHT_PERMILLE=

# production.componentFactorMaxPermille - Internal: ceiling of the component factor of an industry recipe.
# Not in the launcher. Range 1000..20000 (outside: clamped).
# Default: 4000.
# EVEJS_LNE_PRODUCTION_COMPONENT_FACTOR_MAX_PERMILLE=
# battle.strengthGroupConfidence - Internal: confidence of a strength taken from the hull group median
# (fleet composition without typeId). Not in the launcher. Range 0.01..1 (outside: clamped).
# Default: 0.9.
# EVEJS_LNE_BATTLE_STRENGTH_GROUP_CONFIDENCE=

# battle.strengthUnknownTypeConfidence - Internal: confidence when the typeId is unknown to the strength
# catalogue or belongs to another hull group (group row used). Never above strengthGroupConfidence (lowered
# with a warning). Not in the launcher. Range 0.01..1 (outside: clamped).
# Default: 0.6.
# EVEJS_LNE_BATTLE_STRENGTH_UNKNOWN_TYPE_CONFIDENCE=

# battle.resolverMaxRounds - Internal: most rounds of one virtual battle (resolver internal-v1); both sides
# still on the field after the limit -> DRAW. Not in the launcher. Range 1..50 (outside: clamped).
# Default: 16 (calib-v1).
# EVEJS_LNE_BATTLE_RESOLVER_MAX_ROUNDS=

# battle.resolverRoundSec - Internal: seconds of one resolver round (damage and reps per round, battle duration).
# Not in the launcher. Range 1..600 (outside: clamped).
# Default: 30.
# EVEJS_LNE_BATTLE_RESOLVER_ROUND_SEC=

# battle.resolverWorkUnitsPerMs - Internal: work units of the resolver per ms of input.maxResolutionMs; a battle
# whose estimated work is above maxResolutionMs x this is refused (RESOLVER_BUDGET) before any computation.
# Not in the launcher. Range 1000..10000000 (outside: clamped).
# Default: 50000.
# EVEJS_LNE_BATTLE_RESOLVER_WORK_UNITS_PER_MS=

# battle.resolverDpsScale - Internal: absolute scale of the catalogue DPS in the resolver.
# Not in the launcher. Range 0.01..10 (outside: clamped).
# Default: 0.7 (calib-v1).
# EVEJS_LNE_BATTLE_RESOLVER_DPS_SCALE=

# battle.resolverEhpScale - Internal: scale of the catalogue EHP in the resolver.
# Not in the launcher. Range 0.01..10 (outside: clamped).
# Default: 2.75 (calib-v1).
# EVEJS_LNE_BATTLE_RESOLVER_EHP_SCALE=

# battle.resolverRepScale - Internal: scale of reps / logistics in the resolver (0 = no reps).
# Not in the launcher. Range 0..10 (outside: clamped).
# Default: 0.75 (calib-v1).
# EVEJS_LNE_BATTLE_RESOLVER_REP_SCALE=

# battle.resolverRoundVariance - Internal: random spread of a side's damage in one round (0.4 = +-40%).
# Not in the launcher. Range 0..0.9 (outside: clamped).
# Default: 0.4.
# EVEJS_LNE_BATTLE_RESOLVER_ROUND_VARIANCE=

# battle.resolverRetreatLossFraction - Internal: base share of lost EHP after which a side retreats (multiplied by
# the morale of the objective / of the defender). Not in the launcher. Range 0.05..1 (outside: clamped).
# Default: 0.8 (calib-v1).
# EVEJS_LNE_BATTLE_RESOLVER_RETREAT_LOSS_FRACTION=

# battle.resolverRetreatPowerRatio - Internal: a side that dies this many times faster than the enemy retreats.
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 3.
# EVEJS_LNE_BATTLE_RESOLVER_RETREAT_POWER_RATIO=

# battle.resolverGarrisonDpsPerPoint - Internal: DPS of a system garrison per point of its strength.
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_BATTLE_RESOLVER_GARRISON_DPS_PER_POINT=

# battle.resolverGarrisonEhpPerPoint - Internal: EHP of a system garrison per point of its strength.
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_BATTLE_RESOLVER_GARRISON_EHP_PER_POINT=

# battle.resolverModelConfidence - Internal: confidence factor of the resolver model internal-v1 in a result.
# Not in the launcher. Range 0.01..1 (outside: clamped).
# Default: 0.7.
# EVEJS_LNE_BATTLE_RESOLVER_MODEL_CONFIDENCE=

# presence.pollMs - Internal: pause (ms) between two reads of the live session list (dock, login, logout).
# Not in the launcher. Range 250..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_PRESENCE_POLL_MS=

# presence.hookEnabled - Internal: re-read the session list at once after a jump, dock or undock.
# 0 = poll only. Not in the launcher.
# Default: 1.
# EVEJS_LNE_PRESENCE_HOOK_ENABLED=

# presence.neighborRadius - Internal: default jumps around a player that count as near a player.
# Not in the launcher. Range 0..5 (outside: clamped).
# Default: 1.
# EVEJS_LNE_PRESENCE_NEIGHBOR_RADIUS=

# presence.maxRadius - Internal: largest radius (jumps) a presence query may ask for.
# Not in the launcher. Range 0..10 (outside: clamped).
# Default: 5.
# EVEJS_LNE_PRESENCE_MAX_RADIUS=

# presence.maxCharacters - Internal: most characters one presence read keeps with names.
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_PRESENCE_MAX_CHARACTERS=

# graph.diameterSampleSources - Internal: BFS sources of the max-jumps sample after the graph build; 0 = no sample.
# Not in the launcher. Range 0..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_GRAPH_DIAMETER_SAMPLE_SOURCES=

# telemetry.intervalSeconds -How often the mod rebuilds its metrics snapshot and writes telemetry/latest.json. Range 1..300 (outside: clamped).
# Default: 10.
# EVEJS_LNE_TELEMETRY_INTERVAL_SECONDS=

# telemetry.histogramSamples - Internal: samples kept per histogram (the window of p50/p95/max; 3000 = 5 min of 10 Hz ticks).
# Not in the launcher. Range 32..10000 (outside: clamped).
# Default: 3000.
# EVEJS_LNE_TELEMETRY_HISTOGRAM_SAMPLES=

# telemetry.histogramSummariesPerPass - Internal: most changed histograms summarized (copy + sort of the ring) per
# snapshot pass; unchanged histograms reuse their last summary, the other changed ones wait for a later pass.
# Not in the launcher. Range 1..16384 (outside: clamped).
# Default: 16.
# EVEJS_LNE_TELEMETRY_HISTOGRAM_SUMMARIES_PER_PASS=

# telemetry.maxMetrics - Internal safety cap: most distinct metric names the mod keeps.
# Not in the launcher. Range 32..16384 (outside: clamped).
# Default: 4096.
# EVEJS_LNE_TELEMETRY_MAX_METRICS=

# telemetry.slowOpMs - Internal: a database write, checkpoint or scheduler pass this long (ms) is counted
# and logged as ": slow ".
# Not in the launcher. Range 10..5000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_TELEMETRY_SLOW_OP_MS=

# telemetry.slowOpLogPerMin - Internal: most ": slow " log lines per minute (per module).
# Not in the launcher. Range 0..600 (outside: clamped).
# Default: 10.
# EVEJS_LNE_TELEMETRY_SLOW_OP_LOG_PER_MIN=

# telemetry.txFailureLogLimit - Internal: the first N TX_FAILED / TX_CONSTRAINT transactions of a process get one
# "persistence: tx" log line (transaction name, SQLite code, error message; never the payload), then only the
# persistence.tx.* counter. 0 = no line.
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 20.
# EVEJS_LNE_TELEMETRY_TX_FAILURE_LOG_LIMIT=

# telemetry.spikeAttribution - Internal: one ": spike " log line per long tick, splitting the gap into EveJS tick
# work, GC, operations of the mod and the rest. 0 = off.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_TELEMETRY_SPIKE_ATTRIBUTION=

# telemetry.spikeLogMs - Internal: tick interval (ms) that counts as a spike. 0 = governor.emergencyMs.
# Not in the launcher. Range 0..5000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_TELEMETRY_SPIKE_LOG_MS=

# telemetry.spikeRingSize - Internal: mod operations and GC pauses kept for the attribution (two rings).
# Not in the launcher. Range 32..8192 (outside: clamped).
# Default: 512.
# EVEJS_LNE_TELEMETRY_SPIKE_RING_SIZE=

# telemetry.spikeMaxPending - Internal: spikes waiting for the next telemetry pass (beyond: dropped and counted).
# Not in the launcher. Range 1..1024 (outside: clamped).
# Default: 64.
# EVEJS_LNE_TELEMETRY_SPIKE_MAX_PENDING=

# telemetry.spikeMaxOpsPerLine - Internal: longest ops= list of a spike line.
# Not in the launcher. Range 1..32 (outside: clamped).
# Default: 6.
# EVEJS_LNE_TELEMETRY_SPIKE_MAX_OPS_PER_LINE=

# telemetry.bootGraceSeconds - Internal: boot grace after the telemetry tick subscription. Tick samples whose gap
# starts inside it are spike source "boot" and are not counted by the load governor. 0 = off.
# Not in the launcher. Range 0..300 (outside: clamped).
# Default: 30.
# EVEJS_LNE_TELEMETRY_BOOT_GRACE_SECONDS=

# telemetry.heapDetail - Internal: process.heap in the telemetry snapshot (V8 heap statistics, heap spaces and the
# heap left after each major GC). 0 = heap null, no v8 call.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_TELEMETRY_HEAP_DETAIL=

# telemetry.heapAfterMajorRing - Internal: entries of process.heap.afterMajor.ring (288 = about one day).
# Not in the launcher. Range 16..4096 (outside: clamped).
# Default: 288.
# EVEJS_LNE_TELEMETRY_HEAP_AFTER_MAJOR_RING=

# telemetry.majorGcLogMs - Internal: a major GC pause this long (ms) gets one "telemetry: major GC" log line.
# 0 = off.
# Not in the launcher. Range 0..60000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_TELEMETRY_MAJOR_GC_LOG_MS=

# telemetry.pollerStallLogMs - Internal: a poller pass whose promise (for example a durable flush) is still pending
# after this many ms gets one "poller: pass still pending" log line. 0 = off.
# Not in the launcher. Range 0..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_TELEMETRY_POLLER_STALL_LOG_MS=

# Module cost ledger (ms/min per poller, scheduler
# event, transaction and adapter call), memory probes and budget alarms. Snapshot field moduleCost, observer view
# module-cost. Not in the launcher.

# telemetry.moduleCost.enabled - 0 = no moduleCost field, no poller hook (every poller pass as before). Default: 1.
# EVEJS_LNE_TELEMETRY_MODULE_COST_ENABLED=

# telemetry.moduleCost.bucketMs - one ledger bucket (ms). Range 10000..600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_TELEMETRY_MODULE_COST_BUCKET_MS=

# telemetry.moduleCost.windowMinutes - buckets in the window. Range 2..60 (outside: clamped). Default: 10.
# EVEJS_LNE_TELEMETRY_MODULE_COST_WINDOW_MINUTES=

# telemetry.moduleCost.maxLabels - tx:*, adapter:*, observer:* ... labels of one bucket, beyond -> other.
# Range 16..2048 (outside: clamped). Default: 256.
# EVEJS_LNE_TELEMETRY_MODULE_COST_MAX_LABELS=

# telemetry.moduleCost.maxPollerLabels - poller and sched:* labels of one bucket (own pool, tx:* never fills it),
# beyond -> other. Range 16..2048 (outside: clamped). Default: 256.
# EVEJS_LNE_TELEMETRY_MODULE_COST_MAX_POLLER_LABELS=

# telemetry.moduleCost.topN - labels in the snapshot (most ms/min first). Range 5..256 (outside: clamped). Default: 40.
# EVEJS_LNE_TELEMETRY_MODULE_COST_TOP_N=

# telemetry.moduleCost.memoryProbeMs - memory probes run at most this often (ms). Range 10000..3600000. Default: 60000.
# EVEJS_LNE_TELEMETRY_MODULE_COST_MEMORY_PROBE_MS=

# telemetry.moduleCost.maxMemoryProbes - registered memory probes. Range 1..128 (outside: clamped). Default: 32.
# EVEJS_LNE_TELEMETRY_MODULE_COST_MAX_MEMORY_PROBES=

# telemetry.budgets.moduleMsPerMin - one label above this (ms per minute) in the last full bucket -> alarm
# moduleOverBudget. Range 100..60000 (outside: clamped). Default: 3000 (5% of a core).
# EVEJS_LNE_TELEMETRY_BUDGETS_MODULE_MS_PER_MIN=

# telemetry.budgets.heapAfterMajorWarnBytes - heap after the last major GC at or above -> alarm heapAfterMajorWarn.
# Range 1000000000..20000000000. Default: 5905580032 (5.5 GiB).
# EVEJS_LNE_TELEMETRY_BUDGETS_HEAP_AFTER_MAJOR_WARN_BYTES=

# telemetry.budgets.heapAfterMajorCriticalBytes - at or above -> alarm heapAfterMajorCritical (must be above warn).
# Range 1000000000..20000000000. Default: 6979321856 (6.5 GiB).
# EVEJS_LNE_TELEMETRY_BUDGETS_HEAP_AFTER_MAJOR_CRITICAL_BYTES=

# Poller pacer. The re-arm after a poller pass grows
# with the governor mode and the module budget (a pass is never skipped, only later). LIVE scene pollers are never
# stretched. Counters perf.pollerStretched, perf.pollerBudgetStretched, gauge perf.stretchedLabels. Not in the launcher.

# perf.pollerPacing.enabled - 0 = no pacer, every poller re-arms after its interval as before. Default: 1.
# EVEJS_LNE_PERF_POLLER_PACING_ENABLED=

# perf.pollerPacing.constrainedFactor - interval multiplier in governor mode CONSTRAINED. Range 1..10. Default: 1.
# EVEJS_LNE_PERF_POLLER_PACING_CONSTRAINED_FACTOR=

# perf.pollerPacing.overloadedFactor - interval multiplier in governor mode OVERLOADED. Range 1..20. Default: 3.
# EVEJS_LNE_PERF_POLLER_PACING_OVERLOADED_FACTOR=

# perf.pollerPacing.shedFactor - interval multiplier in governor mode SHED. Range 1..50. Default: 6.
# EVEJS_LNE_PERF_POLLER_PACING_SHED_FACTOR=

# perf.pollerPacing.maxStretchMs - a stretched re-arm is at most max(interval, this) ms. Range 10000..3600000.
# Default: 600000.
# EVEJS_LNE_PERF_POLLER_PACING_MAX_STRETCH_MS=

# perf.pollerPacing.budgetStretch - 1 = a label above telemetry.budgets.moduleMsPerMin for budgetWindows full minutes
# gets x budgetStretchFactor, also in NORMAL (needs telemetry.moduleCost.enabled). Default: 1.
# EVEJS_LNE_PERF_POLLER_PACING_BUDGET_STRETCH=

# perf.pollerPacing.budgetStretchFactor - interval multiplier of a label over its budget. Range 1..10. Default: 2.
# EVEJS_LNE_PERF_POLLER_PACING_BUDGET_STRETCH_FACTOR=

# perf.pollerPacing.budgetWindows - full minutes over the budget to switch the stretch on, in the budget to switch it
# off. Range 1..30, at most telemetry.moduleCost.windowMinutes - 1 (else a warning). Default: 3.
# EVEJS_LNE_PERF_POLLER_PACING_BUDGET_WINDOWS=

# perf.pollerPacing.exempt - comma list of poller label prefixes never stretched (labels: view module-cost, e.g.
# highsecLife/index.js:584). At most 64 entries. Default: empty.
# EVEJS_LNE_PERF_POLLER_PACING_EXEMPT=

# NPC budget of one scene. Every LNE spawn of the adapter
# (materialization, patrols, hunts, heavy events, traffic, situations, bounty, ambient rats, belt navy, mining waves,
# officers) counts the native NPC of the scene first and is refused above the cap (SCENE_NPC_BUDGET, transient: the
# work retries in a later pass). Counters perf.sceneNpc.refused(.<source>), gauge perf.sceneNpc.lastCount. Not in the
# launcher.

# perf.sceneNpc.enabled - 0 = no budget, every LNE spawn goes to the vendor as before. Default: 1.
# EVEJS_LNE_PERF_SCENE_NPC_ENABLED=

# perf.sceneNpc.maxPerScene - native NPC of one scene above which a new LNE spawn is refused (governor NORMAL /
# CONSTRAINED). Range 10..2000. Default: 150.
# EVEJS_LNE_PERF_SCENE_NPC_MAX_PER_SCENE=

# perf.sceneNpc.overloadedPermille - the cap in governor mode OVERLOADED = maxPerScene x this / 1000. Range 0..1000.
# Default: 600.
# EVEJS_LNE_PERF_SCENE_NPC_OVERLOADED_PERMILLE=

# perf.sceneNpc.shedExemptSources - comma list of spawn sources still admitted in SHED (cap 0 for the rest). Sources:
# materialization, npcSpawn, heavyEvents, highsecTraffic, bounty, situations, ambientRats, empireBelts,
# miningEncounters, officerSpawn; none = no source. Default: materialization (the LIVE battle, already settled).
# EVEJS_LNE_PERF_SCENE_NPC_SHED_EXEMPT_SOURCES=

# perf.sceneNpc.maxScan - scene entities read per spawn at most; a scan cut here counts as a full scene.
# Range 64..65536. Default: 4096.
# EVEJS_LNE_PERF_SCENE_NPC_MAX_SCAN=

# Stall diag - names the "rest" of tick spikes
# (timer tags, durable scheduler jobs, killmail clones, vendor pauses, event loop delay, optional CPU profile).
# Not in the launcher. Off = no wrap at all. Set in the root .env for one measured restart (compose :-0), then 0.

# telemetry.stallDiag.enabled - the diag (needs telemetry.spikeAttribution). Default: 0.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_ENABLED=

# telemetry.stallDiag.slowCallbackMs - callback / handler / clone this long (ms) goes into the ring.
# Range 5..5000 (outside: clamped). Default: 50.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_SLOW_CALLBACK_MS=

# telemetry.stallDiag.timerTags - wrap of the global timers with the scheduling place. Default: 1.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_TIMER_TAGS=

# telemetry.stallDiag.stackDepth - frames captured at the scheduling place. Range 2..32 (outside: clamped).
# Default: 8.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_STACK_DEPTH=

# telemetry.stallDiag.captureMaxPerSec - stack captures per second; 0 = only fn:<name>.
# Range 0..100000 (outside: clamped). Default: 2000.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_CAPTURE_MAX_PER_SEC=

# telemetry.stallDiag.jobs - durable scheduler job handler timing. Default: 1.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_JOBS=

# telemetry.stallDiag.killmailClone - getAllKillmailRecords clone time and caller. Default: 1.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_KILLMAIL_CLONE=

# telemetry.stallDiag.ringSize - foreign spans kept. Range 32..8192 (outside: clamped). Default: 512.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_RING_SIZE=

# telemetry.stallDiag.maxLabels - labels of the summary window. Range 8..1024 (outside: clamped). Default: 64.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_MAX_LABELS=

# telemetry.stallDiag.summaryMinutes - window of the "telemetry: stall-diag" line; 0 = no line.
# Range 0..1440 (outside: clamped). Default: 5.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_SUMMARY_MINUTES=

# telemetry.stallDiag.loopDelayResolutionMs - monitorEventLoopDelay resolution (ms); 0 = off.
# Range 0..1000 (outside: clamped). Default: 20.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_LOOP_DELAY_RESOLUTION_MS=

# telemetry.stallDiag.maxMinutes - timer wraps stop wrapping new callbacks after this long; 0 = no limit.
# Range 0..10080 (outside: clamped). Default: 120.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_MAX_MINUTES=

# telemetry.stallDiag.profile.enabled - one CPU profile at the first unattributed spike after bootGrace.
# The first sample freezes the process 4-5 s. Default: 0.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_PROFILE_ENABLED=

# telemetry.stallDiag.profile.triggerRestMs - rest (ms) that starts the profile. Range 50..10000. Default: 300.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_PROFILE_TRIGGER_REST_MS=

# telemetry.stallDiag.profile.durationSec - profile window (s). Range 5..600 (outside: clamped). Default: 120.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_PROFILE_DURATION_SEC=

# telemetry.stallDiag.profile.samplingIntervalUs - sampling interval (us). Range 100..100000. Default: 1000.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_PROFILE_SAMPLING_INTERVAL_US=

# telemetry.stallDiag.profile.maxPerBoot - profiles per process start. Range 0..3 (outside: clamped). Default: 1.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_PROFILE_MAX_PER_BOOT=

# telemetry.stallDiag.profile.topN - length of the profile line lists. Range 1..50 (outside: clamped). Default: 10.
# EVEJS_LNE_TELEMETRY_STALL_DIAG_PROFILE_TOP_N=

# governor.sampleCount - Internal: tick samples in the governor window (p95 over the last N ticks).
# Not in the launcher. Range 2..300 (outside: clamped).
# Default: 100.
# EVEJS_LNE_GOVERNOR_SAMPLE_COUNT=

# governor.warningP95Ms - Tick interval p95 at which the mod defers its strategy work (only with governor signal p95). Range 101..499 (outside: clamped).
# Default: 120.
# EVEJS_LNE_GOVERNOR_WARNING_P95_MS=

# governor.overloadP95Ms - Tick interval p95 at which the mod runs only settlements and live work (only with governor signal p95). Range 102..499 (outside: clamped).
# Default: 130.
# EVEJS_LNE_GOVERNOR_OVERLOAD_P95_MS=

# governor.emergencyMs - A single tick this long pauses all background work of the mod for a moment. Range 130..599 (outside: clamped).
# Default: 500.
# EVEJS_LNE_GOVERNOR_EMERGENCY_MS=

# governor.unplayableMs - Internal: a tick this long (or a p95 this high) trips the unplayable breaker.
# Not in the launcher. Range 500..600 (outside: clamped).
# Default: 600.
# EVEJS_LNE_GOVERNOR_UNPLAYABLE_MS=

# governor.recoveryThresholdMs - Internal: after pressure the tick p95 must stay below this to recover.
# Not in the launcher. Range 100..119 (outside: clamped).
# Default: 112.
# EVEJS_LNE_GOVERNOR_RECOVERY_THRESHOLD_MS=

# governor.recoverySeconds - How long the tick must stay healthy before the mod works at full speed again. Range 0..60 (outside: clamped).
# Default: 15.
# EVEJS_LNE_GOVERNOR_RECOVERY_SECONDS=

# governor.overloadExitP95Ms - Internal: after overload the tick p95 must drop below this to step down to constrained.
# Not in the launcher. Range 101..499 (outside: clamped).
# Default: 120.
# EVEJS_LNE_GOVERNOR_OVERLOAD_EXIT_P95_MS=

# governor.minModeHoldSeconds - Internal: minimum time in a governor mode before it steps down one level (0 = no hold).
# Not in the launcher. Range 0..900 (outside: clamped).
# Default: 180.
# EVEJS_LNE_GOVERNOR_MIN_MODE_HOLD_SECONDS=

# governor.shedMinHoldSeconds - Internal: base SHED steps down to OVERLOADED after this hold (not minModeHoldSeconds), so settlements and live work return ~30 s after an isolated stall.
# Not in the launcher. Range 0..900 (outside: clamped).
# Default: 30.
# EVEJS_LNE_GOVERNOR_SHED_MIN_HOLD_SECONDS=

# governor.shedFastExitCooldownSeconds - Internal: at most one fast SHED exit per this window (0 = every SHED exit fast, no hourly bound).
# Not in the launcher. Range 0..86400 (outside: clamped).
# Default: 3600.
# EVEJS_LNE_GOVERNOR_SHED_FAST_EXIT_COOLDOWN_SECONDS=

# governor.logMinIntervalSeconds - Internal: at most one governor transition log line per this window (0 = every line).
# Not in the launcher. Range 0..3600 (outside: clamped).
# Default: 60.
# EVEJS_LNE_GOVERNOR_LOG_MIN_INTERVAL_SECONDS=

# governor.shedHoldMs - Internal: how long one emergency tick keeps background work paused.
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_GOVERNOR_SHED_HOLD_MS=

# governor.staleSampleMs - Internal: no tick sample for this long = no regulation (NORMAL).
# Not in the launcher. Range 1000..60000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_GOVERNOR_STALE_SAMPLE_MS=

# governor.constrainedBudgetMs - Internal: scheduler ms per pass while constrained (capped by maxSchedulerWorkMs).
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 0.5.
# EVEJS_LNE_GOVERNOR_CONSTRAINED_BUDGET_MS=

# governor.constrainedMaxJobs - Internal: jobs per pass while constrained (capped by maxDueEventsPerPass).
# Not in the launcher. Range 0..1024 (outside: clamped).
# Default: 1.
# EVEJS_LNE_GOVERNOR_CONSTRAINED_MAX_JOBS=

# governor.overloadedBudgetMs - Internal: scheduler ms per pass while overloaded (capped by maxSchedulerWorkMs).
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 0.25.
# EVEJS_LNE_GOVERNOR_OVERLOADED_BUDGET_MS=

# governor.overloadedMaxJobs - Internal: jobs per pass while overloaded (capped by maxDueEventsPerPass).
# Not in the launcher. Range 0..1024 (outside: clamped).
# Default: 1.
# EVEJS_LNE_GOVERNOR_OVERLOADED_MAX_JOBS=

# governor.signal - Internal: what drives the governor modes constrained/overloaded: lateness = share of late tick
# time over the last latenessSampleCount ticks, p95 = tick interval p95 against warningP95Ms/overloadP95Ms
# (the older mode). The unplayable breaker always uses the p95.
# Not in the launcher. One of lateness, p95. Default: lateness.
# EVEJS_LNE_GOVERNOR_SIGNAL=

# governor.latenessSampleCount - Internal: tick samples in the lateness window (about 60 s at 10 Hz).
# Not in the launcher. Range 100..3000 (outside: clamped).
# Default: 600.
# EVEJS_LNE_GOVERNOR_LATENESS_SAMPLE_COUNT=

# governor.latenessWarningPercent - Internal: tick lateness share (%) at which the mod defers its strategy work.
# Not in the launcher. Range 1..90 (outside: clamped).
# Default: 15.
# EVEJS_LNE_GOVERNOR_LATENESS_WARNING_PERCENT=

# governor.latenessOverloadPercent - Internal: tick lateness share (%) at which the mod runs only settlements and live work.
# Not in the launcher. Range 1..95 (outside: clamped).
# Default: 25.
# EVEJS_LNE_GOVERNOR_LATENESS_OVERLOAD_PERCENT=

# governor.latenessRecoveryPercent - Internal: after pressure the lateness share must stay below this to recover.
# Not in the launcher. Range 0..90 (outside: clamped).
# Default: 10.
# EVEJS_LNE_GOVERNOR_LATENESS_RECOVERY_PERCENT=

# governor.latenessOverloadExitPercent - Internal: after overload the lateness share must drop below this to step down to constrained.
# Not in the launcher. Range 0..95 (outside: clamped).
# Default: 15.
# EVEJS_LNE_GOVERNOR_LATENESS_OVERLOAD_EXIT_PERCENT=

# governor.vendorPauseExcuseEnabled - Internal: the governor ignores the measured EveJS pause of a player's system entry (content prepare, jump prewarm) in the tick sample (0 = samples unchanged).
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_GOVERNOR_VENDOR_PAUSE_EXCUSE_ENABLED=

# governor.vendorPauseMinMs - Internal: shorter EveJS entry calls are not reported as pauses.
# Not in the launcher. Range 100..5000 (outside: clamped).
# Default: 250.
# EVEJS_LNE_GOVERNOR_VENDOR_PAUSE_MIN_MS=

# governor.vendorPauseMaxExcuseMs - Internal: one entry pause excuses at most this many ms.
# Not in the launcher. Range 1000..60000 (outside: clamped).
# Default: 10000.
# EVEJS_LNE_GOVERNOR_VENDOR_PAUSE_MAX_EXCUSE_MS=

# governor.vendorPauseExcusePerMinute - Internal: at most this many excused tick samples per minute; above it the sample counts in full (0 = none).
# Not in the launcher. Range 0..60 (outside: clamped).
# Default: 6.
# EVEJS_LNE_GOVERNOR_VENDOR_PAUSE_EXCUSE_PER_MINUTE=

# observer.enabled - Serves a read-only page about the mod's state at http://127.0.0.1:26410/ in your
# browser. Changes nothing in the game.
# Default: 1.
# EVEJS_LNE_OBSERVER_ENABLED=

# observer.port - TCP port of the observer page. In Docker set EVEJS_LNE_OBSERVER_PORT in compose
# (it moves the port mapping and the listener together). 0 = any free port. Range 0..65535 (outside: clamped).
# Default: 26410.
# EVEJS_LNE_OBSERVER_PORT=

# observer.host - Address the observer listens on: an IP address or localhost. Not in the launcher.
# 0.0.0.0 natively exposes the page to your LAN (no login); Docker sets 0.0.0.0 in compose and
# publishes the port on 127.0.0.1 only.
# Default: 127.0.0.1.
# EVEJS_LNE_OBSERVER_HOST=

# observer.refreshSeconds - How often the observer page in the browser reloads its data. Range 1..60 (outside: clamped).
# Default: 5.
# EVEJS_LNE_OBSERVER_REFRESH_SECONDS=

# observer.journalLimit - How many of the newest journal entries the observer page lists. Range 1..200 (outside: clamped).
# Default: 50.
# EVEJS_LNE_OBSERVER_JOURNAL_LIMIT=

# observer.journalCacheMs - Internal: at most one journal read per this many ms, whatever the number of tabs.
# 0 = no cache. Not in the launcher. Range 0..60000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_OBSERVER_JOURNAL_CACHE_MS=

# observer.journalPayloadChars - Internal: characters of each journal payload shown. Not in the launcher.
# Range 0..16384 (outside: clamped).
# Default: 512.
# EVEJS_LNE_OBSERVER_JOURNAL_PAYLOAD_CHARS=

# observer.maxConnections - Internal: most open connections to the observer. Not in the launcher.
# Range 1..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_OBSERVER_MAX_CONNECTIONS=

# observer.requestTimeoutMs - Internal: request, headers, keep-alive and idle socket timeout. Not in the launcher.
# Range 1000..60000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_OBSERVER_REQUEST_TIMEOUT_MS=

# observer.maxResponseBytes - Internal: largest serialized data of one view; above it the view answers 500.
# Not in the launcher. Range 65536..8388608 (outside: clamped).
# Default: 4194304.
# EVEJS_LNE_OBSERVER_MAX_RESPONSE_BYTES=

# observer.maxStaleMs - Internal: a panel held back by server load (governor hold) whose last answer is older
# than this gets one refresh anyway (never while the governor sheds, SHED), so the panel is at most about this
# old. 0 = off (a held panel stays stale until the load drops). Not in the launcher.
# Range 0..86400000 (outside: clamped).
# Default: 300000.
# EVEJS_LNE_OBSERVER_MAX_STALE_MS=

# observer.maxForcedRefreshesPerMinute - Internal: at most this many such forced refreshes (all panels together)
# in every 60 s. 0 = off. Not in the launcher. Range 0..60 (outside: clamped).
# Default: 6.
# EVEJS_LNE_OBSERVER_MAX_FORCED_REFRESHES_PER_MINUTE=

# observer.galaxyEnabled - Shows a map of the galaxy (systems, gates, territory control) on the observer page.
# Changes nothing in the game. 0 = none of the map's views is registered.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_ENABLED=

# observer.galaxyGridSize - Internal: integer grid of the map projection (10000 = about 0.01 ly). Not in the
# launcher. Range 1000..100000 (outside: clamped).
# Default: 10000.
# EVEJS_LNE_OBSERVER_GALAXY_GRID_SIZE=

# observer.galaxyFirstBuildBypassesGovernor - Internal: the first build of the map geometry runs once even
# while the server is overloaded (governor hold), so the map shows up. 0 = it waits like every later rebuild.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_FIRST_BUILD_BYPASSES_GOVERNOR=

# observer.galaxyInfluenceTop - Internal: influence rows per system the map receives. Not in the launcher.
# Range 0..8 (outside: clamped).
# Default: 3.
# EVEJS_LNE_OBSERVER_GALAXY_INFLUENCE_TOP=

# observer.galaxyMaxLabels - Most system names the galaxy map draws at once when zoomed in.
# Range 0..2000 (outside: clamped).
# Default: 300.
# EVEJS_LNE_OBSERVER_GALAXY_MAX_LABELS=

# observer.galaxyPlayersEnabled - Marks systems with logged-in players and their character names on the
# observer map. Changes nothing in the game. 0 = the players layer is not registered.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_PLAYERS_ENABLED=

# observer.galaxyPlayersMaxNames - Most character names the galaxy map lists per system; 0 shows counts only.
# Range 0..50 (outside: clamped).
# Default: 10.
# EVEJS_LNE_OBSERVER_GALAXY_PLAYERS_MAX_NAMES=

# observer.galaxyFleetsEnabled - Internal: draws virtual fleets in flight (route + position) on the observer
# map. 0 = the fleets layer is not registered. Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_FLEETS_ENABLED=

# observer.galaxyFleetsMaxItems - Internal: most fleets the map layer lists; 0 = empty layer.
# Not in the launcher. Range 0..5000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_OBSERVER_GALAXY_FLEETS_MAX_ITEMS=

# observer.galaxyFleetsRefreshMs - Internal: the fleets layer is re-read at most once per this many ms.
# Not in the launcher. Range 1000..60000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_OBSERVER_GALAXY_FLEETS_REFRESH_MS=

# observer.galaxyParkedFleetsEnabled - Internal: draws stationary virtual fleets (idle, staged, refitting,
# engaged) as diamonds on the observer map. 0 = the layer is not registered. Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_PARKED_FLEETS_ENABLED=

# observer.galaxyParkedFleetsMaxSystems - Internal: most systems the parked fleets layer marks; 0 = empty layer.
# Not in the launcher. Range 0..5485 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_OBSERVER_GALAXY_PARKED_FLEETS_MAX_SYSTEMS=

# observer.galaxyParkedFleetsMaxLines - Internal: fleet lines per system tooltip of the parked fleets layer.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 8.
# EVEJS_LNE_OBSERVER_GALAXY_PARKED_FLEETS_MAX_LINES=

# observer.galaxyParkedFleetsRefreshMs - Internal: the parked fleets layer is re-read at most once per this
# many ms. Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_OBSERVER_GALAXY_PARKED_FLEETS_REFRESH_MS=

# observer.galaxyWrecksEnabled - Internal: draws wreck fields as triangles on the observer map. 0 = the layer is not
# registered.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_WRECKS_ENABLED=

# observer.galaxyWrecksMaxSystems - Internal: most systems the wreck fields layer marks; 0 = empty layer.
# Not in the launcher. Range 0..5485 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_OBSERVER_GALAXY_WRECKS_MAX_SYSTEMS=

# observer.galaxyWrecksMaxLines - Internal: wreck field lines per system tooltip.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 6.
# EVEJS_LNE_OBSERVER_GALAXY_WRECKS_MAX_LINES=

# observer.galaxyWrecksRefreshMs - Internal: the wreck fields layer is re-read at most once per this many ms.
# Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_OBSERVER_GALAXY_WRECKS_REFRESH_MS=

# observer.galaxyWrecksTierMediumUnits - Internal: effective pool (units) from which a wreck mark is medium.
# Not in the launcher. Range 1..1000000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_OBSERVER_GALAXY_WRECKS_TIER_MEDIUM_UNITS=

# observer.galaxyWrecksTierLargeUnits - Internal: effective pool (units) from which a wreck mark is large (must be above
# medium, else swapped with a warning).
# Not in the launcher. Range 1..10000000 (outside: clamped).
# Default: 400.
# EVEJS_LNE_OBSERVER_GALAXY_WRECKS_TIER_LARGE_UNITS=

# observer.galaxyEventsEnabled - Internal: draws open Event Director events as rings on the observer map (style by
# state: planned, active, completing). 0 = the layer is not registered (needs the events module).
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_EVENTS_ENABLED=

# observer.galaxyEventsMaxSystems - Internal: most systems the events layer marks; 0 = empty layer.
# Not in the launcher. Range 0..1024 (outside: clamped).
# Default: 128.
# EVEJS_LNE_OBSERVER_GALAXY_EVENTS_MAX_SYSTEMS=

# observer.galaxyEventsRefreshMs - Internal: the events layer is re-read at most once per this many ms (and once
# after each events pulse).
# Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 30000.
# EVEJS_LNE_OBSERVER_GALAXY_EVENTS_REFRESH_MS=

# observer.productionMaxActiveJobs - Internal: ACTIVE jobs read by the production panel (response size).
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_OBSERVER_PRODUCTION_MAX_ACTIVE_JOBS=

# observer.productionRefreshMs - Internal: time bucket of the production panel cache; the window of the last 24 h
# moves at least this often.
# Not in the launcher. Range 1000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_OBSERVER_PRODUCTION_REFRESH_MS=

# observer.galaxyBattlesOpenEnabled - Internal: draws battles in progress as a two-colour "versus" mark (left =
# attacker side A, right = defender side B) on the observer map. 0 = the layer is not registered. Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_BATTLES_OPEN_ENABLED=

# observer.galaxyBattlesOpenMaxBattles - Internal: most open battles the battles-in-progress layer reads; 0 = empty
# layer.
# Not in the launcher. Range 0..5000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_OBSERVER_GALAXY_BATTLES_OPEN_MAX_BATTLES=

# observer.galaxyBattlesOpenMaxLines - Internal: battle lines per system tooltip of the battles-in-progress layer.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 6.
# EVEJS_LNE_OBSERVER_GALAXY_BATTLES_OPEN_MAX_LINES=

# observer.galaxyBattlesOpenRefreshMs - Internal: the battles-in-progress layer is re-read at most once per this many
# ms. Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_OBSERVER_GALAXY_BATTLES_OPEN_REFRESH_MS=

# observer.galaxyStationsEnabled - Internal: draws faction stations as squares under the systems of the observer map. 0 =
# the layer is not registered.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_STATIONS_ENABLED=

# observer.galaxyStationsMaxSystems - Internal: most systems the stations layer marks; 0 = empty layer.
# Not in the launcher. Range 0..5000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_OBSERVER_GALAXY_STATIONS_MAX_SYSTEMS=

# observer.galaxyStationsMaxLines - Internal: station lines per system tooltip.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 6.
# EVEJS_LNE_OBSERVER_GALAXY_STATIONS_MAX_LINES=

# observer.galaxyStationsRefreshMs - Internal: the stations layer is re-read at most once per this many ms.
# Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_OBSERVER_GALAXY_STATIONS_REFRESH_MS=

# observer.galaxyCapsuleersEnabled - Internal: draws free pilots (capsuleer corporations of the mod) as dots at the
# systems of the observer map. 0 = the layer is not registered.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_CAPSULEERS_ENABLED=

# observer.galaxyCapsuleersMaxFleets - Internal: most capsuleer fleets the free pilots layer reads; 0 = empty layer.
# Not in the launcher. Range 0..1024 (outside: clamped).
# Default: 256.
# EVEJS_LNE_OBSERVER_GALAXY_CAPSULEERS_MAX_FLEETS=

# observer.galaxyCapsuleersMaxLines - Internal: fleet lines per system tooltip of the free pilots layer.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 6.
# EVEJS_LNE_OBSERVER_GALAXY_CAPSULEERS_MAX_LINES=

# observer.galaxyCapsuleersRefreshMs - Internal: the free pilots layer is re-read at most once per this many ms.
# Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_OBSERVER_GALAXY_CAPSULEERS_REFRESH_MS=

# observer.galaxyCapsuleersCiviliansEnabled - Internal: adds the highsec civilians (Local of systems with a player) to
# the free pilots layer. 0 = the layer without civilians.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_CAPSULEERS_CIVILIANS_ENABLED=

# observer.galaxyCapsuleersCivilianNames - Internal: civilian names per system tooltip of the free pilots layer;
# 0 = the count only.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 5.
# EVEJS_LNE_OBSERVER_GALAXY_CAPSULEERS_CIVILIAN_NAMES=

# observer.stationsPanelMaxRows - Internal: station rows of the observer panel Faction stations.
# Not in the launcher. Range 1..2000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_OBSERVER_STATIONS_PANEL_MAX_ROWS=

# observer.stationsPanelStockLines - Internal: largest stock items per station in that panel; 0 = totals only.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 5.
# EVEJS_LNE_OBSERVER_STATIONS_PANEL_STOCK_LINES=

# observer.sentriesMaxRows - Internal: sentry: sentry rows of the panel sentries (each row = vendor reads of HP and ammo).
# Not in the launcher. Range 10..2000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_OBSERVER_SENTRIES_MAX_ROWS=

# siege visibility on galaxy map (layer-sieges) and panel (sieges).
# observer.galaxySiegesEnabled - Internal: draws open sieges as versus shapes under the systems of the observer map. 0 =
# the layer is not registered.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_SIEGES_ENABLED=

# observer.galaxySiegesMaxSystems - Internal: most systems the sieges layer marks; 0 = empty layer.
# Not in the launcher. Range 0..5000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_OBSERVER_GALAXY_SIEGES_MAX_SYSTEMS=

# observer.galaxySiegesRefreshMs - Internal: the sieges layer is re-read at most once per this many ms.
# Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_OBSERVER_GALAXY_SIEGES_REFRESH_MS=

# observer.siegesPanelMaxRows - Internal: open sieges rows of the observer panel Sieges (response size).
# Not in the launcher. Range 1..2000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_OBSERVER_SIEGES_PANEL_MAX_ROWS=

# observer.galaxyInvasionsEnabled - Internal: draws open invasions as hexagons on the observer map. 0 = the layer is not registered.
# Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_INVASIONS_ENABLED=

# observer.galaxyInvasionsMaxSystems - Internal: most systems the invasions layer marks; 0 = empty layer.
# Not in the launcher. Range 0..5000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_OBSERVER_GALAXY_INVASIONS_MAX_SYSTEMS=

# observer.galaxyInvasionsMaxLines - Internal: mark lines per system tooltip of the invasions layer; 0 = header only.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 6.
# EVEJS_LNE_OBSERVER_GALAXY_INVASIONS_MAX_LINES=

# observer.galaxyInvasionsRefreshMs - Internal: the invasions layer is re-read at most once per this many ms.
# Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_OBSERVER_GALAXY_INVASIONS_REFRESH_MS=

# observer.invasionsPanelMaxRows - Internal: open invasions rows of the observer panel Invasions (response size).
# Not in the launcher. Range 1..2000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_OBSERVER_INVASIONS_PANEL_MAX_ROWS=

# observer.constructionPanelMaxRows - Internal: open builds of the panel construction (response size).
# Not in the launcher. Range 1..2000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_OBSERVER_CONSTRUCTION_PANEL_MAX_ROWS=

# observer.salvagePanelMaxRows - Internal: live anomalies of the panel salvage (response size); 0 = no panel.
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 50.
# EVEJS_LNE_OBSERVER_SALVAGE_PANEL_MAX_ROWS=

# observer.occupationPanelMaxRows - Internal: rows of the panel occupation (systems not STABLE, response size).
# Not in the launcher. Range 1..2000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_OBSERVER_OCCUPATION_PANEL_MAX_ROWS=

# observer.fleetsPanelRows - Internal: fleets in flight listed by the panel "Fleets & operations"; 0 = no panel.
# Not in the launcher. Range 0..200 (outside: clamped).
# Default: 20.
# EVEJS_LNE_OBSERVER_FLEETS_PANEL_ROWS=

# observer.factionActivityEnabled - Internal: panel "Aktywnosc frakcji" (verdict, now, plans per active
# faction). 0 = the view is not registered. Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_FACTION_ACTIVITY_ENABLED=

# observer.factionActivityMaxItems - Internal: list items per section of the panel activity; 0 = counts only.
# Not in the launcher. Range 0..50 (outside: clamped).
# Default: 5.
# EVEJS_LNE_OBSERVER_FACTION_ACTIVITY_MAX_ITEMS=

# observer.factionActivityStaleFactor - Internal: a faction review older than strategy.reviewIntervalMs x this
# factor shows as stale. Not in the launcher. Range 2..48 (outside: clamped).
# Default: 3.
# EVEJS_LNE_OBSERVER_FACTION_ACTIVITY_STALE_FACTOR=

# observer.factionActivityRefreshMs - Internal: the panel activity is re-read at most once per this many ms.
# Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_OBSERVER_FACTION_ACTIVITY_REFRESH_MS=

# observer.factionActivityOffensiveStallMs - Internal: an offensive faction (empire, pirate, invader, neutral
# with invasion in the doctrine) without an open invasion/recon/raid, own claim or capture for this many ms shows
# NO_OFFENSIVE ("NO OFFENSIVE") in the panel activity. View only. 0 = off. Not in the launcher.
# Range 0..2592000000 (outside: clamped).
# Default: 259200000.
# EVEJS_LNE_OBSERVER_FACTION_ACTIVITY_OFFENSIVE_STALL_MS=

# observer.factionActivityMaxCapturedRows - Internal: captured systems read per faction for the last capture
# of the panel activity; more = no NO_OFFENSIVE verdict (fail-safe). Not in the launcher.
# Range 64..8192 (outside: clamped).
# Default: 1024.
# EVEJS_LNE_OBSERVER_FACTION_ACTIVITY_MAX_CAPTURED_ROWS=

# observer.factionActivityMaxOffensiveScanRows - Internal: open operations (PLANNED, ACTIVE) scanned per faction for
# an invasion/recon/raid, independent of factionActivityMaxItems; the limit reached without one = no NO_OFFENSIVE
# verdict (fail-safe). Not in the launcher. Range 64..8192 (outside: clamped).
# Default: 1024.
# EVEJS_LNE_OBSERVER_FACTION_ACTIVITY_MAX_OFFENSIVE_SCAN_ROWS=

# layer-territory of the galaxy map (faction areas as polygons, raster Voronoi clipped by a radius).
# observer.galaxyTerritoryEnabled - Internal: 0 = the view layer-territory is not registered. Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_ENABLED=

# observer.galaxyTerritoryCellSize - Internal: side of a raster cell in map grid units.
# Not in the launcher. Range 5..10000 (outside: clamped).
# Default: 40.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_CELL_SIZE=

# observer.galaxyTerritoryRadius - Internal: blob radius of a system (map grid units, at least one cell).
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 150.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_RADIUS=

# observer.galaxyTerritoryMaxCells - Internal: most raster cells (incl. the radius margin); a larger map grows the cell.
# Not in the launcher. Range 1000..4000000 (outside: clamped).
# Default: 250000.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_MAX_CELLS=

# observer.galaxyTerritoryMaxStampOps - Internal: most cells visited when stamping the systems (about
# systems x (2 x radius / cell)^2); over it the cell doubles, so a large radius cannot stall the server thread.
# Not in the launcher. Range 100000..100000000 (outside: clamped).
# Default: 4000000.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_MAX_STAMP_OPS=

# observer.galaxyTerritoryMaxPoints - Internal: most polygon points of the whole layer (response size).
# Not in the launcher. Range 100..500000 (outside: clamped).
# Default: 30000.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_MAX_POINTS=

# observer.galaxyTerritoryMaxCoarsenSteps - Internal: how many times the cell doubles before the layer gives up.
# Not in the launcher. Range 0..6 (outside: clamped).
# Default: 2.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_MAX_COARSEN_STEPS=

# observer.galaxyTerritorySimplifyPercent - Internal: outline simplification in percent of a cell; 0 = none.
# Not in the launcher. Range 0..200 (outside: clamped).
# Default: 50.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_SIMPLIFY_PERCENT=

# observer.galaxyTerritoryProjectEmpireSpace - Internal: 1 = also areas of empire space without world rows (SDE
# faction, dashed outline). Not in the launcher.
# Default: 0.
# EVEJS_LNE_OBSERVER_GALAXY_TERRITORY_PROJECT_EMPIRE_SPACE=

# layer-sov-projection of the galaxy map (sovereignty projection areas as disks).
# observer.galaxySovProjectionEnabled - Internal: 0 = the view layer-sov-projection is not registered. Not in the launcher.
# Default: 1.
# EVEJS_LNE_OBSERVER_SOV_PROJECTION_ENABLED=

# observer.galaxySovProjectionMaxSystems - Internal: most systems the sov projection layer marks; 0 = empty layer.
# Not in the launcher. Range 0..5485 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_OBSERVER_SOV_PROJECTION_MAX_SYSTEMS=

# observer.galaxySovProjectionRefreshMs - Internal: the sov projection layer is re-read at most once per this many ms.
# Not in the launcher. Range 1000..300000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_OBSERVER_SOV_PROJECTION_REFRESH_MS=

# testing.timeScale - Tests only: speeds up the mod's virtual time (1 = real time, up to 100).
# Any value other than 1 prints a warning at startup. Never set it for normal play. Range 1..100 (outside: ignored).
# Default: 1.
# EVEJS_LNE_TEST_TIME_SCALE=

# testing.accelerationEnabled - Tests only: lets testing.timeScale speed up unobserved virtual travel.
# Off = timeScale is ignored. Never set it for normal play. Not in the launcher.
# Default: 0.
# EVEJS_LNE_TEST_ACCELERATION=

# testing.benchFleets - Tests only: number of test fleets roaming nullsec (benchmark traffic). Works only
# with persistence.dbFile other than world.sqlite (else refused). Not in the launcher. Range 0..5000 (clamped).
# Default: 0.
# EVEJS_LNE_TEST_BENCH_FLEETS=

# testing.benchDwellMs - Tests only: mean stop of a test fleet between two trips (ms). Range 10000..86400000.
# Default: 300000.
# EVEJS_LNE_TEST_BENCH_DWELL_MS=

# testing.benchRoamMaxJumps - Tests only: most jumps of one trip of a test fleet. Range 1..40.
# Default: 5.
# EVEJS_LNE_TEST_BENCH_ROAM_MAX_JUMPS=

# testing.benchSeedBatchRows - Tests only: test fleets seeded per slice, the loop is given back between slices.
# Range 1..10000.
# Default: 100.
# EVEJS_LNE_TEST_BENCH_SEED_BATCH_ROWS=

# testing.battleDemo - Tests only: the M4 gate demo - two hostile virtual fleets in a remote nullsec system, one battle.
# Works only with persistence.dbFile other than world.sqlite (else refused).
# Not in the launcher.
# Default: 0.
# EVEJS_LNE_TEST_BATTLE_DEMO=

# testing.battleDemoDelayMs - Tests only: delay (ms) of the demo contact after the start (window for a restart).
# Not in the launcher. Range 10000..3600000.
# Default: 120000.
# EVEJS_LNE_TEST_BATTLE_DEMO_DELAY_MS=

# testing.battleDemoSystemId - Tests only: system of the demo; 0 = the lowest unobserved nullsec system.
# Not in the launcher. Range 0..99999999.
# Default: 0.
# EVEJS_LNE_TEST_BATTLE_DEMO_SYSTEM_ID=

# testing.battleDemoShipMultiplier - Tests only: every ship count of the demo fleets x m (13/26/39 ships).
# Another value on the same database is refused (same keys) - use a fresh bench database.
# Not in the launcher. Range 1..3.
# Default: 1.
# EVEJS_LNE_TEST_BATTLE_DEMO_SHIP_MULTIPLIER=

# logistics.enabled - Internal: switch of the logistics service and the CONVOY_DISPATCH intents (with modules.strategy); off = open convoys frozen with their cargo in the row, reconcile after switching on
# Not in the launcher.
# Default: true.
# EVEJS_LNE_LOGISTICS_ENABLED=

# logistics.maxFleetsPerFaction - Internal: live logistics fleets per faction (outside strategy.maxFleetsPerFaction)
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 4.
# EVEJS_LNE_LOGISTICS_MAX_FLEETS_PER_FACTION=

# logistics.maxOpenConvoysPerFaction - Internal: open convoys of one faction
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 6.
# EVEJS_LNE_LOGISTICS_MAX_OPEN_CONVOYS_PER_FACTION=

# logistics.maxDispatchesPerReview - Internal: CONVOY_DISPATCH intents of one strategy review
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_LOGISTICS_MAX_DISPATCHES_PER_REVIEW=

# The tribute plan is never starved by the room.
# logistics.tributeReserveSlot - Internal: with a due tribute plan in the review the earlier plans use at most maxDispatchesPerReview - 1 dispatches (one kept for the tribute); off = the tribute takes what is left
# Not in the launcher.
# Default: true.
# EVEJS_LNE_LOGISTICS_TRIBUTE_RESERVE_SLOT=

# logistics.maxHullConvoysPerReview - Internal (Plaster 2): HULLS_TO_MOBILIZATION convoys from production stations to mobilization per review
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 8.
# EVEJS_LNE_LOGISTICS_MAX_HULL_CONVOYS_PER_REVIEW=

# Plaster 3: mineral convoys to stations without raw materials.
# logistics.mineralSurplusThreshold - Internal (Plaster 3): surplus mineral units a source station must have to send a MINERALS_TO_FACTORY convoy
# Not in the launcher. Range 0..100000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_LOGISTICS_MINERAL_SURPLUS_THRESHOLD=

# logistics.maxMineralConvoysPerReview - Internal (Plaster 3): MINERALS_TO_FACTORY convoys per strategy review
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 4.
# EVEJS_LNE_LOGISTICS_MAX_MINERAL_CONVOYS_PER_REVIEW=

# logistics.mineralConvoyMinLoad - Internal (Plaster 3): minimum mineral units in a MINERALS_TO_FACTORY convoy (below = skipped)
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_LOGISTICS_MINERAL_CONVOY_MIN_LOAD=

# logistics.maxMobilizationsPerReview - Internal: mobilizations of a logistics fleet per strategy review
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_LOGISTICS_MAX_MOBILIZATIONS_PER_REVIEW=

# logistics.carrierCapacityM3 - Internal: cargo of one industrial in m3 (hypothesis)
# Not in the launcher. Range 1..10000000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_LOGISTICS_CARRIER_CAPACITY_M3=

# logistics.maxCargoItems - Internal: items of one convoy cargo
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 12.
# EVEJS_LNE_LOGISTICS_MAX_CARGO_ITEMS=

# logistics.minLoadVolume - Internal: smallest cargo the AI ships (units of 0.01 m3, 100000 = 1000 m3)
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 100000.
# EVEJS_LNE_LOGISTICS_MIN_LOAD_VOLUME=

# logistics.factoryRunsTarget - Internal: runs of the group with the largest deficit the AI keeps affordable in the mobilization station
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 2.
# EVEJS_LNE_LOGISTICS_FACTORY_RUNS_TARGET=

# logistics.maxConvoyJumps - Internal: reach logistics fleet -> source station (jumps)
# Not in the launcher. Range 1..40 (outside: clamped).
# Default: 20.
# EVEJS_LNE_LOGISTICS_MAX_CONVOY_JUMPS=

# logistics.capitalCargoPermille - Internal: cargo of a freighter / jump freighter = industry catalogue cargoMedianM3 x this / 1000 (SDE median x skills / expanders)
# Not in the launcher. Range 100..10000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_LOGISTICS_CAPITAL_CARGO_PERMILLE=

# logistics.freighterTargetPerFaction - Internal: freighters a faction keeps (stock + logistics fleets + jobs); planIndustry orders the missing ones
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_LOGISTICS_FREIGHTER_TARGET_PER_FACTION=

# logistics.jumpFreighterTargetPerFaction - Internal: jump freighters a faction keeps, ordered after the freighter target is met
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_LOGISTICS_JUMP_FREIGHTER_TARGET_PER_FACTION=

# logistics.jumpFreighterReachJumps - Internal: reach logistics fleet with a jump freighter -> source station (gate jumps, v1 without cyno)
# Not in the launcher. Range 1..150 (outside: clamped).
# Default: 40.
# EVEJS_LNE_LOGISTICS_JUMP_FREIGHTER_REACH_JUMPS=

# logistics.needsHulls - Internal: a logistics mobilization takes hulls (false = no deadlock: a convoy needed to build a convoy)
# Not in the launcher.
# Default: false.
# EVEJS_LNE_LOGISTICS_NEEDS_HULLS=

# logistics.watchGraceMs - Internal: deadline after the planned arrival of a leg
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 900000.
# EVEJS_LNE_LOGISTICS_WATCH_GRACE_MS=

# logistics.watchRecheckMs - Internal: next deadline of a waiting convoy
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_LOGISTICS_WATCH_RECHECK_MS=

# logistics.maxWatchRounds - Internal: waits / new searches of a convoy before TIMEOUT
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 12.
# EVEJS_LNE_LOGISTICS_MAX_WATCH_ROUNDS=

# logistics.convoyRetentionMs - Internal: ended convoys kept (panel 24 h, totals survive the prune)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 604800000.
# EVEJS_LNE_LOGISTICS_CONVOY_RETENTION_MS=

# logistics.pruneBatch - Internal: ended convoys pruned per dispatch
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_LOGISTICS_PRUNE_BATCH=

# logistics.reconcileMaxConvoys - Internal: open convoys (and staged logistics fleets) checked by the reconcile after a start
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_LOGISTICS_RECONCILE_MAX_CONVOYS=

# logistics.reconcileMaxAttempts - Internal: suffixed reconcile keys tried per convoy
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_LOGISTICS_RECONCILE_MAX_ATTEMPTS=

# logistics.maxStepsPerPass - Internal: maxPerPass of the CONVOY_DELIVERY handler
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 20.
# EVEJS_LNE_LOGISTICS_MAX_STEPS_PER_PASS=

# logistics.replenishEnabled - Internal: REPLENISH intents (hulls of the station pool into an IDLE fleet after its repair); off = none
# Not in the launcher.
# Default: true.
# EVEJS_LNE_LOGISTICS_REPLENISH_ENABLED=

# logistics.maxReplenishPerReview - Internal: REPLENISH intents of one strategy review
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_LOGISTICS_MAX_REPLENISH_PER_REVIEW=

# logistics.frontStationMaxJumps - Internal: the front station of HULLS_TO_FRONT is at most this far from a front target (jumps)
# Not in the launcher. Range 0..40 (outside: clamped).
# Default: 6.
# EVEJS_LNE_LOGISTICS_FRONT_STATION_MAX_JUMPS=

# logistics.replenishFreeHullsEnabled - Internal: a fleet whose role needs no hulls (doctrine hullsRequired false, CONCORD) is replenished in the system of an own station without the station stock (the faction cost as usual); off = stock only
# Not in the launcher.
# Default: false.
# EVEJS_LNE_LOGISTICS_REPLENISH_FREE_HULLS_ENABLED=

# logistics.replenishReturnEnabled - Internal: an idle combat fleet with a large deficit flies (LAUNCH return) to an own station with the hulls of its groups, REPLENISH after the arrival; off = none
# Not in the launcher.
# Default: false.
# EVEJS_LNE_LOGISTICS_REPLENISH_RETURN_ENABLED=

# logistics.replenishReturnMaxJumps - Internal: BFS depth from the fleet of the station search (= strategy.maxAssemblyJumps)
# Not in the launcher. Range 1..40 (outside: clamped).
# Default: 15.
# EVEJS_LNE_LOGISTICS_REPLENISH_RETURN_MAX_JUMPS=

# logistics.replenishReturnMinMissingPermille - Internal: minimal deficit of the fleet against the template of its role (permille)
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_LOGISTICS_REPLENISH_RETURN_MIN_MISSING_PERMILLE=

# logistics.maxReplenishReturnsPerReview - Internal: LAUNCH return for hulls of one strategy review
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_LOGISTICS_MAX_REPLENISH_RETURNS_PER_REVIEW=

# logistics.replenishReturnMaxSearchesPerReview - Internal: BFS of candidates of one faction review
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 6.
# EVEJS_LNE_LOGISTICS_REPLENISH_RETURN_MAX_SEARCHES_PER_REVIEW=

# logistics.retireEnabled - Internal: a logistics fleet whose carriers all died returns to an own station and is disbanded (no base in strategy.maxAssemblyJumps: disbanded in place); off = such fleets stay (the behaviour before)
# Not in the launcher.
# Default: true.
# EVEJS_LNE_LOGISTICS_RETIRE_ENABLED=

# logistics.maxRetiresPerReview - Internal: LAUNCH return + DISBAND intents of logistics fleets without carriers in one strategy review
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_LOGISTICS_MAX_RETIRES_PER_REVIEW=

# logistics.strandedReturnEnabled - Internal: (tribute-c): an IDLE logistics fleet with carriers whose nearest own station is beyond its reach (maxConvoyJumps / jump freighter reach) returns to that station (shares logistics.maxRetiresPerReview); off = such fleets stay
# Not in the launcher.
# Default: true.
# EVEJS_LNE_LOGISTICS_STRANDED_RETURN_ENABLED=

# logistics.strandedReturnMaxJumps - Internal: (tribute-c): BFS depth of the search for the nearest own station of a stranded logistics fleet (at least its reach; gate jumps)
# Not in the launcher. Range 1..150 (outside: clamped).
# Default: 40.
# EVEJS_LNE_LOGISTICS_STRANDED_RETURN_MAX_JUMPS=

# logistics.strandedFromStationsEnabled - Internal: (tribute-c): a logistics fleet in jump reach of its nearest station is stranded too when the planner BFS (strategy.maxBfsSystems) of no own station in its reach sees it; off = the criterion
# Not in the launcher.
# Default: true.
# EVEJS_LNE_LOGISTICS_STRANDED_FROM_STATIONS_ENABLED=

# logistics.strandedMaxStationBfs - Internal: (tribute-c): at most this many BFS from stations per review when judging stranded logistics; beyond it the criterion and note LOGISTICS_STRANDED_BFS_LIMIT
# Not in the launcher. Range 1..32 (outside: clamped).
# Default: 4.
# EVEJS_LNE_LOGISTICS_STRANDED_MAX_STATION_BFS=

# logistics.convoysEnabled - Internal: false = strategy review without logistics (no CONVOY_DISPATCH and no logistics MOBILIZE), open convoys finish their route, REPLENISH unchanged - the behaviour before
# Not in the launcher.
# Default: true.
# EVEJS_LNE_LOGISTICS_CONVOYS_ENABLED=

# tribute.enabled - Internal: switch of the tribute plans of the strategy review; off = no tribute plan, open TRIBUTE convoys finish their route (receiver from the registry). compose.yaml passes 0 unless the root.env sets it.
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRIBUTE_ENABLED=

# tribute.ratePermille - Internal: permille of the mineral surplus above the reserve paid per period (0 = no tribute)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_TRIBUTE_RATE_PERMILLE=

# tribute.periodMs - Internal: the tribute period (bucket of the period marker tribute:<faction>:<bucket>)
# Not in the launcher. Range 3600000..604800000 (outside: clamped).
# Default: 86400000.
# EVEJS_LNE_TRIBUTE_PERIOD_MS=

# tribute.reserveRuns - Internal: reserve per station and mineral = runs of the most expensive recipe of the target hull groups
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 8.
# EVEJS_LNE_TRIBUTE_RESERVE_RUNS=

# tribute.minLoadVolume - Internal: smallest tribute cargo (units of 0.01 m3, as logistics.minLoadVolume)
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 100000.
# EVEJS_LNE_TRIBUTE_MIN_LOAD_VOLUME=

# tribute.recipientMaxMineralUnits - Internal: 0 = no ceiling; > 0 = no tribute while the stations of the receiver hold >= this many minerals
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_TRIBUTE_RECIPIENT_MAX_MINERAL_UNITS=

# tribute.recipientBuildsHulls - Internal: true = with tribute on the receiver requires hulls (changes the CONCORD strength, experiment only)
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRIBUTE_RECIPIENT_BUILDS_HULLS=

# tribute.maxRecipientStations - Internal: stations of the receiver read in the review snapshot
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRIBUTE_MAX_RECIPIENT_STATIONS=

# the NPC mineral swap of the strategy review (internal).
# mineralSwap.enabled - Internal: NPC mineral swap of the review (surplus -> binding mineral of a blocked group); off = no intent. compose.yaml passes 0 unless the root.env sets it.
# Not in the launcher.
# Default: false.
# EVEJS_LNE_MINERAL_SWAP_ENABLED=

# mineralSwap.maxPerReview - Internal: MINERAL_SWAP intents of one review (each takes a PRODUCE slot of production.maxJobsPerReview).
# Not in the launcher. Range 0..4 (outside: clamped).
# Default: 1.
# EVEJS_LNE_MINERAL_SWAP_MAX_PER_REVIEW=

# mineralSwap.spreadPermille - Internal: discount from the reference price ratio (REF_PRICE_MILLI) the swap loses.
# Not in the launcher. Range 0..900 (outside: clamped).
# Default: 200.
# EVEJS_LNE_MINERAL_SWAP_SPREAD_PERMILLE=

# mineralSwap.sourceKeepPermille - Internal: share of the source surplus (stock minus one run) that stays on the station.
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_MINERAL_SWAP_SOURCE_KEEP_PERMILLE=

# mineralSwap.minSourceUnits - Internal: smallest station stock of a source mineral.
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 20000000 (was 1000000000; compose.yaml passes it empty = this default; rollback = 1000000000).
# EVEJS_LNE_MINERAL_SWAP_MIN_SOURCE_UNITS=

# mineralSwap.maxIskPerReview - Internal: ISK value (reference price) of the taken minerals per review.
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 2000000000.
# EVEJS_LNE_MINERAL_SWAP_MAX_ISK_PER_REVIEW=

# The faction ISK treasury (internal, never in the launcher).
# treasury.enabled - Internal: switch of the faction ISK treasury (with modules.strategy); off = no TREASURY intent, UPKEEP funds the trade budget from units, treasury rows frozen; default on
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TREASURY_ENABLED=

# treasury.periodMs - Internal: the period of the treasury income and fleet upkeep
# Not in the launcher. Range 600000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_TREASURY_PERIOD_MS=

# treasury.maxCatchUpPeriods - Internal: periods charged after a downtime, the rest forgiven (income and costs)
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 48.
# EVEJS_LNE_TREASURY_MAX_CATCH_UP_PERIODS=

# treasury.initialIskEmpire - Internal: seed of an empire treasury (x strategy.budgetFactor)
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 5000000000000.
# EVEJS_LNE_TREASURY_INITIAL_ISK_EMPIRE=

# treasury.initialIskPolice - Internal: seed of a police treasury (x strategy.budgetFactor)
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 3000000000000.
# EVEJS_LNE_TREASURY_INITIAL_ISK_POLICE=

# treasury.initialIskPirate - Internal: seed of a pirate treasury (x strategy.budgetFactor)
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 1000000000000.
# EVEJS_LNE_TREASURY_INITIAL_ISK_PIRATE=

# treasury.initialIskInvader - Internal: seed of an invader treasury (x strategy.budgetFactor)
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 500000000000.
# EVEJS_LNE_TREASURY_INITIAL_ISK_INVADER=

# treasury.initialIskNeutral - Internal: seed of a neutral treasury (x strategy.budgetFactor): pirate parity (the only active neutral is SoE)
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 1000000000000.
# EVEJS_LNE_TREASURY_INITIAL_ISK_NEUTRAL=

# treasury.baseIncomeIskPerDayEmpire - Internal: unconditional income of an empire per day
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 8000000000.
# EVEJS_LNE_TREASURY_BASE_INCOME_ISK_PER_DAY_EMPIRE=

# treasury.baseIncomeIskPerDayPolice - Internal: unconditional income of a police faction per day
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 4000000000.
# EVEJS_LNE_TREASURY_BASE_INCOME_ISK_PER_DAY_POLICE=

# treasury.baseIncomeIskPerDayPirate - Internal: unconditional income of a pirate faction per day
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 2000000000.
# EVEJS_LNE_TREASURY_BASE_INCOME_ISK_PER_DAY_PIRATE=

# treasury.baseIncomeIskPerDayInvader - Internal: unconditional income of an invader per day
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 1000000000.
# EVEJS_LNE_TREASURY_BASE_INCOME_ISK_PER_DAY_INVADER=

# treasury.baseIncomeIskPerDayNeutral - Internal: unconditional income of a neutral faction per day: pirate parity (the only active neutral is SoE)
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 2000000000.
# EVEJS_LNE_TREASURY_BASE_INCOME_ISK_PER_DAY_NEUTRAL=

# treasury.incomeIskPerSystemPerDay - Internal: income per controlled system per day (countControlledByFaction)
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 200000000.
# EVEJS_LNE_TREASURY_INCOME_ISK_PER_SYSTEM_PER_DAY=

# treasury.incomeIskPerStationPerDay - Internal: income per own ONLINE station per day
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 500000000.
# EVEJS_LNE_TREASURY_INCOME_ISK_PER_STATION_PER_DAY=

# treasury.fleetUpkeepPermillePerDay - Internal: fleet upkeep per day in permille of the hull value of the live fleets
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_TREASURY_FLEET_UPKEEP_PERMILLE_PER_DAY=

# treasury.tradeBudgetTargetIsk - Internal: level of the trade budget (available + reserved) the treasury tops up to
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 10000000000.
# EVEJS_LNE_TREASURY_TRADE_BUDGET_TARGET_ISK=

# treasury.tradeTransferMaxIskPerDay - Internal: transfer treasury -> trade budget per faction per day (UTC day of the world time)
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 10000000000.
# EVEJS_LNE_TREASURY_TRADE_TRANSFER_MAX_ISK_PER_DAY=

# treasury.tradeTransferMaxIskPerDayGalaxy - Internal: transfer treasury -> trade budget of all factions per day (bound of the payouts to players)
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 100000000000.
# EVEJS_LNE_TREASURY_TRADE_TRANSFER_MAX_ISK_PER_DAY_GALAXY=

# treasury.dayRetentionDays - Internal: days of the treasury day ledger kept (min 8: the panel reads 7 full days)
# Not in the launcher. Range 8..365 (outside: clamped).
# Default: 30.
# EVEJS_LNE_TREASURY_DAY_RETENTION_DAYS=

# treasury.pruneBatch - Internal: day rows deleted per TREASURY intent
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_TREASURY_PRUNE_BATCH=

# treasury.productionFeePermille - Internal: production fee per run in permille of the hull value (installation, wages, components)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_TREASURY_PRODUCTION_FEE_PERMILLE=

# treasury.austerityEnterPermille - Internal: AUSTERITY when the balance after the settlement is below this permille of the initial ISK
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_TREASURY_AUSTERITY_ENTER_PERMILLE=

# treasury.austerityExitPermille - Internal: back to NORMAL when the balance after the settlement is at least this permille of the initial ISK (at least the enter threshold)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_TREASURY_AUSTERITY_EXIT_PERMILLE=

# treasury.austerityJobsPermille - Internal: production and industry jobs per review in AUSTERITY, permille of the limits (min 1)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_TREASURY_AUSTERITY_JOBS_PERMILLE=

# treasury.minJobsWhenBroke - Internal: production jobs per review without the ISK for their fee (anti death spiral, the fee goes to unpaid)
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 1.
# EVEJS_LNE_TREASURY_MIN_JOBS_WHEN_BROKE=

# Battle losses cost the faction ISK (settlement consequence treasury).
# treasury.lossesEnabled - Internal: the settlement consequence treasury (with treasury.enabled and modules.strategy); off = no consequence entry, battle losses cost no ISK; a change needs a restart
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TREASURY_LOSSES_ENABLED=

# treasury.fitValuePermille - Internal: ISK of the fit, ammunition, crew and insurance per lost hull in permille of the hull value (the debit; the loss value of the panel = hull + fit)
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_TREASURY_FIT_VALUE_PERMILLE=

# ISK as a flow budget of the war (admin of captured systems, war room of the day).
# treasury.pressureEnabled - Internal: the ISK pressure: the treasury charges the administration of captured systems and books the war spend (with treasury.enabled and modules.strategy); off = the plan and the settlement of before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TREASURY_PRESSURE_ENABLED=

# treasury.adminIskPerCapturedSystemPerDay - Internal: linear administration cost per captured system per day (a in a x c + floor(a x c^2 / S))
# Not in the launcher. Range 0..100000000000 (outside: clamped).
# Default: 100000000.
# EVEJS_LNE_TREASURY_ADMIN_ISK_PER_CAPTURED_SYSTEM_PER_DAY=

# treasury.adminSprawlSystems - Internal: sprawl scale S of the administration cost (0 = linear only)
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_TREASURY_ADMIN_SPRAWL_SYSTEMS=

# treasury.savingsDrawPermillePerDay - Internal: permille of the balance the war budget of a day may draw from the savings
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 3.
# EVEJS_LNE_TREASURY_SAVINGS_DRAW_PERMILLE_PER_DAY=

# treasury.captureLaunchIsk - Internal: ISK of one capture LAUNCH (not the recovery of a home system; read by the AI from)
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 1000000000.
# EVEJS_LNE_TREASURY_CAPTURE_LAUNCH_ISK=

# treasury.mobilizeFitPermille - Internal: fit and crew cost of a MOBILIZE in permille of the hull values (read by the AI from)
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 300.
# EVEJS_LNE_TREASURY_MOBILIZE_FIT_PERMILLE=

# treasury.productionRoomSharePermille - Internal: the most of the war room the production fees may take (read by the AI from)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_TREASURY_PRODUCTION_ROOM_SHARE_PERMILLE=

# treasury.lossesInRoomPermille - Internal: permille of today's battle losses counted as spent from the war room (read by the AI from)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 300.
# EVEJS_LNE_TREASURY_LOSSES_IN_ROOM_PERMILLE=

# The war room over a rolling 24 h window instead of the accrual from UTC midnight.
# treasury.warRoomRollingEnabled - Internal: (war-budget-rolling-window): the war room over a rolling 24 h window (the whole day budget minus today's spend and the share of yesterday's spend inside the window) instead of the accrual from UTC midnight; needs treasury.pressureEnabled; off = the calendar day of before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TREASURY_WAR_ROOM_ROLLING_ENABLED=

# invader home yield and separate Triglavian values. Empty = mod default.
# invaderEconomy.enabled - Internal: home yield of the invaders (units in UPKEEP, ISK in TREASURY per home system) and the separate base income of invaderEconomy.<faction>.baseIncomeIskPerDay; off = the review params without invaderEconomy, the plan byte for byte as before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_INVADER_ECONOMY_ENABLED=

# invaderEconomy.triglavian.baseIncomeIskPerDay - Internal: Triglavian (500026) base income per day instead of treasury.baseIncomeIskPerDayInvader (0 = the class value)
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 3000000000.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_BASE_INCOME_ISK_PER_DAY=

# invaderEconomy.triglavian.iskPerHomeSystemPerDay - Internal: Triglavian ISK yield per home system (heartland, not captured) per day, on top of treasury.incomeIskPerSystemPerDay
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 300000000.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_ISK_PER_HOME_SYSTEM_PER_DAY=

# invaderEconomy.triglavian.unitsPerHomeSystemPerPeriod - Internal: Triglavian resource unit yield per home system per upkeep period, on top of upkeep.incomePerSystem
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 2.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_UNITS_PER_HOME_SYSTEM_PER_PERIOD=

# invaderEconomy.deathless.baseIncomeIskPerDay - Internal: Deathless (500029) base income per day instead of treasury.baseIncomeIskPerDayInvader (0 = the class value; values > 0 only set on purpose in .env)
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_BASE_INCOME_ISK_PER_DAY=

# invaderEconomy.deathless.iskPerHomeSystemPerDay - Internal: A: Deathless ISK yield per home system per day (0 = none)
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_ISK_PER_HOME_SYSTEM_PER_DAY=

# invaderEconomy.deathless.unitsPerHomeSystemPerPeriod - Internal: A: Deathless resource unit yield per home system per upkeep period (0 = none)
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_UNITS_PER_HOME_SYSTEM_PER_PERIOD=

# invaderEconomy.homePoolEnabled - Internal: the AI mobilizes a home fleet pool (role garrison) in the HQ of an invader up to invaderEconomy.<faction>.homeFleetsMax, pseudo-state HOME_POOL (no merge, stranded, patrol); needs invaderEconomy.enabled; off = the review params without homePool, the plan byte for byte as before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_INVADER_ECONOMY_HOME_POOL_ENABLED=

# invaderEconomy.conduitEnabled - Internal: conduit spawns of an invader on their own chain INVASION_CONDUIT_ROLL (own slots outside invasions.maxActive, a day cap, the cost from the treasury war spend and the home pool fleets); needs invaderEconomy.enabled and the invasions module; off = no chain, the main roll as before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_INVADER_ECONOMY_CONDUIT_ENABLED=

# invaderEconomy.raidsEnabled - Internal: raids of an invader from its footholds (doctrine overlay raid + raidsBeyondTheatre, the footholds anchor the raid scan, the front limits of invaderEconomy.<faction>.maxActiveFronts / maxRaidFronts); needs invaderEconomy.enabled and invasions.reviewFootholdsEnabled; off = the review as before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_INVADER_ECONOMY_RAIDS_ENABLED=

# invaderEconomy.triglavian.homeFleetsMax - Internal: Triglavian (500026): the ceiling of the home pool fleets in the HQ
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 8.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_HOME_FLEETS_MAX=

# invaderEconomy.triglavian.homeMobilizationsPerReview - Internal: Triglavian (500026): home pool MOBILIZE per review (inside strategy.maxMobilizationsPerReview)
# Not in the launcher. Range 0..3 (outside: clamped).
# Default: 1.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_HOME_MOBILIZATIONS_PER_REVIEW=

# invaderEconomy.triglavian.conduitChancePermille - Internal: Triglavian (500026): chance of a conduit spawn per window (window = invasions.rollIntervalMs)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_CHANCE_PERMILLE=

# invaderEconomy.triglavian.conduitMaxActive - Internal: Triglavian (500026): open conduit invasions, slots outside invasions.maxActive
# Not in the launcher. Range 0..4 (outside: clamped).
# Default: 2.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_MAX_ACTIVE=

# invaderEconomy.triglavian.conduitMaxSpawnsPerDay - Internal: Triglavian (500026): conduit spawns per UTC day of the world time
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 2.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_MAX_SPAWNS_PER_DAY=

# invaderEconomy.triglavian.conduitIskPerSpawn - Internal: Triglavian (500026): ISK of one conduit spawn (treasury war spend)
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 20000000000.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_ISK_PER_SPAWN=

# invaderEconomy.triglavian.conduitReserveIsk - Internal: Triglavian (500026): balance the conduit never spends; surplus = balance - reserve
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 200000000000.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_RESERVE_ISK=

# invaderEconomy.triglavian.conduitPoolFleetsPerSpawn - Internal: Triglavian (500026): home pool fleets disbanded by one conduit spawn
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 3.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_POOL_FLEETS_PER_SPAWN=

# invaderEconomy.triglavian.conduitBonusFleetsMax - Internal: Triglavian (500026): extra package fleets of a conduit spawn from the surplus (package + bonus <= 8)
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 3.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_BONUS_FLEETS_MAX=

# invaderEconomy.triglavian.conduitIskPerBonusFleet - Internal: Triglavian (500026): ISK of one bonus fleet; bonus = min(max, floor((surplus - spawn cost) / this)), 0 = no bonus
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 10000000000.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_ISK_PER_BONUS_FLEET=

# invaderEconomy.triglavian.conduitWithdrawAfterMs - Internal: Triglavian (500026): withdrawal time of a conduit invasion (0 = the time of the profile)
# Not in the launcher. Range 0..2592000000 (outside: clamped).
# Default: 172800000.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_CONDUIT_WITHDRAW_AFTER_MS=

# invaderEconomy.triglavian.maxActiveFronts - Internal: Triglavian (500026): front limit of the review with raids (0 = the registry value; capped by limits.maxActiveFrontsPerFaction)
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 3.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_MAX_ACTIVE_FRONTS=

# invaderEconomy.triglavian.maxRaidFronts - Internal: Triglavian (500026): open raid fronts with raids (0 = no raids for this faction)
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_INVADER_ECONOMY_TRIGLAVIAN_MAX_RAID_FRONTS=

# invaderEconomy.deathless.homeFleetsMax - Internal: Deathless (500029): the ceiling of the home pool fleets in the HQ
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_HOME_FLEETS_MAX=

# invaderEconomy.deathless.homeMobilizationsPerReview - Internal: Deathless (500029): home pool MOBILIZE per review (inside strategy.maxMobilizationsPerReview)
# Not in the launcher. Range 0..3 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_HOME_MOBILIZATIONS_PER_REVIEW=

# invaderEconomy.deathless.conduitChancePermille - Internal: Deathless (500029): chance of a conduit spawn per window (window = invasions.rollIntervalMs)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_CHANCE_PERMILLE=

# invaderEconomy.deathless.conduitMaxActive - Internal: Deathless (500029): open conduit invasions, slots outside invasions.maxActive
# Not in the launcher. Range 0..4 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_MAX_ACTIVE=

# invaderEconomy.deathless.conduitMaxSpawnsPerDay - Internal: Deathless (500029): conduit spawns per UTC day of the world time
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_MAX_SPAWNS_PER_DAY=

# invaderEconomy.deathless.conduitIskPerSpawn - Internal: Deathless (500029): ISK of one conduit spawn (treasury war spend)
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_ISK_PER_SPAWN=

# invaderEconomy.deathless.conduitReserveIsk - Internal: Deathless (500029): balance the conduit never spends; surplus = balance - reserve
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_RESERVE_ISK=

# invaderEconomy.deathless.conduitPoolFleetsPerSpawn - Internal: Deathless (500029): home pool fleets disbanded by one conduit spawn
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_POOL_FLEETS_PER_SPAWN=

# invaderEconomy.deathless.conduitBonusFleetsMax - Internal: Deathless (500029): extra package fleets of a conduit spawn from the surplus (package + bonus <= 8)
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_BONUS_FLEETS_MAX=

# invaderEconomy.deathless.conduitIskPerBonusFleet - Internal: Deathless (500029): ISK of one bonus fleet; bonus = min(max, floor((surplus - spawn cost) / this)), 0 = no bonus
# Not in the launcher. Range 0..10000000000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_ISK_PER_BONUS_FLEET=

# invaderEconomy.deathless.conduitWithdrawAfterMs - Internal: Deathless (500029): withdrawal time of a conduit invasion (0 = the time of the profile)
# Not in the launcher. Range 0..2592000000 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_CONDUIT_WITHDRAW_AFTER_MS=

# invaderEconomy.deathless.maxActiveFronts - Internal: Deathless (500029): front limit of the review with raids (0 = the registry value; capped by limits.maxActiveFrontsPerFaction)
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_MAX_ACTIVE_FRONTS=

# invaderEconomy.deathless.maxRaidFronts - Internal: Deathless (500029): open raid fronts with raids (0 = no raids for this faction)
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 0.
# EVEJS_LNE_INVADER_ECONOMY_DEATHLESS_MAX_RAID_FRONTS=

# invaderEconomy.sleepersEnabled - Internal: Sleepers (500021) base resource unit income invaderEconomy.sleepers.baseUnitsPerPeriod per upkeep period; needs invaderEconomy.enabled; off = no invaderEconomy for the Sleepers, the upkeep as before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_INVADER_ECONOMY_SLEEPERS_ENABLED=

# invaderEconomy.sleepers.baseUnitsPerPeriod - Internal: Sleepers (500021) base resource units per upkeep period on top of upkeep.incomePerSystem (only with invaderEconomy.sleepersEnabled)
# Not in the launcher. Range 0..1000000 (outside: clamped).
# Default: 5.
# EVEJS_LNE_INVADER_ECONOMY_SLEEPERS_BASE_UNITS_PER_PERIOD=

# construction.enabled - Internal: switch of the construction service (with modules.strategy and stations.enabled); off = open builds frozen, no CONSTRUCTION convoy, reconcile after switching on
# Not in the launcher.
# Default: true.
# EVEJS_LNE_CONSTRUCTION_ENABLED=

# construction.maxOpenBuildsPerFaction - Internal: open builds (SUPPLYING / ANCHORING) of one faction (brake): 1→2
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 2.
# EVEJS_LNE_CONSTRUCTION_MAX_OPEN_BUILDS_PER_FACTION=

# construction.supplyTimeoutMs - Internal: time to bring the whole kit to the site (72 h), then CANCELLED TIMEOUT
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000.
# EVEJS_LNE_CONSTRUCTION_SUPPLY_TIMEOUT_MS=

# construction.recheckMs - Internal: next check of a SUPPLYING site (owner, occupation, limits)
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_CONSTRUCTION_RECHECK_MS=

# construction.anchoringMs - Internal: anchoring of a built station before ONLINE: 24 h→12 h
# Not in the launcher. Range 0..2592000000 (outside: clamped).
# Default: 43200000.
# EVEJS_LNE_CONSTRUCTION_ANCHORING_MS=

# construction.maxLostConvoys - Internal: CONSTRUCTION convoys LOST on the way before the build is CANCELLED
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 1.
# EVEJS_LNE_CONSTRUCTION_MAX_LOST_CONVOYS=

# construction.maxStepsPerPass - Internal: maxPerPass of the STATION_BUILD_STEP handler
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 20.
# EVEJS_LNE_CONSTRUCTION_MAX_STEPS_PER_PASS=

# construction.reconcileMaxBuilds - Internal: open builds checked by the reconcile after a start
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_CONSTRUCTION_RECONCILE_MAX_BUILDS=

# construction.reconcileMaxAttempts - Internal: suffixed reconcile keys tried per build (pattern logistics)
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_CONSTRUCTION_RECONCILE_MAX_ATTEMPTS=

# construction.kitId - Internal: the kit a building site needs, one of the 8 Upwell families of the SDE (raitaru|azbel|sotiyo|astrahus|fortizar|keepstar|athanor|tatara)
# Not in the launcher.
# Default: astrahus.
# EVEJS_LNE_CONSTRUCTION_KIT_ID=

# construction.kitComponentFactorPermille - Internal: substitute component factor of the structure kits (without basePrice in the SDE), floor of the catalogue factor; then production.componentWeightPermille and production.componentFactorMaxPermille
# Not in the launcher. Range 1000..20000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_CONSTRUCTION_KIT_COMPONENT_FACTOR_PERMILLE=

# construction.maxBuildsPerReview - Internal: BUILD_PLAN intents of one strategy review; 0 = the AI plans no station
# Not in the launcher. Range 0..4 (outside: clamped).
# Default: 1.
# EVEJS_LNE_CONSTRUCTION_MAX_BUILDS_PER_REVIEW=

# construction.targetsGateMax - Internal: a faction with at most this many capture targets in reach may build (0 + overdueMs 0 =: no target)
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 3.
# EVEJS_LNE_CONSTRUCTION_TARGETS_GATE_MAX=

# construction.overdueMs - Internal: a faction whose last build is this old (or that never built) may build despite its targets; 0 = off
# Not in the launcher. Range 0..2592000000 (outside: clamped).
# Default: 172800000.
# EVEJS_LNE_CONSTRUCTION_OVERDUE_MS=

# construction.minGapMs - Internal: least time between two builds of one faction (created_at of the last, any state)
# Not in the launcher. Range 0..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_CONSTRUCTION_MIN_GAP_MS=

# construction.maxOpenBuildsTotal - Internal: open builds of every faction (also bounds the CONSTRUCTION convoys); planInTx BUILD_LIMIT_TOTAL
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_CONSTRUCTION_MAX_OPEN_BUILDS_TOTAL=

# construction.maxLiveStationsTotal - Internal: live stations of every kind + SUPPLYING builds; planInTx GLOBAL_STATION_LIMIT
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_CONSTRUCTION_MAX_LIVE_STATIONS_TOTAL=

# construction.outpostsEnabled - Internal: the empires build outposts on captured STABLE nullsec at the border; off = the planner of a non-conquest doctrine as before (nothing, no note, no read)
# Not in the launcher.
# Default: true.
# EVEJS_LNE_CONSTRUCTION_OUTPOSTS_ENABLED=

# construction.outpostKinds - Internal: faction kinds that build outposts (CONCORD police never: it controls no system)
# Not in the launcher.
# Default: empire.
# EVEJS_LNE_CONSTRUCTION_OUTPOST_KINDS=

# construction.outpostEveryMs - Internal: least time since the last build of the faction before an outpost (created_at, any state)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 345600000.
# EVEJS_LNE_CONSTRUCTION_OUTPOST_EVERY_MS=

# construction.outpostMaxOpen - Internal: open builds of an outpost faction (OUTPOST: CONSTRUCTION_BUSY)
# Not in the launcher. Range 0..4 (outside: clamped).
# Default: 1.
# EVEJS_LNE_CONSTRUCTION_OUTPOST_MAX_OPEN=

# construction.outpostMaxStations - Internal: own ONLINE upwell stations + open builds at which an outpost faction stops (OUTPOST_CAP)
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_CONSTRUCTION_OUTPOST_MAX_STATIONS=

# construction.outpostMaxCandidates - Internal: border systems of one review whose station counts are read (one query)
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_CONSTRUCTION_OUTPOST_MAX_CANDIDATES=

# construction.outpostMinBorderNeighbours - Internal: nullsec neighbours outside the own territory an outpost system needs
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 1.
# EVEJS_LNE_CONSTRUCTION_OUTPOST_MIN_BORDER_NEIGHBOURS=

# construction.maxSiteCandidates - Internal: own systems (farthest from the capture anchors first) whose gain one review computes
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_CONSTRUCTION_MAX_SITE_CANDIDATES=

# construction.minSiteGain - Internal: new systems a site must add to the capture reach to be planned
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 1.
# EVEJS_LNE_CONSTRUCTION_MIN_SITE_GAIN=

# construction.requireKitInStock - Internal: plan a site only when the own ONLINE stations hold the whole kit
# Not in the launcher.
# Default: true.
# EVEJS_LNE_CONSTRUCTION_REQUIRE_KIT_IN_STOCK=

# trade.enabled - Internal: switch of the trade service (with modules.strategy and stations.enabled); off = the trade share of the upkeep stays with the faction, budget rows frozen
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TRADE_ENABLED=

# trade.maxIntakesPerPass - Internal: max ACCEPTED→INTAKE + INTAKE→DELIVERED cycles per pass
# Not in the launcher. Range 1..32 (outside: clamped).
# Default: 2.
# EVEJS_LNE_TRADE_MAX_INTAKES_PER_PASS=

# trade.intakeGraceMs - Internal: grace period before accepting partial delivery as LOST
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 600000.
# EVEJS_LNE_TRADE_INTAKE_GRACE_MS=

# trade.maxOrphansPerPass - Internal: orphan contracts deleted per pass
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 2.
# EVEJS_LNE_TRADE_MAX_ORPHANS_PER_PASS=

# trade.maxOrphanScanCorporations - Internal (): NPC corporations of the offers (distinct issuers) added to the registry corporations in one orphan scan
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 64.
# EVEJS_LNE_TRADE_MAX_ORPHAN_SCAN_CORPORATIONS=

# trade.intakeMaxRetries - Internal (SWEEP-20261021-trade): consecutive failed passes of one INTAKE offer before LOST INTAKE_RETRIES_EXHAUSTED
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_TRADE_INTAKE_MAX_RETRIES=

# trade.iskPerResourceUnit - Internal: ISK of the trade budget per faction resource unit of the upkeep trade share
# Not in the launcher. Range 1..1000000000 (outside: clamped).
# Default: 50000.
# EVEJS_LNE_TRADE_ISK_PER_RESOURCE_UNIT=

# trade.iskBudgetCap - Internal: cap of available + reserved ISK of one faction; the surplus stays with the faction as units; with the treasury topped up to treasury.tradeBudgetTargetIsk
# Not in the launcher. Range 0..1000000000000000 (outside: clamped).
# Default: 50000000000.
# EVEJS_LNE_TRADE_ISK_BUDGET_CAP=

# pricing and AI limits (internal, never in the launcher).
# trade.premiumPermille - Internal: premium over best bid in permille (1100 = 10% over bid)
# Not in the launcher. Range 1000..3000 (outside: clamped).
# Default: 1100.
# EVEJS_LNE_TRADE_PREMIUM_PERMILLE=

# trade.askCapPermille - Internal: cap at this permille of best ask (980 = 98% of ask)
# Not in the launcher. Range 500..1000 (outside: clamped).
# Default: 980.
# EVEJS_LNE_TRADE_ASK_CAP_PERMILLE=

# trade.maxOffersPerReview - Internal: new offers per strategy review
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRADE_MAX_OFFERS_PER_REVIEW=

# trade.maxCancelsPerReview - Internal: cancellations per strategy review
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRADE_MAX_CANCELS_PER_REVIEW=

# trade.maxOpenOffersPerFaction - Internal: max open offers of one faction
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 32.
# EVEJS_LNE_TRADE_MAX_OPEN_OFFERS_PER_FACTION=

# trade.maxOpenOffersPerStation - Internal: max open offers per station
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 8.
# EVEJS_LNE_TRADE_MAX_OPEN_OFFERS_PER_STATION=

# trade.maxQuantityPerOffer - Internal: max mineral units per offer (1e8, the real limit is trade.maxOfferVolumeM3)
# Not in the launcher. Range 1..1000000000 (outside: clamped).
# Default: 100000000.
# EVEJS_LNE_TRADE_MAX_QUANTITY_PER_OFFER=

# trade.minIskPerOffer - Internal: minimum ISK per offer (avoids dust)
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 100000.
# EVEJS_LNE_TRADE_MIN_ISK_PER_OFFER=

# trade.maxIskPerOffer - Internal: maximum ISK per offer (1e9 = trade.tier3Isk)
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 1000000000.
# EVEJS_LNE_TRADE_MAX_ISK_PER_OFFER=

# trade.offerTtlMs - Internal: offer plan TTL (3 days default)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000.
# EVEJS_LNE_TRADE_OFFER_TTL_MS=

# trade.factoryRunsTarget - Internal: demand horizon in factory runs (like logistics.factoryRunsTarget)
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 2.
# EVEJS_LNE_TRADE_FACTORY_RUNS_TARGET=

# trade.maxUnitPriceMilli - Internal: hard cap on unit price in milli-ISK
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 1000000000000.
# EVEJS_LNE_TRADE_MAX_UNIT_PRICE_MILLI=

# trade.priceCacheMs - Internal: price cache TTL (1 hour default)
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_TRADE_PRICE_CACHE_MS=

# trade.stockpileEnabled - Internal: stockpile buy offers on every own NPC station (false = mobilization demand only)
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TRADE_STOCKPILE_ENABLED=

# trade.stockpileRuns - Internal: stockpile target = runs of the most expensive doctrine recipe per mineral (0 = off: 8 = tribute.reserveRuns)
# Not in the launcher. Range 0..100 (outside: clamped).
# Default: 8.
# EVEJS_LNE_TRADE_STOCKPILE_RUNS=

# trade.stockpileMaxIskPerOffer - Internal: maximum ISK of one stockpile offer
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 5000000.
# EVEJS_LNE_TRADE_STOCKPILE_MAX_ISK_PER_OFFER=

# trade.stockpileFreeFloorPermille - Internal: stockpile never takes free ISK below this permille of available+reserved
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 300.
# EVEJS_LNE_TRADE_STOCKPILE_FREE_FLOOR_PERMILLE=

# trade.publicLotMaxIsk - Internal: max ISK of one public mineral/ore WTB offer (one player, one haul: vendor WTB contracts are all-or-nothing); 0 = off
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 10000000.
# EVEJS_LNE_TRADE_PUBLIC_LOT_MAX_ISK=

# trade.targetOpenContracts - Internal: galaxy target of open faction offers, split over the factions with a budget (0 = no target)
# Not in the launcher. Range 0..2000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_TRADE_TARGET_OPEN_CONTRACTS=

# trade.stockpileRecallEnabled - Internal (contract-volume a): recall a PLANNED/OPEN stockpile offer whose pair the mobilization demand needs (false = planner before)
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TRADE_STOCKPILE_RECALL_ENABLED=

# trade.stockpileRecallMinNeedPermille - Internal (contract-volume a): recall when the uncovered war value >= max(minIskPerOffer, iskTotal of the offer x this permille)
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_TRADE_STOCKPILE_RECALL_MIN_NEED_PERMILLE=

# doctrine hulls in the trade catalog and the WTB path (internal).
# trade.hullOffersEnabled - Internal (contract-volume c1): doctrine hulls in the trade catalog and WTB; false = catalog, prices and validation without doctrine hulls
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TRADE_HULL_OFFERS_ENABLED=

# contract-volume c2: the hull WTB planner and the faction slots reserved for the war demand (internal).
# trade.hullOffersPerReview - Internal (contract-volume c2): hull offers per strategy review (inside maxOffersPerReview; 0 = no hull offers)
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_TRADE_HULL_OFFERS_PER_REVIEW=

# trade.hullMaxPerOffer - Internal (contract-volume c2): hulls in one offer
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRADE_HULL_MAX_PER_OFFER=

# trade.warReservedOffersPerFaction - Internal (contract-volume c2): open offer slots of a faction out of reach of the stockpile (0 = stockpile as before c2)
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRADE_WAR_RESERVED_OFFERS_PER_FACTION=

# contract-volume d1: WTS contracts of the factions (internal).
# trade.wtsEnabled - Internal (contract-volume d1): WTS contracts of the factions; false = no new sell offers, the existing ones settle
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_WTS_ENABLED=

# contract-volume d2: the life of a WTS contract from its issue (internal).
# trade.wtsTtlMs - Internal (contract-volume d2): life of a WTS contract from its issue (3 days default)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000.
# EVEJS_LNE_TRADE_WTS_TTL_MS=

# contract-volume d4: the WTS planner of the strategy review (internal; only with trade.wtsEnabled).
# trade.wtsOffersPerReview - Internal (contract-volume d4): WTS offers per strategy review (inside maxOffersPerReview; 0 = no WTS offer)
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_TRADE_WTS_OFFERS_PER_REVIEW=

# trade.wtsMaxOpenPerFaction - Internal (contract-volume d4): open WTS offers of a faction (inside the faction cap of the stockpile)
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_TRADE_WTS_MAX_OPEN_PER_FACTION=

# trade.wtsStationSlotHeadroom - Internal (contract-volume d4): free station offer slots a WTS offer leaves for the WTB offers
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 1.
# EVEJS_LNE_TRADE_WTS_STATION_SLOT_HEADROOM=

# trade.wtsMineralSurplusRuns - Internal (contract-volume d4): minerals kept on a station = runs of the most expensive doctrine recipe; above = WTS (0 = no WTS of minerals)
# Keep it above trade.stockpileRuns (hysteresis: the stockpile never buys back what WTS sold).
# Not in the launcher. Range 0..200 (outside: clamped).
# Default: 16.
# EVEJS_LNE_TRADE_WTS_MINERAL_SURPLUS_RUNS=

# trade.wtsHullSurplusPermille - Internal (contract-volume d4): hulls kept by a faction = desired x this permille; above = WTS (0 = no WTS of hulls)
# Not in the launcher. Range 0..100000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_TRADE_WTS_HULL_SURPLUS_PERMILLE=

# trade.wtsAskPermille - Internal (contract-volume d4): WTS price >= market ask x this permille
# Not in the launcher. Range 1000..5000 (outside: clamped).
# Default: 1050.
# EVEJS_LNE_TRADE_WTS_ASK_PERMILLE=

# trade.wtsBidPermille - Internal (contract-volume d4): WTS price >= market bid x this permille
# Not in the launcher. Range 1000..5000 (outside: clamped).
# Default: 1100.
# EVEJS_LNE_TRADE_WTS_BID_PERMILLE=

# trade.wtsMaxIskPerOffer - Internal (contract-volume d4): maximum ISK of one WTS offer
# Not in the launcher. Range 1000000..1000000000000 (outside: clamped).
# Default: 500000000.
# EVEJS_LNE_TRADE_WTS_MAX_ISK_PER_OFFER=

# Value tiers 10M / 100M / 1B of the public mineral offers (internal).
#
# Full rollback of tiers-1: set all 4 keys below. TIERS_ENABLED=false alone keeps the
# 3 new defaults of (1e9 ISK per offer, 1e8 units per offer, stockpile target 8 runs).
# Since (a) trade.maxOfferVolumeM3 caps the volume of one public offer also without the tiers
# so the offers stay deliverable by one freighter (keep the default 500000 m3).
#   EVEJS_LNE_TRADE_TIERS_ENABLED=false
#   EVEJS_LNE_TRADE_MAX_ISK_PER_OFFER=200000000
#   EVEJS_LNE_TRADE_MAX_QUANTITY_PER_OFFER=10000000
#   EVEJS_LNE_TRADE_STOCKPILE_RUNS=4
# Restart the server after the change. To enable the tiers again, remove the 4 lines.
#
# trade.tiersEnabled - Internal: value tiers of the offers (false = the sizes and the TTL before the tiers)
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TRADE_TIERS_ENABLED=

# trade.tier1Isk - Internal: ISK cap of tier 1
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 10000000.
# EVEJS_LNE_TRADE_TIER1_ISK=

# trade.tier2Isk - Internal: ISK cap of tier 2
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 100000000.
# EVEJS_LNE_TRADE_TIER2_ISK=

# trade.tier3Isk - Internal: ISK cap of tier 3
# Not in the launcher. Range 1..1000000000000 (outside: clamped).
# Default: 1000000000.
# EVEJS_LNE_TRADE_TIER3_ISK=

# trade.tier2SharePermille - Internal: share of the faction offer slots for tier 2
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 350.
# EVEJS_LNE_TRADE_TIER2_SHARE_PERMILLE=

# trade.tier3SharePermille - Internal: share of the faction offer slots for tier 3 (tier 1 = the rest)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 150.
# EVEJS_LNE_TRADE_TIER3_SHARE_PERMILLE=

# trade.tier1TtlMs - Internal: TTL of a tier 1 offer and contract (3 days)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000.
# EVEJS_LNE_TRADE_TIER1_TTL_MS=

# trade.tier2TtlMs - Internal: TTL of a tier 2 offer and contract (7 days)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 604800000.
# EVEJS_LNE_TRADE_TIER2_TTL_MS=

# trade.tier3TtlMs - Internal: TTL of a tier 3 offer and contract (14 days)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 1209600000.
# EVEJS_LNE_TRADE_TIER3_TTL_MS=

# trade.tierMinOfferIsk - Internal: minimum ISK of a tiered stockpile offer (below: TRADE_TIER_NEED_SMALL)
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 5000000.
# EVEJS_LNE_TRADE_TIER_MIN_OFFER_ISK=

# trade.tierMaxBudgetSharePermille - Internal: one offer takes at most this permille of the trade budget (available+reserved)
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_TRADE_TIER_MAX_BUDGET_SHARE_PERMILLE=

# trade.maxOfferVolumeM3 - Internal: maximum cargo volume of one offer (deliverable by one freighter)
# Not in the launcher. Range 1..100000000 (outside: clamped).
# Default: 500000.
# EVEJS_LNE_TRADE_MAX_OFFER_VOLUME_M3=

# Local resources cache of the trade service (internal).
# trade.localResourcesEnabled - Internal: local resources source of the stations (false = no reads, panel section local off)
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TRADE_LOCAL_RESOURCES_ENABLED=

# trade.localOreJumps - Internal: radius in stargate jumps of the local ore of a station system
# Not in the launcher. Range 0..3 (outside: clamped).
# Default: 1.
# EVEJS_LNE_TRADE_LOCAL_ORE_JUMPS=

# trade.localResourcesMaxSystemsPerRead - Internal: systems per adapter read (the rest stays pending)
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_TRADE_LOCAL_RESOURCES_MAX_SYSTEMS_PER_READ=

# trade.localResourcesMaxFailures - Internal: failed single-system reads in a row before the system is unreadable until restart (stations: no filter)
# Not in the launcher. Range 1..100 (outside: clamped).
# Default: 3.
# EVEJS_LNE_TRADE_LOCAL_RESOURCES_MAX_FAILURES=

# trade.localResourcesWarmMaxSystems - Internal: upper limit of the warm-up after the stations (0 = no warm-up)
# Not in the launcher. Range 0..8490 (outside: clamped).
# Default: 2048.
# EVEJS_LNE_TRADE_LOCAL_RESOURCES_WARM_MAX_SYSTEMS=

# trade.localOreIncludeAnomalies - Internal: ore anomaly entitlement counts as a local ore source
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_LOCAL_ORE_INCLUDE_ANOMALIES=

# Ore as a trade good (internal).
# trade.oreOffersEnabled - Internal: ore prices, ore quotes and new ore offers, default off (compressed and II/III-grade ore does not fit; false = trade without ore; intake of existing ore offers runs)
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_ORE_OFFERS_ENABLED=

# trade.oreRefineEfficiencyPermille - Internal: refining efficiency of ore in the price cap and in the intake plan (frozen at ACCEPTED)
# Not in the launcher. Range 500..1000 (outside: clamped).
# Default: 800.
# EVEJS_LNE_TRADE_ORE_REFINE_EFFICIENCY_PERMILLE=

# The stockpile buys only the minerals of the local ore (internal).
# trade.stockpileLocalOnly - Internal: stockpile buys only minerals of local ore, default off (contracts for every mineral; false = stockpile of every mineral; no effect without local data)
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_STOCKPILE_LOCAL_ONLY=

# contract executor (internal, never in the launcher).
# trade.contractsEnabled - Internal: when false, offers stay PLANNED (plan only); when true, executor issues contracts
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TRADE_CONTRACTS_ENABLED=

# trade.cleanupOnDisable - Internal: when trade.enabled=false and this is true, executor runs in cleanup mode (closes offers)
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_CLEANUP_ON_DISABLE=

# trade.walletAccountKey - Internal: corporation wallet division for trade contracts (1006 = 7th division)
# Not in the launcher. Range 1000..1006 (outside: clamped).
# Default: 1006.
# EVEJS_LNE_TRADE_WALLET_ACCOUNT_KEY=

# trade.buyOrdersEnabled - Internal: enable market buy order path (ISSUING->OPEN via market daemon); false = contract path only
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_BUY_ORDERS_ENABLED=

# trade.hullBuyOrdersEnabled - Internal: public hull offers of NPC stations may go out as market buy orders (needs buyOrdersEnabled; off while warContracts.enabled); false = hulls by contract only
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_HULL_BUY_ORDERS_ENABLED=

# trade.commodityOffersEnabled - Internal (moon/PI): moon / PI catalog entries, quotes and review steps 6c (buy shortages) / 7c (WTS surplus + float); false = trade as before
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_COMMODITY_OFFERS_ENABLED=

# trade.commodityBuyOrdersEnabled - Internal (moon/PI): moon / PI buy offers of NPC stations may go out as market buy orders (needs commodityOffersEnabled and buyOrdersEnabled); false = contract WTB
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_COMMODITY_BUY_ORDERS_ENABLED=

# trade.marketSellOrdersEnabled - Internal (moon/PI): public mineral / moon / PI sell offers of NPC stations may go out as market sell orders with vendor escrow (needs wtsEnabled); false = WTS contracts only
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_MARKET_SELL_ORDERS_ENABLED=

# trade.sellOrderDurationDays - Internal (moon/PI): market sell order duration in days, one of 1/3/7/14/30/90 and >= wtsTtlMs + 1 day (W210)
# Not in the launcher. Range 1..90 (outside: clamped).
# Default: 7.
# EVEJS_LNE_TRADE_SELL_ORDER_DURATION_DAYS=

# trade.maxCommodityTypes - Internal (moon/PI): moon / PI types of the trade catalog (catalog limit 192 types)
# Not in the launcher. Range 0..128 (outside: clamped).
# Default: 96.
# EVEJS_LNE_TRADE_MAX_COMMODITY_TYPES=

# trade.commodityOffersPerReview - Internal (moon/PI): moon / PI buy + sell offers per faction review (inside maxOffersPerReview)
# Not in the launcher. Range 0..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRADE_COMMODITY_OFFERS_PER_REVIEW=

# trade.commodityFloatPermille - Internal (moon/PI): share of the station commodity stock always offered by WTS (0 = surplus only)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_TRADE_COMMODITY_FLOAT_PERMILLE=

# trade.commodityMinSellUnits - Internal (moon/PI): smallest moon / PI WTS lot in units
# Not in the launcher. Range 1..1000000000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_TRADE_COMMODITY_MIN_SELL_UNITS=

# trade.commoditySellAskPermille - Internal (moon/PI): moon / PI WTS price = market ask x this permille
# Not in the launcher. Range 500..1000 (outside: clamped).
# Default: 980.
# EVEJS_LNE_TRADE_COMMODITY_SELL_ASK_PERMILLE=

# trade.commoditySellBidFloorPermille - Internal (moon/PI): moon / PI WTS price floor = market bid x this permille
# Not in the launcher. Range 1000..2000 (outside: clamped).
# Default: 1020.
# EVEJS_LNE_TRADE_COMMODITY_SELL_BID_FLOOR_PERMILLE=

# trade.commodityBasePriceEnabled - Internal: a moon / PI type without a local ask and without a Jita entry is priced from its type base price (clean local read of the type only); works only with commodityOffersEnabled; false = as before
# Not in the launcher.
# Default: true.
# EVEJS_LNE_TRADE_COMMODITY_BASE_PRICE_ENABLED=

# trade.commodityBasePriceAskPermille - Internal: synthetic ask of the base price fallback = base price x this permille (buy cap and WTS base)
# Not in the launcher. Range 1000..3000 (outside: clamped).
# Default: 1200.
# EVEJS_LNE_TRADE_COMMODITY_BASE_PRICE_ASK_PERMILLE=

# trade.buyOrderWalletAccountKey - Internal: corporation wallet division for market buy order escrow (1005 = 6th division); must differ from walletAccountKey when trade.enabled
# Not in the launcher. Range 1000..1006 (outside: clamped).
# Default: 1005.
# EVEJS_LNE_TRADE_BUY_ORDER_WALLET_ACCOUNT_KEY=

# trade.buyOrderTtlMs - Internal: market buy order lifetime in ms (default 3 days)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000.
# EVEJS_LNE_TRADE_BUY_ORDER_TTL_MS=

# trade.buyOrderDurationDays - Internal: market buy order duration in days (max 90 per EveJS)
# Not in the launcher. Range 1..90 (outside: clamped).
# Default: 7.
# EVEJS_LNE_TRADE_BUY_ORDER_DURATION_DAYS=

# trade.buyOrderMinVolume - Internal: minimum volume for market buy order (avoids dust)
# Not in the launcher. Range 1..1000000000 (outside: clamped).
# Default: 1.
# EVEJS_LNE_TRADE_BUY_ORDER_MIN_VOLUME=

# trade.maxBuyOrderPollsPerPass - Internal: max OPEN market buy orders to poll per pass
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_TRADE_MAX_BUY_ORDER_POLLS_PER_PASS=

# trade.maxBuyOrderClosesPerPass - Internal: max market buy orders to close per pass
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRADE_MAX_BUY_ORDER_CLOSES_PER_PASS=

# trade.maxMarketIssueFailures - Internal: consecutive market ISSUE_FAILED aborts that switch the market channel to contracts until restart (0 = off)
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 3.
# EVEJS_LNE_TRADE_MAX_MARKET_ISSUE_FAILURES=

# trade.maxBuyOrderOrphansPerPass - Internal: max market orphan escrows/orders cleaned per pass (0 = off)
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_TRADE_MAX_BUY_ORDER_ORPHANS_PER_PASS=

# trade.maxRefundSweepsPerPass - Internal: max refund sweep wallet adjustments per pass (0 = off)
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_TRADE_MAX_REFUND_SWEEPS_PER_PASS=

# trade.marketOrphanScanMs - Internal: interval of the full market orphan scan in ms (default 1 hour)
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_TRADE_MARKET_ORPHAN_SCAN_MS=

# trade.marketOrphanScanPage - Internal: page size of the market orphan escrow scan (min 8 per EveJS)
# Not in the launcher. Range 8..512 (outside: clamped).
# Default: 64.
# EVEJS_LNE_TRADE_MARKET_ORPHAN_SCAN_PAGE=

# trade.contractTtlMs - Internal: contract lifetime in ms (default 3 days, same as offerTtlMs)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000.
# EVEJS_LNE_TRADE_CONTRACT_TTL_MS=

# trade.executorPollMs - Internal: executor pass interval in ms
# Not in the launcher. Range 10000..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_TRADE_EXECUTOR_POLL_MS=

# trade.maxIssuesPerPass - Internal: max offers to process for issuing per pass
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRADE_MAX_ISSUES_PER_PASS=

# trade.maxPollsPerPass - Internal: max OPEN offers to poll per pass
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_TRADE_MAX_POLLS_PER_PASS=

# trade.maxClosesPerPass - Internal: max contracts to close per pass
# Not in the launcher. Range 0..32 (outside: clamped).
# Default: 4.
# EVEJS_LNE_TRADE_MAX_CLOSES_PER_PASS=

# trade.issueTimeoutMs - Internal: timeout for issue step before abort (ms)
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_TRADE_ISSUE_TIMEOUT_MS=

# trade.priceRegionId - Internal: reference region for prices (The Forge = 10000002)
# Not in the launcher. Range 10000001..19999999 (outside: clamped).
# Default: 10000002.
# EVEJS_LNE_TRADE_PRICE_REGION_ID=

# trade.maxPriceRegions - Internal: max station regions to query for ask prices
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 8.
# EVEJS_LNE_TRADE_MAX_PRICE_REGIONS=

# trade.priceRefreshMs - Internal: price cache refresh interval (ms)
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_TRADE_PRICE_REFRESH_MS=

# trade.priceRetryMs - Internal: price refresh retry after a failed refresh (market daemon unreachable, seam refusal) in ms; the pump checks it once per executorPollMs
# Not in the launcher. Range 10000..3600000 (outside: clamped).
# Default: 120000.
# EVEJS_LNE_TRADE_PRICE_RETRY_MS=

# trade.externalPriceEnabled - Internal: fetch Jita prices from market.fuzzwork.co.uk (run mode only, on by default, outbound HTTPS); bid = buy percentile, ask = min(local ask, sell percentile); any failure or no internet = local market prices
# Not in the launcher. Needs internet access from the server container (README "Ceny Jity z Fuzzwork").
# Default: true.
# EVEJS_LNE_TRADE_EXTERNAL_PRICE_ENABLED=

# trade.externalPriceStationId - Internal: station of the Fuzzwork aggregates (60003760 = Jita IV - Moon 4 - Caldari Navy Assembly Plant)
# Not in the launcher. Range 60000000..69999999 (outside: clamped).
# Default: 60003760.
# EVEJS_LNE_TRADE_EXTERNAL_PRICE_STATION_ID=

# trade.externalPriceRefreshMs - Internal: Fuzzwork fetch interval in ms (aggregates change every ~6 h; the API author asks for rare fetches)
# Not in the launcher. Range 3600000..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_TRADE_EXTERNAL_PRICE_REFRESH_MS=

# trade.externalPriceRetryMs - Internal: next Fuzzwork fetch after a failed one (ms)
# Not in the launcher. Range 900000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_TRADE_EXTERNAL_PRICE_RETRY_MS=

# trade.externalPriceMaxAgeMs - Internal: a Jita snapshot older than this is not used (local prices, panel stale=true)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 172800000.
# EVEJS_LNE_TRADE_EXTERNAL_PRICE_MAX_AGE_MS=

# trade.externalPriceTimeoutMs - Internal: limit of the whole Fuzzwork request (ms)
# Not in the launcher. Range 1000..60000 (outside: clamped).
# Default: 10000.
# EVEJS_LNE_TRADE_EXTERNAL_PRICE_TIMEOUT_MS=

# trade.externalPriceMaxResponseBytes - Internal: size limit of the Fuzzwork answer and of the saved snapshot file (bytes)
# Not in the launcher. Range 4096..1048576 (outside: clamped).
# Default: 65536.
# With trade.commodityOffersEnabled the whole catalog may exceed it (W286): 262144 recommended.
# EVEJS_LNE_TRADE_EXTERNAL_PRICE_MAX_RESPONSE_BYTES=

# trade.externalPriceMaxRatio - Internal: a Jita bid more than this factor above or below the local base price is refused (DEVIATION)
# Not in the launcher. Range 2..1000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_TRADE_EXTERNAL_PRICE_MAX_RATIO=

# trade.askCapIncludesExternal - Internal: true = ask cap min(local ask, Jita ask); false = the local in-game ask when known (Jita only without a local ask)
# Not in the launcher.
# Default: false.
# EVEJS_LNE_TRADE_ASK_CAP_INCLUDES_EXTERNAL=

# siege.enabled - Internal: switch of the siege service (with modules.strategy and stations.enabled); off = no siege starts, open sieges frozen, reconcile after switching on
# Not in the launcher.
# Default: true.
# EVEJS_LNE_SIEGE_ENABLED=

# siege.timerScale - Internal: factor of the EveJS reinforce timers (STRUCTURE_TIMER_SECONDS); 1 = EVE
# Not in the launcher. Range 0.001..10 (outside: clamped).
# Default: 0.25.
# EVEJS_LNE_SIEGE_TIMER_SCALE=

# siege.assaultMinMs - Internal: shortest attack phase (EveJS REPAIR_DEFAULT 900 s)
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 900000.
# EVEJS_LNE_SIEGE_ASSAULT_MIN_MS=

# siege.assaultMaxMs - Internal: longest attack phase; a weaker fleet does not start / is repelled; below assaultMinMs = no start
# Not in the launcher. Range 60000..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_SIEGE_ASSAULT_MAX_MS=

# siege.recheckMs - Internal: wait of a deadline while a battle runs or hostile fleets hold the system
# Not in the launcher. Range 10000..86400000 (outside: clamped).
# Default: 300000.
# EVEJS_LNE_SIEGE_RECHECK_MS=

# siege.maxWaitRounds - Internal: waits of one phase, then the siege is repelled (CONTESTED_TIMEOUT)
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 6.
# EVEJS_LNE_SIEGE_MAX_WAIT_ROUNDS=

# siege.maxOpenSieges - Internal: open sieges in the whole world
# Not in the launcher. Range 1..4096 (outside: clamped).
# Default: 64.
# EVEJS_LNE_SIEGE_MAX_OPEN_SIEGES=

# siege.maxOpenSiegesPerFaction - Internal: open sieges of one attacking faction
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 4.
# EVEJS_LNE_SIEGE_MAX_OPEN_SIEGES_PER_FACTION=

# siege.maxFleetsReadPerCheck - Internal: fleets of a system read by a check / step; more = contested (conservative)
# Not in the launcher. Range 1..1024 (outside: clamped).
# Default: 64.
# EVEJS_LNE_SIEGE_MAX_FLEETS_READ_PER_CHECK=

# siege.maxChecksPerPass - Internal: maxPerPass of the STATION_SIEGE_CHECK handler
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 32.
# EVEJS_LNE_SIEGE_MAX_CHECKS_PER_PASS=

# siege.maxStepsPerPass - Internal: maxPerPass of the STATION_SIEGE_STEP handler
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 16.
# EVEJS_LNE_SIEGE_MAX_STEPS_PER_PASS=

# siege.captureUpwell - Internal: true = an Upwell station is captured like an NPC station (EVE: destroyed)
# Not in the launcher.
# Default: false.
# EVEJS_LNE_SIEGE_CAPTURE_UPWELL=

# siege.allowHighsec - Internal: true = sieges also in highsec
# Not in the launcher.
# Default: false.
# EVEJS_LNE_SIEGE_ALLOW_HIGHSEC=

# siege.retentionMs - Internal: ended siege rows older than this are deleted by a check (the totals stay)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 604800000.
# EVEJS_LNE_SIEGE_RETENTION_MS=

# siege.sackCooldownMs - Internal: after a SACKED end no faction besieges the same station for this long (per station, independent of siege.retentionMs)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000.
# EVEJS_LNE_SIEGE_SACK_COOLDOWN_MS=

# siege.repelCooldownMs - Internal: after a REPELLED end the same attacker does not besiege the same station for this long (per pair station + attacker; 0 = off)
# Not in the launcher. Range 0..2592000000 (outside: clamped).
# Default: 0. Recommended value: 86400000 (24 h).
# EVEJS_LNE_SIEGE_REPEL_COOLDOWN_MS=86400000

# siege.pruneBatch - Internal: ended siege rows deleted by one start
# Not in the launcher. Range 0..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_SIEGE_PRUNE_BATCH=

# siege.reconcileMaxSieges - Internal: open sieges whose deadline the reconcile after a start re-enqueues
# Not in the launcher. Range 0..4096 (outside: clamped).
# Default: 256.
# EVEJS_LNE_SIEGE_RECONCILE_MAX_SIEGES=

# siege.stationGarrisonEnabled - Internal: an ONLINE station adds its garrison points (structureDefense.js) to the battles of its system
# Not in the launcher.
# Default: true.
# EVEJS_LNE_SIEGE_STATION_GARRISON_ENABLED=

# siege.reliefEnabled - Internal: the owner of a besieged station sends a relief (operation defense) from its IDLE fleets
# Not in the launcher.
# Default: true.
# EVEJS_LNE_SIEGE_RELIEF_ENABLED=

# siege.reliefLeadMs - Internal: a relief leaves at most this long before the end of a reinforce timer (ARMOR_TIMER / HULL_TIMER)
# Not in the launcher. Range 0..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_SIEGE_RELIEF_LEAD_MS=

# siege.reliefHoldMs - Internal: the relief operation lasts at least this long after the end of the current siege phase
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_SIEGE_RELIEF_HOLD_MS=

# siege.maxReliefPerReview - Internal: relief operations of one faction review (0 = no relief)
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_SIEGE_MAX_RELIEF_PER_REVIEW=

# siege.nativeDestructionEnabled - Internal: a structure destroyed in EveJS (player) in the HULL_ASSAULT / ANCHOR_ASSAULT window of its siege ends the siege (station DESTROYED, no mod wreck field); off = the projection recreates it
# Not in the launcher.
# Default: false.
# EVEJS_LNE_SIEGE_NATIVE_DESTRUCTION_ENABLED=

# siege.gridEnabled - Internal: sieges of LNE stations and player structures per grid (with grid.enabled and grid.movesEnabled): resistance and battle only in the grid of the target, SIEGE moves of the attacker to the target, siege posts in gridDefense; off = system sieges
# Not in the launcher. Enable together with grid.defense.enabled and battle.gridContacts.enabled.
# Default: false.
# EVEJS_LNE_SIEGE_GRID_ENABLED=

# siege.gridMaxMovers - Internal: attacker fleets with a SIEGE move per CHECK / STEP; 0 = no moves (presence rule only)
# Not in the launcher. Range 0..16 (outside: clamped).
# Default: 8.
# EVEJS_LNE_SIEGE_GRID_MAX_MOVERS=

# Sieges of player Upwell structures in nullsec.
# Internal: never in the launcher. On by default (adds the structure_assault dispatch).
# Values = config.js SCHEMA.

# playerSiege.enabled - Internal: switch of the player structure siege service (with modules.strategy and the playerStructures seam); off = no handler, open sieges frozen, reconcile after switching on
# Not in the launcher.
# Default: true. Safeguards kept on: the final hull phase only with vendor asset safety and an owner
# corporation member online in the last 48 h (playerSiege.ownerOnlineWindowMs).
# EVEJS_LNE_PLAYER_SIEGE_ENABLED=

# playerSiege.maxDispatchPerReview - Internal: LAUNCH structure_assault of one review (0 = no dispatch, sieges only by fleets already there)
# Not in the launcher. Range 0..4 (outside: clamped).
# Default: 1.
# EVEJS_LNE_PLAYER_SIEGE_MAX_DISPATCH_PER_REVIEW=

# playerSiege.dispatchMaxJumps - Internal: a target structure at most this many jumps from a system the faction controls
# Not in the launcher. Range 0..20 (outside: clamped).
# Default: 3.
# EVEJS_LNE_PLAYER_SIEGE_DISPATCH_MAX_JUMPS=

# playerSiege.dispatchDpsMargin - Internal: the dispatched fleets carry at least the required DPS of the target x this margin
# Not in the launcher. Range 1..10 (outside: clamped).
# Default: 1.5.
# EVEJS_LNE_PLAYER_SIEGE_DISPATCH_DPS_MARGIN=

# playerSiege.targetFamilies - Internal: structure families a faction besieges (vendor STRUCTURE_FAMILY)
# Not in the launcher.
# Default: citadel,engineering,refinery.
# EVEJS_LNE_PLAYER_SIEGE_TARGET_FAMILIES=

# playerSiege.destroyEnabled - Internal: the final hull hit may destroy the structure (vendor asset safety); off = HALTED FINAL_DISABLED
# Not in the launcher.
# Default: true.
# EVEJS_LNE_PLAYER_SIEGE_DESTROY_ENABLED=

# playerSiege.ownerOnlineWindowMs - Internal: a member of the owner corporation online in this window opens the final hull phase
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 172800000.
# EVEJS_LNE_PLAYER_SIEGE_OWNER_ONLINE_WINDOW_MS=

# playerSiege.maxMembersRead - Internal: members of the owner corporation read by the activity gate
# Not in the launcher. Range 1..5000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_PLAYER_SIEGE_MAX_MEMBERS_READ=

# playerSiege.assaultMinMs - Internal: shortest assault phase
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 900000.
# EVEJS_LNE_PLAYER_SIEGE_ASSAULT_MIN_MS=

# playerSiege.assaultMaxMs - Internal: longest assault phase; a weaker fleet does not start / is repelled
# Not in the launcher. Range 60000..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_PLAYER_SIEGE_ASSAULT_MAX_MS=

# playerSiege.hitMarginMs - Internal: a hit falls this long before the vendor repair of the vulnerable layer
# Not in the launcher. Range 0..600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_PLAYER_SIEGE_HIT_MARGIN_MS=

# playerSiege.timerExitDelayMs - Internal: wait after the end of a vendor reinforce timer (tickStructures throttling)
# Not in the launcher. Range 0..600000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_PLAYER_SIEGE_TIMER_EXIT_DELAY_MS=

# playerSiege.lagRecheckMs - Internal: recheck while the vendor has not left a reinforce timer that already ended
# Not in the launcher. Range 1000..600000 (outside: clamped).
# Default: 10000.
# EVEJS_LNE_PLAYER_SIEGE_LAG_RECHECK_MS=

# playerSiege.maxLagRounds - Internal: lag rechecks of one phase, then ABORTED VENDOR_STUCK
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 30.
# EVEJS_LNE_PLAYER_SIEGE_MAX_LAG_ROUNDS=

# playerSiege.recheckMs - Internal: wait while a battle runs or hostile fleets hold the system
# Not in the launcher. Range 10000..86400000 (outside: clamped).
# Default: 300000.
# EVEJS_LNE_PLAYER_SIEGE_RECHECK_MS=

# playerSiege.maxWaitRounds - Internal: contested waits of one phase, then REPELLED CONTESTED_TIMEOUT
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 6.
# EVEJS_LNE_PLAYER_SIEGE_MAX_WAIT_ROUNDS=

# playerSiege.maxOpen - Internal: open player structure sieges in the world
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 4.
# EVEJS_LNE_PLAYER_SIEGE_MAX_OPEN=

# playerSiege.maxOpenPerFaction - Internal: open player structure sieges of one attacking faction
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 1.
# EVEJS_LNE_PLAYER_SIEGE_MAX_OPEN_PER_FACTION=

# playerSiege.maxOpenPerOwner - Internal: open sieges of the structures of one owner corporation
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 1.
# EVEJS_LNE_PLAYER_SIEGE_MAX_OPEN_PER_OWNER=

# playerSiege.structureCooldownMs - Internal: after any end the same structure is not besieged for this long
# Not in the launcher. Range 3600000..2592000000 (outside: clamped).
# Default: 604800000.
# EVEJS_LNE_PLAYER_SIEGE_STRUCTURE_COOLDOWN_MS=

# playerSiege.retentionMs - Internal: ended siege rows older than this are deleted by a start (>= structureCooldownMs, else no start)
# Not in the launcher. Range 3600000..7776000000 (outside: clamped).
# Default: 1209600000.
# EVEJS_LNE_PLAYER_SIEGE_RETENTION_MS=

# playerSiege.pruneBatch - Internal: ended siege rows deleted by one start
# Not in the launcher. Range 0..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_PLAYER_SIEGE_PRUNE_BATCH=

# playerSiege.scanIntervalMs - Internal: period of PLAYER_SIEGE_SCAN
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_PLAYER_SIEGE_SCAN_INTERVAL_MS=

# playerSiege.maxSystemsPerScan - Internal: systems with player structures checked by one scan (cursor continues)
# Not in the launcher. Range 1..4096 (outside: clamped).
# Default: 64.
# EVEJS_LNE_PLAYER_SIEGE_MAX_SYSTEMS_PER_SCAN=

# playerSiege.indexTtlMs - Internal: age of the candidate structure index of the adapter before a rebuild
# Not in the launcher. Range 1000..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_PLAYER_SIEGE_INDEX_TTL_MS=

# playerSiege.maxIndexStructures - Internal: structures of the candidate index (the tail is cut)
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_PLAYER_SIEGE_MAX_INDEX_STRUCTURES=

# playerSiege.maxStructuresPerCheck - Internal: structures of one system read by a check
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_PLAYER_SIEGE_MAX_STRUCTURES_PER_CHECK=

# playerSiege.maxStandingReadsPerCheck - Internal: standing reads of one check; over the budget = not hostile
# Not in the launcher. Range 1..1024 (outside: clamped).
# Default: 32.
# EVEJS_LNE_PLAYER_SIEGE_MAX_STANDING_READS_PER_CHECK=

# playerSiege.maxFleetsReadPerCheck - Internal: fleets of a system read by a check / step; more = contested
# Not in the launcher. Range 1..1024 (outside: clamped).
# Default: 64.
# EVEJS_LNE_PLAYER_SIEGE_MAX_FLEETS_READ_PER_CHECK=

# playerSiege.maxChecksPerPass - Internal: maxPerPass of the PLAYER_SIEGE_CHECK handler
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 16.
# EVEJS_LNE_PLAYER_SIEGE_MAX_CHECKS_PER_PASS=

# playerSiege.maxStepsPerPass - Internal: maxPerPass of the PLAYER_SIEGE_STEP handler
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 8.
# EVEJS_LNE_PLAYER_SIEGE_MAX_STEPS_PER_PASS=

# playerSiege.reconcileMaxSieges - Internal: open sieges whose deadline the reconcile after a start re-enqueues
# Not in the launcher. Range 0..4096 (outside: clamped).
# Default: 256.
# EVEJS_LNE_PLAYER_SIEGE_RECONCILE_MAX_SIEGES=

# playerSiege.stepLostBufferMs - Internal: slack after the STEP deadline + maxWaitRounds x recheckMs before a siege stops pinning its fleets
# Not in the launcher. Range 0..604800000 (outside: clamped).
# Default: 21600000.
# EVEJS_LNE_PLAYER_SIEGE_STEP_LOST_BUFFER_MS=

# Sentries without a control tower
# (types 340500-340503 of the customTypes pack mobile-sentries). Internal: never in the launcher. On by default since
# . Values = config.js SCHEMA.

# sentries.enabled - Internal: switch of the sentries (with modules.strategy); off = no vendor wrap and no handler (POS batteries vanilla, existing sentries go offline by the vendor), rows frozen, reconcile after switching on
# Not in the launcher. Range: true/false. Needs a server restart (the wraps are installed at the first load).
# Default: true.
# EVEJS_LNE_SENTRIES_ENABLED=

# sentries.player.enabled - Internal: players may anchor sentries (off = anchoring refused SENTRY_DISABLED, existing sentries keep working)
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_SENTRIES_PLAYER_ENABLED=

# sentries.player.allowHighsec - Internal: a player sentry may be anchored in high-security space
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_SENTRIES_PLAYER_ALLOW_HIGHSEC=

# sentries.anchorMinDistanceM - Internal: shortest distance from the surface of the anchor (gate, NPC station, own Upwell structure)
# Not in the launcher. Range 0..50000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_SENTRIES_ANCHOR_MIN_DISTANCE_M=

# sentries.anchorMaxDistanceM - Internal: longest distance from the surface of the anchor (must be > anchorMinDistanceM, else no start)
# Not in the launcher. Range 1000..250000 (outside: clamped).
# Default: 30000.
# EVEJS_LNE_SENTRIES_ANCHOR_MAX_DISTANCE_M=

# sentries.minSpacingM - Internal: least distance between two anchored sentries
# Not in the launcher. Range 0..50000 (outside: clamped).
# Default: 2000.
# EVEJS_LNE_SENTRIES_MIN_SPACING_M=

# sentries.armDelayMs - Internal: a sentry may shoot this long after it was anchored
# Not in the launcher. Range 0..3600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_SENTRIES_ARM_DELAY_MS=

# sentries.accessRangeM - Internal: ammo of a sentry within this surface distance of the ship
# Not in the launcher. Range 500..50000 (outside: clamped).
# Default: 2500.
# EVEJS_LNE_SENTRIES_ACCESS_RANGE_M=

# sentries.maxPerAnchor - Internal: live sentries at one anchor
# Not in the launcher. Range 1..32 (outside: clamped).
# Default: 6.
# EVEJS_LNE_SENTRIES_MAX_PER_ANCHOR=

# sentries.player.maxPerSystemPerOwner - Internal: live sentries of one corporation in one system
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 6.
# EVEJS_LNE_SENTRIES_PLAYER_MAX_PER_SYSTEM_PER_OWNER=

# sentries.player.maxPerOwner - Internal: live sentries of one corporation
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 30.
# EVEJS_LNE_SENTRIES_PLAYER_MAX_PER_OWNER=

# sentries.player.free* - the free anchor (anchor_kind space)
# of a player sentry with no gate / station / structure in the band, e.g. in a belt or a mining anomaly. Not in the
# launcher.
# sentries.player.freeEnabled - a sentry may anchor anywhere far enough from every anchor. Default: false.
# EVEJS_LNE_SENTRIES_PLAYER_FREE_ENABLED=0
# sentries.player.freeClearanceM - least surface distance to every stargate, station and structure (at least
# anchorMinDistanceM). Range 0..2000000 (outside: clamped). Default: 150000.
# EVEJS_LNE_SENTRIES_PLAYER_FREE_CLEARANCE_M=
# sentries.player.freeMaxPerSystemPerOwner - live free sentries of one corporation in one system. Range 0..16. Default: 3.
# EVEJS_LNE_SENTRIES_PLAYER_FREE_MAX_PER_SYSTEM_PER_OWNER=
# sentries.player.freeMaxPerOwner - live free sentries of one corporation. Range 0..200. Default: 12.
# EVEJS_LNE_SENTRIES_PLAYER_FREE_MAX_PER_OWNER=

# listeningPost.* - the listening post 340520 (customTypes pack
# listening-post) anchored by the player sentry path; no weapon, dps 0 in a battle, a battle target only while its
# owner corporation is online. Not in the launcher.
# listeningPost.enabled - players may anchor a listening post (off = SENTRY_KIND_DISABLED). Default: false.
# EVEJS_LNE_LISTENING_POST_ENABLED=0
# listeningPost.secClasses - security classes of a listening post (lowsec|nullsec|wormhole). Default: lowsec,nullsec.
# EVEJS_LNE_LISTENING_POST_SEC_CLASSES=
# listeningPost.maxPerSystemPerOwner - live posts of one corporation in one system. Range 0..8. Default: 1.
# EVEJS_LNE_LISTENING_POST_MAX_PER_SYSTEM_PER_OWNER=
# listeningPost.maxPerOwner - live posts of one corporation. Range 0..100. Default: 5.
# EVEJS_LNE_LISTENING_POST_MAX_PER_OWNER=
# listeningPost.maxPerSystem - live posts of every corporation in one system. Range 0..16. Default: 3.
# EVEJS_LNE_LISTENING_POST_MAX_PER_SYSTEM=
# an armed post reports the virtual fleets entering its system (table
# world_post_sightings, LISTENING_POST_SIGHTING; service listeningPost, module strategy).
# listeningPost.rangeJumps - watched systems: 0 = the post system, 1 = also its gate neighbours. Range 0..1. Default: 0.
# EVEJS_LNE_LISTENING_POST_RANGE_JUMPS=
# listeningPost.maxChecksPerLeg - sighting checks of one fleet leg. Range 1..16. Default: 4.
# EVEJS_LNE_LISTENING_POST_MAX_CHECKS_PER_LEG=
# listeningPost.maxEnqueuesPerTransaction - sighting rows of one departure transaction. Range 1..8. Default: 2.
# EVEJS_LNE_LISTENING_POST_MAX_ENQUEUES_PER_TRANSACTION=
# listeningPost.maxSightingsPerPass - sighting events of one scheduler pass. Range 1..256. Default: 16.
# EVEJS_LNE_LISTENING_POST_MAX_SIGHTINGS_PER_PASS=
# listeningPost.smallMaxShips - at most this many ships = size class small. Range 1..64. Default: 5.
# EVEJS_LNE_LISTENING_POST_SMALL_MAX_SHIPS=
# listeningPost.largeMinShips - at least this many ships = size class large. Range 2..2000. Default: 20.
# EVEJS_LNE_LISTENING_POST_LARGE_MIN_SHIPS=
# listeningPost.sightingRetentionMs - age of a sighting row before deletion. Range 3600000..604800000. Default: 86400000.
# EVEJS_LNE_LISTENING_POST_SIGHTING_RETENTION_MS=
# listeningPost.pruneBatch - old sighting rows deleted by one sighting. Range 1..500. Default: 50.
# EVEJS_LNE_LISTENING_POST_PRUNE_BATCH=
# listeningPost.watchRefreshMs - rebuild interval of the watched systems. Range 5000..600000. Default: 60000.
# EVEJS_LNE_LISTENING_POST_WATCH_REFRESH_MS=
# the sighting mail (notices lines LP_SIGHTING / LP_SIGHTING_LARGE for the members of the
# post owner; needs notices.enabled) and the map markers (ctx.listeningPosts.markersFor, observer layer).
# listeningPost.mailEnabled - mail the members of the corporations watching the system. Default: 0.
# EVEJS_LNE_LISTENING_POST_MAIL_ENABLED=
# listeningPost.mailMaxRecipients - members of one corporation per sighting. Range 1..50. Default: 10.
# EVEJS_LNE_LISTENING_POST_MAIL_MAX_RECIPIENTS=
# listeningPost.maxCorpsPerSighting - corporations mailed per sighting. Range 1..16. Default: 4.
# EVEJS_LNE_LISTENING_POST_MAX_CORPS_PER_SIGHTING=
# listeningPost.mapMaxMarkers - markers of one markersFor call. Range 1..500. Default: 50.
# EVEJS_LNE_LISTENING_POST_MAP_MAX_MARKERS=
# listeningPost.mapWindowMs - age of sightings in the markers and the observer layer. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_LISTENING_POST_MAP_WINDOW_MS=

# sentries.heavy.* - the heavy sentry 340522-340525
# (customTypes pack heavy-sentries, clones of the large batteries, XL ammo) anchored by the player sentry path; own
# limits, counted apart from the small sentries. Not in the launcher.
# sentries.heavy.enabled - players may anchor a heavy sentry (off = SENTRY_KIND_DISABLED). Default: false.
# EVEJS_LNE_SENTRIES_HEAVY_ENABLED=0
# sentries.heavy.secClasses - security classes of a heavy sentry (highsec|lowsec|nullsec|wormhole).
# Default: lowsec,nullsec,wormhole.
# EVEJS_LNE_SENTRIES_HEAVY_SEC_CLASSES=
# sentries.heavy.maxPerSystem - live heavy sentries of every corporation in one system. Range 0..16. Default: 2.
# EVEJS_LNE_SENTRIES_HEAVY_MAX_PER_SYSTEM=
# sentries.heavy.maxPerSystemPerOwner - live heavy sentries of one corporation in one system. Range 0..8. Default: 1.
# EVEJS_LNE_SENTRIES_HEAVY_MAX_PER_SYSTEM_PER_OWNER=
# sentries.heavy.maxPerOwner - live heavy sentries of one corporation. Range 0..100. Default: 4.
# EVEJS_LNE_SENTRIES_HEAVY_MAX_PER_OWNER=
# sentries.heavy.battleDpsPermille - heavy sentry DPS in the virtual battle x this / 1000. Range 0..5000. Default: 1000.
# EVEJS_LNE_SENTRIES_HEAVY_BATTLE_DPS_PERMILLE=
# sentries.heavy.designSig - heavy sentry design signature in the virtual battle (0 = type attr 620 or sentries.battle.defaultDesignSig). Range 0..100000. Default: 125.
# EVEJS_LNE_SENTRIES_HEAVY_DESIGN_SIG=
# sentries.heavy.missileDpsPermille - heavy missile sentry DPS in the virtual battle x this / 1000 (after battleDpsPermille). Range 0..5000. Default: 440.
# EVEJS_LNE_SENTRIES_HEAVY_MISSILE_DPS_PERMILLE=
# sentries.heavy.allowFree - a heavy sentry may take the free anchor (with sentries.player.freeEnabled). Default: true.
# EVEJS_LNE_SENTRIES_HEAVY_ALLOW_FREE=
# sentries.heavy.lookTypeId - type whose model a heavy sentry shows: 0 = the Large battery, 1194 or 3739-3743 (other = W154, look off). Range 0..100000. Default: 3740.
# EVEJS_LNE_SENTRIES_HEAVY_LOOK_TYPE_ID=
# sentries.heavy.lookMode - graphic = slimGraphicID only; type = also slimTypeID of the look type. Default: graphic.
# EVEJS_LNE_SENTRIES_HEAVY_LOOK_MODE=

# sentries.maxTotal - Internal: live sentries on the server
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 500.
# EVEJS_LNE_SENTRIES_MAX_TOTAL=

# sentries.maxAnchorsRead - Internal: anchors (gates, stations, structures) of one system read by an anchoring
# Not in the launcher. Range 8..1024 (outside: clamped).
# Default: 64.
# EVEJS_LNE_SENTRIES_MAX_ANCHORS_READ=

# sentries.slowDeployLogMs - Internal: a SENTRY_DEPLOY slower than this logs its phase timings (0 = off)
# Not in the launcher. Range 0..60000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_SENTRIES_SLOW_DEPLOY_LOG_MS=

# sentries.reconcileIntervalMs - Internal: period of SENTRY_RECONCILE
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 600000.
# EVEJS_LNE_SENTRIES_RECONCILE_INTERVAL_MS=

# sentries.reconcileMaxRows - Internal: sentry rows of one reconcile page (cursor continues)
# Not in the launcher. Range 10..5000 (outside: clamped).
# Default: 200.
# EVEJS_LNE_SENTRIES_RECONCILE_MAX_ROWS=

# sentries.maxHealsPerPass - Internal: offline anchored sentries put back online by one reconcile
# Not in the launcher. Range 0..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_SENTRIES_MAX_HEALS_PER_PASS=

# sentries.retentionMs - Internal: ended sentry rows older than this are deleted by the reconcile
# Not in the launcher. Range 3600000..7776000000 (outside: clamped).
# Default: 604800000.
# EVEJS_LNE_SENTRIES_RETENTION_MS=

# sentries.pruneBatch - Internal: ended sentry rows deleted by one reconcile
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_SENTRIES_PRUNE_BATCH=

# sentries.live.maxEngagesPerPass - Internal: battery activations (engage) of one materialization pass
# Not in the launcher. Range 1..512 (outside: clamped).
# Default: 32.
# EVEJS_LNE_SENTRIES_LIVE_MAX_ENGAGES_PER_PASS=

# sentries.live.maxStandingReadsPerPass - Internal: standing reads (owner -> LNE faction) of one pass
# Not in the launcher. Range 1..1024 (outside: clamped).
# Default: 32.
# EVEJS_LNE_SENTRIES_LIVE_MAX_STANDING_READS_PER_PASS=

# sentries.live.proxyDpsPerShip - Internal: proxy damage per second of one hostile LNE ship (0 = off)
# Not in the launcher. Range 0..100000 (outside: clamped).
# Default: 100.
# EVEJS_LNE_SENTRIES_LIVE_PROXY_DPS_PER_SHIP=

# sentries.live.proxyRangeM - Internal: range of the proxy fire of LNE ships on a sentry
# Not in the launcher. Range 1000..500000 (outside: clamped).
# Default: 50000.
# EVEJS_LNE_SENTRIES_LIVE_PROXY_RANGE_M=

# sentries.live.maxProxyHitsPerPass - Internal: sentries hit by proxy fire in one pass
# Not in the launcher. Range 0..512 (outside: clamped).
# Default: 16.
# EVEJS_LNE_SENTRIES_LIVE_MAX_PROXY_HITS_PER_PASS=

# Faction sentries. On by default since.

# sentries.faction.enabled - Internal: factions build sentries at their stations and border gates (off = no plan, no build, no top-up)
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_SENTRIES_FACTION_ENABLED=

# sentries.faction.allowHighsec - Internal: a faction sentry may be built in high-security space
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_SENTRIES_FACTION_ALLOW_HIGHSEC=

# sentries.faction.costIsk - Internal: ISK of one faction sentry from the treasury (warSpend, no refund)
# Not in the launcher. Range 0..1000000000000 (outside: clamped).
# Default: 30000000.
# EVEJS_LNE_SENTRIES_FACTION_COST_ISK=

# sentries.faction.minBalanceMultiple - Internal: the planner builds only with a treasury balance >= costIsk x this
# Not in the launcher. Range 1..1000 (outside: clamped).
# Default: 5.
# EVEJS_LNE_SENTRIES_FACTION_MIN_BALANCE_MULTIPLE=

# sentries.faction.maxPerFaction - Internal: live sentries of one faction (built + pending): 24 -> 60
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 60.
# EVEJS_LNE_SENTRIES_FACTION_MAX_PER_FACTION=

# sentries.faction.maxPerSystem - Internal: live sentries of one faction in one system
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 6.
# EVEJS_LNE_SENTRIES_FACTION_MAX_PER_SYSTEM=

# sentries.faction.maxBuildsPerReview - Internal: SENTRY_BUILD intents of one strategy review: stays 1 (2 = review bound 1005 > maxRowsPerTransaction 1000)
# Not in the launcher. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_SENTRIES_FACTION_MAX_BUILDS_PER_REVIEW=

# sentries.faction.maxCandidateSystems - Internal: own systems read as sentry sites by one review
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_SENTRIES_FACTION_MAX_CANDIDATE_SYSTEMS=

# sentries.faction.buildDelayMs - Internal: time from the build request to the deploy of a faction sentry
# Not in the launcher. Range 0..604800000 (outside: clamped).
# Default: 7200000.
# EVEJS_LNE_SENTRIES_FACTION_BUILD_DELAY_MS=

# sentries.faction.ringDistanceM - Internal: distance of the faction sentry ring from the anchor surface (clipped to the anchor band)
# Not in the launcher. Range 1000..250000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_SENTRIES_FACTION_RING_DISTANCE_M=

# sentries.faction.topUpBelowPermille - Internal: ammo of a faction sentry is topped up below this share of its capacity
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 250.
# EVEJS_LNE_SENTRIES_FACTION_TOP_UP_BELOW_PERMILLE=

# sentries.faction.maxTopUpsPerPass - Internal: faction sentries checked for an ammo top-up by one reconcile (unloaded scenes only)
# Not in the launcher. Range 0..256 (outside: clamped).
# Default: 4.
# EVEJS_LNE_SENTRIES_FACTION_MAX_TOP_UPS_PER_PASS=

# The round of the chain creates one VIRTUAL battle of the
# hostile fleets against the sentries; projects the sentry damage to EveJS (one-way attrition removed). Off until verified in the game.

# sentries.battle.enabled - Internal: a round with hostile fleets holding the field of a system without a player creates a battle against the sentries (off = no battle round, the sentries take no damage off-scene)
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_SENTRIES_BATTLE_ENABLED=

# sentries.battle.roundMs - Internal: length of one battle round (rounds start at multiples of it)
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 900000.
# EVEJS_LNE_SENTRIES_BATTLE_ROUND_MS=

# sentries.battle.maxFleetsRead - Internal: fleets of a system read by one battle round
# Not in the launcher. Range 1..512 (outside: clamped).
# Default: 32.
# EVEJS_LNE_SENTRIES_BATTLE_MAX_FLEETS_READ=

# sentries.battle.maxStandingReads - Internal: standing reads (owner of a player sentry -> fleet faction) of one round; over it = not hostile
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_SENTRIES_BATTLE_MAX_STANDING_READS=

# sentries.battle.maxSystemsPerBootstrap - Internal: systems with sentries checked for hostile holders at the start and per reconcile round
# Not in the launcher. Range 1..4096 (outside: clamped).
# Default: 64.
# EVEJS_LNE_SENTRIES_BATTLE_MAX_SYSTEMS_PER_BOOTSTRAP=

# sentries.battle.maxSentriesPerBattle - Internal: hostile sentries of one battle (sentryId order)
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 12.
# EVEJS_LNE_SENTRIES_BATTLE_MAX_SENTRIES_PER_BATTLE=

# sentries.battle.dpsPermille - Internal: share of the DPS of the sentry type (SDE, default ammo) used in the battle
# Not in the launcher. Range 0..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_SENTRIES_BATTLE_DPS_PERMILLE=

# sentries.battle.damageTakenPermille - Internal: damage taken by a sentry in the battle per mille (ehp = hp x 1000 / this)
# Not in the launcher. Range 1..10000 (outside: clamped).
# Default: 1000.
# EVEJS_LNE_SENTRIES_BATTLE_DAMAGE_TAKEN_PERMILLE=

# sentries.battle.attackerRetreatLossPermille - Internal: the attacking fleets retreat once their losses reach this share of their EHP
# Not in the launcher. Range 50..1000 (outside: clamped).
# Default: 300.
# EVEJS_LNE_SENTRIES_BATTLE_ATTACKER_RETREAT_LOSS_PERMILLE=

# sentries.battle.defaultDesignSig - Internal: design signature of a sentry type without optimalSigRadius (the missile battery)
# Not in the launcher. Range 1..100000 (outside: clamped).
# Default: 125.
# EVEJS_LNE_SENTRIES_BATTLE_DEFAULT_DESIGN_SIG=

# sentries.battle.gridEnabled - Internal: grid: sentry battles, the LIVE hold and the garrison eyes per grid (off = the system rule)
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_SENTRIES_BATTLE_GRID_ENABLED=

# LIVE hold of a hostile fleet STAGED under
# live hostile sentries in the system of a player (fleet exposure kind SENTRY). Off until verified in the game.

# sentries.liveHold.enabled - Internal: a hostile fleet STAGED under live hostile sentries in the system of a player gets EveJS ships at the sentry and fights it (one settlement through the fleet exposure lock)
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_ENABLED=

# sentries.liveHold.scanIntervalMs - Internal: shortest time between two scans for new holds
# Not in the launcher. Range 1000..600000 (outside: clamped).
# Default: 15000.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_SCAN_INTERVAL_MS=

# sentries.liveHold.maxSystemsPerScan - Internal: systems read by one scan (rotating cursor)
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_MAX_SYSTEMS_PER_SCAN=

# sentries.liveHold.maxFleetsPerSystem - Internal: STAGED fleets of one system read by one scan
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_MAX_FLEETS_PER_SYSTEM=

# sentries.liveHold.maxNewPerPass - Internal: new holds started in one pass
# Not in the launcher. Range 1..16 (outside: clamped).
# Default: 2.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_MAX_NEW_PER_PASS=

# sentries.liveHold.maxHeld - Internal: holds at the same time on the server
# Not in the launcher. Range 1..128 (outside: clamped).
# Default: 8.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_MAX_HELD=

# sentries.liveHold.maxShipsPerHold - Internal: ships of one hold (the first members by member key)
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 12.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_MAX_SHIPS_PER_HOLD=

# sentries.liveHold.spawnDistanceM - Internal: spawn distance of the hold ships from the anchor sentry
# Not in the launcher. Range 1000..250000 (outside: clamped).
# Default: 20000.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_SPAWN_DISTANCE_M=

# sentries.liveHold.warningMs - Internal: time from the spawn to the first shot (both sides)
# Not in the launcher. Range 0..600000 (outside: clamped).
# Default: 30000.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_WARNING_MS=

# sentries.liveHold.maxHeldMs - Internal: a hold ends TIMEOUT after this time
# Not in the launcher. Range 60000..86400000 (outside: clamped).
# Default: 3600000.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_MAX_HELD_MS=

# sentries.liveHold.exitWarpMaxMs - Internal: longest retreat warp before the hold ends RETREAT
# Not in the launcher. Range 5000..600000 (outside: clamped).
# Default: 60000.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_EXIT_WARP_MAX_MS=

# sentries.liveHold.respawnCooldownMs - Internal: no new hold of the same fleet for this time after the end (memory)
# Not in the launcher. Range 0..86400000 (outside: clamped).
# Default: 1800000.
# EVEJS_LNE_SENTRIES_LIVE_HOLD_RESPAWN_COOLDOWN_MS=

# sentries.live.proxyDpsFromCatalog - Internal: the proxy fire of a ship = dps of its hull group in the strength table (no row = proxyDpsPerShip); proxyDpsPerShip 0 still turns the proxy fire off
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_SENTRIES_LIVE_PROXY_DPS_FROM_CATALOG=

# sentries.live.proxySplitEnabled - Internal: every LNE ship gives its proxy dps to one sentry per pass (the nearest hostile to it within proxyRangeM, tie: lower itemId); off = every sentry in range takes the full dps
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_SENTRIES_LIVE_PROXY_SPLIT_ENABLED=

# sentries.live.defendEnabled - Internal: a player sentry also shoots vendor NPCs hostile to players and every NPC targeting the owner / its corp (first); off = only the LNE ships hostile to the owner, as before
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_SENTRIES_LIVE_DEFEND_ENABLED=

# sentries.live.defendMaxSceneScan - Internal: scene entities read per system and pass (over it = sentries.defendScanTruncated)
# Not in the launcher. Range 16..4096 (outside: clamped).
# Default: 512.
# EVEJS_LNE_SENTRIES_LIVE_DEFEND_MAX_SCENE_SCAN=

# sentries.live.defendMaxCandidates - Internal: defend candidates per sentry after the sort
# Not in the launcher. Range 1..512 (outside: clamped).
# Default: 64.
# EVEJS_LNE_SENTRIES_LIVE_DEFEND_MAX_CANDIDATES=

# sentries.live.maxEngageTriesPerSentry - Internal: sentry brief step 6 /: engage calls (refused ones too) per sentry and pass
# Not in the launcher. Range 1..64 (outside: clamped).
# Default: 3.
# EVEJS_LNE_SENTRIES_LIVE_MAX_ENGAGE_TRIES_PER_SENTRY=

# sentries.live.defendRefuseTtlPasses - Internal: with defendEnabled a refused engage of a player sentry on an entity is not tried again for this many pump passes (no try, no engage budget; sentries.defendRefuseSkipped); 0 = no memory
# Not in the launcher. Range 0..1000 (outside: clamped).
# Default: 10.
# EVEJS_LNE_SENTRIES_LIVE_DEFEND_REFUSE_TTL_PASSES=

# sentries.live.defendRefuseMaxEntries - Internal: (sentry, entity) refusals kept in RAM; full = expired ones out, then the oldest
# Not in the launcher. Range 16..65536 (outside: clamped).
# Default: 4096.
# EVEJS_LNE_SENTRIES_LIVE_DEFEND_REFUSE_MAX_ENTRIES=

# sentries.live.defendPlayersEnabled - Internal: with defendEnabled a player sentry also shoots a pilot with an active limited engagement with the owner character and a lock on the owner ship / corp ship / corp sentry (W202 without defendEnabled); off = no pilot is a candidate
# Not in the launcher. Range: true/false.
# Default: false.
# EVEJS_LNE_SENTRIES_LIVE_DEFEND_PLAYERS_ENABLED=

# sentries.live.defendMaxPlayerReadsPerPass - Internal: vendor LE reads per pump pass for all sentries (over it = no pilot target this pass, sentries.defendPlayerDeferred)
# Not in the launcher. Range 1..256 (outside: clamped).
# Default: 16.
# EVEJS_LNE_SENTRIES_LIVE_DEFEND_MAX_PLAYER_READS_PER_PASS=

# NOTE: After deploying, remove any EVEJS_LNE_SENTRIES_ATTRITION_* lines from your local.env file.
# They are no longer valid settings and will produce a "not a setting" config warning.

# random invasions. On by default since (Sleepers withdraw).: values = config.js SCHEMA.
# invasions.enabled - Internal: switch of the invasions service. 0 = no handlers, state frozen, events park.
# Not in the launcher. Range: true/false.
# Default: true.
# EVEJS_LNE_INVASIONS_ENABLED=

# invasions.chancePermille - Internal: chance per roll window (per mille). Range 0..1000 (outside: clamped).
# Default: 250.
# EVEJS_LNE_INVASIONS_CHANCE_PERMILLE=

# invasions.maxActive - Internal: max concurrent invasions globally. Range 0..16 (outside: clamped).
# Default: 3.
# EVEJS_LNE_INVASIONS_MAX_ACTIVE=

# invasions.maxActivePerFaction - Internal: max concurrent invasions per invader faction. Range 0..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_INVASIONS_MAX_ACTIVE_PER_FACTION=

# invasions.weightFree - Internal: weight of a STABLE system without a controller. Range 0..100 (outside: clamped).
# Default: 3.
# EVEJS_LNE_INVASIONS_WEIGHT_FREE=

# invasions.weightActive - Internal: weight of a STABLE system controlled by an ACTIVE faction that
# fields defense (fieldsDefense). Range 0..100 (outside: clamped).
# Default: 100 (rollProbe on the base).
# EVEJS_LNE_INVASIONS_WEIGHT_ACTIVE=

# invasions.weightControlled - Internal: weight of a STABLE system with another controller (passive, invader,
# CONCORD). weightActive = weightControlled = 1 restores equal weights. Range 0..100 (outside: clamped).
# Default: 1.
# EVEJS_LNE_INVASIONS_WEIGHT_CONTROLLED=

# invasions.avoidObservedSystems - Internal: skip systems with player presence in the roll. Not in the launcher.
# Default: true.
# EVEJS_LNE_INVASIONS_AVOID_OBSERVED_SYSTEMS=

# invasions.avoidStationSystems - Internal: skip systems with live stations in the roll. Not in the launcher.
# Default: true.
# EVEJS_LNE_INVASIONS_AVOID_STATION_SYSTEMS=

# invasions.avoidCampaignTheatres - Internal: skip systems inside active campaign theatres in the roll. Not in the launcher.
# Default: true.
# EVEJS_LNE_INVASIONS_AVOID_CAMPAIGN_THEATRES=

# invasions.requireSovCheck - Internal: skip systems with a player sov claim (via sovClaims adapter). Not in the launcher.
# Default: true.
# EVEJS_LNE_INVASIONS_REQUIRE_SOV_CHECK=

# invasions.beachheadCaptureRangeJumps - Internal: capture range from the beachhead in jumps (clamped to graph.routeMaxJumps). Range 0..10 (outside: clamped).
# Default: 3.
# EVEJS_LNE_INVASIONS_BEACHHEAD_CAPTURE_RANGE_JUMPS=

# invasions.targetSampleSize - Internal: systems sampled per roll for sov/observation/station checks. Range 1..256 (outside: clamped).
# Default: 64.
# EVEJS_LNE_INVASIONS_TARGET_SAMPLE_SIZE=

# invasions.rollIntervalMs - Internal: interval of the invasion roll window in ms (virtual time). Range 900000..604800000 (outside: clamped).
# Default: 21600000 (6 h).
# EVEJS_LNE_INVASIONS_ROLL_INTERVAL_MS=

# invasions.checkIntervalMs - Internal: interval of the invasion step check in ms (virtual time). Range 60000..86400000 (outside: clamped).
# Default: 600000 (10 min).
# EVEJS_LNE_INVASIONS_CHECK_INTERVAL_MS=

# invasions.holdMinFleets - Internal: minimum holder fleets in the beachhead to avoid collapse. Range 1..8 (outside: clamped).
# Default: 1.
# EVEJS_LNE_INVASIONS_HOLD_MIN_FLEETS=

# invasions.reviewFootholdsEnabled - Internal: invader-footholds-review: the AI review of an invader faction gets its ACTIVE footholds (capture range) and keeps invasions.holdMinFleets fleets in them; off = no footholds. Range: true/false.
# Default: false.
# EVEJS_LNE_INVASIONS_REVIEW_FOOTHOLDS_ENABLED=

# invasions.refitAtFootholdEnabled - Internal: invader-refit-at-foothold: an ACTIVE foothold repairs the invader's fleets (travel refit only); off = stations + hive. Range: true/false.
# Default: false.
# EVEJS_LNE_INVASIONS_REFIT_AT_FOOTHOLD_ENABLED=

# invasions.homeBaseEnabled - Internal: deathless-inactive: the controlled HQ of an invader faction is a capture anchor like a foothold (occupation range; the review needs reviewFootholdsEnabled); off = footholds only. Range: true/false.
# Default: false.
# EVEJS_LNE_INVASIONS_HOME_BASE_ENABLED=

# invasions.homeCaptureRangeJumps - Internal: deathless-inactive: capture range from the invader home in jumps (clamped to graph.routeMaxJumps). Range 0..10 (outside: clamped).
# Default: 3.
# EVEJS_LNE_INVASIONS_HOME_CAPTURE_RANGE_JUMPS=

# invasions.refitAtHomeEnabled - Internal: deathless-inactive: the controlled HQ of an invader faction repairs its fleets (travel refit only; needs homeBaseEnabled); off = stations + hive + footholds. Range: true/false.
# Default: false.
# EVEJS_LNE_INVASIONS_REFIT_AT_HOME_ENABLED=

# invasions.maxFleetsReadPerStep - Internal: max fleets read per step (truncation -> safe HOLD). Range 8..512 (outside: clamped).
# Default: 64.
# EVEJS_LNE_INVASIONS_MAX_FLEETS_READ_PER_STEP=

# invasions.maxStepsPerPass - Internal: maxPerPass of the INVASION_STEP handler. Range 1..64 (outside: clamped).
# Default: 4.
# EVEJS_LNE_INVASIONS_MAX_STEPS_PER_PASS=

# invasions.retentionMs - Internal: ended invasions older than this are pruned (totals survive). Range 86400000..31536000000 (outside: clamped).
# Default: 2592000000 (30 days).
# EVEJS_LNE_INVASIONS_RETENTION_MS=

# invasions.pruneBatch - Internal: ended invasions pruned per roll (journal-free). Range 0..500 (outside: clamped).
# Default: 50.
# EVEJS_LNE_INVASIONS_PRUNE_BATCH=

# Sleepers withdrawal config
# invasions.sleeperWithdrawAfterMs - Internal: Sleepers withdraw after this time in ms. Range 3600000..2592000000 (outside: clamped).
# Default: 259200000 (72 h).
# EVEJS_LNE_INVASIONS_SLEEPER_WITHDRAW_AFTER_MS=

# Triglavian / Deathless withdrawal, 0 = never
# invasions.triglavianWithdrawAfterMs - Internal: Triglavian withdraw after this time in ms, 0 = never. Range 0..2592000000 (outside: clamped).
# Default: 432000000 (120 h).
# EVEJS_LNE_INVASIONS_TRIGLAVIAN_WITHDRAW_AFTER_MS=

# invasions.deathlessWithdrawAfterMs - Internal: Deathless withdraw after this time in ms, 0 = never. Range 0..2592000000 (outside: clamped).
# Default: 345600000 (96 h).
# EVEJS_LNE_INVASIONS_DEATHLESS_WITHDRAW_AFTER_MS=

# Drifters 500024 as an invader behind a flag
# invasions.drifters.enabled - Internal: Drifters join the invasion roll (registry flag drifters); off = not active.
# Default: false.
# EVEJS_LNE_INVASIONS_DRIFTERS_ENABLED=

# Drifter targets from the vendor Jove observatory list
# invasions.drifters.originObservatories - Internal: Drifter targets only in Jove observatory systems; no list = no filter.
# Default: false.
# EVEJS_LNE_INVASIONS_DRIFTERS_ORIGIN_OBSERVATORIES=

# invasions.drifterWithdrawAfterMs - Internal: Drifters withdraw after this time in ms, 0 = never. Range 0..2592000000 (outside: clamped).
# Default: 259200000 (72 h).
# EVEJS_LNE_INVASIONS_DRIFTER_WITHDRAW_AFTER_MS=

# invasions.withdrawRetryMs - Internal: interval between withdrawal rounds in ms. Range 60000..86400000 (outside: clamped).
# Default: 900000 (15 min).
# EVEJS_LNE_INVASIONS_WITHDRAW_RETRY_MS=

# invasions.withdrawMaxRounds - Internal: maximum withdrawal rounds before timeout. Range 1..96 (outside: clamped).
# Default: 16.
# EVEJS_LNE_INVASIONS_WITHDRAW_MAX_ROUNDS=

# Open invasions in the native Incursions UI of the client
# (Journal -> Incursions, map overlay). Off by default; turn on only for a client check.
# invasions.incursionUi.enabled - Internal: publish open invasions into the vendor Incursions list. Range: true/false.
# Default: false.
# EVEJS_LNE_INVASIONS_INCURSION_UI_ENABLED=

# invasions.incursionUi.maxEntries - Internal: max invasions published (0 = empty list). Range 0..64 (outside: clamped).
# Default: 16.
# EVEJS_LNE_INVASIONS_INCURSION_UI_MAX_ENTRIES=

# invasions.incursionUi.templateNameID - Internal: client localization id of the incursion name (0 = none; on a client
# exception use the Sansha template id). Range 0..2147483647 (outside: clamped). Default: 0.
# EVEJS_LNE_INVASIONS_INCURSION_UI_TEMPLATE_NAME_ID=

# invasions.incursionUi.refreshMs - Internal: interval of the publish timer in ms. Range 5000..3600000 (outside:
# clamped). Default: 60000.
# EVEJS_LNE_INVASIONS_INCURSION_UI_REFRESH_MS=

# the Rogue Drones hive. Off by default; do not switch it on before.
# All keys internal: not in the launcher, values outside the range are clamped.
# hive.enabled - Switch of the hive. 0 = Rogue Drones do not play (registry, seed and reviews as before).
# Range: true/false. Default: false.
# EVEJS_LNE_HIVE_ENABLED=

# hive.nodesPerRegion - Hive nodes per home region (stateless, picked from the gate graph). Range 1..16. Default: 3.
# EVEJS_LNE_HIVE_NODES_PER_REGION=

# hive.nodeCaptureRangeJumps - Capture range of an active node in jumps. Range 0..40. Default: 10.
# EVEJS_LNE_HIVE_NODE_CAPTURE_RANGE_JUMPS=

# hive.fleetsPerNode - Standing hive fleets per node. Range 0..8. Default: 1.
# EVEJS_LNE_HIVE_FLEETS_PER_NODE=

# hive.maxFleets - Ceiling of the hive fleets. Range 0..200. Default: 20.
# EVEJS_LNE_HIVE_MAX_FLEETS=

# hive.maxFrontsPerAttacker - Fronts one attacker may hold on hive space. Range 0..16. Default: 1.
# EVEJS_LNE_HIVE_MAX_FRONTS_PER_ATTACKER=

# hive.assumedGarrisonFleets - Hive strength an attacker assumes per system. Range 0..32. Default: 2.
# EVEJS_LNE_HIVE_ASSUMED_GARRISON_FLEETS=

# hive.captureSlowFactor - Pace divisor of a capture of hive home. Range 1..20. Default: 3.
# EVEJS_LNE_HIVE_CAPTURE_SLOW_FACTOR=

# The swarm wave of the hive (one LAUNCH of fresh fleets on a lost home per bucket).
# hive.swarmEnabled - Switch of the swarm wave. 0 = no wave, no marker read (the review as before).
# Range: true/false. Default: false.
# EVEJS_LNE_HIVE_SWARM_ENABLED=

# hive.swarmThresholdUnits - Resource left in the review above which the hive sends a wave. Range 0..1000000000.
# Default: 100000.
# EVEJS_LNE_HIVE_SWARM_THRESHOLD_UNITS=

# hive.swarmCooldownMs - Bucket of one wave (floor(at / cooldownMs)). Range 3600000..2592000000. Default: 259200000.
# EVEJS_LNE_HIVE_SWARM_COOLDOWN_MS=

# hive.swarmFleets - Fresh fleets of one wave (above hive.maxFleets). Range 1..16. Default: 6.
# EVEJS_LNE_HIVE_SWARM_FLEETS=

# hive.swarmMaxJumps - BFS range from the target to the start node. Range 1..40. Default: 10.
# EVEJS_LNE_HIVE_SWARM_MAX_JUMPS=

# event sites pump (module modules.sites - Danger, off by default: EVEJS_LNE_SITES_ENABLED).
# All keys internal: not in the launcher, values outside the range are clamped.
# sites.pumpIntervalMs - Interval between pump passes. Range 1000..60000. Default: 5000.
# EVEJS_LNE_SITES_PUMP_INTERVAL_MS=

# sites.pollIntervalMs - Read of an ACTIVE site (completion, loss). Range 5000..600000. Default: 30000.
# EVEJS_LNE_SITES_POLL_INTERVAL_MS=

# sites.maxRowsPerPass - Site rows per pump pass. Range 1..256. Default: 32.
# EVEJS_LNE_SITES_MAX_ROWS_PER_PASS=

# sites.maxWritesPerPass - EveJS writes per pump pass (each is O(N) of the dungeon table). Range 1..16. Default: 2.
# EVEJS_LNE_SITES_MAX_WRITES_PER_PASS=

# sites.maxActiveSites - Live site rows in the world. Range 1..256. Default: 32.
# EVEJS_LNE_SITES_MAX_ACTIVE_SITES=

# sites.maxSlotsPerEvent - Sites of one event. Range 1..8. Default: 4.
# EVEJS_LNE_SITES_MAX_SLOTS_PER_EVENT=

# sites.newSiteWindowMs - Window of limits.maxNewSitesPerSystemPerWindow. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_SITES_NEW_SITE_WINDOW_MS=

# sites.vendorExpiryGraceMs - Vendor safety expiry after the end of the event. Range 0..86400000. Default: 3600000.
# EVEJS_LNE_SITES_VENDOR_EXPIRY_GRACE_MS=

# sites.purgeDelayMs - Grace before the purge of a despawned site. Range 0..86400000. Default: 600000.
# EVEJS_LNE_SITES_PURGE_DELAY_MS=

# sites.retryDelayMs - Retry after an error or a deferral. Range 1000..3600000. Default: 60000.
# EVEJS_LNE_SITES_RETRY_DELAY_MS=

# sites.maxCreateAttempts - Attempts after CREATE_FAILED. Range 1..10. Default: 3.
# EVEJS_LNE_SITES_MAX_CREATE_ATTEMPTS=

# sites.maxRecreate - Recreations after a lost site. Range 0..5. Default: 1.
# EVEJS_LNE_SITES_MAX_RECREATE=

# sites.placementBaseDistanceAu - Distance from the anchor in AU. Range 0.5..20. Default: 4.
# EVEJS_LNE_SITES_PLACEMENT_BASE_DISTANCE_AU=

# sites.rowRetentionMs - Retention of PURGED / FAILED rows. Range 3600000..2592000000. Default: 604800000.
# EVEJS_LNE_SITES_ROW_RETENTION_MS=

# sites.durableCreate - Flush of the dungeon table after a create. true/false. Default: true.
# EVEJS_LNE_SITES_DURABLE_CREATE=

# sites.hideEndedFromScanner - an ended LNE site leaves the client scanner at once, also while
# the vendor keeps its grid for a player on it. true/false. Default: true.
# EVEJS_LNE_SITES_HIDE_ENDED_FROM_SCANNER=

# sites.maxHiddenScannerSites - Hidden scanner sites kept in process memory (oldest dropped first).
# Range 16..4096. Default: 256.
# EVEJS_LNE_SITES_MAX_HIDDEN_SCANNER_SITES=

# salvage anomaly of a wreck field (works only with modules.sites - Danger, off: EVEJS_LNE_SITES_ENABLED).
# All keys internal: not in the launcher, values outside the range are clamped.
# salvageAnomaly.enabled - Feature flag (kill-switch). true/false. Default: true.
# EVEJS_LNE_SALVAGE_ANOMALY_ENABLED=

# salvageAnomaly.templateId - Site template of the anomaly (no spaces, <= 128 chars). Default: client-dungeon:4088.
# EVEJS_LNE_SALVAGE_ANOMALY_TEMPLATE_ID=

# salvageAnomaly.pumpIntervalMs - Interval between pump passes. Range 1000..120000. Default: 10000.
# EVEJS_LNE_SALVAGE_ANOMALY_PUMP_INTERVAL_MS=

# salvageAnomaly.maxActiveAnomalies - Anomalies outside ENDED in the world (<= sites.maxActiveSites).
# Range 1..64. Default: 8.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_ACTIVE_ANOMALIES=

# salvageAnomaly.maxPerSystem - Anomalies outside ENDED of one system. Range 1..100. Default: 2.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_PER_SYSTEM=

# salvageAnomaly.maxNewPerPass - Claims per pass. Range 1..4. Default: 1.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_NEW_PER_PASS=

# salvageAnomaly.maxObservedSystemsPerPass - Observed systems read per pass. Range 1..256. Default: 16.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_OBSERVED_SYSTEMS_PER_PASS=

# salvageAnomaly.maxRowsPerPass - Two uses: (1) anomaly rows stepped per pass (also fields read per
#  observed system); (2) extra fields the claim reads past readCap for skipped fields (claim read limit =
#  readCap + maxRowsPerPass). Range 1..64. Default: 8.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_ROWS_PER_PASS=

# salvageAnomaly.maxWrecksPerAnomaly - EveJS wrecks of one anomaly. Range 1..32. Default: 12.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_WRECKS_PER_ANOMALY=

# salvageAnomaly.maxWreckWritesPerPass - Wreck operations (place + remove calls) per pass; loot item writes
# not counted. Range 1..16. Default: 4.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_WRECK_WRITES_PER_PASS=

# salvageAnomaly.lootUnitsPerRoll - Loot units of the field per vendor loot roll. Range 1..1000. Default: 4.
# EVEJS_LNE_SALVAGE_ANOMALY_LOOT_UNITS_PER_ROLL=

# salvageAnomaly.maxLootRollsPerWreck - Loot rolls of one wreck. Range 0..10. Default: 3.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_LOOT_ROLLS_PER_WRECK=

# salvageAnomaly.wreckSpreadM - Radius of the wrecks around the site in metres. Range 1000..100000. Default: 10000.
# EVEJS_LNE_SALVAGE_ANOMALY_WRECK_SPREAD_M=

# salvageAnomaly.trackIntervalMs - Read of the own wrecks of a placed anomaly. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_SALVAGE_ANOMALY_TRACK_INTERVAL_MS=

# salvageAnomaly.minPoolUnits - Effective pool of a field below this -> no anomaly. Range 1..1000000. Default: 1.
# EVEJS_LNE_SALVAGE_ANOMALY_MIN_POOL_UNITS=

# salvageAnomaly.maxRefusedFieldsRemembered - Fields with a permanent claim refusal skipped by the claims
# (in process, oldest dropped first; a restart clears it). Range 1..4096. Default: 256.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_REFUSED_FIELDS_REMEMBERED=

# salvageAnomaly.fallbackLootTableId - Loot table of a faction without one (a-z, 0-9, _). Default: generic_random_any.
# EVEJS_LNE_SALVAGE_ANOMALY_FALLBACK_LOOT_TABLE_ID=

# salvageAnomaly.trackObservedIntervalMs - read of the own wrecks of a placed anomaly in an
# observed system (the pump passes as often then). Range 1000..60000. Default: 3000.
# EVEJS_LNE_SALVAGE_ANOMALY_TRACK_OBSERVED_INTERVAL_MS=

# salvageAnomaly.endWhenLooted - every wreck empty, a player visited and left the grid -> the anomaly ends
# (LOOTED). true/false. Default: true.
# EVEJS_LNE_SALVAGE_ANOMALY_END_WHEN_LOOTED=

# salvageAnomaly.lootedGraceMs - no player on the grid of an all-empty visited anomaly this long ->
# LOOTED (time to dock and come back in a salvager). Range 0..600000. Default: 300000.
# EVEJS_LNE_SALVAGE_ANOMALY_LOOTED_GRACE_MS=

# salvageAnomaly.lootedWreckTtlMs - empty wrecks of a LOOTED anomaly stay this long, then they are removed.
# Range 0..7200000. Default: 600000.
# EVEJS_LNE_SALVAGE_ANOMALY_LOOTED_WRECK_TTL_MS=

# salvageAnomaly.gridRangeM - a player ship this near the site (metres) is on the anomaly grid.
# Range 10000..1000000. Default: 250000.
# EVEJS_LNE_SALVAGE_ANOMALY_GRID_RANGE_M=

# salvageAnomaly.maxFieldsPerAnomaly - live wreck fields of one system merged into one anomaly
# (1 = no merge). Runtime min(value, (persistence.maxRowsPerTransaction - 3) / 2); the merge stops once the hulls of
# the taken fields reach min(maxWrecksPerAnomaly, 102). Set it to wrecks.maxFieldsPerSystem for one anomaly
# from every field of a system. Range 1..300. Default: 8.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_FIELDS_PER_ANOMALY=

# salvageAnomaly.respawnDelayMs - no new anomaly in a system this long after a CLEARED / LOOTED end
# (process memory). Range 0..86400000. Default: 300000.
# EVEJS_LNE_SALVAGE_ANOMALY_RESPAWN_DELAY_MS=

# salvageAnomaly.maxClaimFieldsPerPass - no further claim in a pass once its claims took this many fields
# (one claim may go above it). Range 1..1000. Default: 300.
# EVEJS_LNE_SALVAGE_ANOMALY_MAX_CLAIM_FIELDS_PER_PASS=

# salvageAnomaly.sizedDefaultLoot - a faction without its own loot table (empires, CONCORD, Triglavians...)
# gets loot_belt_normal_<size> of the wreck / chest; a fallback table that rolls any item type of the game
# (generic_random_any: hulls, structures) is refused - no loot rolls. false = the old fallback chain.
# true/false. Default: true.
# EVEJS_LNE_SALVAGE_ANOMALY_SIZED_DEFAULT_LOOT=

# faction loot caches of the pirate war events pirate_war_depot
# pirate_war_vault (works only with modules.events and modules.sites - Danger, off). All keys internal: not in the
# launcher, values outside the range are clamped. Numbers are hypotheses (not calibrated yet).
# eventRewards.enabled - Feature flag: the 2 reward event types + their caches. Turn on only after T9 on the full SDE.
# true/false. Default: false.
# EVEJS_LNE_EVENT_REWARDS_ENABLED=

# eventRewards.pumpIntervalMs - Interval between cache pump passes. Range 5000..600000. Default: 15000.
# EVEJS_LNE_EVENT_REWARDS_PUMP_INTERVAL_MS=

# eventRewards.maxPlacesPerPass - Caches placed per pass. Range 1..4. Default: 1.
# EVEJS_LNE_EVENT_REWARDS_MAX_PLACES_PER_PASS=

# eventRewards.maxCachesPerDay - Caches per UTC day of event creation, whole world (0 = no caches). Range 0..1000.
# Default: 12.
# EVEJS_LNE_EVENT_REWARDS_MAX_CACHES_PER_DAY=

# eventRewards.maxCachesPerSystemPerDay - Caches per UTC day of event creation in one system. Range 0..24. Default: 1.
# EVEJS_LNE_EVENT_REWARDS_MAX_CACHES_PER_SYSTEM_PER_DAY=

# eventRewards.depotRolls - Loot table rolls of a depot cache. Range 0..10. Default: 2.
# EVEJS_LNE_EVENT_REWARDS_DEPOT_ROLLS=

# eventRewards.vaultRolls - Loot table rolls of a vault cache. Range 0..10. Default: 3.
# EVEJS_LNE_EVENT_REWARDS_VAULT_ROLLS=

# eventRewards.minEntries - Loot entries per roll (min). Range 1..6. Default: 2.
# EVEJS_LNE_EVENT_REWARDS_MIN_ENTRIES=

# eventRewards.maxEntries - Loot entries per roll (max; below minEntries -> minEntries). Range 1..6. Default: 3.
# EVEJS_LNE_EVENT_REWARDS_MAX_ENTRIES=

# eventRewards.factionAmmoWeight - Selector weight of faction ammo (T1 filler = 85). Range 0..1000. Default: 20.
# EVEJS_LNE_EVENT_REWARDS_FACTION_AMMO_WEIGHT=

# eventRewards.factionModuleWeight - Selector weight of a faction module. Range 0..1000. Default: 4.
# EVEJS_LNE_EVENT_REWARDS_FACTION_MODULE_WEIGHT=

# eventRewards.deadspaceModuleWeight - Selector weight of a deadspace module (0 = none). Range 0..1000. Default: 0.
# EVEJS_LNE_EVENT_REWARDS_DEADSPACE_MODULE_WEIGHT=

# eventRewards.cacheOffsetM - Distance of the cache from the site centre (metres). Range 500..50000. Default: 5000.
# EVEJS_LNE_EVENT_REWARDS_CACHE_OFFSET_M=

# materialization service - battles near a player fought by real EveJS ships (works only with
# modules.materialization - Danger, off: EVEJS_LNE_MATERIALIZATION_ENABLED).
# All keys internal: not in the launcher, values outside the range are clamped.
# materialization.pumpMs - Interval between pump passes. Range 500..60000. Default: 2000.
# EVEJS_LNE_MATERIALIZATION_PUMP_MS=

# materialization.maxBattlesPerPass - New battles per pass. Range 1..16. Default: 1.
# EVEJS_LNE_MATERIALIZATION_MAX_BATTLES_PER_PASS=

# materialization.maxExitsPerPass - Exits of live battles per pass. Range 1..64. Default: 4.
# EVEJS_LNE_MATERIALIZATION_MAX_EXITS_PER_PASS=

# materialization.maxShipsPerBattle - Ships of one live battle; a larger battle is resolved virtually.
# Range 1..256. Default: 40.
# EVEJS_LNE_MATERIALIZATION_MAX_SHIPS_PER_BATTLE=

# materialization.exitGraceMs - How long the exit condition (no player, no scene, no live ship) must hold.
# Range 0..300000. Default: 30000.
# EVEJS_LNE_MATERIALIZATION_EXIT_GRACE_MS=

# materialization.anchorDistanceMeters - Spawn distance of side B from the anchor. Range 1000..100000. Default: 15000.
# EVEJS_LNE_MATERIALIZATION_ANCHOR_DISTANCE_METERS=

# materialization.sideSeparationMeters - Side A spawns this much farther. Range 0..100000. Default: 20000.
# EVEJS_LNE_MATERIALIZATION_SIDE_SEPARATION_METERS=

# materialization.aggroPlayers - The live ships also attack players. true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_AGGRO_PLAYERS=

# materialization.invaderProfilesEnabled - Battles of Triglavians (500026) and Drifters (500024) near a player go
# live with the EveJS profiles parity_trig_* / parity_drifter_*. true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_INVADER_PROFILES_ENABLED=

# materialization.industryProfilesEnabled - Battles with haulers and miners (industrial, mining, freighter groups)
# near a player go live with the EveJS profiles ore_mining_* / parity_*_hauler. true/false.
# Default: false.
# EVEJS_LNE_MATERIALIZATION_INDUSTRY_PROFILES_ENABLED=

# materialization.factionProfilesEnabled - LNE NPC profiles lne_faction_<factionId>_<class> of factions without a
# vendor combat entity (Sisters of EVE 500016: Astero, Catalyst, Stratios, Brutix, Nestor) in the EveJS NPC tables
# . A SoE battle near a player can spawn LIVE; off = SoE stays NO_PROFILE (virtual). Needs only the
# master switch (not modules.materialization). Read at boot: a change needs a restart. true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_FACTION_PROFILES_ENABLED=

# materialization.capitalLiveEnabled - Own NPC profiles lne_capital_<factionId>_<class> with the real capital hull
# in the EveJS NPC tables. A capital of a battle / patrol / hunt near a player spawns with it; off = the
# whole battle (or fleet) stays virtual (never a battleship proxy). Read at boot: a change needs a restart.
# true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_LIVE_ENABLED=

# materialization.capitalClassesLive - Capital classes that get a profile: none or a comma list of carrier,
# dreadnought, force_auxiliary, supercarrier, titan. Default: carrier,dreadnought,force_auxiliary,supercarrier,titan.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_CLASSES_LIVE=

# materialization.capitalFightersEnabled - Carrier / supercarrier profiles launch fighter wings (3 / 5 tubes of the
# vendor template). true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_FIGHTERS_ENABLED=

# materialization.capitalSuperweaponsEnabled - Titan profiles carry the doomsday of the vendor template.
# true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_SUPERWEAPONS_ENABLED=

# materialization.capitalFighterDamageEnabled - The fighters of the LNE carriers / supercarriers deal damage LIVE: the
# mod runs their offensive cycle with the EveJS functions (EveJS cuts the cycle of NPC fighters). Needs
# capitalLiveEnabled and capitalFightersEnabled. Read at boot: a change needs a restart. true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_FIGHTER_DAMAGE_ENABLED=

# materialization.capitalFighterDpsPermille - Raw DPS of the LIVE fighter wing = resolver row dps x permille / 1000
# (a squadron gets that / the tubes of the class). Range 100..5000. Default: 1000.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_FIGHTER_DPS_PERMILLE=

# materialization.capitalFighterScaleMaxPermille - Upper clamp of the damage scale of one squadron against the
# EveJS ability (permille). Range 1000..200000. Default: 20000.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_FIGHTER_SCALE_MAX_PERMILLE=

# materialization.capitalFaxRepairEnabled - The LNE force auxiliaries repair the allies of their LIVE battle side: the
# mod runs the remote repair cycle with the EveJS functions, never on the enemy. Needs capitalLiveEnabled and
# force_auxiliary in capitalClassesLive. Read at boot: a change needs a restart. true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_FAX_REPAIR_ENABLED=

# materialization.capitalFaxRepairPermille - HP per FAX cycle = resolver row remoteRepPerSec x permille / 1000 x cycle
# seconds (Apostle: 290 x 5 s = 1450 HP). Range 100..5000. Default: 1000.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_FAX_REPAIR_PERMILLE=

# materialization.capitalFaxRepairCycleMs - One repair (one ally) per FAX per this many ms of scene time. Range
# 1000..60000. Default: 5000.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_FAX_REPAIR_CYCLE_MS=

# materialization.capitalFaxRepairRangeMeters - An ally farther than this (surface distance) gets no repair. Range
# 5000..300000. Default: 75000.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_FAX_REPAIR_RANGE_METERS=

# materialization.relationColorsEnabled - The LIVE ships of LNE carry the slim response thresholds of the relation of
# the player to their faction, by the rule of the attack (playerHunt thresholds and neutralPolicy): red = hostile,
# white = neutral, blue = friendly. Read at boot: a change needs a restart. true/false. Default: false.
# EVEJS_LNE_MATERIALIZATION_RELATION_COLORS_ENABLED=

# materialization.relationColorsMaxStandingReadsPerPass - Standing reads of the relation painter per pump pass (over
# it the player is unknown this pass). Range 1..1024. Default: 32.
# EVEJS_LNE_MATERIALIZATION_RELATION_COLORS_MAX_STANDING_READS_PER_PASS=

# materialization.relationColorsMaxRepaintsPerPass - Ships whose thresholds change per pump pass (the rest waits for
# the next pass). Range 1..4096. Default: 64.
# EVEJS_LNE_MATERIALIZATION_RELATION_COLORS_MAX_REPAINTS_PER_PASS=

# materialization.capitalBudgetWeight - Slots of the live budget per capital: a reservation is ships +
# (weight - 1) x capitals. Range 1..16. Default: 4.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_BUDGET_WEIGHT=

# materialization.capitalAnchorDistanceMeters - Spawn distance of a capital from the anchor (side A adds
# sideSeparationMeters; patrols and hunts use it instead of the landing spread). Range 5000..300000.
# Default: 40000.
# EVEJS_LNE_MATERIALIZATION_CAPITAL_ANCHOR_DISTANCE_METERS=

# materialization.targetMode - manual (ordered target only, new target from the pump; no fire at allies) or
# vendor (EveJS auto aggro, also at allies). Default: manual.
# EVEJS_LNE_MATERIALIZATION_TARGET_MODE=

# materialization.maxRetargetsPerPass - New attack orders per pass (manual mode). Range 1..1024. Default: 64.
# EVEJS_LNE_MATERIALIZATION_MAX_RETARGETS_PER_PASS=

# materialization.retryAfterFailMs - A battle whose spawn failed is tried again after this time.
# Range 10000..86400000. Default: 300000.
# EVEJS_LNE_MATERIALIZATION_RETRY_AFTER_FAIL_MS=

# materialization.maxFailedBattlesRemembered - Failed battles remembered (oldest dropped first; a restart clears
# it). Range 1..4096. Default: 256.
# EVEJS_LNE_MATERIALIZATION_MAX_FAILED_BATTLES_REMEMBERED=

# materialization.despawnRetryPasses - Retries of a failed despawn of a stray ship. Range 0..100. Default: 3.
# EVEJS_LNE_MATERIALIZATION_DESPAWN_RETRY_PASSES=

# materialization.maxStrayShipsRemembered - Stray ships remembered for a despawn retry (oldest dropped first).
# Range 1..4096. Default: 256.
# EVEJS_LNE_MATERIALIZATION_MAX_STRAY_SHIPS_REMEMBERED=

# materialization.attackLockEnabled - Attack orders of the hunts, garrison patrols / gate camps, belt navy and
# ambient rats carry keepLock / allowWeapons (without them EveJS neither locks nor fires). Default: true.
# EVEJS_LNE_MATERIALIZATION_ATTACK_LOCK_ENABLED=

# materialization.liveBattleAttackLockEnabled - The same for the LIVE NPC vs NPC battles (engage / orderAttack):
# the ships really destroy each other (killmails, loss import, LIVE settlement). Default: false.
# EVEJS_LNE_MATERIALIZATION_LIVE_BATTLE_ATTACK_LOCK_ENABLED=

# materialization.gridAnchorEnabled - A LIVE battle with a grid (battle_records.grid_*, battle.gridContacts.enabled)
# spawns at its grid anchor (gate, station, structure, sun, belt) + the anchor radius; no grid or an anchor not in
# the scene -> pickAnchor as before. Restart. Default: false.
# EVEJS_LNE_MATERIALIZATION_GRID_ANCHOR_ENABLED=

# materialization.wavesEnabled - A battle above the ceiling (LIVE_TOO_LARGE) goes LIVE as one battle in waves:
# the first wave up to the ceiling, the rest waits as RESERVE and replaces the ships that are gone. Default: false.
# EVEJS_LNE_MATERIALIZATION_WAVES_ENABLED=

# materialization.waveMaxShips - Ships of a wave at once (min with maxShipsPerBattle). Range 2..256. Default: 40.
# EVEJS_LNE_MATERIALIZATION_WAVE_MAX_SHIPS=

# materialization.waveMaxMembers - Members of one wave battle (more -> LIVE_TOO_LARGE). Range 2..256. Default: 120.
# EVEJS_LNE_MATERIALIZATION_WAVE_MAX_MEMBERS=

# materialization.waveMaxSpawnsPerPass - Reserve members spawned per pump pass. Range 1..64. Default: 8.
# EVEJS_LNE_MATERIALIZATION_WAVE_MAX_SPAWNS_PER_PASS=

# materialization.profileFallbackEnabled - A member without a LIVE profile of its class takes the profile of a
# substitute class (frigate -> destroyer, ...); never a capital. Default: false.
# EVEJS_LNE_MATERIALIZATION_PROFILE_FALLBACK_ENABLED=

# materialization.playerBattlesLiveWorkEnabled - A new battle in the system of a player and the wave refills ask
# the load governor for the work class LIVE (priority 2): they run in CONSTRAINED and OVERLOADED, they wait in
# SHED. false = the class OPERATIONAL as before (they wait from OVERLOADED). Rollback only. Default: true.
# EVEJS_LNE_MATERIALIZATION_PLAYER_BATTLES_LIVE_WORK_ENABLED=

# materialization.spawnBackoff.enabled - A garrison patrol / player hunt whose spawn rolled back (SPAWN_FAILED) is
# not claimed again until its retry time (RAM only, a restart clears it); one log line per fleet and reason. false =
# retried every pass as before. Default: true.
# EVEJS_LNE_MATERIALIZATION_SPAWN_BACKOFF_ENABLED=

# materialization.spawnBackoff.baseMs - First wait of a transient spawn failure (baseMs * 2^(n-1), cap maxMs); also
# the wait of an armNpcCombat id that failed. Range 1000..3600000. Default: 60000.
# EVEJS_LNE_MATERIALIZATION_SPAWN_BACKOFF_BASE_MS=

# materialization.spawnBackoff.maxMs - Cap of the exponential wait. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_MATERIALIZATION_SPAWN_BACKOFF_MAX_MS=

# materialization.spawnBackoff.permanentMs - Wait after a deterministic vendor refusal (NPC_NATIVE_NO_FREE_SLOT,
# module / capability type not found). Range 60000..604800000. Default: 21600000.
# EVEJS_LNE_MATERIALIZATION_SPAWN_BACKOFF_PERMANENT_MS=

# materialization.spawnBackoff.maxEntries - Fleets / ids held per step; overflow drops the smallest retry time.
# Range 64..65536. Default: 4096.
# EVEJS_LNE_MATERIALIZATION_SPAWN_BACKOFF_MAX_ENTRIES=

# player hunts - a faction fleet in the system of a hostile player hunts him (new hunts need
# playerHunt.enabled and modules.materialization; the recovery of the previous boot runs with the fleets).
# All keys internal: not in the launcher, values outside the range are clamped.
# playerHunt.enabled - New player hunts (default true since without the in-game gate session
# 2026-10-31; nothing happens while modules.materialization is off). true/false. Default: true.
# EVEJS_LNE_PLAYER_HUNT_ENABLED=

# playerHunt.hostileStandingMax - Standing of the character towards the fleet faction at or below this = hostile.
# Range -10..10. Default: -5.
# EVEJS_LNE_PLAYER_HUNT_HOSTILE_STANDING_MAX=

# playerHunt.friendlyStandingMin - Standing at or above this = friendly, never a target. Range -10..10. Default: 5.
# EVEJS_LNE_PLAYER_HUNT_FRIENDLY_STANDING_MIN=

# playerHunt.loyaltySpareEnabled - a faction spares a player from
# loyaltySpareStandingMin (huntStep, garrisonStep). true/false. Default: false.
# EVEJS_LNE_PLAYER_HUNT_LOYALTY_SPARE_ENABLED=

# playerHunt.loyaltySpareStandingMin - With loyaltySpareEnabled the friendly threshold = min(friendlyStandingMin, this).
# Range 0..10 (outside: clamped). Default: 2.
# EVEJS_LNE_PLAYER_HUNT_LOYALTY_SPARE_STANDING_MIN=

# playerHunt.neutralPolicy - Neutral standing per faction kind: <kind>:<hostile|ignore>, comma list.
# Default: pirate:hostile,invader:hostile,empire:ignore,police:ignore,neutral:ignore.
# EVEJS_LNE_PLAYER_HUNT_NEUTRAL_POLICY=

# playerHunt.roles - Fleet roles that may hunt (comma list). Default: patrol,garrison,invasion,reserve,scout.
# EVEJS_LNE_PLAYER_HUNT_ROLES=

# playerHunt.scannerHullGroups - Hull groups that count as a probe scanner (comma list or none). Default: ewar.
# EVEJS_LNE_PLAYER_HUNT_SCANNER_HULL_GROUPS=

# playerHunt.maxActiveHunts - Open hunts in the galaxy. Range 0..16. Default: 4.
# EVEJS_LNE_PLAYER_HUNT_MAX_ACTIVE_HUNTS=

# playerHunt.maxHuntsPerSystem - Open hunts in one system. Range 1..4. Default: 2.
# EVEJS_LNE_PLAYER_HUNT_MAX_HUNTS_PER_SYSTEM=

# playerHunt.maxNewHuntsPerPass - New hunts per pump pass. Range 1..4. Default: 1.
# EVEJS_LNE_PLAYER_HUNT_MAX_NEW_HUNTS_PER_PASS=

# playerHunt.maxShipsPerHunt - Ships of a hunt; a larger fleet hunts with a detachment of this size in its own
# system only (no approach, no pursuit; with oversizeDetachmentEnabled off it does not hunt). Range 1..64. Default: 10.
# EVEJS_LNE_PLAYER_HUNT_MAX_SHIPS_PER_HUNT=

# playerHunt.maxStandingReadsPerPass - Standing reads per pump pass. Range 1..1024. Default: 64.
# EVEJS_LNE_PLAYER_HUNT_MAX_STANDING_READS_PER_PASS=

# playerHunt.fleetScanMax - Fleets read per system; open hunts per recovery page. Range 1..256. Default: 32.
# EVEJS_LNE_PLAYER_HUNT_FLEET_SCAN_MAX=

# playerHunt.noticeDelayMs - The player is in the system this long before a hunt starts. Range 0..600000.
# Default: 60000.
# EVEJS_LNE_PLAYER_HUNT_NOTICE_DELAY_MS=

# playerHunt.cooldownMs - No new hunt of one (character, faction) this long after the last one ended.
# Range 0..86400000. Default: 900000.
# EVEJS_LNE_PLAYER_HUNT_COOLDOWN_MS=

# playerHunt.maxDurationMs - Longest hunt (TIMEOUT). Range 60000..7200000. Default: 1200000.
# EVEJS_LNE_PLAYER_HUNT_MAX_DURATION_MS=

# playerHunt.exitGraceMs - The target out of space of the system this long ends the hunt. Range 0..300000.
# Default: 30000.
# EVEJS_LNE_PLAYER_HUNT_EXIT_GRACE_MS=

# playerHunt.reacquireGraceMs - No target on grid this long -> search again. Range 0..300000. Default: 20000.
# EVEJS_LNE_PLAYER_HUNT_REACQUIRE_GRACE_MS=

# playerHunt.gridRadiusMeters - On grid = within this distance. Range 10000..1000000. Default: 250000.
# EVEJS_LNE_PLAYER_HUNT_GRID_RADIUS_METERS=

# playerHunt.objectKinds - Object kinds of the sweep, in this order (stargate, station, asteroidBelt, planet,
# anomaly). Drop anomaly = the sweep skips anomaly sites (safe spots are found by SCAN only).
# Default: stargate,station,asteroidBelt,planet,anomaly.
# EVEJS_LNE_PLAYER_HUNT_OBJECT_KINDS=

# playerHunt.objectDwellMs - Stay on one object of the sweep. Range 5000..600000. Default: 30000.
# EVEJS_LNE_PLAYER_HUNT_OBJECT_DWELL_MS=

# playerHunt.maxObjectsPerHunt - Objects of one sweep before NOT_FOUND. Range 1..256. Default: 24.
# EVEJS_LNE_PLAYER_HUNT_MAX_OBJECTS_PER_HUNT=

# playerHunt.maxAnomaliesPerHunt - Anomaly sites of one sweep (nearest the quarry first, the rest dropped).
# Range 1..64. Default: 8.
# EVEJS_LNE_PLAYER_HUNT_MAX_ANOMALIES_PER_HUNT=

# playerHunt.sweepRetargetEnabled - the next sweep object = the object on the grid of a visible
# quarry (counter sweepRetargets). Default: true.
# EVEJS_LNE_PLAYER_HUNT_SWEEP_RETARGET_ENABLED=

# playerHunt.warpTimeoutMs - A sweep warp ends after this at the latest. Range 10000..300000. Default: 60000.
# EVEJS_LNE_PLAYER_HUNT_WARP_TIMEOUT_MS=

# playerHunt.warpStartGraceMs - no ship seen in warp this long ends the warp phase (0 = at once, as before). Range 0..60000. Default: 6000.
# EVEJS_LNE_PLAYER_HUNT_WARP_START_GRACE_MS=

# playerHunt.landingSpreadMeters - Landing spread of the ships. Range 0..50000. Default: 5000.
# EVEJS_LNE_PLAYER_HUNT_LANDING_SPREAD_METERS=

# playerHunt.warpInDistanceMeters - Landing distance from the target (scan mode). Range 0..100000. Default: 15000.
# EVEJS_LNE_PLAYER_HUNT_WARP_IN_DISTANCE_METERS=

# playerHunt.scanCycleMs - One scan cycle. Range 1000..120000. Default: 8000.
# EVEJS_LNE_PLAYER_HUNT_SCAN_CYCLE_MS=

# playerHunt.scanBasePermille - Chance per cycle at the reference signature. Range 0..1000. Default: 250.
# EVEJS_LNE_PLAYER_HUNT_SCAN_BASE_PERMILLE=

# playerHunt.scanRefSignatureM - Reference signature radius (metres). Range 1..10000. Default: 100.
# EVEJS_LNE_PLAYER_HUNT_SCAN_REF_SIGNATURE_M=

# playerHunt.scanMinPermille - Lowest chance per cycle. Range 0..1000. Default: 50.
# EVEJS_LNE_PLAYER_HUNT_SCAN_MIN_PERMILLE=

# playerHunt.scanMaxPermille - Highest chance per cycle. Range 0..1000. Default: 900.
# EVEJS_LNE_PLAYER_HUNT_SCAN_MAX_PERMILLE=

# playerHunt.maxScanCycles - Scan cycles before NOT_FOUND. Range 1..500. Default: 30.
# EVEJS_LNE_PLAYER_HUNT_MAX_SCAN_CYCLES=

# Pursuit through gates (the hunters follow the quarry as a virtual fleet). Off by default.
# playerHunt.pursuitEnabled - Hunters follow the quarry through gates (operation pursuit). Default: false.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_ENABLED=

# playerHunt.pursuitMaxJumps - Gate jumps of one pursuit leg. Range 1..3. Default: 1.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_MAX_JUMPS=

# playerHunt.pursuitMaxHops - Legs of one pursuit chain. Range 1..10. Default: 3.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_MAX_HOPS=

# playerHunt.pursuitMaxActive - Pursuits on the way at once (0 = none). Range 0..16. Default: 2.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_MAX_ACTIVE=

# playerHunt.pursuitArrivalWaitMs - Wait after the arrival before the pursuit gives up. Range 0..300000.
# Default: 30000.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_ARRIVAL_WAIT_MS=

# playerHunt.pursuitRequireContact - pursue only after a contact with the quarry. Default: true.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_REQUIRE_CONTACT=

# playerHunt.pursuitAvoidSecClasses - Security classes the pursuit route and target avoid (highsec, lowsec,
# nullsec, wormhole, other; none = no class). Default: highsec.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_AVOID_SEC_CLASSES=

# The approach. No IDLE candidate in the system of a
# player -> an IDLE fleet within approachMaxJumps flies to it (operation pursuit) and appears at the arrival gate.
# Needs playerHunt.pursuitEnabled (the arrival is the pursuit step). Off by default.
# playerHunt.approachEnabled - An IDLE fleet near a player flies to it when its system has no candidate.
# Default: false.
# EVEJS_LNE_PLAYER_HUNT_APPROACH_ENABLED=

# playerHunt.approachMaxJumps - Gate jumps from the system of the player to the searched systems. Range 1..5.
# Default: 2.
# EVEJS_LNE_PLAYER_HUNT_APPROACH_MAX_JUMPS=

# playerHunt.approachMaxSystems - Systems of one approach search (nearest first). Range 1..256. Default: 32.
# EVEJS_LNE_PLAYER_HUNT_APPROACH_MAX_SYSTEMS=

# playerHunt.approachMaxPerPass - Approaches written in one pump pass (0 = none). Range 0..8. Default: 1.
# EVEJS_LNE_PLAYER_HUNT_APPROACH_MAX_PER_PASS=

# playerHunt.approachRetryMs - Wait before the next approach search for the same system after a refusal.
# Range 0..3600000. Default: 60000.
# EVEJS_LNE_PLAYER_HUNT_APPROACH_RETRY_MS=

# the gang of a new hunt sized to the hull of the quarry. A detachment of the
# fleet spawns; the rest of the fleet takes no loss. A claim hunt is never scaled. Off by default (compose :-0).
# playerHunt.scaleEnabled - A new hunt spawns a detachment sized by the hull class of the quarry. Default: false.
# EVEJS_LNE_PLAYER_HUNT_SCALE_ENABLED=

# playerHunt.scaleTable - Ships per hull class of the quarry (<class>:<1..64>, classes of the strength catalogue and
# capsule; the numbers are a hypothesis). A row above playerHunt.maxShipsPerHunt is cut to it (config warning).
# Default: capsule:1,frigate:2,tackle:2,ewar:2,industrial:2,destroyer:3,logistics:3,cruiser:4,battlecruiser:6,
# battleship:8,capital:10.
# EVEJS_LNE_PLAYER_HUNT_SCALE_TABLE=

# playerHunt.scaleDefaultShips - Ships when the hull class of the quarry is unknown. Range 1..64. Default: 4.
# EVEJS_LNE_PLAYER_HUNT_SCALE_DEFAULT_SHIPS=

# the heat of the player hunts. Hunts won by the player (planRepel)
# in the window make the next hunt of that faction heavier (hull weight), larger (with scaleEnabled) and let it come
# from farther (approach). Off by default.
# playerHunt.escalationEnabled - The heat of the won hunts escalates the next hunt. Default: false.
# EVEJS_LNE_PLAYER_HUNT_ESCALATION_ENABLED=

# playerHunt.escalationWindowMs - Window of the won hunts counted as heat. Range 600000..604800000. Default: 21600000.
# EVEJS_LNE_PLAYER_HUNT_ESCALATION_WINDOW_MS=

# playerHunt.escalationMaxHeat - Ceiling of the heat. Range 1..8. Default: 3.
# EVEJS_LNE_PLAYER_HUNT_ESCALATION_MAX_HEAT=

# playerHunt.escalationScalePermille - Gang growth per heat (permille of the scaled cap). Range 0..4000. Default: 500.
# EVEJS_LNE_PLAYER_HUNT_ESCALATION_SCALE_PERMILLE=

# playerHunt.escalationMaxApproachJumps - Ceiling of approachMaxJumps + heat. Range 1..5. Default: 4.
# EVEJS_LNE_PLAYER_HUNT_ESCALATION_MAX_APPROACH_JUMPS=

# playerHunt.detachmentMatchEnabled - The hunt detachment takes the hull groups nearest the quarry hull first.
# Default: false.
# EVEJS_LNE_PLAYER_HUNT_DETACHMENT_MATCH_ENABLED=

# the scout warning before a player hunt. The pick of a new hunt sends one EVE
# mail at once (notices, outside notices.minMailIntervalMs) and the spawn comes later. Needs notices.enabled for the
# mail (without it the hunt still waits). Off by default (compose :-0).
# playerHunt.warningEnabled - A new hunt sends a scout warning mail first. Default: false.
# EVEJS_LNE_PLAYER_HUNT_WARNING_ENABLED=

# playerHunt.warningLeadMs - Time from the warning to the earliest spawn (also the arrival of an approach).
# Range 0..600000. Default: 60000.
# EVEJS_LNE_PLAYER_HUNT_WARNING_LEAD_MS=

# playerHunt.warningGraceMs - After warningLeadMs the spawn is still possible for this long, then the warning lapses.
# Range 0..600000. Default: 60000.
# EVEJS_LNE_PLAYER_HUNT_WARNING_GRACE_MS=

# playerHunt.warningRepeatMs - Quiet window per character (no second warning mail) and the time bucket of the mail
# key. Range 0..86400000. Default: 900000.
# EVEJS_LNE_PLAYER_HUNT_WARNING_REPEAT_MS=

# playerHunt.warningMaxPerPass - Warnings of new hunts per pump pass (0 = none). Range 0..8. Default: 1.
# EVEJS_LNE_PLAYER_HUNT_WARNING_MAX_PER_PASS=

# Retreat of a losing gang and the player-like exit of a hunt. Both off by default.
# playerHunt.exitEnabled - Hunters warp to a gate / station before they leave space when a player is on their grid.
# Default: false.
# EVEJS_LNE_PLAYER_HUNT_EXIT_ENABLED=

# playerHunt.retreatEnabled - A losing gang retreats (end RETREATED) and its fleet goes home. Default: false.
# EVEJS_LNE_PLAYER_HUNT_RETREAT_ENABLED=

# playerHunt.retreatLossPermille - Share of lost ships (permille) from which the gang retreats. Range 1..1000.
# Default: 500.
# EVEJS_LNE_PLAYER_HUNT_RETREAT_LOSS_PERMILLE=

# playerHunt.claimRepelLossPermille - Share of lost ships (permille) from which a hunt counts as won by the player
# (repel of the invasion, occupation.playerRepelEnabled). Range 1..1000. Default: 500.
# EVEJS_LNE_PLAYER_HUNT_CLAIM_REPEL_LOSS_PERMILLE=

# the fleet of the claim pretender hunts the player. Off by default.
# playerHunt.claimHuntsEnabled - The fleet of the pretender of a CONTESTED / INVASION claim (also STAGED with its
# operation) hunts a player in its system; it retreats at claimRepelLossPermille losses and never pursues.
# Default: false.
# EVEJS_LNE_PLAYER_HUNT_CLAIM_HUNTS_ENABLED=

# playerHunt.claimMaxShips - Ships of a claim hunt; a larger fleet of the pretender hunts with a detachment of this
# size (with oversizeDetachmentEnabled off it does not hunt for its claim). Range 1..64. Default: 16.
# EVEJS_LNE_PLAYER_HUNT_CLAIM_MAX_SHIPS=

# playerHunt.oversizeDetachmentEnabled - A fleet above maxShipsPerHunt (a claim hunt: claimMaxShips) hunts with a
# detachment of that size instead of being excluded, in its own system only (no approach, no pursuit).
# Default: true.
# EVEJS_LNE_PLAYER_HUNT_OVERSIZE_DETACHMENT_ENABLED=

# playerHunt.retreatOutnumberPermille - Targets x 1000 / live hunters from which the gang retreats (0 = rule off).
# Range 0..10000. Default: 2000.
# EVEJS_LNE_PLAYER_HUNT_RETREAT_OUTNUMBER_PERMILLE=

# playerHunt.returnMaxJumps - Gate jumps of the way home after a retreat. Range 1..30. Default: 10.
# EVEJS_LNE_PLAYER_HUNT_RETURN_MAX_JUMPS=

# Camp at the undock of the docked quarry and the way home. Both off by default.
# playerHunt.dockCampEnabled - Hunters camp at the station of a quarry docked in the hunt system. Default: false.
# EVEJS_LNE_PLAYER_HUNT_DOCK_CAMP_ENABLED=

# playerHunt.dockCampMs - Time of the camp, then the end TARGET_DOCKED. Range 10000..900000. Default: 120000.
# EVEJS_LNE_PLAYER_HUNT_DOCK_CAMP_MS=

# playerHunt.returnHomeEnabled - The fleet goes home after the end of a hunt and after a pursuit gave up.
# Default: false.
# EVEJS_LNE_PLAYER_HUNT_RETURN_HOME_ENABLED=

# playerHunt.pursuitChainCooldownMs - Minimum time between two pursuit chains on the same character (0 = no limit).
# Range 0..86400000. Default: 0.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_CHAIN_COOLDOWN_MS=

# playerHunt.pursuitWarmScan - after a pursuit hop the first scan cycle hits a visible quarry (the hunters
# follow the trail). Default: true.
# EVEJS_LNE_PLAYER_HUNT_PURSUIT_WARM_SCAN=

# NPC aggressors as targets and the d-scan order of the sweep. Both off by default.
# playerHunt.npcAggressorsEnabled - An NPC aggressor of another faction on the grid of a hunter is a target.
# Default: false.
# EVEJS_LNE_PLAYER_HUNT_NPC_AGGRESSORS_ENABLED=

# playerHunt.lneRetaliationEnabled - A hunter fires back at an LNE aggressor of an enemy faction. Default: true.
# EVEJS_LNE_PLAYER_HUNT_LNE_RETALIATION_ENABLED=

# playerHunt.lneArmMaxPerPass - armNpcCombat calls of the hunts per pump pass. Range 0..200. Default: 20.
# EVEJS_LNE_PLAYER_HUNT_LNE_ARM_MAX_PER_PASS=

# playerHunt.dscanEnabled - The sweep order is weighted by the distance of each object from the quarry.
# Default: false.
# EVEJS_LNE_PLAYER_HUNT_DSCAN_ENABLED=

# playerHunt.dscanRangeAu - D-scan range from the spawn anchor (AU). Range 0.1..50. Default: 14.3.
# EVEJS_LNE_PLAYER_HUNT_DSCAN_RANGE_AU=

# playerHunt.dscanNoisePermille - Noise of the d-scan ranking (+- permille of the distance). Range 0..1000.
# Default: 300.
# EVEJS_LNE_PLAYER_HUNT_DSCAN_NOISE_PERMILLE=

# The garrison of a system patrols its objects (sun, gates, stations, belts) or
# camps a gate while a player is there; its losses go back to the virtual fleet. Internal keys: not in the launcher.
# Sub1 adds the keys only (the pump step comes with).
# garrisonPatrol.enabled - Feature flag (Danger: needs modules.materialization and battle.liveLossImport.enabled).
# true/false. Default: false.
# EVEJS_LNE_GARRISON_PATROL_ENABLED=

# garrisonPatrol.roles - Fleet roles of the patrol (comma list of distinct fleet roles). Default: garrison.
# EVEJS_LNE_GARRISON_PATROL_ROLES=

# garrisonPatrol.maxActive - Open patrols in the galaxy. Range 0..32. Default: 8.
# EVEJS_LNE_GARRISON_PATROL_MAX_ACTIVE=

# garrisonPatrol.maxPerSystem - Open patrols in one system. Range 1..8. Default: 2.
# EVEJS_LNE_GARRISON_PATROL_MAX_PER_SYSTEM=

# garrisonPatrol.maxNewPerPass - New patrols per pump pass. Range 1..4. Default: 1.
# EVEJS_LNE_GARRISON_PATROL_MAX_NEW_PER_PASS=

# garrisonPatrol.maxShipsPerFleet - Ships of the detachment (a larger fleet sends this many). Range 1..64. Default: 12.
# EVEJS_LNE_GARRISON_PATROL_MAX_SHIPS_PER_FLEET=

# garrisonPatrol.maxSystemsPerPass - Systems checked for a new patrol per pump pass. Range 1..64. Default: 4.
# EVEJS_LNE_GARRISON_PATROL_MAX_SYSTEMS_PER_PASS=

# garrisonPatrol.scanIntervalMs - A system is read for fleets at most this often. Range 1000..600000. Default: 15000.
# EVEJS_LNE_GARRISON_PATROL_SCAN_INTERVAL_MS=

# garrisonPatrol.fleetScanMax - Limit of listFleetsInSystem per system read. Range 1..256. Default: 32.
# EVEJS_LNE_GARRISON_PATROL_FLEET_SCAN_MAX=

# garrisonPatrol.startDelayMs - A player in space this long -> the patrol spawns. Range 0..600000. Default: 3000.
# EVEJS_LNE_GARRISON_PATROL_START_DELAY_MS=

# garrisonPatrol.exitGraceMs - Nobody in the system this long -> end UNOBSERVED (warning at >= 60000: the vendor
# collects empty scenes after 60 s). Range 0..300000. Default: 30000.
# EVEJS_LNE_GARRISON_PATROL_EXIT_GRACE_MS=

# garrisonPatrol.maxLiveMs - End TIMEOUT after this (0 = no limit). Range 0..86400000. Default: 0.
# EVEJS_LNE_GARRISON_PATROL_MAX_LIVE_MS=

# garrisonPatrol.objectKinds - Object kinds of the route (sun, stargate, station, asteroidBelt, planet); the route
# starts at the object nearest the player, a gate = its camp point on the sun side.
# Default: sun,stargate,station.
# EVEJS_LNE_GARRISON_PATROL_OBJECT_KINDS=

# garrisonPatrol.maxRouteObjects - At most this many objects of a patrol route. Range 2..64. Default: 8.
# EVEJS_LNE_GARRISON_PATROL_MAX_ROUTE_OBJECTS=

# garrisonPatrol.objectDwellMs - Stay on one object. Range 5000..600000. Default: 60000.
# EVEJS_LNE_GARRISON_PATROL_OBJECT_DWELL_MS=

# garrisonPatrol.warpTimeoutMs - End of a patrol warp at the latest. Range 10000..300000. Default: 60000.
# EVEJS_LNE_GARRISON_PATROL_WARP_TIMEOUT_MS=

# garrisonPatrol.warpStartGraceMs - No ship seen in warp for this long ends the warp phase. Range 0..60000.
# Default: 6000.
# EVEJS_LNE_GARRISON_PATROL_WARP_START_GRACE_MS=

# garrisonPatrol.landingSpreadMeters - Spread of the spawn and the landing. Range 0..50000. Default: 5000.
# EVEJS_LNE_GARRISON_PATROL_LANDING_SPREAD_METERS=

# garrisonPatrol.objectClearanceMeters - Distance from the surface of an object (its radius + this). Range
# 0..500000. Default: 25000.
# EVEJS_LNE_GARRISON_PATROL_OBJECT_CLEARANCE_METERS=

# garrisonPatrol.gridRadiusMeters - On grid. Range 10000..1000000. Default: 250000.
# EVEJS_LNE_GARRISON_PATROL_GRID_RADIUS_METERS=

# garrisonPatrol.reacquireGraceMs - No target this long ends ENGAGED. Range 0..300000. Default: 20000.
# EVEJS_LNE_GARRISON_PATROL_REACQUIRE_GRACE_MS=

# garrisonPatrol.campPermilleByKind - Chance of a gate camp per faction kind (<kind>:<0..1000>).
# Default: pirate:700,invader:500,hive:500,neutral:300,empire:250,police:0.
# EVEJS_LNE_GARRISON_PATROL_CAMP_PERMILLE_BY_KIND=

# garrisonPatrol.maxCampsPerSystem - More camps in one system -> PATROL. Range 0..4. Default: 1.
# EVEJS_LNE_GARRISON_PATROL_MAX_CAMPS_PER_SYSTEM=

# garrisonPatrol.campGatePolicy - Choice of the camped gate: border, arrival or random. Default: border.
# EVEJS_LNE_GARRISON_PATROL_CAMP_GATE_POLICY=

# garrisonPatrol.campStandoffMeters - Distance of the camp from the gate (towards the sun). Range 0..100000.
# Default: 15000.
# EVEJS_LNE_GARRISON_PATROL_CAMP_STANDOFF_METERS=

# a hostile player comes through a gate into a system whose owner has
# fleets there -> those fleets camp the arrival gate (only with garrisonPatrol.enabled).
# garrisonPatrol.defenseEnabled - Gate defense of the system owner. true/false. Default: true.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_ENABLED=

# garrisonPatrol.defenseRoles - Fleet roles of the gate defense (comma list of distinct fleet roles).
# Default: garrison,patrol,invasion,hunter.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_ROLES=

# garrisonPatrol.defenseUnstageOperationTypes - Operation types a STAGED fleet leaves for the defense (none = never).
# Default: patrol,reinforce.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_UNSTAGE_OPERATION_TYPES=

# garrisonPatrol.defenseKinds - Faction kinds of the owner that defend a gate. Default: pirate,empire,invader,hive.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_KINDS=

# garrisonPatrol.defenseTrigger - Who triggers the defense: hostile or any. Default: hostile.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_TRIGGER=

# garrisonPatrol.defenseArrivalMatchMeters - A player this close to a gate at the first sight came through it.
# Range 5000..250000. Default: 50000.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_ARRIVAL_MATCH_METERS=

# garrisonPatrol.defenseArrivalWindowMs - An arrival waits this long for a start. Range 2000..120000. Default: 20000.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_ARRIVAL_WINDOW_MS=

# garrisonPatrol.defenseFleetsPerGate - Defense fleets on one gate. Range 1..4. Default: 2.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_FLEETS_PER_GATE=

# garrisonPatrol.defenseMaxNewPerPass - New gate defenses per pump pass. Range 1..4. Default: 1.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_MAX_NEW_PER_PASS=

# garrisonPatrol.defenseMaxAttemptsPerPass - Defense fleets tried per pump pass (a refused fleet -> the next one).
# Range 1..8. Default: 3.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_MAX_ATTEMPTS_PER_PASS=

# garrisonPatrol.defenseWorkClass - Governor work class of the defense: LIVE or OPERATIONAL. Default: LIVE.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_WORK_CLASS=

# The exit gate a hostile player warps to.
# garrisonPatrol.defenseExitEnabled - Defense of the gate a hostile player warps to (needs defenseEnabled).
# Default: true.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_EXIT_ENABLED=

# garrisonPatrol.defenseExitMatchMeters - A warp target this close to a gate is a warp to that gate.
# Range 10000..1000000. Default: 100000.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_EXIT_MATCH_METERS=

# garrisonPatrol.defenseMaxRelocations - Warps of one defense camp to an exit gate (0 = none). Range 0..8. Default: 2.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_MAX_RELOCATIONS=

# garrisonPatrol.defenseExitCooldownMs - One decision per system, character and exit gate in this time.
# Range 5000..300000. Default: 30000.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_EXIT_COOLDOWN_MS=

# garrisonPatrol.lneTargetsEnabled - LNE ships of an enemy faction are targets of the garrison (initiative in a system
# of its faction, retaliation everywhere). Default: true.
# EVEJS_LNE_GARRISON_PATROL_LNE_TARGETS_ENABLED=

# garrisonPatrol.lneTargetSources - Sources of the LNE groups (hunt, patrol, exposure; none = no source; never battle).
# Default: hunt,patrol.
# EVEJS_LNE_GARRISON_PATROL_LNE_TARGET_SOURCES=

# garrisonPatrol.lneArmMaxPerPass - armNpcCombat calls of the garrison per pump pass. Range 0..400. Default: 40.
# EVEJS_LNE_GARRISON_PATROL_LNE_ARM_MAX_PER_PASS=

# A hostile LNE group in a system of the owner.
# garrisonPatrol.defenseLneEnabled - Defense camp against a hostile LNE group (needs defenseEnabled and
# lneTargetsEnabled). Default: true.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_LNE_ENABLED=

# garrisonPatrol.defenseLneMatchMeters - The lead ship of a group this close to a gate = the group at that gate.
# Range 10000..1000000. Default: 100000.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_LNE_MATCH_METERS=

# Reinforcements of the gate defense from a neighbour system.
# garrisonPatrol.defenseReinforceEnabled - A fleet of the owner from a neighbour system flies to a defenseNoFleet
# arrival and camps the gate it came through (needs defenseEnabled). Default: true.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_ENABLED=

# garrisonPatrol.defenseReinforceRoles - Fleet roles of the reinforcements. Default: garrison,patrol.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_ROLES=

# garrisonPatrol.defenseReinforceKeepPerSystem - Fleets of the pool a neighbour system always keeps. Range 0..4.
# Default: 1.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_KEEP_PER_SYSTEM=

# garrisonPatrol.defenseReinforceMaxJumps - Jumps of the reinforcement flight. Range 1..1. Default: 1.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_MAX_JUMPS=

# garrisonPatrol.defenseReinforcePerSystem - Reinforcements in flight to one system. Range 1..4. Default: 1.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_PER_SYSTEM=

# garrisonPatrol.defenseReinforceMaxActive - Reinforcements in flight in the galaxy. Range 1..32. Default: 4.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_MAX_ACTIVE=

# garrisonPatrol.defenseReinforceMaxPerPass - Reinforcement calls per pump pass. Range 1..4. Default: 1.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_MAX_PER_PASS=

# garrisonPatrol.defenseReinforceMaxPerFactionHour - Reinforcements of one faction in a sliding hour. Range 1..60.
# Default: 6.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_MAX_PER_FACTION_HOUR=

# garrisonPatrol.defenseReinforceCooldownMs - One reinforcement per system and character in this time. Range
# 60000..3600000. Default: 600000.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_COOLDOWN_MS=

# garrisonPatrol.defenseReinforceArrivalWaitMs - After arriveAt the reinforcement waits this long for its fleet / its
# defense start. Range 5000..300000. Default: 30000.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_ARRIVAL_WAIT_MS=

# garrisonPatrol.defenseReinforceMaxReadsPerPass - Fleet reads of arrived reinforcements per pump pass. Range 1..8.
# Default: 2.
# EVEJS_LNE_GARRISON_PATROL_DEFENSE_REINFORCE_MAX_READS_PER_PASS=

# garrisonPatrol.campCloakOrderEnabled - A gate camp gives the attack order already to a hostile player in the jump
# cloak after a gate jump (EveJS locks at the first tick after the decloak). Default: true.
# EVEJS_LNE_GARRISON_PATROL_CAMP_CLOAK_ORDER_ENABLED=

# Fleet exposures of convoys / miners a player attacked (module fleets).
# Internal key: not in the launcher. The recovery of the previous boot runs also with the flag off.
# fleetExposure.enabled - Feature flag: convoys in flight and miners in the system of a player get EveJS ships
# (pump of modules.materialization); an attack holds the fleet and its losses are settled once. Needs
# battle.liveLossImport.enabled and materialization.industryProfilesEnabled. true/false. Default: false.
# EVEJS_LNE_FLEET_EXPOSURE_ENABLED=

# fleetExposure.convoysEnabled - Convoys in flight through the system of a player get ships. Default: true.
# EVEJS_LNE_FLEET_EXPOSURE_CONVOYS_ENABLED=

# fleetExposure.minersEnabled - Mining fleets STAGED in the system of a player get ships. Default: true.
# EVEJS_LNE_FLEET_EXPOSURE_MINERS_ENABLED=

# fleetExposure.scanIntervalMs - Minimum time between two reads of candidates. Range 1000..600000. Default: 5000.
# EVEJS_LNE_FLEET_EXPOSURE_SCAN_INTERVAL_MS=

# fleetExposure.maxVisible - Exposures of the pump at once (all phases); fleets left out are counted
# refusedMaxVisible. Range 0..32. Default: 12.
# EVEJS_LNE_FLEET_EXPOSURE_MAX_VISIBLE=

# fleetExposure.maxNewPerPass - New exposures per pump pass. Range 1..8. Default: 4.
# EVEJS_LNE_FLEET_EXPOSURE_MAX_NEW_PER_PASS=

# fleetExposure.maxShipsPerExposure - Ships of one exposure; a larger fleet is shown partially (the first N in the
# order of the hull group list, exposureTrimmed). Range 1..32. Default: 10.
# EVEJS_LNE_FLEET_EXPOSURE_MAX_SHIPS_PER_EXPOSURE=

# fleetExposure.maxSystemsPerScan - Observed systems of one read of candidates. Range 1..64. Default: 8.
# EVEJS_LNE_FLEET_EXPOSURE_MAX_SYSTEMS_PER_SCAN=

# fleetExposure.scanMaxConvoys - Convoys in flight of one read (page with a cursor). Range 1..500. Default: 256.
# EVEJS_LNE_FLEET_EXPOSURE_SCAN_MAX_CONVOYS=

# fleetExposure.scanMaxMinersPerSystem - STAGED fleets of one system in one read. Range 1..500. Default: 32.
# EVEJS_LNE_FLEET_EXPOSURE_SCAN_MAX_MINERS_PER_SYSTEM=

# fleetExposure.convoyHullGroups - Hull groups of a convoy that get ships (none or a comma list).
# Default: industrial,freighter,jump_freighter.
# EVEJS_LNE_FLEET_EXPOSURE_CONVOY_HULL_GROUPS=

# fleetExposure.minerHullGroups - Hull groups of a mining fleet that get ships (none or a comma list).
# Default: mining_frigate,mining_barge,exhumer.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_HULL_GROUPS=

# fleetExposure.transitMinRemainingMs - The shortest time the ships of a crossing stay (a short rest is shown).
# Range 0..600000. Default: 20000.
# EVEJS_LNE_FLEET_EXPOSURE_TRANSIT_MIN_REMAINING_MS=

# fleetExposure.transitEndMarginMs - The convoy ships leave this long before the end of the crossing window.
# Range 0..60000. Default: 5000.
# EVEJS_LNE_FLEET_EXPOSURE_TRANSIT_END_MARGIN_MS=

# fleetExposure.spawnDistanceMeters - Distance of the spawn from the gate / belt. Range 500..100000. Default: 5000.
# EVEJS_LNE_FLEET_EXPOSURE_SPAWN_DISTANCE_METERS=

# fleetExposure.surfaceMarginMeters - A planet / sun / station anchor spawns this far from its surface (radius +
# margin, outside the body). Range 1000..1000000. Default: 10000.
# EVEJS_LNE_FLEET_EXPOSURE_SURFACE_MARGIN_METERS=

# fleetExposure.stationDefaultRadiusMeters - The radius of a station anchor without a radius in its record.
# Range 0..1000000. Default: 50000.
# EVEJS_LNE_FLEET_EXPOSURE_STATION_DEFAULT_RADIUS_METERS=

# fleetExposure.holdQuietMs - No new aggression for this long -> the held ships leave. Range 10000..3600000.
# Default: 60000.
# EVEJS_LNE_FLEET_EXPOSURE_HOLD_QUIET_MS=

# fleetExposure.maxHeldMs - The longest held exposure (end TIMEOUT). Range 60000..7200000. Default: 900000.
# EVEJS_LNE_FLEET_EXPOSURE_MAX_HELD_MS=

# fleetExposure.exitWarpMaxMs - The longest exit warp (then the end QUIET). Range 5000..300000. Default: 30000.
# EVEJS_LNE_FLEET_EXPOSURE_EXIT_WARP_MAX_MS=

# fleetExposure.respawnCooldownMs - No new exposure of the same fleet for this long after a refused claim (every
# reason except the permanent ones; no pause after an end). Range 0..86400000. Default: 30000.
# EVEJS_LNE_FLEET_EXPOSURE_RESPAWN_COOLDOWN_MS=

# fleetExposure.permanentRefusalCooldownMs - The same pause after a claim refused for a permanent reason
# (EXPOSURE_OPEN, FLEET_EXPOSURE_INVALID_INPUT, FLEET_NOT_EXPOSABLE, FLEET_NOT_FOUND, HALT/LOCK_ALREADY_APPLIED).
# Range 0..86400000. Default: 600000.
# EVEJS_LNE_FLEET_EXPOSURE_PERMANENT_REFUSAL_COOLDOWN_MS=

# fleetExposure.preemptBackoffMs - A LIVE battle / hunt reservation makes the exposures yield at most once in this
# time (0 = every time). Range 0..3600000. Default: 60000.
# EVEJS_LNE_FLEET_EXPOSURE_PREEMPT_BACKOFF_MS=

# the carriers of a CONVOY exposure carry loot of the convoy cargo.
# fleetExposure.cargoLootEnabled - Every carrier of a new CONVOY exposure gets a share of the convoy minerals in its
# native hold; the wreck takes it (needs fleetExposure.enabled and convoysEnabled). Default: 0.
# EVEJS_LNE_FLEET_EXPOSURE_CARGO_LOOT_ENABLED=

# fleetExposure.cargoLootSharePermille - The part of the mineral share of one carrier in its hold. Range 0..1000.
# Default: 500.
# EVEJS_LNE_FLEET_EXPOSURE_CARGO_LOOT_SHARE_PERMILLE=

# fleetExposure.cargoLootMaxM3PerCarrier - The most m3 of minerals in the hold of one carrier. Range 1..1000000.
# Default: 5000.
# EVEJS_LNE_FLEET_EXPOSURE_CARGO_LOOT_MAX_M3_PER_CARRIER=

# the escort samples of a CONVOY exposure (frontJobs.escortEnabled).
# fleetExposure.escortRangeMeters - A player ship this close to a live convoy ship counts one escort sample per pass.
# Range 5000..1000000. Default: 100000.
# EVEJS_LNE_FLEET_EXPOSURE_ESCORT_RANGE_METERS=

# fleetExposure.escortMinSamples - Escort samples of a character for the credit of a crossing. Range 1..100.
# Default: 3.
# EVEJS_LNE_FLEET_EXPOSURE_ESCORT_MIN_SAMPLES=

# fleetExposure.escortMaxCharactersPerCrossing - Characters credited for one crossing (lowest id first). Range 1..32.
# Default: 4.
# EVEJS_LNE_FLEET_EXPOSURE_ESCORT_MAX_CHARACTERS_PER_CROSSING=

# fleetExposure.escortMaxTracked - Characters sampled on one convoy exposure. Range 4..256. Default: 32.
# EVEJS_LNE_FLEET_EXPOSURE_ESCORT_MAX_TRACKED=

# the NPC ambush at the exit gate of a convoy crossing.
# fleetExposure.ambushEnabled - A CONVOY exposure with a player in escort range rolls once per crossing for pirate
# ships at its exit gate that attack the carriers (needs fleetExposure.enabled and convoysEnabled). Default: 0.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_ENABLED=

# fleetExposure.ambushChancePermilleHighsec - The chance of an ambush in a highsec system. Range 0..1000. Default: 100.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_CHANCE_PERMILLE_HIGHSEC=

# fleetExposure.ambushChancePermilleLowsec - The chance of an ambush in a lowsec system. Range 0..1000. Default: 250.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_CHANCE_PERMILLE_LOWSEC=

# fleetExposure.ambushChancePermilleNullsec - The chance of an ambush in a nullsec system. Range 0..1000. Default: 350.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_CHANCE_PERMILLE_NULLSEC=

# fleetExposure.ambushShips - Pirate ships of one ambush. Range 1..8. Default: 3.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_SHIPS=

# fleetExposure.ambushHullGroups - Hull groups of the pirate ships. Default: cruiser,destroyer,frigate.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_HULL_GROUPS=

# fleetExposure.ambushDelayMs - The roll waits this long after the convoy ships appear. Range 0..600000. Default: 10000.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_DELAY_MS=

# fleetExposure.ambushFightMs - A fight at the gate keeps the convoy until engagedAt + this (0 = no extension).
# Range 0..600000. Default: 60000.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_FIGHT_MS=

# fleetExposure.ambushMaxStartsPerPass - Ambush rolls per pump pass. Range 1..4. Default: 1.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_MAX_STARTS_PER_PASS=

# fleetExposure.ambushAggroPlayers - The pirates also aggress players (v1: the carriers only). Default: 0.
# EVEJS_LNE_FLEET_EXPOSURE_AMBUSH_AGGRO_PLAYERS=

# the faction escort of a convoy exposure.
# fleetExposure.convoyEscortsEnabled - The escort hulls of a convoy fleet get ships after the carriers; passive until
# the first aggression on the convoy, then they attack the aggressors (needs fleetExposure.enabled and
# convoysEnabled). Default: 0.
# EVEJS_LNE_FLEET_EXPOSURE_CONVOY_ESCORTS_ENABLED=

# fleetExposure.convoyEscortHullGroups - The escort hull groups (no carrier group). Default: frigate,destroyer,cruiser.
# EVEJS_LNE_FLEET_EXPOSURE_CONVOY_ESCORT_HULL_GROUPS=

# fleetExposure.convoyEscortTargetPlayers - The escort attacks the players who attacked the convoy (0 = the ambush
# pirates only). Default: 1.
# EVEJS_LNE_FLEET_EXPOSURE_CONVOY_ESCORT_TARGET_PLAYERS=

# fleetExposure.convoyEscortMaxOrdersPerPass - Escort attack orders per pump pass. Range 1..64. Default: 8.
# EVEJS_LNE_FLEET_EXPOSURE_CONVOY_ESCORT_MAX_ORDERS_PER_PASS=

# fleetExposure.convoyEscortMaxTargets - Player ships kept as escort targets of one exposure. Range 1..64. Default: 16.
# EVEJS_LNE_FLEET_EXPOSURE_CONVOY_ESCORT_MAX_TARGETS=

# fleetExposure.minerBeamsEnabled - Mining laser effect on MINER exposures seen by a player. Range: true/false.
# Default: false.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAMS_ENABLED=

# fleetExposure.minerBeamViewMeters - A player this close to a miner sees the beams. Range 10000..1000000.
# Default: 150000.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAM_VIEW_METERS=

# fleetExposure.minerBeamRockMeters - Farthest asteroid a beam may target. Range 1000..200000. Default: 60000.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAM_ROCK_METERS=

# fleetExposure.minerBeamRefreshMs - Full restart of the beams of an exposure. Range 5000..600000. Default: 30000.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAM_REFRESH_MS=

# fleetExposure.minerBeamMaxFxPerPass - Beam effects sent per exposure pass (0 = none). Range 0..500. Default: 40.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAM_MAX_FX_PER_PASS=

# fleetExposure.minerBeamApproachEnabled - MINER exposures fly to the asteroid at full subwarp before the beam
# (needs minerBeamsEnabled). Range: true/false. Default: false.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAM_APPROACH_ENABLED=

# fleetExposure.minerBeamStartMeters - Surface distance to the asteroid at which the beam starts. Range 2000..60000.
# Default: 10000.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAM_START_METERS=

# fleetExposure.minerBeamApproachMeters - Follow range of the approach (kept below minerBeamStartMeters).
# Range 500..50000. Default: 7500.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAM_APPROACH_METERS=

# fleetExposure.minerBeamRetryMs - Gap between two approach checks of a miner without a beam. Range 1000..60000.
# Default: 5000.
# EVEJS_LNE_FLEET_EXPOSURE_MINER_BEAM_RETRY_MS=

# the presence step - every fleet IDLE / PLANNED / STAGED / REFITTING
# RETREATING of the system of a player gets passive ships (internal; enable it on purpose).
# fleetExposure.presence.enabled - The presence step (independent of fleetExposure.enabled; needs
# battle.liveLossImport.enabled). Default: 0.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_ENABLED=

# fleetExposure.presence.maxShipsPerFleet - Ships of one presence fleet at most. Range 1..32. Default: 3.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_MAX_SHIPS_PER_FLEET=

# fleetExposure.presence.maxShipsPerSystem - Presence ships of one system at most (0 = none). Range 0..256.
# Default: 24.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_MAX_SHIPS_PER_SYSTEM=

# fleetExposure.presence.maxNewShipsPerPass - Presence ships spawned in one pump pass. Range 1..64. Default: 12.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_MAX_NEW_SHIPS_PER_PASS=

# fleetExposure.presence.scanIntervalMs - Minimum time between two presence reads. Range 1000..600000.
# Default: 5000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_SCAN_INTERVAL_MS=

# fleetExposure.presence.maxSystemsPerScan - Observed systems of one presence scan. Range 1..64. Default: 8.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_MAX_SYSTEMS_PER_SCAN=

# fleetExposure.presence.scanMaxFleetsPerSystem - Fleets of one system read by one scan. Range 1..500. Default: 64.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_SCAN_MAX_FLEETS_PER_SYSTEM=

# fleetExposure.presence.exitGraceMs - No player in space for this long -> the presence ships leave.
# Range 1000..600000. Default: 30000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_EXIT_GRACE_MS=

# fleetExposure.presence.yieldHoldMs - After yielding ships the system gets no new presence ships for this long.
# Range 0..3600000. Default: 60000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_YIELD_HOLD_MS=

# fleetExposure.presence.spawnDistanceMeters - Distance of a presence spawn from its anchor. Range 500..100000.
# Default: 8000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_SPAWN_DISTANCE_METERS=

# fleetExposure.presence.unclaimableCooldownMs - A fleet attacked while PLANNED / REFITTING / RETREATING is not shown
# for this long. Range 0..86400000. Default: 300000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_UNCLAIMABLE_COOLDOWN_MS=

# fleetExposure.presence.wipedCooldownMs - A fleet whose presence claim ended WIPED (or after any ship killed by the
# player) is not shown for this long. Range 0..86400000. Default: 600000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_WIPED_COOLDOWN_MS=

# fleetExposure.presence.systemWipeHoldMs - After a presence claim ended WIPED the system gets no new presence ships
# for this long. Range 0..3600000. Default: 120000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_SYSTEM_WIPE_HOLD_MS=

# fleetExposure.presence.claimStagedOperationTypes - Operation types of a STAGED fleet an aggression claims
# other STAGED types are despawned + cooldown; none = no STAGED claim. Default: mining,logistics,ratting,salvage.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_CLAIM_STAGED_OPERATION_TYPES=

# fleetExposure.presence.pendingLossMaxAgeMs - A kill waiting for its claim longer than this is dropped (
# presencePendingExpired). Range 1000..3600000. Default: 120000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_PENDING_LOSS_MAX_AGE_MS=

# the transit phase of the presence step (fleets in flight crossing the system
# of a player). fleetExposure.presence.transitEnabled - Works only with presence.enabled. Default: 1.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_TRANSIT_ENABLED=

# fleetExposure.presence.scanMaxTravelling - Fleets TRAVELLING / RETREATING of one page of the transit cursor.
# Range 1..500. Default: 256.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_SCAN_MAX_TRAVELLING=

# fleetExposure.presence.transitPagesPerScan - Pages of the transit cursor per presence scan. Range 1..8. Default: 1.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_TRANSIT_PAGES_PER_SCAN=

# fleetExposure.presence.transitIndexMax - Routes of the in-memory transit index (0 = only the page of the scan).
# Range 0..65536. Default: 4096.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_TRANSIT_INDEX_MAX=

# fleetExposure.presence.transitClaimOperationTypes - Operation types of a fleet in transit an aggression claims
# (halt like a blockade); none = never. Default: invasion,raid,gank,defense,reinforce,mining.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_TRANSIT_CLAIM_OPERATION_TYPES=

# A presence fleet hostile to a player (standing <= -5
# pirates / invaders also at neutral) wakes in place and attacks. fleetExposure.presence.hostileEnabled - Works only
# with presence.enabled and battle.liveLossImport.enabled. Default: 0.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_ENABLED=

# fleetExposure.presence.hostileAggroRangeMeters - Wake range. Range 10000..1000000. Default: 150000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_AGGRO_RANGE_METERS=

# fleetExposure.presence.hostileChaseRangeMeters - Hold range of a woken fleet (never below aggro).
# Range 10000..1000000. Default: 250000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_CHASE_RANGE_METERS=

# fleetExposure.presence.hostileWakeDelayMs - Target in range this long before the wake. Range 0..60000. Default: 3000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_WAKE_DELAY_MS=

# fleetExposure.presence.hostileMaxWakesPerPass - Wakes per pump pass. Range 1..16. Default: 2.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_MAX_WAKES_PER_PASS=

# fleetExposure.presence.hostileMaxEngagedPerSystem - Woken fleets per system (0 = never). Range 0..32. Default: 4.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_MAX_ENGAGED_PER_SYSTEM=

# fleetExposure.presence.hostileHighsecMaxEngagedPerSystem - Woken fleets per highsec system. Range 0..32. Default: 1.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_HIGHSEC_MAX_ENGAGED_PER_SYSTEM=

# fleetExposure.presence.hostileMaxEngagedGlobal - Woken fleets in the process. Range 0..256. Default: 16.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_MAX_ENGAGED_GLOBAL=

# fleetExposure.presence.hostileSecClasses - Security classes with a wake; none = nowhere.
# Default: highsec,lowsec,nullsec,wormhole.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_SEC_CLASSES=

# fleetExposure.presence.hostileRewakeCooldownMs - No new wake of the fleet after a fight. Range 0..86400000.
# Default: 300000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_REWAKE_COOLDOWN_MS=

# fleetExposure.presence.hostileMaxOrdersPerPass - Attack orders per pump pass. Range 1..256. Default: 24.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_MAX_ORDERS_PER_PASS=

# fleetExposure.presence.hostileMaxStandingReadsPerPass - Standing reads per pump pass. Range 1..1024. Default: 32.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_MAX_STANDING_READS_PER_PASS=

# fleetExposure.presence.hostileStandingTtlMs - Standing cache in memory. Range 0..600000. Default: 30000.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_STANDING_TTL_MS=

# fleetExposure.presence.hostileClaimStates - Fleet states a hostile wake / retaliation claims; REFITTING is
# released back to REFITTING with its repair deadline; none = only IDLE / claimable STAGED. Default: IDLE,STAGED,REFITTING.
# EVEJS_LNE_FLEET_EXPOSURE_PRESENCE_HOSTILE_CLAIM_STATES=

# Event Director pulse (module modules.events - Danger, off by default: EVEJS_LNE_EVENTS_ENABLED).
# All keys internal: not in the launcher, values outside the range are clamped.
# events.refreshIntervalMs - Interval of the SITE_REFRESH pulses. Range 60000..3600000. Default: 300000.
# EVEJS_LNE_EVENTS_REFRESH_INTERVAL_MS=

# events.maxNewEventsPerPass - New events per pulse. Range 1..16. Default: 2.
# EVEJS_LNE_EVENTS_MAX_NEW_EVENTS_PER_PASS=

# events.maxOpenEvents - Open events in the world. Range 1..128. Default: 8.
# EVEJS_LNE_EVENTS_MAX_OPEN_EVENTS=

# events.maxOpenEventsPerSystem - Open events of one system. Range 1..4. Default: 1.
# EVEJS_LNE_EVENTS_MAX_OPEN_EVENTS_PER_SYSTEM=

# events.maxCandidatesPerPass - Candidate systems per pulse. Range 8..1024. Default: 128.
# EVEJS_LNE_EVENTS_MAX_CANDIDATES_PER_PASS=

# events.maxRecentRows - History rows for cooldown and window. Range 64..8192. Default: 1024.
# EVEJS_LNE_EVENTS_MAX_RECENT_ROWS=

# events.presenceRadius - Jumps of the presence bonus. Range 0..5. Default: 2.
# EVEJS_LNE_EVENTS_PRESENCE_RADIUS=

# events.presenceBonus - Score bonus near players, x(1+bonus). Range 0..10. Default: 1.
# EVEJS_LNE_EVENTS_PRESENCE_BONUS=

# events.rowRetentionMs - Retention of terminal event rows. Range 86400000..2592000000. Default: 604800000.
# EVEJS_LNE_EVENTS_ROW_RETENTION_MS=

# events.maxDeletesPerPass - Retention deletes per pulse. Range 1..256. Default: 32.
# EVEJS_LNE_EVENTS_MAX_DELETES_PER_PASS=

# events.maxCleanupRetriesPerPass - Retries of refused site cleanups per pulse. Range 1..64. Default: 8.
# EVEJS_LNE_EVENTS_MAX_CLEANUP_RETRIES_PER_PASS=

# events.debug - Log why per plan and per refusal. true/false. Default: false.
# EVEJS_LNE_EVENTS_DEBUG=

# events.debugMaxSkipped - Refusals in the debug log. Range 1..256. Default: 32.
# EVEJS_LNE_EVENTS_DEBUG_MAX_SKIPPED=

# events.maxFailureLogsPerPulse - Refused transitions, plans and retention logged per pulse (also without debug).
# Range 1..64. Default: 8.
# EVEJS_LNE_EVENTS_MAX_FAILURE_LOGS_PER_PULSE=

# events.failureLogRepeatMs - The same refusal (action, event, reason) is logged again only after this time;
# 0 = every pulse. Range 0..86400000. Default: 3600000.
# EVEJS_LNE_EVENTS_FAILURE_LOG_REPEAT_MS=

# presence activation of the PLANNED events.
# events.presenceActivation - A PLANNED event activates only when a player is within events.activationRadius
# false = activation at the next pulse. Default true since, flipped without the in-game
# gate session (2026-10-31). true/false. Default: true.
# EVEJS_LNE_EVENTS_PRESENCE_ACTIVATION=

# events.activationRadius - Jumps from an observed system. Effective min(activationRadius
# events.presenceRadius); a larger value gives a warning. Range 0..5. Default: 1.
# EVEJS_LNE_EVENTS_ACTIVATION_RADIUS=

# events.plannedWaitMs - A PLANNED event without a player in range longer than this ends CANCELLED/UNOBSERVED,
# outside the cooldown and the site window. Range 300000..86400000. Default: 3600000.
# EVEJS_LNE_EVENTS_PLANNED_WAIT_MS=

# events.nudgeMinIntervalMs - Slot of the nudge pulse: a player who enters the range brings the activation forward,
# at most one nudge pulse per slot. Range 5000..300000. Default: 30000.
# EVEJS_LNE_EVENTS_NUDGE_MIN_INTERVAL_MS=

# events.maxUnobservedOpenEvents - Max open PLANNED events without a player within the activation radius; the
# Director skips the rest as NOT_OBSERVED. Only with events.presenceActivation. 0 = plan only near players
# a value not below events.maxOpenEvents gives the warning EVENTS_UNOBSERVED_CAP_NOOP. Range 0..128. Default: 2.
# EVEJS_LNE_EVENTS_MAX_UNOBSERVED_OPEN_EVENTS=

# events.activeCauseStickyEnabled - An ACTIVE event that already has sites is not cancelled as CAUSE_GONE when its
# cause is gone (a claim changed phase); it ends by expiresAt (EXPIRED) or when a player clears it (CLEARED).
# PLANNED events and ACTIVE events without sites are cancelled as before. true/false. Default: false.
# EVEJS_LNE_EVENTS_ACTIVE_CAUSE_STICKY_ENABLED=

# events.clearedInfluencePoints - A player clears all sites of an event: the content faction of the site (the NPCs
# in it) loses this many influence points in the system, in any occupation state, also a claimant (
# ). No influence row of that faction -> no change. 0 = off (no call). Range 0..100. Default: 20.
# EVEJS_LNE_EVENTS_CLEARED_INFLUENCE_POINTS=

# Upwell stations as EveJS structures (module modules.structures - Danger, off by default:
# EVEJS_LNE_STRUCTURES_ENABLED). Module off = the tagged structures stay frozen in EveJS.
# All keys internal: not in the launcher, values outside the range are clamped.
# structures.mode - project (one structure per live Upwell station) or cleanup (remove every tagged structure,
# NOT_EMPTY -> destroy). A bad value is ignored with a warning. Default: project.
# EVEJS_LNE_STRUCTURES_MODE=

# structures.passMs - Interval between projection passes. Range 1000..600000. Default: 10000.
# EVEJS_LNE_STRUCTURES_PASS_MS=

# structures.fullReconcileMs - Periodic full reconcile (warning below passMs). Range 10000..86400000. Default: 300000.
# EVEJS_LNE_STRUCTURES_FULL_RECONCILE_MS=

# structures.maxWritesPerPass - EveJS structure writes per pass. Range 1..64. Default: 4.
# EVEJS_LNE_STRUCTURES_MAX_WRITES_PER_PASS=

# structures.maxProjected - Live tagged structures in EveJS. Range 1..1000. Default: 64.
# EVEJS_LNE_STRUCTURES_MAX_PROJECTED=

# structures.placementAttempts - Seeded position candidates per station. Range 1..64. Default: 8.
# EVEJS_LNE_STRUCTURES_PLACEMENT_ATTEMPTS=

# structures.placementChecksPerPass - validatePlacement calls per pass. Range 1..64. Default: 4.
# EVEJS_LNE_STRUCTURES_PLACEMENT_CHECKS_PER_PASS=

# structures.placementClearanceM - Distance of a candidate from its celestial in m. Range 1000000..50000000.
# Default: 2500000.
# EVEJS_LNE_STRUCTURES_PLACEMENT_CLEARANCE_M=

# structures.dockingAccess - Docking profile of a projected structure: public, owner or none. Default: public.
# EVEJS_LNE_STRUCTURES_DOCKING_ACCESS=

# structures.quantumCore - Projected structures carry a quantum core. true/false. Default: false.
# EVEJS_LNE_STRUCTURES_QUANTUM_CORE=

# virtualCorps config (Danger module - disabled by default)
# virtualCorps.corpsPerFaction - Corporations per qualifying faction. Range 1..4 (outside: clamped).
# Default: 2.
# EVEJS_LNE_VIRTUAL_CORPS_CORPS_PER_FACTION=

# virtualCorps.membersPerCorp - Characters per corporation. Range 1..50 (outside: clamped).
# Default: 3.
# EVEJS_LNE_VIRTUAL_CORPS_MEMBERS_PER_CORP=

# virtualCorps.maxCharacters - Characters per qualifying faction. Range 1..1024 (outside: clamped).
# Default: 64.
# EVEJS_LNE_VIRTUAL_CORPS_MAX_CHARACTERS=

# virtualCorps.seedOpsPerSlice - Identity creation operations per setImmediate slice. Range 1..32 (outside: clamped).
# Default: 4.
# EVEJS_LNE_VIRTUAL_CORPS_SEED_OPS_PER_SLICE=

# virtualCorps.fleetCorporations - Fleet corporation flag (read by). true/false.
# Default: true.
# EVEJS_LNE_VIRTUAL_CORPS_FLEET_CORPORATIONS=

# virtualCorps.characterScanCacheTtlMs - TTL for cached character scan in virtualIdentities adapter (ms). Range 100..60000 (outside: clamped).
# Default: 5000.
# EVEJS_LNE_VIRTUAL_CORPS_CHARACTER_SCAN_CACHE_TTL_MS=

# virtualCorps.sagaMaxIterations - Max saga iterations per faction (safety limit for stuck rows). Range 10..500 (outside: clamped).
# Default: 100.
# EVEJS_LNE_VIRTUAL_CORPS_SAGA_MAX_ITERATIONS=

# virtualCorps.sagaNoProgressIterations - Consecutive saga iterations with zero progress before giving up on a faction. Range 1..50 (outside: clamped).
# Default: 3.
# EVEJS_LNE_VIRTUAL_CORPS_SAGA_NO_PROGRESS_ITERATIONS=

# virtualCorps.ownerCharacterBudget - Characters of the owner corporations (capsuleers + civilians); = config
# warning only (enforced from). Range 0..16384 (outside: clamped). Default: 2048.
# EVEJS_LNE_VIRTUAL_CORPS_OWNER_CHARACTER_BUDGET=

# free corporation saga - free owners only, needs
# freeCorps.enabled (W44). Factions, capsuleers and civilians are unchanged.
# virtualCorps.freeSaga.lean - CEO without a third affiliation, member state once per slice, flush
# of 3 tables. Default: false.
# EVEJS_LNE_VIRTUAL_CORPS_FREE_SAGA_LEAN=
# virtualCorps.freeSaga.membersStartInCorp - born members written in their corporation at once (no career stage
# no flush; the employment history starts with the free corporation). Default: false.
# EVEJS_LNE_VIRTUAL_CORPS_FREE_SAGA_MEMBERS_START_IN_CORP=

# The own name table of the mod (lib/names). Internal, not in the
# launcher.
# names.enabled - module flag of lib/names (pure code); off = the identity saga keeps the vendor generator.
# Range: true/false. Default: true.
# EVEJS_LNE_NAMES_ENABLED=
# names.characterNamesEnabled - new LNE characters get a name from lib/names ("First Last", on a collision a middle
# name, a double surname or a nickname, never a number). Off = vendor getValidRandomName bit for bit (adds " 2", " 3").
# Range: true/false. Default: false (recommendation on).
# EVEJS_LNE_NAMES_CHARACTER_NAMES_ENABLED=
# names.maxAttempts - candidates per name (8 per pattern). Range 8..256 (outside: clamped). Default: 48.
# EVEJS_LNE_NAMES_MAX_ATTEMPTS=
# Rename of the existing LNE characters with a number suffix.
# names.renameSuffixedEnabled - after virtualCorps is ready, the LNE characters named "First Last 2" get a lib/names
# name in batches (EveJS record + mod identity row). Off = no read, no write. Range: true/false. Default: false.
# EVEJS_LNE_NAMES_RENAME_SUFFIXED_ENABLED=
# names.renameBatchPerPass - characters renamed per pass. Range 1..500 (outside: clamped). Default: 50.
# EVEJS_LNE_NAMES_RENAME_BATCH_PER_PASS=
# names.renamePassMs - pause between two passes while candidates are left. Range 1000..600000. Default: 5000.
# EVEJS_LNE_NAMES_RENAME_PASS_MS=

# hunt service config (hunter/interceptor fleets, module strategy + hunt.enabled; off by default).
# All keys internal: not in the launcher, values outside the range are clamped.
# hunt.enabled - Master switch for the hunt service. Off = no pins, no scans, no poller.
# Range: true/false. Default: false.
# EVEJS_LNE_HUNT_ENABLED=

# hunt.dwellMs - Patrol dwell time per system (ms) - hunter waits before next scan.
# Range 60000..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_HUNT_DWELL_MS=

# hunt.pinBaseMs - Base pin duration (ms) before cover/speed modifiers (D-6 formula).
# Range 60000..3600000 (outside: clamped). Default: 900000.
# EVEJS_LNE_HUNT_PIN_BASE_MS=

# hunt.pinMinMs - Minimum pin duration (ms); below this -> NO_TACKLE.
# Range 1000..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_HUNT_PIN_MIN_MS=

# hunt.pinMaxMs - Maximum pin duration (ms); cap after cover/speed modifiers.
# Range 60000..3600000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_HUNT_PIN_MAX_MS=

# hunt.pinGraceMs - Grace after strike arrival before pin expires; MUST be < battle.engageDelayMs (60000 default).
# Range 0..60000 (outside: clamped). Default: 30000.
# EVEJS_LNE_HUNT_PIN_GRACE_MS=

# hunt.speedPenaltyPermille - Speed penalty per speed class difference (permille) in D-6 formula.
# Range 0..10000 (outside: clamped). Default: 500.
# EVEJS_LNE_HUNT_SPEED_PENALTY_PERMILLE=

# hunt.strikeMaxJumps - Maximum jumps for a strike fleet to travel to the pin.
# Range 1..40 (outside: clamped). Default: 5.
# EVEJS_LNE_HUNT_STRIKE_MAX_JUMPS=

# hunt.strikeScanMaxFleets - Maximum candidate strike fleets to evaluate per scan.
# Range 1..500 (outside: clamped). Default: 32.
# EVEJS_LNE_HUNT_STRIKE_SCAN_MAX_FLEETS=

# hunt.maxActivePinsPerFaction - Concurrent active pins per hunter faction (limit on parallel intercepts).
# Range 0..64 (outside: clamped). Default: 2.
# EVEJS_LNE_HUNT_MAX_ACTIVE_PINS_PER_FACTION=

# hunt.maxActivePins - Global concurrent active pins across all factions.
# Range 0..1024 (outside: clamped). Default: 64.
# EVEJS_LNE_HUNT_MAX_ACTIVE_PINS=

# hunt.maxHuntersPerFaction - Maximum hunter fleets per faction (separate from strategy.maxFleetsPerFaction).
# Range 0..32 (outside: clamped). Default: 2.
# EVEJS_LNE_HUNT_MAX_HUNTERS_PER_FACTION=

# hunt.attackStrengthRatio - Required strength ratio for strike fleet (same as strategy.attackStrengthRatio).
# Range 0.1..10 (outside: clamped). Default: 1.2.
# EVEJS_LNE_HUNT_ATTACK_STRENGTH_RATIO=

# hunt.scanOnHostileArrival - Also scan when a hostile fleet arrives in a system with a hunter (costs one listener read).
# Range: true/false. Default: false.
# EVEJS_LNE_HUNT_SCAN_ON_HOSTILE_ARRIVAL=

# hunt.scanMaxFleets - Fleets of a system read by one scan; more -> SCAN_TRUNCATED, no pin.
# Range 1..500 (outside: clamped). Default: 64.
# EVEJS_LNE_HUNT_SCAN_MAX_FLEETS=

# hunt.maxHuntersPerScan - Hunters of a system evaluated by one scan (fleetId order).
# Range 1..32 (outside: clamped). Default: 4.
# EVEJS_LNE_HUNT_MAX_HUNTERS_PER_SCAN=

# hunt.maxScansPerPass - HUNT_SCAN events per scheduler pass.
# Range 1..1000 (outside: clamped). Default: 16.
# EVEJS_LNE_HUNT_MAX_SCANS_PER_PASS=

# hunt.maxExpiresPerPass - HUNT_PIN_EXPIRE events per scheduler pass.
# Range 1..1000 (outside: clamped). Default: 32.
# EVEJS_LNE_HUNT_MAX_EXPIRES_PER_PASS=

# hunt.maxBfsSystems - Systems visited by the strike search of one scan.
# Range 1..10000 (outside: clamped). Default: 500.
# EVEJS_LNE_HUNT_MAX_BFS_SYSTEMS=

# lowsec camps (pirate fleets camp a lowsec system near highsec; module strategy + lowsec.enabled; on by
# default since). All keys internal: not in the launcher, values outside the range are clamped.
# lowsec.enabled - Master switch of the lowsec camps. Off = no handlers, no LOWSEC_* events, no camp rows.
# Default true since, flipped without the in-game gate session (2026-10-31).
# Range: true/false. Default: true.
# EVEJS_LNE_LOWSEC_ENABLED=

# lowsec.planPeriodMs - Period of the LOWSEC_CAMP_PLAN chain (ms).
# Range 60000..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_LOWSEC_PLAN_PERIOD_MS=

# lowsec.maxActiveCamps - Open camps (PLANNED or ACTIVE, until_at > now) in the galaxy.
# Range 0..32 (outside: clamped). Default: 6.
# EVEJS_LNE_LOWSEC_MAX_ACTIVE_CAMPS=

# lowsec.maxActiveCampsPerFaction - Open camps of one pirate faction.
# Range 0..16 (outside: clamped). Default: 2.
# EVEJS_LNE_LOWSEC_MAX_ACTIVE_CAMPS_PER_FACTION=

# lowsec.maxCampsPerPlan - New camps of one plan round.
# Range 1..16 (outside: clamped). Default: 2.
# EVEJS_LNE_LOWSEC_MAX_CAMPS_PER_PLAN=

# lowsec.campMinMs - Shortest camp (ms); a camp that holds less after the trip is refused (CAMP_TOO_SHORT).
# Range 60000..14400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_LOWSEC_CAMP_MIN_MS=

# lowsec.campMaxMs - Longest camp (ms); below lowsec.campMinMs the service uses lowsec.campMinMs (warning).
# Range 60000..14400000 (outside: clamped). Default: 5400000.
# EVEJS_LNE_LOWSEC_CAMP_MAX_MS=

# lowsec.campMaxJumps - Jumps from the fleet to a camp system.
# Range 1..20 (outside: clamped). Default: 6.
# EVEJS_LNE_LOWSEC_CAMP_MAX_JUMPS=

# lowsec.campChoiceTopN - The seeded choice is made among the best N ranked systems.
# Range 1..16 (outside: clamped). Default: 3.
# EVEJS_LNE_LOWSEC_CAMP_CHOICE_TOP_N=

# lowsec.fleetScanMax - IDLE fleets of a faction read by one plan.
# Range 1..500 (outside: clamped). Default: 32.
# EVEJS_LNE_LOWSEC_FLEET_SCAN_MAX=

# lowsec.maxBfsSystems - Systems visited by the camp search around one fleet.
# Range 1..10000 (outside: clamped). Default: 500.
# EVEJS_LNE_LOWSEC_MAX_BFS_SYSTEMS=

# lowsec.stepIntervalMs - Interval of the LOWSEC_CAMP_STEP of an ACTIVE camp (ms).
# Range 10000..600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_LOWSEC_STEP_INTERVAL_MS=

# lowsec.stepRecheckMs - Recheck of a PLANNED camp whose fleet is still on its way (ms).
# Range 10000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_LOWSEC_STEP_RECHECK_MS=

# lowsec.maxWatchRounds - Rechecks of a PLANNED camp before it ends CANCELLED TIMEOUT.
# Range 1..100 (outside: clamped). Default: 10.
# EVEJS_LNE_LOWSEC_MAX_WATCH_ROUNDS=

# lowsec.reconcileMaxCamps - Open camps checked for a missing step event after a start.
# Range 1..1024 (outside: clamped). Default: 64.
# EVEJS_LNE_LOWSEC_RECONCILE_MAX_CAMPS=

# lowsec.reconcileMaxAttempts - Suffixed reconcile keys tried per camp step (pattern construction).
# Range 1..64 (outside: clamped). Default: 8.
# EVEJS_LNE_LOWSEC_RECONCILE_MAX_ATTEMPTS=

# lowsec.endedRetentionMs - ENDED camp rows are kept this long (ms).
# Range 3600000..2592000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_LOWSEC_ENDED_RETENTION_MS=

# lowsec.pruneMaxRows - ENDED camp rows deleted by one plan.
# Range 1..1000 (outside: clamped). Default: 64.
# EVEJS_LNE_LOWSEC_PRUNE_MAX_ROWS=

# lowsec.scanMaxConvoys - IN_TRANSIT convoys read by one camp step scan (more: the next scan goes on after the last one).
# 256, so a truncated read (lowsec.scanTruncated) is the exception.
# Range 1..500 (outside: clamped). Default: 256.
# EVEJS_LNE_LOWSEC_SCAN_MAX_CONVOYS=

# lowsec.maxStrikesPerScan - New LOWSEC_AMBUSH events of one camp step.
# Range 1..64 (outside: clamped). Default: 4.
# EVEJS_LNE_LOWSEC_MAX_STRIKES_PER_SCAN=

# lowsec.interceptChancePermille - Chance that a convoy crossing a camp system is stopped (else it escapes).
# Range 0..1000 (outside: clamped). Default: 800.
# EVEJS_LNE_LOWSEC_INTERCEPT_CHANCE_PERMILLE=

# lowsec.captureEnabled - AI may capture a lowsec system. Off = a lowsec candidate of the theatre, the expansion or
# the belt gets no capturing kind (a hostile one can still get a raid). Works also with lowsec.enabled=false.
# Range: true/false. Default: false.
# EVEJS_LNE_LOWSEC_CAPTURE_ENABLED=

# wormhole expeditions (pirate patrol fleets go through a wormhole pair into J-space for a while; presence is
# a field of the expedition, never a world row; module strategy + expeditions.enabled + wormholes.enabled; on by
# default since). All keys internal: not in the launcher, values outside the range are clamped.
# expeditions.enabled - Master switch of the expeditions. Off = no handlers, no WH_EXPEDITION_* events, no expedition
# rows. Needs wormholes.enabled (else the service refuses WORMHOLES_DISABLED).
# Default true since, flipped without the in-game gate session (2026-10-31).
# Range: true/false. Default: true.
# EVEJS_LNE_EXPEDITIONS_ENABLED=

# expeditions.planPeriodMs - Period of the WH_EXPEDITION_PLAN chain (ms).
# Range 60000..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_EXPEDITIONS_PLAN_PERIOD_MS=

# expeditions.maxActiveExpeditions - Open expeditions (not ENDED) in the galaxy.
# Range 0..50 (outside: clamped). Default: 3.
# EVEJS_LNE_EXPEDITIONS_MAX_ACTIVE_EXPEDITIONS=

# expeditions.maxActiveExpeditionsPerFaction - Open expeditions of one pirate faction.
# Range 0..10 (outside: clamped). Default: 1.
# EVEJS_LNE_EXPEDITIONS_MAX_ACTIVE_EXPEDITIONS_PER_FACTION=

# expeditions.maxExpeditionsPerPlan - New expeditions of one plan round.
# Range 1..10 (outside: clamped). Default: 1.
# EVEJS_LNE_EXPEDITIONS_MAX_EXPEDITIONS_PER_PLAN=

# expeditions.entryMaxJumps - Gate jumps from the fleet to the k-space end of a wormhole (0 = at the entry).
# Range 0..15 (outside: clamped). Default: 5.
# EVEJS_LNE_EXPEDITIONS_ENTRY_MAX_JUMPS=

# expeditions.expeditionMinMs - Shortest stay in J-space (ms); less after the trip -> refused.
# Range 600000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_EXPEDITIONS_EXPEDITION_MIN_MS=

# expeditions.expeditionMaxMs - Longest stay in J-space (ms); below expeditionMinMs the service uses expeditionMinMs
# (warning).
# Range 600000..604800000 (outside: clamped). Default: 14400000.
# EVEJS_LNE_EXPEDITIONS_EXPEDITION_MAX_MS=

# expeditions.returnMarginMs - The evacuation starts this long before the entry wormhole expires (ms).
# Range 0..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_EXPEDITIONS_RETURN_MARGIN_MS=

# expeditions.stepIntervalMs - Interval of the WH_EXPEDITION_STEP of an ACTIVE expedition (ms).
# Range 60000..3600000 (outside: clamped). Default: 600000.
# EVEJS_LNE_EXPEDITIONS_STEP_INTERVAL_MS=

# expeditions.stepRecheckMs - Recheck of an expedition whose fleet is on its way or busy (ms).
# Range 10000..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_EXPEDITIONS_STEP_RECHECK_MS=

# expeditions.maxWatchRounds - Rechecks of a PLANNED expedition waiting for departure before CANCELLED TIMEOUT.
# Range 1..100 (outside: clamped). Default: 10.
# EVEJS_LNE_EXPEDITIONS_MAX_WATCH_ROUNDS=

# expeditions.presenceGainPermille - Presence gained per ACTIVE step (permille, capped at 1000).
# Range 0..1000 (outside: clamped). Default: 100.
# EVEJS_LNE_EXPEDITIONS_PRESENCE_GAIN_PERMILLE=

# expeditions.cutOffRecheckMs - Recheck of a CUT_OFF expedition for a new route out (ms).
# Range 60000..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_EXPEDITIONS_CUT_OFF_RECHECK_MS=

# expeditions.cutOffDecisionMs - Decision deadline of a CUT_OFF expedition after the cut (ms).
# Range 3600000..604800000 (outside: clamped). Default: 86400000.
# EVEJS_LNE_EXPEDITIONS_CUT_OFF_DECISION_MS=

# expeditions.syncWaitMs - A step before the first wormhole sync is deferred this long (ms, attempt given back).
# Range 5000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_EXPEDITIONS_SYNC_WAIT_MS=

# expeditions.fleetScanMax - IDLE fleets of a faction read by one plan.
# Range 1..500 (outside: clamped). Default: 50.
# EVEJS_LNE_EXPEDITIONS_FLEET_SCAN_MAX=

# expeditions.maxBfsSystems - Systems visited by the entry search around one fleet.
# Range 10..20000 (outside: clamped). Default: 2000.
# EVEJS_LNE_EXPEDITIONS_MAX_BFS_SYSTEMS=

# expeditions.candidateTopN - The seeded choice is made among the best N ranked J-space systems.
# Range 1..20 (outside: clamped). Default: 3.
# EVEJS_LNE_EXPEDITIONS_CANDIDATE_TOP_N=

# expeditions.reconcileMaxExpeditions - Open expeditions checked for a missing step event after a start.
# Range 1..5000 (outside: clamped). Default: 200.
# EVEJS_LNE_EXPEDITIONS_RECONCILE_MAX_EXPEDITIONS=

# expeditions.reconcileMaxAttempts - Suffixed reconcile keys tried per expedition step.
# Range 1..50 (outside: clamped). Default: 5.
# EVEJS_LNE_EXPEDITIONS_RECONCILE_MAX_ATTEMPTS=

# expeditions.endedRetentionMs - ENDED expedition rows are kept this long (ms).
# Range 0..2592000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_EXPEDITIONS_ENDED_RETENTION_MS=

# expeditions.pruneMaxRows - ENDED expedition rows deleted by one plan.
# Range 1..5000 (outside: clamped). Default: 200.
# EVEJS_LNE_EXPEDITIONS_PRUNE_MAX_ROWS=

# expeditions.capitalMassRuleEnabled - A fleet with a capital may go through
# a wormhole pair with maxJumpMass >= its heaviest capital (plan, route, replan, evacuation); a pair without a known
# mass is refused. Off = no capital ever goes on an expedition. Needs strategy.capitalAttachEnabled to matter.
# Range: true/false. Default: false.
# EVEJS_LNE_EXPEDITIONS_CAPITAL_MASS_RULE_ENABLED=

# expeditions.maxCapitalHullsPerExpedition - Capitals of one expedition fleet with the mass rule on (: one
# capital there and back fits the total mass of a 2 bn pair, two would close it).
# Range 1..3 (outside: clamped). Default: 1.
# EVEJS_LNE_EXPEDITIONS_MAX_CAPITAL_HULLS_PER_EXPEDITION=

# expeditions.massRuleExcludedHullGroups - Capital classes that never go with the mass rule on (none or a
# comma list of carrier|dreadnought|force_auxiliary|supercarrier|titan; titans never fit by mass anyway).
# Default: supercarrier.
# EVEJS_LNE_EXPEDITIONS_MASS_RULE_EXCLUDED_HULL_GROUPS=

# expeditions.subcapMassRuleEnabled - Subcap hulls count in the expedition
# mass rule (class maximum of lib/fleets/data/hullMasses.js SUBCAP_CLASS_MASS_KG): plan, route, replan and
# evacuation only through a pair with maxJumpMass >= the heaviest hull. Off = subcaps weigh 0 as before.
# Range: true/false. Default: false.
# EVEJS_LNE_EXPEDITIONS_SUBCAP_MASS_RULE_ENABLED=

# capsuleer corporations (EveJS corporations with members, a base in lowsec next to pirate space, a mod ISK
# wallet and small fleets of faction 500018; module strategy + capsuleers.enabled + modules.virtualCorps.enabled; off
# by default). All keys internal: not in the launcher, values outside the range are clamped.
# capsuleers.enabled - Master switch of the capsuleer corporations. Off = no handler, no CAPSULEER_* events; rows and
# fleets stay.
# Range: true/false. Default: false.
# EVEJS_LNE_CAPSULEERS_ENABLED=

# capsuleers.maxCorps - Capsuleer corporation slots (1..maxCorps).
# Range 0..64 (outside: clamped). Default: 4.
# EVEJS_LNE_CAPSULEERS_MAX_CORPS=

# capsuleers.membersPerCorp - EveJS characters of one capsuleer corporation (CEO included).
# Range 1..10 (outside: clamped). Default: 3.
# EVEJS_LNE_CAPSULEERS_MEMBERS_PER_CORP=

# capsuleers.maxFleetsPerCorp - Live fleets of one capsuleer corporation (no buy above; ratters get maxFleetsPerCorp - maxMercenaryFleetsPerCorp since).
# Range 0..8 (outside: clamped). Default: 3.
# EVEJS_LNE_CAPSULEERS_MAX_FLEETS_PER_CORP=

# capsuleers.reviewPeriodMs - Period of the CAPSULEER_CORP_REVIEW chain (ms).
# Range 60000..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_CAPSULEERS_REVIEW_PERIOD_MS=

# capsuleers.maxFoundingsPerReview - New corporations of one review.
# Range 0..8 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_MAX_FOUNDINGS_PER_REVIEW=

# capsuleers.maxFleetBuysPerReview - Fleets bought by all corporations in one review.
# Range 0..8 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_MAX_FLEET_BUYS_PER_REVIEW=

# capsuleers.fleetBudgetEnabled - capsuleer fleet budget: a buy only below maxFleetsTotal capsuleer fleets and
# while the active fleets stay below limits.maxVirtualFleets - minFleetHeadroom (refusal counted capsuleers.fleetBudget);
# buys rotate by round. Off = buys as before.
# Range: true/false. Default: false.
# EVEJS_LNE_CAPSULEERS_FLEET_BUDGET_ENABLED=

# capsuleers.maxFleetsTotal - most live capsuleer fleets with fleetBudgetEnabled.
# Range 0..512 (outside: clamped). Default: 48.
# EVEJS_LNE_CAPSULEERS_MAX_FLEETS_TOTAL=

# capsuleers.minFleetHeadroom - active fleets kept free below limits.maxVirtualFleets with fleetBudgetEnabled.
# Range 0..2000 (outside: clamped). Default: 100.
# EVEJS_LNE_CAPSULEERS_MIN_FLEET_HEADROOM=

# free-corps start scale - recommended start values (copy to the root.env and uncomment):
# EVEJS_LNE_CAPSULEERS_MAX_CORPS=12
# EVEJS_LNE_CAPSULEERS_MEMBERS_PER_CORP=5
# EVEJS_LNE_CAPSULEERS_MAX_FOUNDINGS_PER_REVIEW=2
# EVEJS_LNE_CAPSULEERS_MAX_FLEET_BUYS_PER_REVIEW=3
# EVEJS_LNE_CAPSULEERS_FLEET_BUDGET_ENABLED=1
# EVEJS_LNE_CAPSULEERS_MAX_FLEETS_TOTAL=36
# EVEJS_LNE_CAPSULEERS_MIN_FLEET_HEADROOM=150
# EVEJS_LNE_HIGHSEC_LIFE_CIVILIAN_CORPS=40

# free corps tier 2 - corporations without fleets, real
# EveJS identities (owner kind free, prefix i) through virtualCorps; panel free-corps. Needs modules.world and
# modules.virtualCorps. Internal: not in the launcher. Read at boot. Start scale (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_ENABLED=1
# EVEJS_LNE_FREE_CORPS_TARGET_CORPS=60
# EVEJS_LNE_FREE_CORPS_FOUNDING_INTERVAL_MS=60000
#
# freeCorps.enabled - Feature flag (off = no service, no timer, an empty table). true/false. Default: false.
# EVEJS_LNE_FREE_CORPS_ENABLED=
# freeCorps.targetCorps - Open corporations (0 = no founding). Range 0..1000. Default: 60.
# EVEJS_LNE_FREE_CORPS_TARGET_CORPS=
# freeCorps.membersMin / membersMax - Characters of a corporation. Range 1..10. Default: 3 / 8.
# EVEJS_LNE_FREE_CORPS_MEMBERS_MIN=
# EVEJS_LNE_FREE_CORPS_MEMBERS_MAX=
# freeCorps.passMs - Period of the pass. Range 1000..60000. Default: 5000.
# EVEJS_LNE_FREE_CORPS_PASS_MS=
# freeCorps.maxCorpsPerPass - Due corporations per pass. Range 1..256. Default: 32.
# EVEJS_LNE_FREE_CORPS_MAX_CORPS_PER_PASS=
# freeCorps.maxPassMs - Time budget of a pass. Range 1..100. Default: 8.
# EVEJS_LNE_FREE_CORPS_MAX_PASS_MS=
# freeCorps.foundingIntervalMs - Least time between two foundings. Range 5000..86400000. Default: 60000.
# EVEJS_LNE_FREE_CORPS_FOUNDING_INTERVAL_MS=
# freeCorps.maxFoundingsPerPass - Foundings per pass (0 = population frozen). Range 0..8. Default: 1.
# EVEJS_LNE_FREE_CORPS_MAX_FOUNDINGS_PER_PASS=
# freeCorps.maxFoundingOpen - Corporations FOUNDING at a time. Range 1..16. Default: 2.
# EVEJS_LNE_FREE_CORPS_MAX_FOUNDING_OPEN=
# freeCorps.foundingRecheckMs - Recheck of a FOUNDING corporation. Range 5000..600000. Default: 30000.
# EVEJS_LNE_FREE_CORPS_FOUNDING_RECHECK_MS=
# freeCorps.foundingStaleMs - FOUNDING older than this = foundingStale. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_FREE_CORPS_FOUNDING_STALE_MS=
# freeCorps.activeIdleMs - Review of an ACTIVE corporation. Range 60000..86400000. Default: 600000.
# EVEJS_LNE_FREE_CORPS_ACTIVE_IDLE_MS=
# freeCorps.maxRefused - REFUSED corporations that stop the founding. Range 1..10000. Default: 50.
# EVEJS_LNE_FREE_CORPS_MAX_REFUSED=
# freeCorps.bandWeights - band:weight list. Default: highsec:50,lowsec:30,nullsec:20.
# EVEJS_LNE_FREE_CORPS_BAND_WEIGHTS=
# freeCorps.archetypeWeights - archetype:weight list.
# Default: miner:20,hauler:15,ratter:15,explorer:10,industrialist:10,missioner:15.
# EVEJS_LNE_FREE_CORPS_ARCHETYPE_WEIGHTS=
# freeCorps.maxCorpsPerHomeSystem - Open corporations per home system. Range 1..20. Default: 3.
# EVEJS_LNE_FREE_CORPS_MAX_CORPS_PER_HOME_SYSTEM=
# freeCorps.maxHomeAttempts - Home systems drawn per founding. Range 1..64. Default: 8.
# EVEJS_LNE_FREE_CORPS_MAX_HOME_ATTEMPTS=
# freeCorps.maxNameAttempts - Names drawn per founding. Range 1..32. Default: 8.
# EVEJS_LNE_FREE_CORPS_MAX_NAME_ATTEMPTS=
# freeCorps.initialIsk - Starting wallet of a corporation. Range 0..1000000000000. Default: 200000000.
# EVEJS_LNE_FREE_CORPS_INITIAL_ISK=
# freeCorps.observerMaxRows - Rows of the panel free-corps. Range 10..1000. Default: 200.
# EVEJS_LNE_FREE_CORPS_OBSERVER_MAX_ROWS=

# free corps ventures - one venture per
# corporation (MINE, HAUL, RAT, EXPLORE, BUILD, RUN), stepped every stepMs, deterministic result in the mod treasury;
# upkeep, growth, STRUGGLING. Needs freeCorps.enabled. Internal: not in the launcher. Read at boot. Start
# (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_VENTURES_ENABLED=1
# EVEJS_LNE_FREE_CORPS_VENTURES_STEP_MS=900000
# EVEJS_LNE_FREE_CORPS_VENTURES_REST_MS=1800000
#
# freeCorps.ventures.enabled - Feature flag (off = corporations idle as in, zero venture rows). Default: false.
# EVEJS_LNE_FREE_CORPS_VENTURES_ENABLED=
# freeCorps.ventures.stepMs - Time of one venture step. Range 60000..86400000. Default: 900000.
# EVEJS_LNE_FREE_CORPS_VENTURES_STEP_MS=
# freeCorps.ventures.restMs - Rest after a venture / a refused plan. Range 60000..86400000. Default: 1800000.
# EVEJS_LNE_FREE_CORPS_VENTURES_REST_MS=
# freeCorps.ventures.holdMs - Wait of a loss step in an observed system. Range 60000..3600000. Default: 600000.
# EVEJS_LNE_FREE_CORPS_VENTURES_HOLD_MS=
# freeCorps.ventures.maxHolds - Holds before the crew returns without a loss. Range 1..48. Default: 6.
# EVEJS_LNE_FREE_CORPS_VENTURES_MAX_HOLDS=
# freeCorps.ventures.maxJumps - Reach of a venture from home. Range 1..15. Default: 6.
# EVEJS_LNE_FREE_CORPS_VENTURES_MAX_JUMPS=
# freeCorps.ventures.jumpsPerStep - Jumps travelled in one step. Range 1..15. Default: 3.
# EVEJS_LNE_FREE_CORPS_VENTURES_JUMPS_PER_STEP=
# freeCorps.ventures.maxBfsSystems - Systems of the reach search. Range 10..2000. Default: 200.
# EVEJS_LNE_FREE_CORPS_VENTURES_MAX_BFS_SYSTEMS=
# freeCorps.ventures.reachMemoMax - Homes whose reach is kept in memory. Range 16..4096. Default: 256.
# EVEJS_LNE_FREE_CORPS_VENTURES_REACH_MEMO_MAX=
# freeCorps.ventures.workStepsMin / workStepsMax - Work steps of a venture. Range 1..16. Default: 2 / 6.
# EVEJS_LNE_FREE_CORPS_VENTURES_WORK_STEPS_MIN=
# EVEJS_LNE_FREE_CORPS_VENTURES_WORK_STEPS_MAX=
# freeCorps.ventures.yieldVariancePermille - Spread of the yield of a step. Range 0..900. Default: 200.
# EVEJS_LNE_FREE_CORPS_VENTURES_YIELD_VARIANCE_PERMILLE=
# freeCorps.ventures.yield.<kind> - ISK per work step per pilot. Range 0..1000000000.
# Default: mine 2000000, haul 3000000, rat 4000000, explore 5000000, run 2500000.
# EVEJS_LNE_FREE_CORPS_VENTURES_YIELD_MINE=
# EVEJS_LNE_FREE_CORPS_VENTURES_YIELD_HAUL=
# EVEJS_LNE_FREE_CORPS_VENTURES_YIELD_RAT=
# EVEJS_LNE_FREE_CORPS_VENTURES_YIELD_EXPLORE=
# EVEJS_LNE_FREE_CORPS_VENTURES_YIELD_RUN=
# freeCorps.ventures.buildInputIskPerStepPerPilot - BUILD input per step per pilot. Range 0..1000000000.
# Default: 3000000.
# EVEJS_LNE_FREE_CORPS_VENTURES_BUILD_INPUT_ISK_PER_STEP_PER_PILOT=
# freeCorps.ventures.buildMarginPermille - BUILD margin on the input. Range 0..1000. Default: 150.
# EVEJS_LNE_FREE_CORPS_VENTURES_BUILD_MARGIN_PERMILLE=
# freeCorps.ventures.loss.<band>Permille - Loss chance of a work step (x kind risk / 1e6). Range 0..1000.
# Default: highsec 2, lowsec 20, nullsec 40.
# EVEJS_LNE_FREE_CORPS_VENTURES_LOSS_HIGHSEC_PERMILLE=
# EVEJS_LNE_FREE_CORPS_VENTURES_LOSS_LOWSEC_PERMILLE=
# EVEJS_LNE_FREE_CORPS_VENTURES_LOSS_NULLSEC_PERMILLE=
# freeCorps.ventures.shipLossIskPerPilot - Treasury cost of one lost ship. Range 0..10000000000. Default: 20000000.
# EVEJS_LNE_FREE_CORPS_VENTURES_SHIP_LOSS_ISK_PER_PILOT=
# freeCorps.ventures.recoverMs - Time the lost crew is missing. Range 0..604800000. Default: 21600000.
# EVEJS_LNE_FREE_CORPS_VENTURES_RECOVER_MS=
# freeCorps.lifecycle.upkeepIskPerMember - Upkeep per member per review. Range 0..10000000000. Default: 1000000.
# EVEJS_LNE_FREE_CORPS_LIFECYCLE_UPKEEP_ISK_PER_MEMBER=
# freeCorps.lifecycle.growthIskThreshold - Treasury for one more member. Range 0..1000000000000. Default: 2000000000.
# EVEJS_LNE_FREE_CORPS_LIFECYCLE_GROWTH_ISK_THRESHOLD=
# freeCorps.lifecycle.growthCostIsk - Cost of one more member. Range 0..1000000000000. Default: 500000000.
# EVEJS_LNE_FREE_CORPS_LIFECYCLE_GROWTH_COST_ISK=
# freeCorps.lifecycle.struggleReviews - Unpaid upkeeps before STRUGGLING. Range 1..100. Default: 6.
# EVEJS_LNE_FREE_CORPS_LIFECYCLE_STRUGGLE_REVIEWS=
# freeCorps.lifecycle.dissolveEnabled - STRUGGLING -> DISSOLVED (state only until). Default: false.
# EVEJS_LNE_FREE_CORPS_LIFECYCLE_DISSOLVE_ENABLED=
# freeCorps.retention.ventureRetentionMs - Closed ventures older than this are deleted. Range 3600000..7776000000.
# Default: 604800000.
# EVEJS_LNE_FREE_CORPS_RETENTION_VENTURE_RETENTION_MS=
# freeCorps.retention.pruneBatch - Closed ventures deleted per pass. Range 1..1024. Default: 64.
# EVEJS_LNE_FREE_CORPS_RETENTION_PRUNE_BATCH=

# free corps in Local and on the map - the crew of
# an open venture and part of the members at home in the Local of the observed systems (reads only, no write); the
# homes and ventures as marks of layer-capsuleers. Local needs freeCorps.enabled and localPilots.enabled; the map needs
# freeCorps.enabled and observer.galaxyEnabled + observer.galaxyCapsuleersEnabled. Internal: not in the launcher.
# Read at boot. Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_LOCAL_ENABLED=1
# EVEJS_LNE_FREE_CORPS_MAP_ENABLED=1
#
# freeCorps.local.enabled - Feature flag of the residents in Local. Default: false.
# EVEJS_LNE_FREE_CORPS_LOCAL_ENABLED=
# freeCorps.local.maxResidentsPerSystem - Residents per Local system (0 = none). Range 0..500. Default: 40.
# EVEJS_LNE_FREE_CORPS_LOCAL_MAX_RESIDENTS_PER_SYSTEM=
# freeCorps.local.homeIdlePermille - Part of the non-crew members at home per bucket. Range 0..1000. Default: 300.
# EVEJS_LNE_FREE_CORPS_LOCAL_HOME_IDLE_PERMILLE=
# freeCorps.local.bucketMs - Rotation of the members at home. Range 60000..86400000. Default: 1800000.
# EVEJS_LNE_FREE_CORPS_LOCAL_BUCKET_MS=
# freeCorps.map.enabled - Feature flag of the free corp marks on the map. Default: false.
# EVEJS_LNE_FREE_CORPS_MAP_ENABLED=
# freeCorps.map.maxMarks - Rows per read and marks on the map (0 = none). Range 0..4000. Default: 400.
# EVEJS_LNE_FREE_CORPS_MAP_MAX_MARKS=

# free corps in the Local chatter - the tier 2
# residents shown in Local speak about their venture, last result or archetype (a second lane of the highsecLife
# chatter poller, the same global maxLinesPerMinute), and the rare closed ventures (LOST, rich DONE) become rumours
# told by the civilians. Reads only, no write. Needs freeCorps.enabled, highsecLife.civilians.enabled and
# highsecLife.chatter.enabled (W13); lines need freeCorps.local.enabled (W14), rumours freeCorps.ventures.enabled (W15).
# Internal: not in the launcher. Read at boot. Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_CHATTER_ENABLED=1
#
# freeCorps.chatter.enabled - Feature flag of the resident lines and the free corp rumours. Default: false.
# EVEJS_LNE_FREE_CORPS_CHATTER_ENABLED=
# freeCorps.chatter.maxLinesPerSystemPerHour - Resident lines per system in a sliding hour (0 = silent). Range 0..60.
# Default: 4.
# EVEJS_LNE_FREE_CORPS_CHATTER_MAX_LINES_PER_SYSTEM_PER_HOUR=
# freeCorps.chatter.minResidents - Fewest shown residents for a system to get the lane. Range 1..500. Default: 1.
# EVEJS_LNE_FREE_CORPS_CHATTER_MIN_RESIDENTS=
# freeCorps.chatter.newsPollMs - Gap of the closed venture reads. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_FREE_CORPS_CHATTER_NEWS_POLL_MS=
# freeCorps.chatter.newsReadLimit - Rows per news page (at least maxCorpsPerPass + 1). Range 1..1024. Default: 64.
# EVEJS_LNE_FREE_CORPS_CHATTER_NEWS_READ_LIMIT=
# freeCorps.chatter.rumourMinYieldIsk - Yield of a FC_RICH rumour and a LAST_RICH line. Range 0..1000000000000.
# Default: 150000000.
# EVEJS_LNE_FREE_CORPS_CHATTER_RUMOUR_MIN_YIELD_ISK=
# freeCorps.chatter.rumourMinCrewLost - Ships lost of a FC_LOST rumour. Range 1..10. Default: 1.
# EVEJS_LNE_FREE_CORPS_CHATTER_RUMOUR_MIN_CREW_LOST=

# free corps wormhole explorers - the explorer
# archetype also gets EXPLORE_WH ventures: through a live wormhole pair of the graph overlay into J-space, work steps
# there, back by the same or another exit. A closed pair -> search for another exit (maxWhJumps), none -> STRANDED
# (longer steps, risk of loss, LOST after strandedMaxSteps). Migration 75 rebuilds world_free_corp_ventures (runs also
# with the flag off). Needs freeCorps.enabled and freeCorps.ventures.enabled (W16); without wormholes.enabled or
# modules.graph no new EXPLORE_WH and the open ones return after syncWaitMaxMs (W17).
# Internal: not in the launcher. Read at boot. Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_WORMHOLES_ENABLED=1
#
# freeCorps.wormholes.enabled - Feature flag of the EXPLORE_WH ventures. Default: false.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_ENABLED=
# freeCorps.wormholes.weight - Weight of EXPLORE_WH next to the explorer kinds (85/15; 0 = never). Range 0..1000.
# Default: 60.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_WEIGHT=
# freeCorps.wormholes.maxWhJumps - Wormhole jumps of the search for another exit. Range 1..8. Default: 3.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_MAX_WH_JUMPS=
# freeCorps.wormholes.maxExitCandidates - Exits checked exactly per search. Range 1..16. Default: 4.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_MAX_EXIT_CANDIDATES=
# freeCorps.wormholes.maxReturnJumps - Longest gate return from the exit to home. Range 1..64. Default: 20.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_MAX_RETURN_JUMPS=
# freeCorps.wormholes.maxExitSearchesPerPass - Exit searches per pass. Range 1..64. Default: 4.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_MAX_EXIT_SEARCHES_PER_PASS=
# freeCorps.wormholes.strandedStepMs - Step of a STRANDED crew. Range 60000..86400000. Default: 1800000.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_STRANDED_STEP_MS=
# freeCorps.wormholes.strandedMaxSteps - STRANDED steps before the whole crew is lost (0 = never). Range 0..48.
# Default: 6.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_STRANDED_MAX_STEPS=
# freeCorps.wormholes.strandedLossPermille - Loss chance of a STRANDED step. Range 0..1000. Default: 200.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_STRANDED_LOSS_PERMILLE=
# freeCorps.wormholes.yieldIskPerStepPerPilot - Yield of a work step in J-space. Range 0..1000000000.
# Default: 8000000.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_YIELD_ISK_PER_STEP_PER_PILOT=
# freeCorps.wormholes.syncWaitMs - Retry gap in WAIT and after a deferred exit search. Range 5000..3600000.
# Default: 60000.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_SYNC_WAIT_MS=
# freeCorps.wormholes.syncWaitMaxMs - Longer in WAIT = OFFLINE for the venture. Range 60000..86400000.
# Default: 1800000.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_SYNC_WAIT_MAX_MS=
# freeCorps.wormholes.indexRefreshMs - Most frequent rebuild of the wormhole index. Range 30000..86400000.
# Default: 600000.
# EVEJS_LNE_FREE_CORPS_WORMHOLES_INDEX_REFRESH_MS=

# free corps with a home in J-space (wormhole corps)
# the quota targetCorps founds explorer corporations with a staging station in k-space and a home in
# a J system behind a live k <-> J pair; they work WH_HOME ventures in J (blue loot and gas into the stock of the home,
# PI into the treasury). Migration 127 adds world_free_corp_wh_homes and rebuilds world_free_corp_ventures (runs also
# with the flag off). Needs freeCorps.enabled, freeCorps.ventures.enabled and freeCorps.wormholes.enabled (W280);
# targetCorps 0 founds none (W281).
# Internal: not in the launcher. Read at boot. Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_WH_CORPS_ENABLED=1
#
# freeCorps.whCorps.enabled - Feature flag of the wormhole corporations. Default: false.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_ENABLED=
# freeCorps.whCorps.targetCorps - Quota of wormhole corporations above targetCorps. Range 0..64. Default: 4.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_TARGET_CORPS=
# freeCorps.whCorps.homePickTries - J candidates checked at a founding. Range 1..64. Default: 8.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HOME_PICK_TRIES=
# freeCorps.whCorps.sweepPerPass - Homes of closed corporations closed per pass. Range 1..64. Default: 8.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_SWEEP_PER_PASS=
# freeCorps.whCorps.home.riskPermille - Multiplier of ventures.loss.nullsecPermille in J. Range 0..5000.
# Default: 800.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HOME_RISK_PERMILLE=
# freeCorps.whCorps.home.lootIskPerStepPerPilot - Blue loot of a WH_HOME step (stock). Range 0..1000000000.
# Default: 6000000.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HOME_LOOT_ISK_PER_STEP_PER_PILOT=
# freeCorps.whCorps.home.gasIskPerStepPerPilot - Gas of a WH_HOME step (stock). Range 0..1000000000.
# Default: 2000000.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HOME_GAS_ISK_PER_STEP_PER_PILOT=
# freeCorps.whCorps.home.piIskPerStepPerPilot - PI of a WH_HOME step (treasury). Range 0..1000000000.
# Default: 1000000.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HOME_PI_ISK_PER_STEP_PER_PILOT=
# freeCorps.whCorps.home.stockMaxIsk - Ceiling of loot + gas in the stock of a home. Range 0..1000000000000.
# Default: 2000000000.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HOME_STOCK_MAX_ISK=
#
# WH_HAUL: a home with stock >= haul.minIsk takes the
# whole stock out of J through the current exit to the nearest trade hub (or sells it in staging), sells it exactly
# once and returns. Needs freeCorps.whCorps.enabled (W282); haul.minIsk above home.stockMaxIsk = no haul (W284).
# freeCorps.whCorps.haul.enabled - Feature flag of WH_HAUL. Default: false.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_ENABLED=
# freeCorps.whCorps.haul.minIsk - Stock (loot + gas) from which a corporation hauls. Range 1..1000000000000.
# Default: 300000000.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_MIN_ISK=
# freeCorps.whCorps.haul.hubSystemIds - Trade hubs of the sale (1..16 distinct system ids, CSV).
# Default: 30000142,30002187,30002659,30002510,30002053.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_HUB_SYSTEM_IDS=
# freeCorps.whCorps.haul.maxHubJumps - Gate jumps exit -> hub; farther = sale in staging. Range 1..40. Default: 20.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_MAX_HUB_JUMPS=
# freeCorps.whCorps.haul.maxHubSearchesPerPass - Hub searches per pass. Range 1..64. Default: 4.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_MAX_HUB_SEARCHES_PER_PASS=
# freeCorps.whCorps.haul.lootSalePermille - Blue loot price in a hub. Range 0..2000. Default: 1000.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_LOOT_SALE_PERMILLE=
# freeCorps.whCorps.haul.gasSalePermille - Gas price in a hub. Range 0..2000. Default: 900.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_GAS_SALE_PERMILLE=
# freeCorps.whCorps.haul.stagingSalePermille - Price of the whole cargo in staging. Range 0..2000. Default: 850.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_STAGING_SALE_PERMILLE=
# freeCorps.whCorps.haul.riskPermille - Multiplier of ventures.loss.<band>Permille on a lowsec / nullsec gate step.
# Range 0..5000. Default: 300.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_RISK_PERMILLE=
# freeCorps.whCorps.haul.outsideMaxSteps - STRANDED steps outside J before WH_LONG_WAY. Range 1..96. Default: 12.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_HAUL_OUTSIDE_MAX_STEPS=
#
# WH_RAID: a home goes out of J through the current
# exit and raids k-space systems <= raid.maxJumps gate jumps from the exit (a system with a player weighs more, no loss
# there); the yield goes to the treasury once at DONE. Needs freeCorps.whCorps.enabled, names in Local need
# freeCorps.local.enabled (W283).
# freeCorps.whCorps.raid.enabled - Feature flag of WH_RAID. Default: false.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_ENABLED=
# freeCorps.whCorps.raid.planPermille - Chance of a raid instead of WH_HOME (full stock = always). Range 0..1000.
# Default: 300.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_PLAN_PERMILLE=
# freeCorps.whCorps.raid.maxPlansPerPass - New exit searches of raid plans per pass. Range 1..64. Default: 1.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_MAX_PLANS_PER_PASS=
# freeCorps.whCorps.raid.maxJumps - Radius of the raid area (gate jumps from the exit). Range 1..6. Default: 3.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_MAX_JUMPS=
# freeCorps.whCorps.raid.maxBfsSystems - Ceiling of the systems of the area BFS. Range 1..500. Default: 60.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_MAX_BFS_SYSTEMS=
# freeCorps.whCorps.raid.maxAreaBuildsPerPass - Area builds (BFS) per pass. Range 1..64. Default: 8.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_MAX_AREA_BUILDS_PER_PASS=
# freeCorps.whCorps.raid.areaMemoMax - Areas kept in memory (one per exit). Range 1..4096. Default: 128.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_AREA_MEMO_MAX=
# freeCorps.whCorps.raid.bands - Security bands of the area systems (1..3 of highsec,lowsec,nullsec, CSV).
# Default: lowsec,nullsec.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_BANDS=
# freeCorps.whCorps.raid.observedWeight - Draw weight of a system with a player (others 1). Range 1..100. Default: 5.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_OBSERVED_WEIGHT=
# freeCorps.whCorps.raid.riskPermille - Multiplier of ventures.loss.<band>Permille on a raid step. Range 0..5000.
# Default: 1200.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_RISK_PERMILLE=
# freeCorps.whCorps.raid.yieldIskPerStepPerPilot - Yield of a raid work step per pilot. Range 0..1000000000.
# Default: 6000000.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_YIELD_ISK_PER_STEP_PER_PILOT=
# freeCorps.whCorps.raid.outsideMaxSteps - STRANDED steps outside J before WH_LONG_WAY. Range 1..96. Default: 12.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_RAID_OUTSIDE_MAX_STEPS=
#
# Gas contracts: in the sale step of a WH_HAUL at a hub
# a part of the cargo gas becomes one WTS contract of the corporation at the hub station (the contract pump)
# that part is not bought at the hub. Needs freeCorps.contracts.enabled and freeCorps.whCorps.haul.enabled (W285).
# freeCorps.whCorps.contracts.enabled - Feature flag of the gas contracts. Default: false.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_CONTRACTS_ENABLED=
# freeCorps.whCorps.contracts.gasSharePermille - Part of the cargo gas on the contract (then capped at
# freeCorps.contracts.lotMaxIsk). Range 1..1000. Default: 300.
# EVEJS_LNE_FREE_CORPS_WH_CORPS_CONTRACTS_GAS_SHARE_PERMILLE=

# free corps hunters and wars - the hunter
# archetype gets HUNT ventures (roam in lowsec / nullsec, attack the ventures of other corporations); wars between
# two free corporations of the same region (declaration, mercenary hunter ally, end by time, surrender or a closed
# side), the sides of an ACTIVE war raid each other. A skirmish is a pure function settled once (key
# fcs:<ventureId>:<step>); in a system observed by a player both ventures wait HELD. Migration 76 adds
# world_free_corp_wars and world_free_corp_skirmishes (runs also with the flags off). Needs freeCorps.enabled and
# freeCorps.ventures.enabled (W18).
# Internal: not in the launcher. Read at boot. Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_HUNTING_ENABLED=1
# EVEJS_LNE_FREE_CORPS_WARS_ENABLED=1
#
# freeCorps.hunting.enabled - Feature flag of the hunters (archetype, quota, random targets). Default: false.
# EVEJS_LNE_FREE_CORPS_HUNTING_ENABLED=
# freeCorps.hunting.targetHunters - Quota of hunter corporations above targetCorps. Range 0..64. Default: 8.
# EVEJS_LNE_FREE_CORPS_HUNTING_TARGET_HUNTERS=
# freeCorps.hunting.huntMaxJumps - Area of the random targets (<= ventures.maxJumps). Range 1..15. Default: 4.
# EVEJS_LNE_FREE_CORPS_HUNTING_HUNT_MAX_JUMPS=
# freeCorps.hunting.engageChancePermille - Attack roll on the picked prey. Range 0..1000. Default: 300.
# EVEJS_LNE_FREE_CORPS_HUNTING_ENGAGE_CHANCE_PERMILLE=
# freeCorps.hunting.yieldIskPerStepPerPilot - Yield of a HUNT step without a fight. Range 0..1000000000.
# Default: 1500000.
# EVEJS_LNE_FREE_CORPS_HUNTING_YIELD_ISK_PER_STEP_PER_PILOT=
# freeCorps.hunting.lootPermille - Loot = part of the ISK lost by the defender. Range 0..1000. Default: 300.
# EVEJS_LNE_FREE_CORPS_HUNTING_LOOT_PERMILLE=
# freeCorps.hunting.maxPreyRows - Rows of the prey index of a pass. Range 16..4096. Default: 512.
# EVEJS_LNE_FREE_CORPS_HUNTING_MAX_PREY_ROWS=
# freeCorps.hunting.maxSkirmishesPerPass - Skirmishes + holds per pass. Range 1..32. Default: 4.
# EVEJS_LNE_FREE_CORPS_HUNTING_MAX_SKIRMISHES_PER_PASS=
# freeCorps.wars.enabled - Feature flag of the wars between free corporations. Default: false.
# EVEJS_LNE_FREE_CORPS_WARS_ENABLED=
# freeCorps.wars.maxOpenWars - Open wars at a time (0 = no declaration). Range 0..200. Default: 20.
# EVEJS_LNE_FREE_CORPS_WARS_MAX_OPEN_WARS=
# freeCorps.wars.warDurationMs - Time of an ACTIVE war. Range 3600000..2592000000. Default: 259200000.
# EVEJS_LNE_FREE_CORPS_WARS_WAR_DURATION_MS=
# freeCorps.wars.declareDelayMs - DECLARED -> ACTIVE. Range 0..86400000. Default: 3600000.
# EVEJS_LNE_FREE_CORPS_WARS_DECLARE_DELAY_MS=
# freeCorps.wars.declareMinIsk - Treasury of a declaring corporation. Range 0..1000000000000. Default: 1000000000.
# EVEJS_LNE_FREE_CORPS_WARS_DECLARE_MIN_ISK=
# freeCorps.wars.declareCostIsk - Fee of a declaration. Range 0..1000000000000. Default: 100000000.
# EVEJS_LNE_FREE_CORPS_WARS_DECLARE_COST_ISK=
# freeCorps.wars.declareChancePermille - Declaration roll per review. Range 0..1000. Default: 100.
# EVEJS_LNE_FREE_CORPS_WARS_DECLARE_CHANCE_PERMILLE=
# freeCorps.wars.maxDeclarationsPerPass - Declarations per pass. Range 0..8. Default: 1.
# EVEJS_LNE_FREE_CORPS_WARS_MAX_DECLARATIONS_PER_PASS=
# freeCorps.wars.redeclareCooldownMs - Pause of the same pair after a war. Range 0..2592000000.
# Default: 259200000.
# EVEJS_LNE_FREE_CORPS_WARS_REDECLARE_COOLDOWN_MS=
# freeCorps.wars.reviewMs - Review rhythm of a war. Range 60000..86400000. Default: 600000.
# EVEJS_LNE_FREE_CORPS_WARS_REVIEW_MS=
# freeCorps.wars.maxWarReviewsPerPass - War reviews per pass. Range 1..32. Default: 2.
# EVEJS_LNE_FREE_CORPS_WARS_MAX_WAR_REVIEWS_PER_PASS=
# freeCorps.wars.surrenderIskPermille - Part of the treasury paid on a surrender. Range 0..1000. Default: 100.
# EVEJS_LNE_FREE_CORPS_WARS_SURRENDER_ISK_PERMILLE=
# freeCorps.wars.surrenderMinKills - Kills of the enemy before a surrender by losses. Range 1..100. Default: 3.
# EVEJS_LNE_FREE_CORPS_WARS_SURRENDER_MIN_KILLS=
# freeCorps.wars.surrenderLossRatioPermille - Loss ratio of a surrender by losses. Range 1000..10000.
# Default: 2000.
# EVEJS_LNE_FREE_CORPS_WARS_SURRENDER_LOSS_RATIO_PERMILLE=
# freeCorps.wars.raidWeight - Weight of HUNT appended to a side of an ACTIVE war (0 = no raids). Range 0..1000.
# Default: 40.
# EVEJS_LNE_FREE_CORPS_WARS_RAID_WEIGHT=
# freeCorps.wars.allyFeeIsk - Fee of a mercenary hunter ally (0 = no allies). Range 0..1000000000000.
# Default: 200000000.
# EVEJS_LNE_FREE_CORPS_WARS_ALLY_FEE_ISK=
# freeCorps.wars.maxCandidateScan - Rows of the candidate scan of a declaration. Range 16..4096. Default: 512.
# EVEJS_LNE_FREE_CORPS_WARS_MAX_CANDIDATE_SCAN=

# free corps virtual killmails - the loss of a
# FIGHT skirmish becomes one EveJS killmail (victim and attackers = the virtual characters of both corporations),
# written only after the commit through the outbox world_free_corp_outbox (migration 77, runs also with the flag off)
# by an own pump: at most maxPerHour vendor calls an hour (gap from the last attempt, survives a restart), retries
# with backoff, FAILED after maxAttempts; a restart replays the same eventID lne:fc:km:<skirmishId> (the vendor
# returns the existing killmail). The final blow carries no character (no DBS / FW / career effect). Needs
# freeCorps.enabled, freeCorps.ventures.enabled and freeCorps.hunting.enabled or freeCorps.wars.enabled (W23).
# Internal: not in the launcher. Read at boot. Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_KILLMAILS_ENABLED=1
#
# freeCorps.killmails.enabled - Feature flag of the virtual killmails (off = no outbox row, no pump). Default: false.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_ENABLED=
# freeCorps.killmails.maxPerHour - Vendor calls per hour. Range 1..12. Default: 6.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_MAX_PER_HOUR=
# freeCorps.killmails.pumpMs - Rhythm of the killmail pump. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_PUMP_MS=
# freeCorps.killmails.maxAttempts - Vendor calls before FAILED. Range 1..20. Default: 5.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_MAX_ATTEMPTS=
# freeCorps.killmails.backoffBaseMs - First retry gap (doubles per attempt). Range 60000..86400000. Default: 600000.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_BACKOFF_BASE_MS=
# freeCorps.killmails.backoffMaxMs - Cap of the retry gap. Range 60000..604800000. Default: 21600000.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_BACKOFF_MAX_MS=
# freeCorps.killmails.maxPending - PENDING killmails at most (more = dropped). Range 1..256. Default: 12.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_MAX_PENDING=
# freeCorps.killmails.maxAgeMs - Older PENDING -> FAILED EXPIRED. Range 3600000..604800000. Default: 21600000.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_MAX_AGE_MS=
# freeCorps.killmails.maxAttackers - Attackers on a killmail. Range 1..10. Default: 5.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_MAX_ATTACKERS=
# freeCorps.killmails.slowCallMs - A slower vendor call pauses the pump. Range 10..60000. Default: 500.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_SLOW_CALL_MS=
# freeCorps.killmails.slowPauseMs - Pause after a slow call (memory only). Range 60000..604800000.
# Default: 21600000.
# EVEJS_LNE_FREE_CORPS_KILLMAILS_SLOW_PAUSE_MS=

# free corps WTS contracts - after a DONE MINE
# BUILD venture a tier 2 corporation may put up one public item exchange (ore, minerals, a packaged T1 frigate /
# destroyer) in its home station, issued by its CEO (a virtual character). Planned in the pass, written to
# world_free_corp_contracts + the outbox (migration 78, runs also with the flag off); an own pump grants the goods,
# creates the contract, polls it, deletes it after contractTtlMs and voids the returned goods. The price of a contract
# a player buys goes once into the treasury of the corporation. Flag off with open rows = the cleanup pump closes them.
# Needs freeCorps.enabled and freeCorps.ventures.enabled (W25). Internal: not in the launcher. Read at boot.
# Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_CONTRACTS_ENABLED=1
#
# freeCorps.contracts.enabled - Feature flag of the WTS contracts (off = no new row). Default: false.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_ENABLED=
# freeCorps.contracts.maxOpen - Open contracts at most (globally). Range 1..120. Default: 40.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_MAX_OPEN=
# freeCorps.contracts.maxPerCorp - Open contracts per corporation. Range 1..8. Default: 2.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_MAX_PER_CORP=
# freeCorps.contracts.lotMaxIsk - Ceiling of a lot (reference value). Range 100000..1000000000. Default: 10000000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_LOT_MAX_ISK=
# freeCorps.contracts.lotMinIsk - A smaller lot = no contract (W26). Range 0..1000000000. Default: 500000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_LOT_MIN_ISK=
# freeCorps.contracts.lotSharePermille - Share of the venture payout put up for sale. Range 1..1000. Default: 250.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_LOT_SHARE_PERMILLE=
# freeCorps.contracts.issueChancePermille - Chance of a contract after a DONE venture. Range 0..1000. Default: 500.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_ISSUE_CHANCE_PERMILLE=
# freeCorps.contracts.mineralSharePermille - MINE: minerals instead of ore. Range 0..1000. Default: 300.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_MINERAL_SHARE_PERMILLE=
# freeCorps.contracts.priceFactorPermille - Price = reference x factor / 1000. Range 500..2000. Default: 950.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_PRICE_FACTOR_PERMILLE=
# freeCorps.contracts.maxPlansPerPass - Contract plans per pass. Range 0..8. Default: 2.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_MAX_PLANS_PER_PASS=
# freeCorps.contracts.contractTtlMs - Life of a contract. Range 3600000..2592000000. Default: 259200000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_CONTRACT_TTL_MS=
# freeCorps.contracts.pumpMs - Rhythm of the contract pump. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_PUMP_MS=
# freeCorps.contracts.issueSpacingMs - Minimum gap between two issues. Range 0..86400000. Default: 120000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_ISSUE_SPACING_MS=
# freeCorps.contracts.pollMs - Gap between two reads of one contract. Range 30000..86400000. Default: 600000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_POLL_MS=
# freeCorps.contracts.maxPollsPerRun - Contract reads per run. Range 1..40. Default: 8.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_MAX_POLLS_PER_RUN=
# freeCorps.contracts.maxReturnStacks - Stacks in a return plan. Range 1..16. Default: 8.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_MAX_RETURN_STACKS=
# freeCorps.contracts.maxAttempts - Issue attempts before the abort. Range 1..20. Default: 5.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_MAX_ATTEMPTS=
# freeCorps.contracts.backoffBaseMs - First retry gap (doubles per attempt). Range 60000..86400000. Default: 300000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_BACKOFF_BASE_MS=
# freeCorps.contracts.backoffMaxMs - Cap of the retry gap (W27). Range 60000..604800000. Default: 21600000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_BACKOFF_MAX_MS=
# freeCorps.contracts.maxIssueAgeMs - A never attempted PLANNED contract older than this -> CANCELLED.
# Range 3600000..604800000. Default: 21600000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_MAX_ISSUE_AGE_MS=
#
# free corps courier contracts - after a
# DONE HAUL venture the CEO of a hauler corporation may put up one public courier contract: ore / mineral from the home
# station to the NPC station of the venture, the reward paid from the treasury of the corporation (funded into the
# CEO wallet first), the collateral >= the value of the goods. Delivered goods are voided at the destination; an
# accepted courier not delivered by its deadline is failed by the issuer (the collateral goes into the treasury).
# Same table / pump as the WTS contracts (migration 82, runs also with the flag off). Needs
# freeCorps.contracts.enabled (W47). Internal: not in the launcher. Read at boot.
# Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_ENABLED=1
#
# freeCorps.contracts.courier.enabled - Feature flag of the courier contracts (off = no new row). Default: false.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_ENABLED=
# freeCorps.contracts.courier.maxOpen - Open courier contracts at most (W48). Range 1..40. Default: 10.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_MAX_OPEN=
# freeCorps.contracts.courier.issueChancePermille - Chance of a courier after a DONE HAUL venture. Range 0..1000.
# Default: 500.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_ISSUE_CHANCE_PERMILLE=
# freeCorps.contracts.courier.rewardBaseIsk - Base reward of a courier (W49). Range 0..100000000. Default: 300000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_REWARD_BASE_ISK=
# freeCorps.contracts.courier.rewardPerJumpIsk - Reward per jump of the venture (W49). Range 0..100000000.
# Default: 150000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_REWARD_PER_JUMP_ISK=
# freeCorps.contracts.courier.rewardMaxIsk - Ceiling of a courier reward. Range 100000..100000000. Default: 3000000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_REWARD_MAX_ISK=
# freeCorps.contracts.courier.collateralPermille - Collateral = value x permille / 1000. Range 1000..2000.
# Default: 1000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_COLLATERAL_PERMILLE=
# freeCorps.contracts.courier.days - Vendor numDays of a courier. Range 1..14. Default: 3.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_DAYS=
# freeCorps.contracts.courier.failGraceMs - Wait after the deadline before the issuer fails it. Range 0..86400000.
# Default: 600000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_FAIL_GRACE_MS=
# freeCorps.contracts.courier.maxVolumeM3 - Ceiling of the courier volume (m3). Range 1000..1200000. Default: 60000.
# EVEJS_LNE_FREE_CORPS_CONTRACTS_COURIER_MAX_VOLUME_M3=

# free corps mergers and recycling - a STRUGGLING
# corporation merges into a richer one of the same archetype and region (MERGED) or dissolves (DISSOLVED, behind
# freeCorps.lifecycle.dissolveEnabled); its characters (not the CEO) go to the partner or to a pool of free characters
# (world_free_corp_members, migration 79, runs also with the flag off). A founding and a growth take characters of the
# pool first and create new ones only after that. Every move is one vendor call (setCharacterAffiliation: the
# employment history in Show Info) made by an own pump after the commit through the outbox (lne:fc:join:<char>:<n>);
# the vendor corporation of a closed one stays with the description "Disbanded <date>" / "Merged into <name> <date>".
# Flag off with pending moves = the drain pump delivers them. Needs freeCorps.enabled and freeCorps.ventures.enabled
# (W29). Internal: not in the launcher. Read at boot. Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_RECYCLE_ENABLED=1
#
# freeCorps.recycle.enabled - Feature flag of the mergers and the recycling (off = no move, no row). Default: false.
# EVEJS_LNE_FREE_CORPS_RECYCLE_ENABLED=
# freeCorps.recycle.maxRecruitsPerFounding - Recruits of the pool at a founding. Range 0..9. Default: 7.
# EVEJS_LNE_FREE_CORPS_RECYCLE_MAX_RECRUITS_PER_FOUNDING=
# freeCorps.recycle.mergeAfterStruggles - Reviews with a shortfall before a merger (W31). Range 1..200. Default: 9.
# EVEJS_LNE_FREE_CORPS_RECYCLE_MERGE_AFTER_STRUGGLES=
# freeCorps.recycle.mergeMinPartnerIsk - Minimum treasury of the merge partner. Range 0..1000000000000.
# Default: 500000000.
# EVEJS_LNE_FREE_CORPS_RECYCLE_MERGE_MIN_PARTNER_ISK=
# freeCorps.recycle.mergeScanLimit - Candidate rows of a merger. Range 16..4096. Default: 256.
# EVEJS_LNE_FREE_CORPS_RECYCLE_MERGE_SCAN_LIMIT=
# freeCorps.recycle.maxMergesPerPass - Mergers per pass. Range 0..8. Default: 1.
# EVEJS_LNE_FREE_CORPS_RECYCLE_MAX_MERGES_PER_PASS=
# freeCorps.recycle.pumpMs - Rhythm of the recycling pump. Range 1000..600000. Default: 10000.
# EVEJS_LNE_FREE_CORPS_RECYCLE_PUMP_MS=
# freeCorps.recycle.joinSpacingMs - Minimum gap between two vendor calls. Range 1000..3600000. Default: 30000.
# EVEJS_LNE_FREE_CORPS_RECYCLE_JOIN_SPACING_MS=
# freeCorps.recycle.targetWaitMs - Wait for the vendor corporation of a founding target. Range 5000..3600000.
# Default: 60000.
# EVEJS_LNE_FREE_CORPS_RECYCLE_TARGET_WAIT_MS=
# freeCorps.recycle.maxAttempts - Vendor calls before FAILED. Range 1..20. Default: 5.
# EVEJS_LNE_FREE_CORPS_RECYCLE_MAX_ATTEMPTS=
# freeCorps.recycle.backoffBaseMs - First retry gap (doubles per attempt). Range 10000..86400000. Default: 60000.
# EVEJS_LNE_FREE_CORPS_RECYCLE_BACKOFF_BASE_MS=
# freeCorps.recycle.backoffMaxMs - Cap of the retry gap (W32). Range 60000..604800000. Default: 3600000.
# EVEJS_LNE_FREE_CORPS_RECYCLE_BACKOFF_MAX_MS=
# freeCorps.recycle.slowCallMs - A slower vendor call pauses the pump. Range 10..60000. Default: 250.
# EVEJS_LNE_FREE_CORPS_RECYCLE_SLOW_CALL_MS=
# freeCorps.recycle.slowPauseMs - Pause after a slow call (memory only). Range 60000..86400000. Default: 600000.
# EVEJS_LNE_FREE_CORPS_RECYCLE_SLOW_PAUSE_MS=
# freeCorps.recycle.cleanSourceRoster - Delete the entry of the source roster after a move. Default: true.
# EVEJS_LNE_FREE_CORPS_RECYCLE_CLEAN_SOURCE_ROSTER=
# free corps CEO reuse - only with the recycling on. A bounded
# scan puts the CEO of a closed corporation (DISSOLVED / MERGED, 0 open contracts) into the pool; a founding takes the
# oldest character of the pool as its CEO (no new character, the identity row moves to the new owner).
# freeCorps.recycle.ceoReuse - CEOs of closed corporations into the pool + CEO of a founding from the pool (W37). Default: false.
# EVEJS_LNE_FREE_CORPS_RECYCLE_CEO_REUSE=
# freeCorps.recycle.maxCeoReleasesPerPass - CEO releases per pass; 0 = none (W38). Range 0..32. Default: 4.
# EVEJS_LNE_FREE_CORPS_RECYCLE_MAX_CEO_RELEASES_PER_PASS=
# freeCorps.recycle.ceoReleaseScanRows - Backlog rows read per pass. Range 4..512. Default: 32.
# EVEJS_LNE_FREE_CORPS_RECYCLE_CEO_RELEASE_SCAN_ROWS=

# free corps Upwell structures - a rich ACTIVE
# corporation with a lowsec / nullsec home (treasury >= minCorpIsk) anchors one Astrahus owned by its EveJS corporation
# in its home system (no LNE sovereignty, no faction station there), at most 8 in the world. The cost leaves the
# treasury at the plan, an own pump creates the structure after the commit (outbox ANCHOR, lne:fc:st:<corp>:<n> = the
# devFlags tag), the vendor anchors it (~24 h), the pump brings it online. A structure destroyed by a player = a
# treasury penalty, STRUGGLING and a rebuild cooldown. Table world_free_corp_structures (migration 80, runs also with
# the flag off, KEEP at a world reset). Flag off = the vendor structures stay frozen; mode=cleanup removes all of them.
# Needs freeCorps.enabled, stations.enabled and modules.world (W33). Internal: not in the launcher. Read at boot.
# Start (copy to the root .env, uncomment):
# EVEJS_LNE_FREE_CORPS_STRUCTURES_ENABLED=1
#
# freeCorps.structures.enabled - Feature flag of the structures (off = no pump, no read, no seam call). Default: false.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_ENABLED=
# freeCorps.structures.mode - on = plan, anchor and watch; cleanup = remove every structure of a free corp (W36).
# Default: on.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_MODE=
# freeCorps.structures.anchorMode - native = the vendor anchoring (~24 h); instant = online at once. Default: native.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_ANCHOR_MODE=
# freeCorps.structures.typeId - EveJS type of the structure (Astrahus). Range 1..2147483647. Default: 35832.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_TYPE_ID=
# freeCorps.structures.maxTotal - Open structures in the whole world. Range 0..8. Default: 8.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_MAX_TOTAL=
# freeCorps.structures.maxPerCorp - Open structures per corporation. Range 1..2. Default: 1.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_MAX_PER_CORP=
# freeCorps.structures.maxPerSystem - Open structures in one system. Range 1..4. Default: 1.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_MAX_PER_SYSTEM=
# freeCorps.structures.minCorpIsk - Treasury from which a corporation anchors (W34). Range 0..1000000000000.
# Default: 5000000000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_MIN_CORP_ISK=
# freeCorps.structures.anchorCostIsk - Cost of a structure (refunded at FAILED). Range 0..1000000000000.
# Default: 1000000000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_ANCHOR_COST_ISK=
# freeCorps.structures.lossTreasuryPermille - Treasury penalty of a destroyed structure. Range 0..1000. Default: 250.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_LOSS_TREASURY_PERMILLE=
# freeCorps.structures.rebuildCooldownMs - Pause after a destroyed structure. Range 0..7776000000. Default: 604800000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_REBUILD_COOLDOWN_MS=
# freeCorps.structures.pumpMs - Rhythm of the structure pump. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_PUMP_MS=
# freeCorps.structures.planMs - Rhythm of the plan. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_PLAN_MS=
# freeCorps.structures.reconcileMs - Rhythm of the full reconcile. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_RECONCILE_MS=
# freeCorps.structures.maxAnchorsPerPlan - New rows per plan. Range 1..8. Default: 1.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_MAX_ANCHORS_PER_PLAN=
# freeCorps.structures.candidateRows - Candidate corporations read per plan. Range 8..1024. Default: 64.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_CANDIDATE_ROWS=
# freeCorps.structures.maxWritesPerPass - Vendor writes + placement checks per run. Range 1..32. Default: 4.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_MAX_WRITES_PER_PASS=
# freeCorps.structures.placementAttempts - Candidate positions per attempt. Range 1..64. Default: 8.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_PLACEMENT_ATTEMPTS=
# freeCorps.structures.placementChecksPerPass - validatePlacement calls per run. Range 1..64. Default: 4.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_PLACEMENT_CHECKS_PER_PASS=
# freeCorps.structures.placementClearanceM - Distance from the celestial. Range 1000000..50000000. Default: 2500000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_PLACEMENT_CLEARANCE_M=
# freeCorps.structures.anchorVulnerableMs - ANCHOR_VULNERABLE before the native anchoring. Range 60000..86400000.
# Default: 900000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_ANCHOR_VULNERABLE_MS=
# freeCorps.structures.anchorSpacingMs - Minimum gap between two creates. Range 10000..86400000. Default: 600000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_ANCHOR_SPACING_MS=
# freeCorps.structures.anchorMaxAttempts - Attempts before FAILED. Range 1..20. Default: 5.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_ANCHOR_MAX_ATTEMPTS=
# freeCorps.structures.anchorMaxAgeMs - A never attempted anchor older than this -> FAILED EXPIRED.
# Range 3600000..604800000. Default: 86400000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_ANCHOR_MAX_AGE_MS=
# freeCorps.structures.backoffBaseMs - First retry gap (W35). Range 60000..86400000. Default: 600000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_BACKOFF_BASE_MS=
# freeCorps.structures.backoffMaxMs - Cap of the retry gap (W35). Range 60000..604800000. Default: 21600000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_BACKOFF_MAX_MS=
# freeCorps.structures.targetStructureCorps - Structure corporations founded above targetCorps
# 0 = none; cut to maxTotal at runtime (W39-W41, W43). Range 0..8. Default: 0.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_TARGET_STRUCTURE_CORPS=
# freeCorps.structures.foundingIsk - Starting treasury of a quota corporation (W41). Range 0..1000000000000.
# Default: 6000000000.
# EVEJS_LNE_FREE_CORPS_STRUCTURES_FOUNDING_ISK=

# capsuleers.baseSecClasses - Security classes of a corporation base (comma list of lowsec, nullsec).
# Default: lowsec.
# EVEJS_LNE_CAPSULEERS_BASE_SEC_CLASSES=

# capsuleers.baseMaxJumpsToPirate - Jumps from pirate space to a corporation base.
# Range 1..10 (outside: clamped). Default: 5.
# EVEJS_LNE_CAPSULEERS_BASE_MAX_JUMPS_TO_PIRATE=

# capsuleers.baseScanMaxSystems - Systems visited by the base search around pirate space.
# Range 100..10000 (outside: clamped). Default: 2000.
# EVEJS_LNE_CAPSULEERS_BASE_SCAN_MAX_SYSTEMS=

# capsuleers.baseCandidatesTop - The seeded base choice is made among the nearest N candidates.
# Range 1..64 (outside: clamped). Default: 16.
# EVEJS_LNE_CAPSULEERS_BASE_CANDIDATES_TOP=

# capsuleers.pirateSystemsReadMax - Controlled systems read per pirate faction for the base search.
# Range 16..4096 (outside: clamped). Default: 512.
# EVEJS_LNE_CAPSULEERS_PIRATE_SYSTEMS_READ_MAX=

# capsuleers.initialIsk - ISK of a new corporation (mod wallet).
# Range 0..1000000000000 (outside: clamped). Default: 1000000000.
# EVEJS_LNE_CAPSULEERS_INITIAL_ISK=

# capsuleers.stipendIskPerReview - ISK added to an ACTIVE corporation every review.
# Range 0..10000000000 (outside: clamped). Default: 10000000.
# EVEJS_LNE_CAPSULEERS_STIPEND_ISK_PER_REVIEW=

# capsuleers.maxIskBalance - Ceiling of a corporation wallet.
# Range 1000000..10000000000000 (outside: clamped). Default: 50000000000.
# EVEJS_LNE_CAPSULEERS_MAX_ISK_BALANCE=

# ratting trips of the capsuleer fleets (out of the base to a quiet pirate system, NPC kills that lower the
# pirate influence through liberation.onNpcKill, a bounty to the corporation wallet, back home). Under
# capsuleers.enabled; all keys internal.
# capsuleers.rattingEnabled - New ratting trips (off = only trips home; open trips finish).
# Range: true/false. Default: true.
# EVEJS_LNE_CAPSULEERS_RATTING_ENABLED=

# capsuleers.maxDispatchesPerReview - Ratting trips dispatched by one review (home: maxHomeDispatchesPerReview since).
# Range 0..8 (outside: clamped). Default: 2.
# EVEJS_LNE_CAPSULEERS_MAX_DISPATCHES_PER_REVIEW=

# Own limit of the trips home (rotating) and the sweep of orphan fleets.
# capsuleers.maxHomeDispatchesPerReview - Trips home dispatched by one review (rotating over the fleets outside their base).
# Range 0..8 (outside: clamped). Default: 2.
# EVEJS_LNE_CAPSULEERS_MAX_HOME_DISPATCHES_PER_REVIEW=

# capsuleers.orphanSweepsPerReview - Capsuleer fleets under orders without a trip freed (IDLE, operation FAILED) by one review.
# Range 0..32 (outside: clamped). Default: 4.
# EVEJS_LNE_CAPSULEERS_ORPHAN_SWEEPS_PER_REVIEW=

# capsuleers.rattingMaxJumps - Jumps from the base to a ratting target.
# Range 1..10 (outside: clamped). Default: 5.
# EVEJS_LNE_CAPSULEERS_RATTING_MAX_JUMPS=

# capsuleers.rattingScanMaxSystems - Systems visited by the target search around a base.
# Range 50..5000 (outside: clamped). Default: 500.
# EVEJS_LNE_CAPSULEERS_RATTING_SCAN_MAX_SYSTEMS=

# capsuleers.rattingTargetScanMax - Nearest pirate systems checked for hostiles per base.
# Range 1..64 (outside: clamped). Default: 16.
# EVEJS_LNE_CAPSULEERS_RATTING_TARGET_SCAN_MAX=

# capsuleers.rattingTargetsTop - The seeded target choice is made among the best N quiet systems.
# Range 1..16 (outside: clamped). Default: 4.
# EVEJS_LNE_CAPSULEERS_RATTING_TARGETS_TOP=

# capsuleers.rattingMaxFleetsPerSystem - Open ratting trips per target system.
# Range 1..8 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_RATTING_MAX_FLEETS_PER_SYSTEM=

# capsuleers.rattingStepMs - Time between two ratting steps (ms).
# Range 60000..21600000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_CAPSULEERS_RATTING_STEP_MS=

# capsuleers.rattingShiftMs - Ratting time of one trip (ms; below rattingStepMs the service does not start).
# Range 60000..86400000 (outside: clamped). Default: 7200000.
# EVEJS_LNE_CAPSULEERS_RATTING_SHIFT_MS=

# capsuleers.rattingKillsPerStep - NPC kills of one ratting step (liberation.onNpcKill).
# Range 0..20 (outside: clamped). Default: 2.
# EVEJS_LNE_CAPSULEERS_RATTING_KILLS_PER_STEP=

# capsuleers.rattingBountyIskPerKill - ISK paid to the corporation wallet per kill.
# Range 0..1000000000 (outside: clamped). Default: 10000000.
# EVEJS_LNE_CAPSULEERS_RATTING_BOUNTY_ISK_PER_KILL=

# capsuleers.hostileScanMaxFleets - Fleets read per system by the hostile scan (more = hostile).
# Range 4..256 (outside: clamped). Default: 32.
# EVEJS_LNE_CAPSULEERS_HOSTILE_SCAN_MAX_FLEETS=

# capsuleers.tripWatchGraceMs - Grace after the planned arrival before a trip deadline (ms).
# Range 0..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_CAPSULEERS_TRIP_WATCH_GRACE_MS=

# capsuleers.tripWatchRecheckMs - Recheck of a waiting trip (ms).
# Range 60000..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_CAPSULEERS_TRIP_WATCH_RECHECK_MS=

# capsuleers.tripMaxWatchRounds - Waits of one trip phase before it ends with TIMEOUT.
# Range 1..1000 (outside: clamped). Default: 12.
# EVEJS_LNE_CAPSULEERS_TRIP_MAX_WATCH_ROUNDS=

# capsuleers.tripRetentionMs - Ended trips kept for the panel (ms).
# Range 3600000..7776000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_CAPSULEERS_TRIP_RETENTION_MS=

# capsuleers.tripPruneBatch - Ended trips deleted per review (0 = no retention).
# Range 0..1000 (outside: clamped). Default: 32.
# EVEJS_LNE_CAPSULEERS_TRIP_PRUNE_BATCH=

# capsuleers.tripReconcileMaxTrips - Open trips checked at the start for a lost step event.
# Range 1..4096 (outside: clamped). Default: 128.
# EVEJS_LNE_CAPSULEERS_TRIP_RECONCILE_MAX_TRIPS=

# capsuleers.tripReconcileMaxAttempts - Reconcile events of one trip phase before it is left alone.
# Range 1..20 (outside: clamped). Default: 3.
# EVEJS_LNE_CAPSULEERS_TRIP_RECONCILE_MAX_ATTEMPTS=

# Mercenary fleets of the capsuleer corporations and the contracts of the empires against pirate fleets in
# empire lowsec (fee from the treasury of the empire into an escrow, payout on station / refund when cancelled).
# Under capsuleers.enabled; no hire and no mercenary buy without treasury.enabled. All keys internal.
# capsuleers.mercenaryEnabled - New mercenary contracts and mercenary fleet buys (off = none; open contracts finish).
# Range: true/false. Default: true.
# EVEJS_LNE_CAPSULEERS_MERCENARY_ENABLED=

# capsuleers.maxMercenaryFleetsPerCorp - Live mercenary fleets of one capsuleer corporation (reserved inside maxFleetsPerCorp).
# Range 0..4 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_MAX_MERCENARY_FLEETS_PER_CORP=

# capsuleers.maxContractsPerCorp - Open mercenary contracts of one capsuleer corporation.
# Range 0..4 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_MAX_CONTRACTS_PER_CORP=

# capsuleers.maxContractsPerEmpire - Open mercenary contracts of one employer empire.
# Range 0..16 (outside: clamped). Default: 2.
# EVEJS_LNE_CAPSULEERS_MAX_CONTRACTS_PER_EMPIRE=

# capsuleers.maxContractsPerReview - Mercenary contracts signed by one review.
# Range 0..4 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_MAX_CONTRACTS_PER_REVIEW=

# capsuleers.mercMaxContractsPerSystem - Open mercenary contracts per target system.
# Range 1..4 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_MERC_MAX_CONTRACTS_PER_SYSTEM=

# capsuleers.mercMaxJumps - Jumps from the base to a contract target.
# Range 1..10 (outside: clamped). Default: 6.
# EVEJS_LNE_CAPSULEERS_MERC_MAX_JUMPS=

# capsuleers.mercScanMaxSystems - Systems visited by the contract target search around a base.
# Range 50..5000 (outside: clamped). Default: 500.
# EVEJS_LNE_CAPSULEERS_MERC_SCAN_MAX_SYSTEMS=

# capsuleers.mercTargetScanMax - Nearest systems with a pirate fleet checked per base.
# Range 1..64 (outside: clamped). Default: 32.
# EVEJS_LNE_CAPSULEERS_MERC_TARGET_SCAN_MAX=

# capsuleers.mercTargetsTop - The seeded contract target choice is made among the best N candidates.
# Range 1..16 (outside: clamped). Default: 4.
# EVEJS_LNE_CAPSULEERS_MERC_TARGETS_TOP=

# capsuleers.mercEnemyFleetsReadMax - Fleets of one pirate faction read per review for the contract targets.
# Range 16..4096 (outside: clamped). Default: 256.
# EVEJS_LNE_CAPSULEERS_MERC_ENEMY_FLEETS_READ_MAX=

# capsuleers.mercTargetSecClasses - Security classes of a contract target (comma list of lowsec, nullsec).
# Default: lowsec.
# EVEJS_LNE_CAPSULEERS_MERC_TARGET_SEC_CLASSES=

# capsuleers.mercGuardMs - Time a mercenary fleet holds its contract target (ms; below mercStepMs the service does not start).
# Range 60000..86400000 (outside: clamped). Default: 14400000.
# EVEJS_LNE_CAPSULEERS_MERC_GUARD_MS=

# capsuleers.mercStepMs - Time between two steps of a mercenary fleet on station (ms).
# Range 60000..21600000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_CAPSULEERS_MERC_STEP_MS=

# capsuleers.mercFeeFactorPermille - Contract fee = the hull fees of the fleet x this / 1000.
# Range 1..100000 (outside: clamped). Default: 1000.
# EVEJS_LNE_CAPSULEERS_MERC_FEE_FACTOR_PERMILLE=

# capsuleers.mercMinTreasuryMultiple - An empire hires only with a treasury balance of at least fee x this.
# Range 1..1000 (outside: clamped). Default: 10.
# EVEJS_LNE_CAPSULEERS_MERC_MIN_TREASURY_MULTIPLE=

# Salvage trips of the capsuleer ratter fleets to wreck fields the faction salvage leaves (no winner, won by
# the capsuleers, terminal job); the haul is paid in ISK to the corporation wallet at docking. Under
# capsuleers.enabled; no capsuleer salvage without wrecks.enabled. All keys internal.
# capsuleers.salvageEnabled - New capsuleer salvage trips to wreck fields (off = none; open trips finish).
# Range: true/false. Default: false.
# EVEJS_LNE_CAPSULEERS_SALVAGE_ENABLED=

# capsuleers.maxSalvageDispatchesPerReview - Salvage trips dispatched by one review (apart from maxDispatchesPerReview).
# Range 0..8 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_MAX_SALVAGE_DISPATCHES_PER_REVIEW=

# capsuleers.salvageMaxJumps - Jumps from the base to a wreck field.
# Range 1..10 (outside: clamped). Default: 4.
# EVEJS_LNE_CAPSULEERS_SALVAGE_MAX_JUMPS=

# capsuleers.salvageScanMaxSystems - Systems visited by the wreck field search around a base.
# Range 10..5000 (outside: clamped). Default: 200.
# EVEJS_LNE_CAPSULEERS_SALVAGE_SCAN_MAX_SYSTEMS=

# capsuleers.salvageFieldsPerSystem - Wreck fields read per system by the search.
# Range 1..16 (outside: clamped). Default: 3.
# EVEJS_LNE_CAPSULEERS_SALVAGE_FIELDS_PER_SYSTEM=

# capsuleers.salvageIskPerUnit - ISK per salvaged unit paid to the corporation wallet at docking.
# Range 0..1000000000 (outside: clamped). Default: 2000000.
# EVEJS_LNE_CAPSULEERS_SALVAGE_ISK_PER_UNIT=

# Claims of the capsuleer corporations on free nullsec systems (a record of the mod: no controller,
# influence or occupation change); a held claim is ratting space (bounty without liberation). Under
# capsuleers.enabled. All keys internal.
# capsuleers.claimsEnabled - New claims, the loss check and the ratting in claims (off = the claim records are frozen).
# Range: true/false. Default: false.
# EVEJS_LNE_CAPSULEERS_CLAIMS_ENABLED=

# capsuleers.maxClaimsPerCorp - Claims held by one corporation.
# Range 0..8 (outside: clamped). Default: 2.
# EVEJS_LNE_CAPSULEERS_MAX_CLAIMS_PER_CORP=

# capsuleers.maxClaimsPerReview - New claims of one review (all corporations).
# Range 0..4 (outside: clamped). Default: 1.
# EVEJS_LNE_CAPSULEERS_MAX_CLAIMS_PER_REVIEW=

# capsuleers.claimMaxJumps - Jumps from the base to a claim and from a claim to the fleet that holds it.
# Range 1..10 (outside: clamped). Default: 3.
# EVEJS_LNE_CAPSULEERS_CLAIM_MAX_JUMPS=

# capsuleers.claimScanMaxSystems - Systems visited by the claim searches (candidates and fleet range).
# Range 10..5000 (outside: clamped). Default: 200.
# EVEJS_LNE_CAPSULEERS_CLAIM_SCAN_MAX_SYSTEMS=

# capsuleers.claimBountyPermille - Bounty of a kill in a claim = rattingBountyIskPerKill x this / 1000.
# Range 0..1000 (outside: clamped). Default: 500.
# EVEJS_LNE_CAPSULEERS_CLAIM_BOUNTY_PERMILLE=

# world.coreProtectionEnabled - Master switch for faction core protection (system + base station immune to capture); off = cores can be captured.
# Range: true/false. Default: true.
# EVEJS_LNE_WORLD_CORE_PROTECTION_ENABLED=

# world.coreMaxSystemsPerFaction - Max core systems per faction in data validation (1 system default, data allows up to 3).
# Range 1..8 (outside: clamped). Default: 3.
# EVEJS_LNE_WORLD_CORE_MAX_SYSTEMS_PER_FACTION=

# world.npcSovBastionsEnabled - NPC sov systems (static EveJS factionID, nullsec) of neutral / unregistered factions are uncapturable bases of that faction and a reconcile restores them; off = capturable again, restored systems stay.
# Range: true/false. Default: true.
# EVEJS_LNE_WORLD_NPC_SOV_BASTIONS_ENABLED=

# world.npcSovBastionKinds - Registry kinds whose NPC sov becomes a bastion (pirate|empire|police|neutral|invader|hive|unregistered); an unknown token is a warning and is skipped.
# Default: neutral,unregistered.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_KINDS=

# world.npcSovBastionExcludeFactionIds - Faction IDs never made bastions (500018 = capsuleer umbrella; add 500015 to keep Great Wildlands with its holder).
# Empty or a comma list of at most 8 faction IDs. Default: 500018.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_EXCLUDE_FACTION_IDS=

# world.npcSovBastionSkipForeignHomeRegions - No bastion in a home region of another non-passive registry faction.
# Range: true/false. Default: true.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_SKIP_FOREIGN_HOME_REGIONS=

# world.npcSovBastionMaxSystems - More bastions than this = none at all and an issue at boot.
# Range 1..8192 (outside: clamped). Default: 1024.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_MAX_SYSTEMS=

# world.npcSovBastionReconcileIntervalMs - Period of the WORLD_BASTION_RECONCILE chain.
# Range 60000..604800000 (outside: clamped). Default: 21600000.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_RECONCILE_INTERVAL_MS=

# world.npcSovBastionReconcileDelayMs - First reconcile this long after start; also the defer when the graph is not ready.
# Range 0..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_RECONCILE_DELAY_MS=

# world.npcSovBastionReconcileMaxPerPass - Bastion systems per reconcile page.
# Range 1..256 (outside: clamped). Default: 32.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_RECONCILE_MAX_PER_PASS=

# world.npcSovBastionStationReturnEnabled - The bastion reconcile hands foreign NPC stations ONLINE of a bastion back to its owner (stock wiped).
# Range: true/false. Default: false.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_STATION_RETURN_ENABLED=

# world.npcSovBastionStationReturnMaxPerPass - Station returns per reconcile event.
# Range 1..4 (outside: clamped). Default: 1.
# EVEJS_LNE_WORLD_NPC_SOV_BASTION_STATION_RETURN_MAX_PER_PASS=

# strategy.coreRaidsAllowed - When true AI may raid foreign core (signal allowed), when false AI skips foreign core entirely; machines still protect.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_CORE_RAIDS_ALLOWED=

# strategy.maxCapturedSystemsPerFaction - Hard limit of captured systems per faction (0 = only home reclaim); in PARAM_KEYS.
# Range 0..4096 (outside: clamped). Default: 150.
# EVEJS_LNE_STRATEGY_MAX_CAPTURED_SYSTEMS_PER_FACTION=

# strategy.captureRequiresAdjacency - Capture target must neighbor own system / station / foothold / capturedIds / belt=1; in PARAM_KEYS.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_CAPTURE_REQUIRES_ADJACENCY=

# strategy.defenseEnabled - Enables defense LAUNCHes (params.defense); off = zero defense intents.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_DEFENSE_ENABLED=

# strategy.maxDefensePerReview - Max defense LAUNCHes per review; goes to params.defense.maxPerReview.
# Range 0..8 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_MAX_DEFENSE_PER_REVIEW=

# strategy.intruderDefenseEnabled - a hostile fleet standing in the home / an own station system (STABLE, own control) is a threat of planDefense (LAUNCH defense, own limit); off = snapshot and decisions as before.
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_INTRUDER_DEFENSE_ENABLED=

# strategy.intruderScanMaxSystems - systems scanned for intruders per review (home first, then own station systems by id).
# Range 0..64 (outside: clamped). Default: 8.
# EVEJS_LNE_STRATEGY_INTRUDER_SCAN_MAX_SYSTEMS=

# strategy.intruderMaxPerReview - intruder defense LAUNCHes per review (apart from strategy.maxDefensePerReview).
# Range 0..8 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_INTRUDER_MAX_PER_REVIEW=

# strategy.mergeEnabled - Internal: MERGE of idle fleets of one role standing in one system
# (the smaller one goes into the largest; frees strategy.maxFleetsPerFaction slots). On since bench IF2.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_MERGE_ENABLED=

# strategy.maxMergesPerReview - Internal: max MERGE intents per review (one absorbed fleet each, 0 = no MERGE).
# Range 0..16 (outside: clamped). Default: 2.
# EVEJS_LNE_STRATEGY_MAX_MERGES_PER_REVIEW=

# strategy.mergeRoles - Internal: fleet roles a MERGE joins. Comma list of invasion, garrison, scout, patrol
# wormhole, reserve or none; logistics, mining, hunter, capsuleer, mercenary refused (warning, default kept).
# Default: scout,garrison.
# EVEJS_LNE_STRATEGY_MERGE_ROLES=

# strategy.garrisonReleaseEnabled - Internal: GARRISON_RELEASE of garrisons on interior posts and of the
# surplus on border posts (role garrison -> invasion). Off: no release, interior posts count as weak again.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_GARRISON_RELEASE_ENABLED=

# strategy.maxGarrisonReleasesPerReview - Internal: max GARRISON_RELEASE intents per review (3 rows each, also
# bounded by strategy.maxFleetsPerFaction).
# Range 0..16 (outside: clamped). Default: 2.
# EVEJS_LNE_STRATEGY_MAX_GARRISON_RELEASES_PER_REVIEW=

# strategy.claimHoldEnabled - Internal: the last holder of an own claim stays in the system, no planner takes
# it (operations, relief, defense, patrols, merges, returns, the reactive sweep). Off: any IDLE fleet may leave and a
# sole holder drops INVASION back to CONTESTED.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_CLAIM_HOLD_ENABLED=

# strategy.claimHoldStates - Internal: occupation states of an own claim that keep a holder: none or a comma
# list of CONTESTED, INVASION, OCCUPIED, CONSOLIDATING. From OCCUPIED on the fleet is free by default (the capture
# draws a garrison, occupation.garrisonFleetsTarget). Default: CONTESTED,INVASION.
# The value CONTESTED,INVASION,OCCUPIED,CONSOLIDATING keeps
# the holder of a new capture until STABLE (claimHoldMaxMs 12 h > occupiedSettleMs 1 h + consolidateMs 4 h).
# EVEJS_LNE_STRATEGY_CLAIM_HOLD_STATES=CONTESTED,INVASION,OCCUPIED,CONSOLIDATING

# strategy.claimHoldRoles - Internal: fleet roles that may be kept as the holder (none = no hold).
# Default: invasion,patrol,garrison,scout,reserve.
# EVEJS_LNE_STRATEGY_CLAIM_HOLD_ROLES=

# strategy.claimHoldMaxMs - Internal: age of the occupation phase after which the holder is free again.
# Range 60000..604800000 (outside: clamped). Default: 43200000.
# EVEJS_LNE_STRATEGY_CLAIM_HOLD_MAX_MS=

# strategy.hqGarrisonEnabled - Internal: IDLE fleets in the faction HQ stay there (after the foothold holders)
# and one free combat fleet flies back to an unheld HQ (LAUNCH patrol HQ_RETURN, in strategy.maxReturnsPerReview).
# Off by default (it changes the bench digest).
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_HQ_GARRISON_ENABLED=

# strategy.hqGarrisonMinFleets - Internal: fleets the HQ keeps (standing, refitting, engaged or flying to it).
# Range 1..4 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_HQ_GARRISON_MIN_FLEETS=

# strategy.hqGarrisonRoles - Internal: fleet roles that may hold the HQ or fly back to it (none = no HQ
# garrison). Default: garrison,patrol,invasion.
# EVEJS_LNE_STRATEGY_HQ_GARRISON_ROLES=

# strategy.hqGarrisonMaxJumps - Internal: max jumps from the HQ of a fleet sent back to it.
# Range 1..30 (outside: clamped). Default: 10.
# EVEJS_LNE_STRATEGY_HQ_GARRISON_MAX_JUMPS=

# strategy.garrisonReinforceEnabled - Internal: LAUNCH garrison (the doctrine garrison
# template) to own posts whose garrison is weaker than the template, only from the operation / mobilization slots the
# offensive left. On since bench IF2.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_GARRISON_REINFORCE_ENABLED=

# strategy.maxGarrisonReinforcePerReview - Internal: max garrison reinforcements per review (also bounded by
# the free strategy.maxOperationsPerReview / maxMobilizationsPerReview slots).
# Range 0..8 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_MAX_GARRISON_REINFORCE_PER_REVIEW=

# strategy.garrisonConsolidateEnabled - Internal: an own captured
# OCCUPIED / CONSOLIDATING system without a standing own fleet is a weak garrison post (after the posts under threat,
# before the other STABLE posts; needs strategy.garrisonReinforceEnabled). Off = the planner as before.
# Range: true/false. Default: false. Recommended value: 1.
# EVEJS_LNE_STRATEGY_GARRISON_CONSOLIDATE_ENABLED=1

# strategy.patrolEnabled - Internal: LAUNCH patrol (an idle garrison returns to a post or
# makes a sortie into own / unclaimed space nearby) and picket (an idle scout on stale intel of the reach), in the room
# of strategy.maxReturnsPerReview left by the returns. On by default, pickets closed by
# strategy.patrolMaxOpenPickets 0.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_PATROL_ENABLED=

# strategy.patrolWindowMs - Internal: dueAt window of a patrol / picket leg (dueAt = review time + window).
# Range 60000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_STRATEGY_PATROL_WINDOW_MS=

# strategy.patrolIdleMs - Internal: idle time before a garrison sortie / scout picket (a return never waits).
# Range 60000..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_STRATEGY_PATROL_IDLE_MS=

# strategy.patrolRoleSortieEnabled - Internal: LAUNCH patrol of an idle fleet of the role patrol inside the
# reach, in the room of strategy.maxReturnsPerReview. Off: such a fleet waits for an offensive.
# Range: true/false. Default: true.
# EVEJS_LNE_STRATEGY_PATROL_ROLE_SORTIE_ENABLED=

# strategy.patrolRoleMaxJumps - Internal: radius of a sortie of the role patrol from where the fleet stands.
# Range 1..15 (outside: clamped). Default: 6.
# EVEJS_LNE_STRATEGY_PATROL_ROLE_MAX_JUMPS=

# strategy.patrolRoleMaxEnemyRatio - Internal: a target with fresh intel of hostile strength above fleet
# strength x this ratio is refused.
# Range 0.1..10 (outside: clamped). Default: 1.5.
# EVEJS_LNE_STRATEGY_PATROL_ROLE_MAX_ENEMY_RATIO=

# strategy.patrolHostileNeedsFreshIntel - Internal: a sortie of the role patrol into a hostile system only
# with fresh intel and enemy strength (fresh hostileStrength + controller garrison) <= fleet strength x
# strategy.patrolRoleMaxEnemyRatio. Off: the old rule (no intel does not block the target).
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_PATROL_HOSTILE_NEEDS_FRESH_INTEL=

# strategy.patrolMinShips - Internal: min ships of a garrison for a sortie out of its post.
# Range 1..500 (outside: clamped). Default: 6.
# EVEJS_LNE_STRATEGY_PATROL_MIN_SHIPS=

# strategy.patrolGarrisonMaxJumps - Internal: max jumps of a garrison sortie target from its post.
# Range 1..10 (outside: clamped). Default: 2.
# EVEJS_LNE_STRATEGY_PATROL_GARRISON_MAX_JUMPS=

# strategy.patrolScoutMaxJumps - Internal: max jumps of a scout picket target from the scout.
# Range 1..15 (outside: clamped). Default: 5.
# EVEJS_LNE_STRATEGY_PATROL_SCOUT_MAX_JUMPS=

# strategy.patrolMaxGarrisonsPerPost - Internal (): ceiling of a garrison return. A returning garrison goes
# to the nearest post short of occupation.garrisonFleetsTarget, else to the nearest post holding (standing + flying)
# fewer than this many garrison fleets, else it stays (note PATROL_POSTS_FULL).
# Range 1..16 (outside: clamped). Default: 3.
# EVEJS_LNE_STRATEGY_PATROL_MAX_GARRISONS_PER_POST=

# strategy.patrolMaxOpenPickets - Internal (): max open picket operations of a faction.
# A scout over the limit stays (note PATROL_PICKET_CAP). 0 = no pickets (garrison patrols stay).
# Range 0..16 (outside: clamped). Default: 0.
# EVEJS_LNE_STRATEGY_PATROL_MAX_OPEN_PICKETS=

# strategy.patrolScoutReserve - Internal: idle scouts a picket always leaves for recon, counted after the recon
# of the review took its scouts (note PATROL_SCOUT_RESERVE).
# Range 0..16 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_PATROL_SCOUT_RESERVE=

# strategy.minerRaidEnabled - Internal: LAUNCH gank - an idle invasion / patrol fleet of a faction with
# "raid" in its doctrine flies to a belt where a hostile mining fleet stands in its shift (lowsec / nullsec), in the
# operation slots the offensive and the garrison left. The battle and the loss of the shift are the existing contact /
# settlement / trip machinery. Off: no read, no planner.
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_MINER_RAID_ENABLED=

# strategy.maxMinerRaidsPerReview - Internal: max LAUNCH gank per review (also bounded by the free
# strategy.maxOperationsPerReview slots).
# Range 0..4 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_MAX_MINER_RAIDS_PER_REVIEW=

# strategy.minerRaidWindowMs - Internal: dueAt window of a gank operation (the raider waits in the belt).
# Range 60000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_STRATEGY_MINER_RAID_WINDOW_MS=

# strategy.minerRaidMaxJumps - Internal: max jumps from the idle fleet to the hostile belt.
# Range 1..15 (outside: clamped). Default: 5.
# EVEJS_LNE_STRATEGY_MINER_RAID_MAX_JUMPS=

# strategy.minerRaidMinShips - Internal: min ships of a fleet sent on a miner raid.
# Range 1..500 (outside: clamped). Default: 3.
# EVEJS_LNE_STRATEGY_MINER_RAID_MIN_SHIPS=

# strategy.minerRaidMinShipRatioPermille - Internal: raider ships x 1000 >= hostile miner ships x this ratio.
# Range 0..10000 (outside: clamped). Default: 1000.
# EVEJS_LNE_STRATEGY_MINER_RAID_MIN_SHIP_RATIO_PERMILLE=

# strategy.minerRaidMinShiftLeftMs - Internal: time of the mining shift that must be left for a belt to be a
# raid target.
# Range 0..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_STRATEGY_MINER_RAID_MIN_SHIFT_LEFT_MS=

# strategy.minerRaidHighsecEnabled - Internal: highsec belts are miner raid targets too.
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_MINER_RAID_HIGHSEC_ENABLED=

# strategy.minerRaidStrengthCheck - Internal: a gank target must also pass the
# attack threshold: fleet strength >= max(1, ceil((fresh intel + garrison of strategy.garrisonEstimate) x
# strategy.attackStrengthRatio)); else note MINER_RAID_TOO_STRONG (counter strategy.review.minerRaidTooStrong).
# Off: the ship ratio only (the state before).
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_MINER_RAID_STRENGTH_CHECK=

# strategy.capitalPowerCalibrated - Internal: the AI power of each capital
# class (power tables of the AI review, hunt, occupation and siege) = the strength-v2 power x
# strategy.capitalPowerPermille<Class> / 1000 (calibrated on the resolver: tools/calibration/capitalScenarios.js).
# Off: the strength-v2 power only (the state before).
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_CAPITAL_POWER_CALIBRATED=

# strategy.capitalPowerPermille<Class> - Internal: AI power multiplier (permille) of the class, used only
# with strategy.capitalPowerCalibrated. Range 100..20000 (outside: clamped).
# Defaults: carrier 800, dreadnought 4100, force auxiliary 900, supercarrier 1250, titan 4700.
# EVEJS_LNE_STRATEGY_CAPITAL_POWER_PERMILLE_CARRIER=
# EVEJS_LNE_STRATEGY_CAPITAL_POWER_PERMILLE_DREADNOUGHT=
# EVEJS_LNE_STRATEGY_CAPITAL_POWER_PERMILLE_FORCE_AUXILIARY=
# EVEJS_LNE_STRATEGY_CAPITAL_POWER_PERMILLE_SUPERCARRIER=
# EVEJS_LNE_STRATEGY_CAPITAL_POWER_PERMILLE_TITAN=

# strategy.battleshipPowerCalibrated - Internal: the AI power of the battleship
# group (all AI power tables: review, occupation, hunt, grid defense, siege, sentries) = the strength-v2 power x
# strategy.battleshipPowerPermille / 1000 (calibrated on the resolver: tools/calibration/battleshipScenarios.js C2).
# Off: the strength-v2 power only (the state before).
# With strategy.battleshipDoctrines stock/on it also applies the garrison overlay of
# doctrines v21 (4 cruisers + 1 battlecruiser + 1 battleship), per doctrine only while it is not stronger than the v18
# garrison at this power table (else the start line "battleship garrison overlay dropped"). Target state: DOCTRINES=on
# together with POWER_CALIBRATED=1; rollback: both back to off / 0.
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_BATTLESHIP_POWER_CALIBRATED=

# strategy.battleshipPowerPermille - Internal: AI power multiplier (permille) of the
# battleship group, used only with strategy.battleshipPowerCalibrated. Range 100..2000 (outside: clamped).
# Default: 520.
# EVEJS_LNE_STRATEGY_BATTLESHIP_POWER_PERMILLE=

# strategy.capitalAttachEnabled - Internal:
# a mobilization that takes its hulls from a station (hull ledger) of a role of strategy.capitalAttachRoles adds up
# to strategy.capitalAttachMax capitals of the same station (one per class, order strategy.capitalAttachOrder). Never
# blocks the template: no capital / no ISK -> the fleet without it, note CAPITAL_NOT_AT_STATION / CAPITAL_SKIPPED_ISK
# (counters strategy.review.capitalAttached / capitalAttachSkipped). Gate: enable only with
# strategy.capitalPowerCalibrated, production.capitalLadderEnabled and materialization.capitalLiveEnabled.
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_CAPITAL_ATTACH_ENABLED=

# strategy.capitalAttachRoles - Internal: none or a comma list of invasion|garrison|patrol|hunter.
# Default: invasion,garrison,patrol,hunter.
# EVEJS_LNE_STRATEGY_CAPITAL_ATTACH_ROLES=

# strategy.capitalAttachOrder - Internal: none or a comma list of capital classes, tried in order.
# Default: titan,supercarrier,dreadnought,carrier,force_auxiliary.
# EVEJS_LNE_STRATEGY_CAPITAL_ATTACH_ORDER=

# strategy.capitalAttachMax - Internal: max capitals added to one mobilization. Range 0..3 (outside: clamped).
# Default: 1.
# EVEJS_LNE_STRATEGY_CAPITAL_ATTACH_MAX=

# strategy.capitalPreferStationEnabled - Internal: with
# strategy.capitalAttachEnabled a mobilization whose target level allows a capital class takes its template from a
# station holding such a capital first (else the nearest station as before). Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_CAPITAL_PREFER_STATION_ENABLED=

# strategy.capitalEscortEnabled - Internal: with strategy.capitalAttachEnabled an attack / garrison
# LAUNCH whose template went without the capital of its station (CAPITAL_NOT_AT_STATION) gets one capital-only MOBILIZE
# from a station within strategy.capitalEscortMaxJumps of the target (note CAPITAL_ESCORT, counter
# strategy.review.capitalEscort). Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_CAPITAL_ESCORT_ENABLED=

# strategy.capitalEscortMaxJumps - Internal: max jumps from the target to the station of the escort.
# Range 1..20 (outside: clamped). Default: 8.
# EVEJS_LNE_STRATEGY_CAPITAL_ESCORT_MAX_JUMPS=

# strategy.capitalReplenishEnabled - Internal: with
# strategy.capitalAttachEnabled and logistics.replenishEnabled an idle combat fleet without a capital standing in the
# system of an own station gets one capital of that station (REPLENISH, note CAPITAL_REPLENISH, counter
# strategy.review.capitalReplenished) when the escalation level of the system allows the class (a hunter never a
# supercarrier / titan). Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_CAPITAL_REPLENISH_ENABLED=

# strategy.capitalReplenishMaxPerReview - Internal: max capital REPLENISH intents per review, inside
# logistics.maxReplenishPerReview. Range 0..4 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_CAPITAL_REPLENISH_MAX_PER_REVIEW=

# strategy.minerRaidPreferUnescorted - Internal: gank targets without an escort
# first. Class 0 = fresh intel with hostile ships <= the miner ships, 1 = no fresh intel, 2 = fresh intel with more
# hostile ships (an escort); then jumps / ships as before (counter strategy.review.minerRaidUnescortedFirst).
# Range: true/false. Default: false.
# EVEJS_LNE_STRATEGY_MINER_RAID_PREFER_UNESCORTED=

# strategy.maxMinerTargetsRead - Internal: page of hostile mining trips read per review (1 -> truncated).
# Range 0..1024 (outside: clamped). Default: 256.
# EVEJS_LNE_STRATEGY_MAX_MINER_TARGETS_READ=

# strategy.capsuleerPursuitEnabled - Experimental: an idle combat fleet flies to
# virtual capsuleers STAGED in an own system (LAUNCH gank, purpose CAPSULEER_PURSUIT) and stays there as a guard.
# Needs capsuleers.enabled (config warning otherwise); the battle needs battle.capsuleerTripsFightable.enabled.
# Not in the launcher. Values: 1/0.
# Default: 0.
# EVEJS_LNE_STRATEGY_CAPSULEER_PURSUIT_ENABLED=

# strategy.foreignBastionRaidSkipEnabled - Experimental: miner raids
# and capsuleer pursuits skip a system whose NPC sov bastion belongs to another faction (the targeting rule).
# Not in the launcher. Values: 1/0.
# Default: 0.
# EVEJS_LNE_STRATEGY_FOREIGN_BASTION_RAID_SKIP_ENABLED=

# strategy.maxCapsuleerPursuitsPerReview - Internal: max pursuit LAUNCHes per review (also the free operation slots).
# Range 0..4 (outside: clamped). Default: 1.
# EVEJS_LNE_STRATEGY_MAX_CAPSULEER_PURSUITS_PER_REVIEW=

# strategy.capsuleerPursuitMaxJumps - Internal: max jumps from the capsuleer system to the pursuing fleet.
# Range 1..15 (outside: clamped). Default: 6.
# EVEJS_LNE_STRATEGY_CAPSULEER_PURSUIT_MAX_JUMPS=

# strategy.capsuleerPursuitMinShipRatioPermille - Internal: pursuer ships x 1000 >= capsuleer ships x this ratio.
# Range 100..10000 (outside: clamped). Default: 1500.
# EVEJS_LNE_STRATEGY_CAPSULEER_PURSUIT_MIN_SHIP_RATIO_PERMILLE=

# strategy.capsuleerPursuitWindowMs - Internal: dueAt window of a pursuit operation (dueAt = reviewAt + window).
# Range 60000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_STRATEGY_CAPSULEER_PURSUIT_WINDOW_MS=

# strategy.capsuleerPursuitReadLimit - Internal: page of STAGED capsuleer fleets read per faction review.
# Range 1..512 (outside: clamped). Default: 64.
# EVEJS_LNE_STRATEGY_CAPSULEER_PURSUIT_READ_LIMIT=

# strategy.capsuleerPursuitMaxFleetsScanned - Internal: idle combat fleets the pursuit planner considers per review.
# Range 1..256 (outside: clamped). Default: 32.
# EVEJS_LNE_STRATEGY_CAPSULEER_PURSUIT_MAX_FLEETS_SCANNED=

# blockade. A fleet STAGED in a system on an operation blockade
# stops hostile fleets that cross the system (fleets.travel.interceptInTx); the battle comes from the contact check.
# Needs modules.strategy and modules.battle. All keys internal: not in the launcher, values outside the range are
# clamped. The blockade operations are launched by the planners of (not in this slice).
# strategy.blockadeEnabled - Feature flag (departure listener + BLOCKADE_INTERCEPT). true/false. Default: false.
# EVEJS_LNE_STRATEGY_BLOCKADE_ENABLED=

# strategy.blockadeInterceptChancePermille - Chance (per mille) that a crossing fleet is stopped. Range 0..1000.
# Default: 600.
# EVEJS_LNE_STRATEGY_BLOCKADE_INTERCEPT_CHANCE_PERMILLE=

# strategy.blockadeInterceptOperationTypes - Operation types of the fleets a blockade stops: none or a comma list of
# operation types (also miners and convoys). Default: invasion,raid,gank,defense,reinforce,mining,logistics.
# EVEJS_LNE_STRATEGY_BLOCKADE_INTERCEPT_OPERATION_TYPES=

# strategy.blockadeListenerMaxSystems - Inner systems of a leg checked at departure. Range 1..128. Default: 32.
# EVEJS_LNE_STRATEGY_BLOCKADE_LISTENER_MAX_SYSTEMS=

# strategy.blockadeOpsPerSystemRead - Open blockades read per crossed system. Range 1..64. Default: 8.
# EVEJS_LNE_STRATEGY_BLOCKADE_OPS_PER_SYSTEM_READ=

# strategy.blockadeMaxCrossingsPerLeg - Interception events per leg (first by time). Range 1..8. Default: 2.
# EVEJS_LNE_STRATEGY_BLOCKADE_MAX_CROSSINGS_PER_LEG=

# strategy.blockadeActivationScanMaxFleets - Fleets in flight read when a blockade starts. Range 1..1000.
# Default: 256.
# EVEJS_LNE_STRATEGY_BLOCKADE_ACTIVATION_SCAN_MAX_FLEETS=

# border posts. The AI stages a rested combat fleet (role patrol
# invasion, no operation) on an operation blockade in an own border system with a hostile neighbour; a fleet already
# in the system stays in place. All keys internal: not in the launcher, values outside the range are clamped.
# Without strategy.blockadeEnabled the posts stand but stop nobody. With strategy.blockadeEnabled the service refuses
# to start (BLOCKADE_ROW_BOUND) while a row bound exceeds persistence.maxRowsPerTransaction.
# strategy.borderPostsEnabled - Feature flag (snapshot.borderLine + LAUNCH blockade). true/false. Default: false.
# EVEJS_LNE_STRATEGY_BORDER_POSTS_ENABLED=

# strategy.borderPostsMaxPerFaction - Open border posts of one faction. Range 0..16. Default: 3.
# EVEJS_LNE_STRATEGY_BORDER_POSTS_MAX_PER_FACTION=

# strategy.borderPostsMaxPerReview - Border posts launched per review. Range 0..8. Default: 1.
# EVEJS_LNE_STRATEGY_BORDER_POSTS_MAX_PER_REVIEW=

# strategy.borderPostWindowMs - dueAt window of a border post. Range 600000..86400000. Default: 3600000.
# EVEJS_LNE_STRATEGY_BORDER_POST_WINDOW_MS=

# strategy.borderPostIdleMs - Idle time of a fleet that flies to a post (none for a fleet in place). Range
# 0..86400000. Default: 900000.
# EVEJS_LNE_STRATEGY_BORDER_POST_IDLE_MS=

# strategy.borderPostMinShips - Ships of a border post fleet. Range 1..500. Default: 6.
# EVEJS_LNE_STRATEGY_BORDER_POST_MIN_SHIPS=

# strategy.borderPostMaxJumps - Jumps from the post to its fleet (0 = only a fleet in place). Range 0..15. Default: 4.
# EVEJS_LNE_STRATEGY_BORDER_POST_MAX_JUMPS=

# strategy.borderPostMaxEnemyRatio - Fresh hostile strength in the post above fleet strength x ratio -> no post.
# Range 0.1..10. Default: 1.5.
# EVEJS_LNE_STRATEGY_BORDER_POST_MAX_ENEMY_RATIO=

# strategy.borderPostSecClasses - Security classes of the post systems (comma list). Default: lowsec,nullsec.
# EVEJS_LNE_STRATEGY_BORDER_POST_SEC_CLASSES=

# strategy.borderLineMaxSystems - Border line systems in the review snapshot. Range 1..512. Default: 64.
# EVEJS_LNE_STRATEGY_BORDER_LINE_MAX_SYSTEMS=

# strategy.defensiveFleetSharePermille - Share of the live combat fleets on open blockade + escort operations. Range
# 0..1000. Default: 300.
# EVEJS_LNE_STRATEGY_DEFENSIVE_FLEET_SHARE_PERMILLE=

# strategy.borderForwardPostsEnabled - Forward posts beyond the gate (no logic in this version). Default: false.
# EVEJS_LNE_STRATEGY_BORDER_FORWARD_POSTS_ENABLED=

# strategy.borderPostScanMaxFleets - Fleets in flight read when a border post starts (min with
# strategy.blockadeActivationScanMaxFleets; 0 = no scan). Range 0..1000. Default: 32.
# EVEJS_LNE_STRATEGY_BORDER_POST_SCAN_MAX_FLEETS=

# miner escorts. The AI sends a rested combat fleet (role patrol
# invasion, no operation) on an operation escort to the belt of an own MINING trip at risk (on the border line or
# fresh hostile intel <= strategy.minerEscortThreatJumps); a fleet already in the belt stays in place. Shares the
# defensive budget strategy.defensiveFleetSharePermille and the operation slots with the border posts (posts first).
# All keys internal: not in the launcher, values outside the range are clamped.
# strategy.minerEscortEnabled - Feature flag (snapshot.mining.openTrips + LAUNCH escort). true/false. Default: false.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_ENABLED=

# strategy.minerEscortMaxPerFaction - Open escorts of one faction. Range 0..16. Default: 2.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_MAX_PER_FACTION=

# strategy.minerEscortMaxPerReview - Escorts launched per review. Range 0..8. Default: 1.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_MAX_PER_REVIEW=

# strategy.minerEscortWindowMs - dueAt window of an escort (dueAt = min(end of the shift, at + window)). Range
# 600000..86400000. Default: 3600000.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_WINDOW_MS=

# strategy.minerEscortMinShiftLeftMs - Shift time left for a belt to get an escort. Range 0..86400000. Default: 1800000.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_MIN_SHIFT_LEFT_MS=

# strategy.minerEscortThreatJumps - Jumps from a belt whose fresh hostile intel puts it at risk (0 = the belt only).
# Range 0..6. Default: 3.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_THREAT_JUMPS=

# strategy.minerEscortSecClasses - Security classes of the escorted belts (comma list). Default: lowsec,nullsec.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_SEC_CLASSES=

# strategy.minerEscortMinShips - Ships of an escort fleet. Range 1..500. Default: 3.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_MIN_SHIPS=

# strategy.minerEscortIdleMs - Idle time of a fleet that flies to a belt (none for a fleet in place). Range
# 0..86400000. Default: 900000.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_IDLE_MS=

# strategy.minerEscortMaxJumps - Jumps from the belt to its escort fleet (0 = only a fleet in place). Range 0..15.
# Default: 4.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_MAX_JUMPS=

# strategy.minerEscortMaxEnemyRatio - Fresh hostile strength in the belt above fleet strength x ratio -> no escort.
# Range 0.1..10. Default: 1.5.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_MAX_ENEMY_RATIO=

# strategy.minerEscortIntelMaxSystems - Systems around the escorted belts whose intel the review reads (cut ->
# counter strategy.review.minerEscortIntelTruncated). Range 0..512. Default: 128.
# EVEJS_LNE_STRATEGY_MINER_ESCORT_INTEL_MAX_SYSTEMS=

# intercepts. The reactive sweep reads the ACTIVE hostile invasion / raid / gank
# operations aimed at own space (only while the blockade service runs) and puts a short blockade (kind intercept_post,
# operation blockade) of an idle combat fleet in an own system on the route of a sighted hostile fleet, before
# it crosses. Shares the defensive budget strategy.defensiveFleetSharePermille and the open blockades with the border
# posts. Needs strategy.blockadeEnabled and strategy.reactiveEnabled. All keys internal: not in the launcher, values
# outside the range are clamped.
# strategy.interceptEnabled - Feature flag (intercept gate of the reactive sweep + LAUNCH intercept_post). true/false.
# Default: false.
# EVEJS_LNE_STRATEGY_INTERCEPT_ENABLED=

# strategy.interceptScanMaxOperations - ACTIVE hostile offensives read per sweep (full page -> counter
# strategy.reactive.interceptOpsTruncated). Range 1..1000. Default: 256.
# EVEJS_LNE_STRATEGY_INTERCEPT_SCAN_MAX_OPERATIONS=

# strategy.interceptMaxCandidates - Incoming hostile operations per faction whose fleets are read. Range 0..64.
# Default: 8.
# EVEJS_LNE_STRATEGY_INTERCEPT_MAX_CANDIDATES=

# strategy.interceptRouteMaxSystems - Systems of a hostile route the planner sees. Range 3..128. Default: 32.
# EVEJS_LNE_STRATEGY_INTERCEPT_ROUTE_MAX_SYSTEMS=

# strategy.interceptMaxJumps - Jumps from the intercept system to the own fleet (0 = only a fleet in place).
# Range 0..15. Default: 4.
# EVEJS_LNE_STRATEGY_INTERCEPT_MAX_JUMPS=

# strategy.interceptMinLeadMs - Time the own fleet stands in the system before the hostile crossing. Range
# 0..3600000. Default: 120000.
# EVEJS_LNE_STRATEGY_INTERCEPT_MIN_LEAD_MS=

# strategy.interceptHoldMs - Hold after the last hostile crossing (dueAt of the intercept post). Range
# 60000..86400000. Default: 900000.
# EVEJS_LNE_STRATEGY_INTERCEPT_HOLD_MS=

# strategy.interceptStrengthRatio - Own strength >= hostile strength crossing the system x ratio (hypothesis).
# Range 0.1..10. Default: 1.2.
# EVEJS_LNE_STRATEGY_INTERCEPT_STRENGTH_RATIO=

# strategy.interceptMaxPerSweep - Intercepts launched per faction and sweep. Range 0..8. Default: 1.
# EVEJS_LNE_STRATEGY_INTERCEPT_MAX_PER_SWEEP=

# strategy.maxThreatsRead - Page of threatened systems read per review (+1 -> truncated); only for service.
# Range 0..256 (outside: clamped). Default: 32.
# EVEJS_LNE_STRATEGY_MAX_THREATS_READ=

# strategy.maxLostHomeRead - Page of lost home systems read per review (+1 -> truncated); only for service.
# Range 0..256 (outside: clamped). Default: 32.
# EVEJS_LNE_STRATEGY_MAX_LOST_HOME_READ=

# trade.privateContractsEnabled - enable private contract path (assigneeCharacterId + standing threshold); false = public only.
# Range: true/false. Default: true.
# EVEJS_LNE_TRADE_PRIVATE_CONTRACTS_ENABLED=

# trade.privateOfferTtlMs - private offer TTL in ms (default 1 day); contract TTL = min(contractTtlMs, privateOfferTtlMs).
# Range 3600000..2592000000 (outside: clamped). Default: 86400000.
# EVEJS_LNE_TRADE_PRIVATE_OFFER_TTL_MS=

# trade.standingThreshold - minimum raw standing (0..10 scale) for private offer eligibility.
# Range 0..10 (outside: clamped). Default: 5.
# EVEJS_LNE_TRADE_STANDING_THRESHOLD=

# trade.rejectedCleanupMs - cooldown before REJECTED contracts are purged (default 7 days).
# Range 3600000..2592000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_TRADE_REJECTED_CLEANUP_MS=

# trade.privateOffersEnabled - enable AI planning of private offers for suppliers with standing bonus; false = public only.
# Range: true/false. Default: false.
# EVEJS_LNE_TRADE_PRIVATE_OFFERS_ENABLED=

# trade.maxPrivateOffersPerReview - max private offers planned per strategy review.
# Range 0..8 (outside: clamped). Default: 2.
# EVEJS_LNE_TRADE_MAX_PRIVATE_OFFERS_PER_REVIEW=

# trade.maxOpenPrivateOffersPerFaction - max open private offers per faction (shared with public offers limit).
# Range 0..32 (outside: clamped). Default: 4.
# EVEJS_LNE_TRADE_MAX_OPEN_PRIVATE_OFFERS_PER_FACTION=

# trade.maxOpenPrivateOffersPerCharacter - max open private offers per supplier character.
# Range 0..8 (outside: clamped). Default: 2.
# EVEJS_LNE_TRADE_MAX_OPEN_PRIVATE_OFFERS_PER_CHARACTER=

# trade.privateRejectCooldownMs - cooldown after REJECTED before character can receive another private offer (default 7 days, 0 = no cooldown).
# Range 0..2592000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_TRADE_PRIVATE_REJECT_COOLDOWN_MS=

# trade.supplierLookbackMs - time window to look back for recent suppliers (default 7 days).
# Range 3600000..2592000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_TRADE_SUPPLIER_LOOKBACK_MS=

# trade.maxSuppliersPerReview - max suppliers to consider per review.
# Range 1..100 (outside: clamped). Default: 20.
# EVEJS_LNE_TRADE_MAX_SUPPLIERS_PER_REVIEW=

# trade.standingThreshold1Min - tier 1 minimum raw standing for bonus.
# Range 0..10 (outside: clamped). Default: 2.
# EVEJS_LNE_TRADE_STANDING_THRESHOLD_1_MIN=

# trade.standingThreshold1Bonus - tier 1 bonus permille (0.3% per 1000).
# Range 0..1000 (outside: clamped). Default: 30.
# EVEJS_LNE_TRADE_STANDING_THRESHOLD_1_BONUS=

# trade.standingThreshold2Min - tier 2 minimum raw standing for bonus.
# Range 0..10 (outside: clamped). Default: 5.
# EVEJS_LNE_TRADE_STANDING_THRESHOLD_2_MIN=

# trade.standingThreshold2Bonus - tier 2 bonus permille.
# Range 0..1000 (outside: clamped). Default: 60.
# EVEJS_LNE_TRADE_STANDING_THRESHOLD_2_BONUS=

# trade.standingThreshold3Min - tier 3 minimum raw standing for bonus.
# Range 0..10 (outside: clamped). Default: 8.
# EVEJS_LNE_TRADE_STANDING_THRESHOLD_3_MIN=

# trade.standingThreshold3Bonus - tier 3 bonus permille.
# Range 0..1000 (outside: clamped). Default: 100.
# EVEJS_LNE_TRADE_STANDING_THRESHOLD_3_BONUS=

# trade.standingGrantEnabled - Enable the supplier standing for faction trade deliveries (default off until verified in the game); false = no grants, trade continues.
# Range: true/false. Default: false.
# EVEJS_LNE_TRADE_STANDING_GRANT_ENABLED=

# trade.contractListLiveRead - the LNE orphan scan filters the live contractRuntime rows instead of a clone
# of every contract; a failed read = the vendor list. Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_TRADE_CONTRACT_LIST_LIVE_READ=

# trade.standingIskPer01 - Supplier-standing: ISK for +0.1 standing at standing <= 0 (small volume, marginal).
# Range 100000..1000000000000 (outside: clamped). Default: 20000000.
# EVEJS_LNE_TRADE_STANDING_ISK_PER_01=

# trade.standingGrowthPermille - Supplier-standing: multiplier (permille) of the ISK for +0.1 per 1.0 of standing.
# Range 1000..5000 (outside: clamped). Default: 1600.
# EVEJS_LNE_TRADE_STANDING_GROWTH_PERMILLE=

# trade.standingDailyCap - Supplier-standing: standing gain per UTC day per character x faction (concave, saturates here).
# Range 0.001..2 (outside: clamped). Default: 0.3.
# EVEJS_LNE_TRADE_STANDING_DAILY_CAP=

# trade.standingWindowCap - Supplier-standing: rolling cap of the gain over standingWindowDays; 0 = off.
# Range 0..10 (outside: clamped). Default: 0.
# EVEJS_LNE_TRADE_STANDING_WINDOW_CAP=

# trade.standingWindowDays - Supplier-standing: window of the rolling cap and of the WTS debit, retention of the ledger (days).
# Range 1..30 (outside: clamped). Default: 7.
# EVEJS_LNE_TRADE_STANDING_WINDOW_DAYS=

# trade.standingCeiling - Supplier-standing: highest standing reachable by deliveries alone.
# Range 0..10 (outside: clamped). Default: 3.
# EVEJS_LNE_TRADE_STANDING_CEILING=

# trade.standingMinGrant - Supplier-standing: below this gain no grant, the credit carries over to the next delivery.
# Range 0..0.1 (outside: clamped). Default: 0.001.
# EVEJS_LNE_TRADE_STANDING_MIN_GRANT=

# trade.standingWtsOffsetEnabled - Supplier-standing: WTS bought from the faction within the window eats the delivery credit.
# Range: true/false. Default: true.
# EVEJS_LNE_TRADE_STANDING_WTS_OFFSET_ENABLED=

# trade.standingNoticeEnabled - Supplier-standing: SUPPLIER_STANDING notice line after an applied grant.
# Range: true/false. Default: true.
# EVEJS_LNE_TRADE_STANDING_NOTICE_ENABLED=

# trade.standingMaxGrantsPerCharacterDay - daily cap of standing grants per character per supplier faction (0 = unlimited); WARNING: if > persistence.maxRowsPerTransaction, effective cap is min(cap, maxRows).
# Range 0..10000 (outside: clamped). Default: 100.
# EVEJS_LNE_TRADE_STANDING_MAX_GRANTS_PER_CHARACTER_DAY=

# trade.standingGrantMaxAgeMs - max age of a standing grant event before it expires without vendor call (default 7 days).
# Range 0..2592000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_TRADE_STANDING_GRANT_MAX_AGE_MS=

# trade.standingMaxGrantsPerPass - max standing grants processed per scheduler pass.
# Range 1..1000 (outside: clamped). Default: 10.
# EVEJS_LNE_TRADE_STANDING_MAX_GRANTS_PER_PASS=

# trade.virtualIssuers - Internal: contracts issued by the virtual corporation heads (virtualCorps); off or no head -> NPC corporation of the station
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_TRADE_VIRTUAL_ISSUERS=

# trade.warPricingEnabled - Internal: mobilization / hull WTB offers of a faction under war pressure pay a war price; false = prices and snapshot as before
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_TRADE_WAR_PRICING_ENABLED=

# trade.warPricingWindowDays - Internal: days of treasury battle losses in the pressure (cut to treasury.dayRetentionDays).
# Range 1..14 (outside: clamped). Default: 3.
# EVEJS_LNE_TRADE_WAR_PRICING_WINDOW_DAYS=

# trade.warPricingLossRefPermille - Internal: losses of the window equal to this permille of the initial ISK = full loss pressure.
# Range 1..10000 (outside: clamped). Default: 100.
# EVEJS_LNE_TRADE_WAR_PRICING_LOSS_REF_PERMILLE=

# trade.warPricingThreatRef - Internal: threatened own systems giving full threat pressure.
# Range 1..64 (outside: clamped). Default: 4.
# EVEJS_LNE_TRADE_WAR_PRICING_THREAT_REF=

# trade.warPricingLossWeightPermille - Internal: weight of the loss pressure.
# Range 0..1000 (outside: clamped). Default: 700.
# EVEJS_LNE_TRADE_WAR_PRICING_LOSS_WEIGHT_PERMILLE=

# trade.warPricingThreatWeightPermille - Internal: weight of the threat pressure.
# Range 0..1000 (outside: clamped). Default: 500.
# EVEJS_LNE_TRADE_WAR_PRICING_THREAT_WEIGHT_PERMILLE=

# trade.warPricingAusterityWeightPermille - Internal: weight of the treasury AUSTERITY mode.
# Range 0..1000 (outside: clamped). Default: 200.
# EVEJS_LNE_TRADE_WAR_PRICING_AUSTERITY_WEIGHT_PERMILLE=

# trade.warPricingMinPermille - Internal: pressure under this permille = 0 (dead zone).
# Range 0..1000 (outside: clamped). Default: 100.
# EVEJS_LNE_TRADE_WAR_PRICING_MIN_PERMILLE=

# trade.warPricingStepPermille - Internal: the pressure is rounded down to this step.
# Range 1..1000 (outside: clamped). Default: 100.
# EVEJS_LNE_TRADE_WAR_PRICING_STEP_PERMILLE=

# trade.warBonusMaxPermille - Internal: bonus over the reference price at full pressure.
# Range 0..2000 (outside: clamped). Default: 300.
# EVEJS_LNE_TRADE_WAR_BONUS_MAX_PERMILLE=

# trade.warAskCapMaxPermille - Internal: ask cap at full pressure (permille of the best ask).
# Range 500..2000 (outside: clamped). Default: 1150.
# EVEJS_LNE_TRADE_WAR_ASK_CAP_MAX_PERMILLE=

# trade.warRepriceEnabled - Internal: recall an open public war-demand offer priced below the war price (needs warPricingEnabled).
# Range: true/false. Default: false.
# EVEJS_LNE_TRADE_WAR_REPRICE_ENABLED=

# trade.warRepriceGapPermille - Internal: minimal gap under the war price (permille) that recalls an offer.
# Range 1..1000 (outside: clamped). Default: 50.
# EVEJS_LNE_TRADE_WAR_REPRICE_GAP_PERMILLE=

# trade.warRepricePerReview - Internal: max war reprice recalls per review (inside maxCancelsPerReview).
# Range 0..8 (outside: clamped). Default: 2.
# EVEJS_LNE_TRADE_WAR_REPRICE_PER_REVIEW=

# trade.warStationAskGuardEnabled - Internal: cut the war price of a station to its cheapest ask (needs warPricingEnabled; no fresh read = public price).
# Range: true/false. Default: false.
# EVEJS_LNE_TRADE_WAR_STATION_ASK_GUARD_ENABLED=

# trade.warStationAskCapPermille - Internal: war price cap of a station = its cheapest ask x this permille / 1000.
# Range 500..2000 (outside: clamped). Default: 1000.
# EVEJS_LNE_TRADE_WAR_STATION_ASK_CAP_PERMILLE=

# trade.stationAskCacheMs - Internal: age of a station ask read the review still uses.
# Range 60000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_TRADE_STATION_ASK_CACHE_MS=

# trade.maxStationAskReadsPerPass - Internal: GetStationAsks reads per executor pass (0 = never).
# Range 0..64 (outside: clamped). Default: 4.
# EVEJS_LNE_TRADE_MAX_STATION_ASK_READS_PER_PASS=

# trade.stationAskCacheMaxStations - Internal: stations kept in the ask cache and its read queue.
# Range 16..8192 (outside: clamped). Default: 512.
# EVEJS_LNE_TRADE_STATION_ASK_CACHE_MAX_STATIONS=

# observer.galaxyFrontEnabled - Off = the view layer-front is not registered (needs galaxyEnabled and the occupation service).
# Range: true/false. Default: true.
# EVEJS_LNE_OBSERVER_GALAXY_FRONT_ENABLED=

# observer.galaxyFrontMaxSystems - Marks per response (pattern of obs-02); 0 = empty layer.
# Range 0..5000 (outside: clamped). Default: 512.
# EVEJS_LNE_OBSERVER_GALAXY_FRONT_MAX_SYSTEMS=

# observer.galaxyFrontMaxLines - Mark lines per system tooltip of the front layer; 0 = header only.
# Range 0..50 (outside: clamped). Default: 4.
# EVEJS_LNE_OBSERVER_GALAXY_FRONT_MAX_LINES=

# observer.galaxyFrontRefreshMs - Time bucket of the layer cacheKey, at most one database read per bucket.
# Range 1000..300000 (outside: clamped). Default: 60000.
# EVEJS_LNE_OBSERVER_GALAXY_FRONT_REFRESH_MS=

# observer.galaxyProgressEnabled - Off = the view layer-progress is not registered (needs galaxyEnabled and the occupation service).
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_OBSERVER_GALAXY_PROGRESS_ENABLED=

# observer.galaxyProgressMaxSystems - Systems per response of the progress layer, ceiling world.maxListLimit; 0 = empty layer.
# Not in the launcher. Range 0..500 (outside: clamped). Default: 256.
# EVEJS_LNE_OBSERVER_GALAXY_PROGRESS_MAX_SYSTEMS=

# observer.galaxyProgressMaxDrawn - Progress bars drawn per frame; the list of captures still shows every system of the response.
# Not in the launcher. Range 0..512 (outside: clamped). Default: 96.
# EVEJS_LNE_OBSERVER_GALAXY_PROGRESS_MAX_DRAWN=

# observer.galaxyProgressRefreshMs - Time bucket of the layer cacheKey, at most one build per bucket.
# Not in the launcher. Range 1000..300000 (outside: clamped). Default: 30000.
# EVEJS_LNE_OBSERVER_GALAXY_PROGRESS_REFRESH_MS=

# observer.systemCardEnabled - Off = the view system-card is not registered and the map keeps its old details table.
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_OBSERVER_SYSTEM_CARD_ENABLED=

# observer.systemCardRefreshMs - Time bucket of the cacheKey and the refresh of an open card in the page.
# Not in the launcher. Range 1000..300000 (outside: clamped). Default: 15000.
# EVEJS_LNE_OBSERVER_SYSTEM_CARD_REFRESH_MS=

# observer.systemCardCacheSlots - Systems kept in the router cache and the last good answers (LRU).
# Not in the launcher. Range 1..64 (outside: clamped). Default: 16.
# EVEJS_LNE_OBSERVER_SYSTEM_CARD_CACHE_SLOTS=

# observer.systemCardMaxRows - Operations of the card; each costs one more query for its fleets.
# Not in the launcher. Range 1..100 (outside: clamped). Default: 12.
# EVEJS_LNE_OBSERVER_SYSTEM_CARD_MAX_ROWS=

# observer.systemCardMaxFleets - Fleets read in the system for the card; above = the section says truncated.
# Not in the launcher. Range 1..2000 (outside: clamped). Default: 200.
# EVEJS_LNE_OBSERVER_SYSTEM_CARD_MAX_FLEETS=

# observer.systemCardRecentBattles - Latest battles of the card; 0 = no section.
# Not in the launcher. Range 0..50 (outside: clamped). Default: 5.
# EVEJS_LNE_OBSERVER_SYSTEM_CARD_RECENT_BATTLES=

# observer.systemInteriorEnabled - Off = the view system-interior is not registered, ui.systemInterior = null (needs galaxyEnabled).
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_ENABLED=

# observer.systemInteriorRefreshMs - Time bucket of the cacheKey and the refresh of the interior in the page.
# Not in the launcher. Range 1000..300000 (outside: clamped). Default: 15000.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_REFRESH_MS=

# observer.systemInteriorStaticCacheSystems - Systems whose static interior (adapter) the view keeps (LRU).
# Not in the launcher. Range 1..1024 (outside: clamped). Default: 64.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_STATIC_CACHE_SYSTEMS=

# observer.systemInteriorMaxObjects - Static objects per system; above = truncated (moons go first).
# Not in the launcher. Range 16..2000 (outside: clamped). Default: 400.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_MAX_OBJECTS=

# observer.systemInteriorMaxFleets - Present fleets and incoming rows of the interior.
# Not in the launcher. Range 1..500 (outside: clamped). Default: 60.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_MAX_FLEETS=

# observer.systemInteriorMaxOperations - Operations targeting the system; each costs one query for its fleets; 0 = no incoming.
# Not in the launcher. Range 0..50 (outside: clamped). Default: 8.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_MAX_OPERATIONS=

# observer.systemInteriorMaxBattles - Latest battles read (the open ones are shown); 0 = none.
# Not in the launcher. Range 0..50 (outside: clamped). Default: 5.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_MAX_BATTLES=

# observer.systemInteriorMaxSites - Visible Event Director sites of the interior; 0 = none.
# Not in the launcher. Range 0..200 (outside: clamped). Default: 24.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_MAX_SITES=

# observer.systemInteriorZoom - Relative zoom (fit = 1) at which the interior opens, above the map's old maximum 80.
# Not in the launcher. Range 81..1000 (outside: clamped). Default: 90.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_ZOOM=

# observer.systemInteriorZoomMax - Zoom ceiling of the map with the interior on; must be above systemInteriorZoom.
# Not in the launcher. Range 100..100000 (outside: clamped). Default: 20000.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_ZOOM_MAX=

# observer.systemInteriorZoomOutPermille - Hysteresis, the interior closes below zoom * permille / 1000.
# Not in the launcher. Range 500..1000 (outside: clamped). Default: 800.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_ZOOM_OUT_PERMILLE=

# observer.systemInteriorPickPx - Radius (px) around the canvas centre in which the interior system is picked.
# Not in the launcher. Range 20..600 (outside: clamped). Default: 120.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_PICK_PX=

# observer.systemInteriorLogBaseMilliAu - Base b of the logarithmic distance scale, in milli-AU.
# Not in the launcher. Range 1..10000 (outside: clamped). Default: 100.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_LOG_BASE_MILLI_AU=

# observer.systemInteriorStartPx - Disc radius (px) at the entry zoom; grows linearly with the zoom.
# Not in the launcher. Range 8..200 (outside: clamped). Default: 24.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_START_PX=

# observer.systemInteriorMoonRingPermille - Largest moon / belt / station offset from its parent, permille of the disc radius (log scale).
# Not in the launcher. Range 1..200 (outside: clamped). Default: 30.
# EVEJS_LNE_OBSERVER_SYSTEM_INTERIOR_MOON_RING_PERMILLE=

# observer.galaxyHuntsMaxSystems - Limit of systems in the layer-hunts response (0 = empty layer).
# Range 0..5000 (outside: clamped). Default: 1000.
# EVEJS_LNE_OBSERVER_GALAXY_HUNTS_MAX_SYSTEMS=

# observer.galaxyHuntsRefreshMs - Time bucket of the layer-hunts cacheKey, at most one database read per bucket.
# Range 1000..300000 (outside: clamped). Default: 15000.
# EVEJS_LNE_OBSERVER_GALAXY_HUNTS_REFRESH_MS=

# observer.huntsPanelMaxRows - Max rows in the hunts panel.
# Range 1..2000 (outside: clamped). Default: 100.
# EVEJS_LNE_OBSERVER_HUNTS_PANEL_MAX_ROWS=

# observer.huntsPanelRefreshMs - Time bucket of the hunts panel cacheKey.
# Range 1000..300000 (outside: clamped). Default: 15000.
# EVEJS_LNE_OBSERVER_HUNTS_PANEL_REFRESH_MS=

# observer.factionOverviewEnabled - Internal: off = neither faction-overview nor faction-fleets is registered.
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_OBSERVER_FACTION_OVERVIEW_ENABLED=

# observer.factionOverviewRefreshMs - Time bucket of the faction-overview and faction-fleets cacheKey, at most one build per bucket.
# Range 1000..300000 (outside: clamped). Default: 15000.
# EVEJS_LNE_OBSERVER_FACTION_OVERVIEW_REFRESH_MS=

# observer.factionOverviewMaxFactions - Factions per faction-overview / faction-fleets response.
# Range 1..128 (outside: clamped). Default: 32.
# EVEJS_LNE_OBSERVER_FACTION_OVERVIEW_MAX_FACTIONS=

# observer.factionOverviewMaxNotes - Strategy notes per faction card (blockers first).
# Range 0..64 (outside: clamped). Default: 12.
# EVEJS_LNE_OBSERVER_FACTION_OVERVIEW_MAX_NOTES=

# observer.factionOverviewMaxJobs - Production jobs per faction card (by dueAt).
# Range 0..200 (outside: clamped). Default: 16.
# EVEJS_LNE_OBSERVER_FACTION_OVERVIEW_MAX_JOBS=

# observer.factionOverviewMaxStations - Station rows per faction card.
# Range 0..200 (outside: clamped). Default: 16.
# EVEJS_LNE_OBSERVER_FACTION_OVERVIEW_MAX_STATIONS=

# observer.treasuryFullDayEnabled - the faction card treasury shows the whole
# day (admin, warSpend, mercFees, mercRefunds, net of today and yesterday) and the 7-day average net of the forecast.
# Off = the card of before. compose.yaml passes 0 unless the root .env sets it. Not in the launcher.
# Range: true/false. Default: false.
# EVEJS_LNE_OBSERVER_TREASURY_FULL_DAY_ENABLED=

# observer.factionFleetsMaxPerFaction - Fleet rows per faction in faction-fleets (0 = totals only).
# Range 0..1000 (outside: clamped). Default: 100.
# EVEJS_LNE_OBSERVER_FACTION_FLEETS_MAX_PER_FACTION=

# observer.factionFleetsMaxOperationsPerFaction - Open operations per faction in faction-fleets (ACTIVE first, then PLANNED; 0 = none).
# Range 0..200 (outside: clamped). Default: 20.
# EVEJS_LNE_OBSERVER_FACTION_FLEETS_MAX_OPERATIONS_PER_FACTION=

# observer.effectiveConfigEnabled - Internal: the read-only panel effective-config (flags vs default, sleeping
# features, retention, database size; secrets masked). Off = the view is not registered.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_OBSERVER_EFFECTIVE_CONFIG_ENABLED=

# observer.effectiveConfigRefreshMs - Time bucket of the effective-config cacheKey, at most one build per bucket.
# Range 1000..300000 (outside: clamped). Default: 10000.
# EVEJS_LNE_OBSERVER_EFFECTIVE_CONFIG_REFRESH_MS=

# observer.effectiveConfigOriginChars - Characters of the SCHEMA origin text per flag row (0 = none).
# Range 0..2000 (outside: clamped). Default: 120.
# EVEJS_LNE_OBSERVER_EFFECTIVE_CONFIG_ORIGIN_CHARS=

# `!front` in local chat (a reply to the sender only, read only; needs modules.world).
# All keys internal: not in the launcher, values outside the range are clamped.
# frontChat.enabled - Feature flag. true/false. Default: false (turn on after a try in the client).
# EVEJS_LNE_FRONT_CHAT_ENABLED=

# frontChat.cooldownMs - Cooldown per character. Range 1000..600000. Default: 10000.
# EVEJS_LNE_FRONT_CHAT_COOLDOWN_MS=

# frontChat.maxRepliesPerMinute - Replies of every character together in 60 s. Range 1..600. Default: 30.
# EVEJS_LNE_FRONT_CHAT_MAX_REPLIES_PER_MINUTE=

# frontChat.maxTrackedCharacters - Characters held by the limiter. Range 16..65536. Default: 1024.
# EVEJS_LNE_FRONT_CHAT_MAX_TRACKED_CHARACTERS=

# frontChat.maxRows - Operations read by the card of a reply. Range 1..12. Default: 5.
# EVEJS_LNE_FRONT_CHAT_MAX_ROWS=

# frontChat.maxFleets - Fleets read by the card of a reply. Range 1..2000. Default: 100.
# EVEJS_LNE_FRONT_CHAT_MAX_FLEETS=

# frontChat.recentBattles - Latest battles read by the card. Range 0..50. Default: 3.
# EVEJS_LNE_FRONT_CHAT_RECENT_BATTLES=

# frontChat.regionMaxSystems - Above: the region line says too large, no read. Range 1..1000. Default: 500.
# EVEJS_LNE_FRONT_CHAT_REGION_MAX_SYSTEMS=

# frontChat.regionContestedRows - Contested systems of the region listed. Range 0..10. Default: 3.
# EVEJS_LNE_FRONT_CHAT_REGION_CONTESTED_ROWS=

# frontChat.regionProgressSystems - Progress reads of the listed rows per reply. Range 0..10. Default: 3.
# EVEJS_LNE_FRONT_CHAT_REGION_PROGRESS_SYSTEMS=

# frontChat.maxLines - Lines of a reply. Range 3..30. Default: 10.
# EVEJS_LNE_FRONT_CHAT_MAX_LINES=

# frontChat.maxReplyChars - Characters of a reply (hypothesis of the client limit). Range 200..4000. Default: 1000.
# EVEJS_LNE_FRONT_CHAT_MAX_REPLY_CHARS=

# frontChat.lineBreak - Line separator of a reply: <br>, \n or " | ". Default: <br> (to verify in the client).
# EVEJS_LNE_FRONT_CHAT_LINE_BREAK=

# `!mods` in local chat (the chat commands of the loaded mods, a reply to the
# sender only, read only; needs modules.world). All keys internal: not in the launcher, values outside the range are
# clamped. Line break, global window and tracked characters: frontChat.lineBreak / maxRepliesPerMinute /
# maxTrackedCharacters.
# modsHelp.enabled - Feature flag. true/false. Default: true (off = `!mods` is plain chat text).
# EVEJS_LNE_MODS_HELP_ENABLED=

# modsHelp.cooldownMs - Cooldown per character. Range 1000..600000. Default: 5000.
# EVEJS_LNE_MODS_HELP_COOLDOWN_MS=

# modsHelp.maxReplyChars - Characters of a reply (a longer list is split into pages: `!mods 2`). Range 200..4000. Default: 1000.
# EVEJS_LNE_MODS_HELP_MAX_REPLY_CHARS=

# `!map` (alias `!mapa`) in local chat, a link to the observer map at the system
# of the sender (a reply to the sender only, read only; needs modules.world). All keys internal: not in the launcher,
# integers outside the range are clamped. Line break, global window and tracked characters: frontChat.lineBreak /
# maxRepliesPerMinute / maxTrackedCharacters.
# inGameMap.enabled - Master of the in-game map. true/false. Default: false (off = `!map` is plain chat text).
# EVEJS_LNE_INGAME_MAP_ENABLED=0

# inGameMap.chatEnabled - The `!map` command (only with inGameMap.enabled). true/false. Default: true.
# EVEJS_LNE_INGAME_MAP_CHAT_ENABLED=

# inGameMap.observerUrl - Observer URL of the link, http:// or https://, no spaces, quotes, < or >, at most 200
# characters (a bad value is ignored). Default: empty = http://127.0.0.1:<observer.port>/. A missing "/" is added.
# EVEJS_LNE_INGAME_MAP_OBSERVER_URL=

# inGameMap.chatMinIntervalMs - One `!map` reply per character per period. Range 1000..600000. Default: 10000.
# EVEJS_LNE_INGAME_MAP_CHAT_MIN_INTERVAL_MS=

# The jumps of the LNE fleets in the star map Statistics -> Jumps (a scan of the
# fleets in flight, memory only, no write; needs modules.fleets, W57).
# inGameMap.starmapJumpsEnabled - LNE jumps in the star map (only with inGameMap.enabled). true/false. Default: true.
# EVEJS_LNE_INGAME_MAP_STARMAP_JUMPS_ENABLED=

# inGameMap.starmapJumpsPerShip - A jump weighs the ship count of the fleet; false = 1 per fleet. true/false.
# Default: true.
# EVEJS_LNE_INGAME_MAP_STARMAP_JUMPS_PER_SHIP=

# inGameMap.starmapScanMs - Period of the scan of the fleets in flight. Range 5000..600000. Default: 30000.
# EVEJS_LNE_INGAME_MAP_STARMAP_SCAN_MS=

# inGameMap.starmapScanPageSize - Fleets per read page (also capped by fleets.maxListLimit). Range 50..5000.
# Default: 500.
# EVEJS_LNE_INGAME_MAP_STARMAP_SCAN_PAGE_SIZE=

# inGameMap.starmapMaxScanFleets - Fleets read per scan in total. Range 100..50000. Default: 5000.
# EVEJS_LNE_INGAME_MAP_STARMAP_MAX_SCAN_FLEETS=

# inGameMap.starmapMaxTrackedLegs - Legs kept in memory (the oldest arrival dropped first). Range 100..200000.
# Default: 20000.
# EVEJS_LNE_INGAME_MAP_STARMAP_MAX_TRACKED_LEGS=

# The losses of the LNE VIRTUAL battles in Statistics -> Ship kills / NPC kills
# . Read only, nothing written; a change of starmapKillsEnabled or inGameMap.enabled needs a restart.
# inGameMap.starmapKillsEnabled - LNE kills in the star map (only with inGameMap.enabled). true/false. Default: true.
# EVEJS_LNE_INGAME_MAP_STARMAP_KILLS_ENABLED=

# inGameMap.starmapKillsRefreshMs - Period of the read of the losses of the last 24 h. Range 10000..3600000.
# Default: 60000.
# EVEJS_LNE_INGAME_MAP_STARMAP_KILLS_REFRESH_MS=

# inGameMap.starmapMaxLossRows - Loss rows read per refresh (newest first). Range 10..20000. Default: 2000.
# EVEJS_LNE_INGAME_MAP_STARMAP_MAX_LOSS_ROWS=

# inGameMap.starmapMaxSyntheticKills - Synthetic kill records (one per lost hull, newest first). Range 10..50000.
# Default: 5000.
# EVEJS_LNE_INGAME_MAP_STARMAP_MAX_SYNTHETIC_KILLS=

# inGameMap.starmapFallbackShipTypeId - Hull type of a loss without a type. Range 1..2147483647. Default: 587.
# EVEJS_LNE_INGAME_MAP_STARMAP_FALLBACK_SHIP_TYPE_ID=

# The client map probe client/mapProbe.py, sent at login
# with the board code (same clientHook.js preload and jobBoard.handshakeHashes). It only reports which UI primitives the
# client has (log LNE_MAP_UI:PROBE) and opens a test window on `!map probe [N|attrs]`. A change needs a restart + relog.
# inGameMap.clientProbeEnabled - The map probe (only with inGameMap.enabled). true/false. Default: false.
# EVEJS_LNE_INGAME_MAP_CLIENT_PROBE_ENABLED=0

# inGameMap.maxClientPayloadBytes - Budget of the probe part (deflate + base64). Range 4096..49152. Default: 24576.
# EVEJS_LNE_INGAME_MAP_MAX_CLIENT_PAYLOAD_BYTES=

# inGameMap.reportMinIntervalMs - One LNE_MAP_UI:PROBE line per character per period. Range 1000..3600000.
# Default: 10000.
# EVEJS_LNE_INGAME_MAP_REPORT_MIN_INTERVAL_MS=

# inGameMap.probeDefaultNodes - Nodes of `!map probe` without a number. Range 1..5000. Default: 100.
# EVEJS_LNE_INGAME_MAP_PROBE_DEFAULT_NODES=

# inGameMap.probeMaxNodes - Ceiling of `!map probe <N>`. Range 1..5000. Default: 2000.
# EVEJS_LNE_INGAME_MAP_PROBE_MAX_NODES=

# inGameMap.windowMaxTrackedCharacters - Characters kept in memory (delivered code, limiter). Range 16..8192.
# Default: 512.
# EVEJS_LNE_INGAME_MAP_WINDOW_MAX_TRACKED_CHARACTERS=

# lneMapSvc.GetMap, the data of the client map window
# (a region with its neighbours or the galaxy by regions) from the observer map views (needs observer.galaxyEnabled).
# No table, no write; memory only.
# inGameMap.windowEnabled - GetMap answers (only with inGameMap.enabled). true/false. Default: false.
# EVEJS_LNE_INGAME_MAP_WINDOW_ENABLED=0

# inGameMap.windowPollMs - Poll period of an open client map window. Range 10000..300000. Default: 30000.
# EVEJS_LNE_INGAME_MAP_WINDOW_POLL_MS=

# inGameMap.windowMinIntervalMs - One GetMap per character per period. Range 1000..60000. Default: 5000.
# EVEJS_LNE_INGAME_MAP_WINDOW_MIN_INTERVAL_MS=

# inGameMap.windowMaxReadsPerMinute - GetMap answers of all characters per minute. Range 1..6000. Default: 120.
# EVEJS_LNE_INGAME_MAP_WINDOW_MAX_READS_PER_MINUTE=

# inGameMap.windowMaxSystems - Nodes of one answer. Range 20..1000. Default: 300.
# EVEJS_LNE_INGAME_MAP_WINDOW_MAX_SYSTEMS=

# inGameMap.windowMaxMarkers - Markers of one answer. Range 0..1000. Default: 200.
# EVEJS_LNE_INGAME_MAP_WINDOW_MAX_MARKERS=

# inGameMap.windowNeighborJumps - Jumps of the outer neighbours of a region. Range 0..2. Default: 1.
# EVEJS_LNE_INGAME_MAP_WINDOW_NEIGHBOR_JUMPS=

# inGameMap.windowCacheEntries - Built answers kept in memory (LRU). Range 1..1024. Default: 64.
# EVEJS_LNE_INGAME_MAP_WINDOW_CACHE_ENTRIES=

# inGameMap.windowClientCacheRegions - Static parts the client keeps. Range 1..64. Default: 8.
# EVEJS_LNE_INGAME_MAP_WINDOW_CLIENT_CACHE_REGIONS=

# inGameMap.windowMaxLabels - System names the client draws. Range 0..1000. Default: 150.
# EVEJS_LNE_INGAME_MAP_WINDOW_MAX_LABELS=

# inGameMap.windowStateMinRefreshMs - galaxy-state read again at most once per period. Range 1000..300000.
# Default: 10000.
# EVEJS_LNE_INGAME_MAP_WINDOW_STATE_MIN_REFRESH_MS=

# inGameMap.windowCorpMarksRefreshMs - Listening post sightings of one corporation and scope read again at most once
# per period (kind 6 of the map window). Range 5000..300000. Default: 30000.
# EVEJS_LNE_INGAME_MAP_WINDOW_CORP_MARKS_REFRESH_MS=

# The LNE board window in the game client (front jobs and war
# contracts). Python code sent to the client at login, in memory only (the shipWing technique). Docker
# needs the extra preload line `--require /app/mods/livingNewEden/clientHook.js` before shipWing (docker/entrypoint.sh).
# All keys internal: not in the launcher, integers outside the range are clamped. A change needs a restart.
# jobBoard.enabled - Master of the board window. true/false. Default: false (off = no hook, no service, no `!board`).
# EVEJS_LNE_JOB_BOARD_ENABLED=0

# jobBoard.chatEnabled - The `!board` command (alias `!tablica`, only with jobBoard.enabled). true/false. Default: true.
# EVEJS_LNE_JOB_BOARD_CHAT_ENABLED=

# jobBoard.handshakeHashes - Known handshake.js hashes (sha256 of the LF text), comma list of 1..8. Default: the hash
# of EveJS 261115.2. Another file = no window (the log names the hash).
# EVEJS_LNE_JOB_BOARD_HANDSHAKE_HASHES=

# jobBoard.maxClientPayloadBytes - Budget of the own part of the login code. Range 4096..49152. Default: 32768.
# EVEJS_LNE_JOB_BOARD_MAX_CLIENT_PAYLOAD_BYTES=

# jobBoard.clientPollMs - Refresh of the open window; 0 = the Refresh button only, else 5000..120000. Default: 15000.
# EVEJS_LNE_JOB_BOARD_CLIENT_POLL_MS=

# jobBoard.minCallIntervalMs - One window read per character per period. Range 250..60000. Default: 1000.
# EVEJS_LNE_JOB_BOARD_MIN_CALL_INTERVAL_MS=

# jobBoard.maxTrackedCharacters - Characters kept by the limiters. Range 16..8192. Default: 512.
# EVEJS_LNE_JOB_BOARD_MAX_TRACKED_CHARACTERS=

# jobBoard.maxJobRows - Rows of the front jobs section. Range 5..50. Default: 20.
# EVEJS_LNE_JOB_BOARD_MAX_JOB_ROWS=

# jobBoard.maxWarRows - Rows of the war contracts section. Range 5..50. Default: 20.
# EVEJS_LNE_JOB_BOARD_MAX_WAR_ROWS=

# jobBoard.nearbyMaxJumps - Gate jumps of the distance search (farther = -1). Range 1..30. Default: 10.
# EVEJS_LNE_JOB_BOARD_NEARBY_MAX_JUMPS=

# jobBoard.distanceMemoSystems - Viewer systems kept in the distance memo. Range 8..512. Default: 64.
# EVEJS_LNE_JOB_BOARD_DISTANCE_MEMO_SYSTEMS=

# jobBoard.distanceMemoMaxEntries - Budget of the distance memo in system entries, all viewer systems together (LRU;
# the newest map stays). Range 10000..2000000. Default: 200000.
# EVEJS_LNE_JOB_BOARD_DISTANCE_MEMO_MAX_ENTRIES=

# jobBoard.warCacheTtlMs - Cache of the war contract list, shared by all players (0 = none). Range 0..120000.
# Default: 10000.
# EVEJS_LNE_JOB_BOARD_WAR_CACHE_TTL_MS=

# jobBoard.openMinIntervalMs - One `!board` per character per period. Range 0..60000. Default: 1000.
# EVEJS_LNE_JOB_BOARD_OPEN_MIN_INTERVAL_MS=

# jobBoard.reportMinIntervalMs - One LNE_BOARD_UI:PROBE log line per character per period (a Report inside it =
# RATE_LIMIT, the client sends it again later). Range 1000..3600000. Default: 60000.
# EVEJS_LNE_JOB_BOARD_REPORT_MIN_INTERVAL_MS=

# jobBoard.pinsEnabled - Accept / Drop of a front job in the window (a pin: tracking only, the payouts stay the same;
# only with jobBoard.enabled). true/false. Default: true.
# EVEJS_LNE_JOB_BOARD_PINS_ENABLED=

# jobBoard.maxPinsPerCharacter - Pins of one character (one more = PIN_LIMIT). Range 1..20. Default: 5.
# EVEJS_LNE_JOB_BOARD_MAX_PINS_PER_CHARACTER=

# jobBoard.pinPruneBatch - Expired pins of every character deleted by one Pin. Range 10..5000. Default: 200.
# EVEJS_LNE_JOB_BOARD_PIN_PRUNE_BATCH=

# jobBoard.mineWindowMs - Window of the recent rewards in the section Mine. Range 3600000..604800000. Default: 86400000.
# EVEJS_LNE_JOB_BOARD_MINE_WINDOW_MS=

# jobBoard.maxMineRows - Rows of the section Mine. Range 3..30. Default: 10.
# EVEJS_LNE_JOB_BOARD_MAX_MINE_ROWS=

# The sections Nearby (events and anomalies), Front, News.
# jobBoard.eventsEnabled - The section Nearby (off = no near rows, no source read). true/false. Default: true.
# EVEJS_LNE_JOB_BOARD_EVENTS_ENABLED=

# jobBoard.eventsNearbyJumps - Gate jumps of the section Nearby (at most jobBoard.nearbyMaxJumps). Range 1..20.
# Default: 8.
# EVEJS_LNE_JOB_BOARD_EVENTS_NEARBY_JUMPS=

# jobBoard.eventsMaxRows - Rows of the section Nearby (and the limit of each source read). Range 3..30. Default: 10.
# EVEJS_LNE_JOB_BOARD_EVENTS_MAX_ROWS=

# jobBoard.eventsRevealSignatures - Off = a scan signature shows its system, jumps, time and state only ("Unknown
# signature"). true/false. Default: false.
# EVEJS_LNE_JOB_BOARD_EVENTS_REVEAL_SIGNATURES=

# jobBoard.frontEnabled - The section Front (the `!front` text of the viewer system, also with frontChat.enabled
# off). true/false. Default: true.
# EVEJS_LNE_JOB_BOARD_FRONT_ENABLED=

# jobBoard.frontMaxLines - Lines of the section Front. Range 2..12. Default: 6.
# EVEJS_LNE_JOB_BOARD_FRONT_MAX_LINES=

# jobBoard.frontCacheTtlMs - Cache of the section Front per system (0 = no cache). Range 0..300000. Default: 30000.
# EVEJS_LNE_JOB_BOARD_FRONT_CACHE_TTL_MS=

# jobBoard.frontCacheSystems - Systems kept in the Front cache (LRU). Range 4..512. Default: 32.
# EVEJS_LNE_JOB_BOARD_FRONT_CACHE_SYSTEMS=

# jobBoard.newsEnabled - The section News (the headline of the newest edition; only with news.enabled). true/false.
# Default: true.
# EVEJS_LNE_JOB_BOARD_NEWS_ENABLED=

# jobBoard.newsMaxChars - Characters of the first paragraph in the section News. Range 100..1000. Default: 400.
# EVEJS_LNE_JOB_BOARD_NEWS_MAX_CHARS=

# jobBoard.newsCacheTtlMs - Cache of the News headline, shared by all players (0 = no cache). Range 0..600000.
# Default: 60000.
# EVEJS_LNE_JOB_BOARD_NEWS_CACHE_TTL_MS=

# (D-j2, D-j5): the board window at login (`!board auto on|off` per character
# the switch on the voice panel). Only with jobBoard.enabled.
# jobBoard.openAtLoginEnabled - One OnLneBoardOpen per new login of a character with `!board auto on` (opt-in per
# character). true/false. Default: true.
# EVEJS_LNE_JOB_BOARD_OPEN_AT_LOGIN_ENABLED=

# jobBoard.loginOpenDelayMs - Delay of the board window opened at login after the first call of the new client
# session. Range 0..30000. Default: 3000.
# EVEJS_LNE_JOB_BOARD_LOGIN_OPEN_DELAY_MS=

# The in-game settings panel of the mods = the
# override layer <EVEJS_DATA_ROOT>/mods/<mod>/settings.override.json (above the environment; works without the
# panel) and a read-only service. All keys internal: not in the launcher, never set from the panel or the override
# file, integers outside the range are clamped. EVEJS_MOD_SETTINGS_OVERRIDES_IGNORE=1 (no mod prefix) ignores the
# override files of every mod.
# the web panel <observer>/settings.html and `!settings` in Local (a one-time link for the
# characters of allowedCharacterIds; sessions in memory; the observer stays on 127.0.0.1).
# modSettings.enabled - Feature flag. true/false. Default: false (off = no modSettings service).
# EVEJS_LNE_MOD_SETTINGS_ENABLED=0

# modSettings.allowedCharacterIds - Characters allowed to use the panel: empty or a comma list of at most 32
# character IDs. Default: empty = nobody.
# EVEJS_LNE_MOD_SETTINGS_ALLOWED_CHARACTER_IDS=

# modSettings.mods - Mod folders the panel serves, a comma list of 1-32 names (a folder without a provider is listed
# read only). Default: livingNewEden,shipWing,EveJS-AdvancedUtilityDrones-1.0.3,hotPathPerf,scenePerfFix,
# npcKillsGiveSp,moonOreAnomalies,soloProgressionBalance,autopilotJumpZero,droneClassBalance,blueprintDrops,
# marketAllRegions,dailyGoalsPersist,industryOrphanCleanup,skyhookOrphanFix,customTypes,planetaryDrill,
# missionStructureRestore (the 18 folders of docker/entrypoint.sh).
# EVEJS_LNE_MOD_SETTINGS_MODS=

# modSettings.linkTtlMs - Lifetime of the one-time link token. Range 60000..3600000. Default: 600000.
# EVEJS_LNE_MOD_SETTINGS_LINK_TTL_MS=

# modSettings.sessionTtlMs - Idle lifetime of a panel session. Range 300000..86400000. Default: 3600000.
# EVEJS_LNE_MOD_SETTINGS_SESSION_TTL_MS=

# modSettings.maxSessions - Panel sessions (the oldest is evicted). Range 1..32. Default: 4.
# EVEJS_LNE_MOD_SETTINGS_MAX_SESSIONS=

# modSettings.cooldownMs - Cooldown of !settings per character. Range 0..60000. Default: 3000.
# EVEJS_LNE_MOD_SETTINGS_COOLDOWN_MS=

# modSettings.maxBodyBytes - Body of one panel request. Range 1024..65536. Default: 16384.
# EVEJS_LNE_MOD_SETTINGS_MAX_BODY_BYTES=

# modSettings.maxRowsPerPage - Rows of one describe page. Range 20..2000. Default: 200.
# EVEJS_LNE_MOD_SETTINGS_MAX_ROWS_PER_PAGE=

# modSettings.auditMaxBytes - Size of settings-audit.jsonl before its one rotation. Range 65536..67108864.
# Default: 1048576.
# EVEJS_LNE_MOD_SETTINGS_AUDIT_MAX_BYTES=

# modSettings.maxReplyChars - Characters of a chat reply. Range 200..4000. Default: 1000.
# EVEJS_LNE_MOD_SETTINGS_MAX_REPLY_CHARS=

# The board wrap (space/transitions.boardSpaceShip, FIRST_LOAD). Only the master
# enabled. All keys internal: not in the launcher, integers outside the range are clamped.
# capsuleSweep.enabled - Feature flag. true/false. Default: true (off at start = no wrap, vendor board as is).
# EVEJS_LNE_CAPSULE_SWEEP_ENABLED=

# capsuleSweep.resendRemoval - RemoveBalls of the consumed capsule to a pilot whose observer the vendor forgot during
# the board (alone in the system). true/false. Default: true (off = only the sweep of a leftover capsule).
# EVEJS_LNE_CAPSULE_SWEEP_RESEND_REMOVAL=

# capsuleSweep.logIntervalMs - At most one capsuleSweep: log line per period. Range 1000..3600000. Default: 60000.
# EVEJS_LNE_CAPSULE_SWEEP_LOG_INTERVAL_MS=

# The post-hook of beyonceService Handle_CmdWarpToStuff (a warp to a coordinate
# bookmark materializes the nearest universe site). Only the master enabled. All keys internal: not in the launcher,
# integers outside the range are clamped.
# bookmarkSiteWarp.enabled - Feature flag. true/false. Default: true (off at start = no wrap, vendor warp as is).
# EVEJS_LNE_BOOKMARK_SITE_WARP_ENABLED=

# bookmarkSiteWarp.rangeMeters - Radius around the bookmark in which the nearest universe site is materialized.
# Range 1000..1000000. Default: 300000.
# EVEJS_LNE_BOOKMARK_SITE_WARP_RANGE_METERS=

# bookmarkSiteWarp.logIntervalMs - At most one bookmarkSiteWarp: log line per period. Range 1000..3600000.
# Default: 60000.
# EVEJS_LNE_BOOKMARK_SITE_WARP_LOG_INTERVAL_MS=

# The daily front job board (KILL jobs from the fronts, payout plan PENDING
# needs modules.world and occupation.enabled). All keys internal: not in the launcher, values outside the range are
# clamped.
# frontJobs.enabled - Feature flag. true/false. Default: false (turn on after a try in the client).
# EVEJS_LNE_FRONT_JOBS_ENABLED=

# frontJobs.passIntervalMs - Period of the pass (expire, board). Range 5000..3600000. Default: 60000.
# EVEJS_LNE_FRONT_JOBS_PASS_INTERVAL_MS=

# frontJobs.resetHourUtc - Start hour (UTC) of the board day. Range 0..23. Default: 11.
# EVEJS_LNE_FRONT_JOBS_RESET_HOUR_UTC=

# frontJobs.jobsPerDay - Jobs of one board. Range 1..10. Default: 4.
# EVEJS_LNE_FRONT_JOBS_JOBS_PER_DAY=

# frontJobs.frontScanLimit - Most front rows read by one board generation. Range 10..2000. Default: 200.
# EVEJS_LNE_FRONT_JOBS_FRONT_SCAN_LIMIT=

# frontJobs.empireIssuerWeight - Draw weight of an issuer with an LP corporation (others 1). Range 1..10. Default: 3.
# EVEJS_LNE_FRONT_JOBS_EMPIRE_ISSUER_WEIGHT=

# frontJobs.killTarget - Rats of a KILL job. Range 1..100. Default: 10.
# EVEJS_LNE_FRONT_JOBS_KILL_TARGET=

# frontJobs.maxCompletionsPerJob - Characters that can complete one job. Range 1..50. Default: 3.
# EVEJS_LNE_FRONT_JOBS_MAX_COMPLETIONS_PER_JOB=

# frontJobs.maxCompletionsPerCharacterDay - Completions of one character per board day. Range 1..20. Default: 5.
# EVEJS_LNE_FRONT_JOBS_MAX_COMPLETIONS_PER_CHARACTER_DAY=

# frontJobs.maxExpirePerPass - Jobs expired in one pass. Range 1..1000. Default: 50.
# EVEJS_LNE_FRONT_JOBS_MAX_EXPIRE_PER_PASS=

# frontJobs.killIsk - ISK reward of a KILL job. Range 0..1000000000. Default: 2000000.
# EVEJS_LNE_FRONT_JOBS_KILL_ISK=

# frontJobs.killLp - LP reward of a KILL job (issuer with an LP corporation only). Range 0..100000. Default: 500.
# EVEJS_LNE_FRONT_JOBS_KILL_LP=

# frontJobs.standingRaw - Raw standing plus at the issuer (scale of standings.navyKillRaw). Range 0..0.1. Default: 0.005.
# EVEJS_LNE_FRONT_JOBS_STANDING_RAW=

# frontJobs.retentionMs - Age of the jobs pruned. Range 86400000..7776000000. Default: 604800000.
# EVEJS_LNE_FRONT_JOBS_RETENTION_MS=

# frontJobs.payoutEnabled - Wallet and standing legs of the payout pump. true/false. Default: true (works only
# with frontJobs.enabled; off = the payout rows wait PENDING, the prune still runs).
# EVEJS_LNE_FRONT_JOBS_PAYOUT_ENABLED=

# frontJobs.payoutMaxPerPass - Payout rows of one pass. Range 1..200. Default: 10.
# EVEJS_LNE_FRONT_JOBS_PAYOUT_MAX_PER_PASS=

# frontJobs.payoutMaxAttempts - Transient failures before the PENDING legs fail. Range 1..50. Default: 8.
# EVEJS_LNE_FRONT_JOBS_PAYOUT_MAX_ATTEMPTS=

# frontJobs.payoutRetryBaseMs - First backoff of a transient failure (doubles per attempt). Range 1000..3600000.
# Default: 60000.
# EVEJS_LNE_FRONT_JOBS_PAYOUT_RETRY_BASE_MS=

# frontJobs.payoutRetryMaxMs - Cap of the backoff. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_FRONT_JOBS_PAYOUT_RETRY_MAX_MS=

# frontJobs.payoutRetentionMs - Age (updated_at) of the closed payout rows pruned. Range 86400000..31536000000.
# Default: 2592000000.
# EVEJS_LNE_FRONT_JOBS_PAYOUT_RETENTION_MS=

# frontJobs.prunePerPass - Rows of each prune kind deleted in one pass. Range 1..5000. Default: 200.
# EVEJS_LNE_FRONT_JOBS_PRUNE_PER_PASS=

# frontJobs.chatEnabled - The!zlecenia /!jobs command in local chat. true/false. Default: true (works only
# with frontJobs.enabled; off = plain chat text).
# EVEJS_LNE_FRONT_JOBS_CHAT_ENABLED=

# frontJobs.chatMinIntervalMs - Cooldown of !zlecenia per character. Range 1000..600000. Default: 10000.
# EVEJS_LNE_FRONT_JOBS_CHAT_MIN_INTERVAL_MS=

# frontJobs.chatMaxChars - Characters of a !zlecenia reply (separators count). Range 200..4000. Default: 900.
# EVEJS_LNE_FRONT_JOBS_CHAT_MAX_CHARS=

# frontJobs.boardMailEnabled - One mail line of a new board to the online characters (needs notices.enabled).
# true/false. Default: true.
# EVEJS_LNE_FRONT_JOBS_BOARD_MAIL_ENABLED=

# frontJobs.maxBoardMailRecipients - Online characters that get the board line. Range 1..500. Default: 50.
# EVEJS_LNE_FRONT_JOBS_MAX_BOARD_MAIL_RECIPIENTS=

# frontJobs.doneMailEnabled - One mail line per completed job (needs notices.enabled). true/false. Default: true.
# EVEJS_LNE_FRONT_JOBS_DONE_MAIL_ENABLED=

# Job kinds CLEAR (an Event Director site) and DELIVER (a public WTB contract).
# frontJobs.clearEnabled - CLEAR jobs. true/false. Default: false.
# EVEJS_LNE_FRONT_JOBS_CLEAR_ENABLED=

# frontJobs.maxClearPerDay - CLEAR jobs of one board. Range 0..5. Default: 1.
# EVEJS_LNE_FRONT_JOBS_MAX_CLEAR_PER_DAY=

# frontJobs.clearMinKills - Kills in the system for a CLEAR completion. Range 1..50. Default: 1.
# EVEJS_LNE_FRONT_JOBS_CLEAR_MIN_KILLS=

# frontJobs.clearMaxCompletions - Characters rewarded by one CLEAR job. Range 1..20. Default: 3.
# EVEJS_LNE_FRONT_JOBS_CLEAR_MAX_COMPLETIONS=

# frontJobs.clearIsk - ISK reward of a CLEAR job. Range 0..1000000000. Default: 4000000.
# EVEJS_LNE_FRONT_JOBS_CLEAR_ISK=

# frontJobs.clearLp - LP reward of a CLEAR job (issuer with LP only). Range 0..100000. Default: 1000.
# EVEJS_LNE_FRONT_JOBS_CLEAR_LP=

# frontJobs.clearSiteScanLimit - Visible site rows read per front system. Range 1..64. Default: 8.
# EVEJS_LNE_FRONT_JOBS_CLEAR_SITE_SCAN_LIMIT=

# frontJobs.deliverEnabled - DELIVER jobs. true/false. Default: false.
# EVEJS_LNE_FRONT_JOBS_DELIVER_ENABLED=

# frontJobs.maxDeliverPerDay - DELIVER jobs of one board. Range 0..5. Default: 1.
# EVEJS_LNE_FRONT_JOBS_MAX_DELIVER_PER_DAY=

# frontJobs.deliverScanLimit - Open offers read per issuer. Range 1..200. Default: 20.
# EVEJS_LNE_FRONT_JOBS_DELIVER_SCAN_LIMIT=

# frontJobs.deliverIsk - ISK bonus of a DELIVER job. Range 0..1000000000. Default: 1500000.
# EVEJS_LNE_FRONT_JOBS_DELIVER_ISK=

# frontJobs.deliverLp - LP reward of a DELIVER job (issuer with LP only). Range 0..100000. Default: 400.
# EVEJS_LNE_FRONT_JOBS_DELIVER_LP=

# frontJobs.refChecksPerPass - OPEN CLEAR / DELIVER jobs settled in one pass. Range 1..200. Default: 20.
# EVEJS_LNE_FRONT_JOBS_REF_CHECKS_PER_PASS=

# frontJobs.scanEnabled - SCAN jobs (perfect probe scan of a signature). true/false. Default: false.
# EVEJS_LNE_FRONT_JOBS_SCAN_ENABLED=

# frontJobs.maxScanPerDay - SCAN jobs of one board. Range 0..5. Default: 1.
# EVEJS_LNE_FRONT_JOBS_MAX_SCAN_PER_DAY=

# frontJobs.scanMaxCompletions - Characters rewarded by one SCAN job. Range 1..20. Default: 3.
# EVEJS_LNE_FRONT_JOBS_SCAN_MAX_COMPLETIONS=

# frontJobs.scanIsk - ISK reward of a SCAN job. Range 0..1000000000. Default: 1500000.
# EVEJS_LNE_FRONT_JOBS_SCAN_ISK=

# frontJobs.scanLp - LP reward of a SCAN job (issuer with LP only). Range 0..100000. Default: 400.
# EVEJS_LNE_FRONT_JOBS_SCAN_LP=

# ESCORT jobs - escort a faction convoy crossing the system of a player.
# frontJobs.escortEnabled - ESCORT jobs (needs fleetExposure.enabled and convoysEnabled). true/false. Default: false.
# EVEJS_LNE_FRONT_JOBS_ESCORT_ENABLED=

# frontJobs.maxEscortPerDay - ESCORT jobs of one board. Range 0..5. Default: 1.
# EVEJS_LNE_FRONT_JOBS_MAX_ESCORT_PER_DAY=

# frontJobs.escortTarget - Escorted convoy crossings of one character for an ESCORT job. Range 1..50. Default: 3.
# EVEJS_LNE_FRONT_JOBS_ESCORT_TARGET=

# frontJobs.escortMaxCompletions - Characters rewarded by one ESCORT job. Range 1..20. Default: 3.
# EVEJS_LNE_FRONT_JOBS_ESCORT_MAX_COMPLETIONS=

# frontJobs.escortIsk - ISK reward of an ESCORT job. Range 0..1000000000. Default: 1500000.
# EVEJS_LNE_FRONT_JOBS_ESCORT_ISK=

# frontJobs.escortLp - LP reward of an ESCORT job (issuer with LP only). Range 0..100000. Default: 400.
# EVEJS_LNE_FRONT_JOBS_ESCORT_LP=

# War contracts over the mobilization WTB offers of the LNE trade (offer
# id "to_"): LP / standing / ISK reward frozen at the adoption, recorded for the acceptor (payout legs PENDING; needs
# modules.world). All keys internal: not in the launcher, values outside the range are clamped.
# warContracts.enabled - Feature flag. true/false. Default: false. compose.yaml sets 1; set 0 in the
# root .env to turn it off in Docker.
# EVEJS_LNE_WAR_CONTRACTS_ENABLED=

# warContracts.passIntervalMs - Period of the pass (adopt, settle). Range 5000..3600000. Default: 60000.
# EVEJS_LNE_WAR_CONTRACTS_PASS_INTERVAL_MS=

# warContracts.factionsPerPass - Factions with a trade budget scanned in one pass. Range 1..64. Default: 8.
# EVEJS_LNE_WAR_CONTRACTS_FACTIONS_PER_PASS=

# warContracts.offerScanLimit - Open offers read per faction. Range 1..200. Default: 32.
# EVEJS_LNE_WAR_CONTRACTS_OFFER_SCAN_LIMIT=

# warContracts.maxAdoptPerPass - New war contract rows in one pass. Range 1..200. Default: 16.
# EVEJS_LNE_WAR_CONTRACTS_MAX_ADOPT_PER_PASS=

# warContracts.settlePerPass - OPEN rows checked in one pass. Range 1..500. Default: 32.
# EVEJS_LNE_WAR_CONTRACTS_SETTLE_PER_PASS=

# warContracts.includePrivate - Private offers (assignee) are war contracts too. true/false. Default: true.
# EVEJS_LNE_WAR_CONTRACTS_INCLUDE_PRIVATE=

# warContracts.hullsOnly - Only hull offers are war contracts. true/false. Default: false.
# EVEJS_LNE_WAR_CONTRACTS_HULLS_ONLY=

# warContracts.lpPerMillionIsk - LP per 1 million ISK of the offer value. Range 0..10000. Default: 30.
# EVEJS_LNE_WAR_CONTRACTS_LP_PER_MILLION_ISK=

# warContracts.lpMin - Lower bound of the LP reward. Range 0..100000. Default: 200.
# EVEJS_LNE_WAR_CONTRACTS_LP_MIN=

# warContracts.lpMax - Upper bound of the LP reward. Range 0..1000000. Default: 10000.
# EVEJS_LNE_WAR_CONTRACTS_LP_MAX=

# warContracts.standingRaw - Raw standing per war contract. Range 0..0.1. Default: 0.01.
# EVEJS_LNE_WAR_CONTRACTS_STANDING_RAW=

# warContracts.iskBonusPermille - ISK bonus above the contract price (an ISK faucet). Range 0..1000. Default: 0.
# EVEJS_LNE_WAR_CONTRACTS_ISK_BONUS_PERMILLE=

# warContracts.maxAwardsPerCharacterDay - Rewards of one character in the rolling window. Range 1..100. Default: 10.
# EVEJS_LNE_WAR_CONTRACTS_MAX_AWARDS_PER_CHARACTER_DAY=

# warContracts.awardWindowMs - Rolling window of the character cap. Range 3600000..604800000. Default: 86400000.
# EVEJS_LNE_WAR_CONTRACTS_AWARD_WINDOW_MS=

# warContracts.payoutEnabled - the ISK / LP / standing legs of the
# AWARDED rows (shared frontJobs payout pump); off = the rows wait PENDING, the prune still runs. Default: true.
# EVEJS_LNE_WAR_CONTRACTS_PAYOUT_ENABLED=

# warContracts.payoutMaxPerPass - Payout rows of one pump pass. Range 1..100. Default: 10.
# EVEJS_LNE_WAR_CONTRACTS_PAYOUT_MAX_PER_PASS=

# warContracts.payoutMaxAttempts - Transient failures of a leg before FAILED. Range 1..50. Default: 8.
# EVEJS_LNE_WAR_CONTRACTS_PAYOUT_MAX_ATTEMPTS=

# warContracts.payoutRetryBaseMs - Base of the retry backoff (doubles per attempt). Range 1000..3600000. Default: 60000.
# EVEJS_LNE_WAR_CONTRACTS_PAYOUT_RETRY_BASE_MS=

# warContracts.payoutRetryMaxMs - Cap of the retry backoff. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_WAR_CONTRACTS_PAYOUT_RETRY_MAX_MS=

# warContracts.retentionMs - A terminal row is pruned this long after ended_at. Range 86400000..31536000000.
# Default: 2592000000.
# EVEJS_LNE_WAR_CONTRACTS_RETENTION_MS=

# warContracts.prunePerPass - Rows deleted by one prune step. Range 1..5000. Default: 200.
# EVEJS_LNE_WAR_CONTRACTS_PRUNE_PER_PASS=

# warContracts.chatEnabled - the `!kontrakty` / `!war` command in
# local chat (open war contracts, your region first). true/false. Default: true.
# EVEJS_LNE_WAR_CONTRACTS_CHAT_ENABLED=

# warContracts.chatMinIntervalMs - Cooldown of `!war` per character. Range 1000..600000. Default: 10000.
# EVEJS_LNE_WAR_CONTRACTS_CHAT_MIN_INTERVAL_MS=

# warContracts.chatMaxLines - Contract lines of one `!war` reply. Range 1..20. Default: 6.
# EVEJS_LNE_WAR_CONTRACTS_CHAT_MAX_LINES=

# warContracts.chatMaxChars - Characters of one `!war` reply. Range 200..4000. Default: 900.
# EVEJS_LNE_WAR_CONTRACTS_CHAT_MAX_CHARS=

# warContracts.chatFrontScan - Occupied systems read for the "front:" of a `!war` line. Range 1..64. Default: 16.
# EVEJS_LNE_WAR_CONTRACTS_CHAT_FRONT_SCAN=

# warContracts.awardMailEnabled - Mail of a reward (what was delivered, the reward, the station stock). true/false.
# Default: true.
# EVEJS_LNE_WAR_CONTRACTS_AWARD_MAIL_ENABLED=

# warContracts.announceMailEnabled - One mail line per online character with the new war contracts of its region.
# true/false. Default: false.
# EVEJS_LNE_WAR_CONTRACTS_ANNOUNCE_MAIL_ENABLED=

# warContracts.announceMaxRecipients - Characters of one announcement pass. Range 1..500. Default: 50.
# EVEJS_LNE_WAR_CONTRACTS_ANNOUNCE_MAX_RECIPIENTS=

# warContracts.adoptLateMs - offers accepted at most this long ago are adopted late (0 = off). Must be
# <= warContracts.retentionMs / 2 (config error). Range 0..15768000000. Default: 86400000.
# EVEJS_LNE_WAR_CONTRACTS_ADOPT_LATE_MS=

# The observer panel war-contracts.
# warContracts.viewEnabled - The panel (under warContracts.enabled). true/false. Default: true.
# EVEJS_LNE_WAR_CONTRACTS_VIEW_ENABLED=

# warContracts.viewRows - Rows of each list of the panel (open, recent). Range 1..200. Default: 50.
# EVEJS_LNE_WAR_CONTRACTS_VIEW_ROWS=

# warContracts.viewSumWindowMs - Window of the faction sums and the FAILED payouts. Range 3600000..2592000000.
# Default: 604800000.
# EVEJS_LNE_WAR_CONTRACTS_VIEW_SUM_WINDOW_MS=

# The killboard read model of the settled LNE battles (tables kb_*, observer view
# kb-battles; needs modules.world). All keys internal: not in the launcher, values outside the range are clamped.
# killboard.enabled - Feature flag. true/false. Default: false (off = no poller, no view, no row in kb_*).
# EVEJS_LNE_KILLBOARD_ENABLED=

# killboard.passMs - Period of the projector pass. Range 5000..600000. Default: 30000.
# EVEJS_LNE_KILLBOARD_PASS_MS=

# killboard.maxBattlesPerPass - New battles per pass. Range 1..500. Default: 50.
# EVEJS_LNE_KILLBOARD_MAX_BATTLES_PER_PASS=

# killboard.maxScanRowsPerPass - Settled battles scanned per pass. Range 50..10000. Default: 1000.
# EVEJS_LNE_KILLBOARD_MAX_SCAN_ROWS_PER_PASS=

# killboard.maxPassMs - Time of the write loop, checked per battle. Range 5..200. Default: 25.
# EVEJS_LNE_KILLBOARD_MAX_PASS_MS=

# killboard.battleOverlapMs - Window below the cursor scanned again. Range 0..86400000. Default: 900000.
# EVEJS_LNE_KILLBOARD_BATTLE_OVERLAP_MS=

# killboard.battleBackfillMs - History read at the first pass (0 = all). Range 0..31536000000. Default: 2592000000.
# EVEJS_LNE_KILLBOARD_BATTLE_BACKFILL_MS=

# killboard.maxPriceTypesPerPass - Item types priced per pass. Range 1..1024. Default: 128.
# EVEJS_LNE_KILLBOARD_MAX_PRICE_TYPES_PER_PASS=

# killboard.maxBattleRows - Rows of kb_battles kept (oldest pruned). Range 1000..1000000. Default: 100000.
# EVEJS_LNE_KILLBOARD_MAX_BATTLE_ROWS=

# killboard.pruneBatch - Battles pruned per pass at most. Range 1..1000. Default: 200.
# EVEJS_LNE_KILLBOARD_PRUNE_BATCH=

# killboard.pageRows - Rows of one page of the view kb-battles. Range 10..200. Default: 50.
# EVEJS_LNE_KILLBOARD_PAGE_ROWS=

# The vendor killmails of the players (kb_kills, views kb-kills / kb-kill
# kb-character). Needs killboard.enabled.
# killboard.killmailsEnabled - Feature flag. true/false. Default: false (off = no vendor read, no row in kb_kills).
# EVEJS_LNE_KILLBOARD_KILLMAILS_ENABLED=

# killboard.maxKillsPerPass - Vendor killIDs examined per pass. Range 1..500. Default: 200.
# EVEJS_LNE_KILLBOARD_MAX_KILLS_PER_PASS=

# killboard.killMinAgeMs - A kill younger than this waits. Range 0..600000. Default: 10000.
# EVEJS_LNE_KILLBOARD_KILL_MIN_AGE_MS=

# killboard.killHoleLookahead - KillIDs looked at after a missing one. Range 1..256. Default: 16.
# EVEJS_LNE_KILLBOARD_KILL_HOLE_LOOKAHEAD=

# killboard.killBackfillMs - Kills older than this are skipped (0 = all). Range 0..31536000000. Default: 2592000000.
# EVEJS_LNE_KILLBOARD_KILL_BACKFILL_MS=

# killboard.includeNpcVictims - NPC victims killed by a player go in too (class PVE). true/false. Default: false.
# EVEJS_LNE_KILLBOARD_INCLUDE_NPC_VICTIMS=

# killboard.maxKillRows - Rows of kb_kills kept (oldest pruned). Range 1000..1000000. Default: 100000.
# EVEJS_LNE_KILLBOARD_MAX_KILL_ROWS=

# killboard.maxAttackersStored - Attackers stored per kill. Range 1..50. Default: 10.
# EVEJS_LNE_KILLBOARD_MAX_ATTACKERS_STORED=

# killboard.maxNamesPerPass - Unknown names / item types resolved per pass. Range 1..512. Default: 64.
# EVEJS_LNE_KILLBOARD_MAX_NAMES_PER_PASS=

# killboard.resetKills - exit of VENDOR_REWOUND. true/false. Default: false. true = a cursor in
# VENDOR_REWOUND is reset once (kb_kills, kb_kill_chars, kb_char_totals and the cursor 'kills' wiped, then a read from
# killID 1 with killBackfillMs); set back to false after the log line "reset of the kill source done".
# EVEJS_LNE_KILLBOARD_RESET_KILLS=

# killboard.pendingMaxAgeMs - a vendor pending killmail older than this, with a record after
# it, is skipped (killsSkippedStalePending). Range 60000..604800000. Default: 3600000.
# EVEJS_LNE_KILLBOARD_PENDING_MAX_AGE_MS=

# killboard.relatedKillsMax - capsuleer kills shown on the battle page (kills in the system in the
# battle window). Range 0..100 (0 = off). Default: 20.
# EVEJS_LNE_KILLBOARD_RELATED_KILLS_MAX=

# killboard.relatedKillSlackMs - slack around the battle window [created_at, settled_at] for its
# related kills. Range 0..3600000. Default: 300000.
# EVEJS_LNE_KILLBOARD_RELATED_KILL_SLACK_MS=

# killboard.relatedScanRows - battles of the system scanned (newest first) for the battles of a kill.
# Range 10..2000. Default: 200.
# EVEJS_LNE_KILLBOARD_RELATED_SCAN_ROWS=

# The mil/ind/trade development indices of the systems (table
# world_system_dev, chat !dev, observer layer-dev and panel dev-indices; inputs from the killboard; needs
# modules.world). All keys internal: not in the launcher, values outside the range are clamped.
# devIndices.enabled - Feature flag. true/false. Default: false (off = no timer, no read, no write).
# EVEJS_LNE_DEV_INDICES_ENABLED=

# devIndices.secClassesCsv - Security classes with indices. highsec|lowsec|nullsec|wormhole|other list.
# Default: highsec,lowsec,nullsec.
# EVEJS_LNE_DEV_INDICES_SEC_CLASSES_CSV=

# devIndices.maxPoints - Points ceiling of one index. Range 1000..1000000. Default: 6000.
# EVEJS_LNE_DEV_INDICES_MAX_POINTS=

# devIndices.levelWidth - Points of one level (0..5). Range 100..200000. Default: 1000.
# EVEJS_LNE_DEV_INDICES_LEVEL_WIDTH=

# devIndices.decayPointsPerHour - Points lost per hour and index. Range 1..1000. Default: 5.
# EVEJS_LNE_DEV_INDICES_DECAY_POINTS_PER_HOUR=

# devIndices.contestedDecayPermille - Decay multiplier in a contested system. Range 1000..10000. Default: 3000.
# EVEJS_LNE_DEV_INDICES_CONTESTED_DECAY_PERMILLE=

# devIndices.maxDecayGapMs - Longest decay gap counted at once. Range 3600000..604800000. Default: 86400000.
# EVEJS_LNE_DEV_INDICES_MAX_DECAY_GAP_MS=

# devIndices.captureLossMilPermille - Military points lost on a controller change. Range 0..1000. Default: 500.
# EVEJS_LNE_DEV_INDICES_CAPTURE_LOSS_MIL_PERMILLE=

# devIndices.captureLossIndPermille - Industry points lost on a controller change. Range 0..1000. Default: 300.
# EVEJS_LNE_DEV_INDICES_CAPTURE_LOSS_IND_PERMILLE=

# devIndices.captureLossTradePermille - Trade points lost on a controller change. Range 0..1000. Default: 500.
# EVEJS_LNE_DEV_INDICES_CAPTURE_LOSS_TRADE_PERMILLE=

# devIndices.trendWindowMs - A trend fades after this without input. Range 600000..604800000. Default: 86400000.
# EVEJS_LNE_DEV_INDICES_TREND_WINDOW_MS=

# devIndices.sweepIntervalMs - Period of the sweep pass. Range 60000..3600000. Default: 600000.
# EVEJS_LNE_DEV_INDICES_SWEEP_INTERVAL_MS=

# devIndices.sourcePageRows - Facts read per source and pass. Range 10..1000. Default: 200.
# EVEJS_LNE_DEV_INDICES_SOURCE_PAGE_ROWS=

# devIndices.maxSystemsPerPass - Systems written per sweep pass. Range 1..1000. Default: 100.
# EVEJS_LNE_DEV_INDICES_MAX_SYSTEMS_PER_PASS=

# devIndices.refreshRowsPerPass - Rows refreshed per pass. Range 1..1000. Default: 200.
# EVEJS_LNE_DEV_INDICES_REFRESH_ROWS_PER_PASS=

# devIndices.refreshMinAgeMs - A row is refreshed when its anchor is older. Range 600000..86400000. Default: 3600000.
# EVEJS_LNE_DEV_INDICES_REFRESH_MIN_AGE_MS=

# devIndices.maxTrackedSystems - Rows of the RAM index. Range 100..20000. Default: 10000.
# EVEJS_LNE_DEV_INDICES_MAX_TRACKED_SYSTEMS=

# devIndices.indexPageRows - Rows per page of the warm load. Range 50..2000. Default: 500.
# EVEJS_LNE_DEV_INDICES_INDEX_PAGE_ROWS=

# devIndices.bootstrapLookbackMs - A new cursor starts this far back (0 = now). Range 0..2592000000.
# Default: 86400000.
# EVEJS_LNE_DEV_INDICES_BOOTSTRAP_LOOKBACK_MS=

# devIndices.battleWinMilPoints - Military points of a won battle of the controller. Range 0..1000. Default: 40.
# EVEJS_LNE_DEV_INDICES_BATTLE_WIN_MIL_POINTS=

# devIndices.battleLossMilPoints - Military points lost for a lost battle. Range 0..1000. Default: 60.
# EVEJS_LNE_DEV_INDICES_BATTLE_LOSS_MIL_POINTS=

# devIndices.battleLossTradePoints - Trade points lost for a lost battle. Range 0..1000. Default: 30.
# EVEJS_LNE_DEV_INDICES_BATTLE_LOSS_TRADE_POINTS=

# devIndices.battleNearbyTradePoints - Trade points lost for a battle without the controller. Range 0..1000.
# Default: 10.
# EVEJS_LNE_DEV_INDICES_BATTLE_NEARBY_TRADE_POINTS=

# devIndices.ratKillMilPoints - Military points of a PVE kill by a player. Range 0..100. Default: 4.
# EVEJS_LNE_DEV_INDICES_RAT_KILL_MIL_POINTS=

# devIndices.killPointsCapPerHour - Kill points per system and hour at most. Range 0..10000. Default: 200.
# EVEJS_LNE_DEV_INDICES_KILL_POINTS_CAP_PER_HOUR=

# devIndices.commandEnabled - The chat command !dev. true/false. Default: true.
# EVEJS_LNE_DEV_INDICES_COMMAND_ENABLED=

# devIndices.commandCooldownMs - One !dev per character in this window. Range 1000..600000. Default: 10000.
# EVEJS_LNE_DEV_INDICES_COMMAND_COOLDOWN_MS=

# devIndices.observerLayerEnabled - The map layer layer-dev (needs observer.galaxyEnabled). true/false.
# Default: true.
# EVEJS_LNE_DEV_INDICES_OBSERVER_LAYER_ENABLED=

# devIndices.layerMinLevel - Least level of a system on the map layer. Range 1..5. Default: 2.
# EVEJS_LNE_DEV_INDICES_LAYER_MIN_LEVEL=

# devIndices.layerMaxItems - Systems on the map layer at most. Range 10..5000. Default: 500.
# EVEJS_LNE_DEV_INDICES_LAYER_MAX_ITEMS=

# devIndices.panelTopRows - Systems per index on the panel dev-indices. Range 1..50. Default: 10.
# EVEJS_LNE_DEV_INDICES_PANEL_TOP_ROWS=

# economy facts (mining trips, production jobs, convoys, player deliveries) and the
# !invest ISK investment of a player (a sink: the ISK leaves the wallet, no refund).
# devIndices.sourceLagMs - An economy fact is read only when it ended at least this long ago (W99). Range 0..86400000.
# Default: 600000.
# EVEJS_LNE_DEV_INDICES_SOURCE_LAG_MS=

# devIndices.miningTripIndPoints - Industry points of a delivered mining trip. Range 0..1000. Default: 10.
# EVEJS_LNE_DEV_INDICES_MINING_TRIP_IND_POINTS=

# devIndices.productionJobIndPoints - Industry points of a delivered production job. Range 0..1000. Default: 15.
# EVEJS_LNE_DEV_INDICES_PRODUCTION_JOB_IND_POINTS=

# devIndices.convoyTradePoints - Trade points of a delivered convoy. Range 0..1000. Default: 20.
# EVEJS_LNE_DEV_INDICES_CONVOY_TRADE_POINTS=

# devIndices.tradeDeliveryIskPerPoint - ISK of a player delivery per trade point. Range 1..1000000000000.
# Default: 1000000.
# EVEJS_LNE_DEV_INDICES_TRADE_DELIVERY_ISK_PER_POINT=

# devIndices.tradeDeliveryMaxPoints - Trade points of one player delivery at most. Range 1..1000. Default: 50.
# EVEJS_LNE_DEV_INDICES_TRADE_DELIVERY_MAX_POINTS=

# devIndices.tradeDeliveryIndPoints - Industry points of one player delivery. Range 0..1000. Default: 10.
# EVEJS_LNE_DEV_INDICES_TRADE_DELIVERY_IND_POINTS=

# devIndices.investEnabled - The chat command !invest (only with devIndices.enabled). Default: false.
# EVEJS_LNE_DEV_INDICES_INVEST_ENABLED=

# devIndices.investIskPerPoint - ISK per point of an investment. Range 1..1000000000. Default: 50000.
# EVEJS_LNE_DEV_INDICES_INVEST_ISK_PER_POINT=

# devIndices.investMinIsk - Least ISK of one investment. Range 1..1000000000000. Default: 1000000.
# EVEJS_LNE_DEV_INDICES_INVEST_MIN_ISK=

# devIndices.investMaxIskPerCommand - Most ISK of one investment. Range 1..1000000000000. Default: 100000000.
# EVEJS_LNE_DEV_INDICES_INVEST_MAX_ISK_PER_COMMAND=

# devIndices.investMaxIskPerCharacterPerDay - Most ISK of one character in 24 h. Range 1..1000000000000000.
# Default: 500000000.
# EVEJS_LNE_DEV_INDICES_INVEST_MAX_ISK_PER_CHARACTER_PER_DAY=

# devIndices.investMaxPointsPerSystemPerDay - Most invested points of one system in 24 h. Range 1..1000000.
# Default: 2000.
# EVEJS_LNE_DEV_INDICES_INVEST_MAX_POINTS_PER_SYSTEM_PER_DAY=

# devIndices.investConfirmMs - A request waits this long for !invest yes. Range 10000..600000. Default: 60000.
# EVEJS_LNE_DEV_INDICES_INVEST_CONFIRM_MS=

# devIndices.investRetryMs - First backoff after a transient wallet refusal. Range 1000..3600000. Default: 60000.
# EVEJS_LNE_DEV_INDICES_INVEST_RETRY_MS=

# devIndices.investRetryMaxMs - Longest backoff of a pending investment. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_DEV_INDICES_INVEST_RETRY_MAX_MS=

# devIndices.investPassRows - Pending investments resumed per pass. Range 1..500. Default: 20.
# EVEJS_LNE_DEV_INDICES_INVEST_PASS_ROWS=

# devIndices.investRetentionMs - Applied / refused investments are deleted after this long.
# Range 86400000..31536000000. Default: 2592000000.
# EVEJS_LNE_DEV_INDICES_INVEST_RETENTION_MS=

# devIndices.investPruneBatch - Investments deleted per pass at most (W96). Range 1..1000. Default: 200.
# EVEJS_LNE_DEV_INDICES_INVEST_PRUNE_BATCH=

# The effects of the indices, each behind its own flag (off).
# devIndices.garrisonEnabled - The controller gets mil level x garrisonPointsPerLevel garrison in a battle. Default: false.
# EVEJS_LNE_DEV_INDICES_GARRISON_ENABLED=

# devIndices.garrisonPointsPerLevel - Garrison points per mil level. Range 0..400. Default: 20.
# EVEJS_LNE_DEV_INDICES_GARRISON_POINTS_PER_LEVEL=

# devIndices.tradeDiscountEnabled - Faction WTS cheaper by trade level (never at / below the own WTB). Default: false.
# EVEJS_LNE_DEV_INDICES_TRADE_DISCOUNT_ENABLED=

# devIndices.tradeDiscountPermillePerLevel - WTS discount per trade level. Range 0..100. Default: 8.
# EVEJS_LNE_DEV_INDICES_TRADE_DISCOUNT_PERMILLE_PER_LEVEL=

# devIndices.tradeDiscountMaxPermille - Largest WTS discount (W98). Range 0..500. Default: 40.
# EVEJS_LNE_DEV_INDICES_TRADE_DISCOUNT_MAX_PERMILLE=

# devIndices.gmHintEnabled - Hint source devIndices of the Game Master (collapse / boom). Default: false.
# EVEJS_LNE_DEV_INDICES_GM_HINT_ENABLED=

# The anomalies of developed systems (Event Director types).
# devIndices.anomaliesEnabled - DEVELOPED ore / combat anomalies (needs modules.events + modules.sites, W100). Default: false.
# EVEJS_LNE_DEV_INDICES_ANOMALIES_ENABLED=

# devIndices.anomalyMinLevel - ind / mil level that gives a DEVELOPED cause. Range 1..5. Default: 3.
# EVEJS_LNE_DEV_INDICES_ANOMALY_MIN_LEVEL=

# devIndices.anomalyMaxOpen - Open DEVELOPED anomalies in the world (0 = no new one). Range 0..20. Default: 2.
# EVEJS_LNE_DEV_INDICES_ANOMALY_MAX_OPEN=

# devIndices.anomalyCandidateRows - listTop limit per index of one pulse. Range 1..64. Default: 8.
# EVEJS_LNE_DEV_INDICES_ANOMALY_CANDIDATE_ROWS=

# devIndices.anomalyOreWeight - Weight of the developed ore types (0 = left out). Range 0..100. Default: 2.
# EVEJS_LNE_DEV_INDICES_ANOMALY_ORE_WEIGHT=

# devIndices.anomalyRatsWeight - Weight of the developed combat types (0 = left out). Range 0..100. Default: 2.
# EVEJS_LNE_DEV_INDICES_ANOMALY_RATS_WEIGHT=

# devIndices.anomalyOreDurationMs - Life of a developed ore anomaly. Range 600000..172800000. Default: 86400000.
# EVEJS_LNE_DEV_INDICES_ANOMALY_ORE_DURATION_MS=

# devIndices.anomalyRatsDurationMs - Life of a developed combat anomaly. Range 600000..86400000. Default: 14400000.
# EVEJS_LNE_DEV_INDICES_ANOMALY_RATS_DURATION_MS=

# devIndices.anomalyCooldownMs - Cooldown of a developed type in one system. Range 0..604800000. Default: 86400000.
# EVEJS_LNE_DEV_INDICES_ANOMALY_COOLDOWN_MS=

# devIndices.anomalyAftermathMs - Aftermath after clear / mined (capped at the duration). Range 0..3600000. Default: 600000.
# EVEJS_LNE_DEV_INDICES_ANOMALY_AFTERMATH_MS=

# devIndices.stationsEnabled - a faction plans a station in its own developed system (needs construction). Default: false.
# EVEJS_LNE_DEV_INDICES_STATIONS_ENABLED=

# devIndices.stationMinLevelSum - least industry + trade level for a DEV_STATION build. Range 2..10. Default: 6.
# EVEJS_LNE_DEV_INDICES_STATION_MIN_LEVEL_SUM=

# devIndices.stationMaxOpenPerFaction - open builds in qualifying systems per faction. Range 1..5. Default: 1.
# EVEJS_LNE_DEV_INDICES_STATION_MAX_OPEN_PER_FACTION=

# devIndices.clientIndicesEnabled - the client dev indices window shows LNE indices (no alliance sov). Default: false.
# EVEJS_LNE_DEV_INDICES_CLIENT_INDICES_ENABLED=

# devIndices.clientMaxSystems - LNE systems added to the client list (0 = vendor list). Range 0..8000. Default: 2000.
# EVEJS_LNE_DEV_INDICES_CLIENT_MAX_SYSTEMS=

# EVE mail to players about the war (at most once per line; needs
# modules.world). All keys internal: not in the launcher, values outside the range are clamped.
# notices.enabled - Feature flag. true/false. Default: false (turn on after a try in the client).
# EVEJS_LNE_NOTICES_ENABLED=

# notices.passIntervalMs - Timer of a pass. Range 5000..600000. Default: 30000.
# EVEJS_LNE_NOTICES_PASS_INTERVAL_MS=

# notices.maxMailsPerPass - Mails per pass. Range 1..50. Default: 3.
# EVEJS_LNE_NOTICES_MAX_MAILS_PER_PASS=

# notices.minMailIntervalMs - At most one mail per character in this window. Range 60000..86400000. Default: 900000.
# EVEJS_LNE_NOTICES_MIN_MAIL_INTERVAL_MS=

# notices.maxItemsPerMail - Lines of one mail. Range 1..30. Default: 10.
# EVEJS_LNE_NOTICES_MAX_ITEMS_PER_MAIL=

# notices.maxPendingPerCharacter - Waiting lines per character, the oldest above are dropped. Range 5..500. Default: 50.
# EVEJS_LNE_NOTICES_MAX_PENDING_PER_CHARACTER=

# notices.maxNoticeAgeMs - Waiting lines older than this expire. Range 600000..604800000. Default: 21600000.
# EVEJS_LNE_NOTICES_MAX_NOTICE_AGE_MS=

# notices.maxAttempts - Tries of one line, then failed. Range 1..10. Default: 3.
# EVEJS_LNE_NOTICES_MAX_ATTEMPTS=

# notices.senderCharacterId - Sender of the mails; 0 = the EveJS welcome sender (GM ELYSIAN). Range 0..2147483647. Default: 0.
# EVEJS_LNE_NOTICES_SENDER_CHARACTER_ID=

# notices.retentionMs - Sent / ended lines and mails older than this are deleted. Range 3600000..2592000000. Default: 604800000.
# EVEJS_LNE_NOTICES_RETENTION_MS=

# notices.pruneBatch - Rows of each table deleted per pass (0 = no delete). Range 0..1000. Default: 200.
# EVEJS_LNE_NOTICES_PRUNE_BATCH=

# Sources of the lines (tail of the world event journal).
# notices.tailScanWindow - Journal id range read per pass. Range 100..100000. Default: 5000.
# EVEJS_LNE_NOTICES_TAIL_SCAN_WINDOW=

# notices.tailMaxRowsPerPass - Journal rows per pass. Range 10..1000. Default: 200.
# EVEJS_LNE_NOTICES_TAIL_MAX_ROWS_PER_PASS=

# notices.tailMaxLagRows - A larger backlog jumps to the journal head. Range 1000..10000000. Default: 200000.
# EVEJS_LNE_NOTICES_TAIL_MAX_LAG_ROWS=

# notices.tailMaxFailedPasses - Failed tail passes in a row on one journal cursor, then a jump to the head. Range 1..100. Default: 3.
# EVEJS_LNE_NOTICES_TAIL_MAX_FAILED_PASSES=

# notices.maxItemsPerPass - Lines queued per pass. Range 10..900. Default: 300.
# EVEJS_LNE_NOTICES_MAX_ITEMS_PER_PASS=

# notices.maxEventAgeMs - An older event gives no line. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_NOTICES_MAX_EVENT_AGE_MS=

# notices.proximityJumps - Online players within this many jumps get the line (0 = the system only). Range 0..5. Default: 1.
# EVEJS_LNE_NOTICES_PROXIMITY_JUMPS=

# notices.maxRecipientsPerEvent - Proximity recipients of one event. Range 1..500. Default: 50.
# EVEJS_LNE_NOTICES_MAX_RECIPIENTS_PER_EVENT=

# notices.impactWindowMs - Kills of this window make a player a contributor of a release (0 = off). Range 0..86400000. Default: 3600000.
# EVEJS_LNE_NOTICES_IMPACT_WINDOW_MS=

# notices.maxImpactRecipients - Contributors of one release. Range 0..200. Default: 20.
# EVEJS_LNE_NOTICES_MAX_IMPACT_RECIPIENTS=

# notices.kindAttackStarted / kindSystemCaptured / kindSystemReleased / kindAttackRepelled / kindSiegeStarted /
# kindSiegeEnded / kindPlayerImpact - Lines of that kind. true/false. Default: true.
# EVEJS_LNE_NOTICES_KIND_ATTACK_STARTED=
# EVEJS_LNE_NOTICES_KIND_SYSTEM_CAPTURED=
# EVEJS_LNE_NOTICES_KIND_SYSTEM_RELEASED=
# EVEJS_LNE_NOTICES_KIND_ATTACK_REPELLED=
# EVEJS_LNE_NOTICES_KIND_SIEGE_STARTED=
# EVEJS_LNE_NOTICES_KIND_SIEGE_ENDED=
# EVEJS_LNE_NOTICES_KIND_PLAYER_IMPACT=

# notices.kindStructureSiegeStarted / kindStructureSiegeEnded - Lines to the owner corporation at the start / end of a
# faction siege of its structure (playerSiege). true/false. Default: true.
# EVEJS_LNE_NOTICES_KIND_STRUCTURE_SIEGE_STARTED=
# EVEJS_LNE_NOTICES_KIND_STRUCTURE_SIEGE_ENDED=

# notices.kindHarvestRaid - the raid warning and end lines to the owner
# corporation of a raided Metenox. false = the raid module does not start (W158). true/false. Default: true.
# EVEJS_LNE_NOTICES_KIND_HARVEST_RAID=

# notices.maxOwnerRecipients - Members of the owner corporation (lowest character ids, also offline) that get a structure siege line. Range 1..500. Default: 50.
# EVEJS_LNE_NOTICES_MAX_OWNER_RECIPIENTS=

# notices.priorityKinds - kinds of the priority path; a character with such a
# waiting line is due after priorityMinIntervalMs (none = off).: + HARVEST_RAID_WARNED (the raid warning).
# Default: BATTLE_ETA,HARVEST_RAID_WARNED.
# EVEJS_LNE_NOTICES_PRIORITY_KINDS=

# notices.priorityMinIntervalMs - window of the priority path (above
# minMailIntervalMs = no effect). Range 0..86400000. Default: 60000.
# EVEJS_LNE_NOTICES_PRIORITY_MIN_INTERVAL_MS=

# ETA lines of attack operations and one end mail
# through the notices outbox (needs modules.world and notices.enabled). All keys internal: not in the launcher.
# battleAnnounce.enabled - feature flag, off = no departure listener, no handler, no write
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_BATTLE_ANNOUNCE_ENABLED=

# battleAnnounce.operationTypes - operation types that are announced (a comma list of fleets OPERATION_TYPES)
# Not in the launcher. Default: invasion,raid,counter,structure_assault.
# EVEJS_LNE_BATTLE_ANNOUNCE_OPERATION_TYPES=

# battleAnnounce.minLeadMs - a shorter flight to the target is not announced
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 180000.
# EVEJS_LNE_BATTLE_ANNOUNCE_MIN_LEAD_MS=

# battleAnnounce.proximityJumps - online players within this many jumps of the target get the ETA line
# Not in the launcher. Range 0..5 (outside: clamped). Default: 2.
# EVEJS_LNE_BATTLE_ANNOUNCE_PROXIMITY_JUMPS=

# battleAnnounce.standingMin - online players with at least this standing to the defender or the attacker (0 = off)
# Not in the launcher. Range 0..10 (outside: clamped). Default: 5.
# EVEJS_LNE_BATTLE_ANNOUNCE_STANDING_MIN=

# battleAnnounce.maxScanCharacters - online characters read for the standing branch of one announcement
# Not in the launcher. Range 0..2000 (outside: clamped). Default: 200.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAX_SCAN_CHARACTERS=

# battleAnnounce.maxRecipientsPerAnnouncement - recipients of one announcement
# Not in the launcher. Range 1..200 (outside: clamped). Default: 30.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAX_RECIPIENTS_PER_ANNOUNCEMENT=

# battleAnnounce.maxPerCharacterPerDay - ETA lines of one character in capWindowMs
# Not in the launcher. Range 1..100 (outside: clamped). Default: 6.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAX_PER_CHARACTER_PER_DAY=

# battleAnnounce.capWindowMs - window of the per-character cap
# Not in the launcher. Range 3600000..604800000 (outside: clamped). Default: 86400000.
# EVEJS_LNE_BATTLE_ANNOUNCE_CAP_WINDOW_MS=

# battleAnnounce.maxOpenWatches - open announcements at once
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 50.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAX_OPEN_WATCHES=

# battleAnnounce.maxAnnouncementsPerTransaction - rows of the departure listener in one transaction
# Not in the launcher. Range 1..16 (outside: clamped). Default: 2.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAX_ANNOUNCEMENTS_PER_TRANSACTION=

# battleAnnounce.maxAnnouncementsPerPass - BATTLE_ANNOUNCE events per scheduler pass
# Not in the launcher. Range 1..64 (outside: clamped). Default: 4.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAX_ANNOUNCEMENTS_PER_PASS=

# battleAnnounce.maxChecksPerPass - BATTLE_ANNOUNCE_CHECK events per scheduler pass
# Not in the launcher. Range 1..128 (outside: clamped). Default: 8.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAX_CHECKS_PER_PASS=

# battleAnnounce.checkIntervalMs - time between two outcome checks
# Not in the launcher. Range 30000..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_BATTLE_ANNOUNCE_CHECK_INTERVAL_MS=

# battleAnnounce.noBattleGraceMs - after ETA + this without a battle at the target -> NO_CONTACT
# Not in the launcher. Range 0..21600000 (outside: clamped). Default: 900000.
# EVEJS_LNE_BATTLE_ANNOUNCE_NO_BATTLE_GRACE_MS=

# battleAnnounce.maxWatchMs - an announcement open this long -> EXPIRED
# Not in the launcher. Range 600000..86400000 (outside: clamped). Default: 7200000.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAX_WATCH_MS=

# battleAnnounce.staleAfterMs - an end fact older than this closes without a mail
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_BATTLE_ANNOUNCE_STALE_AFTER_MS=

# battleAnnounce.mailOnExpired - an EXPIRED announcement still mails its recipients
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_BATTLE_ANNOUNCE_MAIL_ON_EXPIRED=

# battleAnnounce.battleScanLimit - battles read per operation fleet in one check
# Not in the launcher. Range 1..32 (outside: clamped). Default: 8.
# EVEJS_LNE_BATTLE_ANNOUNCE_BATTLE_SCAN_LIMIT=

# battleAnnounce.retentionMs - closed announcements older than this are deleted
# Not in the launcher. Range 3600000..2592000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_BATTLE_ANNOUNCE_RETENTION_MS=

# battleAnnounce.pruneBatch - closed announcements deleted per check (0 = no delete)
# Not in the launcher. Range 0..20 (outside: clamped). Default: 5.
# EVEJS_LNE_BATTLE_ANNOUNCE_PRUNE_BATCH=

# Pilots of the mod's fleets in the Local member list of the player's system
# (gateway list only, memory only; needs modules.world). Internal: not in the launcher. Read at boot (restart).
# localPilots.enabled - Feature flag. true/false. Default: false.
# EVEJS_LNE_LOCAL_PILOTS_ENABLED=

# localPilots.refreshMs - Period of the pass (departures are seen then). Range 2000..300000. Default: 15000.
# EVEJS_LNE_LOCAL_PILOTS_REFRESH_MS=

# localPilots.nudgeDelayMs - Delay of a pass after a presence change or an arrival. Range 100..30000. Default: 1000.
# EVEJS_LNE_LOCAL_PILOTS_NUDGE_DELAY_MS=

# localPilots.deferRetryMs - Retry of a pass refused by the governor. Range 500..60000. Default: 3000.
# EVEJS_LNE_LOCAL_PILOTS_DEFER_RETRY_MS=

# localPilots.maxSystemsPerPass - Observed systems read per pass. Range 1..64. Default: 8.
# EVEJS_LNE_LOCAL_PILOTS_MAX_SYSTEMS_PER_PASS=

# localPilots.maxFleetsPerSystem - Fleets read per system and pass. Range 1..512. Default: 64.
# EVEJS_LNE_LOCAL_PILOTS_MAX_FLEETS_PER_SYSTEM=

# localPilots.shipsPerPilot - Ships of a pool per pilot in Local (ceil). Range 1..100. Default: 1.
# Not used while crews run (crews.enabled): Local then shows the fleet crews, sized by crews.shipsPerPilot.
# EVEJS_LNE_LOCAL_PILOTS_SHIPS_PER_PILOT=

# localPilots.maxPilotsPerFactionPerSystem - Pilots of one pool (faction, corporation) per system. Range 1..500.
# Default: 100.
# EVEJS_LNE_LOCAL_PILOTS_MAX_PILOTS_PER_FACTION_PER_SYSTEM=

# localPilots.maxPilotsPerSystem - Pilots per system, all pools. Range 1..500. Default: 200.
# EVEJS_LNE_LOCAL_PILOTS_MAX_PILOTS_PER_SYSTEM=

# localPilots.maxRepushPerPass - Local list repushes per pass. Range 1..64. Default: 8.
# EVEJS_LNE_LOCAL_PILOTS_MAX_REPUSH_PER_PASS=

# localPilots.maxPoolCharacters - virtualCorps characters read into the pilot pool. Range 1..16384. Default: 2048.
# EVEJS_LNE_LOCAL_PILOTS_MAX_POOL_CHARACTERS=

# Pilots as occupants of the XMPP MUC Local room (tap of the vendor XMPP
# socket writes, memory only). Works only with localPilots.enabled. Read at boot (restart).
# localPilots.xmppEnabled - Feature flag. true/false. Default: true.
# EVEJS_LNE_LOCAL_PILOTS_XMPP_ENABLED=

# localPilots.xmppMaxBatchBytes - Bytes of one batch of injected stanzas. Range 4096..262144. Default: 32768.
# EVEJS_LNE_LOCAL_PILOTS_XMPP_MAX_BATCH_BYTES=

# localPilots.xmppReassertMs - Period of the idempotent available reassert, 0 = off. Range 0..600000. Default: 60000.
# EVEJS_LNE_LOCAL_PILOTS_XMPP_REASSERT_MS=

# localPilots.xmppMaxReassertStanzasPerPass - Stanzas of one reassert. Range 16..8192. Default: 512.
# EVEJS_LNE_LOCAL_PILOTS_XMPP_MAX_REASSERT_STANZAS_PER_PASS=

# Personal contacts of the online players to the alliance (or
# corporations) of each virtual faction: -10 hostile, +10 friendly, none neutral (the attack rule), so the client
# colours the LNE pilots in Local (visible after a relog). A contact set by the player is never changed. Full mode
# needs localPilots.enabled and modules.virtualCorps. Off with live rows = cleanup: removes only the LNE contacts.
# Turn it off and restart BEFORE uninstalling the mod. Internal: not in the launcher. Read at boot (restart).
# localContacts.enabled - Feature flag. true/false. Default: false.
# EVEJS_LNE_LOCAL_CONTACTS_ENABLED=

# localContacts.contactLevel - alliance (corporations for a faction without one) or corporation. Default: alliance.
# EVEJS_LNE_LOCAL_CONTACTS_CONTACT_LEVEL=

# localContacts.refreshMs - Period of the pass. Range 10000..600000. Default: 60000.
# EVEJS_LNE_LOCAL_CONTACTS_REFRESH_MS=

# localContacts.confirmDelayMs - Wait before a written / removed contact is confirmed. Range 3000..600000. Default: 10000.
# EVEJS_LNE_LOCAL_CONTACTS_CONFIRM_DELAY_MS=

# localContacts.maxCharactersPerPass - Characters handled per pass. Range 1..256. Default: 8.
# EVEJS_LNE_LOCAL_CONTACTS_MAX_CHARACTERS_PER_PASS=

# localContacts.maxWritesPerPass - Character record writes per pass. Range 1..256. Default: 16.
# EVEJS_LNE_LOCAL_CONTACTS_MAX_WRITES_PER_PASS=

# Civilian population of the imperial highsec. Sub1 = density core
# and the civilian identities (20 corporations x 10 characters via virtualCorps, outside virtualCorps.maxCharacters);
# Local does not change before. Needs modules.world, localPilots.enabled and modules.virtualCorps (else the
# service is disabled_by_dependency). Memory only. Internal: not in the launcher; values outside the range are clamped.

# highsecLife.enabled - Feature flag of the highsec civilians. Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_ENABLED=

# highsecLife.civilians.enabled - Civilians (identities in, Local in); needs highsecLife.enabled.
# Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_CIVILIANS_ENABLED=

# highsecLife.civilianCorps - Civilian corporations (catalogue lib/highsecLife/data/civilianCorps.js). Range 1..60.
# Default: 20.
# EVEJS_LNE_HIGHSEC_LIFE_CIVILIAN_CORPS=

# highsecLife.civilianMembersPerCorp - Characters per civilian corporation. Range 1..10. Default: 10.
# EVEJS_LNE_HIGHSEC_LIFE_CIVILIAN_MEMBERS_PER_CORP=

# highsecLife.basePilots - Civilians of every system of the bands. Range 0..100. Default: 2.
# EVEJS_LNE_HIGHSEC_LIFE_BASE_PILOTS=

# highsecLife.perStationPilots - Civilians per NPC station of the system. Range 0..50. Default: 1.
# EVEJS_LNE_HIGHSEC_LIFE_PER_STATION_PILOTS=

# highsecLife.maxStationBonus - Cap of the station bonus. Range 0..100. Default: 6.
# EVEJS_LNE_HIGHSEC_LIFE_MAX_STATION_BONUS=

# highsecLife.hubPilots - Civilians of a trade hub. Range 0..500. Default: 45.
# EVEJS_LNE_HIGHSEC_LIFE_HUB_PILOTS=

# highsecLife.primeHubPilots - Civilians of the prime hub (first of hubSystemIds, Jita). Range 0..500. Default: 80.
# EVEJS_LNE_HIGHSEC_LIFE_PRIME_HUB_PILOTS=

# highsecLife.nearHubPilots - Civilians at 1, 2, 3... jumps from a hub (1..8 integers 0..1000). Default: 16,8,4.
# EVEJS_LNE_HIGHSEC_LIFE_NEAR_HUB_PILOTS=

# highsecLife.maxHubJumps - Depth of the hub BFS. Range 0..8. Default: 3.
# EVEJS_LNE_HIGHSEC_LIFE_MAX_HUB_JUMPS=

# highsecLife.jitterPermille - +- jitter of the density per system and time bucket. Range 0..1000. Default: 250.
# EVEJS_LNE_HIGHSEC_LIFE_JITTER_PERMILLE=

# highsecLife.hourCurvePermille - Density permille per UTC hour (24 integers 0..2000). Default:
# 700,600,480,400,420,460,520,580,640,700,740,780,820,860,900,950,1000,1000,1000,1000,950,900,850,780.
# EVEJS_LNE_HIGHSEC_LIFE_HOUR_CURVE_PERMILLE=

# highsecLife.maxCiviliansPerSystem - Civilians per system (also capped by localPilots.maxPilotsPerSystem).
# Range 0..500. Default: 100.
# EVEJS_LNE_HIGHSEC_LIFE_MAX_CIVILIANS_PER_SYSTEM=

# highsecLife.hubSystemIds - Trade hubs, the first is the prime hub (1..16 system ids).
# Default: 30000142,30002187,30002659,30002510,30002053.
# EVEJS_LNE_HIGHSEC_LIFE_HUB_SYSTEM_IDS=

# highsecLife.bucketMs - Time bucket of the density jitter and the roster rotation. Range 60000..86400000.
# Default: 600000.
# EVEJS_LNE_HIGHSEC_LIFE_BUCKET_MS=

# highsecLife.churnPermille - Part of the civilian roster replaced every bucket. Range 0..1000. Default: 150.
# EVEJS_LNE_HIGHSEC_LIFE_CHURN_PERMILLE=

# highsecLife.bands - Security bands with civilians (comma list of highsec|lowsec|nullsec). Default: highsec.
# EVEJS_LNE_HIGHSEC_LIFE_BANDS=

# Rare Local lines of the civilians (trade in the hubs, greetings, missions
# escorts) and rumours of real LNE events (war events of the notices tail, settled battles) within a few jumps.
# Memory only, needs highsecLife.civilians.enabled; notices off = no war rumours (battles only).

# highsecLife.chatter.enabled - Local chatter of the civilians. Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_ENABLED=

# highsecLife.chatter.tickMs - Period of the chatter pass. Range 2000..600000. Default: 10000.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_TICK_MS=

# highsecLife.chatter.minIntervalMs - Gap between two lines of a system at intervalRefCivilians civilians.
# Range 10000..3600000. Default: 240000.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_MIN_INTERVAL_MS=

# highsecLife.chatter.minIntervalFloorMs - Shortest gap between two lines of a system. Range 5000..3600000.
# Default: 45000.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_MIN_INTERVAL_FLOOR_MS=

# highsecLife.chatter.intervalRefCivilians - Civilians at which the gap is minIntervalMs. Range 1..500. Default: 24.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_INTERVAL_REF_CIVILIANS=

# highsecLife.chatter.jitterPermille - +- jitter of the gap. Range 0..900. Default: 300.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_JITTER_PERMILLE=

# highsecLife.chatter.maxLinesPerMinute - Lines per minute over all systems (0 = silence). Range 0..120. Default: 6.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_MAX_LINES_PER_MINUTE=

# highsecLife.chatter.minCivilians - A system with fewer civilians stays silent. Range 1..500. Default: 3.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_MIN_CIVILIANS=

# highsecLife.chatter.rumourPermille - Chance of a rumour instead of a background line. Range 0..1000. Default: 400.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_RUMOUR_PERMILLE=

# highsecLife.chatter.rumourMaxJumps - Jumps from the listener to the event of a rumour. Range 0..30. Default: 8.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_RUMOUR_MAX_JUMPS=

# highsecLife.chatter.rumourMaxAgeMs - Age of the event of a rumour. Range 60000..604800000. Default: 21600000.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_RUMOUR_MAX_AGE_MS=

# highsecLife.chatter.rumourRingSize - Rumours kept in memory per source. Range 1..1024. Default: 64.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_RUMOUR_RING_SIZE=

# highsecLife.chatter.rumourMinBattleLosses - Ships destroyed in a settled battle for a rumour. Range 0..10000.
# Default: 2.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_RUMOUR_MIN_BATTLE_LOSSES=

# highsecLife.chatter.hubRumoursAnyDistance - Trade hubs hear rumours from any distance. Range: true/false.
# Default: true.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_HUB_RUMOURS_ANY_DISTANCE=

# highsecLife.chatter.recentLinesPerSystem - Last lines of a system not repeated. Range 0..64. Default: 8.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_RECENT_LINES_PER_SYSTEM=

# highsecLife.chatter.maxLineChars - Longest line. Range 40..1000. Default: 240.
# EVEJS_LNE_HIGHSEC_LIFE_CHATTER_MAX_LINE_CHARS=

# 1-2 physical civilian haulers (vendor pool npc_mining_hauler_highsec) at a gate
# of a highsec system with a player in space; they warp to a station or another gate and vanish. Passive, no loot, no
# bounty, a kill has no LNE effect. Memory only, needs highsecLife.civilians.enabled.

# highsecLife.traffic.enabled - Civilian traffic near a player. Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_ENABLED=

# highsecLife.traffic.pollMs - Period of the traffic pass. Range 1000..60000. Default: 5000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_POLL_MS=

# highsecLife.traffic.spawnIntervalMs - Gap between two spawns of a system. Range 10000..3600000. Default: 90000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_SPAWN_INTERVAL_MS=

# highsecLife.traffic.maxLifetimeMs - Longest life of a hauler. Range 30000..3600000. Default: 240000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MAX_LIFETIME_MS=

# highsecLife.traffic.maxShipsPerSystem - Haulers per system. Range 0..10. Default: 4.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MAX_SHIPS_PER_SYSTEM=

# highsecLife.traffic.maxShipsGlobal - Haulers over all systems. Range 0..50. Default: 12.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MAX_SHIPS_GLOBAL=

# highsecLife.traffic.civiliansPerShip - Civilians of the density per hauler of the system cap. Range 1..500.
# Default: 20.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_CIVILIANS_PER_SHIP=

# highsecLife.traffic.pairCivilians - From this many civilians a spawn has 2 haulers. Range 0..500. Default: 30.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_PAIR_CIVILIANS=

# highsecLife.traffic.minCivilians - Below this many civilians no traffic. Range 0..500. Default: 3.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MIN_CIVILIANS=

# highsecLife.traffic.maxSystemsPerPass - Systems spawning per pass. Range 1..50. Default: 4.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MAX_SYSTEMS_PER_PASS=

# highsecLife.traffic.departDelayMs - Wait after the spawn before the warp. Range 0..120000. Default: 15000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_DEPART_DELAY_MS=

# highsecLife.traffic.spawnOffsetMeters - Spawn distance from the surface of the gate. Range 0..50000. Default: 3000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_SPAWN_OFFSET_METERS=

# highsecLife.traffic.landingOffsetMeters - Landing distance from the surface of the target. Range 0..50000.
# Default: 2500.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_LANDING_OFFSET_METERS=

# highsecLife.traffic.arrivalMeters - Out of warp this close to the landing point = arrived. Range 1000..200000.
# Default: 15000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_ARRIVAL_METERS=

# highsecLife.traffic.dockDelayMs - From the arrival to the despawn. Range 0..120000. Default: 8000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_DOCK_DELAY_MS=

# highsecLife.traffic.exitGraceMs - No player in space this long -> the haulers of the system go. Range 0..600000.
# Default: 60000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXIT_GRACE_MS=

# highsecLife.traffic.stationTargetPermille - Chance of a station instead of another gate as the target.
# Range 0..1000. Default: 700.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_STATION_TARGET_PERMILLE=

# highsecLife.traffic.maxWarpAttempts - Refused warps before STUCK. Range 1..10. Default: 2.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MAX_WARP_ATTEMPTS=

# Traffic v2 - ships undock from a station, land in the dock, wait at
# a gate and "jump", and carry the name of an LNE pilot in Local. All flags off = the traffic as before.

# highsecLife.traffic.bands - Security bands of the traffic (comma list of highsec, lowsec, nullsec). A band outside
# highsecLife.bands needs LNE pilots in Local (residents of freeCorps.local). Default: highsec.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_BANDS=

# highsecLife.traffic.undockEnabled - Ships undock from a station and warp to a gate. Range: true/false.
# Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_UNDOCK_ENABLED=

# highsecLife.traffic.undockPermille - Share of the undock role per spawn. Range 0..1000. Default: 300.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_UNDOCK_PERMILLE=

# highsecLife.traffic.undockRunMeters - Straight run out of the dock before the warp. Range 0..50000. Default: 6000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_UNDOCK_RUN_METERS=

# highsecLife.traffic.dockToPointEnabled - A hauler bound for a station lands in the dock opening. Range: true/false.
# Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_DOCK_TO_POINT_ENABLED=

# highsecLife.traffic.gateIdleEnabled - Ships wait at a gate and then jump. Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_IDLE_ENABLED=

# highsecLife.traffic.gateIdlePermille - Share of the gate idle role per spawn. Range 0..1000. Default: 150.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_IDLE_PERMILLE=

# highsecLife.traffic.gateIdleMinMs - Shortest wait at the gate. Range 1000..3600000. Default: 60000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_IDLE_MIN_MS=

# highsecLife.traffic.gateIdleMaxMs - Longest wait at the gate (not below gateIdleMinMs). Range 1000..3600000.
# Default: 240000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_IDLE_MAX_MS=

# highsecLife.traffic.namesEnabled - A ship carries the name of an LNE pilot in the Local of its system. Range:
# true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_NAMES_ENABLED=

# Civilian hulls (NPC types with the graphic of a player hull: miners
# haulers, frigates, cruisers) and miners that stay at an asteroid belt (no laser). All flags off = as before.

# highsecLife.traffic.minerEnabled - Ships warp to an asteroid belt, stay there and leave (no mining laser). Range:
# true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINER_ENABLED=

# highsecLife.traffic.minerPermille - Share of the miner role per spawn. Range 0..1000. Default: 200.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINER_PERMILLE=

# highsecLife.traffic.minerStayMinMs - Shortest stay at the belt. Range 1000..3600000. Default: 120000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINER_STAY_MIN_MS=

# highsecLife.traffic.minerStayMaxMs - Longest stay at the belt (not below minerStayMinMs). Range 1000..3600000.
# Default: 600000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINER_STAY_MAX_MS=

# highsecLife.traffic.minerAsteroidMeters - Distance of the landing point from the centre of the belt. Range 0..50000.
# Default: 5000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINER_ASTEROID_METERS=

# highsecLife.traffic.gateJumpFxEnabled - JumpIn after a gate spawn, JumpOut at the target gate. Range: true/false.
# Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_JUMP_FX_ENABLED=

# highsecLife.traffic.gateJumpInDurationMs - Duration of the JumpIn effect. Range 1000..20000. Default: 5000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_JUMP_IN_DURATION_MS=

# highsecLife.traffic.gateJumpOutDespawnMs - From the JumpOut to the despawn. Range 1000..30000. Default: 3000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_JUMP_OUT_DESPAWN_MS=

# highsecLife.traffic.gateControllerEventsEnabled - Gate Arrival/Departure animation for civilian gate traffic (needs
# gateJumpFxEnabled). Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_CONTROLLER_EVENTS_ENABLED=

# highsecLife.traffic.gateControllerEventMaxPerPass - Gate Arrival/Departure events and arrival rotations per traffic
# pass (0 = none). Range 0..500. Default: 40.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_CONTROLLER_EVENT_MAX_PER_PASS=

# highsecLife.traffic.gateArrivalPoseEnabled - Ships spawned at a gate stand still, turned away from their first
# target. Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_ARRIVAL_POSE_ENABLED=

# highsecLife.traffic.gateArrivalTurnMinDeg - Smallest turn away from the first target. Range 0..180. Default: 60.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_ARRIVAL_TURN_MIN_DEG=

# highsecLife.traffic.gateArrivalTurnMaxDeg - Largest turn away from the first target (not below
# gateArrivalTurnMinDeg). Range 0..180. Default: 120.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_GATE_ARRIVAL_TURN_MAX_DEG=

# highsecLife.traffic.alignBeforeWarpEnabled - Traffic ships align before the warp (vendor warp order). Range:
# true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_ALIGN_BEFORE_WARP_ENABLED=

# highsecLife.traffic.alignTimeoutMs - No warp this long after the align order -> instant warp. Range 5000..120000.
# Default: 30000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_ALIGN_TIMEOUT_MS=

# highsecLife.traffic.visibleWarpEnabled - Warping effect on the instant warp of civilian traffic. Range: true/false.
# Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_VISIBLE_WARP_ENABLED=

# highsecLife.traffic.visibleWarpMaxFxPerPass - Warping effects sent per traffic pass (0 = none). Range 0..500.
# Default: 40.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_VISIBLE_WARP_MAX_FX_PER_PASS=

# highsecLife.traffic.miningBeamsEnabled - Mining laser effect on civilian miners seen by a player. Range: true/false.
# Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAMS_ENABLED=

# highsecLife.traffic.miningBeamViewMeters - A player this close to a miner sees the beams. Range 10000..1000000.
# Default: 150000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAM_VIEW_METERS=

# highsecLife.traffic.miningBeamRockMeters - Farthest asteroid a beam may target. Range 1000..200000. Default: 60000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAM_ROCK_METERS=

# highsecLife.traffic.miningBeamRefreshMs - Full restart of the beams of a system. Range 5000..600000. Default: 30000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAM_REFRESH_MS=

# highsecLife.traffic.miningBeamMaxFxPerPass - Beam effects sent per traffic pass (0 = none). Range 0..500.
# Default: 40.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAM_MAX_FX_PER_PASS=

# highsecLife.traffic.miningBeamApproachEnabled - Civilian miners fly to the asteroid at full subwarp before the beam
# (needs miningBeamsEnabled). Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAM_APPROACH_ENABLED=

# highsecLife.traffic.miningBeamStartMeters - Surface distance to the asteroid at which the beam starts.
# Range 2000..60000. Default: 10000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAM_START_METERS=

# highsecLife.traffic.miningBeamApproachMeters - Follow range of the approach (kept below miningBeamStartMeters).
# Range 500..50000. Default: 7500.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAM_APPROACH_METERS=

# highsecLife.traffic.miningBeamRetryMs - Gap between two approach checks of a miner without a beam.
# Range 1000..60000. Default: 5000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_MINING_BEAM_RETRY_MS=

# highsecLife.traffic.fleeEnabled - A hauler attacked by a player warps away. Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_FLEE_ENABLED=

# highsecLife.traffic.fleeWindowMs - How long after the last hit the hauler keeps trying to flee. Range
# 5000..600000. Default: 60000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_FLEE_WINDOW_MS=

# highsecLife.traffic.fleeRetryMs - Gap between two flee warp orders. Range 1000..60000. Default: 5000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_FLEE_RETRY_MS=

# highsecLife.traffic.fleeMinMeters - Nearest landing point a flee warp may use. Range 0..10000000. Default: 150000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_FLEE_MIN_METERS=

# highsecLife.traffic.fleeAlarmEnabled - Civilians of every role near a civilian attacked by a player flee too
# (needs fleeEnabled). Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_FLEE_ALARM_ENABLED=

# highsecLife.traffic.fleeAlarmMeters - Distance from the attacked civilian within which the others flee. Range
# 1000..1000000. Default: 100000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_FLEE_ALARM_METERS=

# highsecLife.traffic.fleeAlarmMaxPerPass - Civilians alarmed per traffic pass (0 = only the victim flees). Range
# 0..50. Default: 8.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_FLEE_ALARM_MAX_PER_PASS=

# highsecLife.traffic.ratterEnabled - Civilian ratters patrol asteroid belts without weapons (needs
# civilianHullsEnabled). Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_ENABLED=

# Allow armed civilian ratters to engage belt NPCs during patrol stops. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_COMBAT_ENABLED=

# highsecLife.traffic.ratterPermille - Share of the ratter role per spawn. Range 0..1000. Default: 150.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_PERMILLE=

# highsecLife.traffic.ratterMaxPerSystem - Ratters per system. Range 0..10. Default: 2.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_MAX_PER_SYSTEM=

# highsecLife.traffic.ratterBeltsMin - Fewest belts of one patrol (not above the belts of the system). Range 1..10.
# Default: 2.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_BELTS_MIN=

# highsecLife.traffic.ratterBeltsMax - Most belts of one patrol (not below ratterBeltsMin, not above the belts of
# the system). Range 1..10. Default: 3.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_BELTS_MAX=

# highsecLife.traffic.ratterDwellMinMs - Shortest stay at one belt. Range 5000..600000. Default: 45000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_DWELL_MIN_MS=

# highsecLife.traffic.ratterDwellMaxMs - Longest stay at one belt (not below ratterDwellMinMs). Range 5000..600000.
# Default: 90000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_DWELL_MAX_MS=

# highsecLife.traffic.ratterLandingMeters - Landing distance from the centre of the belt. Range 0..50000.
# Default: 10000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_LANDING_METERS=

# highsecLife.traffic.ratterOrbitMeters - Orbit distance around the belt. Range 500..50000. Default: 7500.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_ORBIT_METERS=

# highsecLife.traffic.ratterOrbitSpeedPermille - Orbit speed as a share of the top speed. Range 100..1000.
# Default: 600.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_ORBIT_SPEED_PERMILLE=

# highsecLife.traffic.ratterLegMs - Lifetime allowance per belt of a patrol. Range 10000..600000. Default: 60000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_RATTER_LEG_MS=

# highsecLife.traffic.explorerEnabled - Civilian explorers visit public data and relic sites without touching them
# (needs civilianHullsEnabled). Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_ENABLED=

# highsecLife.traffic.explorerPermille - Share of the explorer role per spawn. Range 0..1000. Default: 100.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_PERMILLE=

# highsecLife.traffic.explorerMaxPerSystem - Explorers per system. Range 0..10. Default: 2.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_MAX_PER_SYSTEM=

# highsecLife.traffic.explorerFamilies - Site families an explorer visits, distinct values of data,relic. Default:
# data,relic.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_FAMILIES=

# highsecLife.traffic.explorerMaxSites - Sites of one explorer. Range 1..5. Default: 2.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_MAX_SITES=

# highsecLife.traffic.explorerScanMs - Scan stop per planned site at the safe spot. Range 1000..300000. Default: 20000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_SCAN_MS=

# highsecLife.traffic.explorerSiteDwellMs - Stay at one site. Range 5000..600000. Default: 60000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_SITE_DWELL_MS=

# highsecLife.traffic.explorerSiteOffsetMeters - Landing distance from the site. Range 0..50000. Default: 5000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_SITE_OFFSET_METERS=

# highsecLife.traffic.explorerNpcClearMeters - No NPC ship this close to a site, else the site is skipped. Range
# 10000..1000000. Default: 150000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_NPC_CLEAR_METERS=

# highsecLife.traffic.explorerSafeSpotOffsetMeters - Height of the safe spot above the line of two celestials. Range
# 0..100000000. Default: 1500000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_SAFE_SPOT_OFFSET_METERS=

# highsecLife.traffic.explorerSafeSpotMinMeters - Smallest distance of the safe spot from any gate, station or belt.
# Range 0..100000000. Default: 1000000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_SAFE_SPOT_MIN_METERS=

# highsecLife.traffic.explorerSafeSpotTries - Tries to find a safe spot away from every celestial. Range 1..16.
# Default: 4.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_SAFE_SPOT_TRIES=

# highsecLife.traffic.explorerSiteReadsPerPass - Site reads of all explorers per traffic pass (0 = explorers skip
# sites). Range 0..50. Default: 4.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_SITE_READS_PER_PASS=

# highsecLife.traffic.explorerLegMs - Lifetime allowance per leg of an explorer. Range 10000..600000. Default: 60000.
# EVEJS_LNE_HIGHSEC_LIFE_TRAFFIC_EXPLORER_LEG_MS=

# highsecLife.civilianHullsEnabled - Traffic ships use the civilian hulls lne_civ_* (restart needed: the NPC profile
# rows are added at the server start). Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_CIVILIAN_HULLS_ENABLED=

# Situations near a player. Pirates attack NPC miners at
# an asteroid belt, the victim pilot calls for help in Local (needs localPilots.enabled with civilians or residents),
# one settlement per situation, an optional reward for the helpers. Internal: not in the launcher. All flags off.
# situations.enabled - Feature flag (needs modules.world). true/false. Default: false.
# EVEJS_LNE_SITUATIONS_ENABLED=
# situations.bands - Security bands (highsec, lowsec, nullsec). Default: highsec,lowsec.
# EVEJS_LNE_SITUATIONS_BANDS=
# situations.pollMs - Period of the pass. Range 1000..60000. Default: 3000.
# EVEJS_LNE_SITUATIONS_POLL_MS=
# situations.bucketMs - Time bucket: at most one roll per system and bucket. Range 600000..86400000. Default: 3600000.
# EVEJS_LNE_SITUATIONS_BUCKET_MS=
# situations.chancePermille - Chance of a situation per roll. Range 0..1000. Default: 150.
# EVEJS_LNE_SITUATIONS_CHANCE_PERMILLE=
# situations.maxActive - Open situations at a time (one per system). Range 0..16. Default: 2.
# EVEJS_LNE_SITUATIONS_MAX_ACTIVE=
# situations.maxShipsPerSituation - Victims + pirates of one situation. Range 3..16. Default: 8.
# EVEJS_LNE_SITUATIONS_MAX_SHIPS_PER_SITUATION=
# situations.maxCivilianShipsPerSystem - Traffic + situation ships of one system. Range 1..64. Default: 10.
# EVEJS_LNE_SITUATIONS_MAX_CIVILIAN_SHIPS_PER_SYSTEM=
# situations.victimsMin / victimsMax - Victim miners. Ranges 1..4. Default: 2 / 3.
# EVEJS_LNE_SITUATIONS_VICTIMS_MIN=
# EVEJS_LNE_SITUATIONS_VICTIMS_MAX=
# situations.piratesBySec - Pirates per band: band:min-max:hull|hull;... (min 1, max 8, hulls frigate, destroyer,
# cruiser, battlecruiser). Default: highsec:2-3:frigate|destroyer;lowsec:3-4:frigate|destroyer|cruiser.
# EVEJS_LNE_SITUATIONS_PIRATES_BY_SEC=
# situations.engageRangeMeters - A player this close to the belt (out of warp) brings the pirates. Range
# 10000..1000000. Default: 150000.
# EVEJS_LNE_SITUATIONS_ENGAGE_RANGE_METERS=
# situations.pirateStandoffMeters / victimOffsetMeters - Spawn distance of the pirates / victims from the belt.
# Ranges 0..150000 / 0..50000. Default: 25000 / 5000.
# EVEJS_LNE_SITUATIONS_PIRATE_STANDOFF_METERS=
# EVEJS_LNE_SITUATIONS_VICTIM_OFFSET_METERS=
# situations.pirateRetaliate - A pirate attacked by a player fires back at that ship. true/false. Default: true.
# EVEJS_LNE_SITUATIONS_PIRATE_RETALIATE=
# situations.callingTimeoutMs - No player near the belt this long -> UNANSWERED. Range 60000..3600000. Default: 600000.
# EVEJS_LNE_SITUATIONS_CALLING_TIMEOUT_MS=
# situations.distressRepeatMs / distressLines - Pause between calls for help / calls per situation. Ranges
# 30000..3600000 / 1..10. Default: 180000 / 3.
# EVEJS_LNE_SITUATIONS_DISTRESS_REPEAT_MS=
# EVEJS_LNE_SITUATIONS_DISTRESS_LINES=
# situations.abandonGraceMs / maxFightMs - No player near the belt this long in the fight / the longest fight ->
# ABANDONED. Ranges 10000..1800000 / 60000..3600000. Default: 120000 / 600000.
# EVEJS_LNE_SITUATIONS_ABANDON_GRACE_MS=
# EVEJS_LNE_SITUATIONS_MAX_FIGHT_MS=
# situations.maxHelpers - Rewarded players per situation. Range 1..16. Default: 5.
# EVEJS_LNE_SITUATIONS_MAX_HELPERS=
# situations.rewardsEnabled - RESCUED pays the helpers through the payout pump. true/false. Default: false.
# EVEJS_LNE_SITUATIONS_REWARDS_ENABLED=
# situations.rewardIskPerSaved - ISK per saved miner and helper. Range 0..1000000000. Default: 200000.
# EVEJS_LNE_SITUATIONS_REWARD_ISK_PER_SAVED=
# situations.rewardStandingMicro - Standing to ORE per helper in millionths (0 = none). Range 0..1000000. Default: 0.
# EVEJS_LNE_SITUATIONS_REWARD_STANDING_MICRO=
# situations.maxRewardsPerCharacterPerDay - Rewards of one player in 24 h. Range 0..100. Default: 3.
# EVEJS_LNE_SITUATIONS_MAX_REWARDS_PER_CHARACTER_PER_DAY=
# situations.payoutPassMs / payoutBatch - Period / rows of the payout pump. Ranges 1000..600000 / 1..64.
# Default: 5000 / 4.
# EVEJS_LNE_SITUATIONS_PAYOUT_PASS_MS=
# EVEJS_LNE_SITUATIONS_PAYOUT_BATCH=
# situations.payoutRetryBaseMs / payoutRetryMaxMs / payoutMaxAttempts - Backoff of a failed payout (doubled per
# attempt) and the attempts before FAILED. Ranges 1000..3600000 / 1000..86400000 / 1..100. Default: 60000 / 3600000 / 8.
# EVEJS_LNE_SITUATIONS_PAYOUT_RETRY_BASE_MS=
# EVEJS_LNE_SITUATIONS_PAYOUT_RETRY_MAX_MS=
# EVEJS_LNE_SITUATIONS_PAYOUT_MAX_ATTEMPTS=
# situations.retentionMs / payoutRetentionMs - Ended rows / settled payouts are kept this long. Ranges
# 3600000..7776000000 / 86400000..7776000000. Default: 604800000 / 2592000000.
# EVEJS_LNE_SITUATIONS_RETENTION_MS=
# EVEJS_LNE_SITUATIONS_PAYOUT_RETENTION_MS=
# situations.pruneEveryMs / prunePerRun - Period / rows of the retention. Ranges 60000..86400000 / 1..500.
# Default: 600000 / 50.
# EVEJS_LNE_SITUATIONS_PRUNE_EVERY_MS=
# EVEJS_LNE_SITUATIONS_PRUNE_PER_RUN=
# situations.boardEnabled / newsEnabled / rumoursEnabled - The information channels of the situations:
# a row in the Nearby section of the board window (needs jobBoard.enabled + eventsEnabled), the news fact
# SITUATION_RESOLVED (needs news.enabled), the rumour SIT_RESCUED / SIT_LOST in Local of other systems (needs
# highsecLife.chatter.enabled). Booleans (1/0). Default: false / false / false.
# EVEJS_LNE_SITUATIONS_BOARD_ENABLED=
# EVEJS_LNE_SITUATIONS_NEWS_ENABLED=
# EVEJS_LNE_SITUATIONS_RUMOURS_ENABLED=
# situations.layerRecentMs / layerMaxRows - Ended situations on the observer map (layer-situations) and the panel
# situations within this window / rows of one read. Ranges 60000..86400000 / 1..500. Default: 1800000 / 100.
# EVEJS_LNE_SITUATIONS_LAYER_RECENT_MS=
# EVEJS_LNE_SITUATIONS_LAYER_MAX_ROWS=
# situations.gateAmbushEnabled / strandedPodEnabled - The kinds of: GATE_AMBUSH (pirates on haulers at a
# gate where a player is in space, the fight at once) and STRANDED_POD (a pilot in a capsule near a belt waits for a
# pick-up; needs highsecLife.enabled + civilianHullsEnabled for the row lne_civ_capsule). Booleans (1/0).
# Default: false / false.
# EVEJS_LNE_SITUATIONS_GATE_AMBUSH_ENABLED=
# EVEJS_LNE_SITUATIONS_STRANDED_POD_ENABLED=
# situations.podDistanceMeters / rescueRangeMeters / rescueHoldMs - The capsule from the belt / the pick-up range /
# the time a player stays in it (leaving resets it). Ranges 0..200000 / 500..50000 / 0..120000.
# Default: 15000 / 2500 / 10000.
# EVEJS_LNE_SITUATIONS_POD_DISTANCE_METERS=
# EVEJS_LNE_SITUATIONS_RESCUE_RANGE_METERS=
# EVEJS_LNE_SITUATIONS_RESCUE_HOLD_MS=
# situations.beltRaidWeight / gateAmbushWeight / strandedPodWeight - Weights of the kind pick (only between the kinds
# eligible in a roll; a weight 0 = the kind never starts). Ranges 0..100. Default: 2 / 1 / 1.
# EVEJS_LNE_SITUATIONS_BELT_RAID_WEIGHT=
# EVEJS_LNE_SITUATIONS_GATE_AMBUSH_WEIGHT=
# EVEJS_LNE_SITUATIONS_STRANDED_POD_WEIGHT=

# The Game Master. One story thread per cycle
# from an arc template (WAR_RUMOUR while no SITE step exists), a validator and the steps WAIT / NOTICE / NEWS; mails
# to the players near the place (needs notices.enabled). No LLM in. Internal: not in the launcher. Flags off.
# gameMaster.enabled - the Game Master (needs modules.world and persistence). true/false. Default: false.
# EVEJS_LNE_GAMEMASTER_ENABLED=
# gameMaster.aiEnabled - proposals of the LLM (the plot lane comes in). true/false. Default: false.
# EVEJS_LNE_GAMEMASTER_AI_ENABLED=
# gameMaster.templateFallback - a thread from the arc template. true/false. Default: true.
# EVEJS_LNE_GAMEMASTER_TEMPLATE_FALLBACK=
# gameMaster.cycleHours - length of a cycle (one thread per cycle). Range 1..168. Default: 24.
# EVEJS_LNE_GAMEMASTER_CYCLE_HOURS=
# gameMaster.cycleStartHourUtc - UTC hour of a boundary. Range 0..23. Default: 16.
# EVEJS_LNE_GAMEMASTER_CYCLE_START_HOUR_UTC=
# gameMaster.settleDelayMs - the draft starts this long after the boundary. Range 0..21600000. Default: 600000.
# EVEJS_LNE_GAMEMASTER_SETTLE_DELAY_MS=
# gameMaster.draftWindowMs - window of the LLM attempts. Range 60000..86400000. Default: 7200000.
# EVEJS_LNE_GAMEMASTER_DRAFT_WINDOW_MS=
# gameMaster.aiAttemptsPerCycle - LLM requests per cycle. Range 0..5. Default: 2.
# EVEJS_LNE_GAMEMASTER_AI_ATTEMPTS_PER_CYCLE=
# gameMaster.aiRetryMs - pause between two LLM attempts. Range 60000..21600000. Default: 600000.
# EVEJS_LNE_GAMEMASTER_AI_RETRY_MS=
# gameMaster.passIntervalMs - period of the pass. Range 5000..900000. Default: 60000.
# EVEJS_LNE_GAMEMASTER_PASS_INTERVAL_MS=
# gameMaster.maxOpenThreads - open threads at a time (more = SKIPPED OPEN_LIMIT). Range 1..8. Default: 1.
# EVEJS_LNE_GAMEMASTER_MAX_OPEN_THREADS=
# gameMaster.maxStepsPerThread - steps of a thread. Range 1..8. Default: 5.
# EVEJS_LNE_GAMEMASTER_MAX_STEPS_PER_THREAD=
# gameMaster.maxSiteStepsPerThread - SITE steps of a thread. Range 0..3. Default: 2.
# EVEJS_LNE_GAMEMASTER_MAX_SITE_STEPS_PER_THREAD=
# gameMaster.maxStepsPerPass - step transitions per pass (also the drain bound). Range 1..64. Default: 8.
# EVEJS_LNE_GAMEMASTER_MAX_STEPS_PER_PASS=
# gameMaster.maxThreadMs - deadline of a thread (EXPIRED). Range 3600000..1209600000. Default: 172800000.
# EVEJS_LNE_GAMEMASTER_MAX_THREAD_MS=
# gameMaster.waitMaxHours - longest WAIT step (hours are clamped). Range 1..72. Default: 12.
# EVEJS_LNE_GAMEMASTER_WAIT_MAX_HOURS=
# gameMaster.siteMinHours - shortest SITE step. Range 1..72. Default: 2.
# EVEJS_LNE_GAMEMASTER_SITE_MIN_HOURS=
# gameMaster.siteMaxHours - longest SITE step. Range 1..72. Default: 12.
# EVEJS_LNE_GAMEMASTER_SITE_MAX_HOURS=
# gameMaster.stepRetryMs - pause before a retried step start. Range 60000..21600000. Default: 600000.
# EVEJS_LNE_GAMEMASTER_STEP_RETRY_MS=
# gameMaster.stepRetries - retried starts of a step before FAILED. Range 0..50. Default: 6.
# EVEJS_LNE_GAMEMASTER_STEP_RETRIES=
# gameMaster.arcsCsv - enabled arcs. Default: MUTINY,DEFECTOR,SMUGGLER_CACHE,WAR_RUMOUR.
# EVEJS_LNE_GAMEMASTER_ARCS_CSV=
# gameMaster.arcCooldownCycles - cycles before an arc is offered again. Range 0..30. Default: 3.
# EVEJS_LNE_GAMEMASTER_ARC_COOLDOWN_CYCLES=
# gameMaster.systemCooldownCycles - cycles before a system is offered again. Range 0..60. Default: 7.
# EVEJS_LNE_GAMEMASTER_SYSTEM_COOLDOWN_CYCLES=
# gameMaster.maxPlaces - places P1..Pn of an offer. Range 1..32. Default: 12.
# EVEJS_LNE_GAMEMASTER_MAX_PLACES=
# gameMaster.maxFacts - news facts of the digest. Range 0..64. Default: 16.
# EVEJS_LNE_GAMEMASTER_MAX_FACTS=
# gameMaster.maxActivityRegions - regions of one activity sample and of an offer. Range 1..64. Default: 16.
# EVEJS_LNE_GAMEMASTER_MAX_ACTIVITY_REGIONS=
# gameMaster.factWindowCycles - cycles of news facts in the digest. Range 1..7. Default: 2.
# EVEJS_LNE_GAMEMASTER_FACT_WINDOW_CYCLES=
# gameMaster.activitySampleMs - period of the activity sample. Range 60000..3600000. Default: 900000.
# EVEJS_LNE_GAMEMASTER_ACTIVITY_SAMPLE_MS=
# gameMaster.activityMidSamples - samples of a region for the level mid. Range 1..10000. Default: 4.
# EVEJS_LNE_GAMEMASTER_ACTIVITY_MID_SAMPLES=
# gameMaster.activityHighSamples - samples of a region for the level high. Range 1..10000. Default: 24.
# EVEJS_LNE_GAMEMASTER_ACTIVITY_HIGH_SAMPLES=
# gameMaster.promptMaxChars - longest prompt. Range 1000..8000. Default: 6000.
# EVEJS_LNE_GAMEMASTER_PROMPT_MAX_CHARS=
# gameMaster.maxProposalChars - longest proposal text (TOO_LARGE above). Range 500..16000. Default: 4000.
# EVEJS_LNE_GAMEMASTER_MAX_PROPOSAL_CHARS=
# gameMaster.maxPlanBytes - longest validated plan JSON. Range 1000..8000. Default: 6000.
# EVEJS_LNE_GAMEMASTER_MAX_PLAN_BYTES=
# gameMaster.noticeRadiusJumps - mail radius around the place in jumps. Range 0..5. Default: 3.
# EVEJS_LNE_GAMEMASTER_NOTICE_RADIUS_JUMPS=
# gameMaster.maxNoticeRecipients - recipients of one mail line. Range 1..200. Default: 30.
# EVEJS_LNE_GAMEMASTER_MAX_NOTICE_RECIPIENTS=
# gameMaster.retentionMs - ended threads, cycles, activity kept. Range 86400000..7776000000. Default: 2592000000.
# EVEJS_LNE_GAMEMASTER_RETENTION_MS=
# gameMaster.maxRetainPerPass - rows deleted per retention run. Range 1..500. Default: 50.
# EVEJS_LNE_GAMEMASTER_MAX_RETAIN_PER_PASS=
# gameMaster.boardEnabled - ACTIVE threads in the board section Nearby (source story). Default: true.
# EVEJS_LNE_GAMEMASTER_BOARD_ENABLED=

# The galactic seasons. One open season with a
# crisis (INVASION_SURGE / PIRATE_SURGE), stages in UTC, a meter defense / crisis from the world journal, news facts
# and the close with an outcome. No player points and no rewards in. Internal: not in the launcher. Flag off.
# seasons.enabled - the galactic seasons (needs modules.world, persistence, scheduler). true/false. Default: false.
# EVEJS_LNE_SEASONS_ENABLED=
# seasons.durationMs - length of a season. Range 3600000..10368000000. Default: 3628800000.
# EVEJS_LNE_SEASONS_DURATION_MS=
# seasons.stageCount - stages of a season (the last = the finale). Range 2..6. Default: 4.
# EVEJS_LNE_SEASONS_STAGE_COUNT=
# seasons.firstStartDelayMs - start of the first season after it is planned. Range 0..604800000. Default: 3600000.
# EVEJS_LNE_SEASONS_FIRST_START_DELAY_MS=
# seasons.breakMs - pause between two seasons. Range 0..2592000000. Default: 259200000.
# EVEJS_LNE_SEASONS_BREAK_MS=
# seasons.resetMode - none | offline (offline = W111, behaves like none until). Default: none.
# EVEJS_LNE_SEASONS_RESET_MODE=
# seasons.planRetryMs - retry of planning / deferral of a start. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_SEASONS_PLAN_RETRY_MS=
# seasons.scoreIntervalMs - period of SEASON_SCORE. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_SEASONS_SCORE_INTERVAL_MS=
# seasons.journalBatch - journal rows of one meter page. Range 16..2048. Default: 256.
# EVEJS_LNE_SEASONS_JOURNAL_BATCH=
# seasons.journalPagesPerPass - meter pages per pass. Range 1..32. Default: 4.
# EVEJS_LNE_SEASONS_JOURNAL_PAGES_PER_PASS=
# seasons.maxCrisisRegions - regions of a regional crisis. Range 1..10. Default: 3.
# EVEJS_LNE_SEASONS_MAX_CRISIS_REGIONS=
# seasons.invasionSpawnPoints - crisis points of an invasion of the crisis faction. Range 0..10000. Default: 30.
# EVEJS_LNE_SEASONS_INVASION_SPAWN_POINTS=
# seasons.invasionRepelPoints - defense points of a lost beachhead. Range 0..10000. Default: 50.
# EVEJS_LNE_SEASONS_INVASION_REPEL_POINTS=
# seasons.battlePoints - points of a battle of the crisis faction. Range 0..10000. Default: 3.
# EVEJS_LNE_SEASONS_BATTLE_POINTS=
# seasons.winRatioPermille - WON when defense x 1000 >= crisis x this. Range 100..10000. Default: 1000.
# EVEJS_LNE_SEASONS_WIN_RATIO_PERMILLE=
# seasons.stepRecoveryMax - recovery keys of a quarantined season step, 0 = none. Range 0..16. Default: 3.
# EVEJS_LNE_SEASONS_STEP_RECOVERY_MAX=
# Player points (crisis NPC kills in the crisis
# area, heavy event defenses), the ranking at the close and the rewards (ISK, item, mail, title) paid exactly once.
# seasons.killPoints - points of a crisis NPC killed by a player. Range 0..1000. Default: 1.
# EVEJS_LNE_SEASONS_KILL_POINTS=
# seasons.heavyDefensePoints - points of a heavy event payout in the crisis area (W116). Range 0..1000. Default: 5.
# EVEJS_LNE_SEASONS_HEAVY_DEFENSE_POINTS=
# seasons.maxPendingKeys - players of the RAM kill accumulator. Range 64..16384. Default: 2048.
# EVEJS_LNE_SEASONS_MAX_PENDING_KEYS=
# seasons.flushMaxRows - accumulator entries per SEASON_SCORE. Range 8..512. Default: 64.
# EVEJS_LNE_SEASONS_FLUSH_MAX_ROWS=
# seasons.payoutBatch - heavy event payouts read per SEASON_SCORE. Range 8..512. Default: 64.
# EVEJS_LNE_SEASONS_PAYOUT_BATCH=
# seasons.maxScoreRowsPerSeason - score rows of one season. Range 100..100000. Default: 5000.
# EVEJS_LNE_SEASONS_MAX_SCORE_ROWS_PER_SEASON=
# seasons.maxRankedPlayers - rewarded places. Range 1..500. Default: 100.
# EVEJS_LNE_SEASONS_MAX_RANKED_PLAYERS=
# seasons.minPointsForReward - least points of a reward. Range 0..1000000. Default: 10.
# EVEJS_LNE_SEASONS_MIN_POINTS_FOR_REWARD=
# seasons.tier1MaxRank - last place of CHAMPION (ranks rise, <= maxRankedPlayers). Range 1..500. Default: 1.
# EVEJS_LNE_SEASONS_TIER1_MAX_RANK=
# seasons.tier2MaxRank - last place of HERO. Range 1..500. Default: 3.
# EVEJS_LNE_SEASONS_TIER2_MAX_RANK=
# seasons.tier3MaxRank - last place of VETERAN. Range 1..500. Default: 10.
# EVEJS_LNE_SEASONS_TIER3_MAX_RANK=
# seasons.tier1Isk - ISK of CHAMPION. Range 0..10000000000. Default: 50000000.
# EVEJS_LNE_SEASONS_TIER1_ISK=
# seasons.tier2Isk - ISK of HERO. Range 0..10000000000. Default: 20000000.
# EVEJS_LNE_SEASONS_TIER2_ISK=
# seasons.tier3Isk - ISK of VETERAN. Range 0..10000000000. Default: 5000000.
# EVEJS_LNE_SEASONS_TIER3_ISK=
# seasons.tier4Isk - ISK of PARTICIPANT. Range 0..10000000000. Default: 1000000.
# EVEJS_LNE_SEASONS_TIER4_ISK=
# seasons.tier1ItemTypeId - item of CHAMPION, 0 = none (W113). Range 0..100000000. Default: 0.
# EVEJS_LNE_SEASONS_TIER1_ITEM_TYPE_ID=
# seasons.tier2ItemTypeId - item of HERO, 0 = none. Range 0..100000000. Default: 0.
# EVEJS_LNE_SEASONS_TIER2_ITEM_TYPE_ID=
# seasons.tier3ItemTypeId - item of VETERAN, 0 = none. Range 0..100000000. Default: 0.
# EVEJS_LNE_SEASONS_TIER3_ITEM_TYPE_ID=
# seasons.tier4ItemTypeId - item of PARTICIPANT, 0 = none. Range 0..100000000. Default: 0.
# EVEJS_LNE_SEASONS_TIER4_ITEM_TYPE_ID=
# seasons.tier1ItemQty - quantity of the CHAMPION item. Range 1..1000. Default: 1.
# EVEJS_LNE_SEASONS_TIER1_ITEM_QTY=
# seasons.tier2ItemQty - quantity of the HERO item. Range 1..1000. Default: 1.
# EVEJS_LNE_SEASONS_TIER2_ITEM_QTY=
# seasons.tier3ItemQty - quantity of the VETERAN item. Range 1..1000. Default: 1.
# EVEJS_LNE_SEASONS_TIER3_ITEM_QTY=
# seasons.tier4ItemQty - quantity of the PARTICIPANT item. Range 1..1000. Default: 1.
# EVEJS_LNE_SEASONS_TIER4_ITEM_QTY=
# seasons.wonBonusPermille - ISK multiplier of a WON season (per mille). Range 1000..5000. Default: 1500.
# EVEJS_LNE_SEASONS_WON_BONUS_PERMILLE=
# seasons.maxIskPerSeason - ISK of all rewards of a season, above = scaled down (W112). Range 0..100000000000. Default: 350000000.
# EVEJS_LNE_SEASONS_MAX_ISK_PER_SEASON=
# seasons.rewardFallbackStationId - item station without an NPC home station, 0 = item SKIPPED. Range 0..2147483647. Default: 60003760.
# EVEJS_LNE_SEASONS_REWARD_FALLBACK_STATION_ID=
# seasons.payOnInterrupt - rewards of an interrupted season. true/false. Default: true.
# EVEJS_LNE_SEASONS_PAY_ON_INTERRUPT=
# seasons.mailEnabled - the reward mail (EN). true/false. Default: true.
# EVEJS_LNE_SEASONS_MAIL_ENABLED=
# seasons.payoutPassMs - period of the reward pump. Range 1000..600000. Default: 15000.
# EVEJS_LNE_SEASONS_PAYOUT_PASS_MS=
# seasons.payoutMaxPerPass - reward rows per pump pass. Range 1..64. Default: 8.
# EVEJS_LNE_SEASONS_PAYOUT_MAX_PER_PASS=
# seasons.payoutMaxAttempts - transient failures before FAILED. Range 1..100. Default: 10.
# EVEJS_LNE_SEASONS_PAYOUT_MAX_ATTEMPTS=
# seasons.payoutRetryBaseMs - first backoff of a reward. Range 1000..3600000. Default: 60000.
# EVEJS_LNE_SEASONS_PAYOUT_RETRY_BASE_MS=
# seasons.payoutRetryMaxMs - longest backoff of a reward. Range 1000..86400000. Default: 3600000.
# EVEJS_LNE_SEASONS_PAYOUT_RETRY_MAX_MS=
# seasons.pruneEveryMs - period of the score retention. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_SEASONS_PRUNE_EVERY_MS=
# seasons.prunePerRun - score rows deleted per run. Range 1..5000. Default: 500.
# EVEJS_LNE_SEASONS_PRUNE_PER_RUN=
# seasons.scoreRetentionMs - scores of an ARCHIVED season kept after its close, 0 = kept. Range 0..62208000000. Default: 15552000000.
# EVEJS_LNE_SEASONS_SCORE_RETENTION_MS=
# seasons.commandEnabled - the!season command of the local chat. true/false. Default: true.
# EVEJS_LNE_SEASONS_COMMAND_ENABLED=
# seasons.viewEnabled - observer panel seasons and map layer layer-season. true/false. Default: true.
# EVEJS_LNE_SEASONS_VIEW_ENABLED=
# seasons.hintEnabled - season hint source of the Game Master (W115). true/false. Default: true.
# EVEJS_LNE_SEASONS_HINT_ENABLED=
# seasons.invasionBiasEnabled - the crisis faction weighs more in the invasion faction pick (W114). true/false. Default: false.
# EVEJS_LNE_SEASONS_INVASION_BIAS_ENABLED=
# seasons.invasionBiasPermille - weight multiplier of the crisis faction profile (per mille). Range 1000..5000. Default: 2000.
# EVEJS_LNE_SEASONS_INVASION_BIAS_PERMILLE=

# The nemesis captains. A revenge squad whose
# leader survived a fight with the killer (boss alive) leaves an ACTIVE nemesis of rank 1. No returns in.
# Needs bountyHunters.enabled + liveEnabled + revengeEnabled (W70). Internal: not in the launcher. Flag off.
# nemesis.enabled - the nemesis captains. true/false. Default: false.
# EVEJS_LNE_NEMESIS_ENABLED=
# nemesis.createOn - WIN | WIN_OR_SURVIVE. Default: WIN_OR_SURVIVE.
# EVEJS_LNE_NEMESIS_CREATE_ON=
# nemesis.maxActivePerPlayer - open nemeses of one player. Range 1..8. Default: 2.
# EVEJS_LNE_NEMESIS_MAX_ACTIVE_PER_PLAYER=
# nemesis.maxActiveTotal - open nemeses server wide (W73). Range 1..1024. Default: 64.
# EVEJS_LNE_NEMESIS_MAX_ACTIVE_TOTAL=
# nemesis.retentionMs - DEFEATED / RETIRED kept this long. Range 86400000..31536000000. Default: 7776000000.
# EVEJS_LNE_NEMESIS_RETENTION_MS=
# nemesis.historyMax - entries of the history of a nemesis. Range 1..32. Default: 8.
# EVEJS_LNE_NEMESIS_HISTORY_MAX=
# The returns, the rank, the ends, the trophy.
# Warnings W71, W72, W74, W77.
# nemesis.checksPerPass - ACTIVE rows checked for a return per check. Range 1..64. Default: 8.
# EVEJS_LNE_NEMESIS_CHECKS_PER_PASS=
# nemesis.checkEveryMs - pause between return checks. Range 10000..3600000. Default: 60000.
# EVEJS_LNE_NEMESIS_CHECK_EVERY_MS=
# nemesis.maxRank - the rank a won return can reach. Range 1..10. Default: 5.
# EVEJS_LNE_NEMESIS_MAX_RANK=
# nemesis.maxHunterLevel - captain level = min(this, base level + rank - 1). Range 1..5. Default: 5.
# EVEJS_LNE_NEMESIS_MAX_HUNTER_LEVEL=
# nemesis.maxExtraEscorts - extra escorts = min(this, rank - 1) (W74). Range 0..8. Default: 2.
# EVEJS_LNE_NEMESIS_MAX_EXTRA_ESCORTS=
# nemesis.returnCooldownMs - pause after the creation / an encounter (W77). Range 600000..1209600000. Default: 21600000.
# EVEJS_LNE_NEMESIS_RETURN_COOLDOWN_MS=
# nemesis.playerGapMs - pause between two returns to one player. Range 0..604800000. Default: 10800000.
# EVEJS_LNE_NEMESIS_PLAYER_GAP_MS=
# nemesis.returnLeadMs - a return row is due this long after it is written (W71). Range 0..3600000. Default: 120000.
# EVEJS_LNE_NEMESIS_RETURN_LEAD_MS=
# nemesis.returnWindowMs - a return row expires this long after it is written (W71, W72). Range 600000..172800000.
# Default: 7200000.
# EVEJS_LNE_NEMESIS_RETURN_WINDOW_MS=
# nemesis.maxMissedReturns - missed returns before the nemesis retires. Range 1..20. Default: 4.
# EVEJS_LNE_NEMESIS_MAX_MISSED_RETURNS=
# nemesis.idleRetireMs - an ACTIVE nemesis without an encounter this long retires (W77). Range 86400000..7776000000.
# Default: 1209600000.
# EVEJS_LNE_NEMESIS_IDLE_RETIRE_MS=
# nemesis.trophyTypeIds - empty or 1..8 type ids in the hold of the captain (unknown -> skipped). Default: empty.
# EVEJS_LNE_NEMESIS_TROPHY_TYPE_IDS=
# nemesis.trophyOfficerRolls - vendor officer loot rolls in the hold of the captain. Range 0..4. Default: 1.
# EVEJS_LNE_NEMESIS_TROPHY_OFFICER_ROLLS=
# The adaptation of a return squad to the player.
# nemesis.adaptEnabled - the escorts of a return follow the hull classes of the player (doctrine table + vendor
# EWAR profiles; the count stays). Default: false.
# EVEJS_LNE_NEMESIS_ADAPT_ENABLED=0
# nemesis.killboardProfileEnabled - one read of the killboard kills of the player at a return adds to the profile
# (W76: needs killboard.enabled). Default: false.
# EVEJS_LNE_NEMESIS_KILLBOARD_PROFILE_ENABLED=0
# nemesis.profileKills - killboard kills read per return. Range 1..100. Default: 20.
# EVEJS_LNE_NEMESIS_PROFILE_KILLS=
# nemesis.profileMaxEntries - hull classes kept in the profile (a new one drops the rarest). Range 1..16. Default: 8.
# EVEJS_LNE_NEMESIS_PROFILE_MAX_ENTRIES=
# nemesis.maxEwarEscorts - escorts of an adapted squad with an EWAR family (also <= rank). Range 0..8. Default: 2.
# EVEJS_LNE_NEMESIS_MAX_EWAR_ESCORTS=
# The letters to the player.
# nemesis.letterEnabled - a CREATED / WON / DEFEATED nemesis writes one line to the LNE mail of the player (AI text
# through chatterAi lane talk, else a template); a return may get an AI system line (W75). Default: false.
# EVEJS_LNE_NEMESIS_LETTER_ENABLED=0
# nemesis.letterMaxPerDay - AI requests of the letters per UTC day and process (0 = templates only). Range 0..1000.
# Default: 48.
# EVEJS_LNE_NEMESIS_LETTER_MAX_PER_DAY=
# nemesis.letterMinGapMs - pause between two letters to one player. Range 0..86400000. Default: 1800000.
# EVEJS_LNE_NEMESIS_LETTER_MIN_GAP_MS=
# nemesis.letterWaitMs - the wait for the AI text before the template. Range 5000..600000. Default: 60000.
# EVEJS_LNE_NEMESIS_LETTER_WAIT_MS=
# nemesis.letterMaxChars - characters of one letter line, frame included. Range 40..400. Default: 240.
# EVEJS_LNE_NEMESIS_LETTER_MAX_CHARS=
# nemesis.letterMaxAgeMs - an older pending letter is skipped. Range 3600000..604800000. Default: 86400000.
# EVEJS_LNE_NEMESIS_LETTER_MAX_AGE_MS=

# The roaming world bosses. A boss walks
# the gates (DWELL <-> MOVING), drops the influence of the controller at the end of a dwell and has a beacon site per
# visit. No battle in. Internal: not in the launcher. Flags off (flag off with open bosses = drain to CANCELLED).
# worldBosses.enabled - the world bosses (needs modules.world, persistence; beacons modules.sites). Default: false.
# EVEJS_LNE_WORLD_BOSSES_ENABLED=
# worldBosses.kindsCsv - boss kinds (drifter_swarm, triglavian_armada; rogue_mother_hive invalid = W103). Default: drifter_swarm.
# EVEJS_LNE_WORLD_BOSSES_KINDS_CSV=
# worldBosses.secClasses - comma list of highsec|lowsec|nullsec. Default: nullsec.
# EVEJS_LNE_WORLD_BOSSES_SEC_CLASSES=
# worldBosses.excludedRegionIdsCsv - regions never entered; empty = Pochven, Zarzakh. Default: empty.
# EVEJS_LNE_WORLD_BOSSES_EXCLUDED_REGION_IDS_CSV=
# worldBosses.maxActive - open bosses at a time. Range 1..4. Default: 1.
# EVEJS_LNE_WORLD_BOSSES_MAX_ACTIVE=
# worldBosses.passIntervalMs - period of the own pass. Range 5000..600000. Default: 60000.
# EVEJS_LNE_WORLD_BOSSES_PASS_INTERVAL_MS=
# worldBosses.roll.enabled - the own roll of a boss (spawnInTx of the seasons works without it). Default: false.
# EVEJS_LNE_WORLD_BOSSES_ROLL_ENABLED=
# worldBosses.roll.intervalMs - one roll per bucket of this length. Range 3600000..2592000000. Default: 604800000.
# EVEJS_LNE_WORLD_BOSSES_ROLL_INTERVAL_MS=
# worldBosses.roll.chancePermille - chance of a roll. Range 0..1000. Default: 500.
# EVEJS_LNE_WORLD_BOSSES_ROLL_CHANCE_PERMILLE=
# worldBosses.cooldownMs - no rolled boss this long after the last end. Range 0..2592000000. Default: 259200000.
# EVEJS_LNE_WORLD_BOSSES_COOLDOWN_MS=
# worldBosses.spawn.minJumps - least jumps from a player. Range 1..40. Default: 4.
# EVEJS_LNE_WORLD_BOSSES_SPAWN_MIN_JUMPS=
# worldBosses.spawn.maxJumps - most jumps from a player (<= graph.routeMaxJumps). Range 1..40. Default: 10.
# EVEJS_LNE_WORLD_BOSSES_SPAWN_MAX_JUMPS=
# worldBosses.spawn.maxBfsSystems - systems of the spawn BFS. Range 100..20000. Default: 4000.
# EVEJS_LNE_WORLD_BOSSES_SPAWN_MAX_BFS_SYSTEMS=
# worldBosses.dwellMs - stay in one system. Range 60000..86400000. Default: 10800000.
# EVEJS_LNE_WORLD_BOSSES_DWELL_MS=
# worldBosses.hopMs - travel through one gate. Range 10000..86400000. Default: 1800000.
# EVEJS_LNE_WORLD_BOSSES_HOP_MS=
# worldBosses.maxHops - hops before MAX_HOPS. Range 1..500. Default: 40.
# EVEJS_LNE_WORLD_BOSSES_MAX_HOPS=
# worldBosses.maxLifetimeMs - life before LIFETIME (W107). Range 3600000..2592000000. Default: 604800000.
# EVEJS_LNE_WORLD_BOSSES_MAX_LIFETIME_MS=
# worldBosses.avoidRevisitHops - last systems the route avoids. Range 0..64. Default: 8.
# EVEJS_LNE_WORLD_BOSSES_AVOID_REVISIT_HOPS=
# worldBosses.route.goalBiasPermille - chance of the hop towards the goal. Range 0..1000. Default: 600.
# EVEJS_LNE_WORLD_BOSSES_ROUTE_GOAL_BIAS_PERMILLE=
# worldBosses.regenPermillePerHour - regeneration of a damaged unit per hour. Range 0..1000. Default: 20.
# EVEJS_LNE_WORLD_BOSSES_REGEN_PERMILLE_PER_HOUR=
# worldBosses.blightPoints - influence lost by the controller per dwell (x phase permille). Range 0..1000. Default: 15.
# EVEJS_LNE_WORLD_BOSSES_BLIGHT_POINTS=
# worldBosses.beaconTemplateId - template of the beacon site. Default: client-dungeon:6366.
# EVEJS_LNE_WORLD_BOSSES_BEACON_TEMPLATE_ID=
# worldBosses.retentionMs - ended bosses kept this long. Range 86400000..31536000000. Default: 2592000000.
# EVEJS_LNE_WORLD_BOSSES_RETENTION_MS=
# worldBosses.pruneEveryMs - period of the retention. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_WORLD_BOSSES_PRUNE_EVERY_MS=
# worldBosses.prunePerRun - bosses deleted per retention run. Range 1..1000. Default: 50.
# EVEJS_LNE_WORLD_BOSSES_PRUNE_PER_RUN=
# virtual clash rounds of the pass and the answer of the factions.
# worldBosses.clash.enabled - clash rounds and the settlement consequence worldBosses. Default: false.
# EVEJS_LNE_WORLD_BOSSES_CLASH_ENABLED=
# worldBosses.clash.firstDelayMs - first round after an arrival. Range 0..86400000. Default: 600000.
# EVEJS_LNE_WORLD_BOSSES_CLASH_FIRST_DELAY_MS=
# worldBosses.clash.intervalMs - period of the rounds (W105). Range 60000..86400000. Default: 1800000.
# EVEJS_LNE_WORLD_BOSSES_CLASH_INTERVAL_MS=
# worldBosses.clash.maxOpen - open battles of one boss. Range 1..16. Default: 4.
# EVEJS_LNE_WORLD_BOSSES_CLASH_MAX_OPEN=
# worldBosses.clash.maxFleetsPerSide - fleets of one round (W104). Range 1..32. Default: 8.
# EVEJS_LNE_WORLD_BOSSES_CLASH_MAX_FLEETS_PER_SIDE=
# worldBosses.clash.maxFleetsRead - fleets of the boss system read per round. Range 1..256. Default: 32.
# EVEJS_LNE_WORLD_BOSSES_CLASH_MAX_FLEETS_READ=
# worldBosses.clash.roles - fleet roles that fight a boss. Default: garrison,patrol,invasion,reserve,mercenary.
# EVEJS_LNE_WORLD_BOSSES_CLASH_ROLES=
# worldBosses.clash.attackerRetreatLossPermille - losses before side A retreats. Range 50..1000. Default: 300.
# EVEJS_LNE_WORLD_BOSSES_CLASH_ATTACKER_RETREAT_LOSS_PERMILLE=
# worldBosses.clash.moveWaitMaxMs - a departure waits for open battles. Range 0..86400000. Default: 3600000.
# EVEJS_LNE_WORLD_BOSSES_CLASH_MOVE_WAIT_MAX_MS=
# worldBosses.response.enabled - factions send idle fleets to a boss (W109). Default: false.
# EVEJS_LNE_WORLD_BOSSES_RESPONSE_ENABLED=
# worldBosses.response.rangeJumps - jumps from a controlled system (W106). Range 1..40. Default: 6.
# EVEJS_LNE_WORLD_BOSSES_RESPONSE_RANGE_JUMPS=
# worldBosses.response.maxPerReview - LAUNCH boss_response per review. Range 0..8. Default: 1.
# EVEJS_LNE_WORLD_BOSSES_RESPONSE_MAX_PER_REVIEW=
# worldBosses.response.strengthPermille - strength needed per 1000 of the boss. Range 1..10000. Default: 600.
# EVEJS_LNE_WORLD_BOSSES_RESPONSE_STRENGTH_PERMILLE=
# worldBosses.response.kinds - faction kinds that answer a boss. Default: empire,pirate.
# EVEJS_LNE_WORLD_BOSSES_RESPONSE_KINDS=
# worldBosses.response.windowMs - window of a boss_response operation. Range 600000..604800000. Default: 21600000.
# EVEJS_LNE_WORLD_BOSSES_RESPONSE_WINDOW_MS=
# worldBosses.response.minLeadMs - min time left before the boss leaves to send a response. Range 0..86400000. Default: 1800000.
# EVEJS_LNE_WORLD_BOSSES_RESPONSE_MIN_LEAD_MS=
# worldBosses.response.maxTargetsRead - bosses read per faction review. Range 1..16. Default: 4.
# EVEJS_LNE_WORLD_BOSSES_RESPONSE_MAX_TARGETS_READ=
# The LIVE fight in phases (EveJS ships at the beacon while a player is
# on its grid) and the ETA mail at a departure. Both flags off =.
# worldBosses.live.enabled - the LIVE fight (needs modules.presence, W108). Default: false.
# EVEJS_LNE_WORLD_BOSSES_LIVE_ENABLED=
# worldBosses.live.pumpIntervalMs - period of the LIVE pump. Range 1000..60000. Default: 5000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_PUMP_INTERVAL_MS=
# worldBosses.live.maxShipsPerPhase - live boss ships at a time (W102). Range 1..64. Default: 12.
# EVEJS_LNE_WORLD_BOSSES_LIVE_MAX_SHIPS_PER_PHASE=
# worldBosses.live.gridRadiusM - a player this close to the beacon is on its grid. Range 10000..1000000. Default: 150000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_GRID_RADIUS_M=
# worldBosses.live.spawnDistanceM - spawn distance from the beacon. Range 1000..200000. Default: 30000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_SPAWN_DISTANCE_M=
# worldBosses.live.aggroRangeM - proximity aggro range of the boss ships. Range 1000..500000. Default: 100000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_AGGRO_RANGE_M=
# worldBosses.live.leashRangeM - leash range of the boss ships. Range 1000..1000000. Default: 200000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_LEASH_RANGE_M=
# worldBosses.live.abandonGraceMs - no player on the grid this long -> VIRTUAL. Range 10000..3600000. Default: 120000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_ABANDON_GRACE_MS=
# worldBosses.live.maxMs - longest LIVE episode. Range 600000..86400000. Default: 7200000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_MAX_MS=
# worldBosses.live.moveHoldMs - a departure during LIVE is moved by this much. Range 0..86400000. Default: 1800000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_MOVE_HOLD_MS=
# worldBosses.live.maxParticipants - participant rows of one boss. Range 1..512. Default: 64.
# EVEJS_LNE_WORLD_BOSSES_LIVE_MAX_PARTICIPANTS=
# worldBosses.live.spawnRetries - further waves for a unit with a transient spawn error. Range 0..10. Default: 2.
# EVEJS_LNE_WORLD_BOSSES_LIVE_SPAWN_RETRIES=
# worldBosses.live.spawnRetryCooldownMs - no LIVE start this long after a transient refusal. Range 10000..3600000. Default: 300000.
# EVEJS_LNE_WORLD_BOSSES_LIVE_SPAWN_RETRY_COOLDOWN_MS=
# worldBosses.notices.enabled - the ETA mail at a departure (needs the notices module). Default: false.
# EVEJS_LNE_WORLD_BOSSES_NOTICES_ENABLED=
# worldBosses.notices.radiusJumps - jumps from the next system to a mailed player. Range 0..20. Default: 5.
# EVEJS_LNE_WORLD_BOSSES_NOTICES_RADIUS_JUMPS=
# worldBosses.notices.maxRecipients - mailed players of one departure. Range 1..500. Default: 50.
# EVEJS_LNE_WORLD_BOSSES_NOTICES_MAX_RECIPIENTS=
# worldBosses.rewards.enabled - a LIVE defeat leaves a chest at the beacon and ISK for the participants. Default: false.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_ENABLED=
# worldBosses.rewards.iskPool - ISK shared by the participants of one boss. Range 0..10000000000. Default: 500000000.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_ISK_POOL=
# worldBosses.rewards.iskMaxPerCharacter - cap of the ISK of one participant. Range 0..10000000000. Default: 100000000.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_ISK_MAX_PER_CHARACTER=
# worldBosses.rewards.maxAttempts - refused chest placements before SKIPPED. Range 1..50. Default: 5.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_MAX_ATTEMPTS=
# worldBosses.rewards.maxAgeMs - a PENDING reward older than this is SKIPPED. Range 3600000..2592000000. Default: 86400000.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_MAX_AGE_MS=
# worldBosses.rewards.aftermathMs - the beacon and the chest stay this long. Range 60000..86400000. Default: 1800000.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_AFTERMATH_MS=
# worldBosses.rewards.chestOffsetM - distance of the chest from the beacon. Range 0..100000. Default: 2000.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_CHEST_OFFSET_M=
# worldBosses.rewards.lootRolls - loot rolls of the chest. Range 1..20. Default: 4.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_LOOT_ROLLS=
# worldBosses.rewards.fallbackLootTableId - vendor loot table without a faction table. Default: generic_random_any.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_FALLBACK_LOOT_TABLE_ID=
# worldBosses.rewards.payoutBatch - ISK payouts per pump pass. Range 1..200. Default: 20.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_PAYOUT_BATCH=
# worldBosses.rewards.payoutRetryBaseMs - first backoff of a failed payout. Range 1000..3600000. Default: 60000.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_PAYOUT_RETRY_BASE_MS=
# worldBosses.rewards.payoutRetryMaxMs - longest backoff of a payout. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_PAYOUT_RETRY_MAX_MS=
# worldBosses.rewards.payoutMaxAttempts - transient failures before FAILED. Range 1..50. Default: 8.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_PAYOUT_MAX_ATTEMPTS=
# worldBosses.rewards.payoutRetentionMs - settled payouts are kept this long. Range 86400000..31536000000. Default: 2592000000.
# EVEJS_LNE_WORLD_BOSSES_REWARDS_PAYOUT_RETENTION_MS=
# worldBosses.newsEnabled - the news kinds WORLD_BOSS_* (needs news.enabled). Default: false.
# EVEJS_LNE_WORLD_BOSSES_NEWS_ENABLED=
# worldBosses.gm.enabled - the Game Master step BOSS and the hint source worldBosses. Default: false.
# EVEJS_LNE_WORLD_BOSSES_GM_ENABLED=
# worldBosses.gm.rangeJumps - jumps from the thread anchor to the boss of a BOSS step. Range 1..40. Default: 6.
# EVEJS_LNE_WORLD_BOSSES_GM_RANGE_JUMPS=
# worldBosses.gm.pollMs - poll period of a BOSS step. Range 60000..3600000. Default: 600000.
# EVEJS_LNE_WORLD_BOSSES_GM_POLL_MS=
# worldBosses.endReplayMs - recent ends told again to the end listeners after a restart (0 = off). Range 0..86400000. Default: 600000.
# EVEJS_LNE_WORLD_BOSSES_END_REPLAY_MS=

# A rare virtual gank on a highsec pipe (Uedama, Sivala,...) leaves a wreck field
# (owned by an NPC corporation, salvage anomaly) and a GANK rumour in Local. No entity, no fight, no CONCORD.
# One field per system and bucket (journal key hsgank:<system>:<bucket>). Needs highsecLife.civilians.enabled.

# highsecLife.gank.enabled - Virtual ganks. Range: true/false. Default: false.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_ENABLED=

# highsecLife.gank.systemIds - Gank pipes, 1..16 distinct system ids. Default: 30002768,30002765,30003503,30002641.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_SYSTEM_IDS=

# highsecLife.gank.pollMs - Period of the gank pass. Range 10000..600000. Default: 60000.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_POLL_MS=

# highsecLife.gank.bucketMs - Time bucket, at most one gank per system and bucket. Range 3600000..86400000.
# Default: 14400000.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_BUCKET_MS=

# highsecLife.gank.chancePermille - Chance of a gank per bucket (x the hour curve / 1000). Range 0..1000. Default: 300.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_CHANCE_PERMILLE=

# highsecLife.gank.freighterPermille - Chance of a freighter victim. Range 0..1000. Default: 400.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_FREIGHTER_PERMILLE=

# highsecLife.gank.gankersFreighterMin - Fewest Catalysts on a freighter. Range 0..30. Default: 8.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_GANKERS_FREIGHTER_MIN=

# highsecLife.gank.gankersFreighterMax - Most Catalysts on a freighter. Range 0..30. Default: 14.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_GANKERS_FREIGHTER_MAX=

# highsecLife.gank.gankersHaulerMin - Fewest Catalysts on an industrial. Range 0..30. Default: 2.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_GANKERS_HAULER_MIN=

# highsecLife.gank.gankersHaulerMax - Most Catalysts on an industrial. Range 0..30. Default: 4.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_GANKERS_HAULER_MAX=

# highsecLife.gank.fieldTtlMs - Life of the gank wreck field. Range 3600000..604800000. Default: 21600000.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_FIELD_TTL_MS=

# highsecLife.gank.maxPerPass - Gank fields written per pass. Range 1..16. Default: 1.
# EVEJS_LNE_HIGHSEC_LIFE_GANK_MAX_PER_PASS=

# Rat waves while a player mines (noise of the mining ledger: modules, drones
# shipWing copies of the owner). Memory only; needs modules.world. Internal: not in the launcher. Read at boot.
# = core only (no hook yet). Enable only after it is verified in the game.
# miningEncounters.enabled - Feature flag. true/false. Default: false.
# EVEJS_LNE_MINING_ENCOUNTERS_ENABLED=

# miningEncounters.highsecEnabled - waves also in highsec (sized by securityBands). true/false. Default: true.
# EVEJS_LNE_MINING_ENCOUNTERS_HIGHSEC_ENABLED=

# miningEncounters.noisePerEvent - Noise of one ledger row. Range 1..100. Default: 1.
# EVEJS_LNE_MINING_ENCOUNTERS_NOISE_PER_EVENT=

# miningEncounters.maxNoisePerMinute - Noise ceiling of one miner and system per minute. Range 1..600. Default: 3.
# EVEJS_LNE_MINING_ENCOUNTERS_MAX_NOISE_PER_MINUTE=

# miningEncounters.threshold - Noise that rolls for a wave. Range 1..10000. Default: 12.
# EVEJS_LNE_MINING_ENCOUNTERS_THRESHOLD=

# miningEncounters.chanceHighsec - Wave chance at the threshold, highsec. Range 0..1. Default: 0.4.
# EVEJS_LNE_MINING_ENCOUNTERS_CHANCE_HIGHSEC=

# miningEncounters.chanceLowsec - Wave chance at the threshold, lowsec. Range 0..1. Default: 0.6.
# EVEJS_LNE_MINING_ENCOUNTERS_CHANCE_LOWSEC=

# miningEncounters.chanceNullsec - Wave chance at the threshold, nullsec. Range 0..1. Default: 0.75.
# EVEJS_LNE_MINING_ENCOUNTERS_CHANCE_NULLSEC=

# miningEncounters.missKeepRatio - Part of the threshold kept after a missed roll. Range 0..1. Default: 0.5.
# EVEJS_LNE_MINING_ENCOUNTERS_MISS_KEEP_RATIO=

# miningEncounters.waveCooldownMs - Minimum time between two waves. Range 30000..3600000. Default: 300000.
# EVEJS_LNE_MINING_ENCOUNTERS_WAVE_COOLDOWN_MS=

# miningEncounters.idleResetMs - No mining this long = a new session. Range 60000..7200000. Default: 600000.
# EVEJS_LNE_MINING_ENCOUNTERS_IDLE_RESET_MS=

# miningEncounters.maxWaves - Waves of one session (then none until idle). Range 1..20. Default: 5.
# EVEJS_LNE_MINING_ENCOUNTERS_MAX_WAVES=

# miningEncounters.growthPerWave - Ships added per next wave. Range 0..5. Default: 1.
# EVEJS_LNE_MINING_ENCOUNTERS_GROWTH_PER_WAVE=

# miningEncounters.maxShipsPerWave - Ship ceiling of one wave. Range 1..20. Default: 8.
# EVEJS_LNE_MINING_ENCOUNTERS_MAX_SHIPS_PER_WAVE=

# miningEncounters.specialMinWave - First wave that may be special. Range 1..20. Default: 2.
# EVEJS_LNE_MINING_ENCOUNTERS_SPECIAL_MIN_WAVE=

# miningEncounters.specialChanceBase - Special chance at specialMinWave. Range 0..1. Default: 0.03.
# EVEJS_LNE_MINING_ENCOUNTERS_SPECIAL_CHANCE_BASE=

# miningEncounters.specialChancePerWave - Special chance added per next wave. Range 0..1. Default: 0.03.
# EVEJS_LNE_MINING_ENCOUNTERS_SPECIAL_CHANCE_PER_WAVE=

# miningEncounters.specialChanceMax - Special chance ceiling. Range 0..1. Default: 0.25.
# EVEJS_LNE_MINING_ENCOUNTERS_SPECIAL_CHANCE_MAX=

# miningEncounters.specialWeightHauler - Weight of a hauler wave. Range 0..1000. Default: 70.
# EVEJS_LNE_MINING_ENCOUNTERS_SPECIAL_WEIGHT_HAULER=

# miningEncounters.specialWeightCommander - Weight of a commander wave. Range 0..1000. Default: 27.
# EVEJS_LNE_MINING_ENCOUNTERS_SPECIAL_WEIGHT_COMMANDER=

# miningEncounters.specialWeightOfficer - Weight of an officer wave. Range 0..1000. Default: 3.
# EVEJS_LNE_MINING_ENCOUNTERS_SPECIAL_WEIGHT_OFFICER=

# miningEncounters.maxTrackedMiners - Tracked (miner, system) entries. Range 16..4096. Default: 256.
# EVEJS_LNE_MINING_ENCOUNTERS_MAX_TRACKED_MINERS=

# miningEncounters.maxBeltGroupsPerSystem - Belt rat groups of a system at which a wave waits. Range 1..64. Default: 4.
# EVEJS_LNE_MINING_ENCOUNTERS_MAX_BELT_GROUPS_PER_SYSTEM=

# miningEncounters.maxWavesPerMinute - Waves per minute, server wide. Range 1..120. Default: 6.
# EVEJS_LNE_MINING_ENCOUNTERS_MAX_WAVES_PER_MINUTE=

# miningEncounters.maxSpawnsPerFlush - Waves spawned in one flush. Range 1..16. Default: 2.
# EVEJS_LNE_MINING_ENCOUNTERS_MAX_SPAWNS_PER_FLUSH=

# miningEncounters.anomalyEnabled - Sub3: no belt under the miner = the wave spawns at the ship (ore anomalies);
# off = NOT_AT_BELT as in. Default: false.
# EVEJS_LNE_MINING_ENCOUNTERS_ANOMALY_ENABLED=

# miningEncounters.anomalySpawnDistanceMeters - Sub3: spawn distance of an anomaly wave from the ship; own waves
# within 2x of it = the anomaly is busy. Range 5000..100000. Default: 20000.
# EVEJS_LNE_MINING_ENCOUNTERS_ANOMALY_SPAWN_DISTANCE_METERS=

# The pirate haulers of a hauler wave warp off and despawn instead
# of looping approach/flee around 200 km (no wreck, no bounty for the escape).
# miningEncounters.haulerWarpOutEnabled - Hauler waves warp off and despawn; off = the vendor behaviour. Default: true.
# EVEJS_LNE_MINING_ENCOUNTERS_HAULER_WARP_OUT_ENABLED=

# miningEncounters.haulerWarpOutRangeMeters - A hauler this far from the miner's ship warps off (the vendor profile
# orbits at 200 km). Range 10000..300000. Default: 150000.
# EVEJS_LNE_MINING_ENCOUNTERS_HAULER_WARP_OUT_RANGE_METERS=

# miningEncounters.haulerWarpOutAfterMs - A hauler wave this old warps off whatever the distance.
# Range 10000..3600000. Default: 180000.
# EVEJS_LNE_MINING_ENCOUNTERS_HAULER_WARP_OUT_AFTER_MS=

# miningEncounters.haulerWarpOutCheckMs - Interval of the hauler check (own timer only while hauler waves are
# tracked). Range 1000..60000. Default: 5000.
# EVEJS_LNE_MINING_ENCOUNTERS_HAULER_WARP_OUT_CHECK_MS=

# Ore mining in a system with an active LNE rich vein
# makes noise faster (needs richVeins.enabled).
# miningEncounters.richVeinNoisePermille - Noise of one ore ledger row in a system with an active rich vein, permille
# of noisePerEvent (floor, at least noisePerEvent); the same permille scales maxNoisePerMinute there.
# 1000 = no change. Range 1000..10000.
# Default: 2000.
# EVEJS_LNE_MINING_ENCOUNTERS_RICH_VEIN_NOISE_PERMILLE=

# miningEncounters.securityBands - wave size by security: minSec:sizeMultiplier:specialChanceMultiplier
# separated by ; (a system takes the band with the highest minSec <= its security). Higher security = smaller
# waves. Default: 0.75:0.5:0.5;0.55:0.75:0.75;0.45:1:1;0:1.5:1.25;-1:2:1.5
# EVEJS_LNE_MINING_ENCOUNTERS_SECURITY_BANDS=

# A rare escalation lead (EVE mail) to a DED signature
# 1-5 jumps away after players clear a combat anomaly. Internal: not in the launcher. adds only the keys; the
# service `escalations` comes in (needs the sites and notices modules).
# escalations.enabled - Feature flag. true/false. Default: false.
# EVEJS_LNE_ESCALATIONS_ENABLED=
# escalations.chance - lead chance per cleared combat anomaly. Range 0..1. Default: 0.07.
# EVEJS_LNE_ESCALATIONS_CHANCE=
# escalations.minJumps / maxJumps - target distance in jumps. Range 0..10 / 1..10. Default: 1 / 5.
# EVEJS_LNE_ESCALATIONS_MIN_JUMPS=
# EVEJS_LNE_ESCALATIONS_MAX_JUMPS=
# escalations.leadTtlMs - Life of the DED site of a lead. Range 3600000..604800000. Default: 86400000.
# EVEJS_LNE_ESCALATIONS_LEAD_TTL_MS=
# escalations.maxPerCharacterPerDay / maxPerDay / maxActive - limits (character and server in limitWindowMs
# live leads). Ranges 1..50 / 1..500 / 1..100. Default: 2 / 20 / 10.
# EVEJS_LNE_ESCALATIONS_MAX_PER_CHARACTER_PER_DAY=
# EVEJS_LNE_ESCALATIONS_MAX_PER_DAY=
# EVEJS_LNE_ESCALATIONS_MAX_ACTIVE=
# escalations.limitWindowMs - Window of the limits. Range 3600000..604800000. Default: 86400000.
# EVEJS_LNE_ESCALATIONS_LIMIT_WINDOW_MS=
# escalations.maxRecipients - Characters mailed by one lead. Range 1..50. Default: 10.
# EVEJS_LNE_ESCALATIONS_MAX_RECIPIENTS=
# escalations.maxTargetAttempts - (system, template) pairs tried when the sites refuse one. Range 1..10. Default: 3.
# EVEJS_LNE_ESCALATIONS_MAX_TARGET_ATTEMPTS=
# escalations.maxDedHighsec / maxDedLowsec / maxDedNullsec - DED cap of a band, 0 = band off. Range 0..10.
# Default: 4 / 5 / 6.
# EVEJS_LNE_ESCALATIONS_MAX_DED_HIGHSEC=
# EVEJS_LNE_ESCALATIONS_MAX_DED_LOWSEC=
# EVEJS_LNE_ESCALATIONS_MAX_DED_NULLSEC=
# escalations.matchFaction - Template of the anomaly faction when the band has one. true/false. Default: true.
# EVEJS_LNE_ESCALATIONS_MATCH_FACTION=
# escalations.excludedOrigins - CSV of vendor siteOrigin without leads (LNE sites never lead). Default:
# sansha_incursion
# EVEJS_LNE_ESCALATIONS_EXCLUDED_ORIGINS=
# escalations.siteKind - template (scan the signature down), signature or anomaly. Default: template.
# EVEJS_LNE_ESCALATIONS_SITE_KIND=
# escalations.queueMax / queueMaxAgeMs - completions waiting in memory and their age. Ranges 1..1000
# 60000..3600000. Default: 64 / 600000.
# EVEJS_LNE_ESCALATIONS_QUEUE_MAX=
# EVEJS_LNE_ESCALATIONS_QUEUE_MAX_AGE_MS=
# escalations.passIntervalMs / maxPerPass - Timer of the pass and completions per pass. Ranges 5000..600000 /
# 1..100. Default: 30000 / 8.
# EVEJS_LNE_ESCALATIONS_PASS_INTERVAL_MS=
# EVEJS_LNE_ESCALATIONS_MAX_PER_PASS=
# escalations.retentionMs / retentionDeletesPerPass - rows kept after expiry and deletes per pass. Ranges
# 86400000..2592000000 / 1..1000. Default: 604800000 / 100. A row is never deleted before limitWindowMs has passed.
# EVEJS_LNE_ESCALATIONS_RETENTION_MS=
# EVEJS_LNE_ESCALATIONS_RETENTION_DELETES_PER_PASS=

# A won data / relic hack in lowsec / nullsec may open a
# personal Jove / Drifter trail (one per player and season, stage 1 in nullsec of another region, hint by mail,
# `!relic`). Internal: not in the launcher. has no stage location yet: a trail ends EXPIRED after chainMaxMs.
# archaeology.enabled - Feature flag (module sites + persistence). Off = ACTIVE trails CANCELLED at start. Default: false.
# EVEJS_LNE_ARCHAEOLOGY_ENABLED=
# archaeology.seasonKey - Season of a trail when the seasons service has none. [a-z0-9_-]{1,16}. Default: s0.
# EVEJS_LNE_ARCHAEOLOGY_SEASON_KEY=
# archaeology.passIntervalMs / maxRowsPerPass / maxHackQueue - Timer of the pass, rows per pass, wins in memory.
# Ranges 5000..900000 / 1..256 / 16..4096. Default: 60000 / 32 / 256.
# EVEJS_LNE_ARCHAEOLOGY_PASS_INTERVAL_MS=
# EVEJS_LNE_ARCHAEOLOGY_MAX_ROWS_PER_PASS=
# EVEJS_LNE_ARCHAEOLOGY_MAX_HACK_QUEUE=
# archaeology.maxActiveChains / chainsPerCharacterPerSeason / restartCooldownMs - Limits. Ranges 1..512 / 1..10 /
# 0..2592000000. Default: 32 / 1 / 86400000.
# EVEJS_LNE_ARCHAEOLOGY_MAX_ACTIVE_CHAINS=
# EVEJS_LNE_ARCHAEOLOGY_CHAINS_PER_CHARACTER_PER_SEASON=
# EVEJS_LNE_ARCHAEOLOGY_RESTART_COOLDOWN_MS=
# archaeology.startChancePermille / startSecClasses - Seeded chance of a won hack and the security classes of its
# system. Range 0..1000 / a comma list of highsec|lowsec|nullsec|wormhole|other. Default: 100 / lowsec,nullsec.
# EVEJS_LNE_ARCHAEOLOGY_START_CHANCE_PERMILLE=
# EVEJS_LNE_ARCHAEOLOGY_START_SEC_CLASSES=
# archaeology.stageCountMin / stageCountMax - Archives of a trail. Range 2..8. Default: 4 / 6.
# EVEJS_LNE_ARCHAEOLOGY_STAGE_COUNT_MIN=
# EVEJS_LNE_ARCHAEOLOGY_STAGE_COUNT_MAX=
# archaeology.minJumps / maxJumps / maxBfsNodes - Distance of a stage and the search ceiling. Ranges 1..60 / 1..60 /
# 100..20000. Default: 6 / 20 / 4000.
# EVEJS_LNE_ARCHAEOLOGY_MIN_JUMPS=
# EVEJS_LNE_ARCHAEOLOGY_MAX_JUMPS=
# EVEJS_LNE_ARCHAEOLOGY_MAX_BFS_NODES=
# archaeology.hostileNullPermille / hostileRegionTries - Share of stages in a held system and regions read for it.
# Ranges 0..1000 / 1..8. Default: 400 / 3.
# EVEJS_LNE_ARCHAEOLOGY_HOSTILE_NULL_PERMILLE=
# EVEJS_LNE_ARCHAEOLOGY_HOSTILE_REGION_TRIES=
# archaeology.spawnRadiusJumps / stageSiteMs / chainMaxMs - Wake radius (hint text), archive life, trail
# life. Ranges 0..3 / 3600000..259200000 / 86400000..7776000000. Default: 1 / 21600000 / 1814400000.
# EVEJS_LNE_ARCHAEOLOGY_SPAWN_RADIUS_JUMPS=
# EVEJS_LNE_ARCHAEOLOGY_STAGE_SITE_MS=
# EVEJS_LNE_ARCHAEOLOGY_CHAIN_MAX_MS=
# archaeology.commandEnabled / language - The !relic command and the language (en|pl). Default: true / en.
# EVEJS_LNE_ARCHAEOLOGY_COMMAND_ENABLED=
# EVEJS_LNE_ARCHAEOLOGY_LANGUAGE=
# archaeology.retentionMs / retentionDeletesPerPass - Ended trails kept and deletes per pass. Ranges
# 86400000..31536000000 / 1..1000. Default: 5184000000 / 100.
# EVEJS_LNE_ARCHAEOLOGY_RETENTION_MS=
# EVEJS_LNE_ARCHAEOLOGY_RETENTION_DELETES_PER_PASS=
# archaeology.presenceCheckMs / sitePollMs / retryMs - stage sites: presence check, site check, retry of a refused
# site or a missing place. Ranges 10000..600000 / 10000..600000 / 60000..21600000. Default: 60000 / 60000 / 600000.
# EVEJS_LNE_ARCHAEOLOGY_PRESENCE_CHECK_MS=
# EVEJS_LNE_ARCHAEOLOGY_SITE_POLL_MS=
# EVEJS_LNE_ARCHAEOLOGY_RETRY_MS=
# archaeology.maxRelocations / maxPlaceRetries - Thefts of a stage and attempts at the next place before the trail
# expires. Ranges 0..10 / 1..48. Default: 3 / 6.
# EVEJS_LNE_ARCHAEOLOGY_MAX_RELOCATIONS=
# EVEJS_LNE_ARCHAEOLOGY_MAX_PLACE_RETRIES=
# archaeology.archiveDifficultyStart / archiveDifficultyStep / archiveOffsetMeters - The archive container: hacking
# difficulty of stage 1, added per stage (max 5), offset from the copied container. Ranges 0..5 / 0..2 / 0..20000.
# Default: 2 / 1 / 3000.
# EVEJS_LNE_ARCHAEOLOGY_ARCHIVE_DIFFICULTY_START=
# EVEJS_LNE_ARCHAEOLOGY_ARCHIVE_DIFFICULTY_STEP=
# EVEJS_LNE_ARCHAEOLOGY_ARCHIVE_OFFSET_METERS=
# archaeology.wormholeStagesEnabled - experimental: a next stage may lead through an open vendor wormhole into
# J-space (needs the vendor wormholesEnabled; else the stage falls back). true/false. Default: false.
# EVEJS_LNE_ARCHAEOLOGY_WORMHOLE_STAGES_ENABLED=
# archaeology.wormholePermille / whStageMs / whMinRemainingMs / whMaxPairs - Chance of a wormhole stage, its longest
# life, the shortest remaining life of the pair, most pairs read per pass. Ranges 0..1000 / 3600000..604800000 /
# 0..86400000 / 64..65536. Default: 250 / 86400000 / 14400000 / 4096.
# EVEJS_LNE_ARCHAEOLOGY_WORMHOLE_PERMILLE=
# EVEJS_LNE_ARCHAEOLOGY_WH_STAGE_MS=
# EVEJS_LNE_ARCHAEOLOGY_WH_MIN_REMAINING_MS=
# EVEJS_LNE_ARCHAEOLOGY_WH_MAX_PAIRS=
# archaeology.finalRewardJoveCsv / finalRewardDrifterCsv - Reward of the last archive, up to 4 typeId:quantity[:runs]
# (a blueprint = a copy with runs). Empty = only the template loot. The types need customTypes + ApplyClientData.
# Default: 341601:1:3,341604:1 / 341603:1:3,341605:1.
# EVEJS_LNE_ARCHAEOLOGY_FINAL_REWARD_JOVE_CSV=
# EVEJS_LNE_ARCHAEOLOGY_FINAL_REWARD_DRIFTER_CSV=
# archaeology.loreAiEnabled - experimental: the lore fragment of a found archive by chatterAi (talk lane); a
# refusal, a filter or no answer within loreWaitMs = the template. Needs chatterAi.enabled + an API key (W122).
# true/false. Default: false.
# EVEJS_LNE_ARCHAEOLOGY_LORE_AI_ENABLED=
# archaeology.loreWaitMs / maxLoreRequestsPerDay / maxLoreChars - Longest wait for the AI answer, AI requests per UTC
# day, longest AI fragment. Ranges 5000..600000 / 0..500 / 80..360. Default: 60000 / 48 / 300.
# EVEJS_LNE_ARCHAEOLOGY_LORE_WAIT_MS=
# EVEJS_LNE_ARCHAEOLOGY_MAX_LORE_REQUESTS_PER_DAY=
# EVEJS_LNE_ARCHAEOLOGY_MAX_LORE_CHARS=

# N individual NPC pilots as data (RAM + one table
# world_npc_pilots written behind, migration 120), tier FAR only: intents and gate jumps, no effect on the world, no
# EveJS character. Internal: not in the launcher.
# population.enabled - Feature flag (module world + persistence). true/false. Default: false.
# EVEJS_LNE_POPULATION_ENABLED=
# population.size - Pilots (IDs 1..size; smaller = the IDs above are deleted). Range 0..20000. Default: 10000.
# EVEJS_LNE_POPULATION_SIZE=
# population.passIntervalMs / maxEventsPerPass / maxPassMs / maxRoutesPerPass - Pass timer and budgets. Ranges
# 250..10000 / 1..5000 / 0.5..50 / 0..100. Default: 1000 / 400 / 4 / 8.
# EVEJS_LNE_POPULATION_PASS_INTERVAL_MS=
# EVEJS_LNE_POPULATION_MAX_EVENTS_PER_PASS=
# EVEJS_LNE_POPULATION_MAX_PASS_MS=
# EVEJS_LNE_POPULATION_MAX_ROUTES_PER_PASS=
# population.maxTripJumps - Longest trip. Range 1..40. Default: 12.
# EVEJS_LNE_POPULATION_MAX_TRIP_JUMPS=
# population.hubSystemIds / hubPermille / maxHubJumps - Trade hubs (1..16 IDs), share of trips to a hub, hub distance
# that still weighs a home. Ranges - / 0..1000 / 1..80. Default: 30000142,30002187,30002659,30002510,30002053 / 400 / 30.
# EVEJS_LNE_POPULATION_HUB_SYSTEM_IDS=
# EVEJS_LNE_POPULATION_HUB_PERMILLE=
# EVEJS_LNE_POPULATION_MAX_HUB_JUMPS=
# population.bandPermille / archetypePermille - Home band weights (highsec,lowsec,nullsec) and archetype weights
# (TRADER,MINER,RATTER,EXPLORER,COMMUTER), integers 0..1000, sum > 0. Default: 700,150,150 / 300,200,200,100,200.
# EVEJS_LNE_POPULATION_BAND_PERMILLE=
# EVEJS_LNE_POPULATION_ARCHETYPE_PERMILLE=
# population.dwellMinMs / dwellMaxMs / hopMinMs / hopMaxMs - Stop and gate jump times. Ranges 60000..86400000 /
# 60000..86400000 / 5000..600000 / 5000..600000. Default: 1200000 / 5400000 / 45000 / 90000. min > max warns (W196).
# EVEJS_LNE_POPULATION_DWELL_MIN_MS=
# EVEJS_LNE_POPULATION_DWELL_MAX_MS=
# EVEJS_LNE_POPULATION_HOP_MIN_MS=
# EVEJS_LNE_POPULATION_HOP_MAX_MS=
# population.staleMs / bootSpreadMs - Fast-forward age and the wake spread after a start. Ranges 60000..86400000 /
# 0..3600000. Default: 600000 / 300000.
# EVEJS_LNE_POPULATION_STALE_MS=
# EVEJS_LNE_POPULATION_BOOT_SPREAD_MS=
# population.flushIntervalMs / flushRowsPerSlice / flushMaxDeferMs - Write-behind period, rows per flush transaction,
# longest governor deferral. Ranges 5000..600000 / 50..10000 / 5000..3600000. Default: 60000 / 1000 / 300000 (W197, W198).
# EVEJS_LNE_POPULATION_FLUSH_INTERVAL_MS=
# EVEJS_LNE_POPULATION_FLUSH_ROWS_PER_SLICE=
# EVEJS_LNE_POPULATION_FLUSH_MAX_DEFER_MS=
# population.seedRowsPerSlice / contextSystemsPerSlice - Rows of one seed transaction, station reads between two yields
# of the boot. Ranges 50..5000 / 50..10000. Default: 500 / 500.
# EVEJS_LNE_POPULATION_SEED_ROWS_PER_SLICE=
# EVEJS_LNE_POPULATION_CONTEXT_SYSTEMS_PER_SLICE=
# The tiers LIVE (observed) / NEAR (within
# nearJumps) / FAR from presence, the NEAR pre-warm (sub-state, name) and attraction, the observer panel and map layer.
# population.near.enabled - Feature flag of the tiers (needs population.enabled and presence). true/false. Default: false.
# EVEJS_LNE_POPULATION_NEAR_ENABLED=
# population.near.nearJumps / maxPrewarmPerPass / nameCacheSize - NEAR radius (clamped by presence.maxRadius), pilots
# pre-warmed per pass, cached names. Ranges 1..10 / 0..2000 / 16..20000. Default: 2 / 64 / 1024.
# EVEJS_LNE_POPULATION_NEAR_JUMPS=
# EVEJS_LNE_POPULATION_NEAR_MAX_PREWARM_PER_PASS=
# EVEJS_LNE_POPULATION_NEAR_NAME_CACHE_SIZE=
# population.near.attractPermille / arrivalRingSize - Share of the trips from a NEAR system to the nearest observed
# system, jumps kept for arrivalsInto. Ranges 0..1000 / 16..10000. Default: 150 / 512.
# EVEJS_LNE_POPULATION_NEAR_ATTRACT_PERMILLE=
# EVEJS_LNE_POPULATION_NEAR_ARRIVAL_RING_SIZE=
# population.near.activityRingSize - Activity changes (dock to ratting / exploring) kept for the pilot ships of
# civilian ratters and explorers. Range 16..10000. Default: 128.
# EVEJS_LNE_POPULATION_NEAR_ACTIVITY_RING_SIZE=
# population.observer.panelEnabled / layerEnabled - Observer panel population and map layer layer-population (the layer
# needs observer.galaxyEnabled). true/false. Default: true / true.
# EVEJS_LNE_POPULATION_OBSERVER_PANEL_ENABLED=
# EVEJS_LNE_POPULATION_OBSERVER_LAYER_ENABLED=
# population.observer.maxSystems / refreshMs - Systems on the map layer (the most pilots), refresh of the panel and the
# layer. Ranges 1..5000 / 5000..3600000. Default: 300 / 60000.
# EVEJS_LNE_POPULATION_OBSERVER_MAX_SYSTEMS=
# EVEJS_LNE_POPULATION_OBSERVER_REFRESH_MS=

# Population pilots of a LIVE system in Local. A pilot
# leases a character of the civilian pool of localPilots (no new EveJS character); this lane takes the place of the
# civilian step (never both). Memory only.
# population.live.localEnabled - Feature flag of the population lane (needs population.enabled, localPilots.enabled;
# the pool needs one civilian saga of highsecLife.enabled + highsecLife.civilians.enabled, W199). true/false.
# Default: false.
# EVEJS_LNE_POPULATION_LIVE_LOCAL_ENABLED=
# population.live.maxLocalPerSystem - Population pilots in the Local of one system (also capped by the room of
# localPilots.maxPilotsPerSystem). Range 0..500. Default: 100.
# EVEJS_LNE_POPULATION_LIVE_MAX_LOCAL_PER_SYSTEM=

# Population pilots of a LIVE system as ships of
# highsecLife.traffic (an arrival = a hauler gate -> next gate or station, a departure = an undock, MINE = a miner).
# A pilot is in the queue or owned by one ship, never both (RAM only). The traffic caps stay.
# population.live.trafficEnabled - Feature flag of the pilot ships (needs population.enabled, population.near.enabled,
# highsecLife.traffic.enabled; W200). true/false. Default: false.
# EVEJS_LNE_POPULATION_LIVE_TRAFFIC_ENABLED=
# population.live.trafficMode - replace = only pilot ships in a LIVE system, mix = pilots first, then the random
# civilians. replace|mix. Default: replace.
# EVEJS_LNE_POPULATION_LIVE_TRAFFIC_MODE=
# population.live.cloneDelayMs - A killed pilot (its ship vanished) stays POD, then docks at home with a new hull.
# Range 60000..86400000. Default: 1800000.
# EVEJS_LNE_POPULATION_LIVE_CLONE_DELAY_MS=
# population.live.ownMaxMs - A pilot owned by a ship longer than this goes back to the queue (EXPIRED). Range
# 60000..3600000. Default: 900000.
# EVEJS_LNE_POPULATION_LIVE_OWN_MAX_MS=
# population.live.maxEventAgeMs / spawnGapMs / maxSpawnsPerSystemPass - Oldest arrival that still gets a ship, pilot
# spawn cadence per system (replace), candidates per spawn attempt. Ranges 5000..600000 / 1000..600000 / 1..10.
# Default: 60000 / 15000 / 2.
# EVEJS_LNE_POPULATION_LIVE_MAX_EVENT_AGE_MS=
# EVEJS_LNE_POPULATION_LIVE_SPAWN_GAP_MS=
# EVEJS_LNE_POPULATION_LIVE_MAX_SPAWNS_PER_SYSTEM_PASS=

# The hostile LNE ships (operatorKind lne
# lne-duel, idle, not capitals) attack the ship of a population pilot in the LIVE traffic (standing relation HOSTILE).
# The live controller of the pilot ship takes the kind of its attackers for holdMs. RAM only, no migration.
# population.live.standingAggroEnabled - Feature flag of the standing aggro (needs population.standings.enabled and
# population.live.trafficEnabled; W265). true/false. Default: false.
# EVEJS_LNE_POPULATION_LIVE_STANDING_AGGRO_ENABLED=
# population.live.standingAggroRangeMeters - Distance of an LNE attacker from the pilot ship. Range 10000..300000.
# Default: 100000.
# EVEJS_LNE_POPULATION_LIVE_STANDING_AGGRO_RANGE_METERS=
# population.live.standingAggroMaxSystemsPerPass / MaxAttackers / MaxCandidates - Scene reads per traffic pass,
# attackers per pilot ship, idle LNE ships read per system. Ranges 1..32 / 1..8 / 1..256. Default: 4 / 2 / 32.
# EVEJS_LNE_POPULATION_LIVE_STANDING_AGGRO_MAX_SYSTEMS_PER_PASS=
# EVEJS_LNE_POPULATION_LIVE_STANDING_AGGRO_MAX_ATTACKERS=
# EVEJS_LNE_POPULATION_LIVE_STANDING_AGGRO_MAX_CANDIDATES=
# population.live.standingAggroHoldMs / CooldownMs - Time a pilot ship stays armed, pause after the disarm.
# Ranges 10000..900000 / 0..900000. Default: 120000 / 60000.
# EVEJS_LNE_POPULATION_LIVE_STANDING_AGGRO_HOLD_MS=
# EVEJS_LNE_POPULATION_LIVE_STANDING_AGGRO_COOLDOWN_MS=
# population.live.vendorRatAggroEnabled - the vendor belt / gate rats attack the pilot ships too
# (needs population.live.standingAggroEnabled; W266). true/false. Default: false.
# EVEJS_LNE_POPULATION_LIVE_VENDOR_RAT_AGGRO_ENABLED=
# population.live.vendorRatAggroMaxPerSystemWindow / WindowMs - Rat attacks (orders) per system in the sliding window
# (0 = no rat attack), length of the window. Ranges 0..16 / 60000..86400000. Default: 1 / 3600000.
# EVEJS_LNE_POPULATION_LIVE_VENDOR_RAT_AGGRO_MAX_PER_SYSTEM_WINDOW=
# EVEJS_LNE_POPULATION_LIVE_VENDOR_RAT_AGGRO_WINDOW_MS=

# World context weights per system (danger of pirate
# control / occupation / claims / open battles, attraction of Event Director sites, veins and wreck fields, the UTC hour
# of highsecLife.hourCurvePermille, the hull tier by seq). RAM only, refreshed in slices of contextSystemsPerSlice.
# population.context.enabled - Feature flag of the world context (needs population.enabled and modules.world, W201).
# true/false. Default: false.
# EVEJS_LNE_POPULATION_CONTEXT_ENABLED=
# population.context.refreshMs - Period of a full refresh of the weights. Range 60000..86400000. Default: 600000.
# EVEJS_LNE_POPULATION_CONTEXT_REFRESH_MS=
# population.context.dangerAvoidPermille / dangerRetreatPermille - How much the danger lowers the weight of a destination
# / chance x danger to dock or go home. Ranges 0..1000. Default: 700 / 300.
# EVEJS_LNE_POPULATION_CONTEXT_DANGER_AVOID_PERMILLE=
# EVEJS_LNE_POPULATION_CONTEXT_DANGER_RETREAT_PERMILLE=
# population.context.attractPermille - Share of the trips of RATTER / EXPLORER / MINER to an attracting system of the
# region. Range 0..1000. Default: 250.
# EVEJS_LNE_POPULATION_CONTEXT_ATTRACT_PERMILLE=
# population.context.hourWeightPermille - How much the UTC hour curve keeps docked pilots in the station. Range
# 0..1000. Default: 1000.
# EVEJS_LNE_POPULATION_CONTEXT_HOUR_WEIGHT_PERMILLE=
# population.context.reshipTierEverySeq - Transitions of a pilot per hull tier of its archetype. Range 1..100000.
# Default: 200.
# EVEJS_LNE_POPULATION_CONTEXT_RESHIP_TIER_EVERY_SEQ=
# population.context.maxOpenBattles / maxOpenEvents / maxWreckFields - Rows read in one refresh. Ranges 1..5000 /
# 1..50000 / 1..20000. Default: 2000 / 2000 / 2000.
# EVEJS_LNE_POPULATION_CONTEXT_MAX_OPEN_BATTLES=
# EVEJS_LNE_POPULATION_CONTEXT_MAX_OPEN_EVENTS=
# EVEJS_LNE_POPULATION_CONTEXT_MAX_WRECK_FIELDS=
# population.gateWarmupMs - Gate measurement: the time after the population start in which the pass
# flush times go under population.warmupPassMs / population.warmupFlushMs instead of passMs / flushMs. 0 = off. Gate
# profile: 600000. Range 0..3600000. Default: 0.
# EVEJS_LNE_POPULATION_GATE_WARMUP_MS=

# Fewer pilots in stations. Flag off = the rules bit for
# bit. On: every station dwell = max(dockDwellFloorMs, dwell x dockDwellPermille / 1000), the DOCK intent weight x
# dockWeightPermille / 1000, NO_ROUTE in a station system stays in space for an archetype with an activity there, a hub
# farther than maxTripJumps is skipped. Internal: not in the launcher. Out of range = clamped.
# population.activeLife.enabled - Feature flag (needs population.enabled, W246). true/false. Default: false.
# EVEJS_LNE_POPULATION_ACTIVE_LIFE_ENABLED=
# population.activeLife.dockDwellPermille - Scale of a dwell in a station. Range 50..1000. Default: 250.
# EVEJS_LNE_POPULATION_ACTIVE_LIFE_DOCK_DWELL_PERMILLE=
# population.activeLife.dockDwellFloorMs - Shortest dwell in a station. Range 60000..86400000. Default: 300000.
# EVEJS_LNE_POPULATION_ACTIVE_LIFE_DOCK_DWELL_FLOOR_MS=
# population.activeLife.dockWeightPermille - Scale of the DOCK intent weight. Range 0..1000. Default: 500.
# EVEJS_LNE_POPULATION_ACTIVE_LIFE_DOCK_WEIGHT_PERMILLE=
# population.activeLife.targetDockedPermille - Target DOCKED share (gauge population.dockedPermille, status, panel; not
# a regulator). Range 0..1000. Default: 400.
# EVEJS_LNE_POPULATION_ACTIVE_LIFE_TARGET_DOCKED_PERMILLE=

# Standing profiles of the pilots to the empire / pirate
# factions, never stored (a function of worldSeed, pilotId and the home region). With population.context.enabled a route
# with a hostile hop is NO_ROUTE, a friendly pirate system has no controller danger and the retreat reads the danger per
# pilot. Flag off = the rules bit for bit. Standings are x 0.1 (50 = +5.0). Internal: not in the launcher. Out of range
# = clamped.
# population.standings.enabled - Feature flag (needs population.enabled and population.context.enabled for an effect,
# W251). true/false. Default: false.
# EVEJS_LNE_POPULATION_STANDINGS_ENABLED=
# population.standings.profiles - Base profiles K (x race groups). Range 8..256. Default: 64.
# EVEJS_LNE_POPULATION_STANDINGS_PROFILES=
# population.standings.friendlyMin - Lowest friendly standing. Range 1..100. Default: 50.
# EVEJS_LNE_POPULATION_STANDINGS_FRIENDLY_MIN=
# population.standings.hostileMax - Highest hostile standing. Range -100..-1. Default: -50.
# EVEJS_LNE_POPULATION_STANDINGS_HOSTILE_MAX=
# population.standings.empireBaseMin - Lowest base standing to an empire faction (min > max swapped, W252). Range
# -100..100. Default: -30.
# EVEJS_LNE_POPULATION_STANDINGS_EMPIRE_BASE_MIN=
# population.standings.empireBaseMax - Highest base standing to an empire faction. Range -100..100. Default: 40.
# EVEJS_LNE_POPULATION_STANDINGS_EMPIRE_BASE_MAX=
# population.standings.pirateBaseMin - Lowest base standing to a pirate faction (min > max swapped, W252). Range
# -100..100. Default: -100.
# EVEJS_LNE_POPULATION_STANDINGS_PIRATE_BASE_MIN=
# population.standings.pirateBaseMax - Highest base standing to a pirate faction. Range -100..100. Default: 60.
# EVEJS_LNE_POPULATION_STANDINGS_PIRATE_BASE_MAX=
# population.standings.homeBonus - Bonus to the faction of the home region race. Range 0..100. Default: 40.
# EVEJS_LNE_POPULATION_STANDINGS_HOME_BONUS=
# population.standings.rivalPenalty - Penalty to the rivals of the home region race. Range 0..100. Default: 40.
# EVEJS_LNE_POPULATION_STANDINGS_RIVAL_PENALTY=
# population.standings.panelTopProfiles - Most used profiles shown in the population panel. Range 0..20. Default: 5.
# EVEJS_LNE_POPULATION_STANDINGS_PANEL_TOP_PROFILES=

# Corporations of the population pilots
# (founding, recruitment, leaving, dissolution; RAM + world_npc_corps, migration 124). A member uses the standing profile
# of its corporation. Flag off = no corps pass, corp_id of the pilots as is, the transitions bit for bit. Internal: not in
# the launcher. Out of range = clamped.
# population.corps.enabled - Feature flag (needs population.enabled and population.standings.enabled, W253). true/false.
# Default: false.
# EVEJS_LNE_POPULATION_CORPS_ENABLED=
# population.corps.targetCorps - Open corporations. Range 0..5000. Default: 300.
# EVEJS_LNE_POPULATION_CORPS_TARGET_CORPS=
# population.corps.membersMin - Members under which a corporation dissolves. Range 1..100. Default: 3.
# EVEJS_LNE_POPULATION_CORPS_MEMBERS_MIN=
# population.corps.membersMax - Most members of a corporation. Range 2..1000. Default: 120.
# EVEJS_LNE_POPULATION_CORPS_MEMBERS_MAX=
# population.corps.corplessPermille - Share of pilots without a corporation at which the recruitment stops. Range
# 0..1000. Default: 300.
# EVEJS_LNE_POPULATION_CORPS_CORPLESS_PERMILLE=
# population.corps.foundPerPass - Foundings per pass. Range 0..16. Default: 1.
# EVEJS_LNE_POPULATION_CORPS_FOUND_PER_PASS=
# population.corps.foundingIntervalMs - Time between founding attempts. Range 1000..86400000. Default: 30000.
# EVEJS_LNE_POPULATION_CORPS_FOUNDING_INTERVAL_MS=
# population.corps.maxCorpsPerPass - Corporation reviews per pass. Range 1..256. Default: 4.
# EVEJS_LNE_POPULATION_CORPS_MAX_CORPS_PER_PASS=
# population.corps.reviewMs - Period of a corporation review. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_POPULATION_CORPS_REVIEW_MS=
# population.corps.scanPerReview - Candidates checked per review / founding. Range 1..5000. Default: 64.
# EVEJS_LNE_POPULATION_CORPS_SCAN_PER_REVIEW=
# population.corps.recruitsPerReview - Recruits accepted per review. Range 0..100. Default: 5.
# EVEJS_LNE_POPULATION_CORPS_RECRUITS_PER_REVIEW=
# population.corps.leavePermille - Members leaving per review. Range 0..1000. Default: 20.
# EVEJS_LNE_POPULATION_CORPS_LEAVE_PERMILLE=
# population.corps.joinMaxDistance - Largest standing profile distance of a recruit. Range 0..200. Default: 60.
# EVEJS_LNE_POPULATION_CORPS_JOIN_MAX_DISTANCE=
# population.corps.focusMatchPermille - Chance to accept an archetype of the corporation focus. Range 0..1000.
# Default: 800.
# EVEJS_LNE_POPULATION_CORPS_FOCUS_MATCH_PERMILLE=
# population.corps.otherFocusPermille - Chance to accept an archetype of another focus. Range 0..1000. Default: 200.
# EVEJS_LNE_POPULATION_CORPS_OTHER_FOCUS_PERMILLE=
# population.corps.dissolveAfterMs - Time under membersMin before the dissolution. Range 60000..2592000000.
# Default: 86400000.
# EVEJS_LNE_POPULATION_CORPS_DISSOLVE_AFTER_MS=
# population.corps.retentionMs - Retention of the DISSOLVED rows. Range 3600000..31536000000. Default: 604800000.
# EVEJS_LNE_POPULATION_CORPS_RETENTION_MS=
# population.corps.flushRowsPerSlice - Corporation rows (and deletions) per flush transaction (W254). Range 1..500.
# Default: 100.
# EVEJS_LNE_POPULATION_CORPS_FLUSH_ROWS_PER_SLICE=
# population.corps.maxNameAttempts - Name attempts of a founding. Range 1..32. Default: 8.
# EVEJS_LNE_POPULATION_CORPS_MAX_NAME_ATTEMPTS=

# Pilot groups (MINING_OP, CONVOY, RAT_GANG, ROAM). A
# leader and its members fly together; only the leader has a queue entry, its transition moves the members in the same
# event (RAM + world_npc_pilots.group_id, migration 125). Flag off = no group, group_id as is, the transitions bit for
# bit. Internal: not in the launcher. Out of range = clamped.
# population.groups.enabled - Feature flag (needs population.enabled, W255). true/false. Default: false.
# EVEJS_LNE_POPULATION_GROUPS_ENABLED=
# population.groups.maxSize - Most members of a group besides the leader. Range 2..16. Default: 4.
# EVEJS_LNE_POPULATION_GROUPS_MAX_SIZE=
# population.groups.minMembers - Fewest members of a new group (above maxSize = maxSize, W256). Range 1..16.
# Default: 2.
# EVEJS_LNE_POPULATION_GROUPS_MIN_MEMBERS=
# population.groups.escortMax - Most escort pilots (RATTER) of a group. Range 0..8. Default: 2.
# EVEJS_LNE_POPULATION_GROUPS_ESCORT_MAX=
# population.groups.formPermille - Chance of a new group in an eligible event of a leader. Range 0..1000. Default: 250.
# EVEJS_LNE_POPULATION_GROUPS_FORM_PERMILLE=
# population.groups.scanPerForm - Candidates checked per group forming. Range 1..500. Default: 32.
# EVEJS_LNE_POPULATION_GROUPS_SCAN_PER_FORM=
# population.groups.maxFormsPerPass - Groups formed per pass. Range 0..1000. Default: 16.
# EVEJS_LNE_POPULATION_GROUPS_MAX_FORMS_PER_PASS=
# population.groups.maxGroups - Most groups at a time (RAM). Range 0..20000. Default: 500.
# EVEJS_LNE_POPULATION_GROUPS_MAX_GROUPS=
# population.groups.maxLifetimeMs - Longest life of a group. Range 60000..86400000. Default: 7200000.
# EVEJS_LNE_POPULATION_GROUPS_MAX_LIFETIME_MS=
# population.groups.liveSpawnEnabled - Feature flag of the member ships in LIVE with the leader (needs
# population.enabled, groups.enabled, near.enabled and live.trafficEnabled, W259; W264 when maxSize + 1 is above
# highsecLife.traffic.maxShipsPerSystem). true/false. Default: false.
# EVEJS_LNE_POPULATION_GROUPS_LIVE_SPAWN_ENABLED=
# population.groups.liveSpacingMeters - Spawn gap of a member ship: spawnOffsetMeters + liveSpacingMeters x (k + 1).
# Range 0..10000. Default: 500.
# EVEJS_LNE_POPULATION_GROUPS_LIVE_SPACING_METERS=

# Hull classes of the population pilots, pools per
# (archetype, home band), freighters without nullsec routes, the LIVE profile by the hull type. Internal: not in the
# launcher.
# population.hulls.enabled - Feature flag (needs population.enabled, W257; LIVE ships need
# highsecLife.civilianHullsEnabled, W258; read at the preload, a change needs a restart). true/false. Default: false.
# EVEJS_LNE_POPULATION_HULLS_ENABLED=
# population.hulls.restrictedAvoidSecClasses - Bands avoided by a FREIGHTER route: lowsec,nullsec list or none.
# Default: nullsec.
# EVEJS_LNE_POPULATION_HULLS_RESTRICTED_AVOID_SEC_CLASSES=

# The life cycle of the population pilots: a docked pilot
# logs off (AWAY) for days, comes back or quits; a new pilot (gen + 1) takes the slot in a starter system. Internal:
# not in the launcher. Out of range = clamped.
# population.lifecycle.enabled - Feature flag (needs population.enabled, W270). true/false. Default: false.
# EVEJS_LNE_POPULATION_LIFECYCLE_ENABLED=
# population.lifecycle.awayPerDayPermille - Chance of a logoff per day docked (linear). 0..1000. Default: 20.
# EVEJS_LNE_POPULATION_LIFECYCLE_AWAY_PER_DAY_PERMILLE=
# population.lifecycle.awayMinMs - Shortest absence. 3600000..2592000000. Default: 43200000.
# EVEJS_LNE_POPULATION_LIFECYCLE_AWAY_MIN_MS=
# population.lifecycle.awayMaxMs - Longest absence (below awayMinMs = awayMinMs, W271). 3600000..7776000000.
# Default: 1814400000.
# EVEJS_LNE_POPULATION_LIFECYCLE_AWAY_MAX_MS=
# population.lifecycle.maxAwayPermille - Most AWAY pilots at a time (permille). 0..1000. Default: 400.
# EVEJS_LNE_POPULATION_LIFECYCLE_MAX_AWAY_PERMILLE=
# population.lifecycle.quitOnReturnPermille - Chance to quit at the end of an absence. 0..1000. Default: 100.
# EVEJS_LNE_POPULATION_LIFECYCLE_QUIT_ON_RETURN_PERMILLE=
# population.lifecycle.rookieSystemIds - Starter systems of a new pilot (1..16 system ids).
# Default: 30001392,30001407,30002505,30003410,30005042,30001672,30002715,30005305.
# EVEJS_LNE_POPULATION_LIFECYCLE_ROOKIE_SYSTEM_IDS=

# The pilot career: xp and wealth from the activities
# the promotion ROOKIE -> VETERAN, the hulls and bands per career, the home move at SEASONED. Internal: not in the
# launcher. Out of range = clamped.
# population.lifecycle.careerEnabled - Feature flag (needs population.lifecycle.enabled, W272). true/false.
# Default: false.
# EVEJS_LNE_POPULATION_LIFECYCLE_CAREER_ENABLED=
# population.lifecycle.xpByCareer - xp threshold of ROOKIE,PILOT,SEASONED,VETERAN (4 integers). Default: 0,30,300,1500.
# EVEJS_LNE_POPULATION_LIFECYCLE_XP_BY_CAREER=
# population.lifecycle.costByCareer - Wealth cost of the promotion to each career (4 integers).
# Default: 0,100,1500,8000.
# EVEJS_LNE_POPULATION_LIFECYCLE_COST_BY_CAREER=
# population.lifecycle.earnByBand - Wealth of one activity in highsec,lowsec,nullsec (3 integers 0..1000000).
# Default: 10,20,40.
# EVEJS_LNE_POPULATION_LIFECYCLE_EARN_BY_BAND=
# population.lifecycle.tradeEarn - Wealth of a TRADER / COMMUTER arrival at a station. 0..1000000. Default: 15.
# EVEJS_LNE_POPULATION_LIFECYCLE_TRADE_EARN=
# population.lifecycle.lossOnPod - Wealth lost at a POD x the career code. 0..1000000. Default: 50.
# EVEJS_LNE_POPULATION_LIFECYCLE_LOSS_ON_POD=
# population.lifecycle.wealthMax - Upper bound of wealth. 1..2147483647. Default: 1000000000.
# EVEJS_LNE_POPULATION_LIFECYCLE_WEALTH_MAX=
# population.lifecycle.seedCareerPermille - Career distribution of the seed pilots (4 permille values).
# Default: 350,350,200,100.
# EVEJS_LNE_POPULATION_LIFECYCLE_SEED_CAREER_PERMILLE=
# population.lifecycle.moveHomePermille - Chance of a home move at the promotion to SEASONED. 0..1000. Default: 500.
# EVEJS_LNE_POPULATION_LIFECYCLE_MOVE_HOME_PERMILLE=

# The corporation activity rules (dissolution by the
# active members, AWAY / ROOKIE out of the recruitment, the region list after a home change). Internal: not in the
# launcher. Out of range = clamped.
# population.lifecycle.corpsActivityEnabled - Feature flag (needs population.lifecycle.enabled and
# population.corps.enabled, W273). true/false. Default: false.
# EVEJS_LNE_POPULATION_LIFECYCLE_CORPS_ACTIVITY_ENABLED=
# population.lifecycle.corpsRegionCompactAt - Additions of a region recruitment list before it is rebuilt.
# 16..100000. Default: 256.
# EVEJS_LNE_POPULATION_LIFECYCLE_CORPS_REGION_COMPACT_AT=

# Moon / PI yield of a system per period (pure model
# has no service, the pulse is). Internal: not in the launcher. Out of range = clamped.
# extraction.enabled - Feature flag of the moon / PI extraction. true/false. Default: false.
# EVEJS_LNE_EXTRACTION_ENABLED=
# extraction.maxMoonsPerSystem / maxPlanetsPerSystem - Moons / planets counted in a system. Ranges 0..64 / 0..32.
# Default: 8 / 6.
# EVEJS_LNE_EXTRACTION_MAX_MOONS_PER_SYSTEM=
# EVEJS_LNE_EXTRACTION_MAX_PLANETS_PER_SYSTEM=
# extraction.moonPortionsPerMoonPerPeriod - Moon ore portions of one moon per period. Range 0..100000. Default: 5.
# EVEJS_LNE_EXTRACTION_MOON_PORTIONS_PER_MOON_PER_PERIOD=
# extraction.piP1UnitsPerPlanetPerPeriod - P1 units of one planet per period. Range 0..1000000. Default: 60.
# EVEJS_LNE_EXTRACTION_PI_P1_UNITS_PER_PLANET_PER_PERIOD=
# extraction.highsecYieldPermille / lowsecYieldPermille / nullsecYieldPermille - Yield multiplier of the band.
# Range 0..2000. Default: 500 / 800 / 1000.
# EVEJS_LNE_EXTRACTION_HIGHSEC_YIELD_PERMILLE=
# EVEJS_LNE_EXTRACTION_LOWSEC_YIELD_PERMILLE=
# EVEJS_LNE_EXTRACTION_NULLSEC_YIELD_PERMILLE=
# The EXTRACTION_PULSE service (works only with
# extraction.enabled and the strategy module). Out of range = clamped.
# extraction.periodMs - Length of one yield period. Range 3600000..604800000. Default: 21600000.
# EVEJS_LNE_EXTRACTION_PERIOD_MS=
# extraction.pulseIntervalMs - Interval of the pulse chain. Range 60000..3600000. Default: 300000.
# EVEJS_LNE_EXTRACTION_PULSE_INTERVAL_MS=
# extraction.maxFactionsPerPulse - Factions delivered in one pulse. Range 1..64. Default: 4.
# EVEJS_LNE_EXTRACTION_MAX_FACTIONS_PER_PULSE=
# extraction.maxMarkerChecksPerPulse - Period marker reads in one pulse. Range 1..1024. Default: 64.
# EVEJS_LNE_EXTRACTION_MAX_MARKER_CHECKS_PER_PULSE=
# extraction.maxSystemsPerFaction - Controlled systems of a faction per cycle. Range 1..1024. Default: 64.
# EVEJS_LNE_EXTRACTION_MAX_SYSTEMS_PER_FACTION=
# extraction.maxStationsPerFaction - Delivery stations of a faction per cycle. Range 1..256. Default: 16.
# EVEJS_LNE_EXTRACTION_MAX_STATIONS_PER_FACTION=
# extraction.maxDeliveryJumps - Jumps from a system to its delivery station. Range 0..20. Default: 5.
# EVEJS_LNE_EXTRACTION_MAX_DELIVERY_JUMPS=
# extraction.claimedYieldPermille - Yield of a system with an occupier claim. Range 0..1000. Default: 500.
# EVEJS_LNE_EXTRACTION_CLAIMED_YIELD_PERMILLE=
# extraction.maxCachedSystems - Systems in the RAM cache of moons / planets. Range 16..16384. Default: 4096.
# EVEJS_LNE_EXTRACTION_MAX_CACHED_SYSTEMS=
# extraction.maxRowsPerPulse - Rows of one pulse (capped at persistence.maxRowsPerTransaction). Range 50..10000.
# Default: 1000.
# EVEJS_LNE_EXTRACTION_MAX_ROWS_PER_PULSE=
# extraction.markerRetentionMs - Age of the extract: journal rows deleted by retention (at least periodMs).
# Range 86400000..2592000000. Default: 604800000.
# EVEJS_LNE_EXTRACTION_MARKER_RETENTION_MS=
# Demand of the pulse (works only
# with extraction.enabled). Out of range = clamped.
# extraction.fuelEnabled - The pulse burns the fuel of Upwell stations, lines follow the fuel. true/false.
# Default: false.
# EVEJS_LNE_EXTRACTION_FUEL_ENABLED=
# extraction.fuelBlocksPerUpwellPerPeriod - Fuel blocks of one Upwell station per period (0 = no fuel).
# Range 0..100000. Default: 60.
# EVEJS_LNE_EXTRACTION_FUEL_BLOCKS_PER_UPWELL_PER_PERIOD=
# extraction.unfueledLinesPermille - Lines of an Upwell station without fuel. Range 0..1000. Default: 500.
# EVEJS_LNE_EXTRACTION_UNFUELED_LINES_PERMILLE=
# extraction.fuelReservePeriods - Periods of fuel in the conversion target and readNeeds. Range 0..100. Default: 4.
# EVEJS_LNE_EXTRACTION_FUEL_RESERVE_PERIODS=
# extraction.maxConversionsPerFaction - PI conversion steps of one faction per pulse (0 = none). Range 0..256.
# Default: 8.
# EVEJS_LNE_EXTRACTION_MAX_CONVERSIONS_PER_FACTION=
# extraction.maxNeedsPerFaction - needs entries of readNeeds. Range 0..256. Default: 32.
# EVEJS_LNE_EXTRACTION_MAX_NEEDS_PER_FACTION=
# extraction.advancedReserveRuns - Runs of advanced inputs in the reserve of a station with lines. Range 0..100.
# Default: 2.
# EVEJS_LNE_EXTRACTION_ADVANCED_RESERVE_RUNS=
# extraction.advancedReserveGroups - Hull groups of the reserve of a station without a job (none = none).
# Default: battleship.
# EVEJS_LNE_EXTRACTION_ADVANCED_RESERVE_GROUPS=
# NPC -> Upwell transfer of the pulse (works
# only with the demand: extraction.fuelEnabled or production.advancedInputsEnabled). Out of range = clamped.
# extraction.upwellTransferEnabled - The pulse moves the short of an Upwell station from the nearest own NPC station
# (in extraction.maxDeliveryJumps); readNeeds moves the Upwell needs to that donor. true/false. Default: false.
# EVEJS_LNE_EXTRACTION_UPWELL_TRANSFER_ENABLED=
# extraction.maxTransfersPerFaction - Donor -> recipient pairs of one faction per pulse (0 = no transfer write).
# Range 0..64. Default: 4.
# EVEJS_LNE_EXTRACTION_MAX_TRANSFERS_PER_FACTION=
# extraction.maxTransferTypesPerPair - Types of one transfer pair (at most stations.maxDeltasPerChange), fuel first.
# Range 1..64. Default: 8.
# EVEJS_LNE_EXTRACTION_MAX_TRANSFER_TYPES_PER_PAIR=
# Native Sansha incursions steered to LNE targets.
# nativeIncursions.enabled - Master flag and kill switch (modules.world + persistence). true/false. Default: false.
# EVEJS_LNE_NATIVE_INCURSIONS_ENABLED=
# nativeIncursions.steer.enabled - The wrapper of selectPlacement steers a vendor slot to an LNE target. true/false.
# Default: false.
# EVEJS_LNE_NATIVE_INCURSIONS_STEER_ENABLED=
# nativeIncursions.steer.mode - steer (no matching target = vanilla) or exclusive (no incursion in the band).
# Default: steer.
# EVEJS_LNE_NATIVE_INCURSIONS_STEER_MODE=
# nativeIncursions.steer.maxTargets - Targets per publication. Range 1..256. Default: 32.
# EVEJS_LNE_NATIVE_INCURSIONS_STEER_MAX_TARGETS=
# nativeIncursions.steer.logSize - Ring of the steered placements. Range 1..64. Default: 16.
# EVEJS_LNE_NATIVE_INCURSIONS_STEER_LOG_SIZE=
# nativeIncursions.claimStates - Claim states of Sansha's Nation that count as an offensive (RECON,CONTESTED,INVASION).
# Default: CONTESTED,INVASION.
# EVEJS_LNE_NATIVE_INCURSIONS_CLAIM_STATES=
# nativeIncursions.settle.enabled - Bind the vendor tales to targets and settle the outcome once. true/false.
# Default: false.
# EVEJS_LNE_NATIVE_INCURSIONS_SETTLE_ENABLED=
# nativeIncursions.maxActiveBindings - Simultaneous LNE incursions. Range 0..3. Default: 3.
# EVEJS_LNE_NATIVE_INCURSIONS_MAX_ACTIVE_BINDINGS=
# nativeIncursions.passIntervalMs - Timer of the pass. Range 5000..3600000. Default: 30000.
# EVEJS_LNE_NATIVE_INCURSIONS_PASS_INTERVAL_MS=
# nativeIncursions.maxTalesPerPass - Tales read per pass. Range 1..256. Default: 32.
# EVEJS_LNE_NATIVE_INCURSIONS_MAX_TALES_PER_PASS=
# nativeIncursions.maxSettlementsPerPass - Settlement transactions per pass. Range 1..32. Default: 4.
# EVEJS_LNE_NATIVE_INCURSIONS_MAX_SETTLEMENTS_PER_PASS=
# nativeIncursions.settleMaxAttempts - Refused settlements before the effect FAILED. Range 1..100. Default: 10.
# EVEJS_LNE_NATIVE_INCURSIONS_SETTLE_MAX_ATTEMPTS=
# nativeIncursions.vanishGraceMs - A bound tale gone from the vendor after expires_at + this = vanished.
# Range 0..604800000. Default: 86400000.
# EVEJS_LNE_NATIVE_INCURSIONS_VANISH_GRACE_MS=
# nativeIncursions.lookbackMs - Read window of the terminal tales (at least one 5-day tale lifetime).
# Range 432000000..2592000000. Default: 604800000.
# EVEJS_LNE_NATIVE_INCURSIONS_LOOKBACK_MS=
# The outcome in the whole constellation + news.
# nativeIncursions.defeatInfluencePoints - Influence drop of Sansha per claimant system of a defeated tale (the target
# only when the repel made no drop). 0 = none. Range 0..100. Default: 10.
# EVEJS_LNE_NATIVE_INCURSIONS_DEFEAT_INFLUENCE_POINTS=
# nativeIncursions.expireInfluencePoints - Influence drop of the controller per claimant system of an expired tale.
# 0 = none. Range 0..100. Default: 10.
# EVEJS_LNE_NATIVE_INCURSIONS_EXPIRE_INFLUENCE_POINTS=
# nativeIncursions.newsEnabled - NATIVE_INCURSION_DEFEATED / _HELD facts of the galactic news (needs news.enabled,
# W244). true/false. Default: false.
# EVEJS_LNE_NATIVE_INCURSIONS_NEWS_ENABLED=
# Visibility (observer + notices).
# nativeIncursions.observerEnabled - Panel native-incursions and layer layer-native-incursions (the layer only with
# observer.galaxyEnabled). true/false. Default: false.
# EVEJS_LNE_NATIVE_INCURSIONS_OBSERVER_ENABLED=
# nativeIncursions.noticesEnabled - Notices lines NATIVE_INCURSION_STARTED / _ENDED to the players near the target
# (needs notices.enabled, W248). true/false. Default: false.
# EVEJS_LNE_NATIVE_INCURSIONS_NOTICES_ENABLED=
# nativeIncursions.observerSettledRows - Latest SETTLED rows of the panel. Range 1..64. Default: 16.
# EVEJS_LNE_NATIVE_INCURSIONS_OBSERVER_SETTLED_ROWS=
# nativeIncursions.noticeRadiusJumps - Radius of the recipients around the target system. Range 0..10. Default: 3.
# EVEJS_LNE_NATIVE_INCURSIONS_NOTICE_RADIUS_JUMPS=
# nativeIncursions.noticeMaxRecipients - Recipients of one notice. Range 1..500. Default: 50.
# EVEJS_LNE_NATIVE_INCURSIONS_NOTICE_MAX_RECIPIENTS=
# LP of the defending faction for the participants.
# nativeIncursions.rewards.enabled - LP of the controller of the target system (its faction LP corporation) for the
# participants of a defeated tale, paid by the heavyEvents payout pump (needs settle.enabled, loyaltyPoints > 0 and a
# heavyEvents layer with heavyEvents.payoutEnabled, W247). true/false. Default: false.
# EVEJS_LNE_NATIVE_INCURSIONS_REWARDS_ENABLED=
# nativeIncursions.rewards.loyaltyPoints - LP per participant. 0 = no reward. Range 0..1000000. Default: 0.
# EVEJS_LNE_NATIVE_INCURSIONS_REWARDS_LOYALTY_POINTS=
# nativeIncursions.rewards.maxRewardedParticipants - Participants rewarded per tale (summed netLP first); rows of the
# reward transaction = this + 2 (over persistence.maxRowsPerTransaction = rewards off, ROW_BOUND). Range 1..256.
# Default: 64.
# EVEJS_LNE_NATIVE_INCURSIONS_REWARDS_MAX_REWARDED_PARTICIPANTS=
# nativeIncursions.rewards.maxReceipts - Receipts of the tale read per reward. Range 1..512. Default: 128.
# EVEJS_LNE_NATIVE_INCURSIONS_REWARDS_MAX_RECEIPTS=
# nativeIncursions.rewards.maxPerPass - Reward transactions per pass. Range 1..8. Default: 2.
# EVEJS_LNE_NATIVE_INCURSIONS_REWARDS_MAX_PER_PASS=
# LNE faction incursions (Triglavian 500026).
# factionIncursions.enabled - Master flag and kill switch (modules.world + persistence); off with open incursions =
# drain (cancelled, effect DISABLED). true/false. Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_ENABLED=
# factionIncursions.settle.enabled - Settle a decided incursion once (defeated = repel of the claim). true/false.
# Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_SETTLE_ENABLED=
# factionIncursions.factionIds - Factions of the engine (1..8 ids of the catalogue). Default: 500026.
# Catalogue: 500026 Triglavian, 500024 Drifters, 500010 Guristas, 500011 Angel Cartel, 500012 Blood Raiders
# 500020 Serpentis, empires 500001 Caldari, 500002 Minmatar, 500003 Amarr, 500004 Gallente (allowEmpireFactions).
# EVEJS_LNE_FACTION_INCURSIONS_FACTION_IDS=
# factionIncursions.allowEmpireFactions - The empire factions (500001..500004) of factionIds create incursions
# (a highsec change); off = their ids are skipped (W243). true/false. Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_ALLOW_EMPIRE_FACTIONS=
# factionIncursions.claimStates - Claim states that count as an offensive (RECON,CONTESTED,INVASION).
# Default: CONTESTED,INVASION.
# EVEJS_LNE_FACTION_INCURSIONS_CLAIM_STATES=
# factionIncursions.maxActive - Open incursions (ACTIVE + DECIDED). Range 0..8. Default: 1.
# EVEJS_LNE_FACTION_INCURSIONS_MAX_ACTIVE=
# factionIncursions.maxActivePerFaction - Open incursions of one faction. Range 0..4. Default: 1.
# EVEJS_LNE_FACTION_INCURSIONS_MAX_ACTIVE_PER_FACTION=
# factionIncursions.systems - Systems of an incursion. Range 2..4. Default: 4.
# EVEJS_LNE_FACTION_INCURSIONS_SYSTEMS=
# factionIncursions.minSystems - Fewer systems of the same class around the target = no incursion. Range 2..4.
# Default: 4.
# EVEJS_LNE_FACTION_INCURSIONS_MIN_SYSTEMS=
# factionIncursions.establishedMs - Phase 1. Range 600000..604800000. Default: 86400000.
# EVEJS_LNE_FACTION_INCURSIONS_ESTABLISHED_MS=
# factionIncursions.mobilizingMs - Phase 2. Range 0..604800000. Default: 43200000.
# EVEJS_LNE_FACTION_INCURSIONS_MOBILIZING_MS=
# factionIncursions.withdrawingMs - Phase 3, then expired. Range 0..604800000. Default: 43200000.
# EVEJS_LNE_FACTION_INCURSIONS_WITHDRAWING_MS=
# factionIncursions.siteTtlMs - Lifetime of a site. Range 600000..86400000. Default: 21600000.
# EVEJS_LNE_FACTION_INCURSIONS_SITE_TTL_MS=
# factionIncursions.siteRespawnMs - A slot waits this long after its site ended. Range 0..86400000. Default: 600000.
# EVEJS_LNE_FACTION_INCURSIONS_SITE_RESPAWN_MS=
# factionIncursions.minSiteWindowMs - No new site this close to the end. Range 0..86400000. Default: 1800000.
# EVEJS_LNE_FACTION_INCURSIONS_MIN_SITE_WINDOW_MS=
# factionIncursions.influence.initialMaxMilli - Player control at the start (offensive strength 0). Range 0..1000.
# Default: 600.
# EVEJS_LNE_FACTION_INCURSIONS_INFLUENCE_INITIAL_MAX_MILLI=
# factionIncursions.influence.initialMinMilli - Player control at the start (offensive strength 100). Range 0..1000.
# Default: 0.
# EVEJS_LNE_FACTION_INCURSIONS_INFLUENCE_INITIAL_MIN_MILLI=
# factionIncursions.influence.perCompletionMilli - Player control per cleared site. Range 1..1000. Default: 250.
# EVEJS_LNE_FACTION_INCURSIONS_INFLUENCE_PER_COMPLETION_MILLI=
# factionIncursions.influence.graceMinutes - Minutes without decay after a clear. Range 0..1440. Default: 10.
# EVEJS_LNE_FACTION_INCURSIONS_INFLUENCE_GRACE_MINUTES=
# factionIncursions.influence.decayMilliPerHour - Decay of the player control per hour. Range 0..1000. Default: 20.
# EVEJS_LNE_FACTION_INCURSIONS_INFLUENCE_DECAY_MILLI_PER_HOUR=
# factionIncursions.influence.hqUnlockMilli - The HQ site opens from this player control. Range 0..1000.
# Default: 1000.
# EVEJS_LNE_FACTION_INCURSIONS_INFLUENCE_HQ_UNLOCK_MILLI=
# factionIncursions.passIntervalMs - Timer of the pass. Range 5000..3600000. Default: 30000.
# EVEJS_LNE_FACTION_INCURSIONS_PASS_INTERVAL_MS=
# factionIncursions.maxIncursionsPerPass - Step transactions per pass. Range 1..16. Default: 4.
# EVEJS_LNE_FACTION_INCURSIONS_MAX_INCURSIONS_PER_PASS=
# factionIncursions.maxSitePlansPerPass - Site plans per pass. Range 0..16. Default: 4.
# EVEJS_LNE_FACTION_INCURSIONS_MAX_SITE_PLANS_PER_PASS=
# factionIncursions.maxCreatesPerPass - New incursions per pass. Range 0..4. Default: 1.
# EVEJS_LNE_FACTION_INCURSIONS_MAX_CREATES_PER_PASS=
# factionIncursions.maxSettlementsPerPass - Settlement transactions per pass. Range 1..32. Default: 4.
# EVEJS_LNE_FACTION_INCURSIONS_MAX_SETTLEMENTS_PER_PASS=
# factionIncursions.maxTargets - Claim rows read per faction. Range 1..512. Default: 64.
# EVEJS_LNE_FACTION_INCURSIONS_MAX_TARGETS=
# factionIncursions.maxSiteClearsPerIncursion - Receipts of one incursion. Range 8..384. Default: 128.
# EVEJS_LNE_FACTION_INCURSIONS_MAX_SITE_CLEARS_PER_INCURSION=
# factionIncursions.settleMaxAttempts - Refused settlements before the effect FAILED. Range 1..100. Default: 10.
# EVEJS_LNE_FACTION_INCURSIONS_SETTLE_MAX_ATTEMPTS=
# Incursions window entries and the influence HUD.
# factionIncursions.ui.enabled - Active incursions in the native Incursions window, after the invasions (needs
# invasions.enabled and invasions.incursionUi.enabled, W245). true/false. Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_UI_ENABLED=
# factionIncursions.hud.enabled - Influence HUD (OnTaleData) for a player in a system of an incursion; no HUD in a
# system of a vendor tale. true/false. Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_HUD_ENABLED=
# factionIncursions.hud.refreshMs - Timer of the HUD sync (a newly observed system at once). Range 1000..60000.
# Default: 5000.
# EVEJS_LNE_FACTION_INCURSIONS_HUD_REFRESH_MS=
# factionIncursions.hud.maxSessionsPerSync - Sessions of one HUD sync. Range 1..4096. Default: 256.
# EVEJS_LNE_FACTION_INCURSIONS_HUD_MAX_SESSIONS_PER_SYNC=
# factionIncursions.hud.removeTemplateID - templateID of OnTaleRemove (vendor synthetic removal id). Range
# 0..2147483647. Default: 980000001.
# EVEJS_LNE_FACTION_INCURSIONS_HUD_REMOVE_TEMPLATE_ID=
# System effects of the LNE incursions.
# factionIncursions.effects.enabled - The vendor incursion effects (resistance and damage penalty scaled by 1 -
# influence, bounty x0.5, cyno block) in the systems of an LNE incursion; a vendor tale wins. Off = no wrap of the
# vendor exports. true/false. Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_EFFECTS_ENABLED=
# factionIncursions.effects.maxRefreshPerPass - Player ships refreshed per pass. Range 0..1024. Default: 64.
# EVEJS_LNE_FACTION_INCURSIONS_EFFECTS_MAX_REFRESH_PER_PASS=
# factionIncursions.effects.refreshDeltaMilli - Change of the opposition (milli) that refreshes the ships of a system.
# Range 1..1000. Default: 50.
# EVEJS_LNE_FACTION_INCURSIONS_EFFECTS_REFRESH_DELTA_MILLI=
# Rewards of the LNE incursions (heavyEvents pump, W249).
# factionIncursions.rewards.enabled - LP per role of the site participants and the HQ pool of a defeated incursion.
# Off = the site payouts of. true/false. Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_REWARDS_ENABLED=
# factionIncursions.rewards.lpPerRole - LP of one participant of one site per role (role:LP, roles
# hq,assault,vanguard,staging, each once, LP 0..1000000, a role not named = 0).
# Default: staging:1000,vanguard:2000,assault:3000,hq:5000.
# EVEJS_LNE_FACTION_INCURSIONS_REWARDS_LP_PER_ROLE=
# factionIncursions.rewards.siteStandingMicro - Standing (micro) of a site participant to the defender, every role.
# Range 0..100000. Default: 50000.
# EVEJS_LNE_FACTION_INCURSIONS_REWARDS_SITE_STANDING_MICRO=
# factionIncursions.rewards.hqPoolLp - LP of the HQ pool per participant of a defeated incursion (0 = no pool).
# Range 0..1000000. Default: 5000.
# EVEJS_LNE_FACTION_INCURSIONS_REWARDS_HQ_POOL_LP=
# factionIncursions.rewards.maxPoolParticipants - Participants of one HQ pool (character id ascending); this + 16
# rows must fit persistence.maxRowsPerTransaction (else ROW_BOUND, no pool). Range 1..256. Default: 64.
# EVEJS_LNE_FACTION_INCURSIONS_REWARDS_MAX_POOL_PARTICIPANTS=
# factionIncursions.rewards.poolMaxHoldPasses - Settle passes a defeated incursion waits for the heavyEvents pump;
# then it settles without a pool (HEAVY_EVENTS_UNAVAILABLE). Range 1..100000. Default: 120.
# EVEJS_LNE_FACTION_INCURSIONS_REWARDS_POOL_MAX_HOLD_PASSES=
# The consequence of a settled LNE incursion in its
# constellation (the same transaction and key as the settlement).
# factionIncursions.consequences.enabled - Influence drops in every claimant system of a settled incursion. Off = the
# settlement of (the payload without factionId). true/false. Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_CONSEQUENCES_ENABLED=
# factionIncursions.consequences.defeatInfluencePoints - Influence the attacker loses per claimant system after
# defeated (the target only when the repel made no drop). 0 = no drop. Range 0..100. Default: 10.
# EVEJS_LNE_FACTION_INCURSIONS_CONSEQUENCES_DEFEAT_INFLUENCE_POINTS=
# factionIncursions.consequences.expireInfluencePoints - Influence the controller loses per claimant system after
# expired, scaled by the strength of the incursion (ceil(points x strength_milli / 1000), at least 1). 0 = no drop.
# Range 0..100. Default: 10.
# EVEJS_LNE_FACTION_INCURSIONS_CONSEQUENCES_EXPIRE_INFLUENCE_POINTS=
# factionIncursions.consequences.newsEnabled - FACTION_INCURSION_DEFEATED / _HELD facts of the galactic news (also
# news.enabled, W250). true/false. Default: false.
# EVEJS_LNE_FACTION_INCURSIONS_CONSEQUENCES_NEWS_ENABLED=
# Advanced inputs (moon / PI) of a job start.
# production.advancedInputsEnabled - A job start takes the advanced inputs from the station stock. true/false.
# Default: false.
# EVEJS_LNE_PRODUCTION_ADVANCED_INPUTS_ENABLED=
# production.advancedInputsMode - optional (take what the stock has) or required (refuse the start).
# Default: optional.
# EVEJS_LNE_PRODUCTION_ADVANCED_INPUTS_MODE=
# production.advancedInputsPermille - Multiplier of the advanced inputs (0 = none). Range 0..5000. Default: 1000.
# EVEJS_LNE_PRODUCTION_ADVANCED_INPUTS_PERMILLE=

# A rare vendor officer of a pirate faction at the player's ship
# (LNE hunt after the fight, wreck anomaly after the first visit). Loot and eligibility are the vendor's.
# Internal: not in the launcher. Limits live in the mod journal (survive a restart).
# officerSpawns.enabled - Feature flag (module world + persistence). true/false. Default: false.
# EVEJS_LNE_OFFICER_SPAWNS_ENABLED=
# officerSpawns.huntEnabled / salvageEnabled - Sources of an officer. true/false. Default: false / false.
# EVEJS_LNE_OFFICER_SPAWNS_HUNT_ENABLED=
# EVEJS_LNE_OFFICER_SPAWNS_SALVAGE_ENABLED=
# officerSpawns.huntChancePermille / salvageChancePermille - Chance per hunt / per anomaly. Range 0..1000.
# Default: 30 / 50.
# EVEJS_LNE_OFFICER_SPAWNS_HUNT_CHANCE_PERMILLE=
# EVEJS_LNE_OFFICER_SPAWNS_SALVAGE_CHANCE_PERMILLE=
# officerSpawns.maxPerSystemPerDay / maxPerDay - Officers per system and UTC day / server wide per UTC day, 0 = none.
# Ranges 0..20 / 0..200. Default: 1 / 6.
# EVEJS_LNE_OFFICER_SPAWNS_MAX_PER_SYSTEM_PER_DAY=
# EVEJS_LNE_OFFICER_SPAWNS_MAX_PER_DAY=
# officerSpawns.spawnDistanceMeters - Distance from the player's ship. Range 5000..100000. Default: 30000.
# EVEJS_LNE_OFFICER_SPAWNS_SPAWN_DISTANCE_METERS=

# Wanted bosses of outlaw gangs (virtualCorps owner kind outlaw)
# roam the territory of their pirate faction and show in Local (needs modules.world and modules.virtualCorps).
# Internal: not in the launcher, no compose line.
# bountyHunters.enabled - Feature flag. true/false. Default: false.
# EVEJS_LNE_BOUNTY_ENABLED=
# bountyHunters.passMs - Timer of the pass. Range 1000..600000. Default: 5000.
# EVEJS_LNE_BOUNTY_PASS_MS=
# bountyHunters.maxGangs / gangMembers - Outlaw gangs / characters per gang; target slots = maxGangs x gangMembers.
# Ranges 1..100 / 1..8. Default: 60 / 5.
# EVEJS_LNE_BOUNTY_MAX_GANGS=
# EVEJS_LNE_BOUNTY_GANG_MEMBERS=
# bountyHunters.maxActive - Wanted targets on the map at a time. Range 0..800. Default: 260.
# EVEJS_LNE_BOUNTY_MAX_ACTIVE=
# bountyHunters.respawnCooldownMs - Pause of a slot after its target EXPIRED. Range 0..2592000000. Default: 3600000.
# EVEJS_LNE_BOUNTY_RESPAWN_COOLDOWN_MS=
# bountyHunters.killedCooldownMs - Pause of a slot after its boss was KILLED. Range 0..2592000000. Default: 43200000.
# EVEJS_LNE_BOUNTY_KILLED_COOLDOWN_MS=
# bountyHunters.movesPerPass / createsPerPass - Moves and new targets of one pass. Ranges 1..256 / 1..64.
# Default: 16 / 4.
# EVEJS_LNE_BOUNTY_MOVES_PER_PASS=
# EVEJS_LNE_BOUNTY_CREATES_PER_PASS=
# bountyHunters.pruneEveryMs / prunePerRun - Retention run pause / rows per run. Ranges 60000..86400000 / 1..500.
# Default: 600000 / 50.
# EVEJS_LNE_BOUNTY_PRUNE_EVERY_MS=
# EVEJS_LNE_BOUNTY_PRUNE_PER_RUN=
# bountyHunters.resyncMs - Reread of the RAM index. Range 60000..86400000. Default: 600000.
# EVEJS_LNE_BOUNTY_RESYNC_MS=
# bountyHunters.maxEnsuringGangs / ensureStaleMs - Gangs created at a time / age of a stale ensure.
# Ranges 1..8 / 60000..86400000. Default: 1 / 600000.
# EVEJS_LNE_BOUNTY_MAX_ENSURING_GANGS=
# EVEJS_LNE_BOUNTY_ENSURE_STALE_MS=
# bountyHunters.statusMaxTargets - Targets listed in the status view. Range 0..300. Default: 20.
# EVEJS_LNE_BOUNTY_STATUS_MAX_TARGETS=
# bountyHunters.minStayMs - Shortest stay in a system. Range 60000..86400000. Default: 600000.
# EVEJS_LNE_BOUNTY_MIN_STAY_MS=
# bountyHunters.territoryRetryMs - Pause before the next try to build the faction territory. Range 5000..3600000.
# Default: 60000.
# EVEJS_LNE_BOUNTY_TERRITORY_RETRY_MS=
# bountyHunters.highsecEnabled - L1-L2 targets may start in highsec (false: new ones never, present ones live out).
# true/false. Default: true.
# EVEJS_LNE_BOUNTY_HIGHSEC_ENABLED=
# bountyHunters.smugglerPermille - Smuggler chance of an L3+ target. Range 0..1000. Default: 150.
# EVEJS_LNE_BOUNTY_SMUGGLER_PERMILLE=
# bountyHunters.rewardPermille - Multiplier of the level reward of a new target (1000 = L1 50M .. L6 4B; made
# targets keep theirs). Range 0..100000. Default: 1000.
# EVEJS_LNE_BOUNTY_REWARD_PERMILLE=
# bountyHunters.factionIds - CSV of pirate factionIDs whose gangs are awake (gang factions: territory, D'Hondt).
# Default: 500010,500011,500012,500019,500020.
# EVEJS_LNE_BOUNTY_FACTION_IDS=
# bountyHunters.retentionMs - Ended targets kept before deletion. Range 86400000..2592000000. Default: 604800000.
# EVEJS_LNE_BOUNTY_RETENTION_MS=
# the boss and escort in space (LIVE) while a pilot is in space of its system.
# bountyHunters.liveEnabled - Feature flag. true/false. Default: false.
# EVEJS_LNE_BOUNTY_LIVE_ENABLED=
# bountyHunters.maxLive - LIVE groups server wide. Range 0..16. Default: 4.
# EVEJS_LNE_BOUNTY_MAX_LIVE=
# bountyHunters.liveSpawnsPerPass - New LIVE groups of one pass. Range 1..4. Default: 1.
# EVEJS_LNE_BOUNTY_LIVE_SPAWNS_PER_PASS=
# bountyHunters.maxShipsPerTarget - Ships of one LIVE group (boss + escorts). Range 1..12. Default: 8.
# EVEJS_LNE_BOUNTY_MAX_SHIPS_PER_TARGET=
# bountyHunters.idleDespawnMs - Despawn after no pilot in space this long. Range 10000..3600000. Default: 120000.
# EVEJS_LNE_BOUNTY_IDLE_DESPAWN_MS=
# bountyHunters.ambushDelayMs - Escort of an AMBUSH boss after the first aggression. Range 0..600000. Default: 20000.
# EVEJS_LNE_BOUNTY_AMBUSH_DELAY_MS=
# bountyHunters.escapeConfirmMs - Boss gone after the warp-off = escaped after this. Range 0..60000. Default: 3000.
# EVEJS_LNE_BOUNTY_ESCAPE_CONFIRM_MS=
# bountyHunters.killedDespawnMs - Escort of a killed boss leaves after this. Range 0..3600000. Default: 60000.
# EVEJS_LNE_BOUNTY_KILLED_DESPAWN_MS=
# bountyHunters.victimRegisterCap - RAM register of the bounty ships. Range 16..512. Default: 64.
# EVEJS_LNE_BOUNTY_VICTIM_REGISTER_CAP=
# bountyHunters.liveRetryMs - Pause after NO_ANCHOR / a refused spawn / a lost group. Range 60000..3600000.
# Default: 600000.
# EVEJS_LNE_BOUNTY_LIVE_RETRY_MS=
# bountyHunters.runnerWarpRetryMs - A tackled RUNNER fights back this long, then warps off again (0 = vendor retry).
# Range 0..300000. Default: 20000.
# EVEJS_LNE_BOUNTY_RUNNER_WARP_RETRY_MS=
# bountyHunters.killRetryMaxMs - A boss kill refused by the store is retried this long, then dropped.
# Range 10000..86400000. Default: 600000.
# EVEJS_LNE_BOUNTY_KILL_RETRY_MAX_MS=
# the RUNNER / SMUGGLER escape through a stargate.
# bountyHunters.escapeViaGate - A fleeing boss warps to the gate of its escape neighbour and jumps (off = warp-off).
# true/false. Default: true.
# EVEJS_LNE_BOUNTY_ESCAPE_VIA_GATE=
# bountyHunters.gateLandingMeters - The flee warp lands this far off the gate. Range 0..20000. Default: 2000.
# EVEJS_LNE_BOUNTY_GATE_LANDING_METERS=
# bountyHunters.gateJumpRangeMeters - A fleeing boss this close to the gate jumps. Range 500..20000. Default: 2500.
# EVEJS_LNE_BOUNTY_GATE_JUMP_RANGE_METERS=
# bountyHunters.gateJumpDespawnMs - The group leaves this long after the JumpOut. Range 0..30000. Default: 3000.
# EVEJS_LNE_BOUNTY_GATE_JUMP_DESPAWN_MS=
# bountyHunters.gateControllerEventsEnabled - Gate Arrival/Departure animation for bounty ships at gates. Range:
# true/false. Default: false.
# EVEJS_LNE_BOUNTY_GATE_CONTROLLER_EVENTS_ENABLED=
# bountyHunters.fleeRetryMs - A flee warp held by tackle is ordered again after this. Range 1000..300000.
# Default: 15000.
# EVEJS_LNE_BOUNTY_FLEE_RETRY_MS=
# bountyHunters.followSpawnWindowMs - Spawn at the gate back within this window after a jump (0 = off).
# Range 0..1800000. Default: 180000.
# EVEJS_LNE_BOUNTY_FOLLOW_SPAWN_WINDOW_MS=
# the reward (once), the loot of the boss, the smuggler freighter.
# bountyHunters.payoutEnabled - Feature flag: pay the PENDING bounty payouts. true/false. Default: false.
# EVEJS_LNE_BOUNTY_PAYOUT_ENABLED=
# bountyHunters.payoutPassMs - Timer of the payout pump. Range 1000..600000. Default: 5000.
# EVEJS_LNE_BOUNTY_PAYOUT_PASS_MS=
# bountyHunters.payoutBatch - Payouts of one pump pass. Range 1..64. Default: 4.
# EVEJS_LNE_BOUNTY_PAYOUT_BATCH=
# bountyHunters.payoutMaxAttempts - Transient wallet failures before FAILED. Range 1..100. Default: 8.
# EVEJS_LNE_BOUNTY_PAYOUT_MAX_ATTEMPTS=
# bountyHunters.payoutRetryBaseMs - First backoff of a transient wallet failure (doubles per attempt).
# Range 1000..3600000. Default: 60000.
# EVEJS_LNE_BOUNTY_PAYOUT_RETRY_BASE_MS=
# bountyHunters.payoutRetryMaxMs - Cap of the payout backoff. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_BOUNTY_PAYOUT_RETRY_MAX_MS=
# bountyHunters.payoutRetentionMs - Settled payouts kept. Range 86400000..31536000000. Default: 2592000000.
# EVEJS_LNE_BOUNTY_PAYOUT_RETENTION_MS=
# bountyHunters.lootEnabled - Feature flag: contraband / officer loot in the boss hold. true/false. Default: false.
# EVEJS_LNE_BOUNTY_LOOT_ENABLED=
# bountyHunters.smugglerEnabled - Feature flag: smuggler freighters (10 NPC profile rows, 2 per faction). true/false. Default: false.
# EVEJS_LNE_BOUNTY_SMUGGLER_ENABLED=
# bountyHunters.smugglerWarpOffDelayMs - A SMUGGLER warps off after the first aggression. Range 0..600000.
# Default: 60000.
# EVEJS_LNE_BOUNTY_SMUGGLER_WARP_OFF_DELAY_MS=
# the section Wanted of the board window.
# bountyHunters.boardEnabled - Feature flag: the board shows the section Wanted. true/false. Default: false.
# EVEJS_LNE_BOUNTY_BOARD_ENABLED=
# bountyHunters.boardNearJumps - Near you: a visible trace within this many jumps. Range 1..15. Default: 8.
# EVEJS_LNE_BOUNTY_BOARD_NEAR_JUMPS=
# bountyHunters.boardNearRows - Rows of Near you. Range 0..12. Default: 6.
# EVEJS_LNE_BOUNTY_BOARD_NEAR_ROWS=
# bountyHunters.boardTopRows - Rows of Most wanted. Range 0..12. Default: 5.
# EVEJS_LNE_BOUNTY_BOARD_TOP_ROWS=
# bountyHunters.boardCacheTtlMs - Summary / Most wanted shared by every viewer this long. Range 0..600000.
# Default: 10000.
# EVEJS_LNE_BOUNTY_BOARD_CACHE_TTL_MS=
# the revenge of a gang on the killer of its boss (no spawn yet).
# bountyHunters.revengeEnabled - Feature flag: the kill of an L4+ boss writes a revenge of its gang. true/false.
# Default: false.
# EVEJS_LNE_BOUNTY_REVENGE_ENABLED=
# bountyHunters.revengeMinLevel - Lowest boss level whose kill is avenged. Range 2..6. Default: 4.
# EVEJS_LNE_BOUNTY_REVENGE_MIN_LEVEL=
# bountyHunters.revengeDelayMs - The revenge waits this long after the kill. Range 0..604800000. Default: 14400000.
# EVEJS_LNE_BOUNTY_REVENGE_DELAY_MS=
# bountyHunters.revengeWindowMs - The revenge expires this long after the kill. Range 3600000..2592000000.
# Default: 172800000.
# EVEJS_LNE_BOUNTY_REVENGE_WINDOW_MS=
# bountyHunters.revengeMaxJumps - Hunted only within this many jumps of the kill system. Range 0..15. Default: 5.
# EVEJS_LNE_BOUNTY_REVENGE_MAX_JUMPS=
# bountyHunters.revengeChecksPerPass - Revenge rows checked / expired in one pass. Range 1..64. Default: 8.
# EVEJS_LNE_BOUNTY_REVENGE_CHECKS_PER_PASS=
# bountyHunters.revengeCheckEveryMs - Pause between two start checks of one row. Range 5000..600000. Default: 30000.
# EVEJS_LNE_BOUNTY_REVENGE_CHECK_EVERY_MS=
# the revenge squad in space near the killer (revengeEnabled + liveEnabled).
# bountyHunters.revengeMaxLive - Revenge squads in space server wide. Range 0..4. Default: 1.
# EVEJS_LNE_BOUNTY_REVENGE_MAX_LIVE=
# bountyHunters.revengeMaxAttempts - Squads without contact before EXPIRED. Range 1..10. Default: 3.
# EVEJS_LNE_BOUNTY_REVENGE_MAX_ATTEMPTS=
# bountyHunters.revengeRetryMs - Pause after a squad without contact. Range 60000..86400000. Default: 1800000.
# EVEJS_LNE_BOUNTY_REVENGE_RETRY_MS=
# bountyHunters.revengeMaxDurationMs - A squad leaves after this long. Range 60000..3600000. Default: 900000.
# EVEJS_LNE_BOUNTY_REVENGE_MAX_DURATION_MS=
# bountyHunters.revengeMaxScanCycles - Scan cycles before NOT_FOUND. Range 1..100. Default: 10.
# EVEJS_LNE_BOUNTY_REVENGE_MAX_SCAN_CYCLES=

# Persistent crews of the mod's fleets (world_fleet_crews*, virtualCorps
# characters; needs modules.fleets and modules.virtualCorps). Internal: not in the launcher. Read at boot (restart).
# crews.enabled - Feature flag. true/false. Default: false.
# on = Local shows the crews of the present fleets and exposure losses take pilots (LIVE). Compose:-0.
# EVEJS_LNE_CREWS_ENABLED=

# crews.refreshMs - Period of the pass. Range 5000..600000. Default: 30000.
# EVEJS_LNE_CREWS_REFRESH_MS=

# crews.nudgeDelayMs - Delay of a pass after a request or a presence change. Range 100..30000. Default: 1000.
# EVEJS_LNE_CREWS_NUDGE_DELAY_MS=

# crews.shipsPerPilot - Ships of a fleet per crew seat (ceil). Range 1..100. Default: 1.
# EVEJS_LNE_CREWS_SHIPS_PER_PILOT=

# crews.maxCrewPerFleet - Seats of one fleet. Range 1..500. Default: 64.
# EVEJS_LNE_CREWS_MAX_CREW_PER_FLEET=

# crews.maxFleetsPerPass - Fleets reconciled per pass. Range 1..500 (= fleets.maxListLimit). Default: 64.
# EVEJS_LNE_CREWS_MAX_FLEETS_PER_PASS=

# crews.maxSettleRows - Rows of the crews battle consequence, reserved on top of battle.settleRowsReserve when
# crews.enabled; the seats over it go later in a crews pass (no loss). Range 3..500. Default: 32.
# EVEJS_LNE_CREWS_MAX_SETTLE_ROWS=

# crews.maxSeatWritesPerPass - Seat writes of one pass (x2 <= persistence.maxRowsPerTransaction). Range 16..400.
# Default: 256.
# EVEJS_LNE_CREWS_MAX_SEAT_WRITES_PER_PASS=

# crews.maxReclaimPerPass - Seats taken from unwatched fleets per pass. Range 0..400. Default: 64.
# EVEJS_LNE_CREWS_MAX_RECLAIM_PER_PASS=

# crews.lostCooldownMs - A pilot who lost a ship waits this long. Range 0..604800000. Default: 21600000 (6 h).
# EVEJS_LNE_CREWS_LOST_COOLDOWN_MS=

# crews.seenWriteMs - last_seen_at is written at most this often. Range 60000..86400000. Default: 600000.
# EVEJS_LNE_CREWS_SEEN_WRITE_MS=

# crews.reclaimMinIdleMs - A fleet unseen this long may lose seats to a watched one. Range 0..86400000.
# Default: 1800000.
# EVEJS_LNE_CREWS_RECLAIM_MIN_IDLE_MS=

# crews.backgroundEnlist - Free pilots also crew unwatched fleets. true/false. Default: true.
# EVEJS_LNE_CREWS_BACKGROUND_ENLIST=

# crews.observerMaxPilots - Pilot lines of the system card. Range 1..200. Default: 40.
# EVEJS_LNE_CREWS_OBSERVER_MAX_PILOTS=

# crews.tooltipMaxNames - Pilot names in a fleet tooltip. Range 0..20. Default: 5.
# EVEJS_LNE_CREWS_TOOLTIP_MAX_NAMES=

# An NPC station in a system controlled by a faction refuses docking to a player
# with a bad standing to that faction (needs modules.world). Every read fault lets the dock through.
# All keys internal: not in the launcher, values outside the range are clamped.
# loyalty.dockDenyEnabled - Feature flag. true/false. Default: false.
# EVEJS_LNE_LOYALTY_DOCK_DENY_ENABLED=

# loyalty.dockDenyStandingMax - Standing to the controller at or below which docking is refused. Range -10..0.
# Default: -5.
# EVEJS_LNE_LOYALTY_DOCK_DENY_STANDING_MAX=

# loyalty.dockDenyExemptCapsule - A capsule always docks. true/false. Default: true.
# EVEJS_LNE_LOYALTY_DOCK_DENY_EXEMPT_CAPSULE=

# Groups of NPC of the controller faction near a player at gates, stations
# and planets (not on the belts, not in anomalies). Memory only; needs modules.world. Internal: not in the launcher.
# = core and config only (seam, service).
# ambientRats.enabled - Feature flag (needs modules.world), off = no ambient groups. true/false. Default: false.
# EVEJS_LNE_AMBIENT_RATS_ENABLED=

# ambientRats.bands - security bands (highsec off: vendor gate CONCORD shoots NPC). Default: lowsec,nullsec.
# EVEJS_LNE_AMBIENT_RATS_BANDS=

# ambientRats.factionKinds - kinds of the controller faction. Default: pirate,empire,hive.
# EVEJS_LNE_AMBIENT_RATS_FACTION_KINDS=

# ambientRats.scope - controlled = every system of the faction, captured = only controller!= home faction. Default: controlled.
# EVEJS_LNE_AMBIENT_RATS_SCOPE=

# ambientRats.anchorKinds - spawn places (never a belt, never an anomaly). Default: stargate,station,planet.
# EVEJS_LNE_AMBIENT_RATS_ANCHOR_KINDS=

# ambientRats.groupsHighsec - Target groups of a highsec system. Range 0..8. Default: 1.
# EVEJS_LNE_AMBIENT_RATS_GROUPS_HIGHSEC=

# ambientRats.groupsLowsec - Target groups of a lowsec system. Range 0..8. Default: 2.
# EVEJS_LNE_AMBIENT_RATS_GROUPS_LOWSEC=

# ambientRats.groupsNullsec - Target groups of a nullsec system. Range 0..8. Default: 3.
# EVEJS_LNE_AMBIENT_RATS_GROUPS_NULLSEC=

# ambientRats.maxShipsPerGroup - MaxCount ceiling of the vendor plan of a group. Range 1..12. Default: 5.
# EVEJS_LNE_AMBIENT_RATS_MAX_SHIPS_PER_GROUP=

# ambientRats.maxGroupsGlobal - Groups in the registry, server wide. Range 1..512. Default: 48.
# EVEJS_LNE_AMBIENT_RATS_MAX_GROUPS_GLOBAL=

# ambientRats.maxShipsGlobal - Ambient ships, server wide. Range 1..2000. Default: 200.
# EVEJS_LNE_AMBIENT_RATS_MAX_SHIPS_GLOBAL=

# ambientRats.pollMs - Pause of the timer between passes. Range 1000..60000. Default: 5000.
# EVEJS_LNE_AMBIENT_RATS_POLL_MS=

# ambientRats.maxSystemsPerPass - Systems evaluated for a spawn in one pass. Range 1..64. Default: 8.
# EVEJS_LNE_AMBIENT_RATS_MAX_SYSTEMS_PER_PASS=

# ambientRats.maxGroupsPerPass - Groups handled in one pass (rotation). Range 1..256. Default: 16.
# EVEJS_LNE_AMBIENT_RATS_MAX_GROUPS_PER_PASS=

# ambientRats.maxSpawnsPerPass - New groups in one pass. Range 1..8. Default: 1.
# EVEJS_LNE_AMBIENT_RATS_MAX_SPAWNS_PER_PASS=

# ambientRats.spawnIntervalMs - Minimum time between two spawns in one system. Range 5000..3600000. Default: 60000.
# EVEJS_LNE_AMBIENT_RATS_SPAWN_INTERVAL_MS=

# ambientRats.respawnCooldownMs - Pause of a system after a group was wiped. Range 0..86400000. Default: 600000.
# EVEJS_LNE_AMBIENT_RATS_RESPAWN_COOLDOWN_MS=

# ambientRats.groupTtlMs - Age after which a group leaves when nobody is in range. Range 60000..86400000. Default: 1800000.
# EVEJS_LNE_AMBIENT_RATS_GROUP_TTL_MS=

# ambientRats.exitGraceMs - No player in space of the system this long = despawn of its groups. Range 0..3600000. Default: 120000.
# EVEJS_LNE_AMBIENT_RATS_EXIT_GRACE_MS=

# ambientRats.aggroRangeMeters - Range of the targets and of the TTL. Range 10000..1000000. Default: 150000.
# EVEJS_LNE_AMBIENT_RATS_AGGRO_RANGE_METERS=

# ambientRats.vendorAggroEnabled - vendor proximity aggro while every pilot of the system is hostile. true/false. Default: true.
# EVEJS_LNE_AMBIENT_RATS_VENDOR_AGGRO_ENABLED=

# ambientRats.minPlayerDistanceMeters - No spawn at an anchor closer to a player (no pop-in). Range 0..10000000. Default: 500000.
# EVEJS_LNE_AMBIENT_RATS_MIN_PLAYER_DISTANCE_METERS=

# ambientRats.anchorClearMeters - An anchor with a foreign NPC closer is skipped. Range 0..1000000. Default: 100000.
# EVEJS_LNE_AMBIENT_RATS_ANCHOR_CLEAR_METERS=

# ambientRats.distanceFromSurfaceMeters - Distance of a group from the surface of its anchor. Range 1000..200000. Default: 20000.
# EVEJS_LNE_AMBIENT_RATS_DISTANCE_FROM_SURFACE_METERS=

# ambientRats.maxStandingReadsPerPass - Standing reads in one pass (cache of the pass). Range 1..1024. Default: 64.
# EVEJS_LNE_AMBIENT_RATS_MAX_STANDING_READS_PER_PASS=

# ambientRats.maxRepaintsPerPass - Entities repainted in one pass. Range 0..1024. Default: 64.
# EVEJS_LNE_AMBIENT_RATS_MAX_REPAINTS_PER_PASS=

# ambientRats.eligibilityCacheMs - Cache of the eligibility decision of a system. Range 0..3600000. Default: 60000.
# EVEJS_LNE_AMBIENT_RATS_ELIGIBILITY_CACHE_MS=

# ambientRats.highsecNavy - passive empire navy in highsec, SDE controller (CONCORD skipped; refused while the vendor gate CONCORD aggroes NPC). true/false. Default: false.
# EVEJS_LNE_AMBIENT_RATS_HIGHSEC_NAVY=

# ambientRats.gatePicketsEnabled - gate pickets in controlled nullsec from the transit risk index (needs ambientRats.enabled and transit.enabled; cold index = no picket). true/false. Default: false.
# EVEJS_LNE_AMBIENT_RATS_GATE_PICKETS_ENABLED=

# ambientRats.gatePicketTiers - <chance permille>:<gates> tiers of the transit chanceBase, chance ascending. Default: 100:1,200:2,300:3.
# EVEJS_LNE_AMBIENT_RATS_GATE_PICKET_TIERS=

# ambientRats.gatePicketMaxGates - ceiling of the gates with a picket in one system (0 = no picket). Range 0..8. Default: 3.
# EVEJS_LNE_AMBIENT_RATS_GATE_PICKET_MAX_GATES=

# A capsule appears at the wreck of a destroyed NPC ship near a player, warps out in a random direction
# and is removed. Visual effect only: memory only, no bounty, loot, killmail or kill rights.
# Needs modules.world. Internal: not in the launcher. Every flag is off by default.
# capsuleFx.enabled - Feature flag (needs modules.world). true/false. Default: false.
# EVEJS_LNE_CAPSULE_FX_ENABLED=

# capsuleFx.civilianEnabled - Source: civilian highsec traffic. true/false. Default: false.
# EVEJS_LNE_CAPSULE_FX_CIVILIAN_ENABLED=

# capsuleFx.ratsEnabled - Source: vendor rats outside missions (belts, anomalies, sites). true/false. Default: false.
# EVEJS_LNE_CAPSULE_FX_RATS_ENABLED=

# capsuleFx.missionRatsEnabled - Source: vendor rats of a mission site. true/false. Default: false.
# EVEJS_LNE_CAPSULE_FX_MISSION_RATS_ENABLED=

# capsuleFx.lneFleetsEnabled - Source: fleets, scenes and materializations of the mod. true/false. Default: false.
# EVEJS_LNE_CAPSULE_FX_LNE_FLEETS_ENABLED=

# capsuleFx.warpDelayMs - Pause between the spawn and the warp. Range 0..30000. Default: 2500.
# EVEJS_LNE_CAPSULE_FX_WARP_DELAY_MS=

# capsuleFx.despawnAfterWarpMs - The capsule is removed this long after the warp started. Range 500..60000.
# Default: 4000.
# EVEJS_LNE_CAPSULE_FX_DESPAWN_AFTER_WARP_MS=

# capsuleFx.maxLifetimeMs - Removal of a capsule that could not warp (at least warpDelayMs + despawnAfterWarpMs).
# Range 2000..120000. Default: 20000.
# EVEJS_LNE_CAPSULE_FX_MAX_LIFETIME_MS=

# capsuleFx.warpDistanceAu - Warp distance in a random direction. Range 0.5..50. Default: 3.
# EVEJS_LNE_CAPSULE_FX_WARP_DISTANCE_AU=

# capsuleFx.spawnOffsetMeters - Spawn distance from the wreck surface. Range 0..5000. Default: 300.
# EVEJS_LNE_CAPSULE_FX_SPAWN_OFFSET_METERS=

# capsuleFx.viewMeters - A player ship this close to the wreck is needed for a capsule. Range 10000..2000000.
# Default: 300000.
# EVEJS_LNE_CAPSULE_FX_VIEW_METERS=

# capsuleFx.maxPerSystem - Queued and live capsules in one scene. Range 1..50. Default: 6.
# EVEJS_LNE_CAPSULE_FX_MAX_PER_SYSTEM=

# capsuleFx.maxGlobal - Queued and live capsules, server wide. Range 1..500. Default: 48.
# EVEJS_LNE_CAPSULE_FX_MAX_GLOBAL=

# capsuleFx.maxPending - Queue length, the excess is dropped. Range 1..1000. Default: 64.
# EVEJS_LNE_CAPSULE_FX_MAX_PENDING=

# capsuleFx.pendingMaxAgeMs - A queued capsule older than this is dropped. Range 250..30000. Default: 3000.
# EVEJS_LNE_CAPSULE_FX_PENDING_MAX_AGE_MS=

# capsuleFx.maxSpawnsPerPass - Spawns in one pass. Range 1..100. Default: 8.
# EVEJS_LNE_CAPSULE_FX_MAX_SPAWNS_PER_PASS=

# capsuleFx.maxActionsPerPass - Warps and removals in one pass. Range 1..500. Default: 32.
# EVEJS_LNE_CAPSULE_FX_MAX_ACTIONS_PER_PASS=

# capsuleFx.pollMs - Pause of the timer between passes. Range 100..5000. Default: 250.
# EVEJS_LNE_CAPSULE_FX_POLL_MS=

# capsuleFx.untargetable - The capsule refuses a target lock. true/false. Default: true.
# EVEJS_LNE_CAPSULE_FX_UNTARGETABLE=

# capsuleFx.excludedFactionIds - Factions without a capsule (empty = none). Default: 500021,500024,500025.
# EVEJS_LNE_CAPSULE_FX_EXCLUDED_FACTION_IDS=

# Heavy PvE events (Redoubt, Field Foundry, Outpost Defense) in lowsec
# and nullsec. Needs modules.world and modules.sites. Internal: not in the launcher.
# = pure core, migration 64 and config only (service).
# heavyEvents.enabled - Feature flag (needs modules.world and modules.sites), off = no heavy events, no rows. true/false. Default: false.
# EVEJS_LNE_HEAVY_EVENTS_ENABLED=

# heavyEvents.redoubtEnabled - Type redoubt (under heavyEvents.enabled). true/false. Default: true.
# EVEJS_LNE_HEAVY_EVENTS_REDOUBT_ENABLED=

# heavyEvents.foundryEnabled - Type foundry (under heavyEvents.enabled). true/false. Default: true.
# EVEJS_LNE_HEAVY_EVENTS_FOUNDRY_ENABLED=

# heavyEvents.defenseEnabled - Type defense (under heavyEvents.enabled). true/false. Default: true.
# EVEJS_LNE_HEAVY_EVENTS_DEFENSE_ENABLED=

# heavyEvents.securityBands - security bands of the candidate systems. Default: lowsec,nullsec.
# EVEJS_LNE_HEAVY_EVENTS_SECURITY_BANDS=

# heavyEvents.factionKinds - Kinds of the content faction (controller; defense: the occupier). Default: pirate,invader,hive.
# EVEJS_LNE_HEAVY_EVENTS_FACTION_KINDS=

# heavyEvents.fundFromStock - redoubt and foundry take the full composition from the hull stock of the faction station. true/false. Default: true.
# EVEJS_LNE_HEAVY_EVENTS_FUND_FROM_STOCK=

# heavyEvents.pumpIntervalMs - Pause of the pump timer. Range 1000..60000. Default: 5000.
# EVEJS_LNE_HEAVY_EVENTS_PUMP_INTERVAL_MS=

# heavyEvents.planIntervalMs - period of the plan pass. Range 300000..86400000. Default: 3600000.
# EVEJS_LNE_HEAVY_EVENTS_PLAN_INTERVAL_MS=

# heavyEvents.presenceRadiusJumps - Jumps from an online player to a candidate system. Range 0..15. Default: 5.
# EVEJS_LNE_HEAVY_EVENTS_PRESENCE_RADIUS_JUMPS=

# heavyEvents.maxCandidateSystems - Candidate systems read by one plan pass. Range 1..512. Default: 64.
# EVEJS_LNE_HEAVY_EVENTS_MAX_CANDIDATE_SYSTEMS=

# heavyEvents.maxOpen - open events (PLANNED / ENGAGED / CLEARED). Range 0..16. Default: 3.
# EVEJS_LNE_HEAVY_EVENTS_MAX_OPEN=

# heavyEvents.maxOpenPerFaction - open events of one faction. Range 1..4. Default: 1.
# EVEJS_LNE_HEAVY_EVENTS_MAX_OPEN_PER_FACTION=

# heavyEvents.maxOpenPerType - Open events of one type. Range 1..16. Default: 2.
# EVEJS_LNE_HEAVY_EVENTS_MAX_OPEN_PER_TYPE=

# heavyEvents.systemCooldownMs - pause of a system after the end of its event. Range 0..604800000. Default: 86400000.
# EVEJS_LNE_HEAVY_EVENTS_SYSTEM_COOLDOWN_MS=

# heavyEvents.plannedTtlMs - Life of a PLANNED event without a player. Range 600000..86400000. Default: 14400000.
# EVEJS_LNE_HEAVY_EVENTS_PLANNED_TTL_MS=

# heavyEvents.engagedMaxMs - Longest fight of an event (then FAILED TIMEOUT). Range 600000..14400000. Default: 5400000.
# EVEJS_LNE_HEAVY_EVENTS_ENGAGED_MAX_MS=

# heavyEvents.abandonGraceMs - No player on the grid this long = abandon (back to PLANNED). Range 30000..3600000. Default: 300000.
# EVEJS_LNE_HEAVY_EVENTS_ABANDON_GRACE_MS=

# heavyEvents.maxAbandons - Abandons and restarts before EXPIRED. Range 1..10. Default: 3.
# EVEJS_LNE_HEAVY_EVENTS_MAX_ABANDONS=

# heavyEvents.aftermathMs - Beacon kept after COMPLETED. Range 60000..7200000. Default: 1800000.
# EVEJS_LNE_HEAVY_EVENTS_AFTERMATH_MS=

# heavyEvents.gridRadiusM - Radius of the grid around the beacon (players, copies). Range 10000..1000000. Default: 150000.
# EVEJS_LNE_HEAVY_EVENTS_GRID_RADIUS_M=

# heavyEvents.copyWeightPermille - a ShipWing copy counts this / 1000 of a ship. Range 0..1000. Default: 500.
# EVEJS_LNE_HEAVY_EVENTS_COPY_WEIGHT_PERMILLE=

# heavyEvents.maxUpscaleSteps - scaling steps of an event. Range 0..6. Default: 3.
# EVEJS_LNE_HEAVY_EVENTS_MAX_UPSCALE_STEPS=

# heavyEvents.shipsPerUpscaleStep - ships above the fleetSize of the tier per scaling step. Range 1..10. Default: 3.
# EVEJS_LNE_HEAVY_EVENTS_SHIPS_PER_UPSCALE_STEP=

# heavyEvents.maxShipsPerEvent - Members of one event. Range 1..60. Default: 30.
# EVEJS_LNE_HEAVY_EVENTS_MAX_SHIPS_PER_EVENT=

# heavyEvents.maxLiveShips - Live NPC of all events. Range 1..200. Default: 60.
# EVEJS_LNE_HEAVY_EVENTS_MAX_LIVE_SHIPS=

# heavyEvents.spawnDistanceM - Spawn distance of a phase from the beacon. Range 5000..200000. Default: 30000.
# EVEJS_LNE_HEAVY_EVENTS_SPAWN_DISTANCE_M=

# heavyEvents.aggroRangeM - Aggro range of the NPC. Range 10000..300000. Default: 100000.
# EVEJS_LNE_HEAVY_EVENTS_AGGRO_RANGE_M=

# heavyEvents.leashRangeM - Leash range of the NPC. Range 10000..500000. Default: 150000.
# EVEJS_LNE_HEAVY_EVENTS_LEASH_RANGE_M=

# heavyEvents.tierWeights - Draw weights of the tiers I,II,III (three integers >= 0, sum > 0). Default: 50,35,15.
# EVEJS_LNE_HEAVY_EVENTS_TIER_WEIGHTS=

# heavyEvents.redoubtInfluencePoints - Influence lost by the faction when its redoubt is cleared. Range 0..100. Default: 30.
# EVEJS_LNE_HEAVY_EVENTS_REDOUBT_INFLUENCE_POINTS=

# heavyEvents.foundryInfluencePoints - Influence lost by the faction when its foundry is cleared. Range 0..100. Default: 15.
# EVEJS_LNE_HEAVY_EVENTS_FOUNDRY_INFLUENCE_POINTS=

# heavyEvents.defenseInfluencePoints - Influence lost by the invader after a successful defense. Range 0..100. Default: 25.
# EVEJS_LNE_HEAVY_EVENTS_DEFENSE_INFLUENCE_POINTS=

# heavyEvents.foundryMinMineralUnits - Minerals of the station needed by a foundry. Range 0..1000000000. Default: 50000.
# EVEJS_LNE_HEAVY_EVENTS_FOUNDRY_MIN_MINERAL_UNITS=

# heavyEvents.foundryDrainPermille - Share of the station minerals drained when a foundry is cleared. Range 0..1000. Default: 200.
# EVEJS_LNE_HEAVY_EVENTS_FOUNDRY_DRAIN_PERMILLE=

# heavyEvents.foundryDrainMaxUnits - Cap of the drain of one foundry. Range 0..1000000000. Default: 500000.
# EVEJS_LNE_HEAVY_EVENTS_FOUNDRY_DRAIN_MAX_UNITS=

# heavyEvents.foundryLootSharePermille - Share of the drain put into the foundry chest. Range 0..1000. Default: 50.
# EVEJS_LNE_HEAVY_EVENTS_FOUNDRY_LOOT_SHARE_PERMILLE=

# heavyEvents.foundryLootMaxUnitsPerType - Cap of one mineral type in the foundry chest. Range 0..1000000. Default: 20000.
# EVEJS_LNE_HEAVY_EVENTS_FOUNDRY_LOOT_MAX_UNITS_PER_TYPE=

# heavyEvents.defenseWaves - Waves of a defense. Range 1..8. Default: 4.
# EVEJS_LNE_HEAVY_EVENTS_DEFENSE_WAVES=

# heavyEvents.waveIntervalMs - The next wave comes after this at the latest. Range 60000..1800000. Default: 360000.
# EVEJS_LNE_HEAVY_EVENTS_WAVE_INTERVAL_MS=

# heavyEvents.waveGrowthPermille - Growth of each wave over the first. Range 0..1000. Default: 250.
# EVEJS_LNE_HEAVY_EVENTS_WAVE_GROWTH_PERMILLE=

# heavyEvents.waveSpawnDistanceM - Spawn distance of a wave from the beacon. Range 10000..200000. Default: 60000.
# EVEJS_LNE_HEAVY_EVENTS_WAVE_SPAWN_DISTANCE_M=

# heavyEvents.pressureRadiusM - Invaders this close to the beacon wear the outpost integrity. Range 5000..100000. Default: 30000.
# EVEJS_LNE_HEAVY_EVENTS_PRESSURE_RADIUS_M=

# heavyEvents.pressurePerHullPerMinPermille - Integrity (permille) lost per hull weight per minute. Range 1..1000. Default: 8.
# EVEJS_LNE_HEAVY_EVENTS_PRESSURE_PER_HULL_PER_MIN_PERMILLE=

# heavyEvents.rewardMaxPerDay - Chests per day, server wide. Range 0..100. Default: 8.
# EVEJS_LNE_HEAVY_EVENTS_REWARD_MAX_PER_DAY=

# heavyEvents.rewardMaxPerSystemPerDay - Chests per day in one system. Range 0..10. Default: 1.
# EVEJS_LNE_HEAVY_EVENTS_REWARD_MAX_PER_SYSTEM_PER_DAY=

# heavyEvents.redoubtRolls - Loot rolls of the redoubt chest per tier I,II,III. Default: 4,6,9.
# EVEJS_LNE_HEAVY_EVENTS_REDOUBT_ROLLS=

# heavyEvents.rollsPerUpscaleStep - Extra rolls per scaling step. Range 0..3. Default: 1.
# EVEJS_LNE_HEAVY_EVENTS_ROLLS_PER_UPSCALE_STEP=

# heavyEvents.maxLootRolls - Cap of the rolls of one chest. Range 1..10. Default: 10.
# EVEJS_LNE_HEAVY_EVENTS_MAX_LOOT_ROLLS=

# heavyEvents.rewardMaxAttempts - Failed chest placements before SKIPPED. Range 1..100. Default: 10.
# EVEJS_LNE_HEAVY_EVENTS_REWARD_MAX_ATTEMPTS=

# heavyEvents.rewardWaitMs - Wait for a loaded scene before the chest is SKIPPED. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_HEAVY_EVENTS_REWARD_WAIT_MS=

# heavyEvents.beaconTemplateId - Dungeon template of the beacon (no NPC in the instance). Default: client-dungeon:6366.
# EVEJS_LNE_HEAVY_EVENTS_BEACON_TEMPLATE_ID=

# heavyEvents.retentionMs - Age of the terminal rows pruned. Range 86400000..7776000000. Default: 604800000.
# EVEJS_LNE_HEAVY_EVENTS_RETENTION_MS=

# heavyEvents.pruneBatch - Rows pruned in one pass. Range 1..5000. Default: 100.
# EVEJS_LNE_HEAVY_EVENTS_PRUNE_BATCH=

# heavyEvents.announceRadiusJumps - Gate jumps of the new event mail (online players). Range 0..15. Default: 5.
# EVEJS_LNE_HEAVY_EVENTS_ANNOUNCE_RADIUS_JUMPS=

# heavyEvents.announceMaxRecipients - Recipients of one new event mail (0 = no mail). Range 0..500. Default: 50.
# EVEJS_LNE_HEAVY_EVENTS_ANNOUNCE_MAX_RECIPIENTS=

# heavyEvents.panelMaxEnded - Ended events in the observer panel heavy-events. Range 0..50. Default: 20.
# EVEJS_LNE_HEAVY_EVENTS_PANEL_MAX_ENDED=

# LP / standing / ISK of the defenders of a picket (CLEARED defense) and the payout pump.
# heavyEvents.minParticipantPasses - ENGAGED passes a character must be seen on the grid to be paid (present at the success: always). Range 1..100. Default: 3.
# EVEJS_LNE_HEAVY_EVENTS_MIN_PARTICIPANT_PASSES=
# heavyEvents.maxParticipants - Characters paid for one defended picket. Range 1..200. Default: 20.
# EVEJS_LNE_HEAVY_EVENTS_MAX_PARTICIPANTS=
# heavyEvents.defenseLpPerParticipant - LP of the defender corporation per participant (0 = no LP leg). Range 0..100000. Default: 1500.
# EVEJS_LNE_HEAVY_EVENTS_DEFENSE_LP_PER_PARTICIPANT=
# heavyEvents.defenseStandingMicro - Raw standing plus at the defender faction per participant, in millionths (50000 = 0.05). Range 0..100000. Default: 50000.
# EVEJS_LNE_HEAVY_EVENTS_DEFENSE_STANDING_MICRO=
# heavyEvents.defenseIskPerParticipant - ISK per participant (0 = no ISK leg). Range 0..1000000000. Default: 0.
# EVEJS_LNE_HEAVY_EVENTS_DEFENSE_ISK_PER_PARTICIPANT=
# heavyEvents.payoutEnabled - Wallet and standing legs of the pump (under heavyEvents.enabled); off = rows wait PENDING. true/false. Default: true.
# EVEJS_LNE_HEAVY_EVENTS_PAYOUT_ENABLED=
# heavyEvents.payoutMaxPerPass - Payout rows of one pass. Range 1..200. Default: 10.
# EVEJS_LNE_HEAVY_EVENTS_PAYOUT_MAX_PER_PASS=
# heavyEvents.payoutMaxAttempts - Transient failures before the PENDING legs fail. Range 1..50. Default: 8.
# EVEJS_LNE_HEAVY_EVENTS_PAYOUT_MAX_ATTEMPTS=
# heavyEvents.payoutRetryBaseMs - First backoff of a transient failure (doubles per attempt). Range 1000..3600000. Default: 60000.
# EVEJS_LNE_HEAVY_EVENTS_PAYOUT_RETRY_BASE_MS=
# heavyEvents.payoutRetryMaxMs - Cap of the backoff. Range 60000..86400000. Default: 3600000.
# EVEJS_LNE_HEAVY_EVENTS_PAYOUT_RETRY_MAX_MS=
# heavyEvents.payoutRetentionMs - Age (updated_at) of the closed payout rows pruned. Range 86400000..31536000000. Default: 2592000000.
# EVEJS_LNE_HEAVY_EVENTS_PAYOUT_RETENTION_MS=

# Power sites (Lookout Nest, Buried Stash, Courier Trail, Marked
# Commander, Supply Drop, Muster Grounds), the second plan layer on the heavy events engine. Needs modules.world and
# modules.sites. Internal: not in the launcher. = pure core and config only (service).
# powerSites.enabled - Feature flag (needs modules.world and modules.sites), off = no power sites, no rows. true/false. Default: false.
# EVEJS_LNE_POWER_SITES_ENABLED=

# powerSites.outpostWeight - Draw weight of the type outpost (0 = off). Range 0..100. Default: 4.
# EVEJS_LNE_POWER_SITES_OUTPOST_WEIGHT=

# powerSites.cacheWeight - Draw weight of the type cache (0 = off). Range 0..100. Default: 3.
# EVEJS_LNE_POWER_SITES_CACHE_WEIGHT=

# powerSites.trailWeight - Draw weight of the type trail (0 = off). Range 0..100. Default: 2.
# EVEJS_LNE_POWER_SITES_TRAIL_WEIGHT=

# powerSites.huntWeight - Draw weight of the type hunt (0 = off). Range 0..100. Default: 2.
# EVEJS_LNE_POWER_SITES_HUNT_WEIGHT=

# powerSites.convoyWeight - Draw weight of the type convoy (0 = off). Range 0..100. Default: 2.
# EVEJS_LNE_POWER_SITES_CONVOY_WEIGHT=

# powerSites.musterWeight - Draw weight of the type muster (0 = off). Range 0..100. Default: 1.
# EVEJS_LNE_POWER_SITES_MUSTER_WEIGHT=

# powerSites.tierWeights - Draw weights of the tiers I,II (two integers >= 0, sum > 0). Default: 70,30.
# EVEJS_LNE_POWER_SITES_TIER_WEIGHTS=

# powerSites.affixWeights - Draw weights of the affixes none,reinforced,rich,fleeting (four integers >= 0, sum > 0). Default: 50,20,15,15.
# EVEJS_LNE_POWER_SITES_AFFIX_WEIGHTS=

# powerSites.securityBands - Security bands of the candidate systems. Default: lowsec,nullsec.
# EVEJS_LNE_POWER_SITES_SECURITY_BANDS=

# powerSites.factionKinds - Kinds of the controller faction. Default: pirate,invader,hive.
# EVEJS_LNE_POWER_SITES_FACTION_KINDS=

# powerSites.fundFromStock - the full composition is taken from the hull stock of an ONLINE station of the faction (any system). true/false. Default: true.
# EVEJS_LNE_POWER_SITES_FUND_FROM_STOCK=

# powerSites.planIntervalMs - period of the plan pass. Range 300000..86400000. Default: 1800000.
# EVEJS_LNE_POWER_SITES_PLAN_INTERVAL_MS=

# powerSites.maxPlansPerPass - New power sites of one plan pass. Range 1..4. Default: 2.
# EVEJS_LNE_POWER_SITES_MAX_PLANS_PER_PASS=

# powerSites.presenceRadiusJumps - jumps from an online player to a candidate system (no station needed in the system). Range 0..15. Default: 8.
# EVEJS_LNE_POWER_SITES_PRESENCE_RADIUS_JUMPS=

# powerSites.maxCandidateSystems - Candidate systems read by one plan pass. Range 1..512. Default: 128.
# EVEJS_LNE_POWER_SITES_MAX_CANDIDATE_SYSTEMS=

# powerSites.maxOpen - open power sites (PLANNED / ENGAGED / CLEARED). Range 0..32. Default: 6.
# EVEJS_LNE_POWER_SITES_MAX_OPEN=

# powerSites.maxOpenPerFaction - open power sites of one faction. Range 1..8. Default: 2.
# EVEJS_LNE_POWER_SITES_MAX_OPEN_PER_FACTION=

# powerSites.maxOpenPerType - Open power sites of one type. Range 1..16. Default: 2.
# EVEJS_LNE_POWER_SITES_MAX_OPEN_PER_TYPE=

# powerSites.systemCooldownMs - pause of a system after the end of its power site. Range 0..604800000. Default: 21600000.
# EVEJS_LNE_POWER_SITES_SYSTEM_COOLDOWN_MS=

# powerSites.plannedTtlMinMs - Shortest drawn life of a PLANNED power site (before the type and affix factors). Range 600000..86400000. Default: 7200000.
# EVEJS_LNE_POWER_SITES_PLANNED_TTL_MIN_MS=

# powerSites.plannedTtlMaxMs - Longest drawn life of a PLANNED power site (before the type and affix factors). Range 600000..86400000. Default: 21600000.
# EVEJS_LNE_POWER_SITES_PLANNED_TTL_MAX_MS=

# powerSites.pocketTtlMs - Life of a revealed trail pocket. Range 600000..14400000. Default: 3600000.
# EVEJS_LNE_POWER_SITES_POCKET_TTL_MS=

# powerSites.trailPockets - Pockets of a trail (<= sites.maxSlotsPerEvent). Range 2..4. Default: 3.
# EVEJS_LNE_POWER_SITES_TRAIL_POCKETS=

# powerSites.escapeAfterMs - A living commander / hauler leaves this long after its spawn. Range 30000..1800000. Default: 240000.
# EVEJS_LNE_POWER_SITES_ESCAPE_AFTER_MS=

# powerSites.musterWaves - Waves of a muster of tier I (tier II: + 1). Range 1..6. Default: 3.
# EVEJS_LNE_POWER_SITES_MUSTER_WAVES=

# powerSites.musterWaveIntervalMs - The next muster wave comes after this at the latest. Range 60000..1800000. Default: 300000.
# EVEJS_LNE_POWER_SITES_MUSTER_WAVE_INTERVAL_MS=

# powerSites.musterWaveGrowthPermille - Growth of each muster wave over the first. Range 0..1000. Default: 300.
# EVEJS_LNE_POWER_SITES_MUSTER_WAVE_GROWTH_PERMILLE=

# powerSites.maxShipsPerEvent - Members of one power site (<= heavyEvents.maxLiveShips). Range 1..30. Default: 16.
# EVEJS_LNE_POWER_SITES_MAX_SHIPS_PER_EVENT=

# powerSites.minFreeSiteSlots - Free sites.maxActiveSites slots kept for the Director and the heavy events. Range 0..64. Default: 8.
# EVEJS_LNE_POWER_SITES_MIN_FREE_SITE_SLOTS=

# powerSites.minMineralUnits - Minerals of a faction station needed by a cache or a convoy. Range 0..1000000000. Default: 20000.
# EVEJS_LNE_POWER_SITES_MIN_MINERAL_UNITS=

# powerSites.cacheDrainPermille - Share of the station minerals drained when a cache is cleared. Range 0..1000. Default: 50.
# EVEJS_LNE_POWER_SITES_CACHE_DRAIN_PERMILLE=

# powerSites.convoyDrainPermillePerHauler - Share of the station minerals drained per destroyed convoy hauler. Range 0..1000. Default: 30.
# EVEJS_LNE_POWER_SITES_CONVOY_DRAIN_PERMILLE_PER_HAULER=

# powerSites.drainMaxUnits - Cap of the drain of one site. Range 0..1000000000. Default: 100000.
# EVEJS_LNE_POWER_SITES_DRAIN_MAX_UNITS=

# powerSites.lootSharePermille - Share of the drain put into the chest. Range 0..1000. Default: 100.
# EVEJS_LNE_POWER_SITES_LOOT_SHARE_PERMILLE=

# powerSites.lootMaxUnitsPerType - Cap of one mineral type in the chest. Range 0..1000000. Default: 10000.
# EVEJS_LNE_POWER_SITES_LOOT_MAX_UNITS_PER_TYPE=

# powerSites.outpostInfluencePoints - Influence lost by the faction when its outpost is cleared. Range 0..100. Default: 8.
# EVEJS_LNE_POWER_SITES_OUTPOST_INFLUENCE_POINTS=

# powerSites.cacheInfluencePoints - Influence lost by the faction when its cache is cleared. Range 0..100. Default: 10.
# EVEJS_LNE_POWER_SITES_CACHE_INFLUENCE_POINTS=

# powerSites.trailInfluencePoints - Influence lost by the faction when its trail is cleared. Range 0..100. Default: 15.
# EVEJS_LNE_POWER_SITES_TRAIL_INFLUENCE_POINTS=

# powerSites.huntInfluencePoints - Influence lost by the faction when its commander is killed. Range 0..100. Default: 20.
# EVEJS_LNE_POWER_SITES_HUNT_INFLUENCE_POINTS=

# powerSites.convoyInfluencePoints - Influence lost by the faction when its convoy is hit. Range 0..100. Default: 10.
# EVEJS_LNE_POWER_SITES_CONVOY_INFLUENCE_POINTS=

# powerSites.musterInfluencePoints - Influence lost by the faction when its muster is cleared. Range 0..100. Default: 15.
# EVEJS_LNE_POWER_SITES_MUSTER_INFLUENCE_POINTS=

# powerSites.outpostRolls - Loot rolls of the outpost chest per tier I,II. Default: 1,2.
# EVEJS_LNE_POWER_SITES_OUTPOST_ROLLS=

# powerSites.cacheRolls - Loot rolls of the cache chest per tier I,II. Default: 2,3.
# EVEJS_LNE_POWER_SITES_CACHE_ROLLS=

# powerSites.trailRolls - Loot rolls per trail pocket per tier I,II. Default: 1,2.
# EVEJS_LNE_POWER_SITES_TRAIL_ROLLS=

# powerSites.huntRolls - Loot rolls of the hunt chest per tier I,II. Default: 2,4.
# EVEJS_LNE_POWER_SITES_HUNT_ROLLS=

# powerSites.convoyRolls - Loot rolls per destroyed convoy hauler per tier I,II. Default: 1,1.
# EVEJS_LNE_POWER_SITES_CONVOY_ROLLS=

# powerSites.musterRolls - Loot rolls per cleared muster wave per tier I,II. Default: 1,1.
# EVEJS_LNE_POWER_SITES_MUSTER_ROLLS=

# powerSites.affixRolls - Extra rolls of the affixes reinforced and fleeting. Range 0..3. Default: 1.
# EVEJS_LNE_POWER_SITES_AFFIX_ROLLS=

# powerSites.richRolls - Extra rolls of the affix rich. Range 0..5. Default: 2.
# EVEJS_LNE_POWER_SITES_RICH_ROLLS=

# powerSites.maxLootRolls - Cap of the rolls of one power chest. Range 1..10. Default: 8.
# EVEJS_LNE_POWER_SITES_MAX_LOOT_ROLLS=

# powerSites.rareDeadspacePermille - Deadspace weight factor of the hunt chest and of the affix rich. Range 1000..5000. Default: 2000.
# EVEJS_LNE_POWER_SITES_RARE_DEADSPACE_PERMILLE=

# powerSites.fleetingTtlPermille - TTL factor of the affix fleeting. Range 100..1000. Default: 500.
# EVEJS_LNE_POWER_SITES_FLEETING_TTL_PERMILLE=

# powerSites.cacheTtlPermille - TTL factor of the type cache (it must be found with probes). Range 500..3000. Default: 1500.
# EVEJS_LNE_POWER_SITES_CACHE_TTL_PERMILLE=

# powerSites.rewardMaxPerDay - Power chests per day, server wide (hpwrwd keys, apart from the heavy events). Range 0..200. Default: 16.
# EVEJS_LNE_POWER_SITES_REWARD_MAX_PER_DAY=

# powerSites.rewardMaxPerSystemPerDay - Power chests per day in one system. Range 0..10. Default: 2.
# EVEJS_LNE_POWER_SITES_REWARD_MAX_PER_SYSTEM_PER_DAY=

# powerSites.reinforcedSteps - Scale steps of the affix reinforced from the first engage (capped by heavyEvents.maxUpscaleSteps). Range 0..6. Default: 1.
# EVEJS_LNE_POWER_SITES_REINFORCED_STEPS=

# Event anomalies (Regroup Camp after VIRTUAL losses, Hidden Command Post in a
# system held by a pirate), the third plan layer (world) on the heavy events engine. Needs modules.world and
# modules.sites. Internal: not in the launcher. Every kind weight 0 by default. Values = config.js SCHEMA.
# eventAnomalies.enabled - Feature flag (needs modules.world and modules.sites), off = no event anomalies, open ones are cancelled. true/false. Default: false.
# EVEJS_LNE_EVENT_ANOMALIES_ENABLED=

# eventAnomalies.planIntervalMs - Plan bucket of the world layer (one pass per bucket). Range 300000..86400000. Default: 1800000.
# EVEJS_LNE_EVENT_ANOMALIES_PLAN_INTERVAL_MS=

# eventAnomalies.maxPlansPerPass - New event anomalies of one plan pass. Range 1..4. Default: 1.
# EVEJS_LNE_EVENT_ANOMALIES_MAX_PLANS_PER_PASS=

# eventAnomalies.presenceRadiusJumps - Candidate systems within this many jumps of a player. Range 0..15. Default: 5.
# EVEJS_LNE_EVENT_ANOMALIES_PRESENCE_RADIUS_JUMPS=

# eventAnomalies.maxCandidateSystems - Candidate systems read by one plan pass. Range 1..256. Default: 32.
# EVEJS_LNE_EVENT_ANOMALIES_MAX_CANDIDATE_SYSTEMS=

# eventAnomalies.securityBands - Security bands of the candidate systems. Default: lowsec,nullsec.
# EVEJS_LNE_EVENT_ANOMALIES_SECURITY_BANDS=

# eventAnomalies.factionKinds - Kinds of the faction of a warcamp (the faction that lost the ships). Default: pirate,empire.
# EVEJS_LNE_EVENT_ANOMALIES_FACTION_KINDS=

# eventAnomalies.maxOpen - Open event anomalies (PLANNED / ENGAGED / CLEARED). Range 0..32. Default: 3.
# EVEJS_LNE_EVENT_ANOMALIES_MAX_OPEN=

# eventAnomalies.maxOpenPerFaction - Open event anomalies of one faction. Range 0..8. Default: 1.
# EVEJS_LNE_EVENT_ANOMALIES_MAX_OPEN_PER_FACTION=

# eventAnomalies.maxOpenPerKind - Open event anomalies of one kind. Range 0..8. Default: 1.
# EVEJS_LNE_EVENT_ANOMALIES_MAX_OPEN_PER_KIND=

# eventAnomalies.systemCooldownMs - No new event anomaly in a system this long after the end of the last one. Range 0..604800000. Default: 21600000.
# EVEJS_LNE_EVENT_ANOMALIES_SYSTEM_COOLDOWN_MS=

# eventAnomalies.plannedTtlMinMs - Shortest life of a PLANNED event anomaly without a player. Range 600000..86400000. Default: 7200000.
# EVEJS_LNE_EVENT_ANOMALIES_PLANNED_TTL_MIN_MS=

# eventAnomalies.plannedTtlMaxMs - Longest life of a PLANNED event anomaly without a player. Range 600000..86400000. Default: 14400000.
# EVEJS_LNE_EVENT_ANOMALIES_PLANNED_TTL_MAX_MS=

# eventAnomalies.minFreeSiteSlots - Free ctx.sites slots (sites.maxActiveSites - live) a plan keeps for the other sites. Range 0..4000. Default: 8.
# EVEJS_LNE_EVENT_ANOMALIES_MIN_FREE_SITE_SLOTS=

# eventAnomalies.maxShipsPerEvent - Live ships of one event anomaly at once (largest wave + full scaling), <= heavyEvents.maxLiveShips. Range 1..60. Default: 24.
# EVEJS_LNE_EVENT_ANOMALIES_MAX_SHIPS_PER_EVENT=

# eventAnomalies.fundFromStock - the full composition is taken from the hull stock of an ONLINE station of the faction (any system). true/false. Default: true.
# EVEJS_LNE_EVENT_ANOMALIES_FUND_FROM_STOCK=

# eventAnomalies.escapeAfterMs - The hideout commander escapes this long after his phase spawned. Range 30000..3600000. Default: 300000.
# EVEJS_LNE_EVENT_ANOMALIES_ESCAPE_AFTER_MS=

# eventAnomalies.musterWaves - Waves of a warcamp of tier I (+ 1 per tier above I). Range 1..8. Default: 3.
# EVEJS_LNE_EVENT_ANOMALIES_MUSTER_WAVES=

# eventAnomalies.musterWaveIntervalMs - Time between two warcamp waves. Range 60000..3600000. Default: 300000.
# EVEJS_LNE_EVENT_ANOMALIES_MUSTER_WAVE_INTERVAL_MS=

# eventAnomalies.musterWaveGrowthPermille - Growth of each next warcamp wave (permille of the base wave). Range 0..1000. Default: 250.
# EVEJS_LNE_EVENT_ANOMALIES_MUSTER_WAVE_GROWTH_PERMILLE=

# eventAnomalies.trailPockets - Pockets of a trail kind (<= sites.maxSlotsPerEvent). Range 2..8. Default: 3.
# EVEJS_LNE_EVENT_ANOMALIES_TRAIL_POCKETS=

# eventAnomalies.pocketTtlMs - TTL of a pocket beacon of a trail kind. Range 600000..14400000. Default: 3600000.
# EVEJS_LNE_EVENT_ANOMALIES_POCKET_TTL_MS=

# eventAnomalies.rewardMaxPerDay - Event anomaly chests per day, server wide (hwarwd keys, apart from heavy and power). Range 0..200. Default: 12.
# EVEJS_LNE_EVENT_ANOMALIES_REWARD_MAX_PER_DAY=

# eventAnomalies.rewardMaxPerSystemPerDay - Event anomaly chests per day in one system. Range 0..10. Default: 2.
# EVEJS_LNE_EVENT_ANOMALIES_REWARD_MAX_PER_SYSTEM_PER_DAY=

# eventAnomalies.rewardMaxAttempts - Refused places of a chest before it is skipped. Range 1..100. Default: 3.
# EVEJS_LNE_EVENT_ANOMALIES_REWARD_MAX_ATTEMPTS=

# eventAnomalies.maxLootRolls - Cap of the rolls of one chest. Range 1..10. Default: 10.
# EVEJS_LNE_EVENT_ANOMALIES_MAX_LOOT_ROLLS=

# eventAnomalies.maxLossRows - VIRTUAL loss rows read by one plan pass (warcamp trigger). Range 1..20000. Default: 256.
# EVEJS_LNE_EVENT_ANOMALIES_MAX_LOSS_ROWS=

# eventAnomalies.warcampWeight - Draw weight of the kind warcamp (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_WARCAMP_WEIGHT=

# eventAnomalies.warcampWindowMs - VIRTUAL losses settled within this window count for a warcamp. Range 600000..86400000. Default: 10800000.
# EVEJS_LNE_EVENT_ANOMALIES_WARCAMP_WINDOW_MS=

# eventAnomalies.warcampMinLosses - Lost ships of one faction in one system that trigger a warcamp. Range 1..100000. Default: 5.
# EVEJS_LNE_EVENT_ANOMALIES_WARCAMP_MIN_LOSSES=

# eventAnomalies.warcampTierLosses - Lost ships for the warcamp tiers I,II,III. Default: 5,15,40.
# EVEJS_LNE_EVENT_ANOMALIES_WARCAMP_TIER_LOSSES=

# eventAnomalies.warcampRolls - Loot rolls of the warcamp chest per tier I,II,III (x waves cleared). Default: 3,5,8.
# EVEJS_LNE_EVENT_ANOMALIES_WARCAMP_ROLLS=

# eventAnomalies.warcampInfluencePoints - Influence the faction of a cleared warcamp loses in the system. Range 0..1000. Default: 30.
# EVEJS_LNE_EVENT_ANOMALIES_WARCAMP_INFLUENCE_POINTS=

# eventAnomalies.hideoutWeight - Draw weight of the kind hideout (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_HIDEOUT_WEIGHT=

# eventAnomalies.hideoutFactionKinds - Kinds of the occupier of a hideout system. Default: pirate.
# EVEJS_LNE_EVENT_ANOMALIES_HIDEOUT_FACTION_KINDS=

# eventAnomalies.hideoutTierWeights - Draw weights of the hideout tiers I,II,III. Default: 50,35,15.
# EVEJS_LNE_EVENT_ANOMALIES_HIDEOUT_TIER_WEIGHTS=

# eventAnomalies.hideoutRolls - Loot rolls of the hideout chest per tier I,II,III. Default: 4,6,9.
# EVEJS_LNE_EVENT_ANOMALIES_HIDEOUT_ROLLS=

# eventAnomalies.hideoutInfluencePoints - Influence the occupier of a cleared hideout loses in the system. Range 0..1000. Default: 40.
# EVEJS_LNE_EVENT_ANOMALIES_HIDEOUT_INFLUENCE_POINTS=

# eventAnomalies.stagingWeight - Draw weight of the kind staging (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_STAGING_WEIGHT=

# eventAnomalies.stagingFactions - Invader factions whose ACTIVE beachhead triggers a staging. Default: 500026,500024.
# EVEJS_LNE_EVENT_ANOMALIES_STAGING_FACTIONS=

# eventAnomalies.stagingTierWeights - Draw weights of the staging tiers I,II,III. Default: 0,60,40.
# EVEJS_LNE_EVENT_ANOMALIES_STAGING_TIER_WEIGHTS=

# eventAnomalies.stagingRolls - Loot rolls of the staging chest per tier I,II,III (x waves cleared). Default: 4,6,9.
# EVEJS_LNE_EVENT_ANOMALIES_STAGING_ROLLS=

# eventAnomalies.stagingInfluencePoints - Influence the invader of a cleared staging loses in the beachhead system. Range 0..1000. Default: 40.
# EVEJS_LNE_EVENT_ANOMALIES_STAGING_INFLUENCE_POINTS=

# eventAnomalies.stagingBeneficiaryKinds - Kinds of the defender faction that pays LP / standing for a staging. Default: empire,pirate.
# EVEJS_LNE_EVENT_ANOMALIES_STAGING_BENEFICIARY_KINDS=

# eventAnomalies.stagingLpPerTier - LP of the defender per participant of a cleared staging, tiers I,II,III. Default: 1000,2000,4000.
# EVEJS_LNE_EVENT_ANOMALIES_STAGING_LP_PER_TIER=

# eventAnomalies.stagingStandingMicro - Standing to the defender per participant of a cleared staging, micro units. Range 0..100000. Default: 50000.
# EVEJS_LNE_EVENT_ANOMALIES_STAGING_STANDING_MICRO=

# eventAnomalies.desertersWeight - Draw weight of the kind deserters (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_DESERTERS_WEIGHT=

# eventAnomalies.desertersFactionKinds - Kinds of the system controller whose unpaid treasury days trigger deserters. Default: empire,pirate.
# EVEJS_LNE_EVENT_ANOMALIES_DESERTERS_FACTION_KINDS=

# eventAnomalies.desertersWindowDays - Treasury days read for the deserters trigger. Range 1..32. Default: 7.
# EVEJS_LNE_EVENT_ANOMALIES_DESERTERS_WINDOW_DAYS=

# eventAnomalies.desertersMinUnpaidDays - Days with unpaid > 0 in the window that trigger deserters. Range 1..32. Default: 3.
# EVEJS_LNE_EVENT_ANOMALIES_DESERTERS_MIN_UNPAID_DAYS=

# eventAnomalies.desertersTierWeights - Draw weights of the deserters tiers I,II,III. Default: 70,30,0.
# EVEJS_LNE_EVENT_ANOMALIES_DESERTERS_TIER_WEIGHTS=

# eventAnomalies.desertersRolls - Loot rolls of the deserters chest per tier I,II,III. Default: 2,4,6.
# EVEJS_LNE_EVENT_ANOMALIES_DESERTERS_ROLLS=

# eventAnomalies.desertersInfluencePoints - Influence the faction of a cleared deserters loses in the system. Range 0..1000. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_DESERTERS_INFLUENCE_POINTS=

# eventAnomalies.smugglingWeight - Draw weight of the kind smuggling (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_SMUGGLING_WEIGHT=

# eventAnomalies.smugglingVictimKinds - Kinds of the station owner whose low mineral stock triggers smuggling. Default: empire.
# EVEJS_LNE_EVENT_ANOMALIES_SMUGGLING_VICTIM_KINDS=

# eventAnomalies.smugglingFactionKinds - Kinds of the gate neighbour controller that runs the smuggling. Default: pirate.
# EVEJS_LNE_EVENT_ANOMALIES_SMUGGLING_FACTION_KINDS=

# eventAnomalies.smugglingMaxMineralUnits - A victim station below these mineral units triggers smuggling. Range 0..1000000000. Default: 20000.
# EVEJS_LNE_EVENT_ANOMALIES_SMUGGLING_MAX_MINERAL_UNITS=

# eventAnomalies.smugglingMaxNeighborReads - Gate neighbour systems read per plan pass for smuggling. Range 1..256. Default: 32.
# EVEJS_LNE_EVENT_ANOMALIES_SMUGGLING_MAX_NEIGHBOR_READS=

# eventAnomalies.smugglingTierWeights - Draw weights of the smuggling tiers I,II,III. Default: 70,30,0.
# EVEJS_LNE_EVENT_ANOMALIES_SMUGGLING_TIER_WEIGHTS=

# eventAnomalies.smugglingRolls - Loot rolls of the smuggling chest per tier I,II,III. Default: 2,3,5.
# EVEJS_LNE_EVENT_ANOMALIES_SMUGGLING_ROLLS=

# eventAnomalies.smugglingInfluencePoints - Influence the pirate of a cleared smuggling loses in the system. Range 0..1000. Default: 10.
# EVEJS_LNE_EVENT_ANOMALIES_SMUGGLING_INFLUENCE_POINTS=

# eventAnomalies.frontdepotWeight - Draw weight of the kind frontdepot (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_FRONTDEPOT_WEIGHT=

# eventAnomalies.frontdepotFactionKinds - Kinds of the attacker whose open front operation triggers frontdepot. Default: empire,pirate.
# EVEJS_LNE_EVENT_ANOMALIES_FRONTDEPOT_FACTION_KINDS=

# eventAnomalies.frontdepotOperationTypes - Operation types of an open front that trigger frontdepot. Default: invasion,raid.
# EVEJS_LNE_EVENT_ANOMALIES_FRONTDEPOT_OPERATION_TYPES=

# eventAnomalies.frontdepotMaxOpsPerSystem - Open operations read per candidate system for frontdepot. Range 1..32. Default: 4.
# EVEJS_LNE_EVENT_ANOMALIES_FRONTDEPOT_MAX_OPS_PER_SYSTEM=

# eventAnomalies.frontdepotTierWeights - Draw weights of the frontdepot tiers I,II,III. Default: 50,35,15.
# EVEJS_LNE_EVENT_ANOMALIES_FRONTDEPOT_TIER_WEIGHTS=

# eventAnomalies.frontdepotRolls - Loot rolls of the frontdepot chest per tier I,II,III. Default: 3,5,7.
# EVEJS_LNE_EVENT_ANOMALIES_FRONTDEPOT_ROLLS=

# eventAnomalies.frontdepotInfluencePoints - Influence the attacker of a cleared frontdepot loses in the front system. Range 0..1000. Default: 20.
# EVEJS_LNE_EVENT_ANOMALIES_FRONTDEPOT_INFLUENCE_POINTS=

# eventAnomalies.wreckedconvoyWeight - Draw weight of the kind wreckedconvoy (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_WRECKEDCONVOY_WEIGHT=

# eventAnomalies.wreckedconvoyFactionKinds - Kinds of the faction whose LOST convoy triggers wreckedconvoy. Default: empire,pirate.
# EVEJS_LNE_EVENT_ANOMALIES_WRECKEDCONVOY_FACTION_KINDS=

# eventAnomalies.wreckedconvoyWindowMs - Convoys LOST within this window trigger wreckedconvoy. Range 600000..86400000. Default: 10800000.
# EVEJS_LNE_EVENT_ANOMALIES_WRECKEDCONVOY_WINDOW_MS=

# eventAnomalies.wreckedconvoyMaxRows - LOST convoys read per plan pass for wreckedconvoy. Range 1..1024. Default: 64.
# EVEJS_LNE_EVENT_ANOMALIES_WRECKEDCONVOY_MAX_ROWS=

# eventAnomalies.wreckedconvoyMinLostUnits - Lost cargo units of one faction in one system that trigger wreckedconvoy. Range 1..1000000000. Default: 1.
# EVEJS_LNE_EVENT_ANOMALIES_WRECKEDCONVOY_MIN_LOST_UNITS=

# eventAnomalies.wreckedconvoyTierWeights - Draw weights of the wreckedconvoy tiers I,II,III. Default: 70,30,0.
# EVEJS_LNE_EVENT_ANOMALIES_WRECKEDCONVOY_TIER_WEIGHTS=

# eventAnomalies.wreckedconvoyRolls - Loot rolls of the wreckedconvoy chest per tier I,II,III. Default: 2,3,5.
# EVEJS_LNE_EVENT_ANOMALIES_WRECKEDCONVOY_ROLLS=

# eventAnomalies.wreckedconvoyInfluencePoints - Influence the faction of a cleared wreckedconvoy loses in the system. Range 0..1000. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_WRECKEDCONVOY_INFLUENCE_POINTS=

# eventAnomalies.flagwreckWeight - Draw weight of the kind flagwreck (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_FLAGWRECK_WEIGHT=

# eventAnomalies.flagwreckFactionKinds - Kinds of the faction whose lost capital triggers flagwreck. Default: empire,pirate.
# EVEJS_LNE_EVENT_ANOMALIES_FLAGWRECK_FACTION_KINDS=

# eventAnomalies.flagwreckWindowMs - Capitals lost in VIRTUAL battles settled within this window trigger flagwreck. Range 600000..86400000. Default: 21600000.
# EVEJS_LNE_EVENT_ANOMALIES_FLAGWRECK_WINDOW_MS=

# eventAnomalies.flagwreckMinCapitals - Lost capitals of one faction in one system that trigger flagwreck. Range 1..100. Default: 1.
# EVEJS_LNE_EVENT_ANOMALIES_FLAGWRECK_MIN_CAPITALS=

# eventAnomalies.flagwreckSalvageMaxRows - Salvage fields read per plan pass for flagwreck (a field in the system = BUSY; truncated = refused). Range 1..256. Default: 64.
# EVEJS_LNE_EVENT_ANOMALIES_FLAGWRECK_SALVAGE_MAX_ROWS=

# eventAnomalies.flagwreckRolls - Loot rolls of the flagwreck chest per tier I,II,III. Default: 4,6,9.
# EVEJS_LNE_EVENT_ANOMALIES_FLAGWRECK_ROLLS=

# eventAnomalies.flagwreckInfluencePoints - Influence the faction of the lost capital loses when its flagwreck is cleared. Range 0..1000. Default: 40.
# EVEJS_LNE_EVENT_ANOMALIES_FLAGWRECK_INFLUENCE_POINTS=

# eventAnomalies.breachWeight - Draw weight of the kind breach (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_BREACH_WEIGHT=

# eventAnomalies.breachFactionId - Faction of the breach fleets (default Triglavian Collective). Range 1..2147483647. Default: 500026.
# EVEJS_LNE_EVENT_ANOMALIES_BREACH_FACTION_ID=

# eventAnomalies.breachMinPressureMilli - Triglavian attention of the region (abyssal pressure, milli) that triggers breach. Range 1..10000000. Default: 5000.
# EVEJS_LNE_EVENT_ANOMALIES_BREACH_MIN_PRESSURE_MILLI=

# eventAnomalies.breachTierWeights - Draw weights of the breach tiers I,II,III. Default: 0,60,40.
# EVEJS_LNE_EVENT_ANOMALIES_BREACH_TIER_WEIGHTS=

# eventAnomalies.breachRolls - Loot rolls of the breach chest per tier I,II,III, times the pockets cleared. Default: 1,2,3.
# EVEJS_LNE_EVENT_ANOMALIES_BREACH_ROLLS=

# eventAnomalies.breachInfluencePoints - Influence the breach faction loses when its breach is cleared. Range 0..1000. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_BREACH_INFLUENCE_POINTS=

# eventAnomalies.directorKindsEnabled - Director kinds ded_complex / battle_relics in the Event Director catalog, off = catalog v2 unchanged. true/false. Default: false.
# EVEJS_LNE_EVENT_ANOMALIES_DIRECTOR_KINDS_ENABLED=

# eventAnomalies.dedComplexWeight - Director weight of the kind ded_complex (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_DED_COMPLEX_WEIGHT=

# eventAnomalies.battleRelicsWeight - Director weight of the kind battle_relics (0 = off). Range 0..100. Default: 0.
# EVEJS_LNE_EVENT_ANOMALIES_BATTLE_RELICS_WEIGHT=

# eventAnomalies.battleRelicsWindowMs - Settled VIRTUAL losses within this window count for battle_relics; max = the battle_relics cooldown. Range 600000..21600000. Default: 10800000.
# EVEJS_LNE_EVENT_ANOMALIES_BATTLE_RELICS_WINDOW_MS=

# eventAnomalies.battleRelicsMinLosses - Lost ships of one faction in one system that give a battle_relics cause. Range 1..100000. Default: 3.
# EVEJS_LNE_EVENT_ANOMALIES_BATTLE_RELICS_MIN_LOSSES=

# eventAnomalies.battleRelicsMaxSystems - Systems with losses only added to the Director candidates per pulse. Range 1..64. Default: 16.
# EVEJS_LNE_EVENT_ANOMALIES_BATTLE_RELICS_MAX_SYSTEMS=

# The Event Director type rich_vein_liberated, an
# ore anomaly without NPC in a nullsec system its controller abandoned. Needs modules.events + modules.sites. Internal.
# richVeins.enabled - The rich vein type in the Event Director catalog (needs modules.events + modules.sites); off = unchanged. true/false. Default: false.
# EVEJS_LNE_RICH_VEINS_ENABLED=

# richVeins.liberatedWeight - Director weight of rich_vein_liberated (0 = the type is left out). Range 0..100. Default: 3.
# EVEJS_LNE_RICH_VEINS_LIBERATED_WEIGHT=

# richVeins.durationMs - Life of a rich vein (36 h). Range 600000..172800000. Default: 129600000.
# EVEJS_LNE_RICH_VEINS_DURATION_MS=

# richVeins.cooldownMs - Cooldown of the vein type in one system (effective >= liberatedWindowMs). Range 0..604800000. Default: 172800000.
# EVEJS_LNE_RICH_VEINS_COOLDOWN_MS=

# richVeins.aftermathMs - Time after the last rock is mined before the vein ends (capped at durationMs). Range 0..3600000. Default: 600000.
# EVEJS_LNE_RICH_VEINS_AFTERMATH_MS=

# richVeins.liberatedWindowMs - An abandon younger than this gives the LIBERATED cause. Range 600000..86400000. Default: 21600000.
# EVEJS_LNE_RICH_VEINS_LIBERATED_WINDOW_MS=

# richVeins.maxOpen - Open rich veins in the world (0 = no new vein). Range 0..16. Default: 2.
# EVEJS_LNE_RICH_VEINS_MAX_OPEN=

# richVeins.maxLiberatedRows - Row cap of the abandoned-systems read of one pulse. Range 1..1024. Default: 64.
# EVEJS_LNE_RICH_VEINS_MAX_LIBERATED_ROWS=

# The front vein and the moon ore templates.
# richVeins.frontWeight - Director weight of rich_vein_front, CONTESTED / INVASION with an occupier (0 = the type is left out). Range 0..100. Default: 0.
# EVEJS_LNE_RICH_VEINS_FRONT_WEIGHT=

# richVeins.moonTemplatesEnabled - Rich_vein_liberated also lists the R16/R32/R64 templates of the moonOreAnomalies mod (no mod = removed at start). true/false. Default: false.
# EVEJS_LNE_RICH_VEINS_MOON_TEMPLATES_ENABLED=

# The grids of a system (gates, stations, structures
# POS, sun, belts) and the visit of a fleet (world_fleet_grid_visits, entry gate). Needs modules.fleets. Internal:
# not in the launcher. Values = config.js SCHEMA.

# grid.enabled - Feature flag: visit rows at arrivals, grid positions, panel system-interior on the entry gate. Default: false.
# EVEJS_LNE_GRID_ENABLED=

# grid.contactRangeM - Radius of a grid cluster in meters. Range 10000..8000000. Default: 250000.
# EVEJS_LNE_GRID_CONTACT_RANGE_M=

# grid.maxAnchorsPerSystem - Anchors read per system (belts are cut first). Range 8..256. Default: 64.
# EVEJS_LNE_GRID_MAX_ANCHORS_PER_SYSTEM=

# grid.anchorCacheSystems - Systems in the anchor cache (LRU). Range 16..8192. Default: 512.
# EVEJS_LNE_GRID_ANCHOR_CACHE_SYSTEMS=

# grid.dynamicAnchorTtlMs - Age of a cached anchor read before a new read. Range 10000..3600000. Default: 300000.
# EVEJS_LNE_GRID_DYNAMIC_ANCHOR_TTL_MS=

# grid.visitPurgePerWrite - Invalid visits of the system deleted by one arrival. Range 0..64. Default: 4.
# EVEJS_LNE_GRID_VISIT_PURGE_PER_WRITE=

# grid.maxPositionsPerCall - Fleets of one positionsOf call. Range 16..1024. Default: 256.
# EVEJS_LNE_GRID_MAX_POSITIONS_PER_CALL=

# Moves of a fleet between the anchors of its system
# (work target after an arrival, FLEET_GRID_ARRIVAL). Needs grid.enabled. Internal: not in the launcher.

# grid.movesEnabled - Feature flag: in-system moves (work target after an arrival), FLEET_GRID_ARRIVAL. Default: false.
# EVEJS_LNE_GRID_MOVES_ENABLED=

# grid.maxMovesPerVisit - Moves of one visit outside POST/PURSUIT/RETURN. Range 1..64. Default: 4.
# EVEJS_LNE_GRID_MAX_MOVES_PER_VISIT=

# grid.workTargetScanFleets - Fleets of the system read for the gank / escort work target. Range 1..64. Default: 8.
# EVEJS_LNE_GRID_WORK_TARGET_SCAN_FLEETS=

# grid.moveArrivalMaxPerPass - maxPerPass of the FLEET_GRID_ARRIVAL handler. Range 1..1024. Default: 64.
# EVEJS_LNE_GRID_MOVE_ARRIVAL_MAX_PER_PASS=

# The active garrison - posts of the defenders at gates
# and stations, a two-phase alert (SEEN, LOCATE), a group pursuit inside the system, the return to the post. Needs
# modules.strategy, grid.movesEnabled and battle.gridContacts.enabled (enable them together). Internal: not in
# the launcher.

# grid.defense.enabled - Feature flag: listeners, alerts, pursuit; off = queued rows end STALE. Default: false.
# EVEJS_LNE_GRID_DEFENSE_ENABLED=

# grid.defense.roles - Comma list of fleet roles that defend (non-empty). Default: garrison.
# EVEJS_LNE_GRID_DEFENSE_ROLES=

# grid.defense.maxPosts - Posts of one faction in a system (CP first). Range 1..16. Default: 4.
# EVEJS_LNE_GRID_DEFENSE_MAX_POSTS=

# grid.defense.seenReactionMs - Delay of the SEEN alert after a hostile fleet appears. Range 0..600000. Default: 20000.
# EVEJS_LNE_GRID_DEFENSE_SEEN_REACTION_MS=

# grid.defense.locateMs - Delay of the LOCATE alert after the appearance (>= seenReactionMs). Range 0..3600000.
# Default: 90000.
# EVEJS_LNE_GRID_DEFENSE_LOCATE_MS=

# grid.defense.reactionJitterMs - Spread of the alert delays. Range 0..120000. Default: 10000.
# EVEJS_LNE_GRID_DEFENSE_REACTION_JITTER_MS=

# grid.defense.whLocateEnabled - The LOCATE phase also in wormhole systems. Range: true/false. Default: false.
# EVEJS_LNE_GRID_DEFENSE_WH_LOCATE_ENABLED=

# grid.defense.chaseNonCombat - Pursuit of logistics / mining / scout fleets. Range: true/false. Default: true.
# EVEJS_LNE_GRID_DEFENSE_CHASE_NON_COMBAT=

# grid.defense.strengthRatioPermille - Strength of the pursuers vs the intruder (x / 1000). Range 100..10000.
# Default: 1200.
# EVEJS_LNE_GRID_DEFENSE_STRENGTH_RATIO_PERMILLE=

# grid.defense.maxPursuersPerIntruder - Fleets of one pursuit group. Range 1..16. Default: 3.
# EVEJS_LNE_GRID_DEFENSE_MAX_PURSUERS_PER_INTRUDER=

# grid.defense.minHoldAtCp - Defenders that stay in the CP grid during a pursuit. Range 0..8. Default: 1.
# EVEJS_LNE_GRID_DEFENSE_MIN_HOLD_AT_CP=

# grid.defense.maxPursuitsPerSystem - Open pursuits of one faction in a system. Range 1..32. Default: 2.
# EVEJS_LNE_GRID_DEFENSE_MAX_PURSUITS_PER_SYSTEM=

# grid.defense.maxPursuitAttempts - Locate attempts of one pursuit before the return. Range 1..8. Default: 2.
# EVEJS_LNE_GRID_DEFENSE_MAX_PURSUIT_ATTEMPTS=

# grid.defense.returnAfterMs - Delay of the return step after a contact. Range 10000..86400000. Default: 600000.
# EVEJS_LNE_GRID_DEFENSE_RETURN_AFTER_MS=

# grid.defense.returnMaxRounds - Return steps while the pursuer is engaged. Range 1..64. Default: 6.
# EVEJS_LNE_GRID_DEFENSE_RETURN_MAX_ROUNDS=

# grid.defense.scanFleets - Fleets of the system read per listener / event. Range 1..256. Default: 32.
# EVEJS_LNE_GRID_DEFENSE_SCAN_FLEETS=

# grid.defense.maxEventsPerPass - maxPerPass of GRID_DEFENSE_ALERT and GRID_DEFENSE_STEP. Range 1..1024. Default: 64.
# EVEJS_LNE_GRID_DEFENSE_MAX_EVENTS_PER_PASS=

# A hunt strike (intercept / destroy) holds on its
# entry gate and its STRIKE step moves it to the target fleet of its pin in the system. Needs grid.defense.enabled +
# hunt.enabled. Internal: not in the launcher.

# grid.defense.strikePursuitEnabled - Feature flag: a hunt strike holds on its entry gate and pursues the target fleet
# of its pin. Range: true/false. Default: false.
# EVEJS_LNE_GRID_DEFENSE_STRIKE_PURSUIT_ENABLED=

# A fleet in transit on the gates of an inner system
# the garrison on the entry gate (align longer than the lock) or on the exit gate (nullsec bubble) stops it
# (FLEET_GRID_CROSSING, interceptInTx, contact), and the align window of a slow fleet on its entry gate after a
# gate arrival. Needs grid.defense.enabled (enable with). Internal: not in the launcher.

# grid.crossings.enabled - Feature flag: departure listener, FLEET_GRID_CROSSING, align window; off = queued rows end
# STALE. Default: false.
# EVEJS_LNE_GRID_CROSSINGS_ENABLED=

# grid.crossings.lockMs - Raw lock time of a guard; a gate phase longer than this is caught. Range 0..60000.
# Default: 5000.
# EVEJS_LNE_GRID_CROSSINGS_LOCK_MS=

# grid.crossings.exitExposureMs - Raw exposure on the exit gate outside nullsec. Range 0..18000. Default: 0.
# EVEJS_LNE_GRID_CROSSINGS_EXIT_EXPOSURE_MS=

# grid.crossings.nullExitExposureMs - Raw exposure on the exit gate in nullsec (bubble). Range 0..18000.
# Default: 10000.
# EVEJS_LNE_GRID_CROSSINGS_NULL_EXIT_EXPOSURE_MS=

# grid.crossings.catchChancePermille - Chance of a catch once the rules pass. Range 0..1000. Default: 1000.
# EVEJS_LNE_GRID_CROSSINGS_CATCH_CHANCE_PERMILLE=

# grid.crossings.minStrengthPermille - Strength of the guards vs the transit (x / 1000). Range 0..10000. Default: 500.
# EVEJS_LNE_GRID_CROSSINGS_MIN_STRENGTH_PERMILLE=

# grid.crossings.listenerMaxSystems - Inner systems read by the departure listener / one check. Range 1..64.
# Default: 16.
# EVEJS_LNE_GRID_CROSSINGS_LISTENER_MAX_SYSTEMS=

# grid.crossings.listenerScanFleets - Fleets per system of the candidate read. Range 1..64. Default: 8.
# EVEJS_LNE_GRID_CROSSINGS_LISTENER_SCAN_FLEETS=

# grid.crossings.maxChecksPerLeg - FLEET_GRID_CROSSING checks of one leg. Range 1..32. Default: 8.
# EVEJS_LNE_GRID_CROSSINGS_MAX_CHECKS_PER_LEG=

# grid.crossings.maxEventsPerPass - maxPerPass of FLEET_GRID_CROSSING. Range 1..1024. Default: 64.
# EVEJS_LNE_GRID_CROSSINGS_MAX_EVENTS_PER_PASS=

# The blockade moves to the entry gate of a hostile
# crossing (BLOCKADE_POSITION) and the lowsec camp to the gate with the most hostile convoy traffic; BLOCKADE_INTERCEPT
# and LOWSEC_AMBUSH catch only in the grid of the IN / OUT gate. Needs grid.enabled + grid.movesEnabled (not
# grid.defense.enabled). Internal: not in the launcher.

# grid.crossings.blockadeGateEnabled - Feature flag: BLOCKADE_POSITION, gate test of BLOCKADE_INTERCEPT /
# LOWSEC_AMBUSH, camp gate; off = queued positions end STALE. Default: false.
# EVEJS_LNE_GRID_CROSSINGS_BLOCKADE_GATE_ENABLED=

# grid.crossings.blockadePositionLeadMs - Raw lead of BLOCKADE_POSITION before the crossing (scaled like the moves).
# Range 1000..600000. Default: 90000.
# EVEJS_LNE_GRID_CROSSINGS_BLOCKADE_POSITION_LEAD_MS=

# grid.crossings.blockadePositionMaxRounds - Re-checks of one BLOCKADE_POSITION chain. Range 1..16. Default: 4.
# EVEJS_LNE_GRID_CROSSINGS_BLOCKADE_POSITION_MAX_ROUNDS=

# Templates of the Local chatter from the NVIDIA API
# (lib/chatterAi). All keys internal: not in the launcher, values outside the range are clamped. The API key only
# from the env (root.env next to compose.yaml), never in settings.json or the repository (envOnly).
# Enable: key from build.nvidia.com, then in the root.env
# EVEJS_LNE_CHATTER_AI_ENABLED=1, EVEJS_LNE_CHATTER_AI_API_KEY=<key> and EVEJS_LNE_HIGHSEC_LIFE_CHATTER_ENABLED=1
# (the AI only feeds the highsec chatter), then `docker compose up -d --force-recreate server` (no build).
# Rollback: EVEJS_LNE_CHATTER_AI_ENABLED=0 + force-recreate (static lines again).
# RPM of the key: about 40 per key on the free tier, shared with shipAi when shipAi has no key of
# its own. chatterAi 10 + shipAi 20 = 30 <= shipAi.sharedKeyMaxRpm 36 (the background lanes of shipAi sit inside its
# 20). In practice chatterAi sends at most maxInFlight per refill pass (1 every 15 s = 4 RPM). HTTP 429 or a breaker
# often open: lower EVEJS_LNE_CHATTER_AI_MAX_REQUESTS_PER_MINUTE (and/or the shipAi one). HTTP 404/400 in lastError:
# model name not in the NVIDIA catalogue, set EVEJS_LNE_CHATTER_AI_MODEL. AUTH_REJECTED: wrong key.
# chatterAi.enabled - off = no service, no timer, no request; the chatter keeps its static lines
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_CHATTER_AI_ENABLED=

# chatterAi.apiKey - the NVIDIA API key, only from the env (settings.json ignored)
# Not in the launcher. Default: empty. Secret: masked in the observer and warnings.
# EVEJS_LNE_CHATTER_AI_API_KEY=

# chatterAi.baseUrl - API base (https, no user:password, query or fragment); + /chat/completions
# Not in the launcher. Default: https://integrate.api.nvidia.com/v1.
# EVEJS_LNE_CHATTER_AI_BASE_URL=

# chatterAi.model - model name of the chat completion
# Not in the launcher. Default: nvidia/nemotron-3.5-super-vl-120b-a12b.
# EVEJS_LNE_CHATTER_AI_MODEL=

# chatterAi.reasoningOff - send chat_template_kwargs.enable_thinking=false (no reasoning tokens); false = the key is not sent
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_CHATTER_AI_REASONING_OFF=

# chatterAi.temperatureMilli - temperature x 1000
# Not in the launcher. Range 0..2000 (outside: clamped). Default: 900.
# EVEJS_LNE_CHATTER_AI_TEMPERATURE_MILLI=

# chatterAi.topPMilli - top_p x 1000
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 950.
# EVEJS_LNE_CHATTER_AI_TOP_P_MILLI=

# chatterAi.maxTokens - max_tokens of one request
# Not in the launcher. Range 16..4096 (outside: clamped). Default: 512.
# EVEJS_LNE_CHATTER_AI_MAX_TOKENS=

# chatterAi.linesPerRequest - templates asked for (and accepted at most) per request
# Not in the launcher. Range 1..20 (outside: clamped). Default: 8.
# EVEJS_LNE_CHATTER_AI_LINES_PER_REQUEST=

# chatterAi.promptExamples - static lines of the bucket shown as examples
# Not in the launcher. Range 0..8 (outside: clamped). Default: 3.
# EVEJS_LNE_CHATTER_AI_PROMPT_EXAMPLES=

# chatterAi.minTemplateChars - shortest accepted template
# Not in the launcher. Range 1..200 (outside: clamped). Default: 12.
# EVEJS_LNE_CHATTER_AI_MIN_TEMPLATE_CHARS=

# chatterAi.maxTemplateChars - longest accepted template
# Not in the launcher. Range 20..400 (outside: clamped). Default: 160.
# EVEJS_LNE_CHATTER_AI_MAX_TEMPLATE_CHARS=

# chatterAi.bannedWords - comma list of words / phrases added to the built-in banned list
# Not in the launcher. Default: empty.
# EVEJS_LNE_CHATTER_AI_BANNED_WORDS=

# chatterAi.timeoutMs - HTTP time limit
# Not in the launcher. Range 1000..120000 (outside: clamped). Default: 15000.
# EVEJS_LNE_CHATTER_AI_TIMEOUT_MS=

# chatterAi.maxResponseBytes - response body limit (over = TOO_LARGE)
# Not in the launcher. Range 1024..1048576 (outside: clamped). Default: 32768.
# EVEJS_LNE_CHATTER_AI_MAX_RESPONSE_BYTES=

# chatterAi.maxRequestsPerMinute - requests per minute; free NVIDIA tier is 40 RPM per key, shared with shipAi (0 = never)
# Not in the launcher. Range 0..60 (outside: clamped). Default: 10.
# EVEJS_LNE_CHATTER_AI_MAX_REQUESTS_PER_MINUTE=

# chatterAi.maxInFlight - requests at the same time
# Not in the launcher. Range 1..4 (outside: clamped). Default: 1.
# EVEJS_LNE_CHATTER_AI_MAX_IN_FLIGHT=

# chatterAi.dailyTokenBudget - tokens per UTC day, in memory, a runaway guard only (no provider token cap; 0 = never)
# Not in the launcher. Range 0..100000000 (outside: clamped). Default: 20000000.
# EVEJS_LNE_CHATTER_AI_DAILY_TOKEN_BUDGET=

# chatterAi.refillTickMs - cadence of the refill pass
# Not in the launcher. Range 2000..600000 (outside: clamped). Default: 15000.
# EVEJS_LNE_CHATTER_AI_REFILL_TICK_MS=

# chatterAi.poolPerBucket - templates kept per bucket
# Not in the launcher. Range 1..200 (outside: clamped). Default: 16.
# EVEJS_LNE_CHATTER_AI_POOL_PER_BUCKET=

# chatterAi.lowWaterPerBucket - refill below this many templates (<= poolPerBucket)
# Not in the launcher. Range 0..200 (outside: clamped). Default: 6.
# EVEJS_LNE_CHATTER_AI_LOW_WATER_PER_BUCKET=

# chatterAi.lineMaxAgeMs - age at which a template leaves the pool
# Not in the launcher. Range 60000..604800000 (outside: clamped). Default: 43200000.
# EVEJS_LNE_CHATTER_AI_LINE_MAX_AGE_MS=

# chatterAi.usePermille - share of Local lines from the pool when the bucket has templates
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 500.
# EVEJS_LNE_CHATTER_AI_USE_PERMILLE=

# chatterAi.breakerFailures - failures in a row that open the breaker
# Not in the launcher. Range 1..100 (outside: clamped). Default: 3.
# EVEJS_LNE_CHATTER_AI_BREAKER_FAILURES=

# chatterAi.breakerCooldownMs - first open time, doubled per failed probe
# Not in the launcher. Range 1000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_CHATTER_AI_BREAKER_COOLDOWN_MS=

# chatterAi.breakerMaxCooldownMs - longest open time (>= breakerCooldownMs)
# Not in the launcher. Range 1000..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_CHATTER_AI_BREAKER_MAX_COOLDOWN_MS=

# chatterAi.language - language of the AI lines (en | pl); restart to apply
# Not in the launcher. Default: en.
# EVEJS_LNE_CHATTER_AI_LANGUAGE=

# chatterAi.profanity - swearing allowed in the AI lines (off | mild | full), capped per bucket; restart to apply
# Not in the launcher. Default: mild.
# EVEJS_LNE_CHATTER_AI_PROFANITY=

# chatterAi.demandWindowMs - an on-demand bucket is refilled only if asked for within this window
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_CHATTER_AI_DEMAND_WINDOW_MS=

# chatterAi.voiceTokenSharePermille - share of dailyTokenBudget the voice buckets may spend per UTC day
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 500.
# EVEJS_LNE_CHATTER_AI_VOICE_TOKEN_SHARE_PERMILLE=

# chatterAi.talkMaxTokens - max_tokens of one talk request
# Not in the launcher. Range 16..2048 (outside: clamped). Default: 160.
# EVEJS_LNE_CHATTER_AI_TALK_MAX_TOKENS=

# chatterAi.talkTokenSharePermille - share of dailyTokenBudget the talk lane may spend per UTC day
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 500.
# EVEJS_LNE_CHATTER_AI_TALK_TOKEN_SHARE_PERMILLE=

# chatterAi.talkReservedPerMinute - RPM slots the refill leaves to talk when talk is on (0 or < maxRequestsPerMinute)
# Not in the launcher. Range 0..60 (outside: clamped). Default: 4.
# EVEJS_LNE_CHATTER_AI_TALK_RESERVED_PER_MINUTE=

# chatterAi.talkMaxInFlight - talk requests at the same time
# Not in the launcher. Range 0..8 (outside: clamped). Default: 2.
# EVEJS_LNE_CHATTER_AI_TALK_MAX_IN_FLIGHT=

# chatterAi.talkMaxPromptChars - longest message of a talk request (longer = BAD_SPEC, no request)
# Not in the launcher. Range 500..32000 (outside: clamped). Default: 8000.
# EVEJS_LNE_CHATTER_AI_TALK_MAX_PROMPT_CHARS=

# The lane "news" of chatterAi.complete() (the edition text).
# chatterAi.newsMaxTokens - max_tokens of one news request
# Not in the launcher. Range 64..4096 (outside: clamped). Default: 1200.
# EVEJS_LNE_CHATTER_AI_NEWS_MAX_TOKENS=

# chatterAi.newsTokenSharePermille - share of dailyTokenBudget the news lane may spend per UTC day
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 50.
# EVEJS_LNE_CHATTER_AI_NEWS_TOKEN_SHARE_PERMILLE=

# chatterAi.newsMaxPromptChars - longest message of a news request (longer = BAD_SPEC, no request)
# Not in the launcher. Range 1000..32000 (outside: clamped). Default: 8000.
# EVEJS_LNE_CHATTER_AI_NEWS_MAX_PROMPT_CHARS=

# chatterAi.newsTimeoutMs - timeout of one news request
# Not in the launcher. Range 5000..180000 (outside: clamped). Default: 60000.
# EVEJS_LNE_CHATTER_AI_NEWS_TIMEOUT_MS=

# The lane "plot" of chatterAi.complete() (the Game Master proposal).
# chatterAi.plotMaxTokens - max_tokens of one plot request
# Not in the launcher. Range 64..4096 (outside: clamped). Default: 700.
# EVEJS_LNE_CHATTER_AI_PLOT_MAX_TOKENS=

# chatterAi.plotTokenSharePermille - share of dailyTokenBudget the plot lane may spend per UTC day
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 100.
# EVEJS_LNE_CHATTER_AI_PLOT_TOKEN_SHARE_PERMILLE=

# chatterAi.plotMaxPromptChars - longest message of a plot request (longer = BAD_SPEC, no request)
# Not in the launcher. Range 1000..32000 (outside: clamped). Default: 8000.
# EVEJS_LNE_CHATTER_AI_PLOT_MAX_PROMPT_CHARS=

# chatterAi.plotTimeoutMs - timeout of one plot request
# Not in the launcher. Range 5000..180000 (outside: clamped). Default: 90000.
# EVEJS_LNE_CHATTER_AI_PLOT_TIMEOUT_MS=

# Faction voices of the NPC chat (lib/npcVoices).
# All keys internal: not in the launcher, values outside the range are clamped. The local lane also needs
# localPilots.enabled; the AI templates of the voices also need chatterAi.enabled.
# Enable: in the root.env EVEJS_LNE_NPC_VOICES_ENABLED=1
# EVEJS_LNE_NPC_VOICES_LOCAL_ENABLED=1 (needs EVEJS_LNE_LOCAL_PILOTS_ENABLED=1) and EVEJS_LNE_NPC_VOICES_SITE_ENABLED=1,
# then `docker compose up -d --force-recreate server` (no build). Without chatterAi the voices speak static lines.
# The voices add no request of their own: their AI buckets are refilled on demand inside the chatterAi RPM window
# and spend at most chatterAi.voiceTokenSharePermille of its daily token budget.
# Language and swearing of the AI lines: EVEJS_LNE_CHATTER_AI_LANGUAGE=pl (+ EVEJS_LNE_CHATTER_AI_USE_PERMILLE=1000,
# an empty pool gives English static lines) and EVEJS_LNE_CHATTER_AI_PROFANITY=off|mild|full (pirates swear, empires
# do not; restart to apply). Extended alphabet of the glyph lines (Greek, math, geometric signs): first check
# `!npcvoices` in the client; only when its sample shows no squares set EVEJS_LNE_NPC_VOICES_GLYPHS_EXTENDED=1.
# Rollback: EVEJS_LNE_NPC_VOICES_ENABLED=0 + force-recreate (no room entry hook, Local as before).
# npcVoices.enabled - off = no service, no timer, no metric; the 52 fv.* AI buckets are not built
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_NPC_VOICES_ENABLED=

# npcVoices.maxLineChars - longest filled voice line
# Not in the launcher. Range 20..400 (outside: clamped). Default: 200.
# EVEJS_LNE_NPC_VOICES_MAX_LINE_CHARS=

# npcVoices.glyphs.extended - also Greek, math and geometric signs in the glyph lines (client font check first)
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_NPC_VOICES_GLYPHS_EXTENDED=

# npcVoices.glyphs.minWords - fewest words of a glyph line
# Not in the launcher. Range 1..12 (outside: clamped). Default: 2.
# EVEJS_LNE_NPC_VOICES_GLYPHS_MIN_WORDS=

# npcVoices.glyphs.maxWords - most words of a glyph line (>= minWords)
# Not in the launcher. Range 1..12 (outside: clamped). Default: 6.
# EVEJS_LNE_NPC_VOICES_GLYPHS_MAX_WORDS=

# npcVoices.glyphs.minWordLen - shortest glyph word
# Not in the launcher. Range 1..16 (outside: clamped). Default: 2.
# EVEJS_LNE_NPC_VOICES_GLYPHS_MIN_WORD_LEN=

# npcVoices.glyphs.maxWordLen - longest glyph word (>= minWordLen)
# Not in the launcher. Range 1..16 (outside: clamped). Default: 6.
# EVEJS_LNE_NPC_VOICES_GLYPHS_MAX_WORD_LEN=

# npcVoices.local.enabled - off = the faction crews never speak on Local, localPilots does not call noteFactionCrews
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_NPC_VOICES_LOCAL_ENABLED=

# npcVoices.local.tickMs - cadence of the local lane pass
# Not in the launcher. Range 1000..60000 (outside: clamped). Default: 5000.
# EVEJS_LNE_NPC_VOICES_LOCAL_TICK_MS=

# npcVoices.local.minGapMs - shortest gap between two lines of a system
# Not in the launcher. Range 10000..86400000 (outside: clamped). Default: 180000.
# EVEJS_LNE_NPC_VOICES_LOCAL_MIN_GAP_MS=

# npcVoices.local.maxGapMs - longest gap between two lines of a system (>= minGapMs)
# Not in the launcher. Range 10000..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_NPC_VOICES_LOCAL_MAX_GAP_MS=

# npcVoices.local.maxLinesPerMinute - faction crew lines per minute over all systems (0 = silence)
# Not in the launcher. Range 0..60 (outside: clamped). Default: 6.
# EVEJS_LNE_NPC_VOICES_LOCAL_MAX_LINES_PER_MINUTE=

# npcVoices.local.maxLinesPerSystemPerHour - faction crew lines per system and hour
# Not in the launcher. Range 0..120 (outside: clamped). Default: 6.
# EVEJS_LNE_NPC_VOICES_LOCAL_MAX_LINES_PER_SYSTEM_PER_HOUR=

# npcVoices.local.addressPermille - share of lines spoken to a player of the system
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 350.
# EVEJS_LNE_NPC_VOICES_LOCAL_ADDRESS_PERMILLE=

# npcVoices.local.addressCooldownMs - a player is addressed at most once in this window
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_NPC_VOICES_LOCAL_ADDRESS_COOLDOWN_MS=

# npcVoices.local.recentLinesPerSystem - last line ids of a system not repeated while another line fits
# Not in the launcher. Range 0..64 (outside: clamped). Default: 8.
# EVEJS_LNE_NPC_VOICES_LOCAL_RECENT_LINES_PER_SYSTEM=

# npcVoices.local.maxSystems - systems kept by the lane (the oldest drops)
# Not in the launcher. Range 1..1024 (outside: clamped). Default: 64.
# EVEJS_LNE_NPC_VOICES_LOCAL_MAX_SYSTEMS=

# The site lane of the faction voices. The NPC of an
# anomaly / signature / mission room talk to the player who enters it (system lines of Local to him only). Also needs
# npcVoices.enabled. `!npcvoices` (sample of the voices and glyphs) works with npcVoices.enabled alone.
# npcVoices.site.enabled - off = no site entry hook, the NPC of a site never talk to the player
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_NPC_VOICES_SITE_ENABLED=

# npcVoices.site.tickMs - cadence of the site lane pass
# Not in the launcher. Range 250..60000 (outside: clamped). Default: 1000.
# EVEJS_LNE_NPC_VOICES_SITE_TICK_MS=

# npcVoices.site.siteKinds - CSV of the instance siteKind values that talk (abyssal never)
# Not in the launcher. Default: anomaly,signature,mission.
# EVEJS_LNE_NPC_VOICES_SITE_KINDS=

# npcVoices.site.firstDelayMs - delay of the first line after the room entry
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 4000.
# EVEJS_LNE_NPC_VOICES_SITE_FIRST_DELAY_MS=

# npcVoices.site.lineGapMinMs - shortest gap between two lines of an exchange
# Not in the launcher. Range 500..600000 (outside: clamped). Default: 3000.
# EVEJS_LNE_NPC_VOICES_SITE_LINE_GAP_MIN_MS=

# npcVoices.site.lineGapMaxMs - longest gap between two lines of an exchange (>= lineGapMinMs)
# Not in the launcher. Range 500..600000 (outside: clamped). Default: 9000.
# EVEJS_LNE_NPC_VOICES_SITE_LINE_GAP_MAX_MS=

# npcVoices.site.minLines - fewest lines of an exchange
# Not in the launcher. Range 1..8 (outside: clamped). Default: 2.
# EVEJS_LNE_NPC_VOICES_SITE_MIN_LINES=

# npcVoices.site.maxLines - most lines of an exchange (>= minLines)
# Not in the launcher. Range 1..8 (outside: clamped). Default: 4.
# EVEJS_LNE_NPC_VOICES_SITE_MAX_LINES=

# npcVoices.site.characterCooldownMs - a player gets at most one exchange in this window
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_NPC_VOICES_SITE_CHARACTER_COOLDOWN_MS=

# npcVoices.site.roomCooldownMs - the same player, site and room talk at most once in this window (also the dedup)
# Not in the launcher. Range 0..604800000 (outside: clamped). Default: 21600000.
# EVEJS_LNE_NPC_VOICES_SITE_ROOM_COOLDOWN_MS=

# npcVoices.site.otherRoomPermille - share of entries into a room other than room:entry that talk
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 500.
# EVEJS_LNE_NPC_VOICES_SITE_OTHER_ROOM_PERMILLE=

# npcVoices.site.maxExchangesPerHour - exchanges per hour over all players (0 = silence)
# Not in the launcher. Range 0..3600 (outside: clamped). Default: 60.
# EVEJS_LNE_NPC_VOICES_SITE_MAX_EXCHANGES_PER_HOUR=

# npcVoices.site.maxExchangesPerCharacterPerHour - exchanges per player and hour
# Not in the launcher. Range 0..60 (outside: clamped). Default: 4.
# EVEJS_LNE_NPC_VOICES_SITE_MAX_EXCHANGES_PER_CHARACTER_PER_HOUR=

# npcVoices.site.maxPending - exchanges in flight at once
# Not in the launcher. Range 1..1024 (outside: clamped). Default: 32.
# EVEJS_LNE_NPC_VOICES_SITE_MAX_PENDING=

# npcVoices.site.maxEntryQueue - room entries waiting for the next pass (overflow dropped)
# Not in the launcher. Range 1..4096 (outside: clamped). Default: 64.
# EVEJS_LNE_NPC_VOICES_SITE_MAX_ENTRY_QUEUE=

# npcVoices.site.colorSpeakers - the speaker label in the voice colour (<color=0xff...>)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_NPC_VOICES_SITE_COLOR_SPEAKERS=

# npcVoices.talk.enabled - off = no Local tap (no listener on chatRuntime), no transcript
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_NPC_VOICES_TALK_ENABLED=

# npcVoices.talk.transcriptLines - last Local lines kept per system
# Not in the launcher. Range 1..100 (outside: clamped). Default: 24.
# EVEJS_LNE_NPC_VOICES_TALK_TRANSCRIPT_LINES=

# npcVoices.talk.contextMaxAgeMs - a transcript line older than this is never used
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_NPC_VOICES_TALK_CONTEXT_MAX_AGE_MS=

# npcVoices.talk.lineChars - longest kept transcript line (cut after the sanitizing)
# Not in the launcher. Range 20..400 (outside: clamped). Default: 200.
# EVEJS_LNE_NPC_VOICES_TALK_LINE_CHARS=

# npcVoices.talk.maxSystems - systems kept by the transcript (the least recently active drops)
# Not in the launcher. Range 1..1024 (outside: clamped). Default: 32.
# EVEJS_LNE_NPC_VOICES_TALK_MAX_SYSTEMS=

# npcVoices.talk.sharePlayerText - false = player lines never enter the transcript (NPC talk only)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_NPC_VOICES_TALK_SHARE_PLAYER_TEXT=

# npcVoices.talk.tickMs - cadence of the talk lane pass
# Not in the launcher. Range 500..60000 (outside: clamped). Default: 2000.
# EVEJS_LNE_NPC_VOICES_TALK_TICK_MS=

# npcVoices.talk.minGapMs - shortest gap of an ambient turn per system (also the gap after every sent line)
# Not in the launcher. Range 5000..3600000 (outside: clamped). Default: 45000.
# EVEJS_LNE_NPC_VOICES_TALK_MIN_GAP_MS=

# npcVoices.talk.maxGapMs - longest gap of an ambient turn per system (>= minGapMs)
# Not in the launcher. Range 5000..3600000 (outside: clamped). Default: 75000.
# EVEJS_LNE_NPC_VOICES_TALK_MAX_GAP_MS=

# npcVoices.talk.requirePlayer - a system talks only with at least one player in presence
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_NPC_VOICES_TALK_REQUIRE_PLAYER=

# npcVoices.talk.contextLines - last transcript lines in the prompt (<= transcriptLines)
# Not in the launcher. Range 0..50 (outside: clamped). Default: 12.
# EVEJS_LNE_NPC_VOICES_TALK_CONTEXT_LINES=

# npcVoices.talk.maxLineChars - longest AI line of the talk lane
# Not in the launcher. Range 20..400 (outside: clamped). Default: 180.
# EVEJS_LNE_NPC_VOICES_TALK_MAX_LINE_CHARS=

# npcVoices.talk.minLineChars - shortest AI line of the talk lane (<= maxLineChars)
# Not in the launcher. Range 1..100 (outside: clamped). Default: 4.
# EVEJS_LNE_NPC_VOICES_TALK_MIN_LINE_CHARS=

# npcVoices.talk.replyPermille - share of player lines that get an NPC answer
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 1000.
# EVEJS_LNE_NPC_VOICES_TALK_REPLY_PERMILLE=

# npcVoices.talk.replyDelayMinMs - shortest delay of an answer to a player
# Not in the launcher. Range 0..120000 (outside: clamped). Default: 3000.
# EVEJS_LNE_NPC_VOICES_TALK_REPLY_DELAY_MIN_MS=

# npcVoices.talk.replyDelayMaxMs - longest delay of an answer to a player (>= replyDelayMinMs)
# Not in the launcher. Range 0..120000 (outside: clamped). Default: 9000.
# EVEJS_LNE_NPC_VOICES_TALK_REPLY_DELAY_MAX_MS=

# npcVoices.talk.replyCooldownMs - one planned answer per player in this window
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 20000.
# EVEJS_LNE_NPC_VOICES_TALK_REPLY_COOLDOWN_MS=

# npcVoices.talk.followUpPermille - share of sent lines answered by another crew member
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 350.
# EVEJS_LNE_NPC_VOICES_TALK_FOLLOW_UP_PERMILLE=

# npcVoices.talk.followUpDelayMinMs - shortest delay of a follow-up
# Not in the launcher. Range 0..300000 (outside: clamped). Default: 8000.
# EVEJS_LNE_NPC_VOICES_TALK_FOLLOW_UP_DELAY_MIN_MS=

# npcVoices.talk.followUpDelayMaxMs - longest delay of a follow-up (>= followUpDelayMinMs)
# Not in the launcher. Range 0..300000 (outside: clamped). Default: 20000.
# EVEJS_LNE_NPC_VOICES_TALK_FOLLOW_UP_DELAY_MAX_MS=

# npcVoices.talk.maxFollowUpsInRow - follow-ups in a row (a player line resets the count)
# Not in the launcher. Range 0..10 (outside: clamped). Default: 2.
# EVEJS_LNE_NPC_VOICES_TALK_MAX_FOLLOW_UPS_IN_ROW=

# npcVoices.talk.maxInFlight - talk requests in flight over all systems (one per system)
# Not in the launcher. Range 0..16 (outside: clamped). Default: 2.
# EVEJS_LNE_NPC_VOICES_TALK_MAX_IN_FLIGHT=

# npcVoices.talk.maxLinesPerMinute - talk lines per minute over all systems
# Not in the launcher. Range 0..120 (outside: clamped). Default: 12.
# EVEJS_LNE_NPC_VOICES_TALK_MAX_LINES_PER_MINUTE=

# npcVoices.talk.maxLinesPerSystemPerHour - talk lines per system and hour
# Not in the launcher. Range 0..3600 (outside: clamped). Default: 90.
# EVEJS_LNE_NPC_VOICES_TALK_MAX_LINES_PER_SYSTEM_PER_HOUR=

# npcVoices.talk.staleMs - an AI answer older than this (from the dispatch) is dropped
# Not in the launcher. Range 1000..600000 (outside: clamped). Default: 20000.
# EVEJS_LNE_NPC_VOICES_TALK_STALE_MS=

# npcVoices.talk.fallbackPermille - share of failed AI turns that say a static line instead (the rest is silence)
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 300.
# EVEJS_LNE_NPC_VOICES_TALK_FALLBACK_PERMILLE=

# fame - the tier of a player at a faction from the raw
# vendor standing (LEGEND >= legendMin, PUBLIC_ENEMY <= enemyMax), announced on entry (journal + mail), recognized by
# the NPC crews on Local. All keys internal: not in the launcher, numbers outside the range are clamped. Enable in the
# root .env (compose passes the keys): EVEJS_LNE_FAME_ENABLED=1, optional EVEJS_LNE_FAME_LOCAL_ENABLED=1 (needs the
# npcVoices Local lane) and EVEJS_LNE_FAME_NOTICES_ENABLED=1 (needs notices). See the player fame section of the README.
# EVEJS_LNE_FAME_ENABLED=
# EVEJS_LNE_FAME_LEGEND_MIN=
# EVEJS_LNE_FAME_ENEMY_MAX=
# EVEJS_LNE_FAME_HYSTERESIS=
# EVEJS_LNE_FAME_REVIEW_EVERY_MS=
# EVEJS_LNE_FAME_REVIEW_MAX_PLAYERS=
# EVEJS_LNE_FAME_REVIEW_MAX_READS_PER_PASS=
# EVEJS_LNE_FAME_REVIEW_MAX_ANNOUNCES_PER_PASS=
# EVEJS_LNE_FAME_REVIEW_MAX_PAIRS=
# EVEJS_LNE_FAME_ANNOUNCE_PERIOD_MS=
# EVEJS_LNE_FAME_CACHE_TTL_MS=
# EVEJS_LNE_FAME_CACHE_MAX_ENTRIES=
# EVEJS_LNE_FAME_LOCAL_ENABLED=
# EVEJS_LNE_FAME_LOCAL_RECOGNIZE_PERMILLE=
# EVEJS_LNE_FAME_LOCAL_RECOGNIZE_COOLDOWN_MS=
# EVEJS_LNE_FAME_LOCAL_MAX_CANDIDATES=
# EVEJS_LNE_FAME_NOTICES_ENABLED=
# EVEJS_LNE_FAME_DOCK_DENY_ENABLED=1 (dock refusal of a PUBLIC_ENEMY), EVEJS_LNE_FAME_MARKET_TAX_ENABLED=1
# and EVEJS_LNE_FAME_MARKET_BROKER_ENABLED=1 (station market, restart; broker = hypothesis H2).
# EVEJS_LNE_FAME_DOCK_DENY_ENABLED=
# EVEJS_LNE_FAME_MARKET_TAX_ENABLED=
# EVEJS_LNE_FAME_MARKET_BROKER_ENABLED=
# EVEJS_LNE_FAME_LEGEND_TAX_PERMILLE=
# EVEJS_LNE_FAME_ENEMY_TAX_PERMILLE=
# EVEJS_LNE_FAME_LEGEND_BROKER_PERMILLE=
# EVEJS_LNE_FAME_ENEMY_BROKER_PERMILLE=
# EVEJS_LNE_FAME_MAX_SURCHARGE_PERMILLE=
# EVEJS_LNE_FAME_BOUNTY_ENABLED=1 (a PUBLIC_ENEMY in low/null gets hunters of a bounty gang
# needs bountyHunters enabled + liveEnabled + revengeEnabled), EVEJS_LNE_FAME_NEWS_ENABLED=1 (news facts, no player name).
# EVEJS_LNE_FAME_BOUNTY_ENABLED=
# EVEJS_LNE_FAME_BOUNTY_DELAY_AFTER_TIER_MS=
# EVEJS_LNE_FAME_BOUNTY_COOLDOWN_MS=
# EVEJS_LNE_FAME_BOUNTY_DELAY_MS=
# EVEJS_LNE_FAME_BOUNTY_WINDOW_MS=
# EVEJS_LNE_FAME_BOUNTY_LEVEL_BASE=
# EVEJS_LNE_FAME_BOUNTY_LEVEL_STEP=
# EVEJS_LNE_FAME_BOUNTY_MAX_LEVEL=
# EVEJS_LNE_FAME_BOUNTY_CHECKS_PER_PASS=
# EVEJS_LNE_FAME_NEWS_ENABLED=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_ENABLED=1 (the hunters of a fame bounty also in highsec, CONCORD
# answers: the hunters leave after the response time), ..._CONCORD_SPAWN_ENABLED=1 (CONCORD spawned on the hunters;
# hypotheses, to be tried in the game).
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_ENABLED=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_CONCORD_SPAWN_ENABLED=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_CONCORD_EXTRA_MS=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_CONCORD_FALLBACK_MS=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_CONCORD_KILL_MS=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_CONCORD_LEAVE_MS=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_MAX_LIVE=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_MIN_SECURITY=
# EVEJS_LNE_FAME_BOUNTY_HIGHSEC_MAX_SECURITY=

# The ship AI of each player (lib/shipAi)
# = private XMPP room + vendor identity, no model. All keys internal: not in the launcher, values outside the
# range are clamped.
# every switch stays off here and in compose. Enable in the root.env (the server has no env_file
# compose passes the keys): EVEJS_LNE_SHIP_AI_ENABLED=1, EVEJS_LNE_SHIP_AI_ALLOW_CHARACTER_IDS=<id>|*, a key
# (EVEJS_LNE_SHIP_AI_API_KEY or EVEJS_LNE_CHATTER_AI_API_KEY); optional THINKING_CHAT / THINKING_PROACTIVE / VOICE_ENABLED.
# Full description: the ship AI (shipAi) section of the README.
# shipAi.enabled - off = no wrap, no!ai command, no AI character record
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_SHIP_AI_ENABLED=

# shipAi.channel - private = own XMPP room with the AI; local = fallback without the room (lines in)
# Not in the launcher. Values: private | local. Default: private.
# EVEJS_LNE_SHIP_AI_CHANNEL=

# shipAi.allowCharacterIds - who may use!ai - empty = nobody, * = everybody, else a comma list of IDs
# Not in the launcher. Default: (empty = nobody).
# EVEJS_LNE_SHIP_AI_ALLOW_CHARACTER_IDS=

# shipAi.defaultName - name of a new ship AI (1..37 characters)
# Not in the launcher. Default: Jin.
# EVEJS_LNE_SHIP_AI_DEFAULT_NAME=

# shipAi.bio - description of the AI character (at most 1000 characters)
# Not in the launcher. Default: Onboard intelligence of your capsule. Wakes with you in every new clone and every
# new hull.
# EVEJS_LNE_SHIP_AI_BIO=

# shipAi.corporationId - NPC corporation of the AI characters (1000169 = Center for Advanced Studies)
# Not in the launcher. Range 1..2147483647 (outside: clamped). Default: 1000169. Must exist at start.
# EVEJS_LNE_SHIP_AI_CORPORATION_ID=

# shipAi.maxIdentities - AI characters on this server
# Not in the launcher. Range 1..256 (outside: clamped). Default: 16.
# EVEJS_LNE_SHIP_AI_MAX_IDENTITIES=

# shipAi.minIntervalMs - cooldown of!ai per character
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 4000.
# EVEJS_LNE_SHIP_AI_MIN_INTERVAL_MS=

# shipAi.xmppMaxBatchBytes - longest AI stanza written to a socket (over = TOO_LONG)
# Not in the launcher. Range 1024..1048576 (outside: clamped). Default: 32768.
# EVEJS_LNE_SHIP_AI_XMPP_MAX_BATCH_BYTES=

# The conversation with the
# model (the shared chatterAi code, own limits). All keys internal: not in the launcher, values outside the range are
# clamped. The API key: shipAi.apiKey, else chatterAi.apiKey; it never reaches a log line, a status or a metric.
# shipAi.apiKey - own NVIDIA API key, only from the env; empty = chatterAi.apiKey
# Not in the launcher. Default: empty. Secret: masked in the observer and warnings.
# EVEJS_LNE_SHIP_AI_API_KEY=

# shipAi.baseUrl - API base (https, no user:password, query or fragment); + /chat/completions
# Not in the launcher. Default: https://integrate.api.nvidia.com/v1.
# EVEJS_LNE_SHIP_AI_BASE_URL=

# shipAi.model - model name of the chat completion
# Not in the launcher. Default: nvidia/nemotron-3.5-super-vl-120b-a12b.
# EVEJS_LNE_SHIP_AI_MODEL=

# shipAi.reasoningOff - send chat_template_kwargs.enable_thinking=false; false = the key is not sent
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_REASONING_OFF=

# shipAi.language - language of the persona and of the replies (en | pl)
# Not in the launcher. Default: en.
# EVEJS_LNE_SHIP_AI_LANGUAGE=

# shipAi.profanity - swearing the reply filter lets through (off | mild | full); never at the player
# Not in the launcher. Default: mild.
# EVEJS_LNE_SHIP_AI_PROFANITY=

# shipAi.defaultPersona - persona of a player who chose none (default | savage | cold | flirty | captain);!ai persona changes his own
# Not in the launcher. Default: default.
# EVEJS_LNE_SHIP_AI_DEFAULT_PERSONA=

# shipAi.personaCustomMaxChars - longest own style wish of!ai persona custom <text> (a longer one is refused, never cut)
# Not in the launcher. Range 40..400 (outside: clamped). Default: 200.
# EVEJS_LNE_SHIP_AI_PERSONA_CUSTOM_MAX_CHARS=

# shipAi.temperatureMilli - temperature x 1000
# Not in the launcher. Range 0..2000 (outside: clamped). Default: 650.
# EVEJS_LNE_SHIP_AI_TEMPERATURE_MILLI=

# shipAi.topPMilli - top_p x 1000
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 900.
# EVEJS_LNE_SHIP_AI_TOP_P_MILLI=

# shipAi.maxTokens - max_tokens of one reply
# Not in the launcher. Range 16..4096 (outside: clamped). Default: 400.
# EVEJS_LNE_SHIP_AI_MAX_TOKENS=

# shipAi.timeoutMs - HTTP time limit
# Not in the launcher. Range 1000..120000 (outside: clamped). Default: 20000.
# EVEJS_LNE_SHIP_AI_TIMEOUT_MS=

# shipAi.maxResponseBytes - response body limit (over = BAD_SHAPE)
# Not in the launcher. Range 1024..1048576 (outside: clamped). Default: 65536.
# EVEJS_LNE_SHIP_AI_MAX_RESPONSE_BYTES=

# shipAi.maxRequestsPerMinute - requests per minute, the main limit (40 RPM per key on the free tier
# shared with chatterAi; 0 = never)
# Not in the launcher. Range 0..60 (outside: clamped). Default: 20.
# EVEJS_LNE_SHIP_AI_MAX_REQUESTS_PER_MINUTE=

# shipAi.sharedKeyMaxRpm - one WARN at start when chatterAi + shipAi RPM on the same key is above this
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 36.
# EVEJS_LNE_SHIP_AI_SHARED_KEY_MAX_RPM=

# shipAi.maxInFlight - model requests at the same time
# Not in the launcher. Range 1..8 (outside: clamped). Default: 2.
# EVEJS_LNE_SHIP_AI_MAX_IN_FLIGHT=

# shipAi.dailyTokenBudget - tokens per UTC day, in memory, a runaway guard only (0 = never)
# Not in the launcher. Range 0..100000000 (outside: clamped). Default: 20000000.
# EVEJS_LNE_SHIP_AI_DAILY_TOKEN_BUDGET=

# shipAi.perCharacterDailyTokens - tokens per character per UTC day, a runaway guard only (0 = never)
# Not in the launcher. Range 0..100000000 (outside: clamped). Default: 2000000.
# EVEJS_LNE_SHIP_AI_PER_CHARACTER_DAILY_TOKENS=

# shipAi.summaryLanePermille - share of dailyTokenBudget for the summary lane
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 200.
# EVEJS_LNE_SHIP_AI_SUMMARY_LANE_PERMILLE=

# shipAi.proactiveLanePermille - share of dailyTokenBudget for the proactive lane
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 150.
# EVEJS_LNE_SHIP_AI_PROACTIVE_LANE_PERMILLE=

# shipAi.breakerFailures - failures in a row that open the breaker
# Not in the launcher. Range 1..100 (outside: clamped). Default: 3.
# EVEJS_LNE_SHIP_AI_BREAKER_FAILURES=

# shipAi.breakerCooldownMs - first open time, doubled per failed probe
# Not in the launcher. Range 1000..3600000 (outside: clamped). Default: 30000.
# EVEJS_LNE_SHIP_AI_BREAKER_COOLDOWN_MS=

# shipAi.breakerMaxCooldownMs - longest open time (>= breakerCooldownMs)
# Not in the launcher. Range 1000..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_SHIP_AI_BREAKER_MAX_COOLDOWN_MS=

# shipAi.historyTurns - exchanges of the short memory in a prompt
# Not in the launcher. Range 0..40 (outside: clamped). Default: 8.
# EVEJS_LNE_SHIP_AI_HISTORY_TURNS=

# shipAi.historyMaxChars - characters of the history in a prompt (oldest dropped first)
# Not in the launcher. Range 100..20000 (outside: clamped). Default: 2400.
# EVEJS_LNE_SHIP_AI_HISTORY_MAX_CHARS=

# shipAi.turnsKeep - rows of ship_ai_turns kept per character
# Not in the launcher. Range 2..1000 (outside: clamped). Default: 40.
# EVEJS_LNE_SHIP_AI_TURNS_KEEP=

# shipAi.contextMaxChars - characters of the sensor snapshot (DATA block)
# Not in the launcher. Range 50..4000 (outside: clamped). Default: 600.
# EVEJS_LNE_SHIP_AI_CONTEXT_MAX_CHARS=

# shipAi.contextCacheMs - age at which the snapshot of a character is read again
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 5000.
# EVEJS_LNE_SHIP_AI_CONTEXT_CACHE_MS=

# shipAi.maxUserChars - characters of one player text
# Not in the launcher. Range 10..4000 (outside: clamped). Default: 500.
# EVEJS_LNE_SHIP_AI_MAX_USER_CHARS=

# shipAi.maxPendingChars - characters of the texts waiting behind a request (over = the BUSY line)
# Not in the launcher. Range 10..8000 (outside: clamped). Default: 800.
# EVEJS_LNE_SHIP_AI_MAX_PENDING_CHARS=

# shipAi.maxLineChars - characters of one chat line of a reply
# Not in the launcher. Range 40..900 (outside: clamped). Default: 400.
# EVEJS_LNE_SHIP_AI_MAX_LINE_CHARS=

# shipAi.maxLinesPerReply - chat lines of one reply
# Not in the launcher. Range 1..10 (outside: clamped). Default: 3.
# EVEJS_LNE_SHIP_AI_MAX_LINES_PER_REPLY=

# shipAi.pumpIntervalMs - safety pass of the waiting queue (the cooldown arms its own earlier pass)
# Not in the launcher. Range 1000..600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_PUMP_INTERVAL_MS=

# Read-only tools the model asks for. Every
# tool round is one more request in the RPM window of shipAi.maxRequestsPerMinute. All keys internal.
# shipAi.toolMode - off = no tools; text = ASK: lines (every model); native = tools / tool_calls
# Not in the launcher. Values: off | text | native. Default: text.
# EVEJS_LNE_SHIP_AI_TOOL_MODE=

# shipAi.toolMaxRounds - tool rounds of one answer, then 'answer now'
# Not in the launcher. Range 0..5 (outside: clamped). Default: 2.
# EVEJS_LNE_SHIP_AI_TOOL_MAX_ROUNDS=

# shipAi.toolCallsPerRound - tool calls run in one round
# Not in the launcher. Range 1..8 (outside: clamped). Default: 3.
# EVEJS_LNE_SHIP_AI_TOOL_CALLS_PER_ROUND=

# shipAi.toolResultMaxChars - characters of one tool result for the model
# Not in the launcher. Range 100..4000 (outside: clamped). Default: 800.
# EVEJS_LNE_SHIP_AI_TOOL_RESULT_MAX_CHARS=

# shipAi.toolBudgetMs - time of the tool calls of one round; past it the next calls get TOOL_BUDGET
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 50.
# EVEJS_LNE_SHIP_AI_TOOL_BUDGET_MS=

# shipAi.toolCacheMs - age at which a tool result of a character is read again (0 = no cache)
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 15000.
# EVEJS_LNE_SHIP_AI_TOOL_CACHE_MS=

# shipAi.toolMaxRows - rows of a list in one tool result
# Not in the launcher. Range 1..32 (outside: clamped). Default: 8.
# EVEJS_LNE_SHIP_AI_TOOL_MAX_ROWS=

# shipAi.threatMaxJumps - jumps around the pilot searched for hostile LNE fleets
# Not in the launcher. Range 0..3 (outside: clamped). Default: 2.
# EVEJS_LNE_SHIP_AI_THREAT_MAX_JUMPS=

# The long memory of the ship AI (rolling
# summary, facts about the player) and !ai memory / remember / forget / name. All keys internal.
# shipAi.memoryEnabled - false = no summary request, no memory block in the prompt, the memory commands answer 'off'
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_MEMORY_ENABLED=

# shipAi.summaryEveryTurns - rows left out of the summary; a summary is due at 2x this many rows past covers_through_seq
# Not in the launcher. Range 1..50 (outside: clamped). Default: 6.
# EVEJS_LNE_SHIP_AI_SUMMARY_EVERY_TURNS=

# shipAi.summaryMaxChars - characters of the stored rolling summary
# Not in the launcher. Range 100..4000 (outside: clamped). Default: 600.
# EVEJS_LNE_SHIP_AI_SUMMARY_MAX_CHARS=

# shipAi.summaryMaxTokens - max_tokens of one summary request (lane summary)
# Not in the launcher. Range 32..2048 (outside: clamped). Default: 220.
# EVEJS_LNE_SHIP_AI_SUMMARY_MAX_TOKENS=

# shipAi.maxFactsPerCharacter - facts kept per character; over it the lowest score is deleted
# Not in the launcher. Range 1..200 (outside: clamped). Default: 40.
# EVEJS_LNE_SHIP_AI_MAX_FACTS_PER_CHARACTER=

# shipAi.factsInPrompt - top-K facts in one prompt
# Not in the launcher. Range 0..40 (outside: clamped). Default: 8.
# EVEJS_LNE_SHIP_AI_FACTS_IN_PROMPT=

# shipAi.factsMaxChars - characters of all facts in one prompt
# Not in the launcher. Range 0..4000 (outside: clamped). Default: 700.
# EVEJS_LNE_SHIP_AI_FACTS_MAX_CHARS=

# shipAi.factMaxChars - characters of one fact
# Not in the launcher. Range 20..400 (outside: clamped). Default: 120.
# EVEJS_LNE_SHIP_AI_FACT_MAX_CHARS=

# shipAi.factTtlDays - life of a fact taken from the model
# Not in the launcher. Range 1..3650 (outside: clamped). Default: 60.
# EVEJS_LNE_SHIP_AI_FACT_TTL_DAYS=

# shipAi.playerFactTtlDays - life of a fact of!ai remember
# Not in the launcher. Range 1..3650 (outside: clamped). Default: 365.
# EVEJS_LNE_SHIP_AI_PLAYER_FACT_TTL_DAYS=

# shipAi.renameCooldownMs - time between two!ai name of one character (memory only)
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_SHIP_AI_RENAME_COOLDOWN_MS=

# shipAi.forgetConfirmMs - time to type!ai forget all confirm after!ai forget all
# Not in the launcher. Range 5000..600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_FORGET_CONFIRM_MS=

# The game events of the player
# (ship_ai_events) and the proactive lines of the ship AI (!ai quiet / !ai talk). All keys internal.
# shipAi.proactiveEnabled - false = no event pass, no proactive line, no loss listener (!ai quiet / talk still saved)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_PROACTIVE_ENABLED=

# shipAi.proactivePollMs - period of the pass over the watched players (prefs row, online, not quiet)
# Not in the launcher. Range 1000..600000 (outside: clamped). Default: 5000.
# EVEJS_LNE_SHIP_AI_PROACTIVE_POLL_MS=

# shipAi.lowHpPermille - armor or structure below this (in space) = the static low HP warning
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 350.
# EVEJS_LNE_SHIP_AI_LOW_HP_PERMILLE=

# shipAi.lowHpCooldownMs - time between two low HP warnings of one player
# Not in the launcher. Range 5000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_LOW_HP_COOLDOWN_MS=

# shipAi.proactiveKindCooldownMs - time between two lines of one kind (danger, hostiles, dock, undock, ship change) of one player
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_PROACTIVE_KIND_COOLDOWN_MS=

# shipAi.proactiveMinIntervalMs - time between two model lines of one player (kept across a restart; warnings skip it)
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_SHIP_AI_PROACTIVE_MIN_INTERVAL_MS=

# shipAi.silenceMs - silence in the open AI room before a model line, 0 = never
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 2700000.
# EVEJS_LNE_SHIP_AI_SILENCE_MS=

# shipAi.eventsKeep - rows of ship_ai_events kept per player
# Not in the launcher. Range 1..500 (outside: clamped). Default: 30.
# EVEJS_LNE_SHIP_AI_EVENTS_KEEP=

# The portrait of the ship AI from a file of the operator:
# <EVEJS_DATA_ROOT>/mods/livingNewEden/shipAi/avatar-<playerCharId>.jpg|png, else avatar.jpg|png (square 512x512 JPG
# advised; JPEG/PNG by magic bytes, no scaling). All keys internal.
# shipAi.portraitEnabled - false = no portrait file is read, the AI keeps the portrait it has (vendor default hi.jpg if none)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_PORTRAIT_ENABLED=

# shipAi.portraitMaxBytes - largest portrait file read (bigger = too_large, no write)
# Not in the launcher. Range 1024..8388608 (outside: clamped). Default: 1048576.
# EVEJS_LNE_SHIP_AI_PORTRAIT_MAX_BYTES=

# shipAi.portraitBootBatch - AI portraits checked per step of the start pass (one step per setImmediate, outside the tick)
# Not in the launcher. Range 1..64 (outside: clamped). Default: 4.
# EVEJS_LNE_SHIP_AI_PORTRAIT_BOOT_BATCH=

# The ship AI reads the incoming EVE mails of its player
# (the vendor mailbox; no mail text is stored by the mod) and tells / comments them in the AI room (lane mail).
# shipAi.mailEnabled - false = no mail hook (restart), no mail digest,!ai mail answers off
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_MAIL_ENABLED=

# shipAi.mailDigestWindowMs - window after the first new mail in which more mails join the same digest
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 45000.
# EVEJS_LNE_SHIP_AI_MAIL_DIGEST_WINDOW_MS=

# shipAi.mailMinIntervalMs - time between two mail digests of one player
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 120000.
# EVEJS_LNE_SHIP_AI_MAIL_MIN_INTERVAL_MS=

# shipAi.mailLoginDelayMs - delay of the while-you-were-away digest after a login or a boot
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 20000.
# EVEJS_LNE_SHIP_AI_MAIL_LOGIN_DELAY_MS=

# shipAi.mailPollMs - period of the mail pass (due digests only, outside the tick)
# Not in the launcher. Range 1000..600000 (outside: clamped). Default: 15000.
# EVEJS_LNE_SHIP_AI_MAIL_POLL_MS=

# shipAi.mailRescanMs - mailbox rescan of the online players when the mail hook is not installed, 0 = never
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_MAIL_RESCAN_MS=

# shipAi.mailMaxPerDigest - mails in one digest (the newest; the rest is a count)
# Not in the launcher. Range 1..20 (outside: clamped). Default: 5.
# EVEJS_LNE_SHIP_AI_MAIL_MAX_PER_DIGEST=

# shipAi.mailOfflineDigestMax - mails in the while-you-were-away digest (the newest)
# Not in the launcher. Range 1..30 (outside: clamped). Default: 10.
# EVEJS_LNE_SHIP_AI_MAIL_OFFLINE_DIGEST_MAX=

# shipAi.mailMaxBodyChars - characters of a mail body sent to the model (HTML and links removed first)
# Not in the launcher. Range 50..8000 (outside: clamped). Default: 1200.
# EVEJS_LNE_SHIP_AI_MAIL_MAX_BODY_CHARS=

# shipAi.mailMaxTitleChars - characters of a mail subject
# Not in the launcher. Range 10..150 (outside: clamped). Default: 100.
# EVEJS_LNE_SHIP_AI_MAIL_MAX_TITLE_CHARS=

# shipAi.mailPlayersPerPass - due digests handled per mail pass
# Not in the launcher. Range 1..64 (outside: clamped). Default: 4.
# EVEJS_LNE_SHIP_AI_MAIL_PLAYERS_PER_PASS=

# shipAi.mailLanePermille - share of dailyTokenBudget for the mail lane
# Not in the launcher. Range 0..1000 (outside: clamped). Default: 100.
# EVEJS_LNE_SHIP_AI_MAIL_LANE_PERMILLE=

# shipAi.mailFactsPerDigest - lasting facts from one digest into the long memory, 0 = none
# Not in the launcher. Range 0..5 (outside: clamped). Default: 2.
# EVEJS_LNE_SHIP_AI_MAIL_FACTS_PER_DIGEST=

# shipAi.mailFactMaxImportance - highest importance of a fact from a mail
# Not in the launcher. Range 1..5 (outside: clamped). Default: 3.
# EVEJS_LNE_SHIP_AI_MAIL_FACT_MAX_IMPORTANCE=

# shipAi.mailFactTtlDays - life of a fact from a mail
# Not in the launcher. Range 1..365 (outside: clamped). Default: 14.
# EVEJS_LNE_SHIP_AI_MAIL_FACT_TTL_DAYS=

# The read-only game data tools of the ship AI (catalogue v2:
# cargo, fitting, pilot_info). Own character and public data only, nothing is written.
# shipAi.dbReadEnabled - false = the tool catalogue goes back to v1 (no game data tool)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_DB_READ_ENABLED=

# shipAi.dbReadDisabledTools - comma list of game data tools left out of the catalogue (unknown names: one WARN at start)
# Not in the launcher. Default: (empty = every game data tool).
# EVEJS_LNE_SHIP_AI_DB_READ_DISABLED_TOOLS=

# shipAi.dbReadSlowMs - a game data tool call longer than this counts in shipAi.dbReadSlow
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 20.
# EVEJS_LNE_SHIP_AI_DB_READ_SLOW_MS=

# shipAi.dbReadAsyncTimeoutMs - wait of an async game data read (market orders), then TIMEOUT
# Not in the launcher. Range 100..10000 (outside: clamped). Default: 3000.
# EVEJS_LNE_SHIP_AI_DB_READ_ASYNC_TIMEOUT_MS=

# shipAi.walletSumWindowMs - window of the income / spending sums of wallet_history
# Not in the launcher. Range 3600000..2592000000 (outside: clamped). Default: 86400000.
# EVEJS_LNE_SHIP_AI_WALLET_SUM_WINDOW_MS=

# The reasoning of the model per lane (chat
# proactive; never mail nor summary). Off by default: the request body stays as before. Probe first (operator only):
# node mods/livingNewEden/tools/shipAiToolProbe.js --thinking
# shipAi.thinkingChat - true = the chat answers ask for reasoning (chat_template_kwargs.enable_thinking=true)
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_SHIP_AI_THINKING_CHAT=

# shipAi.thinkingProactive - true = the proactive model lines ask for reasoning
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_SHIP_AI_THINKING_PROACTIVE=

# shipAi.thinkingMaxTokens - max_tokens of a request with reasoning (the reasoning counts in it)
# Not in the launcher. Range 256..16384 (outside: clamped). Default: 3072.
# EVEJS_LNE_SHIP_AI_THINKING_MAX_TOKENS=

# shipAi.thinkingTimeoutMs - HTTP time limit of a request with reasoning
# Not in the launcher. Range 1000..180000 (outside: clamped). Default: 90000.
# EVEJS_LNE_SHIP_AI_THINKING_TIMEOUT_MS=

# shipAi.reasoningEffort - reasoning_effort of a request with reasoning (low | medium | high); empty = not sent (probe first)
# Not in the launcher. Values: (empty), low, medium, high. Default: (empty = not sent).
# EVEJS_LNE_SHIP_AI_REASONING_EFFORT=

# shipAi.thinkingToolRounds - true = every round of a tool answer thinks; false = a round that asks a tool does not think, a reply without a tool call is asked once more with reasoning as the final answer
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_THINKING_TOOL_ROUNDS=

# shipAi.thinkingRetryEmpty - a chat round with reasoning and no text is asked once more without reasoning
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_THINKING_RETRY_EMPTY=

# shipAi.thinkingNoticeMs - a chat answer with reasoning longer than this gets one static 'thinking' line, 0 = never
# Not in the launcher. Range 0..120000 (outside: clamped). Default: 15000.
# EVEJS_LNE_SHIP_AI_THINKING_NOTICE_MS=

# The read-only tools in the proactive
# lines, the brief after a SYSTEM_DANGER warning and the RPM window of the background lanes.
# shipAi.proactiveToolsEnabled - true = a proactive model line may read data with the tools first (false = no tools, as)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_PROACTIVE_TOOLS_ENABLED=

# shipAi.proactiveToolMaxRounds - tool rounds of one proactive line (requests per line = rounds + 1)
# Not in the launcher. Range 0..3 (outside: clamped). Default: 1.
# EVEJS_LNE_SHIP_AI_PROACTIVE_TOOL_MAX_ROUNDS=

# shipAi.dangerBriefEnabled - true = after the static SYSTEM_DANGER warning the model may add one brief read with the tools
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_DANGER_BRIEF_ENABLED=

# shipAi.backgroundMaxRequestsPerMinute - requests per minute of the background lanes (proactive, mail, summary), clamped to shipAi.maxRequestsPerMinute (0 = never)
# Not in the launcher. Range 0..60 (outside: clamped). Default: 8.
# EVEJS_LNE_SHIP_AI_BACKGROUND_MAX_REQUESTS_PER_MINUTE=

# The watch of the player data (skills done
# missions near their end) on due times, delivered as one digest line of the model through the proactive lines.
# shipAi.watchEnabled - true = the AI watches the data of its online player (skills done, missions near their end) by itself
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_WATCH_ENABLED=

# shipAi.watchDisabledKinds - comma list of watch kinds left out (SKILL_DONE, MISSION_EXPIRING, JOB_READY, ORDER_FILLED, BOUNTY_PAID, ISK_IN, SKILL_QUEUE_EMPTY, MISSION_OBJECTIVE; unknown names: one WARN at start)
# Not in the launcher. Default: (empty = every watch kind).
# EVEJS_LNE_SHIP_AI_WATCH_DISABLED_KINDS=

# shipAi.watchPollMs - pass interval of the watch (one presence read per pass)
# Not in the launcher. Range 1000..600000 (outside: clamped). Default: 10000.
# EVEJS_LNE_SHIP_AI_WATCH_POLL_MS=

# shipAi.watchReadsPerPass - data reads of one watch pass at most (the rest stays due)
# Not in the launcher. Range 1..64 (outside: clamped). Default: 4.
# EVEJS_LNE_SHIP_AI_WATCH_READS_PER_PASS=

# shipAi.watchPassBudgetMs - synchronous time of one watch pass at most
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 20.
# EVEJS_LNE_SHIP_AI_WATCH_PASS_BUDGET_MS=

# shipAi.watchLoginDelayMs - first watch read after a player shows up
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 30000.
# EVEJS_LNE_SHIP_AI_WATCH_LOGIN_DELAY_MS=

# shipAi.watchLookbackMs - window of the first read after a login (older completed skills give no event)
# Not in the launcher. Range 0..604800000 (outside: clamped). Default: 21600000.
# EVEJS_LNE_SHIP_AI_WATCH_LOOKBACK_MS=

# shipAi.watchRescanMs - longest wait between two reads of a source (also after a refused read)
# Not in the launcher. Range 10000..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_SHIP_AI_WATCH_RESCAN_MS=

# shipAi.skillWatchMs - interval of the skill history reads
# Not in the launcher. Range 10000..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_SHIP_AI_SKILL_WATCH_MS=

# shipAi.missionWarnMs - an accepted mission ending within this time gives MISSION_EXPIRING
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_SHIP_AI_MISSION_WARN_MS=

# shipAi.watchMaxPending - watch events waiting for a line per player at most (the oldest out)
# Not in the launcher. Range 1..32 (outside: clamped). Default: 8.
# EVEJS_LNE_SHIP_AI_WATCH_MAX_PENDING=

# shipAi.watchMaxPerLine - watch events in one digest line at most
# Not in the launcher. Range 1..10 (outside: clamped). Default: 4.
# EVEJS_LNE_SHIP_AI_WATCH_MAX_PER_LINE=

# shipAi.watchPendingMaxAgeMs - a watch event not told within this time is dropped (also the window of the pending after a restart)
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 7200000.
# EVEJS_LNE_SHIP_AI_WATCH_PENDING_MAX_AGE_MS=

# shipAi.marketWatchMs - interval of the market order reads while the player has an open order (else watchRescanMs)
# Not in the launcher. Range 30000..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_MARKET_WATCH_MS=

# The short callouts of hostiles near the player.
# shipAi.calloutEnabled - short template lines when hostiles jump into the system, sit in the sector or attack (needs proactiveEnabled); false = the old static HOSTILES line
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_CALLOUT_ENABLED=

# shipAi.calloutGridRangeMeters - radius of the sector around the ship of the player (the attack counts up to twice this)
# Not in the launcher. Range 10000..1000000 (outside: clamped). Default: 250000.
# EVEJS_LNE_SHIP_AI_CALLOUT_GRID_RANGE_METERS=

# shipAi.calloutScanMax - NPC controllers read in one system per pass at most
# Not in the launcher. Range 10..2000 (outside: clamped). Default: 300.
# EVEJS_LNE_SHIP_AI_CALLOUT_SCAN_MAX=

# shipAi.calloutHostileStandingTenths - a faction standing <= this / 10 is hostile (pirates and invaders always)
# Not in the launcher. Range -100..0 (outside: clamped). Default: -50.
# EVEJS_LNE_SHIP_AI_CALLOUT_HOSTILE_STANDING_TENTHS=

# shipAi.calloutInvaderCacheMs - age of the set of the invader factions
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_CALLOUT_INVADER_CACHE_MS=

# shipAi.calloutSystemCooldownMs - cooldown of the system level (and inbound)
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_CALLOUT_SYSTEM_COOLDOWN_MS=

# shipAi.calloutScanCooldownMs - cooldown of the scan level (a new group on the automatic d-scan)
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_CALLOUT_SCAN_COOLDOWN_MS=

# shipAi.calloutGridCooldownMs - cooldown of the sector level
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_SHIP_AI_CALLOUT_GRID_COOLDOWN_MS=

# shipAi.calloutAttackCooldownMs - cooldown of the attack level
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_CALLOUT_ATTACK_COOLDOWN_MS=

# shipAi.calloutMinGapMs - time between two callouts of a player (the attack skips it)
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 15000.
# EVEJS_LNE_SHIP_AI_CALLOUT_MIN_GAP_MS=

# shipAi.calloutGrowthMin - ships more in a known group that give a callout again
# Not in the launcher. Range 1..100 (outside: clamped). Default: 3.
# EVEJS_LNE_SHIP_AI_CALLOUT_GROWTH_MIN=

# shipAi.calloutClearMs - absence after which a group is gone (the wave ends)
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_SHIP_AI_CALLOUT_CLEAR_MS=

# shipAi.calloutClosingMeters - drop of the distance of the nearest hostile that says closing
# Not in the launcher. Range 100..100000 (outside: clamped). Default: 2000.
# EVEJS_LNE_SHIP_AI_CALLOUT_CLOSING_METERS=

# shipAi.calloutMaxChars - longest callout line (the voice)
# Not in the launcher. Range 40..200 (outside: clamped). Default: 90.
# EVEJS_LNE_SHIP_AI_CALLOUT_MAX_CHARS=

# shipAi.calloutMaxNameChars - longest faction name in a callout line
# Not in the launcher. Range 8..60 (outside: clamped). Default: 24.
# EVEJS_LNE_SHIP_AI_CALLOUT_MAX_NAME_CHARS=

# shipAi.calloutInboundEnabled - line when a hostile LNE fleet jumps next into the system of the player (needs calloutEnabled and fleetExposure.presence enabled + transitEnabled)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_CALLOUT_INBOUND_ENABLED=

# shipAi.calloutInboundMax - fleets in transit read per system per pass
# Not in the launcher. Range 1..32 (outside: clamped). Default: 8.
# EVEJS_LNE_SHIP_AI_CALLOUT_INBOUND_MAX=

# The new wave line of the sector (internal).
# shipAi.calloutWaveCooldownMs - cooldown of the new wave line in the sector (a group back on the grid or a set of new ships)
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 25000.
# EVEJS_LNE_SHIP_AI_CALLOUT_WAVE_COOLDOWN_MS=

# The lookup cap of the grid read (internal).
# shipAi.calloutScanLookupMax - NPC controllers looked up in one system per pass at most (dormant ones too; at least calloutScanMax)
# Not in the launcher. Range 10..4000 (outside: clamped). Default: 600.
# EVEJS_LNE_SHIP_AI_CALLOUT_SCAN_LOOKUP_MAX=

# The d-scan of the ship AI (tool dscan; internal).
# shipAi.dscanMaxEntries - d-scan entries read per scan (tool and the auto scan of); the vendor order is by distance
# Not in the launcher. Range 50..2000 (outside: clamped). Default: 400.
# EVEJS_LNE_SHIP_AI_DSCAN_MAX_ENTRIES=

# Sleepers, Drifters and Triglavians are hostile always.
# shipAi.calloutHostileFactionIds - faction IDs always hostile to the callouts and the d-scan (Sleepers / Unknown 500021, Drifters 500024, Triglavians 500026); empty = only pirates, invaders and standings
# Not in the launcher. Empty or a comma list of at most 8 faction IDs. Default: 500021,500024,500026.
# EVEJS_LNE_SHIP_AI_CALLOUT_HOSTILE_FACTION_IDS=

# The automatic d-scan of the ship AI (internal).
# shipAi.dscanAutoEnabled - the AI d-scans every player in space by itself and says the new hostiles (needs proactiveEnabled and calloutEnabled; the dscan tool works without it)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_DSCAN_AUTO_ENABLED=

# shipAi.dscanIntervalMs - time between two automatic d-scans of a player
# Not in the launcher. Range 5000..600000 (outside: clamped). Default: 15000.
# EVEJS_LNE_SHIP_AI_DSCAN_INTERVAL_MS=

# shipAi.dscanPollMs - interval of the automatic d-scan pass
# Not in the launcher. Range 500..60000 (outside: clamped). Default: 2500.
# EVEJS_LNE_SHIP_AI_DSCAN_POLL_MS=

# shipAi.dscanLoginDelayMs - delay of the first automatic d-scan after a login (or!ai scan on)
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 10000.
# EVEJS_LNE_SHIP_AI_DSCAN_LOGIN_DELAY_MS=

# shipAi.dscanScansPerPass - automatic d-scans in one pass at most (the rest waits for the next pass)
# Not in the launcher. Range 1..64 (outside: clamped). Default: 8.
# EVEJS_LNE_SHIP_AI_DSCAN_SCANS_PER_PASS=

# shipAi.dscanPassBudgetMs - time budget of one automatic d-scan pass (checked before each scan)
# Not in the launcher. Range 1..200 (outside: clamped). Default: 10.
# EVEJS_LNE_SHIP_AI_DSCAN_PASS_BUDGET_MS=

# shipAi.dscanMaxPlayers - players scanned automatically at most
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 64.
# EVEJS_LNE_SHIP_AI_DSCAN_MAX_PLAYERS=

# shipAi.dscanRefusedBackoffMs - wait after a refused automatic d-scan (abyssal space, a failed seam)
# Not in the launcher. Range 10000..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_SHIP_AI_DSCAN_REFUSED_BACKOFF_MS=

# shipAi.dscanSeenTtlMs - a hostile seen on the scan is new again after this absence (RAM memory)
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_SHIP_AI_DSCAN_SEEN_TTL_MS=

# shipAi.dscanSeenMax - hostile objects remembered per player (the oldest goes first)
# Not in the launcher. Range 16..4096 (outside: clamped). Default: 256.
# EVEJS_LNE_SHIP_AI_DSCAN_SEEN_MAX=

# shipAi.dscanMaxPilotsChecked - pilots of one automatic d-scan whose contacts are read
# Not in the launcher. Range 1..256 (outside: clamped). Default: 32.
# EVEJS_LNE_SHIP_AI_DSCAN_MAX_PILOTS_CHECKED=

# The lines about the ShipWing copies (internal).
# shipAi.wingHpEnabled - a line when the colour of the S/A/H number of a ShipWing copy in the wing window goes down (needs proactiveEnabled and the ShipWing mod)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_WING_HP_ENABLED=

# shipAi.wingHpThresholdSource - shipWing = the colour marks of the ShipWing config (hpWarnPct / hpCriticalPct), config = the LNE keys below
# Not in the launcher. shipWing or config. Default: shipWing.
# EVEJS_LNE_SHIP_AI_WING_HP_THRESHOLD_SOURCE=

# shipAi.wingHpWarnPct - orange below this percent (fallback of the ShipWing mark)
# Not in the launcher. Range 1..99 (outside: clamped). Default: 90.
# EVEJS_LNE_SHIP_AI_WING_HP_WARN_PCT=

# shipAi.wingHpCriticalPct - red below this percent (fallback of the ShipWing mark; must be below wingHpWarnPct)
# Not in the launcher. Range 1..99 (outside: clamped). Default: 50.
# EVEJS_LNE_SHIP_AI_WING_HP_CRITICAL_PCT=

# shipAi.wingHpThresholdRefreshMs - age of the ShipWing marks read (a change in the ShipWing panel arrives within it)
# Not in the launcher. Range 5000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_WING_HP_THRESHOLD_REFRESH_MS=

# shipAi.wingHpRearmPct - a colour going up re-arms only this many percent above its mark (shield regeneration)
# Not in the launcher. Range 0..20 (outside: clamped). Default: 3.
# EVEJS_LNE_SHIP_AI_WING_HP_REARM_PCT=

# shipAi.wingHpLayerCooldownMs - the same colour of the same layer of a copy is not told again within this time
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 30000.
# EVEJS_LNE_SHIP_AI_WING_HP_LAYER_COOLDOWN_MS=

# shipAi.wingHpMinGapMs - time between two wing HP lines of a player
# Not in the launcher. Range 0..120000 (outside: clamped). Default: 6000.
# EVEJS_LNE_SHIP_AI_WING_HP_MIN_GAP_MS=

# shipAi.wingHpMaxPerLine - copies named in one fleet line (the rest: and N more)
# Not in the launcher. Range 1..6 (outside: clamped). Default: 3.
# EVEJS_LNE_SHIP_AI_WING_HP_MAX_PER_LINE=

# shipAi.wingHpPendingMaxAgeMs - a colour change not told within this time is dropped
# Not in the launcher. Range 1000..120000 (outside: clamped). Default: 30000.
# EVEJS_LNE_SHIP_AI_WING_HP_PENDING_MAX_AGE_MS=

# shipAi.wingHpCarryMs - how long the colours of a copy that left (warp, jump, ShipWing relaunch) wait for the new entity of the same ship (type + name); 0 = every relaunch is a silent first sight
# Not in the launcher. Range 0..1800000 (outside: clamped). Default: 180000.
# EVEJS_LNE_SHIP_AI_WING_HP_CARRY_MS=

# shipAi.wingHpStatsLogMs - period of the log line 'shipAi proactive: wing stats...' (only when copies were read); 0 = no line
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_WING_HP_STATS_LOG_MS=

# shipAi.wingHpMaxChars - longest wing HP line (the voice)
# Not in the launcher. Range 40..240 (outside: clamped). Default: 120.
# EVEJS_LNE_SHIP_AI_WING_HP_MAX_CHARS=

# shipAi.wingHpMaxNameChars - longest copy name in a wing line
# Not in the launcher. Range 8..60 (outside: clamped). Default: 24.
# EVEJS_LNE_SHIP_AI_WING_HP_MAX_NAME_CHARS=

# shipAi.wingHpScanMax - scene entities read in one system per pass at most
# Not in the launcher. Range 100..50000 (outside: clamped). Default: 4000.
# EVEJS_LNE_SHIP_AI_WING_HP_SCAN_MAX=

# shipAi.wingHpCopiesMax - copies of one player followed at most (ShipWing maxWingPerPilot <= 10)
# Not in the launcher. Range 1..32 (outside: clamped). Default: 12.
# EVEJS_LNE_SHIP_AI_WING_HP_COPIES_MAX=

# shipAi.wingLossLineEnabled - a line when a ShipWing copy of the player is destroyed (the copy never gives the ship loss line)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_WING_LOSS_LINE_ENABLED=

# The speech triggers of the ship state (internal).
# shipAi.triggersEnabled - lines on a change of the ship / pilot state (crimewatch, capacitor, security status, docked damage, region); false = no trigger read and no such line (needs proactiveEnabled)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_TRIGGERS_ENABLED=

# shipAi.crimeWatchEnabled - the criminal / suspect flag lines (one read of the crimewatch row per player per pass)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_CRIME_WATCH_ENABLED=

# shipAi.capLowPermille - a capacitor below this per mille in space (not in warp) gives one line
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 150.
# EVEJS_LNE_SHIP_AI_CAP_LOW_PERMILLE=

# shipAi.capLowRearmPermille - the capacitor line re-arms above this per mille or in a station (must be above capLowPermille)
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 400.
# EVEJS_LNE_SHIP_AI_CAP_LOW_REARM_PERMILLE=

# shipAi.capLowCooldownMs - time between two capacitor lines
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_SHIP_AI_CAP_LOW_COOLDOWN_MS=

# shipAi.secStatusThresholds - comma list of up to 5 security status marks in -10..0 (one decimal); a drop through one gives a line once per mark per UTC day
# Not in the launcher. Empty or a comma list of up to 5 numbers in -10..0 (one decimal). Default: -2,-5.
# EVEJS_LNE_SHIP_AI_SEC_STATUS_THRESHOLDS=

# shipAi.dockRepairPermille - docking with armor or hull below this per mille gives a repair line instead of the dock line
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 900.
# EVEJS_LNE_SHIP_AI_DOCK_REPAIR_PERMILLE=

# shipAi.regionLineEnabled - a line of the model when the player enters a new region (global limit, template fallback)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_REGION_LINE_ENABLED=

# shipAi.triggersDisabledKinds - comma list of line kinds muted for everybody (the kinds of!ai mute)
# Not in the launcher. Empty or a comma list of muted line kinds. Default: (empty).
# EVEJS_LNE_SHIP_AI_TRIGGERS_DISABLED_KINDS=

# shipAi.triggerQueueMax - trigger lines waiting per player at most (the oldest out)
# Not in the launcher. Range 1..64 (outside: clamped). Default: 8.
# EVEJS_LNE_SHIP_AI_TRIGGER_QUEUE_MAX=

# shipAi.triggerPendingMaxAgeMs - a trigger line not told within this time is dropped
# Not in the launcher. Range 1000..120000 (outside: clamped). Default: 15000.
# EVEJS_LNE_SHIP_AI_TRIGGER_PENDING_MAX_AGE_MS=

# The speech triggers of the pilot activity (internal).
# shipAi.miningLinesEnabled - a line when the lasers stop on a full cargo hold or a burned out crystal
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_MINING_LINES_ENABLED=

# shipAi.miningCooldownMs - time between two lines of the same mining stop kind
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_SHIP_AI_MINING_COOLDOWN_MS=

# shipAi.siteClearedEnabled - a line when a site of the player is completed (model within the global limit, template fallback)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_SITE_CLEARED_ENABLED=

# shipAi.siteClearedScanMax - sessions of the scene looked at per completed site at most
# Not in the launcher. Range 1..4096 (outside: clamped). Default: 256.
# EVEJS_LNE_SHIP_AI_SITE_CLEARED_SCAN_MAX=

# shipAi.killLinesEnabled - a line when the player kills a navy ship or a notable NPC (needs the kill wrap: restart after a change)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_KILL_LINES_ENABLED=

# shipAi.notableKillClasses - comma list of ship group words of a notable NPC kill
# Not in the launcher. A comma list of 1..16 words of 2..40 letters, digits, spaces or hyphens. Default: Battleship,Dreadnought,Carrier,Titan,Supercarrier.
# EVEJS_LNE_SHIP_AI_NOTABLE_KILL_CLASSES=

# shipAi.notableKillNamePatterns - comma list of name / group words of a notable NPC kill
# Not in the launcher. A comma list of 1..16 words of 2..40 letters, digits, spaces or hyphens. Default: Commander,Officer,Overseer.
# EVEJS_LNE_SHIP_AI_NOTABLE_KILL_NAME_PATTERNS=

# shipAi.killCooldownMs - time between two notable kill lines
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_KILL_COOLDOWN_MS=

# shipAi.navyKillCooldownMs - time between two navy kill lines
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_SHIP_AI_NAVY_KILL_COOLDOWN_MS=

# The wallet / queue / mission watch, the welcome.
# shipAi.walletWatchEnabled - lines on bounties and other income of the wallet journal (one journal read per player per rescan)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_WALLET_WATCH_ENABLED=

# shipAi.bountyMinIsk - a bounty payout below this ISK says nothing
# Not in the launcher. Range 0..1000000000000 (outside: clamped). Default: 1000000.
# EVEJS_LNE_SHIP_AI_BOUNTY_MIN_ISK=

# shipAi.iskInMinIsk - an insurance / mission reward / donation below this ISK says nothing
# Not in the launcher. Range 0..1000000000000 (outside: clamped). Default: 5000000.
# EVEJS_LNE_SHIP_AI_ISK_IN_MIN_ISK=

# shipAi.walletRescanMs - time between two wallet journal reads of a player
# Not in the launcher. Range 30000..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_WALLET_RESCAN_MS=

# shipAi.walletCursorSlackMs - a journal entry this much older than the newest seen one still counts (late entries)
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_SHIP_AI_WALLET_CURSOR_SLACK_MS=

# shipAi.queueWatchEnabled - a line when the skill training queue is empty (after login and after the last skill)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_QUEUE_WATCH_ENABLED=

# shipAi.missionObjectivePollMs - the missions read rhythm while an accepted mission is in the system of the player
# Not in the launcher. Range 10000..600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_MISSION_OBJECTIVE_POLL_MS=

# shipAi.welcomeEnabled - a welcome line after a long absence (model within the global limit, template fallback)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_WELCOME_ENABLED=

# shipAi.welcomeMinOfflineMs - an absence of at least this long gives the welcome line
# Not in the launcher. Range 60000..604800000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_SHIP_AI_WELCOME_MIN_OFFLINE_MS=

# shipAi.welcomeSeenWriteMs - time between two writes of the last sight of an online player (must be below welcomeMinOfflineMs)
# Not in the launcher. Range 30000..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_WELCOME_SEEN_WRITE_MS=

# shipAi.welcomeMaxWaitMs - a welcome not told within this time after login is dropped
# Not in the launcher. Range 10000..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_WELCOME_MAX_WAIT_MS=

# The world news, an NPC battle / a world event here.
# shipAi.worldNewsEnabled - a line on a notices event near the player (captured / attacked systems, sieges, impact; needs notices.enabled)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_WORLD_NEWS_ENABLED=

# shipAi.worldNewsRadiusJumps - gate jumps from the event system within which a player hears the world news
# Not in the launcher. Range 0..5 (outside: clamped). Default: 2.
# EVEJS_LNE_SHIP_AI_WORLD_NEWS_RADIUS_JUMPS=

# shipAi.worldNewsKinds - comma list of the notice kinds told (empty = every kind)
# Not in the launcher. Empty or a comma list of notice kinds. Default: (empty).
# EVEJS_LNE_SHIP_AI_WORLD_NEWS_KINDS=

# shipAi.worldNewsSystemCooldownMs - time between two world news lines about the same system
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 900000.
# EVEJS_LNE_SHIP_AI_WORLD_NEWS_SYSTEM_COOLDOWN_MS=

# shipAi.worldNewsCooldownMs - time between two world news lines of a player
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_WORLD_NEWS_COOLDOWN_MS=

# shipAi.worldNewsModel - the world news line asks the model (global limit, template fallback); false = template only
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_SHIP_AI_WORLD_NEWS_MODEL=

# shipAi.battleHereEnabled - a line on a new NPC battle in the system of the player (never a LIVE battle)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_BATTLE_HERE_ENABLED=

# shipAi.eventHereEnabled - a line on a new active world event in the system of the player
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_EVENT_HERE_ENABLED=

# shipAi.worldHereCooldownMs - time between two battle / event lines of the same kind
# Not in the launcher. Range 0..86400000 (outside: clamped). Default: 600000.
# EVEJS_LNE_SHIP_AI_WORLD_HERE_COOLDOWN_MS=

# shipAi.worldHereScanMs - time between two battle / event reads of a system
# Not in the launcher. Range 5000..600000 (outside: clamped). Default: 30000.
# EVEJS_LNE_SHIP_AI_WORLD_HERE_SCAN_MS=

# shipAi.worldHereSeenMax - battles / events remembered per player (the oldest out)
# Not in the launcher. Range 8..1024 (outside: clamped). Default: 64.
# EVEJS_LNE_SHIP_AI_WORLD_HERE_SEEN_MAX=

# The ship AI lines of an Abyssal run (needs abyssal.enabled).
# shipAi.abyssalLinesEnabled - the AI tells the Abyssal run of the player (enter, rooms, timeout warnings
# result); off = no read of ctx.abyssal. Not in the launcher. Default: false.
# EVEJS_LNE_SHIP_AI_ABYSSAL_LINES_ENABLED=

# shipAi.abyssalWarnAtMs - comma list of the timeout warnings in ms before the end (up to 4, each
# 10000..1200000; empty = none). Not in the launcher. Default: 300000,60000.
# EVEJS_LNE_SHIP_AI_ABYSSAL_WARN_AT_MS=

# shipAi.abyssalScanMs - time between two reads of the runs (one read for every player)
# Not in the launcher. Range 1000..60000 (outside: clamped). Default: 5000.
# EVEJS_LNE_SHIP_AI_ABYSSAL_SCAN_MS=

# shipAi.abyssalSeenMax - run events remembered per player (the oldest out)
# Not in the launcher. Range 16..512 (outside: clamped). Default: 32.
# EVEJS_LNE_SHIP_AI_ABYSSAL_SEEN_MAX=

# shipAi.abyssalFinishedLookbackMs - a finished run within this time still gives its result line
# Not in the launcher. Range 60000..3600000 (outside: clamped). Default: 600000.
# EVEJS_LNE_SHIP_AI_ABYSSAL_FINISHED_LOOKBACK_MS=

# shipAi.abyssalFinishedLimit - finished runs read per scan (the newest first)
# Not in the launcher. Range 1..200 (outside: clamped). Default: 20.
# EVEJS_LNE_SHIP_AI_ABYSSAL_FINISHED_LIMIT=

# The autostart of the invitation and the voice link (!ai auto).
# shipAi.autostartEnabled - after a login the AI sends the room invitation and the voice link to the players with!ai auto on
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_AUTOSTART_ENABLED=

# shipAi.autostartPollMs - time between two presence reads of the autostart (none while no player has!ai auto on)
# Not in the launcher. Range 1000..60000 (outside: clamped). Default: 5000.
# EVEJS_LNE_SHIP_AI_AUTOSTART_POLL_MS=

# shipAi.autostartLoginDelayMs - wait after the first sight of a player before the invitation
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 20000.
# EVEJS_LNE_SHIP_AI_AUTOSTART_LOGIN_DELAY_MS=

# shipAi.autostartMaxWaitMs - an invitation still without a connected chat client this long after login is given up (must be at least autostartLoginDelayMs)
# Not in the launcher. Range 10000..1800000 (outside: clamped). Default: 180000.
# EVEJS_LNE_SHIP_AI_AUTOSTART_MAX_WAIT_MS=

# The lines of the ship AI read aloud by the observer page
# /shipai-voice.html (speechSynthesis of the browser, local voices). RAM only, no model request.
# shipAi.voiceEnabled - true =!ai voice gives a link to /shipai-voice.html that reads the AI lines aloud (observer needed)
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_SHIP_AI_VOICE_ENABLED=

# shipAi.voiceEngine - browser = speechSynthesis of the page; piper = local engine of (as browser)
# Not in the launcher. Values: browser, piper. Default: browser.
# EVEJS_LNE_SHIP_AI_VOICE_ENGINE=

# shipAi.voiceLinkTtlMs - lifetime of the one-use link token of!ai voice
# Not in the launcher. Range 60000..3600000 (outside: clamped). Default: 600000.
# EVEJS_LNE_SHIP_AI_VOICE_LINK_TTL_MS=

# shipAi.voiceLinkCooldownMs - time between two links of!ai voice of one character
# Not in the launcher. Range 0..600000 (outside: clamped). Default: 10000.
# EVEJS_LNE_SHIP_AI_VOICE_LINK_COOLDOWN_MS=

# shipAi.voiceSessionTtlMs - idle lifetime of a voice page session
# Not in the launcher. Range 600000..86400000 (outside: clamped). Default: 14400000.
# EVEJS_LNE_SHIP_AI_VOICE_SESSION_TTL_MS=

# shipAi.voiceMaxSessions - voice page sessions (and waiting link tokens) at once
# Not in the launcher. Range 1..16 (outside: clamped). Default: 4.
# EVEJS_LNE_SHIP_AI_VOICE_MAX_SESSIONS=

# shipAi.voicePollMs - poll period of the voice page
# Not in the launcher. Range 500..10000 (outside: clamped). Default: 1500.
# EVEJS_LNE_SHIP_AI_VOICE_POLL_MS=

# shipAi.voiceListenerIdleMs - no poll for this long = no listener, lines are not buffered
# Not in the launcher. Range 3000..120000 (outside: clamped). Default: 15000.
# EVEJS_LNE_SHIP_AI_VOICE_LISTENER_IDLE_MS=

# shipAi.voiceQueueMax - lines kept in the voice buffer of a character and on the page (the oldest go first)
# Not in the launcher. Range 1..32 (outside: clamped). Default: 6.
# EVEJS_LNE_SHIP_AI_VOICE_QUEUE_MAX=

# shipAi.voiceLineTtlMs - oldest line kept in the voice buffer
# Not in the launcher. Range 10000..600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_SHIP_AI_VOICE_LINE_TTL_MS=

# shipAi.voiceMaxLineChars - characters of one line read aloud (cut at a sentence or word)
# Not in the launcher. Range 40..2000 (outside: clamped). Default: 400.
# EVEJS_LNE_SHIP_AI_VOICE_MAX_LINE_CHARS=

# shipAi.voiceMaxPartChars - characters of one utterance (a longer sentence is split; Chrome cuts long ones)
# Not in the launcher. Range 40..400 (outside: clamped). Default: 200.
# EVEJS_LNE_SHIP_AI_VOICE_MAX_PART_CHARS=

# shipAi.voiceRateMilli - speech rate x 1000
# Not in the launcher. Range 500..2000 (outside: clamped). Default: 1000.
# EVEJS_LNE_SHIP_AI_VOICE_RATE_MILLI=

# shipAi.voicePitchMilli - speech pitch x 1000
# Not in the launcher. Range 500..2000 (outside: clamped). Default: 1100.
# EVEJS_LNE_SHIP_AI_VOICE_PITCH_MILLI=

# shipAi.voiceName - part of the name of the preferred browser voice (e.g. Paulina), empty = the first local voice
# Not in the launcher. Default: (empty = the first local voice of the language).
# EVEJS_LNE_SHIP_AI_VOICE_NAME=

# shipAi.voiceAllowRemote - true = the page may use remote (cloud) voices of the browser too
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_SHIP_AI_VOICE_ALLOW_REMOTE=

# shipAi.voiceShowText - the page shows the last lines as subtitles
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_VOICE_SHOW_TEXT=

# The local Piper engine (shipAi.voiceEngine=piper).
# The container `piper` of the compose profile tts (docker compose --profile tts up -d piper), no host port. Audio in
# RAM only. Any Piper failure = the line spoken by the browser voice (voiceFallbackBrowser).
# shipAi.voicePiperUrl - base URL of the local Piper HTTP server (http(s), no user:password, query or fragment); compose profile tts: http://piper:5000; empty = no Piper (browser engine)
# Not in the launcher, locked in the game panel. Default: (empty = no Piper). Docker: http://piper:5000.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_URL=

# shipAi.voicePiperVoicePl - Piper voice of Polish lines (docker/piper/voices.txt); empty = browser engine
# Not in the launcher. Default: pl_PL-gosia-medium.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_VOICE_PL=

# shipAi.voicePiperVoiceEn - Piper voice of English lines; empty = browser engine (no en voice with a confirmed CC0/CC-BY card)
# Not in the launcher. Default: (empty).
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_VOICE_EN=

# shipAi.voicePiperTimeoutMs - time limit of one Piper request; a line waits for its audio at most this long
# Not in the launcher. Range 1000..60000 (outside: clamped). Default: 15000.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_TIMEOUT_MS=

# shipAi.voicePiperMaxBytes - largest WAV answer of Piper (a larger one is cut off, the line goes without audio)
# Not in the launcher. Range 65536..8388608 (outside: clamped). Default: 2097152.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_MAX_BYTES=

# shipAi.voicePiperMaxInFlight - Piper requests at once (the rest waits, at most voiceQueueMax)
# Not in the launcher. Range 1..4 (outside: clamped). Default: 1.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_MAX_IN_FLIGHT=

# shipAi.voiceLengthScaleMilli - Piper length_scale x 1000 (higher = slower speech)
# Not in the launcher. Range 500..2000 (outside: clamped). Default: 1000.
# EVEJS_LNE_SHIP_AI_VOICE_LENGTH_SCALE_MILLI=

# shipAi.voiceCacheMaxBytes - RAM bytes of the Piper audio cache (LRU); 0 = no reuse
# Not in the launcher. Range 0..67108864 (outside: clamped). Default: 8388608.
# EVEJS_LNE_SHIP_AI_VOICE_CACHE_MAX_BYTES=

# shipAi.voiceDailyChars - characters sent to Piper per UTC day; 0 = never (safety switch)
# Not in the launcher. Range 0..10000000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_VOICE_DAILY_CHARS=

# shipAi.voiceBreakerFailures - Piper failures in a row that open the breaker
# Not in the launcher. Range 1..20 (outside: clamped). Default: 3.
# EVEJS_LNE_SHIP_AI_VOICE_BREAKER_FAILURES=

# shipAi.voiceBreakerCooldownMs - time the Piper breaker stays open
# Not in the launcher. Range 1000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_SHIP_AI_VOICE_BREAKER_COOLDOWN_MS=

# shipAi.voiceRadioFilter - the page plays Piper audio through a soft ship radio filter
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_VOICE_RADIO_FILTER=

# shipAi.voiceFallbackBrowser - a line without Piper audio is spoken by the browser voice (false = skipped)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_VOICE_FALLBACK_BROWSER=

# shipAi.voicePickerEnabled - the routes options / voice / test / persona and the Voice and Persona sections of the voice page
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_VOICE_PICKER_ENABLED=

# shipAi.voiceChoiceCooldownMs - time between two voice / persona saves of one character (a refusal counts too)
# Not in the launcher. Range 0..60000 (outside: clamped). Default: 1000.
# EVEJS_LNE_SHIP_AI_VOICE_CHOICE_COOLDOWN_MS=

# shipAi.voiceTestCooldownMs - time between two Piper voice tests of one character
# Not in the launcher. Range 0..60000 (outside: clamped). Default: 3000.
# EVEJS_LNE_SHIP_AI_VOICE_TEST_COOLDOWN_MS=

# shipAi.voiceTestTimeoutMs - wait for the WAV of a voice test (below observer.requestTimeoutMs 5000)
# Not in the launcher. Range 1000..4500 (outside: clamped). Default: 4000.
# EVEJS_LNE_SHIP_AI_VOICE_TEST_TIMEOUT_MS=

# shipAi.voicePiperListTimeoutMs - time limit of GET /voices of Piper
# Not in the launcher. Range 500..4500 (outside: clamped). Default: 3000.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_LIST_TIMEOUT_MS=

# shipAi.voicePiperVoicesTtlMs - the Piper voice list is cached this long
# Not in the launcher. Range 10000..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_VOICES_TTL_MS=

# shipAi.voicePiperListMaxBytes - largest answer of GET /voices (4 voices are about 20 KB)
# Not in the launcher. Range 16384..2097152 (outside: clamped). Default: 262144.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_LIST_MAX_BYTES=

# shipAi.voicePiperMaxVoices - Piper voices shown on the page
# Not in the launcher. Range 1..64 (outside: clamped). Default: 16.
# EVEJS_LNE_SHIP_AI_VOICE_PIPER_MAX_VOICES=

# shipAi.panelEnabled - the routes panel / panel/action and the Panel section of the voice page (switches and actions)
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_SHIP_AI_PANEL_ENABLED=

# shipAi.panelCooldownMs - time between two panel saves or actions of one character (a refusal counts too)
# Not in the launcher. Range 0..60000 (outside: clamped). Default: 1000.
# EVEJS_LNE_SHIP_AI_PANEL_COOLDOWN_MS=

# Abyssal run register
# Read only: the Abyssal Deadspace runs of the players go to lne_abyssal_runs and the observer panel abyssal-runs.
# Compose passes every key with an empty default (= the mod default).

# abyssal.enabled - master, off = no wrap, no vendor read, no row (the table exists anyway)
# Launcher: Modules / Abyssal run register. Range: true/false. Default: false.
# EVEJS_LNE_ABYSSAL_ENABLED=0

# abyssal.completionHookEnabled - wrap of dungeonTrackingRuntime.recordAbyssalRunCompletion; false = poll only
# Not in the launcher. Range: true/false. Default: true.
# EVEJS_LNE_ABYSSAL_COMPLETION_HOOK_ENABLED=

# abyssal.pollMs - period of the poll of the pocket hosts
# Not in the launcher. Range 1000..60000 (outside: clamped). Default: 5000.
# EVEJS_LNE_ABYSSAL_POLL_MS=

# abyssal.maxReadsPerPoll - live run reads per poll; a cut pass decides no LOST
# Not in the launcher. Range 1..200 (outside: clamped). Default: 32.
# EVEJS_LNE_ABYSSAL_MAX_READS_PER_POLL=

# abyssal.lostGraceMs - an open run not seen for this long becomes LOST
# Not in the launcher. Range 10000..3600000 (outside: clamped). Default: 120000.
# EVEJS_LNE_ABYSSAL_LOST_GRACE_MS=

# abyssal.maxPendingExits - exits of the completion wrap buffered until the next poll (also LOST marks per poll)
# Not in the launcher. Range 1..1024 (outside: clamped). Default: 64.
# EVEJS_LNE_ABYSSAL_MAX_PENDING_EXITS=

# abyssal.maxRows - rows of lne_abyssal_runs kept (the oldest finished ones are pruned)
# Not in the launcher. Range 100..100000 (outside: clamped). Default: 5000.
# EVEJS_LNE_ABYSSAL_MAX_ROWS=

# abyssal.pruneBatch - finished rows pruned per poll at most
# Not in the launcher. Range 1..1000 (outside: clamped). Default: 200.
# EVEJS_LNE_ABYSSAL_PRUNE_BATCH=

# abyssal.viewLimit - finished runs on the panel abyssal-runs
# Not in the launcher. Range 1..500 (outside: clamped). Default: 50.
# EVEJS_LNE_ABYSSAL_VIEW_LIMIT=

# Triglavian attention of a region from the runs
# abyssal.pressureEnabled - finished runs raise a decaying attention of their region; above the threshold the
# Triglavian invasion roll weighs the targets of the region more (only a weight). Needs abyssal.enabled, invasions.enabled.
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_ABYSSAL_PRESSURE_ENABLED=

# abyssal.pressureRefreshMs - period of the attention memo refresh. Range 10000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_ABYSSAL_PRESSURE_REFRESH_MS=

# abyssal.pressureWindowMs - finished runs younger than this count. Range 3600000..2592000000. Default: 604800000 (7 d).
# EVEJS_LNE_ABYSSAL_PRESSURE_WINDOW_MS=

# abyssal.pressureMaxRuns - runs read per refresh (capped by abyssal.maxRows). Range 10..100000. Default: 2000.
# EVEJS_LNE_ABYSSAL_PRESSURE_MAX_RUNS=

# abyssal.pressureHalfLifeMs - half-life of the weight of one run. Range 600000..2592000000. Default: 86400000 (24 h).
# EVEJS_LNE_ABYSSAL_PRESSURE_HALF_LIFE_MS=

# abyssal.pressureExitedMilli / pressureFailedMilli / pressureLostMilli - weight of one run by state (milli).
# Range 0..100000. Defaults: 1000 / 500 / 250.
# EVEJS_LNE_ABYSSAL_PRESSURE_EXITED_MILLI=
# EVEJS_LNE_ABYSSAL_PRESSURE_FAILED_MILLI=
# EVEJS_LNE_ABYSSAL_PRESSURE_LOST_MILLI=

# abyssal.pressureThresholdMilli - attention of a region that gets the Triglavian weight. Range 1..10000000. Default: 5000.
# EVEJS_LNE_ABYSSAL_PRESSURE_THRESHOLD_MILLI=

# abyssal.pressureWeightPermille - Triglavian target weight multiplier there (permille). Range 1000..10000. Default: 2000.
# EVEJS_LNE_ABYSSAL_PRESSURE_WEIGHT_PERMILLE=

# The galactic news (facts, editions with the
# fallback text, observer page `news`; needs modules.world). All keys internal: not in the launcher.
# news.enabled - feature flag, off = no timer, no read, no write of lne_news_*
# Not in the launcher. Range: true/false. Default: false.
# EVEJS_LNE_NEWS_ENABLED=

# news.passIntervalMs - period of the pass
# Not in the launcher. Range 10000..3600000 (outside: clamped). Default: 60000.
# EVEJS_LNE_NEWS_PASS_INTERVAL_MS=

# news.cycleHours - hours between two editions
# Not in the launcher. Range 1..168 (outside: clamped). Default: 24.
# EVEJS_LNE_NEWS_CYCLE_HOURS=

# news.publishHourUtc - UTC hour of the edition boundary
# Not in the launcher. Range 0..23 (outside: clamped). Default: 17.
# EVEJS_LNE_NEWS_PUBLISH_HOUR_UTC=

# news.settleDelayMs - wait after the boundary before the edition opens
# Not in the launcher. Range 0..3600000 (outside: clamped). Default: 300000.
# EVEJS_LNE_NEWS_SETTLE_DELAY_MS=

# news.language - language of the editions (en | pl); empty = chatterAi.language
# Not in the launcher. Text. Default: (empty).
# EVEJS_LNE_NEWS_LANGUAGE=

# news.kinds - CSV of the fact kinds kept (empty = all)
# Not in the launcher. Text. Default: (empty).
# EVEJS_LNE_NEWS_KINDS=

# news.capitalClasses - CSV of the capital hull groups whose jobs are news
# Not in the launcher. Text. Default: titan,supercarrier.
# EVEJS_LNE_NEWS_CAPITAL_CLASSES=

# news.maxFactsPerEdition - facts of one edition
# Not in the launcher. Range 1..30 (outside: clamped). Default: 10.
# EVEJS_LNE_NEWS_MAX_FACTS_PER_EDITION=

# news.minFactsPerEdition - fewer selected facts -> the edition is SKIPPED
# Not in the launcher. Range 1..30 (outside: clamped). Default: 1.
# EVEJS_LNE_NEWS_MIN_FACTS_PER_EDITION=

# news.maxPerKind - facts of one kind in an edition
# Not in the launcher. Range 1..30 (outside: clamped). Default: 4.
# EVEJS_LNE_NEWS_MAX_PER_KIND=

# news.maxPerSystem - facts of one system in an edition
# Not in the launcher. Range 1..30 (outside: clamped). Default: 2.
# EVEJS_LNE_NEWS_MAX_PER_SYSTEM=

# news.battleMinDestroyed - a merged battle with fewer destroyed ships is not news
# Not in the launcher. Range 1..100000 (outside: clamped). Default: 10.
# EVEJS_LNE_NEWS_BATTLE_MIN_DESTROYED=

# news.maxCandidatesPerEdition - open facts read at the opening (1 rows <= persistence.maxRowsPerTransaction)
# Not in the launcher. Range 10..5000 (outside: clamped). Default: 500.
# EVEJS_LNE_NEWS_MAX_CANDIDATES_PER_EDITION=

# news.maxFactAgeMs - an open fact older than this before the boundary is not news (pruned)
# Not in the launcher. Range 3600000..2592000000 (outside: clamped). Default: 172800000.
# EVEJS_LNE_NEWS_MAX_FACT_AGE_MS=

# news.maxWarFactsPerCall - facts written per notices war events call
# Not in the launcher. Range 1..500 (outside: clamped). Default: 64.
# EVEJS_LNE_NEWS_MAX_WAR_FACTS_PER_CALL=

# news.tailScanWindow - journal_id range per pass
# Not in the launcher. Range 100..1000000 (outside: clamped). Default: 20000.
# EVEJS_LNE_NEWS_TAIL_SCAN_WINDOW=

# news.tailMaxRowsPerPass - journal rows per pass (cut to persistence.maxRowsPerTransaction - 1)
# Not in the launcher. Range 1..5000 (outside: clamped). Default: 500.
# EVEJS_LNE_NEWS_TAIL_MAX_ROWS_PER_PASS=

# news.tailMaxLagRows - a larger backlog jumps to the journal head
# Not in the launcher. Range 1000..100000000 (outside: clamped). Default: 500000.
# EVEJS_LNE_NEWS_TAIL_MAX_LAG_ROWS=

# news.keepEditions - newest editions kept
# Not in the launcher. Range 1..365 (outside: clamped). Default: 30.
# EVEJS_LNE_NEWS_KEEP_EDITIONS=

# news.factRetentionMs - facts older than this are deleted
# Not in the launcher. Range 3600000..31536000000 (outside: clamped). Default: 1209600000.
# EVEJS_LNE_NEWS_FACT_RETENTION_MS=

# news.pruneBatch - rows deleted per pass
# Not in the launcher. Range 1..5000 (outside: clamped). Default: 200.
# EVEJS_LNE_NEWS_PRUNE_BATCH=

# news.observerEditions - editions on the observer page
# Not in the launcher. Range 1..30 (outside: clamped). Default: 7.
# EVEJS_LNE_NEWS_OBSERVER_EDITIONS=

# news.maxTitleChars - length of an edition title
# Not in the launcher. Range 20..150 (outside: clamped). Default: 100.
# EVEJS_LNE_NEWS_MAX_TITLE_CHARS=

# The AI text of the editions (chatterAi lane news, verified
# against the facts, a refusal keeps the fallback text). Needs news.enabled and chatterAi.enabled.
# news.aiEnabled - AI text of the editions through chatterAi (off = the fallback text only)
# Not in the launcher. Default: false.
# EVEJS_LNE_NEWS_AI_ENABLED=

# news.aiMaxAttempts - AI requests per edition, then the fallback
# Not in the launcher. Range 1..5 (outside: clamped). Default: 2.
# EVEJS_LNE_NEWS_AI_MAX_ATTEMPTS=

# news.draftDeadlineMs - an edition still drafting this long after its opening gets the fallback text
# Not in the launcher. Range 60000..21600000 (outside: clamped). Default: 1800000.
# EVEJS_LNE_NEWS_DRAFT_DEADLINE_MS=

# news.minBodyChars - shortest AI text (paragraphs)
# Not in the launcher. Range 50..6000 (outside: clamped). Default: 400.
# EVEJS_LNE_NEWS_MIN_BODY_CHARS=

# news.maxBodyChars - longest AI text (paragraphs)
# Not in the launcher. Range 200..6000 (outside: clamped). Default: 3000.
# EVEJS_LNE_NEWS_MAX_BODY_CHARS=

# news.minParagraphs - fewest paragraphs of the AI text
# Not in the launcher. Range 1..20 (outside: clamped). Default: 2.
# EVEJS_LNE_NEWS_MIN_PARAGRAPHS=

# news.maxParagraphs - most paragraphs of the AI text
# Not in the launcher. Range 1..20 (outside: clamped). Default: 8.
# EVEJS_LNE_NEWS_MAX_PARAGRAPHS=

# news.minCoveredFacts - the heaviest facts whose names the AI text must mention
# Not in the launcher. Range 0..30 (outside: clamped). Default: 3.
# EVEJS_LNE_NEWS_MIN_COVERED_FACTS=

# EVE mail of the editions to the readers seen in the last
# news.mail.readerActiveMs (opt-out !news off) and the !news chat command. Needs news.enabled.
# news.mail.enabled - EVE mail of every published edition to the recent readers (off = no delivery, no vendor call)
# Not in the launcher. Default: false.
# EVEJS_LNE_NEWS_MAIL_ENABLED=

# news.mail.readerActiveMs - a reader seen within this window gets the mail
# Not in the launcher. Range 3600000..2592000000 (outside: clamped). Default: 604800000.
# EVEJS_LNE_NEWS_MAIL_READER_ACTIVE_MS=

# news.mail.readerTouchMs - a seen reader is written at most once per this window
# Not in the launcher. Range 60000..86400000 (outside: clamped). Default: 3600000.
# EVEJS_LNE_NEWS_MAIL_READER_TOUCH_MS=

# news.mail.maxRecipientsPerEdition - mails of one edition (the most active readers; <= persistence.maxRowsPerTransaction - 2)
# Not in the launcher. Range 1..500 (outside: clamped). Default: 50.
# EVEJS_LNE_NEWS_MAIL_MAX_RECIPIENTS_PER_EDITION=

# news.mail.maxMailsPerPass - vendor mails per pass
# Not in the launcher. Range 1..50 (outside: clamped). Default: 5.
# EVEJS_LNE_NEWS_MAIL_MAX_MAILS_PER_PASS=

# news.mail.maxDeliveryAgeMs - a delivery not sent within this time is EXPIRED
# Not in the launcher. Range 3600000..2592000000 (outside: clamped). Default: 172800000.
# EVEJS_LNE_NEWS_MAIL_MAX_DELIVERY_AGE_MS=

# news.mail.senderId - character id of the mail sender (0 = the vendor welcome sender)
# Not in the launcher. Range 0..2147483647 (outside: clamped). Default: 0.
# EVEJS_LNE_NEWS_MAIL_SENDER_ID=

# news.command.enabled - the!news /!news off /!news on chat command (works without news.mail.enabled)
# Not in the launcher. Default: true.
# EVEJS_LNE_NEWS_COMMAND_ENABLED=

# Triglavian bridge
# A vanilla Ansiblex with the mod marker devFlags.lneTrigBridge jumps farther than 5 LY, cheaper, any ship. Internal:
# not in the launcher. = the jump scope only (install, pairing and mail come in).

# trigBridge.enabled - Feature flag: the jump scope (wrap of the vendor Ansiblex jump). Default: false.
# EVEJS_LNE_TRIGBRIDGE_ENABLED=

# trigBridge.maxRangeLy - Largest real distance of a Triglavian pair in LY. Range 1..120 (clamped). Default: 50.
# EVEJS_LNE_TRIGBRIDGE_MAX_RANGE_LY=

# trigBridge.fuelLyPermille - Effective distance = real x permille / 1000, cut to 5 LY (W126); ozone and fee follow
# it. Range 1..1000 (clamped). Default: 20.
# EVEJS_LNE_TRIGBRIDGE_FUEL_LY_PERMILLE=

# trigBridge.jumpCooldownMs - Cooldown per character (memory only). Range 0..86400000 (clamped). Default: 600000.
# EVEJS_LNE_TRIGBRIDGE_JUMP_COOLDOWN_MS=

# trigBridge.maxPairsPerAlliance - Triglavian pairs per alliance. Range 1..20 (clamped). Default: 1.
# EVEJS_LNE_TRIGBRIDGE_MAX_PAIRS_PER_ALLIANCE=

# trigBridge.coreTypeId - type of the Triglavian Conduit Core. Range 1..2147483647 (clamped). Default: 341640.
# EVEJS_LNE_TRIGBRIDGE_CORE_TYPE_ID=

# trigBridge.requireRole - install needs Station Manager or Director / CEO. Default: true.
# EVEJS_LNE_TRIGBRIDGE_REQUIRE_ROLE=

# trigBridge.statusMail - EVE mail after install, pairing and refusal. Default: true.
# EVEJS_LNE_TRIGBRIDGE_STATUS_MAIL=

# trigBridge.debugCommand - `!trigbridge status` (read only, operator diagnostics). Answers GM accounts only.
# Default: false.
# EVEJS_LNE_TRIGBRIDGE_DEBUG_COMMAND=

# trigBridge.presentationTypeId - slim type of a Triglavian bridge, 0 = no change. Range 0..2147483647
# (clamped). Default: 0. Trial value: 47685 Transfer Conduit (Triglavian); not in the type registry = W127.
# EVEJS_LNE_TRIGBRIDGE_PRESENTATION_TYPE_ID=

# trigBridge.listMax - ceiling of the structure scan at install and repair. Range 100..20000 (clamped).
# Default: 2000.
# EVEJS_LNE_TRIGBRIDGE_LIST_MAX=
