# industryOrphanCleanup mod - configuration template
#
# Copy this file to `.env` in this same folder and change the values you want.
# Order of precedence, highest first: the real environment (Docker compose, a
# start script), then this file, then the built-in defaults.
# Format: KEY=value, one per line, whole-line `#` comments only.
# An invalid value: the mod logs the problem and installs nothing.
# A change takes effect the next time EVE.js starts.

# Whole mod on/off (1/0, true/false, on/off). Default: 1.
# Off = vanilla EveJS: deleting a character leaves the industry blueprint state
# of its destroyed blueprints, and every server start then warns
# INDUSTRY_BLUEPRINT_SETTLEMENT_POSTCONDITION_FAILED for their finished jobs.
# EVEJS_INDUSTRY_ORPHAN_CLEANUP=1

# One log line per character deletion that removed or skipped blueprint state
# records (character, blueprint IDs, skip reasons). Default: 1.
# EVEJS_INDUSTRY_ORPHAN_CLEANUP_LOG=1
